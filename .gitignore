/target
.vagrant/

# Terraform working dirs (provider binaries), created by running the generated modules
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
.claude/

# Instance folders written by `isoloom run --instance N` (the committed files are under .isoloom/).
.isoloom-*/

# What `isoloom run cloud-services` writes next to the state: the module's copy, the
# launch-time inputs, the marker of an apply in progress.
.isoloom/cloud-services/module/
.isoloom/cloud-services/inputs.tfvars.json
.isoloom/cloud-services/deploying
