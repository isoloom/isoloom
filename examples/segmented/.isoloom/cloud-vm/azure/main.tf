output "machines" {
  value = {
    cache = azurerm_public_ip.cache.ip_address
    web   = azurerm_public_ip.web.ip_address
    user  = azurerm_public_ip.user.ip_address
  }
}

output "ssh_users" {
  value = {
    cache = "isoloom"
    web   = "isoloom"
    user  = "isoloom"
  }
}

output "ip" {
  value = azurerm_public_ip.user.ip_address
}

output "ready_file" {
  value = "/var/lib/isoloom/ready"
}

# The checks, from where a user stands: ssh <user>@<host> each command.
output "checks" {
  value = {
    host = azurerm_public_ip.user.ip_address
    user = null
    commands = [
      "cd /opt/isoloom && sh checks/web-reachable.sh",
      "cd /opt/isoloom && sh checks/cache-blocked.sh"
    ]
  }
}
