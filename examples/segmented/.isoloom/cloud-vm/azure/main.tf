  }
  security_rule {
    name                       = "reach-0-access"
    priority                   = 120
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "10.61.99.0/24"
    destination_address_prefix = "*"
  }
  security_rule {
