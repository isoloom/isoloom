# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Auth:   export LINODE_TOKEN=<token> (the provider reads it).
# Start:  terraform -chdir=.isoloom/cloud-vm/linode init && terraform -chdir=.isoloom/cloud-vm/linode apply \
#           -var allowed_cidr=<your IP>/32 -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)" -var ssh_private_key_file=~/.ssh/id_ed25519
# Stop:   terraform -chdir=.isoloom/cloud-vm/linode destroy (same variables)

terraform {
  required_version = ">= 1.6"
  backend "local" {}
  required_providers {
    linode = { source = "linode/linode", version = "~> 4.7.0" }
    random = { source = "hashicorp/random", version = "~> 3.9.1" }
    local  = { source = "hashicorp/local", version = "~> 2.9.1" }
  }
}

variable "region" {
  type    = string
  default = "fr-par"
}

variable "allowed_cidr" {
  type        = string
  description = "Who may reach the machines (SSH and the published ports), e.g. your IP/32"
}

variable "ssh_public_key" {
  type = string
}

variable "ssh_private_key_file" {
  type        = string
  description = "The private key of ssh_public_key: Terraform sets the machines up over SSH"
}

variable "auto_stop_minutes" {
  type        = number
  default     = 0
  description = "Shut the machines down after this many minutes (0: never)"
}

variable "expires_at" {
  type        = string
  default     = ""
  description = "When the environment should end, in Unix seconds (empty: no end), as a tag on every resource so a reaper can find what to destroy"
}

provider "linode" {}

resource "terraform_data" "id" {
  input = substr(replace(uuid(), "-", ""), 0, 8)
  lifecycle {
    ignore_changes = [input]
  }
}

locals {
  name = "isoloom-segmented-${terraform_data.id.output}"
  root = abspath("${path.module}/../../..")
}

# The environment's networks: a VPC with a subnet per network at its exact range, so every
# machine keeps its address.
resource "linode_vpc" "env" {
  label  = local.name
  region = var.region
}

resource "linode_vpc_subnet" "front" {
  vpc_id = linode_vpc.env.id
  label  = "front"
  ipv4   = "10.61.10.0/24"
}

resource "linode_vpc_subnet" "back" {
  vpc_id = linode_vpc.env.id
  label  = "back"
  ipv4   = "10.61.20.0/24"
}

resource "linode_vpc_subnet" "access" {
  vpc_id = linode_vpc.env.id
  label  = "access"
  ipv4   = "10.61.99.0/24"
}

# Machine `cache` on `back`: what may reach it, and where it may not go.
resource "linode_firewall" "cache" {
  label           = "${local.name}-cache"
  inbound_policy  = "DROP"
  outbound_policy = "ACCEPT"
  inbound {
    label    = "ssh"
    action   = "ACCEPT"
    protocol = "TCP"
    ports    = "22"
    ipv4     = [var.allowed_cidr]
  }
  inbound {
    label    = "vpc-tcp"
    action   = "ACCEPT"
    protocol = "TCP"
    ports    = "1-65535"
    ipv4     = ["10.61.20.0/24"]
  }
  inbound {
    label    = "vpc-udp"
    action   = "ACCEPT"
    protocol = "UDP"
    ports    = "1-65535"
    ipv4     = ["10.61.20.0/24"]
  }
  inbound {
    label    = "vpc-icmp"
    action   = "ACCEPT"
    protocol = "ICMP"
    ipv4     = ["10.61.20.0/24"]
  }
  inbound {
    label    = "reach-front-tcp"
    action   = "ACCEPT"
    protocol = "TCP"
    ports    = "6379"
    ipv4     = ["10.61.10.0/24"]
  }
  inbound {
    label    = "reach-front-udp"
    action   = "ACCEPT"
    protocol = "UDP"
    ports    = "6379"
    ipv4     = ["10.61.10.0/24"]
  }
  outbound {
    label    = "no-front-tcp"
    action   = "DROP"
    protocol = "TCP"
    ports    = "1-65535"
    ipv4     = ["10.61.10.0/24"]
  }
  outbound {
    label    = "no-front-udp"
    action   = "DROP"
    protocol = "UDP"
    ports    = "1-65535"
    ipv4     = ["10.61.10.0/24"]
  }
  outbound {
    label    = "no-front-icmp"
    action   = "DROP"
    protocol = "ICMP"
    ipv4     = ["10.61.10.0/24"]
  }
  outbound {
    label    = "no-access-tcp"
    action   = "DROP"
    protocol = "TCP"
    ports    = "1-65535"
    ipv4     = ["10.61.99.0/24"]
  }
  outbound {
    label    = "no-access-udp"
    action   = "DROP"
    protocol = "UDP"
    ports    = "1-65535"
    ipv4     = ["10.61.99.0/24"]
  }
  outbound {
    label    = "no-access-icmp"
    action   = "DROP"
    protocol = "ICMP"
    ipv4     = ["10.61.99.0/24"]
  }
  linodes = [linode_instance.cache.id]
}

