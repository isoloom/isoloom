  name         = "${local.name}-web"
  machine_type = "e2-small"
  zone         = local.zone
  tags         = ["${local.name}-web"]
  boot_disk {
    initialize_params {
      image = "debian-cloud/debian-12"
      size  = 20
    }
  }
  network_interface {
    subnetwork = google_compute_subnetwork.front.id
    network_ip = "10.61.10.10"
    access_config {}
