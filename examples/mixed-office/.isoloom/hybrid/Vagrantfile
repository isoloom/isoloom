    m.vm.provision "shell", name: "hosts", inline: "for l in '192.168.58.10 files01' '192.168.58.20 intranet'; do grep -qxF \"$l\" /etc/hosts || echo \"$l\" >> /etc/hosts; done"
    PROJECT.each do |entry|
