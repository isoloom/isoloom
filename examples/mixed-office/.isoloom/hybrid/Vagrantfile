      set -e
      IF=$(ip -o link | grep -i '0a:15:57:4b:b3:00' | awk -F': ' '{print $2}')
      ip link set "$IF" up promisc on
      docker network inspect isoloom-mixed-office-office >/dev/null 2>&1 || docker network create -d macvlan --subnet 192.168.58.0/24 --gateway 192.168.58.1 -o parent="$IF" isoloom-mixed-office-office
    SH
    m.vm.provision "shell", name: "containers", inline: "cd /opt/isoloom && docker compose -f .isoloom/hybrid/compose.yml up -d --build --wait --wait-timeout 900"
