{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "The supplier-portal-api environment's values",
  "$comment": "Generated by Isoloom from isoloom.yml: regenerate it rather than editing it.",
  "type": "object",
  "properties": {
    "images": {
      "description": "Each machine's image, by machine.",
      "type": "object",
      "properties": {
        "database": {
          "type": "string",
          "minLength": 1
        },
        "web": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "database",
        "web"
      ],
      "additionalProperties": false
    },
    "inputs": {
      "description": "The launch-time inputs, by name (an unset one is empty).",
      "type": "object",
      "properties": {
        "API_URL": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "LAUNCH_TOKEN": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "images"
  ],
  "additionalProperties": false
}
