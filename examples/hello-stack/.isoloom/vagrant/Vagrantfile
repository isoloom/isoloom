      set -e
      if command -v apk >/dev/null; then
        apk add -q --no-cache python3 sshpass curl netcat-openbsd
      else
        export DEBIAN_FRONTEND=noninteractive
        apt-get update -qq
        apt-get install -y -qq python3-venv sshpass curl netcat-openbsd >/dev/null
      fi
      [ -x /opt/ansible/bin/ansible-playbook ] || { python3 -m venv /opt/ansible && /opt/ansible/bin/pip install -q 'ansible-core>=2.15,<2.17' pywinrm; }
      mkdir -p /etc/isoloom
      cat > /etc/isoloom/inventory.ini <<'INV'
