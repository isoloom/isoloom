resource "azurerm_network_interface" "client_users" {
  name                = "${local.name}-client-users"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  ip_configuration {
    name                          = "primary"
    subnet_id                     = azurerm_subnet.users.id
    private_ip_address_allocation = "Static"
    private_ip_address            = "10.66.20.10"
    public_ip_address_id          = azurerm_public_ip.client.id
