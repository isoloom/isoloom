    m.vm.network "private_network", ip: "192.168.1.21", netmask: "255.255.255.0", virtualbox__intnet: "isoloom-existing-hosts-lab", libvirt__network_name: "isoloom-existing-hosts-lab", libvirt__dhcp_enabled: false
    m.vm.provider "virtualbox" do |v|
