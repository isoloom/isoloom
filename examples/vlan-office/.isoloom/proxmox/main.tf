    size         = 20
  }
  network_device {
    bridge   = proxmox_sdn_vnet.office.id
    vlan_id  = 20
    firewall = true
  }
  initialization {
    datastore_id      = var.datastore
    user_data_file_id = proxmox_virtual_environment_file.guest.id
    dns {
      servers = ["1.1.1.1"]
    }
    ip_config {
      ipv4 {
