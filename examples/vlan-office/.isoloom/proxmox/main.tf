  value = [
    {
      position = "staff"
      machine  = "staff"
      host     = "10.70.10.10"
      user     = "isoloom"
      script   = ".isoloom/proxmox/checks/staff.sh"
    },
    {
      position = "intranet"
      machine  = "intranet"
      host     = "10.70.99.10"
      user     = "isoloom"
      script   = ".isoloom/proxmox/checks/intranet.sh"
    },
    {
