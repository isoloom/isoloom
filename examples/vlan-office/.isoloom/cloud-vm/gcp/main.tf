output "machines" {
  value = {
    intranet = google_compute_instance.intranet.network_interface[0].access_config[0].nat_ip
    staff    = google_compute_instance.staff.network_interface[0].access_config[0].nat_ip
    guest    = google_compute_instance.guest.network_interface[0].access_config[0].nat_ip
  }
}

output "ssh_users" {
  value = {
    intranet = "admin"
    staff    = "admin"
    guest    = "admin"
  }
}

output "ip" {
  value = google_compute_instance.staff.network_interface[0].access_config[0].nat_ip
}

output "ready_file" {
  value = "/var/lib/isoloom/ready"
}

# The checks: each runner on the machine it stands for (ssh <user>@<host> '<command>'), or `isoloom test cloud-vm`.
output "checks" {
  value = [
    { position = "staff", machine = "staff", host = google_compute_instance.staff.network_interface[0].access_config[0].nat_ip, user = "admin", command = "cd /opt/isoloom && sh .isoloom/cloud-vm/checks/staff.sh" },
    { position = "intranet", machine = "intranet", host = google_compute_instance.intranet.network_interface[0].access_config[0].nat_ip, user = "admin", command = "cd /opt/isoloom && sh .isoloom/cloud-vm/checks/intranet.sh" },
    { position = "guest", machine = "guest", host = google_compute_instance.guest.network_interface[0].access_config[0].nat_ip, user = "admin", command = "cd /opt/isoloom && sh .isoloom/cloud-vm/checks/guest.sh" }
  ]
}
