  project       = local.project
  name          = "${local.name}-office-vlan20"
  network       = google_compute_network.office_vlan20.id
  ip_cidr_range = "10.70.20.0/24"
  region        = var.region
}

resource "google_compute_network" "servers" {
  project                 = local.project
  name                    = "${local.name}-servers"
  auto_create_subnetworks = false
  mtu                     = 1500
}

resource "google_compute_subnetwork" "servers" {
  project       = local.project
  name          = "${local.name}-servers"
  network       = google_compute_network.servers.id
  ip_cidr_range = "10.70.99.0/24"
  region        = var.region
}

resource "google_compute_network_peering" "office_vlan10_office_vlan20" {
  name                 = "${local.name}-office-vlan10-office-vlan20"
  network              = google_compute_network.office_vlan10.self_link
  peer_network         = google_compute_network.office_vlan20.self_link
  export_custom_routes = true
  import_custom_routes = true
}

resource "google_compute_network_peering" "office_vlan20_office_vlan10" {
  name                 = "${local.name}-office-vlan20-office-vlan10"
  network              = google_compute_network.office_vlan20.self_link
  peer_network         = google_compute_network.office_vlan10.self_link
  export_custom_routes = true
  import_custom_routes = true
  depends_on           = [google_compute_network_peering.office_vlan10_office_vlan20]
}

resource "google_compute_network_peering" "office_vlan10_servers" {
  name                 = "${local.name}-office-vlan10-servers"
  network              = google_compute_network.office_vlan10.self_link
