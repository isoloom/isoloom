      v.esxi_hostport = ENV.fetch("ESXI_HOSTPORT", "22").to_i
      v.esxi_username = ENV.fetch("ESXI_USERNAME", "root")
      v.esxi_password = "env:ESXI_PASSWORD"
      v.esxi_disk_store = ENV["ESXI_DATASTORE"] if ENV["ESXI_DATASTORE"]
      v.esxi_virtual_network = esxi_networks(["office-vlan20"])
      v.guest_name = "vlan-office-guest"
      v.guest_numvcpus = 1
      v.guest_memsize = 1024
    end
    m.vm.provider "libvirt" do |v, o|
      o.vm.box = "generic/debian12"
      v.cpus = 1
      v.memory = 1024
    end
    m.vm.provision "shell", name: "hosts", inline: "for l in '10.70.99.10 intranet' '10.70.10.10 staff' '10.70.20.50 admin'; do grep -qxF \"$l\" /etc/hosts || echo \"$l\" >> /etc/hosts; done"
    m.vm.provision "shell", name: "routes", inline: <<~'SH'
      mkdir -p /etc/isoloom
      cat > /etc/isoloom/routes.sh <<'ROUTES'
      #!/bin/sh
      # Routes to the other isoloom networks.
      ip route replace 10.70.10.0/24 via 10.70.20.254 2>/dev/null || true
      ip route replace 10.70.99.0/24 via 10.70.20.254 2>/dev/null || true
      ROUTES
      chmod +x /etc/isoloom/routes.sh
      for d in /etc/network/if-up.d /etc/networkd-dispatcher/routable.d; do
        if [ -d "$d" ]; then ln -sf /etc/isoloom/routes.sh "$d/zz-isoloom-routes"; fi
      done
      cat > /etc/systemd/system/isoloom-routes.service <<'UNIT'
      [Unit]
      Description=Routes to the other isoloom networks
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      ExecStart=/etc/isoloom/routes.sh

      [Install]
      WantedBy=multi-user.target
      UNIT
      systemctl daemon-reload
      systemctl enable isoloom-routes.service
      systemctl restart isoloom-routes.service
    SH
    m.vm.provision "isoloom_project", name: "project"
    m.vm.provision "shell", name: "provision/guest.sh", inline: "cd /opt/isoloom && sh provision/guest.sh"
    m.vm.provision "shell", name: "checks", run: "never", path: "checks/guest.sh", env: { "ISOLOOM_DERIVED" => ENV.fetch("ISOLOOM_DERIVED", "1") }
  end

  config.vm.define "admin" do |m|
    m.vm.box = "bento/debian-12"
    m.vm.hostname = "admin"
    m.vm.network "private_network", ip: "10.70.10.50", netmask: "255.255.255.0", virtualbox__intnet: "isoloom-vlan-office-office-vlan10", libvirt__network_name: "isoloom-vlan-office-office-vlan10", libvirt__dhcp_enabled: false
    m.vm.network "private_network", ip: "10.70.20.50", netmask: "255.255.255.0", virtualbox__intnet: "isoloom-vlan-office-office-vlan20", libvirt__network_name: "isoloom-vlan-office-office-vlan20", libvirt__dhcp_enabled: false
    m.vm.provider "virtualbox" do |v|
      v.name = "vlan-office · admin"
      v.linked_clone = true
      v.cpus = 1
      v.memory = 1024
    end
    m.vm.provider "vmware_desktop" do |v|
      v.vmx["displayName"] = "vlan-office · admin"
      v.vmx["numvcpus"] = "1"
      v.vmx["memsize"] = "1024"
    end
    m.vm.provider "parallels" do |v|
      v.name = "vlan-office · admin"
      v.linked_clone = true
      v.cpus = 1
      v.memory = 1024
    end
    m.vm.provider "utm" do |v|
      v.name = "vlan-office · admin"
      v.cpus = 1
      v.memory = 1024
    end
    m.vm.provider "qemu" do |v|
      v.smp = "cpus=1"
      v.memory = "1024M"
    end
    m.vm.provider "vmware_esxi" do |v|
      v.esxi_hostname = ENV.fetch("ESXI_HOSTNAME", "")
      v.esxi_hostport = ENV.fetch("ESXI_HOSTPORT", "22").to_i
      v.esxi_username = ENV.fetch("ESXI_USERNAME", "root")
      v.esxi_password = "env:ESXI_PASSWORD"
      v.esxi_disk_store = ENV["ESXI_DATASTORE"] if ENV["ESXI_DATASTORE"]
      v.esxi_virtual_network = esxi_networks(["office-vlan10", "office-vlan20"])
      v.guest_name = "vlan-office-admin"
      v.guest_numvcpus = 1
      v.guest_memsize = 1024
    end
    m.vm.provider "libvirt" do |v, o|
      o.vm.box = "generic/debian12"
      v.cpus = 1
      v.memory = 1024
    end
    m.vm.provision "shell", name: "hosts", inline: "for l in '10.70.99.10 intranet' '10.70.10.10 staff' '10.70.20.10 guest'; do grep -qxF \"$l\" /etc/hosts || echo \"$l\" >> /etc/hosts; done"
    m.vm.provision "shell", name: "routes", inline: <<~'SH'
      mkdir -p /etc/isoloom
      cat > /etc/isoloom/routes.sh <<'ROUTES'
      #!/bin/sh
      # Routes to the other isoloom networks.
      ip link show office >/dev/null 2>&1 || { ip link add office type veth peer name office-s && ip link set office up && ip link set office-s up && IF=$(ip -o -4 addr show | awk '$4 ~ /^10\.70\.10\.50\//{print $2}' | head -n 1) && MAC=$(cat /sys/class/net/$IF/address) && ip addr flush dev $IF && ip link set $IF address 02:1f:0a:46:0a:32 && ip link add br10 type bridge && ip link set $IF master br10 && ip link set br10 up && ip link add link office-s name office-s.10 type vlan id 10 && ip link set office-s.10 master br10 && ip link set office-s.10 up && ip link add link office name office.10 address $MAC type vlan id 10 && ip addr add 10.70.10.50/24 dev office.10 && ip link set office.10 up && IF=$(ip -o -4 addr show | awk '$4 ~ /^10\.70\.20\.50\//{print $2}' | head -n 1) && MAC=$(cat /sys/class/net/$IF/address) && ip addr flush dev $IF && ip link set $IF address 02:1f:0a:46:14:32 && ip link add br20 type bridge && ip link set $IF master br20 && ip link set br20 up && ip link add link office-s name office-s.20 type vlan id 20 && ip link set office-s.20 master br20 && ip link set office-s.20 up && ip link add link office name office.20 address $MAC type vlan id 20 && ip addr add 10.70.20.50/24 dev office.20 && ip link set office.20 up; } 2>/dev/null || true
      ip route replace 10.70.99.0/24 via 10.70.10.254 2>/dev/null || true
      ROUTES
      chmod +x /etc/isoloom/routes.sh
      for d in /etc/network/if-up.d /etc/networkd-dispatcher/routable.d; do
        if [ -d "$d" ]; then ln -sf /etc/isoloom/routes.sh "$d/zz-isoloom-routes"; fi
      done
      cat > /etc/systemd/system/isoloom-routes.service <<'UNIT'
      [Unit]
      Description=Routes to the other isoloom networks
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      ExecStart=/etc/isoloom/routes.sh

      [Install]
      WantedBy=multi-user.target
      UNIT
      systemctl daemon-reload
      systemctl enable isoloom-routes.service
      systemctl restart isoloom-routes.service
    SH
    m.vm.provision "isoloom_project", name: "project"
    m.vm.provision "shell", name: "provision/guest.sh", inline: "cd /opt/isoloom && sh provision/guest.sh"
    m.vm.provision "shell", name: "checks", run: "never", path: "checks/admin.sh", env: { "ISOLOOM_DERIVED" => ENV.fetch("ISOLOOM_DERIVED", "1") }
  end
