# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  terraform -chdir=.isoloom/cloud-vm/aws init && terraform -chdir=.isoloom/cloud-vm/aws apply \
#           -var allowed_cidr=<your IP>/32 -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)" -var ssh_private_key_file=~/.ssh/id_ed25519
# Stop:   terraform -chdir=.isoloom/cloud-vm/aws destroy (same variables)

terraform {
  required_version = ">= 1.6"
  backend "local" {}
  required_providers {
    aws   = { source = "hashicorp/aws", version = "~> 6.67.0" }
    local = { source = "hashicorp/local", version = "~> 2.9.1" }
  }
}

variable "region" {
  type    = string
  default = "eu-west-3"
}

variable "allowed_cidr" {
  type        = string
  description = "Who may reach the machines (SSH and the published ports), e.g. your IP/32"
}

variable "ssh_public_key" {
  type = string
}

variable "ssh_private_key_file" {
  type        = string
  description = "The private key of ssh_public_key: Terraform sets the machines up over SSH"
}

variable "auto_stop_minutes" {
  type        = number
  default     = 0
  description = "Shut the machines down after this many minutes (0: never)"
}

variable "expires_at" {
  type        = string
  default     = ""
  description = "When the environment should end, in Unix seconds (empty: no end), as a tag on every resource so a reaper can find what to destroy"
}

provider "aws" {
  region = var.region
  default_tags {
    tags = {
      isoloom-environment = "several-addresses"
      managed-by          = "isoloom"
      isoloom-instance    = local.name
      isoloom-expires-at  = var.expires_at
    }
  }
}

resource "terraform_data" "id" {
  input = substr(replace(uuid(), "-", ""), 0, 8)
  lifecycle {
    ignore_changes = [input]
  }
}

locals {
  name = "isoloom-several-addresses-${terraform_data.id.output}"
  root = abspath("${path.module}/../../..")
}

data "aws_availability_zones" "available" {
  state = "available"
}

# The environment's networks: one VPC, a subnet per network with its exact range.
resource "aws_vpc" "env" {
  cidr_block = "10.86.0.0/24"
  tags       = { Name = local.name }
}

resource "aws_internet_gateway" "env" {
  vpc_id = aws_vpc.env.id
}

resource "aws_route_table" "env" {
  vpc_id = aws_vpc.env.id
  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.env.id
  }
}

resource "aws_subnet" "office" {
  vpc_id            = aws_vpc.env.id
  cidr_block        = "10.86.0.0/24"
  availability_zone = data.aws_availability_zones.available.names[0]
  tags              = { Name = "${local.name}-office" }
}

resource "aws_route_table_association" "office" {
  subnet_id      = aws_subnet.office.id
  route_table_id = aws_route_table.env.id
}

resource "aws_key_pair" "env" {
  key_name   = local.name
  public_key = var.ssh_public_key
}

data "aws_ami" "debian_12" {
  most_recent = true
  owners      = ["136693071363"]
  filter {
    name   = "name"
    values = ["debian-12-amd64-*"]
  }
  filter {
    name   = "architecture"
    values = ["x86_64"]
  }
}

# Machine `web`: what may reach it.
resource "aws_security_group" "web" {
  name   = "${local.name}-web"
  vpc_id = aws_vpc.env.id
  ingress {
    description = "its network (office)"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["10.86.0.0/24"]
  }
  ingress {
    description = "SSH from allowed_cidr"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [var.allowed_cidr]
  }
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_instance" "web" {
  ami                         = data.aws_ami.debian_12.id
  instance_type               = "t3.small"
  secondary_private_ips       = ["10.86.0.11", "10.86.0.12"]
  subnet_id                   = aws_subnet.office.id
  private_ip                  = "10.86.0.10"
  associate_public_ip_address = true
  key_name                    = aws_key_pair.env.key_name
  vpc_security_group_ids      = [aws_security_group.web.id]
  user_data                   = var.auto_stop_minutes > 0 ? "#!/bin/sh\nshutdown -h +${var.auto_stop_minutes}\n" : null
  root_block_device {
    volume_size = 20
  }
  tags = { Name = "${local.name}-web" }
}

resource "terraform_data" "web" {
  triggers_replace = [aws_instance.web.id]
  connection {
    type        = "ssh"
    host        = aws_instance.web.public_ip
    user        = "admin"
    private_key = file(pathexpand(var.ssh_private_key_file))
    timeout     = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-web.tgz\" --exclude=.git --exclude=.vagrant --exclude=.terraform --exclude=.isoloom-project* -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-web.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "remote-exec" {
    inline = [
      "set -e",
      "cloud-init status --wait >/dev/null 2>&1 || true",
      "sudo sh -c 'mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz'",
      "sudo sh -c 'for l in '\\''10.86.0.40 decoy'\\'' '\\''10.86.0.20 client'\\'' '\\''10.86.0.48 decoy'\\'' '\\''10.86.0.49 decoy'\\'' '\\''10.86.0.50 decoy'\\'' '\\''10.86.0.51 decoy'\\'' '\\''10.86.0.52 decoy'\\'' '\\''10.86.0.53 decoy'\\'' '\\''10.86.0.54 decoy'\\'' '\\''10.86.0.55 decoy'\\'' '\\''10.86.0.56 decoy'\\'' '\\''10.86.0.57 decoy'\\'' '\\''10.86.0.58 decoy'\\'' '\\''10.86.0.59 decoy'\\'' '\\''10.86.0.60 decoy'\\'' '\\''10.86.0.61 decoy'\\'' '\\''10.86.0.62 decoy'\\'' '\\''10.86.0.63 decoy'\\''; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'",
      "sudo sh -c 'dev=$(ip -o -4 addr show | grep -F '\\'' inet 10.86.0.10/'\\'' | awk '\\''{print $2; exit}'\\'')\nip addr replace 10.86.0.11/24 dev \"$dev\"\nip addr replace 10.86.0.12/24 dev \"$dev\"'",
      "sudo sh -c 'cd /opt/isoloom && sh -c '\\''sh provision/web.sh'\\'''",
      "sudo sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'"
    ]
  }
}

# Machine `decoy`: what may reach it.
resource "aws_security_group" "decoy" {
  name   = "${local.name}-decoy"
  vpc_id = aws_vpc.env.id
  ingress {
    description = "its network (office)"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["10.86.0.0/24"]
  }
  ingress {
    description = "SSH from allowed_cidr"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [var.allowed_cidr]
  }
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_network_interface" "decoy_office" {
  subnet_id               = aws_subnet.office.id
  private_ip_list_enabled = true
  private_ip_list         = ["10.86.0.40"]
  ipv4_prefixes           = ["10.86.0.48/28"]
  security_groups         = [aws_security_group.decoy.id]
  source_dest_check       = false
  tags                    = { Name = "${local.name}-decoy-office" }
}

resource "aws_instance" "decoy" {
  ami           = data.aws_ami.debian_12.id
  instance_type = "t3.micro"
  key_name      = aws_key_pair.env.key_name
  user_data     = var.auto_stop_minutes > 0 ? "#!/bin/sh\nshutdown -h +${var.auto_stop_minutes}\n" : null
  primary_network_interface {
    network_interface_id = aws_network_interface.decoy_office.id
  }
  root_block_device {
    volume_size = 20
  }
  tags = { Name = "${local.name}-decoy" }
}

resource "aws_eip" "decoy" {
  network_interface = aws_network_interface.decoy_office.id
  depends_on        = [aws_internet_gateway.env]
}

resource "terraform_data" "decoy" {
  triggers_replace = [aws_instance.decoy.id]
  connection {
    type        = "ssh"
    host        = aws_eip.decoy.public_ip
    user        = "admin"
    private_key = file(pathexpand(var.ssh_private_key_file))
    timeout     = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-decoy.tgz\" --exclude=.git --exclude=.vagrant --exclude=.terraform --exclude=.isoloom-project* -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-decoy.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "remote-exec" {
    inline = [
      "set -e",
      "cloud-init status --wait >/dev/null 2>&1 || true",
      "sudo sh -c 'mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz'",
      "sudo sh -c 'for l in '\\''10.86.0.10 web'\\'' '\\''10.86.0.20 client'\\'' '\\''10.86.0.11 web'\\'' '\\''10.86.0.12 web'\\''; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'",
      "sudo sh -c 'dev=$(ip -o -4 addr show | grep -F '\\'' inet 10.86.0.40/'\\'' | awk '\\''{print $2; exit}'\\'')\nip addr replace 10.86.0.48/24 dev \"$dev\"\nip addr replace 10.86.0.49/24 dev \"$dev\"\nip addr replace 10.86.0.50/24 dev \"$dev\"\nip addr replace 10.86.0.51/24 dev \"$dev\"\nip addr replace 10.86.0.52/24 dev \"$dev\"\nip addr replace 10.86.0.53/24 dev \"$dev\"\nip addr replace 10.86.0.54/24 dev \"$dev\"\nip addr replace 10.86.0.55/24 dev \"$dev\"\nip addr replace 10.86.0.56/24 dev \"$dev\"\nip addr replace 10.86.0.57/24 dev \"$dev\"\nip addr replace 10.86.0.58/24 dev \"$dev\"\nip addr replace 10.86.0.59/24 dev \"$dev\"\nip addr replace 10.86.0.60/24 dev \"$dev\"\nip addr replace 10.86.0.61/24 dev \"$dev\"\nip addr replace 10.86.0.62/24 dev \"$dev\"\nip addr replace 10.86.0.63/24 dev \"$dev\"'",
      "sudo sh -c 'cd /opt/isoloom && sh -c '\\''sh provision/decoy.sh'\\'''",
      "sudo sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'"
    ]
  }
}

