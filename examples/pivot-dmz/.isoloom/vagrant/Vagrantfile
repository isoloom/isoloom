      systemctl enable isoloom-routes.service
      systemctl restart isoloom-routes.service
    SH
    m.vm.provision "shell", name: "checks", run: "never", path: "checks/user.sh", env: { "ISOLOOM_DERIVED" => ENV.fetch("ISOLOOM_DERIVED", "1") }
  end
end
