    m.vm.network "private_network", ip: "10.30.99.254", netmask: "255.255.255.0", virtualbox__intnet: "isoloom-pivot-dmz-access", libvirt__network_name: "isoloom-pivot-dmz-access", libvirt__dhcp_enabled: false
    m.vm.provider "virtualbox" do |v|
      v.name = "pivot-dmz · router"
      v.cpus = 1
      v.memory = 512
    end
    m.vm.provider "vmware_desktop" do |v|
      v.vmx["displayName"] = "pivot-dmz · router"
      v.vmx["numvcpus"] = "1"
      v.vmx["memsize"] = "512"
    end
    m.vm.provider "parallels" do |v|
      v.name = "pivot-dmz · router"
      v.cpus = 1
      v.memory = 512
    end
    m.vm.provider "libvirt" do |v, o|
      o.vm.box = "generic/debian12"
      v.cpus = 1
      v.memory = 512
    end
    m.vm.provision "shell", name: "router", inline: <<~'SH'
      set -e
      export DEBIAN_FRONTEND=noninteractive
      apt-get update -qq
      apt-get install -y -qq nftables >/dev/null
      echo 'net.ipv4.ip_forward=1' > /etc/sysctl.d/90-isoloom.conf
      sysctl -q -p /etc/sysctl.d/90-isoloom.conf
      cat > /etc/nftables.conf <<'NFT'
      flush ruleset
      table inet isoloom {
        chain forward {
          type filter hook forward priority 0; policy drop;
          ct state established,related accept
          ip saddr 10.30.99.0/24 ip daddr 10.30.10.0/24 accept
          ip saddr 10.30.10.0/24 ip daddr 10.30.20.0/24 meta l4proto { tcp, udp } th dport { 8080, 5432 } accept
          ip saddr 10.30.10.0/24 ip daddr 10.30.20.0/24 icmp type echo-request accept
        }
      }
      NFT
      systemctl enable nftables
      nft -f /etc/nftables.conf
    SH
  end

