# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  cd .isoloom/vagrant && vagrant up
# Stop:   cd .isoloom/vagrant && vagrant destroy -f

ROOT = File.expand_path("../..", __dir__)
# Copied into each VM: the project, without version control or generated files.
PROJECT = Dir.children(ROOT).reject { |e| [".git", ".vagrant"].include?(e) || e.start_with?(".isoloom") }.sort
# This host's CPU as QEMU names it: a machine built for another one runs emulated there.
HOST_ARCH = RbConfig::CONFIG["host_cpu"] =~ /arm|aarch64/ ? "aarch64" : "x86_64"
# ESXi (vagrant-vmware-esxi): ESXI_VIRTUAL_NETWORK lists port groups, comma-separated: the
# management network first, then one per network, in order (outside, dmz, lan); a missing one reuses the last.
ESXI_NETWORKS = ENV.fetch("ESXI_VIRTUAL_NETWORK", "VM Network").split(",").map(&:strip)
LAB_NETWORKS = ["outside", "dmz", "lan"]
def esxi_networks(nets)
  [ESXI_NETWORKS[0]] + nets.map { |n| ESXI_NETWORKS[1 + LAB_NETWORKS.index(n)] || ESXI_NETWORKS[-1] }
end

Vagrant.configure("2") do |config|
  config.vm.synced_folder ".", "/vagrant", disabled: true
  config.vm.boot_timeout = 900
  config.vm.provider "libvirt" do |v|
    v.default_prefix = "edge-firewall_"
  end

  config.vm.define "fw" do |m|
    m.vm.box = "bento/debian-12"
    m.vm.hostname = "fw"
    m.vm.network "private_network", ip: "10.70.0.2", netmask: "255.255.255.0", virtualbox__intnet: "isoloom-edge-firewall-outside", libvirt__network_name: "isoloom-edge-firewall-outside", libvirt__dhcp_enabled: false
    m.vm.network "private_network", ip: "10.70.10.1", netmask: "255.255.255.0", virtualbox__intnet: "isoloom-edge-firewall-dmz", libvirt__network_name: "isoloom-edge-firewall-dmz", libvirt__dhcp_enabled: false
    m.vm.network "private_network", ip: "10.70.20.1", netmask: "255.255.255.0", virtualbox__intnet: "isoloom-edge-firewall-lan", libvirt__network_name: "isoloom-edge-firewall-lan", libvirt__dhcp_enabled: false
    m.vm.provider "virtualbox" do |v|
      v.name = "edge-firewall · fw"
      v.linked_clone = true
      v.cpus = 1
      v.memory = 1024
    end
    m.vm.provider "vmware_desktop" do |v|
      v.vmx["displayName"] = "edge-firewall · fw"
      v.vmx["numvcpus"] = "1"
      v.vmx["memsize"] = "1024"
    end
    m.vm.provider "parallels" do |v|
      v.name = "edge-firewall · fw"
      v.linked_clone = true
      v.cpus = 1
      v.memory = 1024
    end
    m.vm.provider "utm" do |v|
      v.name = "edge-firewall · fw"
      v.cpus = 1
      v.memory = 1024
    end
    m.vm.provider "qemu" do |v, o|
      o.vm.box = "cloud-image/debian-12"
      o.vm.box_version = ">= 0"
      o.vm.box_architecture = "amd64"
      v.arch = "x86_64"
      v.smp = "cpus=1"
      v.memory = "1024M"
      v.ssh_auto_correct = true
      # No private network on QEMU: `fw` is on 3 networks, and QEMU gives a VM one.
      if "x86_64" != HOST_ARCH
        o.vm.boot_timeout = 3600
      end
    end
    m.vm.provider "vmware_esxi" do |v|
      v.esxi_hostname = ENV.fetch("ESXI_HOSTNAME", "")
      v.esxi_hostport = ENV.fetch("ESXI_HOSTPORT", "22").to_i
      v.esxi_username = ENV.fetch("ESXI_USERNAME", "root")
      v.esxi_password = "env:ESXI_PASSWORD"
      v.esxi_disk_store = ENV["ESXI_DATASTORE"] if ENV["ESXI_DATASTORE"]
      v.esxi_virtual_network = esxi_networks(["outside", "dmz", "lan"])
      v.guest_name = "edge-firewall-fw"
      v.guest_numvcpus = 1
      v.guest_memsize = 1024
    end
    m.vm.provider "libvirt" do |v, o|
      o.vm.box = "generic/debian12"
      v.cpus = 1
      v.memory = 1024
    end
    m.vm.provision "shell", name: "hosts", inline: "for l in '10.70.10.10 web www.edge.test' '10.70.20.20 cache' '10.70.0.10 user'; do grep -qxF \"$l\" /etc/hosts || echo \"$l\" >> /etc/hosts; done"
    m.vm.provision "shell", name: "forwarding", inline: "echo 'net.ipv4.ip_forward=1' > /etc/sysctl.d/90-isoloom.conf && sysctl -q -p /etc/sysctl.d/90-isoloom.conf"
    PROJECT.each do |entry|
      m.vm.provision "file", source: File.join(ROOT, entry), destination: "/tmp/isoloom-project/#{entry}"
    end
    m.vm.provision "shell", name: "project", inline: "rm -rf /opt/isoloom && mv /tmp/isoloom-project /opt/isoloom"
    m.vm.provision "shell", name: "provision/fw.sh", inline: "cd /opt/isoloom && sh provision/fw.sh"
    m.vm.provision "shell", name: "checks", run: "never", path: "checks/fw.sh", env: { "ISOLOOM_DERIVED" => ENV.fetch("ISOLOOM_DERIVED", "1") }
  end

