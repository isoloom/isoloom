isoloom_unit 'kafka' '[Unit]
Description=kafka, defined by Isoloom
Wants=network-online.target
After=network-online.target

[Service]
ExecStart="/bin/sh" "-c" "set -eu\nk=/var/lib/kafka; c=$$k/server.properties\njaas_quote() { printf '\''%%s'\'' \"$$1\" | sed -e '\''s/\\\\/\\\\\\\\/g'\'' -e '\''s/\"/\\\\\"/g'\''; }\nprops() { printf '\''%%s'\'' \"$$1\" | sed -e '\''s/\\\\/\\\\\\\\/g'\''; }\nu=$$(cat /etc/isoloom/services/bus/user); p=$$(cat /etc/isoloom/services/bus/password)\ncase \"$$u$$p\" in *'\''\n'\''*) echo '\''the Kafka login holds a line break, which its configuration cannot carry'\'' >&2; exit 1 ;; esac\ncase \"$$u\" in *,*|*]*|'\''\"'\''*'\''\"'\'') echo '\''the Kafka user holds `,` or `]`, or is quoted, which --add-scram cannot carry'\'' >&2; exit 1 ;; esac\njaas=$$(props \"org.apache.kafka.common.security.scram.ScramLoginModule required username=\\\"$$(jaas_quote \"$$u\")\\\" password=\\\"$$(jaas_quote \"$$p\")\\\";\")\nmkdir -p /var/lib/kafka/data\numask 077\ncat > /var/lib/kafka/server.properties <<EOF\nprocess.roles=broker,controller\nnode.id=1\ncontroller.quorum.voters=1@127.0.0.1:9093\nlisteners=SASL_PLAINTEXT://0.0.0.0:9092,CONTROLLER://127.0.0.1:9093\nadvertised.listeners=SASL_PLAINTEXT://bus.shop.internal:9092\nlistener.security.protocol.map=SASL_PLAINTEXT:SASL_PLAINTEXT,CONTROLLER:PLAINTEXT\ncontroller.listener.names=CONTROLLER\ninter.broker.listener.name=SASL_PLAINTEXT\nsasl.enabled.mechanisms=SCRAM-SHA-512\nsasl.mechanism.inter.broker.protocol=SCRAM-SHA-512\nlistener.name.sasl_plaintext.scram-sha-512.sasl.jaas.config=$$jaas\nlog.dirs=/var/lib/kafka/data\noffsets.topic.replication.factor=1\ntransaction.state.log.replication.factor=1\ntransaction.state.log.min.isr=1\nauto.create.topics.enable=false\nEOF\ncat > /var/lib/kafka/client.properties <<EOF\nsecurity.protocol=SASL_PLAINTEXT\nsasl.mechanism=SCRAM-SHA-512\nsasl.jaas.config=$$jaas\nEOF\nhex() { od -An -tx1 | tr -d '\'' \\n'\''; }\nsalt=$$(head -c 16 /dev/urandom | base64 | tr -d '\''\\n'\'')\nsalted=$$(openssl kdf -keylen 64 -kdfopt digest:SHA512 -kdfopt hexpass:\"$$(printf '\''%%s'\'' \"$$p\" | hex)\" -kdfopt hexsalt:\"$$(printf '\''%%s'\'' \"$$salt\" | base64 -d | hex)\" -kdfopt iter:4096 -binary PBKDF2 | base64 | tr -d '\''\\n'\'')\nprintf '\''SCRAM-SHA-512=[name=%%s,salt=%%s,saltedpassword=%%s,iterations=4096]'\'' \"$$u\" \"$$salt\" \"$$salted\" > /var/lib/kafka/scram.arg\n[ -f $$k/data/meta.properties ] || /opt/kafka/bin/kafka-storage.sh format -t \"$$(/opt/kafka/bin/kafka-storage.sh random-uuid)\" -c $$c --add-scram \"$$(cat $$k/scram.arg)\"\n(for t in orders:3:delete audit:3:delete; do n=$${t%%%%:*}; r=$${t#*:}; n_p=$${r%%%%:*}; cl=$${r#*:}; i=0; until /opt/kafka/bin/kafka-topics.sh --bootstrap-server 127.0.0.1:9092 --command-config $$k/client.properties --create --if-not-exists --topic \"$$n\" --partitions \"$$n_p\" --config cleanup.policy=\"$$cl\" >/dev/null 2>&1; do i=$$((i+1)); [ $$i -lt 90 ] || break; sleep 2; done; done) &\nexport KAFKA_HEAP_OPTS='\''-Xms512m -Xmx512m'\''\nexec /opt/kafka/bin/kafka-server-start.sh $$c"
Restart=on-failure

[Install]
WantedBy=multi-user.target
'
isoloom_service 'kafka' 'yes'
)
