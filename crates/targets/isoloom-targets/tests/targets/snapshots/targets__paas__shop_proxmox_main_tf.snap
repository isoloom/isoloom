    timeout             = "10m"
  }
  provisioner "remote-exec" {
    inline = [
      "sh -c 't=0\nif command -v cloud-init >/dev/null 2>&1; then sudo cloud-init status --wait >/dev/null 2>&1 || true; fi\nwhile :; do\ns=$(sudo head -n1 /var/lib/isoloom/ready 2>/dev/null)\ncase \"$s\" in\nready) echo \"files: set up\"; exit 0 ;;\n\"failed: \"*) echo \"files: its set-up stopped ($s); the end of /var/log/cloud-init-output.log:\"; sudo tail -n 40 /var/log/cloud-init-output.log 2>/dev/null; exit 1 ;;\nesac\nif [ \"$t\" -ge 2400 ]; then echo \"files: not set up after 2400 s ($${s:-no ready file}); the end of /var/log/cloud-init-output.log:\"; sudo tail -n 40 /var/log/cloud-init-output.log 2>/dev/null; exit 1; fi\nsleep 5; t=$((t + 5))\ndone'"
    ]
  }
}

