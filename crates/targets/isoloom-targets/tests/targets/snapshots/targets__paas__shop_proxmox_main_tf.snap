# Machine `web`.
resource "proxmox_virtual_environment_file" "web" {
  node_name    = var.node
  datastore_id = var.snippets_datastore
  content_type = "snippets"
  source_raw {
    file_name = "iso${var.slot}-web.yaml"
    data = format("#cloud-config\n%s", yamlencode({
      hostname = "web"
      users    = local.users
      packages = ["nftables", "curl", "netcat-openbsd"]
      write_files = [
        {
          path        = "/var/lib/isoloom/secrets.env"
          permissions = "0600"
          content = join("", [
            format("%s\n", "ISOLOOM_SECRET_DB_PASSWORD='${base64encode(var.ISOLOOM_SECRET_DB_PASSWORD)}'"),
            format("%s\n", "ISOLOOM_SECRET_FILES_KEY='${base64encode(var.ISOLOOM_SECRET_FILES_KEY)}'"),
            format("%s\n", "ISOLOOM_SECRET_FILES_SECRET='${base64encode(var.ISOLOOM_SECRET_FILES_SECRET)}'"),
            format("%s\n", "ISOLOOM_SECRET_BUS_USER='${base64encode(var.ISOLOOM_SECRET_BUS_USER)}'"),
            format("%s\n", "ISOLOOM_SECRET_BUS_PASSWORD='${base64encode(var.ISOLOOM_SECRET_BUS_PASSWORD)}'")
          ])
        },
        {
          path        = "/var/lib/isoloom/configure/configure-0.sh"
          encoding    = "gz+b64"
          permissions = "0700"
          content     = ""
        }
      ]
      runcmd = [
        "mkdir -p /var/lib/isoloom",
        "echo 'running: hosts file' > /var/lib/isoloom/ready; sh -c 'printf '\\''%s\\n'\\'' '\\''10.30.0.10 web web.shop.internal'\\'' '\\''10.30.0.40 db db.shop.internal'\\'' '\\''10.30.0.41 files files.shop.internal'\\'' '\\''10.30.0.42 bus bus.shop.internal'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done' || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }",
        "echo 'running: system settings' > /var/lib/isoloom/ready; sh -c 'set -e\nmkdir -p /etc/systemd/system.conf.d\ngrep -v -E '\\''^(DATABASE_HOST|DATABASE_PORT|DATABASE_NAME|DATABASE_USER|DATABASE_SSLMODE|DATABASE_PASSWORD_FILE|STORAGE_AUTH|STORAGE_WAIT|STORAGE_ENDPOINT_FILE|STORAGE_BUCKET_FILE|STORAGE_REGION_FILE|STORAGE_API_FILE|STORAGE_ACCESS_KEY_FILE|STORAGE_SECRET_KEY_FILE|BUS_AUTH|BUS_WAIT|BUS_BOOTSTRAP_FILE|BUS_SECURITY_PROTOCOL_FILE|BUS_SASL_MECHANISM_FILE|BUS_USER_FILE|BUS_PASSWORD_FILE)='\\'' /etc/environment > /etc/environment.isoloom 2>/dev/null || true\nprintf %s '\\''DATABASE_HOST=db.shop.internal\nDATABASE_PORT=5432\nDATABASE_NAME=shop\nDATABASE_USER=shop\nDATABASE_SSLMODE=prefer\nDATABASE_PASSWORD_FILE=/etc/isoloom/services/db/password\nSTORAGE_AUTH=keys\nSTORAGE_WAIT=/etc/isoloom/services/wait-for\nSTORAGE_ENDPOINT_FILE=/etc/isoloom/services/files/endpoint\nSTORAGE_BUCKET_FILE=/etc/isoloom/services/files/bucket\nSTORAGE_REGION_FILE=/etc/isoloom/services/files/region\nSTORAGE_API_FILE=/etc/isoloom/services/files/api\nSTORAGE_ACCESS_KEY_FILE=/etc/isoloom/services/files/access-key\nSTORAGE_SECRET_KEY_FILE=/etc/isoloom/services/files/secret-key\nBUS_AUTH=keys\nBUS_WAIT=/etc/isoloom/services/wait-for\nBUS_BOOTSTRAP_FILE=/etc/isoloom/services/bus/bootstrap\nBUS_SECURITY_PROTOCOL_FILE=/etc/isoloom/services/bus/security-protocol\nBUS_SASL_MECHANISM_FILE=/etc/isoloom/services/bus/sasl-mechanism\nBUS_USER_FILE=/etc/isoloom/services/bus/user\nBUS_PASSWORD_FILE=/etc/isoloom/services/bus/password\n'\\'' >> /etc/environment.isoloom && mv /etc/environment.isoloom /etc/environment\nprintf '\\''[Manager]\\nDefaultEnvironment=%s\\n'\\'' '\\''\"DATABASE_HOST=db.shop.internal\" \"DATABASE_PORT=5432\" \"DATABASE_NAME=shop\" \"DATABASE_USER=shop\" \"DATABASE_SSLMODE=prefer\" \"DATABASE_PASSWORD_FILE=/etc/isoloom/services/db/password\" \"STORAGE_AUTH=keys\" \"STORAGE_WAIT=/etc/isoloom/services/wait-for\" \"STORAGE_ENDPOINT_FILE=/etc/isoloom/services/files/endpoint\" \"STORAGE_BUCKET_FILE=/etc/isoloom/services/files/bucket\" \"STORAGE_REGION_FILE=/etc/isoloom/services/files/region\" \"STORAGE_API_FILE=/etc/isoloom/services/files/api\" \"STORAGE_ACCESS_KEY_FILE=/etc/isoloom/services/files/access-key\" \"STORAGE_SECRET_KEY_FILE=/etc/isoloom/services/files/secret-key\" \"BUS_AUTH=keys\" \"BUS_WAIT=/etc/isoloom/services/wait-for\" \"BUS_BOOTSTRAP_FILE=/etc/isoloom/services/bus/bootstrap\" \"BUS_SECURITY_PROTOCOL_FILE=/etc/isoloom/services/bus/security-protocol\" \"BUS_SASL_MECHANISM_FILE=/etc/isoloom/services/bus/sasl-mechanism\" \"BUS_USER_FILE=/etc/isoloom/services/bus/user\" \"BUS_PASSWORD_FILE=/etc/isoloom/services/bus/password\"'\\'' > /etc/systemd/system.conf.d/90-isoloom-environment.conf\nsystemctl daemon-reexec 2>/dev/null || true' || { echo 'failed: system settings' > /var/lib/isoloom/ready; exit 1; }",
        "echo 'running: files' > /var/lib/isoloom/ready; sh -c 'set -e\nmkdir -p '\\''/etc/isoloom/services'\\'' && printf '\\''%s'\\'' '\\''#!/bin/sh\n# wait-for FILE [SECONDS]: until FILE exists and isn'\\''\\'\\'''\\''t empty (a service'\\''\\'\\'''\\''s fact, which a cloud\n# delivers once it has made the service), at most SECONDS (default 300). Exits 1 on the timeout.\nf=$${1:?usage: wait-for FILE [SECONDS]}; t=$${2:-300}; i=0\nwhile [ ! -s \"$f\" ]; do\n  [ \"$i\" -lt \"$t\" ] || { echo \"wait-for: $f didn'\\''\\'\\'''\\''t appear in $t s\" >&2; exit 1; }\n  sleep 1; i=$((i + 1))\ndone\n'\\'' > '\\''/etc/isoloom/services/wait-for'\\'' && chown 0:0 '\\''/etc/isoloom/services/wait-for'\\'' && chmod '\\''0755'\\'' '\\''/etc/isoloom/services/wait-for'\\''\nmkdir -p '\\''/etc/isoloom/services/files'\\'' && printf '\\''%s'\\'' '\\''http://files.shop.internal:8333'\\'' > '\\''/etc/isoloom/services/files/endpoint'\\'' && chown 0:0 '\\''/etc/isoloom/services/files/endpoint'\\'' && chmod '\\''0644'\\'' '\\''/etc/isoloom/services/files/endpoint'\\''\nmkdir -p '\\''/etc/isoloom/services/files'\\'' && printf '\\''%s'\\'' '\\''uploads'\\'' > '\\''/etc/isoloom/services/files/bucket'\\'' && chown 0:0 '\\''/etc/isoloom/services/files/bucket'\\'' && chmod '\\''0644'\\'' '\\''/etc/isoloom/services/files/bucket'\\''\nmkdir -p '\\''/etc/isoloom/services/files'\\'' && printf '\\''%s'\\'' '\\''us-east-1'\\'' > '\\''/etc/isoloom/services/files/region'\\'' && chown 0:0 '\\''/etc/isoloom/services/files/region'\\'' && chmod '\\''0644'\\'' '\\''/etc/isoloom/services/files/region'\\''\nmkdir -p '\\''/etc/isoloom/services/files'\\'' && printf '\\''%s'\\'' '\\''s3'\\'' > '\\''/etc/isoloom/services/files/api'\\'' && chown 0:0 '\\''/etc/isoloom/services/files/api'\\'' && chmod '\\''0644'\\'' '\\''/etc/isoloom/services/files/api'\\''\nmkdir -p '\\''/etc/isoloom/services/bus'\\'' && printf '\\''%s'\\'' '\\''bus.shop.internal:9092'\\'' > '\\''/etc/isoloom/services/bus/bootstrap'\\'' && chown 0:0 '\\''/etc/isoloom/services/bus/bootstrap'\\'' && chmod '\\''0644'\\'' '\\''/etc/isoloom/services/bus/bootstrap'\\''\nmkdir -p '\\''/etc/isoloom/services/bus'\\'' && printf '\\''%s'\\'' '\\''SASL_PLAINTEXT'\\'' > '\\''/etc/isoloom/services/bus/security-protocol'\\'' && chown 0:0 '\\''/etc/isoloom/services/bus/security-protocol'\\'' && chmod '\\''0644'\\'' '\\''/etc/isoloom/services/bus/security-protocol'\\''\nmkdir -p '\\''/etc/isoloom/services/bus'\\'' && printf '\\''%s'\\'' '\\''SCRAM-SHA-512'\\'' > '\\''/etc/isoloom/services/bus/sasl-mechanism'\\'' && chown 0:0 '\\''/etc/isoloom/services/bus/sasl-mechanism'\\'' && chmod '\\''0644'\\'' '\\''/etc/isoloom/services/bus/sasl-mechanism'\\''' || { echo 'failed: files' > /var/lib/isoloom/ready; exit 1; }",
        "echo 'running: waiting for its secrets' > /var/lib/isoloom/ready; set -a && . /var/lib/isoloom/secrets.env && set +a && rm -f /var/lib/isoloom/secrets.env && sh -c 'set -e\numask 077\nmkdir -p /var/lib/isoloom/secrets\nchmod 700 /var/lib/isoloom/secrets\nv=\"$(printenv ISOLOOM_SECRET_DB_PASSWORD || true)\"; if [ -n \"$v\" ] || [ ! -e /var/lib/isoloom/secrets/db-password ]; then printf '\\''%s'\\'' \"$v\" | base64 -d > /var/lib/isoloom/secrets/db-password.new; mv -f /var/lib/isoloom/secrets/db-password.new /var/lib/isoloom/secrets/db-password; fi\nv=\"$(printenv ISOLOOM_SECRET_FILES_KEY || true)\"; if [ -n \"$v\" ] || [ ! -e /var/lib/isoloom/secrets/files-key ]; then printf '\\''%s'\\'' \"$v\" | base64 -d > /var/lib/isoloom/secrets/files-key.new; mv -f /var/lib/isoloom/secrets/files-key.new /var/lib/isoloom/secrets/files-key; fi\nv=\"$(printenv ISOLOOM_SECRET_FILES_SECRET || true)\"; if [ -n \"$v\" ] || [ ! -e /var/lib/isoloom/secrets/files-secret ]; then printf '\\''%s'\\'' \"$v\" | base64 -d > /var/lib/isoloom/secrets/files-secret.new; mv -f /var/lib/isoloom/secrets/files-secret.new /var/lib/isoloom/secrets/files-secret; fi\nv=\"$(printenv ISOLOOM_SECRET_BUS_USER || true)\"; if [ -n \"$v\" ] || [ ! -e /var/lib/isoloom/secrets/bus-user ]; then printf '\\''%s'\\'' \"$v\" | base64 -d > /var/lib/isoloom/secrets/bus-user.new; mv -f /var/lib/isoloom/secrets/bus-user.new /var/lib/isoloom/secrets/bus-user; fi\nv=\"$(printenv ISOLOOM_SECRET_BUS_PASSWORD || true)\"; if [ -n \"$v\" ] || [ ! -e /var/lib/isoloom/secrets/bus-password ]; then printf '\\''%s'\\'' \"$v\" | base64 -d > /var/lib/isoloom/secrets/bus-password.new; mv -f /var/lib/isoloom/secrets/bus-password.new /var/lib/isoloom/secrets/bus-password; fi\ntouch /var/lib/isoloom/secrets/.delivered\nmkdir -p /etc/isoloom\ncat > /etc/isoloom/apply-secrets.sh <<'\\''APPLY-SECRETS'\\''\n#!/bin/sh\n# The machine'\\''s secrets, put in place\ninstall -D -o 0 -g 0 -m 0400 /var/lib/isoloom/secrets/db-password '\\''/etc/isoloom/services/db/password'\\''\ninstall -D -o 0 -g 0 -m 0400 /var/lib/isoloom/secrets/files-key '\\''/etc/isoloom/services/files/access-key'\\''\ninstall -D -o 0 -g 0 -m 0400 /var/lib/isoloom/secrets/files-secret '\\''/etc/isoloom/services/files/secret-key'\\''\ninstall -D -o 0 -g 0 -m 0400 /var/lib/isoloom/secrets/bus-user '\\''/etc/isoloom/services/bus/user'\\''\ninstall -D -o 0 -g 0 -m 0400 /var/lib/isoloom/secrets/bus-password '\\''/etc/isoloom/services/bus/password'\\''\nexit 0\nAPPLY-SECRETS\nchmod +x /etc/isoloom/apply-secrets.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-apply-secrets.service <<'\\''UNIT'\\''\n[Unit]\nDescription=The machine'\\''s secrets, put in place\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=-/etc/isoloom/apply-secrets.sh\n\n[Install]\nWantedBy=multi-user.target\nUNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-apply-secrets.service\nsystemctl restart isoloom-apply-secrets.service\nelse\nmkdir -p /etc/local.d && ln -sf /etc/isoloom/apply-secrets.sh /etc/local.d/isoloom-apply-secrets.start\nrc-update add local default >/dev/null 2>&1 || true\n/etc/isoloom/apply-secrets.sh || true\nfi' || { echo 'failed: waiting for its secrets' > /var/lib/isoloom/ready; exit 1; }",
        "echo 'running: waiting for db' > /var/lib/isoloom/ready; sh -c 'i=0; until (bash -c '\\''</dev/tcp/db/5432'\\'' 2>/dev/null || nc -z -w 2 db 5432 2>/dev/null); do i=$((i+2)); if [ $i -ge 900 ]; then echo \"db didn'\\''t answer within 900s\" >&2; exit 1; fi; sleep 2; done; echo \"db answers\"' || { echo 'failed: waiting for db' > /var/lib/isoloom/ready; exit 1; }",
        "echo 'running: waiting for files' > /var/lib/isoloom/ready; sh -c 'i=0; until (bash -c '\\''</dev/tcp/files/8333'\\'' 2>/dev/null || nc -z -w 2 files 8333 2>/dev/null); do i=$((i+2)); if [ $i -ge 900 ]; then echo \"files didn'\\''t answer within 900s\" >&2; exit 1; fi; sleep 2; done; echo \"files answers\"' || { echo 'failed: waiting for files' > /var/lib/isoloom/ready; exit 1; }",
        "echo 'running: waiting for bus' > /var/lib/isoloom/ready; sh -c 'i=0; until (bash -c '\\''</dev/tcp/bus/9092'\\'' 2>/dev/null || nc -z -w 2 bus 9092 2>/dev/null); do i=$((i+2)); if [ $i -ge 900 ]; then echo \"bus didn'\\''t answer within 900s\" >&2; exit 1; fi; sleep 2; done; echo \"bus answers\"' || { echo 'failed: waiting for bus' > /var/lib/isoloom/ready; exit 1; }",
        "echo 'running: its configuration' > /var/lib/isoloom/ready; sh /var/lib/isoloom/configure/configure-0.sh || { echo 'failed: its configuration' > /var/lib/isoloom/ready; exit 1; }",
        "echo 'running: health check' > /var/lib/isoloom/ready; sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready' || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }"
      ]
    }))
  }
}

