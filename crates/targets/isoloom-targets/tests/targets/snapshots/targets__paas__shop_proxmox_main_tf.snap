---
source: crates/targets/isoloom-targets/tests/targets/paas.rs
expression: main
---
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  terraform -chdir=.isoloom/proxmox init && terraform -chdir=.isoloom/proxmox apply -var proxmox_endpoint=https://<server>:8006/ -var proxmox_api_token=<user@realm!name=secret> \
#           -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)" -var ssh_private_key_file=~/.ssh/id_ed25519
# Stop:   terraform -chdir=.isoloom/proxmox destroy (same variables)

terraform {
  required_version = ">= 1.6.0"
  backend "local" {}
  required_providers {
    proxmox = { source = "bpg/proxmox", version = "~> 0.116.1" }
    tls     = { source = "hashicorp/tls", version = "~> 4.4.1" }
  }
}

variable "proxmox_endpoint" {
  type        = string
  description = "https://<server>:8006/"
}

variable "proxmox_api_token" {
  type        = string
  default     = ""
  sensitive   = true
  description = "user@realm!name=secret; or use proxmox_username and proxmox_password"
}

variable "proxmox_username" {
  type    = string
  default = "root@pam"
}

variable "proxmox_password" {
  type      = string
  default   = ""
  sensitive = true
}

variable "proxmox_insecure" {
  type        = bool
  default     = false
  description = "Accept the server's self-signed certificate (TLS isn't verified)"
}

variable "proxmox_ssh_username" {
  type        = string
  default     = "root"
  description = "Uploading cloud-init snippets goes over SSH to the node"
}

variable "proxmox_ssh_private_key_file" {
  type    = string
  default = ""
}

variable "proxmox_ssh_address" {
  type        = string
  default     = ""
  description = "The node's SSH address, when the API reports one this machine can't reach"
}

variable "node" {
  type        = string
  description = "The Proxmox node the VMs go on (`pvesh get /nodes` lists them)"
  validation {
    condition     = var.node != ""
    error_message = "Set `node` to the Proxmox node the environment's VMs go on (`pvesh get /nodes` lists them)."
  }
}

variable "datastore" {
  type        = string
  default     = "local-lvm"
  description = "Where VM disks go"
}

variable "image_datastore" {
  type        = string
  default     = "local"
  description = "A datastore with 'iso' content, for cloud images"
}

variable "snippets_datastore" {
  type        = string
  default     = "local"
  description = "A datastore with 'snippets' content, for cloud-init"
}

variable "uplink_bridge" {
  type        = string
  default     = "vmbr0"
  description = "The bridge the router reaches the internet through"
}

variable "slot" {
  type        = number
  default     = 1
  description = "1 to 99, unique per environment on this server (SDN ids are short)"
  validation {
    condition     = var.slot >= 1 && var.slot <= 99
    error_message = "slot is 1 to 99."
  }
}

variable "ssh_public_key" {
  type        = string
  description = "The SSH public key the machines let in: Terraform signs in with its private half (`ssh_private_key_file`) to set them up or wait for their set-up, and so can you, to run the checks"
}

variable "ssh_private_key_file" {
  type        = string
  description = "The private key of ssh_public_key (a path, ~ allowed): Terraform signs in to the machines with it to bring the project in and wait for their set-up"
}

variable "ssh_proxy_host" {
  type        = string
  default     = ""
  description = "A SOCKS5 proxy (its host) Terraform's SSH connections go through first, for a server whose lab bridge only its node reaches; empty for none"
}

variable "ssh_proxy_port" {
  type        = number
  default     = 0
  description = "The port of ssh_proxy_host"
}

variable "ISOLOOM_SECRET_DB_PASSWORD" {
  type        = string
  sensitive   = true
  description = "The secret `db-password` (the spec's `secrets`), which the machines get as a file"
}

variable "ISOLOOM_SECRET_FILES_KEY" {
  type        = string
  sensitive   = true
  description = "The secret `files-key` (the spec's `secrets`), which the machines get as a file"
}

variable "ISOLOOM_SECRET_FILES_SECRET" {
  type        = string
  sensitive   = true
  description = "The secret `files-secret` (the spec's `secrets`), which the machines get as a file"
}

variable "ISOLOOM_SECRET_BUS_USER" {
  type        = string
  sensitive   = true
  description = "The secret `bus-user` (the spec's `secrets`), which the machines get as a file"
}

variable "ISOLOOM_SECRET_BUS_PASSWORD" {
  type        = string
  sensitive   = true
  description = "The secret `bus-password` (the spec's `secrets`), which the machines get as a file"
}

provider "proxmox" {
  endpoint  = var.proxmox_endpoint
  api_token = var.proxmox_api_token != "" ? var.proxmox_api_token : null
  username  = var.proxmox_api_token != "" ? null : var.proxmox_username
  password  = var.proxmox_api_token != "" ? null : var.proxmox_password
  insecure  = var.proxmox_insecure
  ssh {
    agent       = false
    username    = var.proxmox_ssh_username
    password    = var.proxmox_ssh_private_key_file != "" ? null : var.proxmox_password
    private_key = var.proxmox_ssh_private_key_file != "" ? file(var.proxmox_ssh_private_key_file) : null
    dynamic "node" {
      for_each = var.proxmox_ssh_address == "" ? [] : [1]
      content {
        name    = var.node
        address = var.proxmox_ssh_address
      }
    }
  }
}

# The project, written to /opt/isoloom in each machine that has steps; the `isoloom` user on every VM.
locals {
  zone          = "iso${var.slot}"
  root          = abspath("${path.module}/../..")
  project_files = [for f in local.project_paths : { path = "/opt/isoloom/${f}", encoding = "b64", content = filebase64("${local.root}/${f}") }]
  users         = var.ssh_public_key == "" ? [] : [{ name = "isoloom", sudo = "ALL=(ALL) NOPASSWD:ALL", shell = "/bin/bash", ssh_authorized_keys = [var.ssh_public_key] }]
}

# The environment's VMs and containers, together in a pool of their own.
resource "proxmox_virtual_environment_pool" "env" {
  pool_id = local.zone
  comment = "Isoloom: shop"
}

# Applies the SDN deletions on destroy, once the zone and its VNets are gone: every SDN object depends on it, so it goes last.
resource "proxmox_sdn_applier" "finalizer" {}

# The environment's networks: an SDN simple zone, a VNet per network.
resource "proxmox_sdn_zone_simple" "env" {
  id         = local.zone
  nodes      = [var.node]
  depends_on = [proxmox_sdn_applier.finalizer]
}

# Network `lab`: 10.30.0.0/24
resource "proxmox_sdn_vnet" "lab" {
  id   = "i${var.slot}n0"
  zone = proxmox_sdn_zone_simple.env.id
}

# Applies the SDN objects once created, and again whenever one of them is replaced.
resource "proxmox_sdn_applier" "env" {
  lifecycle {
    replace_triggered_by = [proxmox_sdn_zone_simple.env, proxmox_sdn_vnet.lab]
  }
  depends_on = [proxmox_sdn_vnet.lab]
}

# The `debian-12` cloud image, per environment: a shared file would go with whichever environment is destroyed first.
resource "proxmox_download_file" "debian_12" {
  node_name           = var.node
  datastore_id        = var.image_datastore
  content_type        = "iso"
  url                 = "https://cloud.debian.org/images/cloud/bookworm/20261015-2632/debian-12-genericcloud-amd64-20261015-2632.qcow2"
  file_name           = "iso${var.slot}-debian-12.img"
  overwrite_unmanaged = true
  checksum            = "56c0bd55b6623f2739f377e983d2872e7b208d0cb9c3ba4e93d3f72929026da03637c598b3bd472b29998c31c8a4c17d8e6ae1c556852a8b83a66a09bf5c2b37"
  checksum_algorithm  = "sha512"
}

# Network `lab`, for the machines' firewall rules.
resource "proxmox_virtual_environment_firewall_ipset" "lab" {
  name    = "iso${var.slot}n0"
  comment = "shop: network lab"
  cidr {
    name = "10.30.0.0/24"
  }
}

# The router: forwards between networks with the reach rules, and to the internet.
resource "proxmox_virtual_environment_file" "isoloom_router" {
  node_name    = var.node
  datastore_id = var.snippets_datastore
  content_type = "snippets"
  source_raw {
    file_name = "iso${var.slot}-isoloom-router.yaml"
    data = format("#cloud-config\n%s", yamlencode({
      hostname = "isoloom-router"
      users    = local.users
      packages = ["nftables", "qemu-guest-agent"]
      write_files = [
        {
          path    = "/etc/systemd/network/10-wan.network"
          content = join("\n", ["[Match]", "MACAddress=${format("02:15:%02x:00:00:00", var.slot)}", "", "[Network]", "DHCP=yes"])
        },
        {
          path    = "/etc/nftables.conf"
          content = "flush ruleset\ntable inet isoloom {\n  chain forward {\n    type filter hook forward priority 0; policy drop;\n    ct state established,related accept\n    ip daddr 10.30.0.10 tcp dport 80 ct status dnat accept\n    ip daddr 10.30.0.40 tcp dport 5432 ct status dnat accept\n    ip saddr { 10.30.0.0/24 } ip daddr != { 10.30.0.0/24 } accept\n  }\n  chain prerouting {\n    type nat hook prerouting priority -100;\n    ip saddr != { 10.30.0.0/24 } tcp dport 8080 dnat ip to 10.30.0.10:80\n    ip saddr != { 10.30.0.0/24 } tcp dport 5432 dnat ip to 10.30.0.40:5432\n  }\n  chain postrouting {\n    type nat hook postrouting priority 100;\n    ip saddr { 10.30.0.0/24 } ip daddr != { 10.30.0.0/24 } masquerade\n  }\n}\n"
        },
        { path = "/etc/sysctl.d/90-isoloom.conf", content = "net.ipv4.ip_forward=1\n" },
        {
          path = "/etc/systemd/network/20-lab.network"
          content = join("\n", [
            "[Match]",
            "MACAddress=${format("02:15:%02x:01:%02x:00", var.slot, 0)}",
            "",
            "[Network]",
            "Address=10.30.0.254/24",
            "ConfigureWithoutCarrier=yes"
          ])
        }
      ]
      runcmd = [
        "sysctl -p /etc/sysctl.d/90-isoloom.conf",
        "systemctl enable systemd-networkd",
        "systemctl restart systemd-networkd",
        "systemctl enable --now nftables",
        "nft -f /etc/nftables.conf",
        "i=0; while [ \"$i\" -lt 84 ] && ! ip -4 -o addr show scope global | awk '{split($4, a, \"/\"); print a[1]}' | grep -qvxF -e 10.30.0.254; do i=$((i + 1)); sleep 5; done; systemctl enable --now qemu-guest-agent"
      ]
    }))
  }
}

# The guest agent reports its uplink address (DHCP), for the published ports.
resource "proxmox_virtual_environment_vm" "isoloom_router" {
  name      = "iso${var.slot}-isoloom-router"
  node_name = var.node
  tags      = ["isoloom", "shop"]
  pool_id   = proxmox_virtual_environment_pool.env.pool_id
  on_boot   = false
  agent {
    enabled = true
    timeout = "8m"
    wait_for_ip {
      ipv4 = true
    }
  }
  stop_on_destroy = true
  lifecycle {
    postcondition {
      condition     = length([for a in try(flatten(self.ipv4_addresses), []) : a if a != "127.0.0.1" && !contains(["10.30.0.254"], a)]) > 0
      error_message = "VM `isoloom-router` got no IPv4 address on its uplink bridge `${var.uplink_bridge}` within 8m: the bridge has no DHCP, or no DNS or internet to install qemu-guest-agent, which reports the address (an IPv6 address alone isn't enough: the uplink needs IPv4 from DHCP). Give it an uplink bridge with DHCP and internet (`uplink_bridge`)."
    }
  }
  cpu {
    cores = 1
    type  = "host"
  }
  memory {
    dedicated = 512
  }
  disk {
    datastore_id = var.datastore
    file_id      = proxmox_download_file.debian_12.id
    interface    = "virtio0"
    size         = 8
  }
  network_device {
    bridge      = var.uplink_bridge
    mac_address = upper(format("02:15:%02x:00:00:00", var.slot))
  }
  network_device {
    bridge      = proxmox_sdn_vnet.lab.id
    mac_address = upper(format("02:15:%02x:01:%02x:00", var.slot, 0))
  }
  initialization {
    datastore_id      = var.datastore
    user_data_file_id = proxmox_virtual_environment_file.isoloom_router.id
    ip_config {
      ipv4 {
        address = "dhcp"
      }
    }
  }
  operating_system {
    type = "l26"
  }
  serial_device {}
  depends_on = [proxmox_sdn_applier.env]
}

# Machine `db`.
resource "proxmox_virtual_environment_file" "db" {
  node_name    = var.node
  datastore_id = var.snippets_datastore
  content_type = "snippets"
  source_raw {
    file_name = "iso${var.slot}-db.yaml"
    data = format("#cloud-config\n%s", yamlencode({
      hostname = "db"
      users    = local.users
      packages = ["nftables", "curl", "netcat-openbsd"]
      write_files = [
        {
          path        = "/var/lib/isoloom/secrets.env"
          permissions = "0600"
          content     = join("", [format("%s\n", "ISOLOOM_SECRET_DB_PASSWORD='${base64encode(var.ISOLOOM_SECRET_DB_PASSWORD)}'")])
        }
      ]
      runcmd = [
        "mkdir -p /var/lib/isoloom",
        "echo 'running: hosts file' > /var/lib/isoloom/ready; sh -c 'printf '\\''%s\\n'\\'' '\\''10.30.0.10 web web.shop.internal'\\'' '\\''10.30.0.40 db db.shop.internal'\\'' '\\''10.30.0.41 files files.shop.internal'\\'' '\\''10.30.0.42 bus bus.shop.internal'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done' || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }",
        "echo 'running: volume folders' > /var/lib/isoloom/ready; sh -c 'mkdir -p '\\''/var/lib/postgresql/data'\\''' || { echo 'failed: volume folders' > /var/lib/isoloom/ready; exit 1; }",
        "echo 'running: waiting for its secrets' > /var/lib/isoloom/ready; set -a && . /var/lib/isoloom/secrets.env && set +a && rm -f /var/lib/isoloom/secrets.env && sh -c 'set -e\numask 077\nmkdir -p /var/lib/isoloom/secrets\nchmod 700 /var/lib/isoloom/secrets\nv=\"$(printenv ISOLOOM_SECRET_DB_PASSWORD || true)\"; if [ -n \"$v\" ] || [ ! -e /var/lib/isoloom/secrets/db-password ]; then printf '\\''%s'\\'' \"$v\" | base64 -d > /var/lib/isoloom/secrets/db-password.new; mv -f /var/lib/isoloom/secrets/db-password.new /var/lib/isoloom/secrets/db-password; fi\ntouch /var/lib/isoloom/secrets/.delivered\nmkdir -p /etc/isoloom\ncat > /etc/isoloom/apply-secrets.sh <<'\\''APPLY-SECRETS'\\''\n#!/bin/sh\n# The machine'\\''s secrets, put in place\ninstall -D -o 0 -g 0 -m 0400 /var/lib/isoloom/secrets/db-password '\\''/run/isoloom/with/password'\\''\nexit 0\nAPPLY-SECRETS\nchmod +x /etc/isoloom/apply-secrets.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-apply-secrets.service <<'\\''UNIT'\\''\n[Unit]\nDescription=The machine'\\''s secrets, put in place\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=-/etc/isoloom/apply-secrets.sh\n\n[Install]\nWantedBy=multi-user.target\nUNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-apply-secrets.service\nsystemctl restart isoloom-apply-secrets.service\nelse\nmkdir -p /etc/local.d && ln -sf /etc/isoloom/apply-secrets.sh /etc/local.d/isoloom-apply-secrets.start\nrc-update add local default >/dev/null 2>&1 || true\n/etc/isoloom/apply-secrets.sh || true\nfi' || { echo 'failed: waiting for its secrets' > /var/lib/isoloom/ready; exit 1; }",
        "echo 'running: health check' > /var/lib/isoloom/ready; sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready' || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }"
      ]
    }))
  }
}

resource "proxmox_virtual_environment_vm" "db" {
  name      = "iso${var.slot}-db"
  node_name = var.node
  tags      = ["isoloom", "shop"]
  pool_id   = proxmox_virtual_environment_pool.env.pool_id
  on_boot   = false
  cpu {
    cores = 1
    type  = "host"
  }
  memory {
    dedicated = 1024
  }
  disk {
    datastore_id = var.datastore
    file_id      = proxmox_download_file.debian_12.id
    interface    = "virtio0"
    size         = 20
  }
  network_device {
    bridge   = proxmox_sdn_vnet.lab.id
    firewall = true
  }
  initialization {
    datastore_id      = var.datastore
    user_data_file_id = proxmox_virtual_environment_file.db.id
    dns {
      servers = ["1.1.1.1"]
      domain  = "shop.internal"
    }
    ip_config {
      ipv4 {
        address = "10.30.0.40/24"
        gateway = "10.30.0.254"
      }
    }
  }
  operating_system {
    type = "l26"
  }
  serial_device {}
  depends_on = [proxmox_virtual_environment_vm.isoloom_router]
}

# Machine `db`'s firewall: what reaches it, outside the guest.
resource "proxmox_virtual_environment_firewall_options" "db" {
  node_name     = var.node
  vm_id         = proxmox_virtual_environment_vm.db.vm_id
  enabled       = true
  input_policy  = "DROP"
  output_policy = "ACCEPT"
}

resource "proxmox_virtual_environment_firewall_rules" "db" {
  node_name = var.node
  vm_id     = proxmox_virtual_environment_vm.db.vm_id
  rule {
    type    = "in"
    action  = "ACCEPT"
    comment = "network lab"
    source  = "+${proxmox_virtual_environment_firewall_ipset.lab.name}"
  }
  rule {
    type    = "in"
    action  = "ACCEPT"
    comment = "published"
    proto   = "tcp"
    dport   = "5432"
  }
}

# Machine `files`.
resource "proxmox_virtual_environment_file" "files" {
  node_name    = var.node
  datastore_id = var.snippets_datastore
  content_type = "snippets"
  source_raw {
    file_name = "iso${var.slot}-files.yaml"
    data = format("#cloud-config\n%s", yamlencode({
      hostname = "files"
      users    = local.users
      packages = ["nftables", "curl", "netcat-openbsd"]
      write_files = [
        {
          path        = "/var/lib/isoloom/secrets.env"
          permissions = "0600"
          content = join("", [
            format("%s\n", "ISOLOOM_SECRET_FILES_KEY='${base64encode(var.ISOLOOM_SECRET_FILES_KEY)}'"),
            format("%s\n", "ISOLOOM_SECRET_FILES_SECRET='${base64encode(var.ISOLOOM_SECRET_FILES_SECRET)}'")
          ])
        },
        {
          path        = "/var/lib/isoloom/configure/configure-0.sh"
          encoding    = "gz+b64"
          permissions = "0700"
          content     = ""
        }
      ]
      runcmd = [
        "mkdir -p /var/lib/isoloom",
        "echo 'running: hosts file' > /var/lib/isoloom/ready; sh -c 'printf '\\''%s\\n'\\'' '\\''10.30.0.10 web web.shop.internal'\\'' '\\''10.30.0.40 db db.shop.internal'\\'' '\\''10.30.0.41 files files.shop.internal'\\'' '\\''10.30.0.42 bus bus.shop.internal'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done' || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }",
        "echo 'running: volume folders' > /var/lib/isoloom/ready; sh -c 'mkdir -p '\\''/var/lib/seaweedfs'\\''' || { echo 'failed: volume folders' > /var/lib/isoloom/ready; exit 1; }",
        "echo 'running: waiting for its secrets' > /var/lib/isoloom/ready; set -a && . /var/lib/isoloom/secrets.env && set +a && rm -f /var/lib/isoloom/secrets.env && sh -c 'set -e\numask 077\nmkdir -p /var/lib/isoloom/secrets\nchmod 700 /var/lib/isoloom/secrets\nv=\"$(printenv ISOLOOM_SECRET_FILES_KEY || true)\"; if [ -n \"$v\" ] || [ ! -e /var/lib/isoloom/secrets/files-key ]; then printf '\\''%s'\\'' \"$v\" | base64 -d > /var/lib/isoloom/secrets/files-key.new; mv -f /var/lib/isoloom/secrets/files-key.new /var/lib/isoloom/secrets/files-key; fi\nv=\"$(printenv ISOLOOM_SECRET_FILES_SECRET || true)\"; if [ -n \"$v\" ] || [ ! -e /var/lib/isoloom/secrets/files-secret ]; then printf '\\''%s'\\'' \"$v\" | base64 -d > /var/lib/isoloom/secrets/files-secret.new; mv -f /var/lib/isoloom/secrets/files-secret.new /var/lib/isoloom/secrets/files-secret; fi\ntouch /var/lib/isoloom/secrets/.delivered\nmkdir -p /etc/isoloom\ncat > /etc/isoloom/apply-secrets.sh <<'\\''APPLY-SECRETS'\\''\n#!/bin/sh\n# The machine'\\''s secrets, put in place\ninstall -D -o 0 -g 0 -m 0400 /var/lib/isoloom/secrets/files-key '\\''/etc/isoloom/services/files/access-key'\\''\ninstall -D -o 0 -g 0 -m 0400 /var/lib/isoloom/secrets/files-secret '\\''/etc/isoloom/services/files/secret-key'\\''\nexit 0\nAPPLY-SECRETS\nchmod +x /etc/isoloom/apply-secrets.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-apply-secrets.service <<'\\''UNIT'\\''\n[Unit]\nDescription=The machine'\\''s secrets, put in place\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=-/etc/isoloom/apply-secrets.sh\n\n[Install]\nWantedBy=multi-user.target\nUNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-apply-secrets.service\nsystemctl restart isoloom-apply-secrets.service\nelse\nmkdir -p /etc/local.d && ln -sf /etc/isoloom/apply-secrets.sh /etc/local.d/isoloom-apply-secrets.start\nrc-update add local default >/dev/null 2>&1 || true\n/etc/isoloom/apply-secrets.sh || true\nfi' || { echo 'failed: waiting for its secrets' > /var/lib/isoloom/ready; exit 1; }",
        "echo 'running: its configuration' > /var/lib/isoloom/ready; sh /var/lib/isoloom/configure/configure-0.sh || { echo 'failed: its configuration' > /var/lib/isoloom/ready; exit 1; }",
        "echo 'running: health check' > /var/lib/isoloom/ready; sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready' || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }"
      ]
    }))
  }
}

resource "proxmox_virtual_environment_vm" "files" {
  name      = "iso${var.slot}-files"
  node_name = var.node
  tags      = ["isoloom", "shop"]
  pool_id   = proxmox_virtual_environment_pool.env.pool_id
  on_boot   = false
  cpu {
    cores = 1
    type  = "host"
  }
  memory {
    dedicated = 1024
  }
  disk {
    datastore_id = var.datastore
    file_id      = proxmox_download_file.debian_12.id
    interface    = "virtio0"
    size         = 20
  }
  network_device {
    bridge   = proxmox_sdn_vnet.lab.id
    firewall = true
  }
  initialization {
    datastore_id      = var.datastore
    user_data_file_id = proxmox_virtual_environment_file.files.id
    dns {
      servers = ["1.1.1.1"]
      domain  = "shop.internal"
    }
    ip_config {
      ipv4 {
        address = "10.30.0.41/24"
        gateway = "10.30.0.254"
      }
    }
  }
  operating_system {
    type = "l26"
  }
  serial_device {}
  depends_on = [proxmox_virtual_environment_vm.isoloom_router]
}

# Machine `files`'s firewall: what reaches it, outside the guest.
resource "proxmox_virtual_environment_firewall_options" "files" {
  node_name     = var.node
  vm_id         = proxmox_virtual_environment_vm.files.vm_id
  enabled       = true
  input_policy  = "DROP"
  output_policy = "ACCEPT"
}

resource "proxmox_virtual_environment_firewall_rules" "files" {
  node_name = var.node
  vm_id     = proxmox_virtual_environment_vm.files.vm_id
  rule {
    type    = "in"
    action  = "ACCEPT"
    comment = "network lab"
    source  = "+${proxmox_virtual_environment_firewall_ipset.lab.name}"
  }
}

# Machine `bus`.
resource "proxmox_virtual_environment_file" "bus" {
  node_name    = var.node
  datastore_id = var.snippets_datastore
  content_type = "snippets"
  source_raw {
    file_name = "iso${var.slot}-bus.yaml"
    data = format("#cloud-config\n%s", yamlencode({
      hostname = "bus"
      users    = local.users
      packages = ["nftables", "curl", "netcat-openbsd"]
      write_files = [
        {
          path        = "/var/lib/isoloom/secrets.env"
          permissions = "0600"
          content = join("", [
            format("%s\n", "ISOLOOM_SECRET_BUS_USER='${base64encode(var.ISOLOOM_SECRET_BUS_USER)}'"),
            format("%s\n", "ISOLOOM_SECRET_BUS_PASSWORD='${base64encode(var.ISOLOOM_SECRET_BUS_PASSWORD)}'")
          ])
        },
        {
          path        = "/var/lib/isoloom/configure/configure-0.sh"
          encoding    = "gz+b64"
          permissions = "0700"
          content     = ""
        }
      ]
      runcmd = [
        "mkdir -p /var/lib/isoloom",
        "echo 'running: hosts file' > /var/lib/isoloom/ready; sh -c 'printf '\\''%s\\n'\\'' '\\''10.30.0.10 web web.shop.internal'\\'' '\\''10.30.0.40 db db.shop.internal'\\'' '\\''10.30.0.41 files files.shop.internal'\\'' '\\''10.30.0.42 bus bus.shop.internal'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done' || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }",
        "echo 'running: volume folders' > /var/lib/isoloom/ready; sh -c 'mkdir -p '\\''/var/lib/kafka'\\''' || { echo 'failed: volume folders' > /var/lib/isoloom/ready; exit 1; }",
        "echo 'running: waiting for its secrets' > /var/lib/isoloom/ready; set -a && . /var/lib/isoloom/secrets.env && set +a && rm -f /var/lib/isoloom/secrets.env && sh -c 'set -e\numask 077\nmkdir -p /var/lib/isoloom/secrets\nchmod 700 /var/lib/isoloom/secrets\nv=\"$(printenv ISOLOOM_SECRET_BUS_USER || true)\"; if [ -n \"$v\" ] || [ ! -e /var/lib/isoloom/secrets/bus-user ]; then printf '\\''%s'\\'' \"$v\" | base64 -d > /var/lib/isoloom/secrets/bus-user.new; mv -f /var/lib/isoloom/secrets/bus-user.new /var/lib/isoloom/secrets/bus-user; fi\nv=\"$(printenv ISOLOOM_SECRET_BUS_PASSWORD || true)\"; if [ -n \"$v\" ] || [ ! -e /var/lib/isoloom/secrets/bus-password ]; then printf '\\''%s'\\'' \"$v\" | base64 -d > /var/lib/isoloom/secrets/bus-password.new; mv -f /var/lib/isoloom/secrets/bus-password.new /var/lib/isoloom/secrets/bus-password; fi\ntouch /var/lib/isoloom/secrets/.delivered\nmkdir -p /etc/isoloom\ncat > /etc/isoloom/apply-secrets.sh <<'\\''APPLY-SECRETS'\\''\n#!/bin/sh\n# The machine'\\''s secrets, put in place\ninstall -D -o 0 -g 0 -m 0400 /var/lib/isoloom/secrets/bus-user '\\''/etc/isoloom/services/bus/user'\\''\ninstall -D -o 0 -g 0 -m 0400 /var/lib/isoloom/secrets/bus-password '\\''/etc/isoloom/services/bus/password'\\''\nexit 0\nAPPLY-SECRETS\nchmod +x /etc/isoloom/apply-secrets.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-apply-secrets.service <<'\\''UNIT'\\''\n[Unit]\nDescription=The machine'\\''s secrets, put in place\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=-/etc/isoloom/apply-secrets.sh\n\n[Install]\nWantedBy=multi-user.target\nUNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-apply-secrets.service\nsystemctl restart isoloom-apply-secrets.service\nelse\nmkdir -p /etc/local.d && ln -sf /etc/isoloom/apply-secrets.sh /etc/local.d/isoloom-apply-secrets.start\nrc-update add local default >/dev/null 2>&1 || true\n/etc/isoloom/apply-secrets.sh || true\nfi' || { echo 'failed: waiting for its secrets' > /var/lib/isoloom/ready; exit 1; }",
        "echo 'running: its configuration' > /var/lib/isoloom/ready; sh /var/lib/isoloom/configure/configure-0.sh || { echo 'failed: its configuration' > /var/lib/isoloom/ready; exit 1; }",
        "echo 'running: health check' > /var/lib/isoloom/ready; sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready' || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }"
      ]
    }))
  }
}

