      ipv4 {
        address = "10.30.0.10/24"
        gateway = "10.30.0.254"
      }
    }
  }
  operating_system {
    type = "l26"
  }
  serial_device {}
  depends_on = [
    proxmox_virtual_environment_vm.isoloom_router,
    proxmox_virtual_environment_vm.db,
    proxmox_virtual_environment_vm.files,
    proxmox_virtual_environment_vm.bus
  ]
}

# Machine `web`'s firewall: what reaches it, outside the guest.
resource "proxmox_virtual_environment_firewall_options" "web" {
  node_name     = var.node
  vm_id         = proxmox_virtual_environment_vm.web.vm_id
  enabled       = true
  input_policy  = "DROP"
  output_policy = "ACCEPT"
}

resource "proxmox_virtual_environment_firewall_rules" "web" {
  node_name = var.node
  vm_id     = proxmox_virtual_environment_vm.web.vm_id
  rule {
    type    = "in"
    action  = "ACCEPT"
    comment = "network lab"
    source  = "+${proxmox_virtual_environment_firewall_ipset.lab.name}"
  }
  rule {
    type    = "in"
    action  = "ACCEPT"
    comment = "published"
    proto   = "tcp"
    dport   = "80"
  }
}

resource "terraform_data" "isoloom_ready_db" {
  triggers_replace = [proxmox_virtual_environment_vm.db.id]
  connection {
    type                = "ssh"
    host                = "10.30.0.40"
    user                = "isoloom"
    private_key         = file(pathexpand(var.ssh_private_key_file))
    bastion_host        = local.router_address
    bastion_user        = "isoloom"
    bastion_private_key = file(pathexpand(var.ssh_private_key_file))
    proxy_scheme        = var.ssh_proxy_host != "" ? "socks5" : null
    proxy_host          = var.ssh_proxy_host != "" ? var.ssh_proxy_host : null
    proxy_port          = var.ssh_proxy_host != "" ? var.ssh_proxy_port : null
    timeout             = "10m"
  }
  provisioner "remote-exec" {
    inline = [
      "sh -c 't=0\nif command -v cloud-init >/dev/null 2>&1; then sudo cloud-init status --wait >/dev/null 2>&1 || true; fi\nwhile :; do\ns=$(sudo head -n1 /var/lib/isoloom/ready 2>/dev/null)\ncase \"$s\" in\nready) echo \"db: set up\"; exit 0 ;;\n\"failed: \"*) echo \"db: its set-up stopped ($s); the end of /var/log/cloud-init-output.log:\"; sudo tail -n 40 /var/log/cloud-init-output.log 2>/dev/null; exit 1 ;;\nesac\nif [ \"$t\" -ge 2400 ]; then echo \"db: not set up after 2400 s ($${s:-no ready file}); the end of /var/log/cloud-init-output.log:\"; sudo tail -n 40 /var/log/cloud-init-output.log 2>/dev/null; exit 1; fi\nsleep 5; t=$((t + 5))\ndone'"
    ]
  }
}

resource "terraform_data" "isoloom_ready_files" {
  triggers_replace = [proxmox_virtual_environment_vm.files.id]
  connection {
    type                = "ssh"
    host                = "10.30.0.41"
