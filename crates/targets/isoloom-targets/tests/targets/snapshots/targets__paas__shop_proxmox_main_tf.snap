locals {
  router_address = try([for a in try(flatten(proxmox_virtual_environment_vm.isoloom_router.ipv4_addresses), []) : a if a != "127.0.0.1" && !contains(["10.30.0.254"], a)][0], "")
}

# The router's uplink address: the environment's way in.
output "ip" {
  value = local.router_address
}

# Each Linux machine's set-up progress (`isoloom-ready/1`: `running: <step>`, `failed: <step>`, `ready`).
output "ready_file" {
  value = "/var/lib/isoloom/ready"
}

# Published services, from the router's uplink address.
output "published" {
  value = { "web/shop" = "${local.router_address}:8080", "db/postgres" = "${local.router_address}:5432" }
}

# The machines, through the router: ssh -J isoloom@<ip> isoloom@<machine>.
output "machines" {
  value = { web = "10.30.0.10", db = "10.30.0.40", files = "10.30.0.41", bus = "10.30.0.42" }
}

output "ssh_user" {
  value = "isoloom"
}

# The checks: each runner piped to its machine (ssh -J isoloom@<ip> isoloom@<host> sh -s < <script>).
output "checks" {
  value = [
    {
      position = "isoloom-networks"
      machine  = "db"
      host     = "10.30.0.40"
      user     = "isoloom"
      script   = ".isoloom/proxmox/checks/isoloom-networks.sh"
    },
    {
      position = "web"
      machine  = "web"
      host     = "10.30.0.10"
      user     = "isoloom"
      script   = ".isoloom/proxmox/checks/web.sh"
    },
    {
      position = "db"
      machine  = "db"
      host     = "10.30.0.40"
      user     = "isoloom"
      script   = ".isoloom/proxmox/checks/db.sh"
    },
    {
      position = "files"
      machine  = "files"
      host     = "10.30.0.41"
      user     = "isoloom"
      script   = ".isoloom/proxmox/checks/files.sh"
    },
    {
      position = "bus"
      machine  = "bus"
      host     = "10.30.0.42"
      user     = "isoloom"
      script   = ".isoloom/proxmox/checks/bus.sh"
    }
  ]
}

# db's VM id: its console is asked for by it (Proxmox's vncproxy).
output "vm_id_db" {
  value = proxmox_virtual_environment_vm.db.vm_id
}

# files's VM id: its console is asked for by it (Proxmox's vncproxy).
output "vm_id_files" {
  value = proxmox_virtual_environment_vm.files.vm_id
}

# bus's VM id: its console is asked for by it (Proxmox's vncproxy).
output "vm_id_bus" {
  value = proxmox_virtual_environment_vm.bus.vm_id
}

# web's VM id: its console is asked for by it (Proxmox's vncproxy).
output "vm_id_web" {
  value = proxmox_virtual_environment_vm.web.vm_id
}

# The project's files the machines don't get: what .isoloomignore at the project's root lists
# (gitignore-style: one pattern per line, `#` comments, `!` brings a path back, a trailing `/`
# matches folders only, a `/` at the start or in the middle anchors the pattern at the root; `*`,
# `?`, `[abc]`, `**`; the last pattern matching a path, or a folder it is in, decides), then
# Isoloom's outputs, version control and the tools' state. Read as regular expressions, as the
# Vagrantfiles do.
locals {
  project_ignore_lines = [for l in split("\n", "${replace(try(file("${local.root}/.isoloomignore"), ""), "\r", "")}\n/.isoloom*\n.git/\n.terraform/\n*.tfstate\n*.tfstate.*\n.terraform.tfstate.lock.info\ncrash.log\ncrash.*.log\n.vagrant/\n") : trimspace(l)]
  project_ignore_pats  = [for l in local.project_ignore_lines : { keep = startswith(l, "!"), pat = trimprefix(l, "!") } if l != "" && !startswith(l, "#")]
  project_ignore_globs = [for r in local.project_ignore_pats : merge(r, { glob = trimsuffix(trimsuffix(trimsuffix(r.pat, "/"), "/**"), "/") })]
  project_ignore = [for r in local.project_ignore_globs : {
    keep = r.keep
    re = format(r.glob == r.pat ? "^%s(/|$)" : "^%s/", replace(replace(replace(replace(replace(replace(replace(replace(
      length(split("/", r.glob)) > 1 ? trimprefix(r.glob, "/") : "**/${r.glob}",
    "/[.+^$(){}|\\\\]/", "\\$0"), "[!", "[^"), "**/", "\u0001"), "**", "\u0002"), "*", "[^/]*"), "?", "[^/]"), "\u0001", "(.*/)?"), "\u0002", ".*"))
  } if r.glob != ""]
  # Each file: whether it goes (the last matching pattern decides; none: it goes).
  project_keep  = { for f in fileset(local.root, "**") : f => reverse(concat([true], [for r in local.project_ignore : r.keep if length(regexall(r.re, f)) > 0]))[0] }
  project_paths = [for f, keep in local.project_keep : f if keep]
}
### <gzip 1> decoded
(
set -eu
isoloom_changed() {
  echo "isoloom: changed $*"
  if [ -n "${ISOLOOM_CHANGED:-}" ]; then
    mkdir -p "${ISOLOOM_CHANGED%/*}" && : >"$ISOLOOM_CHANGED"
  fi
}
isoloom_fail() {
  echo "isoloom: $*" >&2
  return 1
}
isoloom_pm() {
  for _pm in apt-get dnf yum apk; do
    if command -v "$_pm" >/dev/null 2>&1; then
      echo "${_pm%-get}"
      return 0
    fi
  done
  isoloom_fail "no package manager Isoloom knows (apt-get, dnf, yum, apk)"
}
isoloom_installed() {
  _name=${2%%=*}
  _version=
  case $2 in *=*) _version=${2#*=} ;; esac
  case $1 in
    apt)
      # shellcheck disable=SC2016 # dpkg-query's own fields, not the shell's.
      _have=$(dpkg-query -W -f='${Status} ${Version}' "$_name" 2>/dev/null) || return 1
      case $_have in "install ok installed "*) ;; *) return 1 ;; esac
      [ -z "$_version" ] || [ "${_have#install ok installed }" = "$_version" ]
      ;;
    dnf | yum)
      if [ -z "$_version" ]; then
        rpm -q --whatprovides "$_name" >/dev/null 2>&1
      else
        rpm -q "$_name-$_version" >/dev/null 2>&1
      fi
      ;;
    apk)
      if [ -z "$_version" ]; then
        apk info -e "$_name" >/dev/null 2>&1
      else
        apk list --installed "$_name" 2>/dev/null | grep -q "^$_name-$_version "
      fi
      ;;
    *) return 1 ;;
  esac
}
isoloom_install() {
  _pm=$1
  shift
  case $_pm in
    apt)
      apt-get update -qq &&
        DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends "$@" >/dev/null &&
        apt-get clean && rm -rf /var/lib/apt/lists/*
      ;;
    dnf | yum)
      for _spec do
        shift
        case $_spec in
          *=*) set -- "$@" "${_spec%%=*}-${_spec#*=}" ;;
          *) set -- "$@" "$_spec" ;;
        esac
      done
      "$_pm" install -y -q "$@" >/dev/null && "$_pm" clean all >/dev/null
      ;;
    apk) apk add --no-cache -q "$@" ;;
    *) return 1 ;;
  esac
}
isoloom_packages() {
  _pm=$(isoloom_pm) || return 1
  for _spec do
    shift
    isoloom_installed "$_pm" "$_spec" || set -- "$@" "$_spec"
  done
  [ "$#" -eq 0 ] && return 0
  isoloom_install "$_pm" "$@" || isoloom_fail "installing $* failed" || return 1
  isoloom_changed "packages $*"
}
isoloom_need() {
  _cmd=$1
  shift
  command -v "$_cmd" >/dev/null 2>&1 && return 0
  _pm=$(isoloom_pm) || return 1
  isoloom_install "$_pm" "$@" || isoloom_fail "installing $* (for $_cmd) failed" || return 1
  isoloom_changed "packages $*"
}
isoloom_sha256() {
  sha256sum "$1" | cut -d ' ' -f 1
}
isoloom_fetch() {
  if ! command -v curl >/dev/null 2>&1 && command -v wget >/dev/null 2>&1; then
    wget -q -O "$2" "$1"
    return
  fi
  isoloom_need curl curl ca-certificates || return 1
  if [ ! -s /etc/ssl/certs/ca-certificates.crt ] && [ ! -s /etc/pki/tls/certs/ca-bundle.crt ]; then
    _pm=$(isoloom_pm) || return 1
    isoloom_install "$_pm" ca-certificates || isoloom_fail "installing ca-certificates failed" || return 1
    isoloom_changed "packages ca-certificates"
  fi
  curl -fsSL --retry 3 -o "$2" "$1"
}
isoloom_put() {
  if [ -f "$2" ] && [ ! -L "$2" ] && [ "$(isoloom_sha256 "$1")" = "$(isoloom_sha256 "$2")" ]; then
    return 0
  fi
  mkdir -p "$(dirname "$2")" && rm -rf "$2" && cp "$1" "$2" || isoloom_fail "writing $2 failed" || return 1
  isoloom_changed "$2"
}
isoloom_text() {
  _tmp=$(mktemp) || return 1
  printf '%s' "$2" >"$_tmp" && isoloom_put "$_tmp" "$1"
  _status=$?
  rm -f "$_tmp"
  return "$_status"
}
isoloom_download() {
  if [ -f "$2" ] && [ "$(isoloom_sha256 "$2")" = "$3" ]; then
    return 0
  fi
  mkdir -p "$(dirname "$2")" || return 1
  _tmp="$2.isoloom-download"
  isoloom_fetch "$1" "$_tmp" || {
    rm -f "$_tmp"
    isoloom_fail "downloading $1 failed"
    return 1
  }
  _got=$(isoloom_sha256 "$_tmp")
  if [ "$_got" != "$3" ]; then
    rm -f "$_tmp"
    isoloom_fail "$1 has SHA-256 $_got, not $3: the file changed upstream, or the pin is wrong"
    return 1
  fi
  mv -f "$_tmp" "$2" && isoloom_changed "$2"
}
isoloom_attrs() {
  _owner=$2
  _group=$3
  if [ -n "$_owner" ] && [ -z "$_group" ]; then
    _group=$(id -gn "$_owner") || return 1
  fi
  if [ -n "$_owner" ] && [ "$(stat -c %U "$1")" != "$_owner" ]; then
    chown -h "$_owner" "$1" || return 1
    isoloom_changed "owner of $1"
  fi
  if [ -n "$_group" ] && [ "$(stat -c %G "$1")" != "$_group" ]; then
    chgrp -h "$_group" "$1" || return 1
    isoloom_changed "group of $1"
  fi
  if [ -n "$4" ]; then
    _want=${4#"${4%%[!0]*}"}
    if [ "$(stat -c %a "$1")" != "${_want:-0}" ]; then
      chmod "$4" "$1" || return 1
      isoloom_changed "mode of $1"
    fi
  fi
}
isoloom_arch() {
  case $(uname -m) in
    x86_64 | amd64) echo amd64 ;;
    aarch64 | arm64) echo arm64 ;;
    *) uname -m ;;
  esac
}
isoloom_file() {
  _path=$1 _file_owner=$2 _file_group=$3 _file_mode=$4 _state=$5
  shift 5
  case $_state in
    directory)
      if [ ! -d "$_path" ] || [ -L "$_path" ]; then
        rm -rf "$_path" && mkdir -p "$_path" || return 1
        isoloom_changed "$_path"
      fi
      ;;
    absent)
      if [ -e "$_path" ] || [ -L "$_path" ]; then
        rm -rf "$_path" || return 1
        isoloom_changed "$_path removed"
      fi
      return 0
      ;;
    link)
      if [ ! -L "$_path" ] || [ "$(readlink "$_path")" != "$1" ]; then
        mkdir -p "$(dirname "$_path")" && rm -rf "$_path" && ln -s "$1" "$_path" || return 1
        isoloom_changed "$_path"
      fi
      ;;
    download) isoloom_download "$1" "$_path" "$2" || return 1 ;;
    download-arch)
      _arch=$(isoloom_arch)
      while [ $# -ge 3 ] && [ "$1" != "$_arch" ]; do
        shift 3
      done
      if [ $# -lt 3 ]; then
        isoloom_fail "$_path has no download for this machine's architecture ($_arch)"
        return 1
      fi
      isoloom_download "$2" "$_path" "$3" || return 1
      ;;
    *) isoloom_fail "no file state $_state" || return 1 ;;
  esac
  isoloom_attrs "$_path" "$_file_owner" "$_file_group" "$_file_mode"
}
isoloom_restart_due() {
  [ -n "${ISOLOOM_CHANGED:-}" ] && [ -e "$ISOLOOM_CHANGED" ]
}
isoloom_unit() {
  case $2 in
    '#!/sbin/openrc-run'*)
      isoloom_text "/etc/init.d/$1" "$2" && isoloom_attrs "/etc/init.d/$1" root root 0755
      ;;
    *)
      _unit=/etc/systemd/system/$1.service
      _old=
      [ ! -f "$_unit" ] || _old=$(isoloom_sha256 "$_unit")
      isoloom_text "$_unit" "$2" || return 1
      if [ "$_old" != "$(isoloom_sha256 "$_unit")" ] && [ -d /run/systemd/system ]; then
        systemctl daemon-reload
      fi
      ;;
  esac
}
isoloom_service() {
  if [ -d /run/systemd/system ]; then
    isoloom_systemd "$@"
  elif command -v rc-service >/dev/null 2>&1 && [ -d /run/openrc ]; then
    isoloom_openrc "$@"
  else
    echo "isoloom: no init system runs here: $1 is left to the container's supervisor"
  fi
}
isoloom_systemd() {
  if [ "$2" = no ]; then
    if systemctl is-enabled --quiet "$1" 2>/dev/null; then
      systemctl disable --quiet "$1" || return 1
      isoloom_changed "$1 disabled"
    fi
    if systemctl is-active --quiet "$1"; then
      systemctl stop "$1" || return 1
      isoloom_changed "$1 stopped"
    fi
    return 0
  fi
  if ! systemctl is-enabled --quiet "$1" 2>/dev/null; then
    systemctl enable --quiet "$1" || return 1
    isoloom_changed "$1 enabled"
  fi
  if ! systemctl is-active --quiet "$1"; then
    systemctl start "$1" && isoloom_changed "$1 started"
  elif isoloom_restart_due; then
    systemctl restart "$1" && echo "isoloom: restarted $1"
  fi
}
isoloom_openrc() {
  _enabled=$(rc-update show default | awk -v u="$1" '$1 == u { print "yes" }')
  if [ "$2" = no ]; then
    if [ -n "$_enabled" ]; then
      rc-update -q del "$1" default || return 1
      isoloom_changed "$1 disabled"
    fi
    if rc-service -q "$1" status >/dev/null 2>&1; then
      rc-service -q "$1" stop || return 1
      isoloom_changed "$1 stopped"
    fi
    return 0
  fi
  if [ -z "$_enabled" ]; then
    rc-update -q add "$1" default || return 1
    isoloom_changed "$1 enabled"
  fi
  if ! rc-service -q "$1" status >/dev/null 2>&1; then
    rc-service -q "$1" start && isoloom_changed "$1 started"
  elif isoloom_restart_due; then
    rc-service -q "$1" restart && echo "isoloom: restarted $1"
  fi
}
isoloom_first() {
  _n=$1
  shift
  _i=0
  for _arg do
    shift
    if [ "$_i" -lt "$_n" ]; then set -- "$@" "$_arg"; fi
    _i=$((_i + 1))
  done
  "$@"
}
isoloom_command() {
  _guard=$1 _n=$2
  shift 2
  case $_guard in
    creates) [ -e "$1" ] && return 0 ;;
    unless) (isoloom_first "$_n" "$@") >/dev/null 2>&1 && return 0 ;;
    *) isoloom_fail "no guard $_guard" || return 1 ;;
  esac
  shift "$_n"
  "$@" || isoloom_fail "the command $1 failed" || return 1
  isoloom_changed "command $1"
}
ISOLOOM_CHANGED=/run/isoloom/configure.changed
rm -f "$ISOLOOM_CHANGED"
cd /opt/isoloom
isoloom_packages 'ca-certificates' 'curl'
isoloom_file '/opt/isoloom/seaweedfs.tar.gz' '' '' '' 'download' 'https://github.com/seaweedfs/seaweedfs/releases/download/4.53/linux_amd64.tar.gz' 'd1a7dec9f48d8b33895a0ea8951971defc2dc5312906dcc76fa5a5f74a6ee90d'
isoloom_command 'creates' '1' '/usr/local/bin/weed' 'sh' '-c' 'tar -xzf /opt/isoloom/seaweedfs.tar.gz -C /usr/local/bin weed'
# shellcheck disable=SC2016
isoloom_unit 'seaweedfs' '[Unit]
Description=seaweedfs, defined by Isoloom
Wants=network-online.target
After=network-online.target

[Service]
ExecStart="/bin/sh" "-c" "mkdir -p /var/lib/seaweedfs\nset -eu\njson() { printf '\''%%s'\'' \"$$1\" | sed -e '\''s/\\\\/\\\\\\\\/g'\'' -e '\''s/\"/\\\\\"/g'\'' -e '\''s/	/\\\\t/g'\''; }\na=$$(cat /etc/isoloom/services/files/access-key); s=$$(cat /etc/isoloom/services/files/secret-key)\ncase \"$$a$$s\" in *'\''\n'\''*) echo '\''an S3 key holds a line break, which its configuration cannot carry'\'' >&2; exit 1 ;; esac\nmkdir -p \"$$(dirname /run/seaweedfs/s3.json)\"\n(umask 077 && printf '\''{\"identities\":[{\"name\":\"app\",\"credentials\":[{\"accessKey\":\"%%s\",\"secretKey\":\"%%s\"}],\"actions\":[\"Admin\",\"Read\",\"Write\",\"List\",\"Tagging\"]}]}'\'' \"$$(json \"$$a\")\" \"$$(json \"$$s\")\" > /run/seaweedfs/s3.json)\nexec /usr/local/bin/weed server -dir=/var/lib/seaweedfs -ip.bind=0.0.0.0 -s3 -s3.port=8333 -s3.config=/run/seaweedfs/s3.json"
Restart=on-failure

[Install]
WantedBy=multi-user.target
'
isoloom_service 'seaweedfs' 'yes'
)
