---
source: crates/targets/isoloom-targets/tests/snapshots.rs
expression: "file(&render(backend(Target::Hybrid), \"mixed-office\")?, \"hybrid/compose.yml\")?"
---
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# The containers of a hybrid environment: run on the isoloom-docker-host VM, on the networks
# it creates there (macvlan, shared with the VMs). Started by the Vagrantfile next to it.

name: mixed-office
services:
  intranet:
    image: nginx:1.27
    hostname: intranet
    networks:
      office:
        ipv4_address: 192.168.58.20
        gw_priority: 1
      isoloom-publish: null
    extra_hosts:
    - files01:192.168.58.10
    ports:
    - 8083:80
    volumes:
    - isoloom-probe:/.isoloom-probe:ro
    healthcheck:
      test:
      - CMD
      - /.isoloom-probe/busybox
      - sh
      - -c
      - /.isoloom-probe/busybox nc -z -w 2 127.0.0.1 80
      interval: 5s
      timeout: 3s
      retries: 60
      start_period: 10s
    depends_on:
      isoloom-probe:
        condition: service_completed_successfully
    labels:
      isoloom.port.web: http:80
      isoloom.managed: 'true'
      isoloom.environment: mixed-office
    restart: unless-stopped
  isoloom-probe:
    image: busybox:1.37.0-musl@sha256:f6a95d611e0a8780fabdb2aec43e31275b2720dfefa3e41b16835bfc42454478
    entrypoint:
    - /bin/cp
    - /bin/busybox
    - /probe/busybox
    network_mode: none
    volumes:
    - isoloom-probe:/probe
    labels:
      isoloom.managed: 'true'
      isoloom.environment: mixed-office
    restart: no
networks:
  isoloom-publish: {}
  office:
    external: true
    name: isoloom-mixed-office-office
volumes:
  isoloom-probe:
    labels:
      isoloom.managed: 'true'
      isoloom.environment: mixed-office
