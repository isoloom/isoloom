# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  cd .isoloom/docker-vm && vagrant up
# Checks: cd .isoloom/docker-vm && vagrant provision --provision-with checks
# Stop:   cd .isoloom/docker-vm && vagrant destroy -f

ROOT = File.expand_path("../..", __dir__)
# The project goes into a VM through Isoloom's own `project` step (the `isoloom_project`
# provisioner below): a tar.gz of the project as it is when the step runs, not when this file
# loads, so files added or removed since still count. Symbolic links go in as links, never
# followed (a link loop can't break the copy). Plain Ruby (Vagrant's own): no tool on the host.
require "zlib"
require "tempfile"

module IsoloomProject
  # Never copied, at any depth: version control and the tools' own state.
  SKIP = [".git", ".vagrant", ".terraform"].freeze

  # Writes the archive of `root` to `io`, gzipped. `generated`: whether Isoloom's outputs (the
  # top-level `.isoloom*` folders) go in; `extra`: files in them that go in anyway (paths from
  # `root`, with `/`). What `.isoloomignore` lists stays out.
  def self.write(root, io, generated: false, extra: [])
    gz = Zlib::GzipWriter.new(io)
    rules = ignore_rules(root)
    walk(root, nil, generated, extra, rules) { |rel, st| entry(gz, root, rel, st) }
    gz.write("\0" * 1024)
    gz.finish
  end

  # `.isoloomignore` at the project's root, gitignore-style: one pattern per line, `#` comments,
  # `!` brings a path back, a trailing `/` matches folders only, a `/` at the start or in the
  # middle anchors the pattern at the root (otherwise it matches at any depth), `*`, `?`,
  # `[abc]` and `**`. A pattern matching a folder matches everything in it, and the last pattern
  # matching a path (or a folder it is in) decides. As [regexp, keep] pairs; the Terraform
  # outputs translate the patterns the same way, so every target leaves out the same files.
  def self.ignore_rules(root)
    text = File.binread(File.join(root, ".isoloomignore")).force_encoding("UTF-8")
    text.split("\n").filter_map do |line|
      line = line.strip
      next if line.empty? || line.start_with?("#")
      keep = line.start_with?("!")
      pat = keep ? line[1..] : line
      glob = pat.delete_suffix("/").delete_suffix("/**").delete_suffix("/")
      next if glob.empty?
      anchored = glob.include?("/") ? glob.delete_prefix("/") : "**/#{glob}"
      re = anchored.gsub(/[.+^$(){}|\\]/) { "\\#{$&}" }.gsub("[!", "[^")
                   .gsub("**/", "\u0001").gsub("**", "\u0002").gsub("*", "[^/]*").gsub("?", "[^/]")
                   .gsub("\u0001", "(.*/)?").gsub("\u0002", ".*")
      [Regexp.new(glob == pat ? "^#{re}(/|$)" : "^#{re}/"), keep]
    end
  rescue Errno::ENOENT
    []
  end

  # Whether the rules leave a path out (a folder's path ends with `/`).
  def self.ignored?(rules, path)
    rules.reduce(false) { |out, (re, keep)| re.match?(path) ? !keep : out }
  end

  # Every entry under `dir` (relative to `root`), parents first, in name order.
  def self.walk(root, dir, generated, extra, rules, &block)
    names = begin
      Dir.children(dir ? File.join(root, dir) : root).sort
    rescue Errno::ENOENT, Errno::ENOTDIR
      return # removed while the archive was being written
    end
    names.each do |name|
      next if SKIP.include?(name)
      rel = dir ? "#{dir}/#{name}" : name
      if !generated && rel.start_with?(".isoloom")
        next unless extra.any? { |e| e == rel || e.start_with?("#{rel}/") }
      end
      st = begin
        File.lstat(File.join(root, rel))
      rescue Errno::ENOENT
        next
      end
      folder = st.directory?
      out = ignored?(rules, folder ? "#{rel}/" : rel)
      yield rel, st unless out
      # An ignored folder is skipped, unless a `!` pattern may bring back something in it.
      walk(root, rel, generated, extra, rules, &block) if folder && (!out || rules.any? { |_, keep| keep })
    end
  end

  def self.entry(out, root, rel, st)
    path = File.join(root, rel)
    if st.symlink?
      header(out, rel, "2", 0o777, 0, st.mtime, File.readlink(path))
    elsif st.directory?
      header(out, "#{rel}/", "5", st.mode & 0o7777, 0, st.mtime)
    elsif st.file?
      File.open(path, "rb") do |f|
        mode = st.mode & 0o7777
        # Windows has no executable bit: a script (#!) is made executable.
        mode |= 0o111 if Gem.win_platform? && f.read(2) == "#!"
        f.rewind
        header(out, rel, "0", mode, st.size, st.mtime)
        copied = IO.copy_stream(f, out, st.size)
        out.write("\0" * (st.size - copied)) if copied < st.size # shrank while being read
        out.write("\0" * ((512 - st.size % 512) % 512))
      end
    end
  rescue Errno::ENOENT
    nil # removed while the archive was being written
  end

  # A ustar header; a pax one before it for what ustar can't hold (long names, large sizes).
  def self.header(out, name, type, mode, size, mtime, link = "")
    name = name.b
    link = link.b
    pax = {}
    pax["path"] = name if name.bytesize > 100
    pax["linkpath"] = link if link.bytesize > 100
    pax["size"] = size.to_s if size >= 8**11
    unless pax.empty?
      body = pax.map { |k, v| record(k, v) }.join
      header(out, "PaxHeader/#{name.byteslice(0, 80)}", "x", 0o644, body.bytesize, mtime)
      out.write(body)
      out.write("\0" * ((512 - body.bytesize % 512) % 512))
    end
    h = [
      name.byteslice(0, 100), format("%07o", mode), format("%07o", 0), format("%07o", 0),
      format("%011o", size >= 8**11 ? 0 : size), format("%011o", [mtime.to_i, 0].max), " " * 8, type,
      link.byteslice(0, 100), "ustar", "00", "", "", "", "", "", "",
    ].pack("a100a8a8a8a12a12a8a1a100a6a2a32a32a8a8a155a12")
    h[148, 8] = format("%06o\0 ", h.sum(0))
    out.write(h)
  end

  # One pax record: "<length> key=value\n", the length counting itself.
  def self.record(key, value)
    rest = " #{key}=".b + value + "\n"
    len = rest.bytesize + 1
    len += 1 while (len.to_s.bytesize + rest.bytesize) > len
    len.to_s.b + rest
  end
end

if defined?(Vagrant) && Vagrant.respond_to?(:plugin)
  module IsoloomProject
    class Config < Vagrant.plugin("2", :config)
      attr_accessor :name, :generated, :extra

      def initialize
        super
        @name = UNSET_VALUE
        @generated = UNSET_VALUE
        @extra = UNSET_VALUE
      end

      def finalize!
        @name = nil if @name == UNSET_VALUE
        @generated = false if @generated == UNSET_VALUE
        @extra = [] if @extra == UNSET_VALUE
      end
    end

    # Builds the archive, uploads it, unpacks it in /opt/isoloom (C:\isoloom on Windows, over
    # WinRM or OpenSSH, with UNTAR_PS1), replacing an older copy.
    class Provisioner < Vagrant.plugin("2", :provisioner)
      def provision
        windows = %w[winrm winssh].include?(@machine.config.vm.communicator.to_s)
        Tempfile.create(["isoloom-project", ".tgz"]) do |f|
          f.binmode
          IsoloomProject.write(ROOT, f, generated: config.generated, extra: config.extra)
          f.close
          dest = windows ? "C:\\isoloom" : "/opt/isoloom"
          @machine.ui.info("The project, #{(File.size(f.path) / 1024.0).ceil} KB compressed, to #{dest}")
          comm = @machine.communicate
          if windows
            archive = "C:\\Windows\\Temp\\isoloom-project.tgz"
            comm.upload(f.path, archive)
            script = "$archive = '#{archive}'; $dest = '#{dest}'; $strip = 0\n#{UNTAR_PS1}"
            comm.execute(script, elevated: true) do |type, data|
              @machine.ui.info(data.chomp) if type == :stdout && !data.strip.empty?
            end
          else
            comm.upload(f.path, "/tmp/isoloom-project.tgz")
            comm.execute("rm -rf /tmp/isoloom-project && mkdir /tmp/isoloom-project && tar -xzf /tmp/isoloom-project.tgz -C /tmp/isoloom-project && rm -f /tmp/isoloom-project.tgz")
            comm.sudo("rm -rf /opt/isoloom && mv /tmp/isoloom-project /opt/isoloom")
          end
        end
      end
    end

    class Plugin < Vagrant.plugin("2")
      name "isoloom project"
      config(:isoloom_project, :provisioner) { Config }
      provisioner(:isoloom_project) { Provisioner }
    end
  end
end

# Unpacks the project on Windows (no tar.exe before Windows Server 2019).
IsoloomProject::UNTAR_PS1 = <<'PS1'
# The project into a Windows machine: unpacks the tar.gz $archive into $dest (replacing an older
# copy), leaving out the archive's first $strip folders. Plain .NET (GZipStream), so it runs on
# every Windows Isoloom supports: PowerShell 2.0 and later, and no tar.exe before Windows Server
# 2019. Symbolic links are left out (counted).
& {
  $ErrorActionPreference = 'Stop'
  $sep = [IO.Path]::DirectorySeparatorChar
  $new = "$dest.new"
  if (Test-Path $new) { Remove-Item $new -Recurse -Force }
  [void][IO.Directory]::CreateDirectory($new)
  $file = New-Object IO.FileStream($archive, [IO.FileMode]::Open, [IO.FileAccess]::Read)
  $in = New-Object IO.Compression.GZipStream($file, [IO.Compression.CompressionMode]::Decompress)
  $utf8 = New-Object Text.UTF8Encoding($false)
  $header = New-Object byte[] 512
  $chunk = New-Object byte[] 65536
  function Fill([byte[]]$b, [int]$n) {
    $got = 0
    while ($got -lt $n) {
      $r = $in.Read($b, $got, $n - $got)
      if ($r -le 0) { throw "$archive ends early" }
      $got += $r
    }
  }
  function Field([int]$at, [int]$len) {
    $end = [Array]::IndexOf($header, [byte]0, $at, $len)
    if ($end -lt 0) { $end = $at + $len }
    $utf8.GetString($header, $at, $end - $at)
  }
  # Copies $size bytes to $out (or skips them, with no $out), then the padding after them.
  function Body([long]$size, $out) {
    $left = $size
    while ($left -gt 0) {
      $n = [int][Math]::Min([long]$chunk.Length, $left)
      Fill $chunk $n
      if ($out) { $out.Write($chunk, 0, $n) }
      $left -= $n
    }
    $pad = [int]((512 - $size % 512) % 512)
    if ($pad) { Fill $chunk $pad }
  }
  $pax = @{}
  $links = 0
  $files = 0
  while ($true) {
    Fill $header 512
    if ($header[148] -eq 0) { break } # the end: zero blocks have no checksum
    $type = [char]$header[156]
    $sizeText = (Field 124 12).Trim()
    $size = [long]0
    if ($sizeText) { $size = [Convert]::ToInt64($sizeText, 8) }
    if ($pax['size']) { $size = [long]$pax['size'] }
    if ($type -eq 'x') {
      # pax records ("<length> key=value\n"): a long path, a large size, for the next entry.
      $ms = New-Object IO.MemoryStream
      Body $size $ms
      $b = $ms.ToArray()
      $i = 0
      while ($i -lt $b.Length) {
        $sp = [Array]::IndexOf($b, [byte]32, $i)
        $len = [int]$utf8.GetString($b, $i, $sp - $i)
        $eq = [Array]::IndexOf($b, [byte]61, $sp)
        $pax[$utf8.GetString($b, $sp + 1, $eq - $sp - 1)] = $utf8.GetString($b, $eq + 1, $i + $len - $eq - 2)
        $i += $len
      }
      continue
    }
    if ($type -eq 'L' -or $type -eq 'K') {
      # GNU tar's long name (or link target) for the next entry.
      $ms = New-Object IO.MemoryStream
      Body $size $ms
      if ($type -eq 'L') { $pax['path'] = $utf8.GetString($ms.ToArray()).TrimEnd([char]0) }
      continue
    }
    $name = Field 0 100
    $prefix = Field 345 155
    if ($prefix) { $name = "$prefix/$name" }
    if ($pax['path']) { $name = $pax['path'] }
    $pax = @{}
    $parts = @($name.Split('/') | Where-Object { $_ -ne '' -and $_ -ne '.' })
    if ($parts.Count -le $strip) { Body $size $null; continue }
    $path = Join-Path $new ([string]::Join([string]$sep, [string[]]($parts[$strip..($parts.Count - 1)])))
    if ($type -eq '5' -or $type -eq '0' -or $type -eq [char]0) {
      # A name Windows can't take (`:`, `*`, too long...) is left out, with a warning.
      $out = $null
      try {
        if ($type -eq '5') {
          [void][IO.Directory]::CreateDirectory($path)
        } else {
          [void][IO.Directory]::CreateDirectory([IO.Path]::GetDirectoryName($path))
          $out = [IO.File]::Create($path)
        }
      } catch {
        Write-Warning "Not copied: $name ($($_.Exception.Message))"
        Body $size $null
        continue
      }
      if ($out) {
        try { Body $size $out } finally { $out.Close() }
        $files++
      } else {
        Body $size $null
      }
    } else {
      if ($type -eq '2') { $links++ }
      Body $size $null
    }
  }
  $in.Close()
  if (Test-Path $dest) { Remove-Item $dest -Recurse -Force }
  Move-Item $new $dest
  Remove-Item $archive -Force
  $note = ''
  if ($links) { $note = " ($links symbolic links left out)" }
  "$files files in $dest$note"
}
PS1
# Vagrant's own check of a host port before forwarding it (`Vagrant::Util::IsPortOpen`) asks
# `Socket.tcp` with a timeout, and on macOS 27 that hands back a socket for a refused connection
# (Ruby bug #22223: the retried `connect_nonblock` answers EISCONN while the socket's SO_ERROR
# still holds ECONNREFUSED). Every host port then reads as in use, and a VM's fixed forwarded
# port fails as a collision before the VM boots (the SSH one Vagrant moves, to a port that read
# as free by luck). On a Mac the check reads the socket's error itself, as Vagrant's should.
if RUBY_PLATFORM.include?("darwin") && defined?(Vagrant)
  require "vagrant/util/is_port_open"

  module Vagrant::Util::IsPortOpen
    def is_port_open?(host, port)
      addr = Addrinfo.tcp(host, port)
      sock = Socket.new(addr.afamily, addr.socktype, addr.protocol)
      begin
        if sock.connect_nonblock(addr, exception: false) == :wait_writable
          return false unless sock.wait_writable(0.1)
        end
        sock.getsockopt(Socket::SOL_SOCKET, Socket::SO_ERROR).int.zero?
      rescue SystemCallError
        false
      ensure
        sock.close
      end
    end
  end
end
# QEMU (vagrant-qemu): what the provider block can't say on its own.
# - A network of other than two VMs gets a hub: one QEMU process with no machine, a port per VM
#   on one emulated hub, each VM connecting to its own (no root; multicast doesn't send on a
#   Mac). It starts before a VM on that network does, unless it runs, and stops once the
#   network's last VM is destroyed: destroying one VM leaves it to the others.
# - A VM's disk is an overlay of its box's, and a size below the box's disk would cut its file
#   system off: `disk_resize` is set only when the machine's size is above the box's (every
#   installed version of it, read with qemu-img). Until the box is downloaded the size is unknown
#   and nothing is set; Vagrant reads this file again once it has the box, before it makes the
#   disk.
module IsoloomQemu
  # Beside Vagrant's own state for this Vagrantfile.
  def self.hubs_dir
    File.join(__dir__, ".vagrant", "isoloom-qemu-hubs")
  end

  def self.fail!(message)
    raise Class.new(Vagrant::Errors::VagrantError) { define_method(:error_message) { "QEMU: #{message}" } }
  end

  def self.pid_file(net)
    File.join(hubs_dir, "#{net}.pid")
  end

  # The hub's process id, while it runs.
  def self.running(net)
    pid = Integer(File.read(pid_file(net)).strip)
    Process.kill(0, pid)
    pid
  rescue ArgumentError, SystemCallError
    nil
  end

  # Starts the network's hub unless it runs: QEMU returns once its ports listen.
  def self.hub(net, ports)
    return if running(net)
    require "fileutils"
    FileUtils.mkdir_p(hubs_dir)
    args = ["qemu-system-#{HOST_ARCH}", "-machine", "none", "-display", "none", "-nodefaults",
            "-daemonize", "-pidfile", pid_file(net)]
    ports.each_with_index do |port, i|
      args += ["-netdev", "socket,id=s#{i},listen=127.0.0.1:#{port}", "-netdev", "hubport,id=h#{i},hubid=0,netdev=s#{i}"]
    end
    log = File.join(hubs_dir, "#{net}.log")
    ok = system(*args, out: log, err: log)
    fail!("the hub of network `#{net}` didn't start (#{args.first}): see #{log}") unless ok
  end

  # Stops the network's hub once none of its VMs (`vms`, by define name) is left besides the
  # one just destroyed. A VM is left while Vagrant keeps its id: a halted one still holds its
  # port, and the hub starts again for it anyway if stopped.
  def self.release(net, vms, env, gone)
    left = vms.reject { |vm| vm == gone.to_s }
    return if left.any? { |vm| env.local_data_path.join("machines", vm, "qemu", "id").file? }
    stop(net)
  end

  # Stops the network's hub, if it runs.
  def self.stop(net)
    pid = running(net)
    Process.kill("TERM", pid) if pid
    File.delete(pid_file(net)) if File.exist?(pid_file(net))
  end

  # `disk_resize` for a VM of `box` sized `gb` GB: the size when it is above the box's disk,
  # else nothing (the box's disk is kept, never cut).
  def self.disk(box, gb)
    require "json"
    dir = File.join(Vagrant.user_data_path.to_s, "boxes", box.gsub("/", "-VAGRANTSLASH-"))
    images = Dir.glob(File.join(dir, "**", "libvirt", "**", "*.{img,qcow2}"))
    return nil if images.empty?
    sizes = images.map do |img|
      out = IO.popen(["qemu-img", "info", "--output=json", img], err: File::NULL, &:read)
      JSON.parse(out)["virtual-size"]
    rescue StandardError
      nil
    end
    # A box whose size can't be read keeps its own disk: a guess could cut it.
    return nil if sizes.include?(nil)
    gb * 1024**3 > sizes.max ? "#{gb}G" : nil
  end
end
# On UTM, a Linux VM's default route through UTM's shared network, not the plugin's slower emulated one (the `nat-route` provisioners).
ISOLOOM_NAT_ROUTE = <<~'SH'
set -eu
gw=10.0.2.2
dev_of() { awk '{for (i = 1; i < NF; i++) if ($i == "dev") { print $(i + 1); exit }}'; }
via_of() { awk '{for (i = 1; i < NF; i++) if ($i == "via") { print $(i + 1); exit }}'; }
nat=$(ip -4 route show default via "$gw" | dev_of)
# No default route through the emulated network, or no shared one to prefer: nothing to do.
[ -n "$nat" ] || exit 0
up=$(ip -4 route show default | grep -v "via $gw dev $nat " | dev_of)
[ -n "$up" ] || exit 0
# The shared network leads only when it reaches the internet; otherwise the emulated one does.
metric=200
for probe in 1.1.1.1 8.8.8.8 9.9.9.9; do
  if ping -c 1 -W 2 -I "$up" "$probe" >/dev/null 2>&1; then metric=50; break; fi
done
[ "$metric" = 50 ] || echo "nat-route: the shared network ($up) reaches no public resolver; the emulated network keeps the traffic"
# Waits (up to 30 s) for the shared card's default route after its configuration was applied.
route_back() {
  i=0
  until ip -4 route show default dev "$up" | grep -q .; do
    i=$((i + 1))
    [ "$i" -lt 30 ] || return 1
    sleep 1
  done
}
netd=${ISOLOOM_NETWORKD_DIR:-/etc/systemd/network}
if command -v nmcli >/dev/null 2>&1 && nmcli -t -f RUNNING general 2>/dev/null | grep -q running; then
  con=$(nmcli -g GENERAL.CONNECTION device show "$up")
  if [ -n "$con" ] && [ "$(nmcli -g ipv4.route-metric connection show "$con")" != "$metric" ]; then
    nmcli connection modify "$con" ipv4.route-metric "$metric"
    nmcli device reapply "$up"
  fi
elif command -v networkctl >/dev/null 2>&1 && file=$(networkctl status "$up" 2>/dev/null | sed -n 's/^ *Network File: //p') && [ -n "$file" ] && [ "$file" != n/a ]; then
  own="$netd/05-isoloom-uplink.network"
  want=$(printf '[Match]\nName=%s\n\n[Network]\nDHCP=yes\n\n[DHCPv4]\nRouteMetric=%s\n' "$up" "$metric")
  if [ "$file" != "$own" ] || [ "$(cat "$own")" != "$want" ]; then
    mkdir -p "$netd"
    printf '%s\n' "$want" > "$own"
    networkctl reload
    networkctl reconfigure "$up"
  fi
elif [ -f /etc/network/interfaces ]; then
  for f in /etc/network/interfaces /etc/network/interfaces.d/*; do
    [ -f "$f" ] && grep -q "^iface $up inet dhcp" "$f" || continue
    sed -i "/^iface $up inet dhcp/,/^[^ \t]/{/^[ \t]*metric /d}" "$f"
    sed -i "/^iface $up inet dhcp/a\\    metric $metric" "$f"
  done
fi
if ! route_back; then
  echo "nat-route: the shared card has no default route any more; the emulated network carries the traffic"
  exit 0
fi
# The route as it is now, whatever the configuration does at its next renewal.
upgw=$(ip -4 route show default dev "$up" | via_of)
ip -4 route show default dev "$up" | grep -q " metric $metric " ||
  ip -4 route replace default via "$upgw" dev "$up" metric "$metric"
for m in $(ip -4 route show default dev "$up" | awk '{m = 0; for (i = 1; i < NF; i++) if ($i == "metric") m = $(i + 1); print m}'); do
  [ "$m" = "$metric" ] || ip -4 route del default via "$upgw" dev "$up" metric "$m"
done
SH
require "json"
# The host ports the runner chose for this run; each forward defaults to its own number.
ISOLOOM_HOSTPORTS = (JSON.parse(ENV.fetch("ISOLOOM_HOSTPORTS", "{}")) rescue {})

Vagrant.configure("2") do |config|
  config.vm.box = "generic/debian12"
  config.vm.hostname = "hello-stack"
  config.vm.synced_folder ".", "/vagrant", disabled: true
  config.vm.boot_timeout = 600
  config.ssh.proxy_command = ENV["ISOLOOM_SSH_PROXY_COMMAND"] if ENV["ISOLOOM_SSH_PROXY_COMMAND"]
  config.vm.provider "libvirt" do |v|
    v.default_prefix = "hello-stack_"
  end
  config.vm.network "forwarded_port", guest: 8080, host: ISOLOOM_HOSTPORTS.fetch("web/web", 8080), host_ip: "127.0.0.1"
  config.vm.provider "virtualbox" do |v|
    v.customize ["modifyvm", :id, "--graphicscontroller", "vboxvga"]
    v.name = "hello-stack · isoloom-docker-host"
    v.cpus = 2
    v.memory = 2048
  end
  config.vm.provider "vmware_desktop" do |v|
    v.vmx["displayName"] = "hello-stack · isoloom-docker-host"
    v.vmx["numvcpus"] = "2"
    v.vmx["memsize"] = "2048"
  end
  config.vm.provider "parallels" do |v|
    v.name = "hello-stack · isoloom-docker-host"
    v.cpus = 2
    v.memory = 2048
  end
  config.vm.provider "utm" do |v, o|
    o.vm.box = "utm/bookworm"
    v.name = "hello-stack · isoloom-docker-host"
    v.cpus = 2
    v.memory = 2048
    o.vm.provision "nat-route", type: "shell", run: "always", preserve_order: true, inline: ISOLOOM_NAT_ROUTE
  end
  config.vm.provider "qemu" do |v, o|
    o.vm.box = "cloud-image/debian-12"
    o.vm.box_version = ">= 0"
    v.smp = "cpus=2"
    v.memory = "2048M"
    v.disk_resize = IsoloomQemu.disk("cloud-image/debian-12", 40)
    v.ssh_port = ISOLOOM_HOSTPORTS.fetch("isoloom-docker-host/ssh", 50022)
    v.ssh_auto_correct = true
  end
  config.vm.provider "libvirt" do |v|
    v.cpus = 2
    v.memory = 2048
  end
  config.vm.provider "vmware_esxi" do |v|
    v.esxi_hostname = ENV.fetch("ESXI_HOSTNAME", "")
    v.esxi_hostport = ENV.fetch("ESXI_HOSTPORT", "22").to_i
    v.esxi_username = ENV.fetch("ESXI_USERNAME", "root")
    v.esxi_password = "env:ESXI_PASSWORD"
    v.esxi_disk_store = ENV["ESXI_DATASTORE"] if ENV["ESXI_DATASTORE"]
    v.esxi_virtual_network = [ENV.fetch("ESXI_VIRTUAL_NETWORK", "VM Network").split(",").first.strip]
    v.guest_name = "hello-stack-isoloom-docker-host"
    v.guest_numvcpus = 2
    v.guest_memsize = 2048
  end
  config.vm.provision "nat-route", type: "shell", run: "always", inline: ":"
  config.vm.provision "project", type: "isoloom_project", generated: true
  config.vm.provision "docker", type: "shell", inline: "command -v docker >/dev/null || if command -v apt-get >/dev/null; then (
  set -e
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -qq
  apt-get install -y -qq ca-certificates curl
  install -m 0755 -d /etc/apt/keyrings
  k=$(mktemp)
  # shellcheck disable=SC1091,SC2154 # /etc/os-release is on the guest, not here.
  _id=$(. /etc/os-release && printf %s \"$ID\")
  # shellcheck disable=SC1091,SC2154
  _cn=$(. /etc/os-release && printf %s \"$VERSION_CODENAME\")
  curl -fsSL \"https://download.docker.com/linux/$_id/gpg\" -o \"$k\"
  echo \"1500c1f56fa9e26b9b8f42452a553675796ade0807cdce11975eb98170b3a570  $k\" | sha256sum -c -
  install -m 0644 \"$k\" /etc/apt/keyrings/docker.asc
  rm -f \"$k\"
  echo \"deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/$_id $_cn stable\" > /etc/apt/sources.list.d/docker.list
  apt-get update -qq
  v=$(apt-cache madison docker-ce | awk '$3 ~ /(^|:)29[.]9[.]0/ { print $3; exit }')
  [ -n \"$v\" ] || { echo \"docker-ce 29.9.0 is not in Docker's apt repository\" >&2; exit 1; }
  apt-get install -y -qq --allow-downgrades \"docker-ce=$v\" \"docker-ce-cli=$v\" containerd.io docker-buildx-plugin \"docker-compose-plugin=5.6.0-*\"
  # A lab's images are built for x86 unless it says otherwise: on another CPU (an Apple Silicon
  # Mac's VM, an Arm cloud VM) the engine runs them through QEMU's user-mode emulation, which
  # Debian registers with binfmt for every container (Docker Desktop does the same on its own).
  [ \"$(dpkg --print-architecture)\" = amd64 ] || apt-get install -y -qq qemu-user-static binfmt-support
)
else
  curl -fsSL https://get.docker.com | VERSION=29.9.0 sh
fi
cat > /etc/systemd/system/isoloom-published.service <<'UNIT'
[Unit]
Description=Isoloom: published ports reach containers of networks without a default route
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'iptables -t nat -C POSTROUTING -m conntrack --ctstate DNAT -o br-+ -j MASQUERADE 2>/dev/null || iptables -t nat -I POSTROUTING -m conntrack --ctstate DNAT -o br-+ -j MASQUERADE'

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now isoloom-published.service
"
  config.vm.provision "shell", name: "environment", inline: "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name hello-stack --file .isoloom/docker/compose.yml up --detach --build --pull missing --remove-orphans --wait --wait-timeout 600 || exit 1
mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready"
  config.vm.provision "shell", name: "checks", run: "never", inline: "failed=0
  cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name hello-stack --file .isoloom/docker/compose.yml --profile check run --rm --no-deps --env ISOLOOM_DERIVED=\"$ISOLOOM_DERIVED\" isoloom-check || failed=1
  cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name hello-stack --file .isoloom/docker/compose.yml --profile check run --rm --no-deps --env ISOLOOM_DERIVED=\"$ISOLOOM_DERIVED\" isoloom-check-cache || failed=1
  cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name hello-stack --file .isoloom/docker/compose.yml exec -T cache sh -s < .isoloom/docker/checks/exec-cache.sh || failed=1
  cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name hello-stack --file .isoloom/docker/compose.yml --profile check run --rm --no-deps --env ISOLOOM_DERIVED=\"$ISOLOOM_DERIVED\" isoloom-check-web || failed=1
exit \"$failed\"", env: { "ISOLOOM_DERIVED" => ENV.fetch("ISOLOOM_DERIVED", "1") }
end
