---
source: crates/targets/isoloom-targets/tests/paas.rs
expression: services
---
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# The environment's services (`services:`), beside main.tf, whose network, zone and names they use.

resource "google_project_service" "sqladmin" {
  count              = var.project == "" ? 1 : 0
  project            = local.project
  service            = "sqladmin.googleapis.com"
  disable_on_destroy = false
}

resource "google_project_service" "servicenetworking" {
  count              = var.project == "" ? 1 : 0
  project            = local.project
  service            = "servicenetworking.googleapis.com"
  disable_on_destroy = false
}

resource "google_project_service" "storage" {
  count              = var.project == "" ? 1 : 0
  project            = local.project
  service            = "storage.googleapis.com"
  disable_on_destroy = false
}

# Private services access on network `lab`: Cloud SQL's private addresses.
resource "google_compute_global_address" "isoloom_services_lab" {
  project       = local.project
  name          = "${local.name}-lab-services"
  purpose       = "VPC_PEERING"
  address_type  = "INTERNAL"
  prefix_length = 24
  network       = google_compute_network.lab.id
}

resource "google_service_networking_connection" "lab" {
  network                 = google_compute_network.lab.id
  service                 = "servicenetworking.googleapis.com"
  reserved_peering_ranges = [google_compute_global_address.isoloom_services_lab.name]
  deletion_policy         = "ABANDON"
  depends_on              = [google_project_service.servicenetworking]
}

# Service `db`: PostgreSQL 16 on Cloud SQL, reached as db.shop.internal.
resource "google_sql_database_instance" "db" {
  project             = local.project
  name                = "${local.name}-db"
  region              = var.region
  database_version    = "POSTGRES_16"
  deletion_protection = false
  settings {
    tier    = "db-f1-micro"
    edition = "ENTERPRISE"
    ip_configuration {
      ipv4_enabled    = false
      private_network = google_compute_network.lab.id
    }
  }
  depends_on = [google_service_networking_connection.lab, google_project_service.sqladmin]
}

resource "google_sql_database" "db" {
  project  = local.project
  name     = "shop"
  instance = google_sql_database_instance.db.name
}

resource "google_sql_user" "db" {
  project  = local.project
  name     = "shop"
  instance = google_sql_database_instance.db.name
  password = var.ISOLOOM_SECRET_DB_PASSWORD
}

resource "google_dns_record_set" "db_shop_internal" {
  project      = local.project
  managed_zone = google_dns_managed_zone.private.name
  name         = "db.shop.internal."
  type         = "A"
  ttl          = 60
  rrdatas      = [google_sql_database_instance.db.private_ip_address]
}

# Service `files`: the bucket `uploads` on Cloud Storage.
resource "google_storage_bucket" "files" {
  project                     = local.project
  name                        = "isoloom-${terraform_data.id.output}-uploads"
  location                    = var.region
  force_destroy               = true
  uniform_bucket_level_access = true
  public_access_prevention    = "enforced"
  depends_on                  = [google_project_service.storage]
}

output "files_bucket" {
  value = google_storage_bucket.files.name
}

output "files_endpoint" {
  value = "https://storage.googleapis.com"
}
