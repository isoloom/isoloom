---
source: crates/targets/isoloom-targets/tests/paas.rs
expression: services
---
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# The environment's services (`services:`), beside main.tf, whose network, zone and names they use.
# `dns.private` is on: a spec with services turns it on, as each service is reached by its name
# in the zone (shop.internal). That zone is billed: a Cloud DNS private zone, about $0.20 a month.

variable "PLAYER_IP" {
  type        = string
  description = "Who may reach the published services, a CIDR (the spec's `inputs`): the player's address, e.g. 203.0.113.7/32"
}

resource "google_project_service" "sqladmin" {
  count              = var.project == "" ? 1 : 0
  project            = local.project
  service            = "sqladmin.googleapis.com"
  disable_on_destroy = false
}

resource "google_project_service" "servicenetworking" {
  count              = var.project == "" ? 1 : 0
  project            = local.project
  service            = "servicenetworking.googleapis.com"
  disable_on_destroy = false
}

resource "google_project_service" "storage" {
  count              = var.project == "" ? 1 : 0
  project            = local.project
  service            = "storage.googleapis.com"
  disable_on_destroy = false
}

resource "google_project_service" "managedkafka" {
  count              = var.project == "" ? 1 : 0
  project            = local.project
  service            = "managedkafka.googleapis.com"
  disable_on_destroy = false
}

# Private services access on network `lab`: Cloud SQL's private addresses.
resource "google_compute_global_address" "isoloom_services_lab" {
  project       = local.project
  name          = "${local.name}-lab-services"
  purpose       = "VPC_PEERING"
  address_type  = "INTERNAL"
  prefix_length = 24
  network       = google_compute_network.lab.id
}

resource "google_service_networking_connection" "lab" {
  network                 = google_compute_network.lab.id
  service                 = "servicenetworking.googleapis.com"
  reserved_peering_ranges = [google_compute_global_address.isoloom_services_lab.name]
  deletion_policy         = "ABANDON"
  depends_on              = [google_project_service.servicenetworking]
}

# Service `db`: PostgreSQL 16 on Cloud SQL, reached as db.shop.internal.
resource "google_sql_database_instance" "db" {
  project             = local.project
  name                = "${local.name}-db"
  region              = var.region
  database_version    = "POSTGRES_16"
  deletion_protection = false
  settings {
    tier    = "db-f1-micro"
    edition = "ENTERPRISE"
    ip_configuration {
      ipv4_enabled    = true
      private_network = google_compute_network.lab.id
      authorized_networks {
        name  = "isoloom-allow"
        value = var.PLAYER_IP
      }
    }
  }
  depends_on = [google_service_networking_connection.lab, google_project_service.sqladmin]
}

resource "google_sql_database" "db" {
  project  = local.project
  name     = "shop"
  instance = google_sql_database_instance.db.name
}

resource "google_sql_user" "db" {
  project  = local.project
  name     = "shop"
  instance = google_sql_database_instance.db.name
  password = var.ISOLOOM_SECRET_DB_PASSWORD
}

resource "google_dns_record_set" "db_shop_internal" {
  project      = local.project
  managed_zone = google_dns_managed_zone.private.name
  name         = "db.shop.internal."
  type         = "A"
  ttl          = 60
  rrdatas      = [google_sql_database_instance.db.private_ip_address]
}

output "db_published" {
  value = google_sql_database_instance.db.public_ip_address
}

# Service `files`: the bucket `uploads` on Cloud Storage.
resource "google_storage_bucket" "files" {
  project                     = local.project
  name                        = "isoloom-${terraform_data.id.output}-uploads"
  location                    = var.region
  force_destroy               = true
  uniform_bucket_level_access = true
  public_access_prevention    = "enforced"
  depends_on                  = [google_project_service.storage]
}

output "files_bucket" {
  value = google_storage_bucket.files.name
}

output "files_endpoint" {
  value = "https://storage.googleapis.com"
}

resource "google_service_account" "isoloom_service_files" {
  project    = local.project
  account_id = "svc-${terraform_data.id.output}-files"
}

resource "google_storage_bucket_iam_member" "isoloom_service_files" {
  bucket = google_storage_bucket.files.name
  role   = "roles/storage.objectAdmin"
  member = "serviceAccount:${google_service_account.isoloom_service_files.email}"
}

resource "google_service_account_key" "isoloom_service_files" {
  service_account_id = google_service_account.isoloom_service_files.name
}

# Service `bus`: Kafka on Managed Service for Apache Kafka, its brokers in network `lab`.
resource "google_managed_kafka_cluster" "bus" {
  project    = local.project
  cluster_id = "${local.name}-bus"
  location   = var.region
  capacity_config {
    vcpu_count   = 3
    memory_bytes = 3221225472
  }
  gcp_config {
    access_config {
      network_configs {
        subnet = "projects/${local.project}/regions/${var.region}/subnetworks/${google_compute_subnetwork.lab.name}"
      }
    }
  }
  depends_on = [google_project_service.managedkafka]
}

resource "google_managed_kafka_topic" "bus_orders" {
  project            = local.project
  topic_id           = "orders"
  cluster            = google_managed_kafka_cluster.bus.cluster_id
  location           = var.region
  partition_count    = 3
  replication_factor = 3
}

resource "google_managed_kafka_topic" "bus_audit" {
  project            = local.project
  topic_id           = "audit"
  cluster            = google_managed_kafka_cluster.bus.cluster_id
  location           = var.region
  partition_count    = 1
  replication_factor = 3
}

resource "google_service_account" "isoloom_service_bus" {
  project    = local.project
  account_id = "svc-${terraform_data.id.output}-bus"
}

resource "google_project_iam_member" "isoloom_service_bus" {
  project = local.project
  role    = "roles/managedkafka.client"
  member  = "serviceAccount:${google_service_account.isoloom_service_bus.email}"
}

resource "google_service_account_key" "isoloom_service_bus" {
  service_account_id = google_service_account.isoloom_service_bus.name
}

resource "terraform_data" "isoloom_service_files_to_web" {
  triggers_replace = [
    google_compute_instance.web.id,
    sha256(jsonencode([
      "https://storage.googleapis.com",
      google_storage_bucket.files.name,
      var.region,
      "gcs",
      google_service_account.isoloom_service_files.email,
      base64decode(google_service_account_key.isoloom_service_files.private_key)
    ]))
  ]
  connection {
    type        = "ssh"
    host        = google_compute_instance.web.network_interface[0].access_config[0].nat_ip
    user        = "admin"
    private_key = file(pathexpand(var.ssh_private_key_file))
    timeout     = "10m"
  }
  provisioner "file" {
    content     = "https://storage.googleapis.com"
    destination = "/tmp/isoloom-service-files-endpoint"
  }
  provisioner "file" {
    content     = google_storage_bucket.files.name
    destination = "/tmp/isoloom-service-files-bucket"
  }
  provisioner "file" {
    content     = var.region
    destination = "/tmp/isoloom-service-files-region"
  }
  provisioner "file" {
    content     = "gcs"
    destination = "/tmp/isoloom-service-files-api"
  }
  provisioner "file" {
    content     = google_service_account.isoloom_service_files.email
    destination = "/tmp/isoloom-service-files-access-key"
  }
  provisioner "file" {
    content     = base64decode(google_service_account_key.isoloom_service_files.private_key)
    destination = "/tmp/isoloom-service-files-secret-key"
  }
  provisioner "remote-exec" {
    inline = [
      "sudo sh -c 'install -d -m 0755 '\\''/etc/isoloom/services/files'\\'' && install -m 0444 '\\''/tmp/isoloom-service-files-endpoint'\\'' '\\''/etc/isoloom/services/files/endpoint'\\'' && rm -f '\\''/tmp/isoloom-service-files-endpoint'\\'' && install -m 0444 '\\''/tmp/isoloom-service-files-bucket'\\'' '\\''/etc/isoloom/services/files/bucket'\\'' && rm -f '\\''/tmp/isoloom-service-files-bucket'\\'' && install -m 0444 '\\''/tmp/isoloom-service-files-region'\\'' '\\''/etc/isoloom/services/files/region'\\'' && rm -f '\\''/tmp/isoloom-service-files-region'\\'' && install -m 0444 '\\''/tmp/isoloom-service-files-api'\\'' '\\''/etc/isoloom/services/files/api'\\'' && rm -f '\\''/tmp/isoloom-service-files-api'\\'' && install -m 0400 '\\''/tmp/isoloom-service-files-access-key'\\'' '\\''/etc/isoloom/services/files/access-key'\\'' && rm -f '\\''/tmp/isoloom-service-files-access-key'\\'' && install -m 0400 '\\''/tmp/isoloom-service-files-secret-key'\\'' '\\''/etc/isoloom/services/files/secret-key'\\'' && rm -f '\\''/tmp/isoloom-service-files-secret-key'\\'''"
    ]
  }
  depends_on = [terraform_data.isoloom_ready_web]
}

resource "terraform_data" "isoloom_service_bus_to_web" {
  triggers_replace = [
    google_compute_instance.web.id,
    sha256(jsonencode([
      google_managed_kafka_cluster.bus.bootstrap_address,
      "SASL_SSL",
      "PLAIN",
      google_service_account.isoloom_service_bus.email,
      google_service_account_key.isoloom_service_bus.private_key
    ]))
  ]
  connection {
    type        = "ssh"
    host        = google_compute_instance.web.network_interface[0].access_config[0].nat_ip
    user        = "admin"
    private_key = file(pathexpand(var.ssh_private_key_file))
    timeout     = "10m"
  }
  provisioner "file" {
    content     = google_managed_kafka_cluster.bus.bootstrap_address
    destination = "/tmp/isoloom-service-bus-bootstrap"
  }
  provisioner "file" {
    content     = "SASL_SSL"
    destination = "/tmp/isoloom-service-bus-security-protocol"
  }
  provisioner "file" {
    content     = "PLAIN"
    destination = "/tmp/isoloom-service-bus-sasl-mechanism"
  }
  provisioner "file" {
    content     = google_service_account.isoloom_service_bus.email
    destination = "/tmp/isoloom-service-bus-user"
  }
  provisioner "file" {
    content     = google_service_account_key.isoloom_service_bus.private_key
    destination = "/tmp/isoloom-service-bus-password"
  }
  provisioner "remote-exec" {
    inline = [
      "sudo sh -c 'install -d -m 0755 '\\''/etc/isoloom/services/bus'\\'' && install -m 0444 '\\''/tmp/isoloom-service-bus-bootstrap'\\'' '\\''/etc/isoloom/services/bus/bootstrap'\\'' && rm -f '\\''/tmp/isoloom-service-bus-bootstrap'\\'' && install -m 0444 '\\''/tmp/isoloom-service-bus-security-protocol'\\'' '\\''/etc/isoloom/services/bus/security-protocol'\\'' && rm -f '\\''/tmp/isoloom-service-bus-security-protocol'\\'' && install -m 0444 '\\''/tmp/isoloom-service-bus-sasl-mechanism'\\'' '\\''/etc/isoloom/services/bus/sasl-mechanism'\\'' && rm -f '\\''/tmp/isoloom-service-bus-sasl-mechanism'\\'' && install -m 0400 '\\''/tmp/isoloom-service-bus-user'\\'' '\\''/etc/isoloom/services/bus/user'\\'' && rm -f '\\''/tmp/isoloom-service-bus-user'\\'' && install -m 0400 '\\''/tmp/isoloom-service-bus-password'\\'' '\\''/etc/isoloom/services/bus/password'\\'' && rm -f '\\''/tmp/isoloom-service-bus-password'\\'''"
    ]
  }
  depends_on = [terraform_data.isoloom_ready_web]
}
