# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# `isoloom chart --version <v>` packages it with that version.
apiVersion: v2
name: shared-files
description: The shared-files environment, generated by Isoloom from isoloom.yml
type: application
version: 0.1.0
appVersion: 0.1.0

=== .isoloom/kubernetes/chart/values.yaml
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# images: each machine's image (images built from the project must be pushed where the
# cluster pulls from, and named here). inputs: the launch-time inputs (unset ones are empty).
images:
  writer: alpine:3.20
  reader: alpine:3.20

=== .isoloom/kubernetes/chart/templates/environment.yaml
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: writer
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      isoloom.com/machine: writer
  template:
    metadata:
      labels:
        isoloom.com/machine: writer
        net.isoloom.com/app: member
    spec:
      hostname: writer
      initContainers:
      - name: isoloom-probe
        image: busybox:1.37.0-musl
        command:
        - /bin/cp
        - /bin/busybox
        - /probe/busybox
        volumeMounts:
        - name: isoloom-probe
          mountPath: /probe
      - name: seed-shared
        image: '{{ index .Values.images "writer" }}'
        imagePullPolicy: IfNotPresent
        command:
        - /.isoloom-probe/busybox
        - sh
        - -c
        - 'd=/isoloom-seed; m="$d/.isoloom-seeding"; b=/.isoloom-probe/busybox; [ -d ''/srv/shared'' ] || exit 0; for f in "$d"/* "$d"/.[!.]* "$d"/..?*; do if [ -e "$f" ] || [ -L "$f" ]; then case "$f" in "$d/lost+found" | "$m") ;; *) [ -e "$m" ] || exit 0; $b rm -rf "$f" ;; esac; fi; done; : > "$m" && $b cp -a ''/srv/shared/.'' "$d/" && $b rm -f "$m"'
        securityContext:
          runAsUser: 0
          runAsGroup: 0
        volumeMounts:
        - name: vol-shared
          mountPath: /isoloom-seed
        - name: isoloom-probe
          mountPath: /.isoloom-probe
          readOnly: true
      containers:
      - name: writer
        image: '{{ index .Values.images "writer" }}'
        imagePullPolicy: IfNotPresent
        command:
        - sleep
        - infinity
        volumeMounts:
        - name: vol-shared
          mountPath: /srv/shared
      - name: init
        image: '{{ index .Values.images "writer" }}'
        imagePullPolicy: IfNotPresent
        command:
        - sh
        - -c
        - sh /isoloom/scripts/steps__write.sh && exec sleep infinity
        volumeMounts:
        - name: vol-shared
          mountPath: /srv/shared
        - name: scripts
          mountPath: /isoloom/scripts
      nodeSelector:
        kubernetes.io/arch: amd64
      volumes:
      - name: vol-shared
        persistentVolumeClaim:
          claimName: shared
      - name: scripts
        configMap:
          name: isoloom-scripts
          defaultMode: 493
      - name: isoloom-probe
        emptyDir: {}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: shared
spec:
  accessModes:
  - ReadWriteOnce
  resources:
    requests:
      storage: 1Gi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: reader
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      isoloom.com/machine: reader
  template:
    metadata:
      labels:
        isoloom.com/machine: reader
        net.isoloom.com/app: member
    spec:
      hostname: reader
      affinity:
        podAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
          - labelSelector:
              matchLabels:
                isoloom.com/machine: writer
            topologyKey: kubernetes.io/hostname
      initContainers:
      - name: isoloom-probe
        image: busybox:1.37.0-musl
        command:
        - /bin/cp
        - /bin/busybox
        - /probe/busybox
        volumeMounts:
        - name: isoloom-probe
          mountPath: /probe
      containers:
      - name: reader
        image: '{{ index .Values.images "reader" }}'
        imagePullPolicy: IfNotPresent
        command:
        - sleep
        - infinity
        volumeMounts:
        - name: vol-shared
          mountPath: /data/shared
      nodeSelector:
        kubernetes.io/arch: amd64
      volumes:
      - name: vol-shared
        persistentVolumeClaim:
          claimName: shared
      - name: isoloom-probe
        emptyDir: {}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: isoloom-default-deny
spec:
  podSelector: {}
  policyTypes:
  - Ingress
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: net-app
spec:
  podSelector:
    matchLabels:
      net.isoloom.com/app: member
  ingress:
  - from:
    - podSelector:
        matchLabels:
          net.isoloom.com/app: member

=== .isoloom/kubernetes/chart/templates/scripts.yaml
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# The project's scripts (init jobs, checks): copies in files/project/, written by `isoloom generate`.
apiVersion: v1
kind: ConfigMap
metadata:
  name: isoloom-scripts
binaryData:
  steps__write.sh: '{{ required "files/project/steps__write.sh is missing: run isoloom generate" (.Files.Get "files/project/steps__write.sh") | b64enc }}'

=== .isoloom/kubernetes/chart/templates/tests/checks.yaml
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# The checks: `helm test <release>` runs a Job per position (`exec` checks, run inside a machine,
# stay with `isoloom test kubernetes`).
apiVersion: v1
kind: ConfigMap
metadata:
  name: isoloom-check-runners
binaryData:
  reader.sh: '{{ .Files.Get "files/checks/reader.sh" | b64enc }}'
---
apiVersion: v1
kind: Pod
metadata:
  name: isoloom-check-reader
  labels:
    net.isoloom.com/app: member
    isoloom.com/check: isoloom-check-reader
  annotations:
    helm.sh/hook: test
    helm.sh/hook-delete-policy: before-hook-creation
spec:
  restartPolicy: Never
  containers:
  - name: check
    image: curlimages/curl:8.11.1
    command:
    - /bin/sh
    - /isoloom/run/reader.sh
    volumeMounts:
    - name: runner
      mountPath: /isoloom/run
  volumes:
  - name: runner
    configMap:
      name: isoloom-check-runners
      defaultMode: 493

=== .isoloom/kubernetes/chart/files/checks/reader.sh
#!/bin/sh
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# The environment's checks, from reader. `isoloom test` runs it and reads the PASS/FAIL lines.
passed=0; failed=0
pass() { passed=$((passed+1)); echo "isoloom-check: PASS $1"; }
fail() { failed=$((failed+1)); echo "isoloom-check: FAIL $1: $2"; }
# _http URL [follow] -> the status code, 000 when nothing answers (curl, else wget, else bash):
# the first answer's, or with `follow` the last one's after at most 5 redirects (bash: the first).
_http() {
  if command -v curl >/dev/null 2>&1; then
    if [ -n "$2" ]; then set -- "$1" -L --max-redirs 5; else set -- "$1"; fi
    c=$(curl -sk -o /dev/null -m 5 -w '%{http_code}' "$@" 2>/dev/null)
  elif command -v wget >/dev/null 2>&1; then
    # wget follows redirects whatever it's told (busybox's can't be told): -S prints each answer.
    if [ -n "$2" ]; then _n=6; else _n=1; fi
    c=$(wget -q -S -O /dev/null -T 5 --no-check-certificate "$1" 2>&1 | sed -n 's/^ *HTTP\/[0-9.]* \([0-9][0-9][0-9]\).*/\1/p' | head -n $_n | tail -n 1)
  else
    u=${1#*://}; hp=${u%%/*}; p=/${u#*/}; [ "$u" = "$hp" ] && p=/
    h=${hp%%:*}; port=${hp#*:}; [ "$hp" = "$h" ] && port=80
    c=$(H=$h P=$port U=$p timeout 5 bash -c 'exec 3<>/dev/tcp/$H/$P && printf "GET %s HTTP/1.0\r\nHost: %s\r\n\r\n" "$U" "$H" >&3 && read -r l <&3 && echo "$l"' 2>/dev/null | sed -n 's/^HTTP\/[0-9.]* \([0-9][0-9][0-9]\).*/\1/p')
  fi
  echo "${c:-000}"
}
_http_is() { [ "$(_http "$1" "$3")" = "$2" ]; }
# _req STATUS|any TEXT CURL-ARGS... -> 0 when the request gets that status (any answer for `any`)
# and its body contains TEXT (if any); $out says why not. Needs curl.
_req() {
  want=$1; text=$2; shift 2
  command -v curl >/dev/null 2>&1 || { out="curl is needed for this check"; return 1; }
  b=$(mktemp); c=$(curl -sk -m 10 -o "$b" -w '%{http_code}' "$@" 2>/dev/null); c=${c:-000}; r=0
  if [ "$want" = any ]; then [ "$c" != 000 ] || r=1; else [ "$c" = "$want" ] || r=1; fi
  if [ $r = 1 ]; then out="expected HTTP $want, got $c"
  elif [ -n "$text" ] && ! grep -qF -- "$text" "$b"; then r=1; out="HTTP $c, but the response doesn't contain the expected text"
  fi
  rm -f "$b"; return $r
}
_http_any() { [ "$(_http "$1" "$2")" != 000 ]; }
# _tcp HOST PORT -> 0 when it connects (nc, else bash).
_tcp() {
  if command -v nc >/dev/null 2>&1; then nc -z -w 5 "$1" "$2" >/dev/null 2>&1
  else H=$1 P=$2 timeout 5 bash -c 'exec 3<>/dev/tcp/$H/$P' >/dev/null 2>&1
  fi
}
# _tcp_read HOST PORT LINE TEXT -> 0 when the bytes read within 5s of connecting (after writing
# LINE and a newline, if any) contain TEXT; $out says why not (nc, else bash). Stdin stays open
# while reading (some nc quit at its end), and nc is stopped after 5s whatever its flavor.
_tcp_read() {
  f=$(mktemp); i=0; r=1
  if command -v nc >/dev/null 2>&1; then
    { [ -z "$3" ] || printf '%s\n' "$3"; j=0; while [ ! -e "$f.end" ] && [ $j -lt 6 ]; do sleep 1; j=$((j+1)); done; } | nc "$1" "$2" >"$f" 2>/dev/null &
  else
    H=$1 P=$2 L=$3 timeout 6 bash -c 'exec 3<>/dev/tcp/$H/$P || exit 1; [ -z "$L" ] || printf "%s\n" "$L" >&3; cat <&3' >"$f" 2>/dev/null &
  fi
  p=$!
  while :; do
    if grep -qF -- "$4" "$f"; then r=0; break; fi
    [ $i -lt 5 ] && kill -0 $p 2>/dev/null || break
    sleep 1; i=$((i+1))
  done
  [ $r = 0 ] || ! grep -qF -- "$4" "$f" || r=0
  touch "$f.end"; kill $p 2>/dev/null
  if [ $r = 1 ]; then
    if [ -s "$f" ]; then out="$1:$2 answered \"$(head -c 100 "$f" | tr -d '\000\r' | tr '\n\t' '  ')\", without the expected text"
    elif [ $i -lt 5 ]; then out="$1:$2 refused the connection or closed it without a word"
    else out="nothing read from $1:$2 within 5s"; fi
  fi
  rm -f "$f" "$f.end"; return $r
}
# _exec COMMAND TEXT -> 0 when the command succeeds and its output contains TEXT (if any).
_exec() { out=$(sh -c "$1" 2>&1) && { [ -z "$2" ] || printf '%s\n' "$out" | grep -qF -- "$2"; }; }
# _retry SECONDS COMMAND... -> keeps trying every 2s until it passes or the time is up.
_retry() { _end=$(( $(date +%s) + $1 )); shift; while ! "$@"; do [ "$(date +%s)" -lt "$_end" ] || return 1; sleep 2; done; }

echo "isoloom-check: END $passed passed, $failed failed"
[ "$failed" -eq 0 ]

