_tcp_read() {
  f=$(mktemp); i=0; r=1
  if command -v nc >/dev/null 2>&1; then
    { [ -z "$3" ] || printf '%s\n' "$3"; j=0; while [ ! -e "$f.end" ] && [ $j -lt 6 ]; do sleep 1; j=$((j+1)); done; } | nc "$1" "$2" >"$f" 2>/dev/null &
  else
    # shellcheck disable=SC2016 # the inner bash expands $H, $P and $L, for its /dev/tcp
    H=$1 P=$2 L=$3 timeout 6 bash -c 'exec 3<>/dev/tcp/$H/$P || exit 1; [ -z "$L" ] || printf "%s\n" "$L" >&3; cat <&3' >"$f" 2>/dev/null &
  fi
  p=$!
  while :; do
    if grep -qF -- "$4" "$f"; then r=0; break; fi
    if [ $i -ge 5 ] || ! kill -0 $p 2>/dev/null; then break; fi
    sleep 1; i=$((i+1))
  done
  [ $r = 0 ] || ! grep -qF -- "$4" "$f" || r=0
  touch "$f.end"; kill $p 2>/dev/null
  if [ $r = 1 ]; then
    if [ -s "$f" ]; then out="$1:$2 answered \"$(head -c 100 "$f" | tr -d '\000\r' | tr '\n\t' '  ')\", without the expected text"
    elif [ $i -lt 5 ]; then out="$1:$2 refused the connection or closed it without a word"
    else out="nothing read from $1:$2 within 5s"; fi
  fi
  rm -f "$f" "$f.end"; return $r
}
# _exec COMMAND TEXT -> 0 when the command succeeds and its output contains TEXT (if any).
_exec() { out=$(sh -c "$1" 2>&1) && { [ -z "$2" ] || printf '%s\n' "$out" | grep -qF -- "$2"; }; }
# _retry SECONDS COMMAND... -> keeps trying every 2s until it passes or the time is up.
_retry() { _end=$(( $(date +%s) + $1 )); shift; while ! "$@"; do [ "$(date +%s)" -lt "$_end" ] || return 1; sleep 2; done; }

echo '== checks/dmz-reachable.sh'
if _retry 0 sh -c 'cd /isoloom/project && sh '\''checks/dmz-reachable.sh'\'''; then pass 'checks/dmz-reachable.sh'; else fail 'checks/dmz-reachable.sh' "checks/dmz-reachable.sh exited non-zero"; fi

echo '== checks/internal-not-reachable-from-access.sh'
if _retry 0 sh -c 'cd /isoloom/project && sh '\''checks/internal-not-reachable-from-access.sh'\'''; then pass 'checks/internal-not-reachable-from-access.sh'; else fail 'checks/internal-not-reachable-from-access.sh' "checks/internal-not-reachable-from-access.sh exited non-zero"; fi

if [ "${ISOLOOM_DERIVED:-1}" != 0 ]; then
if _retry 30 _tcp '10.30.10.10' 80; then pass 'gateway:80 on dmz from user'; else fail 'gateway:80 on dmz from user' "nothing listens at 10.30.10.10:80"; fi
fi

if [ "${ISOLOOM_DERIVED:-1}" != 0 ]; then
if _retry 30 _tcp '10.30.10.10' 22; then pass 'gateway:22 on dmz from user'; else fail 'gateway:22 on dmz from user' "nothing listens at 10.30.10.10:22"; fi
fi

if [ "${ISOLOOM_DERIVED:-1}" != 0 ]; then
if _tcp '10.30.20.20' 8080; then fail 'app:8080 blocked from user' "10.30.20.20:8080 answered; it should be blocked"; else pass 'app:8080 blocked from user'; fi
fi

if [ "${ISOLOOM_DERIVED:-1}" != 0 ]; then
if _tcp '10.30.20.30' 5432; then fail 'db:5432 blocked from user' "10.30.20.30:5432 answered; it should be blocked"; else pass 'db:5432 blocked from user'; fi
fi

echo "isoloom-check: END $passed passed, $failed failed"
[ "$failed" -eq 0 ]

## .isoloom/docker/compose.yml
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  docker compose -f .isoloom/docker/compose.yml up -d --build --wait
# Access: docker compose -f .isoloom/docker/compose.yml --profile access up -d user
# Checks: docker compose -f .isoloom/docker/compose.yml --profile check run --rm isoloom-check
#         docker compose -f .isoloom/docker/compose.yml --profile check run --rm isoloom-check-gateway
#         docker compose -f .isoloom/docker/compose.yml --profile check run --rm isoloom-check-app
#         docker compose -f .isoloom/docker/compose.yml --profile check run --rm isoloom-check-db
#         Each prints a PASS or FAIL line per check, and fails when one does (`run -e ISOLOOM_DERIVED=0` leaves the derived checks out).
#         Then docker compose -f .isoloom/docker/compose.yml --profile check rm -sf isoloom-access isoloom-routes-isoloom-access: the access machine's stand-in, which a run starts.
# Stop:   docker compose -f .isoloom/docker/compose.yml --profile check down -v

name: dmz-jump
services:
  isoloom-router:
    image: alpine:3.24@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf
    sysctls:
      net.ipv4.ip_forward: '1'
    init: true
    entrypoint:
    - /bin/sh
    - -c
    - apk add --no-cache nftables dnsmasq >/dev/null && printf '%s' "$$RULES" | nft -f - && printf '%s' "$$HOSTS" > /etc/isoloom-hosts && dnsmasq --no-hosts --addn-hosts=/etc/isoloom-hosts --no-resolv --server=127.0.0.11 --bind-interfaces --except-interface=lo && exec sleep infinity
    hostname: isoloom-router
    networks:
      dmz:
        ipv4_address: 10.30.10.254
      internal:
        ipv4_address: 10.30.20.254
      access:
        ipv4_address: 10.30.99.254
    cap_add:
    - NET_ADMIN
    environment:
      RULES: |
        table inet isoloom {
          chain forward {
            type filter hook forward priority 0; policy drop;
            ct state established,related accept
            ip saddr 10.30.99.0/24 ip daddr 10.30.10.0/24 accept
            ip saddr 10.30.10.0/24 ip daddr 10.30.20.0/24 meta l4proto { tcp, udp } th dport { 8080, 5432 } accept
            ip saddr 10.30.10.0/24 ip daddr 10.30.20.0/24 icmp type echo-request accept
          }
        }
      HOSTS: |
        10.30.10.10 gateway
        10.30.20.20 app
        10.30.20.30 db
        10.30.99.10 user
    healthcheck:
      test:
      - CMD-SHELL
      - nft list table inet isoloom >/dev/null 2>&1 && pidof dnsmasq >/dev/null
      interval: 3s
      timeout: 3s
      retries: 60
    labels:
      isoloom.managed: 'true'
      isoloom.environment: dmz-jump
    restart: unless-stopped
  gateway:
    build:
      context: ../../build/gateway
      labels:
        isoloom.managed: 'true'
        isoloom.environment: dmz-jump
    image: localhost/isoloom/dmz-jump-gateway
    dns:
    - 10.30.10.254
    hostname: gateway
    networks:
      dmz:
        ipv4_address: 10.30.10.10
      internal:
        ipv4_address: 10.30.20.10
    volumes:
    - isoloom-probe:/.isoloom-probe:ro
    healthcheck:
      test:
      - CMD
      - /.isoloom-probe/busybox
      - sh
      - -c
      - /.isoloom-probe/busybox nc -z -w 2 127.0.0.1 80 && /.isoloom-probe/busybox nc -z -w 2 127.0.0.1 22
      interval: 5s
      timeout: 3s
      retries: 60
      start_period: 10s
    depends_on:
      isoloom-probe:
        condition: service_completed_successfully
    labels:
      isoloom.port.web: tcp:80
      isoloom.port.ssh: tcp:22
      isoloom.managed: 'true'
      isoloom.environment: dmz-jump
    restart: unless-stopped
  isoloom-routes-gateway:
    image: alpine:3.24@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf
    init: true
    entrypoint:
    - /bin/sh
    - -c
    - ip route replace 10.30.99.0/24 via 10.30.10.254 && while ip -o -4 addr show | grep -qv ' lo '; do sleep 2; done; exit 1
    network_mode: service:gateway
    cap_add:
    - NET_ADMIN
    healthcheck:
      test:
      - CMD-SHELL
      - ip route show 10.30.99.0/24 | grep -q via
      interval: 2s
      timeout: 2s
      retries: 30
    depends_on:
      gateway:
        condition: service_started
      isoloom-router:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: dmz-jump
    restart: unless-stopped
  app:
    build:
      context: ../../build/app
      labels:
        isoloom.managed: 'true'
        isoloom.environment: dmz-jump
    image: localhost/isoloom/dmz-jump-app
    dns:
    - 10.30.20.254
    hostname: app
    networks:
      internal:
        ipv4_address: 10.30.20.20
    volumes:
    - isoloom-probe:/.isoloom-probe:ro
    healthcheck:
      test:
      - CMD
      - /.isoloom-probe/busybox
      - sh
      - -c
      - /.isoloom-probe/busybox nc -z -w 2 127.0.0.1 8080
      interval: 5s
      timeout: 3s
      retries: 60
      start_period: 10s
    depends_on:
      isoloom-probe:
        condition: service_completed_successfully
    labels:
      isoloom.port.api: tcp:8080
      isoloom.managed: 'true'
      isoloom.environment: dmz-jump
    restart: unless-stopped
  isoloom-routes-app:
    image: alpine:3.24@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf
    init: true
    entrypoint:
    - /bin/sh
    - -c
    - ip route replace 10.30.10.0/24 via 10.30.20.254 && ip route replace 10.30.99.0/24 via 10.30.20.254 && (ip route del default 2>/dev/null || true) && while ip -o -4 addr show | grep -qv ' lo '; do sleep 2; done; exit 1
    network_mode: service:app
    cap_add:
    - NET_ADMIN
    healthcheck:
      test:
      - CMD-SHELL
      - ip route show 10.30.10.0/24 | grep -q via && ! ip route | grep -q '^default'
      interval: 2s
      timeout: 2s
      retries: 30
    depends_on:
      app:
        condition: service_started
      isoloom-router:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: dmz-jump
    restart: unless-stopped
  db:
    image: postgres:16
    dns:
    - 10.30.20.254
    hostname: db
    networks:
      internal:
        ipv4_address: 10.30.20.30
    volumes:
    - isoloom-probe:/.isoloom-probe:ro
    healthcheck:
      test:
      - CMD
      - /.isoloom-probe/busybox
      - sh
      - -c
      - /.isoloom-probe/busybox nc -z -w 2 127.0.0.1 5432
      interval: 5s
      timeout: 3s
      retries: 60
      start_period: 10s
    depends_on:
      isoloom-probe:
        condition: service_completed_successfully
    labels:
      isoloom.port.postgres: tcp:5432
      isoloom.managed: 'true'
      isoloom.environment: dmz-jump
    restart: unless-stopped
  isoloom-routes-db:
    image: alpine:3.24@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf
    init: true
    entrypoint:
    - /bin/sh
    - -c
    - ip route replace 10.30.10.0/24 via 10.30.20.254 && ip route replace 10.30.99.0/24 via 10.30.20.254 && (ip route del default 2>/dev/null || true) && while ip -o -4 addr show | grep -qv ' lo '; do sleep 2; done; exit 1
    network_mode: service:db
    cap_add:
    - NET_ADMIN
    healthcheck:
      test:
      - CMD-SHELL
      - ip route show 10.30.10.0/24 | grep -q via && ! ip route | grep -q '^default'
      interval: 2s
      timeout: 2s
      retries: 30
    depends_on:
      db:
        condition: service_started
      isoloom-router:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: dmz-jump
    restart: unless-stopped
  user:
    image: ${ISOLOOM_ACCESS_IMAGE:-debian:12@sha256:2c037a04925515fdd6ea85ea14a682d0e79931f5e9f5d07b6dbfc6ba12f9e858}
    profiles:
    - access
    dns:
    - 10.30.99.254
    init: true
    entrypoint:
    - sleep
    - infinity
    hostname: user
    networks:
      access:
        ipv4_address: 10.30.99.10
    labels:
      isoloom.managed: 'true'
      isoloom.environment: dmz-jump
    restart: unless-stopped
  isoloom-routes-user:
    image: alpine:3.24@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf
    profiles:
    - access
    init: true
    entrypoint:
    - /bin/sh
    - -c
    - ip route replace 10.30.10.0/24 via 10.30.99.254 && ip route replace 10.30.20.0/24 via 10.30.99.254 && while ip -o -4 addr show | grep -qv ' lo '; do sleep 2; done; exit 1
    network_mode: service:user
    cap_add:
    - NET_ADMIN
    healthcheck:
      test:
      - CMD-SHELL
      - ip route show 10.30.10.0/24 | grep -q via
      interval: 2s
      timeout: 2s
      retries: 30
    depends_on:
      user:
        condition: service_started
      isoloom-router:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: dmz-jump
    restart: unless-stopped
  isoloom-access:
    image: alpine:3.24@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf
    profiles:
    - check
    dns:
    - 10.30.99.254
    init: true
    entrypoint:
    - sleep
    - infinity
    hostname: user
    networks:
      access:
        ipv4_address: 10.30.99.10
    labels:
      isoloom.managed: 'true'
      isoloom.environment: dmz-jump
  isoloom-routes-isoloom-access:
    image: alpine:3.24@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf
    profiles:
    - check
    init: true
    entrypoint:
    - /bin/sh
    - -c
    - ip route replace 10.30.10.0/24 via 10.30.99.254 && ip route replace 10.30.20.0/24 via 10.30.99.254 && while ip -o -4 addr show | grep -qv ' lo '; do sleep 2; done; exit 1
    network_mode: service:isoloom-access
    cap_add:
    - NET_ADMIN
    healthcheck:
      test:
      - CMD-SHELL
      - ip route show 10.30.10.0/24 | grep -q via
      interval: 2s
      timeout: 2s
      retries: 30
    depends_on:
      isoloom-access:
        condition: service_started
      isoloom-router:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: dmz-jump
    restart: unless-stopped
  isoloom-check:
    image: curlimages/curl:8.22.0@sha256:58adaa4e8dca9c988bae2aba4ab3434a0bb2da16bbe3f92dec39ec7785166777
    profiles:
    - check
    entrypoint:
