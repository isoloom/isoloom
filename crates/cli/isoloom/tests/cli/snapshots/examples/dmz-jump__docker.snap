      config:
      - subnet: 10.30.99.0/24
        gateway: 10.30.99.1
    labels:
      isoloom.managed: 'true'
      isoloom.environment: dmz-jump
volumes:
  isoloom-probe:
    labels:
      isoloom.managed: 'true'
      isoloom.environment: dmz-jump

