        condition: service_healthy
      app:
        condition: service_healthy
      isoloom-routes-app:
        condition: service_healthy
      db:
        condition: service_healthy
      isoloom-routes-db:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: dmz-jump
  isoloom-probe:
    image: busybox:1.37.0-musl@sha256:f6a95d611e0a8780fabdb2aec43e31275b2720dfefa3e41b16835bfc42454478
    entrypoint:
    - /bin/cp
    - /bin/busybox
    - /probe/busybox
    network_mode: none
    volumes:
    - isoloom-probe:/probe
    labels:
      isoloom.managed: 'true'
      isoloom.environment: dmz-jump
    restart: no
networks:
  dmz:
    ipam:
      config:
      - subnet: 10.30.10.0/24
        gateway: 10.30.10.1
    labels:
      isoloom.managed: 'true'
      isoloom.environment: dmz-jump
  internal:
    ipam:
      config:
      - subnet: 10.30.20.0/24
        gateway: 10.30.20.1
    labels:
      isoloom.managed: 'true'
      isoloom.environment: dmz-jump
  access:
