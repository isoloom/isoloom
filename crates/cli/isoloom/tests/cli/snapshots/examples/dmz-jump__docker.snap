    entrypoint:
    - /bin/sh
    - /isoloom/run.sh
    network_mode: service:app
    volumes:
    - ./checks/app.sh:/isoloom/run.sh:ro,z
    depends_on:
      gateway:
        condition: service_healthy
      isoloom-routes-gateway:
        condition: service_healthy
      app:
        condition: service_healthy
      isoloom-routes-app:
        condition: service_healthy
      db:
        condition: service_healthy
      isoloom-routes-db:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: dmz-jump
  isoloom-check-db:
    image: curlimages/curl:8.22.0@sha256:58adaa4e8dca9c988bae2aba4ab3434a0bb2da16bbe3f92dec39ec7785166777
    profiles:
