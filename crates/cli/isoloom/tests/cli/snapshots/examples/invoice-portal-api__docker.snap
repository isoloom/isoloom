_retry() { _end=$(( $(date +%s) + $1 )); shift; while ! "$@"; do [ "$(date +%s)" -lt "$_end" ] || return 1; sleep 2; done; }

if _retry 30 _http_is 'http://web/api/invoices/INV-1042' 401; then pass 'the API refuses a request without its key'; else fail 'the API refuses a request without its key' "expected HTTP 401 from http://web/api/invoices/INV-1042, got $(_http 'http://web/api/invoices/INV-1042')"; fi

echo '== build/check/check.sh'
if _retry 0 sh -c 'cd /isoloom/project && sh '\''build/check/check.sh'\'''; then pass 'build/check/check.sh'; else fail 'build/check/check.sh' "build/check/check.sh exited non-zero"; fi

echo "isoloom-check: END $passed passed, $failed failed"
[ "$failed" -eq 0 ]

