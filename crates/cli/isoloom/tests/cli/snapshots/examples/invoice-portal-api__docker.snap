## .isoloom/docker/compose.yml
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  docker compose -f .isoloom/docker/compose.yml up -d --build --wait
# Inputs: set CTF_API_URL in Compose's environment (the shell's, else .env) for `up` and `start` (unset: empty).
# Checks: docker compose -f .isoloom/docker/compose.yml --profile check run --rm isoloom-check
#         docker compose -f .isoloom/docker/compose.yml --profile check run --rm isoloom-check-database
#         docker compose -f .isoloom/docker/compose.yml --profile check run --rm isoloom-check-web
#         Each prints a PASS or FAIL line per check, and fails when one does (`run -e ISOLOOM_DERIVED=0` leaves the derived checks out).
# Stop:   docker compose -f .isoloom/docker/compose.yml --profile check down -v
# Secrets and inputs, delivered as files: set CTF_LAUNCH_TOKEN in Compose's environment for `up` and `start` (each value, never in this file).

name: invoice-portal-api
services:
  database:
    build:
      context: ../../build/database
      labels:
        isoloom.managed: 'true'
        isoloom.environment: invoice-portal-api
    image: localhost/isoloom/invoice-portal-api-database
    hostname: database
    networks:
      lab:
        ipv4_address: 10.20.0.32
    environment:
      CTF_API_URL: ${CTF_API_URL:-}
    volumes:
    - database-evidence:/var/lib/ctf
    - isoloom-probe:/.isoloom-probe:ro
    secrets:
    - source: input-ctf-launch-token
      target: /run/lab/launch-token
      mode: '0400'
    healthcheck:
      test:
      - CMD
      - /.isoloom-probe/busybox
      - sh
      - -c
      - /.isoloom-probe/busybox nc -z -w 2 127.0.0.1 3207
      interval: 5s
      timeout: 3s
      retries: 60
      start_period: 10s
    depends_on:
      isoloom-probe:
        condition: service_completed_successfully
    deploy:
      resources:
        limits:
          cpus: '1'
          memory: 1024M
    labels:
      isoloom.port.mysql: tcp:3207
      isoloom.managed: 'true'
      isoloom.environment: invoice-portal-api
    restart: unless-stopped
  isoloom-init-database-1:
    build:
      context: ../../build/database
      labels:
        isoloom.managed: 'true'
        isoloom.environment: invoice-portal-api
    image: localhost/isoloom/invoice-portal-api-database
    user: root
    entrypoint:
    - /bin/sh
    - /isoloom/init/evidence.sh
    network_mode: service:database
    environment:
      CTF_API_URL: ${CTF_API_URL:-}
    volumes:
    - ../../build/database/evidence.sh:/isoloom/init/evidence.sh:ro,z
    - ../..:/opt/isoloom:ro,z
    - database-evidence:/var/lib/ctf
    secrets:
    - source: input-ctf-launch-token
      target: /run/lab/launch-token
      mode: '0400'
    depends_on:
      database:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: invoice-portal-api
    restart: no
  web:
    build:
      context: ../../build/web
      labels:
        isoloom.managed: 'true'
        isoloom.environment: invoice-portal-api
    image: localhost/isoloom/invoice-portal-api-web
    hostname: web
    networks:
      lab:
        ipv4_address: 10.20.0.31
    ports:
    - ${ISOLOOM_PUBLISH_ADDRESS:-127.0.0.1}:8080:80
    volumes:
    - isoloom-probe:/.isoloom-probe:ro
    healthcheck:
      test:
      - CMD
      - /.isoloom-probe/busybox
      - sh
      - -c
      - /.isoloom-probe/busybox nc -z -w 2 127.0.0.1 80
      interval: 5s
      timeout: 3s
      retries: 60
      start_period: 10s
    depends_on:
      isoloom-probe:
        condition: service_completed_successfully
      database:
        condition: service_healthy
      isoloom-init-database-1:
        condition: service_completed_successfully
    deploy:
      resources:
        limits:
          cpus: '1'
          memory: 1024M
    labels:
      isoloom.port.portal: http:80
      isoloom.managed: 'true'
      isoloom.environment: invoice-portal-api
    restart: unless-stopped
  isoloom-check:
    image: curlimages/curl:8.22.0@sha256:58adaa4e8dca9c988bae2aba4ab3434a0bb2da16bbe3f92dec39ec7785166777
    profiles:
    - check
    entrypoint:
    - /bin/sh
    - /isoloom/run.sh
    networks:
      lab: null
    volumes:
    - ./checks/isoloom-networks.sh:/isoloom/run.sh:ro,z
    - ../..:/isoloom/project:ro,z
    depends_on:
      database:
        condition: service_healthy
      isoloom-init-database-1:
        condition: service_completed_successfully
      web:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: invoice-portal-api
  isoloom-check-database:
