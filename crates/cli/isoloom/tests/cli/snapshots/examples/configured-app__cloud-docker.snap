## .isoloom/cloud-docker/aws/main.tf
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  terraform -chdir=.isoloom/cloud-docker/aws init && terraform -chdir=.isoloom/cloud-docker/aws apply \
#           -var allowed_cidr=<your IP>/32 -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)" -var ssh_private_key_file=~/.ssh/id_ed25519
# Stop:   terraform -chdir=.isoloom/cloud-docker/aws destroy (same variables)

terraform {
  required_version = ">= 1.6.0"
  backend "local" {}
  required_providers {
    aws   = { source = "hashicorp/aws", version = "~> 6.67.0" }
    local = { source = "hashicorp/local", version = "~> 2.9.1" }
  }
}

variable "region" {
  type    = string
  default = "eu-west-3"
}

variable "instance_type" {
  type    = string
  default = "t3.small"
}

variable "allowed_cidr" {
  type        = string
  description = "Who may reach the machines (SSH and the published ports), e.g. your IP/32"
}

variable "ssh_public_key" {
  type        = string
  description = "The SSH public key the machines let in: Terraform signs in with its private half (`ssh_private_key_file`) to set them up or wait for their set-up, and so can you, to run the checks"
}

variable "ssh_private_key_file" {
  type        = string
  description = "The private key of ssh_public_key (a path, ~ allowed): Terraform signs in to the machines with it to bring the project in and wait for their set-up"
}

variable "expires_at" {
  type        = string
  default     = ""
  description = "When the environment should end, in Unix seconds (empty: no end): a tag on every resource, so a reaper finds what to destroy, and the time the machines shut themselves down"
}

provider "aws" {
  region = var.region
  default_tags {
    tags = {
      isoloom-environment = "configured-app"
      managed-by          = "isoloom"
      isoloom-instance    = local.name
      isoloom-expires-at  = var.expires_at
    }
  }
}

resource "terraform_data" "id" {
  input = substr(replace(uuid(), "-", ""), 0, 8)
  lifecycle {
    ignore_changes = [input]
  }
}

locals {
  name = "isoloom-configured-app-${terraform_data.id.output}"
  root = abspath("${path.module}/../../..")
}

data "aws_availability_zones" "available" {
  state = "available"
}

data "aws_ami" "debian_12" {
  most_recent = true
  owners      = ["136693071363"]
  filter {
    name   = "name"
    values = ["debian-12-amd64-*"]
  }
  filter {
    name   = "architecture"
    values = ["x86_64"]
  }
}

resource "aws_vpc" "env" {
  cidr_block = "10.42.0.0/16"
  tags       = { Name = local.name }
}

resource "aws_internet_gateway" "env" {
  vpc_id = aws_vpc.env.id
  tags   = { Name = local.name }
}

resource "aws_subnet" "env" {
  vpc_id                  = aws_vpc.env.id
  cidr_block              = "10.42.1.0/24"
  availability_zone       = data.aws_availability_zones.available.names[0]
  map_public_ip_on_launch = true
  tags                    = { Name = local.name }
}

resource "aws_route_table" "env" {
  vpc_id = aws_vpc.env.id
  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.env.id
  }
  tags = { Name = local.name }
}

resource "aws_route_table_association" "env" {
  subnet_id      = aws_subnet.env.id
  route_table_id = aws_route_table.env.id
}

resource "aws_key_pair" "env" {
  key_name   = local.name
  public_key = var.ssh_public_key
}

resource "aws_security_group" "env" {
  name   = local.name
  vpc_id = aws_vpc.env.id
  ingress {
    description = "SSH"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [var.allowed_cidr]
  }
  ingress {
    description = "published 8086"
    from_port   = 8086
    to_port     = 8086
    protocol    = "tcp"
    cidr_blocks = [var.allowed_cidr]
  }
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_instance" "env" {
  instance_initiated_shutdown_behavior = "terminate"
  metadata_options {
    http_tokens = "required"
  }
  ami                    = data.aws_ami.debian_12.id
  instance_type          = var.instance_type
  subnet_id              = aws_subnet.env.id
  key_name               = aws_key_pair.env.key_name
  vpc_security_group_ids = [aws_security_group.env.id]
  user_data_base64       = base64gzip("#!/bin/sh\n# Isoloom: this machine sets itself up. Its progress is in /var/lib/isoloom/ready (isoloom-ready/1), its output in /var/log/isoloom-setup.log. The project comes over SSH from Terraform.\nmkdir -p /var/lib/isoloom\nrm -f /var/lib/isoloom/setup.sh.new\n(umask 077 && cat > /var/lib/isoloom/setup.sh.new) <<'ISOLOOM_SETUP'\n#!/bin/sh\numask 022\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\nstate=$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\npart=$(cat /var/lib/isoloom/part 2>/dev/null || echo 1)\ncase \"$state\" in ready|\"failed: \"*) exit 0 ;; esac\nif [ \"$part\" = 1 ]; then\necho 'running: waiting for the project (Terraform brings it in over SSH)' > /var/lib/isoloom/ready; { i=0; until [ -f /var/lib/isoloom/project-delivered ]; do [ \"$i\" -gt 0 ] || echo 'waiting for the project, which Terraform brings in over SSH during its apply'; i=$((i+5)); if [ \"$i\" -gt 2400 ]; then echo 'the project never came: Terraform brings it in over SSH during its apply (its terraform_data.isoloom_ready_<machine>), with ssh_private_key_file' >&2; exit 1; fi; sleep 5; done; } || { echo 'failed: waiting for the project (Terraform brings it in over SSH)' > /var/lib/isoloom/ready; exit 1; }\necho 'running: Docker' > /var/lib/isoloom/ready; { sh -c 'set -e\ncloud-init status --wait >/dev/null 2>&1 || true\ncommand -v docker >/dev/null || if command -v apt-get >/dev/null; then (\n  set -e\n  export DEBIAN_FRONTEND=noninteractive\n  apt-get update -qq\n  apt-get install -y -qq ca-certificates curl\n  install -m 0755 -d /etc/apt/keyrings\n  k=$(mktemp)\n  # shellcheck disable=SC1091,SC2154 # /etc/os-release is on the guest, not here.\n  _id=$(. /etc/os-release && printf %s \"$ID\")\n  # shellcheck disable=SC1091,SC2154\n  _cn=$(. /etc/os-release && printf %s \"$VERSION_CODENAME\")\n  curl -fsSL \"https://download.docker.com/linux/$_id/gpg\" -o \"$k\"\n  echo \"1500c1f56fa9e26b9b8f42452a553675796ade0807cdce11975eb98170b3a570  $k\" | sha256sum -c -\n  install -m 0644 \"$k\" /etc/apt/keyrings/docker.asc\n  rm -f \"$k\"\n  echo \"deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/$_id $_cn stable\" > /etc/apt/sources.list.d/docker.list\n  apt-get update -qq\n  v=$(apt-cache madison docker-ce | awk '\\''$3 ~ /(^|:)29[.]9[.]0/ { print $3; exit }'\\'')\n  [ -n \"$v\" ] || { echo \"docker-ce 29.9.0 is not in Docker'\\''s apt repository\" >&2; exit 1; }\n  apt-get install -y -qq --allow-downgrades \"docker-ce=$v\" \"docker-ce-cli=$v\" containerd.io docker-buildx-plugin \"docker-compose-plugin=5.6.0-*\"\n  # A container pinned to x86 (its spec'\\''s hardware.arch, or an image published for x86 only): on\n  # another CPU (an Apple Silicon Mac'\\''s VM, an Arm cloud VM) the engine runs it through QEMU'\\''s\n  # user-mode emulation, which Debian registers with binfmt for every container (Docker Desktop\n  # does the same on its own).\n  [ \"$(dpkg --print-architecture)\" = amd64 ] || apt-get install -y -qq qemu-user-static binfmt-support\n)\nelse\n  curl -fsSL https://get.docker.com | VERSION=29.9.0 sh\nfi\ncat > /etc/systemd/system/isoloom-published.service <<'\\''UNIT'\\''\n[Unit]\nDescription=Isoloom: published ports reach containers of networks without a default route\nAfter=docker.service\nWants=docker.service\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=/bin/sh -c '\\''iptables -t nat -C POSTROUTING -m conntrack --ctstate DNAT -o br-+ -j MASQUERADE 2>/dev/null || iptables -t nat -I POSTROUTING -m conntrack --ctstate DNAT -o br-+ -j MASQUERADE'\\''\n\n[Install]\nWantedBy=multi-user.target\nUNIT\nsystemctl daemon-reload\nsystemctl enable --now isoloom-published.service\n'; } || { echo 'failed: Docker' > /var/lib/isoloom/ready; exit 1; }\necho 'running: the containers (1)' > /var/lib/isoloom/ready; { sh -c 'cd /opt/isoloom && env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name configured-app --file .isoloom/docker/compose.yml up --detach --build --pull missing --remove-orphans --wait --wait-timeout 600'; } || { echo 'failed: the containers (1)' > /var/lib/isoloom/ready; exit 1; }\nfi\necho ready > /var/lib/isoloom/ready\nrm -f /var/lib/isoloom/part\nexit 0\nISOLOOM_SETUP\nmv -f /var/lib/isoloom/setup.sh.new /var/lib/isoloom/setup.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-setup.service <<'ISOLOOM_UNIT'\n[Unit]\nDescription=Isoloom: the machine's set-up\nWants=network-online.target\nAfter=network-online.target cloud-final.service google-startup-scripts.service\n\n[Service]\nType=oneshot\nExecStart=/bin/sh /var/lib/isoloom/setup.sh\nStandardOutput=append:/var/log/isoloom-setup.log\nStandardError=append:/var/log/isoloom-setup.log\nTimeoutStartSec=0\n\n[Install]\nWantedBy=multi-user.target\nISOLOOM_UNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-setup.service >/dev/null 2>&1\nsystemctl start --no-block isoloom-setup.service\nelse\nnohup sh /var/lib/isoloom/setup.sh >> /var/log/isoloom-setup.log 2>&1 &\nfi\n")
  lifecycle {
    ignore_changes = [user_data_base64]
  }
  root_block_device {
    volume_size = 40
    volume_type = "gp3"
    encrypted   = true
  }
  depends_on = [aws_route_table_association.env]
  tags       = { Name = local.name }
}

resource "terraform_data" "isoloom_ready_docker_host" {
  triggers_replace = [aws_instance.env.id]
  connection {
    type        = "ssh"
    host        = aws_instance.env.public_ip
    user        = "admin"
    private_key = file(pathexpand(var.ssh_private_key_file))
    timeout     = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-ready_docker_host.tgz\" --exclude=\"${basename(local.root)}/.isoloom*\" --exclude=\".git\" --exclude=\".terraform\" --exclude=\"*.tfstate\" --exclude=\"*.tfstate.*\" --exclude=\".terraform.tfstate.lock.info\" --exclude=\"crash.log\" --exclude=\"crash.*.log\" --exclude=\".vagrant\" -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-ready_docker_host.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-outputs-docker_host.tgz\" -C \"${abspath(local.root)}\" .isoloom/docker .isoloom/configure"
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-outputs-docker_host.tgz"
    destination = "/tmp/isoloom-outputs.tgz"
  }
  provisioner "remote-exec" {
    inline = [
      "sudo sh -c 'rm -rf /opt/isoloom && mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz && tar -xzf /tmp/isoloom-outputs.tgz -C /opt/isoloom && rm -f /tmp/isoloom-outputs.tgz && mkdir -p /var/lib/isoloom && touch /var/lib/isoloom/project-delivered'"
    ]
  }
  provisioner "remote-exec" {
    inline = [
      "sh -c 't=0\nif command -v cloud-init >/dev/null 2>&1; then sudo cloud-init status --wait >/dev/null 2>&1 || true; fi\nwhile :; do\ns=$(sudo head -n1 /var/lib/isoloom/ready 2>/dev/null)\ncase \"$s\" in\nready) echo \"docker-host: set up\"; exit 0 ;;\n\"failed: \"*) echo \"docker-host: its set-up stopped ($s); the end of /var/log/isoloom-setup.log:\"; sudo tail -n 40 /var/log/isoloom-setup.log 2>/dev/null; exit 1 ;;\nesac\nif [ \"$t\" -ge 2400 ]; then echo \"docker-host: not set up after 2400 s ($${s:-no ready file}); the end of /var/log/isoloom-setup.log:\"; sudo tail -n 40 /var/log/isoloom-setup.log 2>/dev/null; exit 1; fi\nsleep 5; t=$((t + 5))\ndone'"
    ]
  }
}

output "ip" {
  value = aws_instance.env.public_ip
}

output "ssh_user" {
  value = "admin"
}

# The project's files the machines don't get: what .isoloomignore at the project's root lists
# (gitignore-style: one pattern per line, `#` comments, `!` brings a path back, a trailing `/`
# matches folders only, a `/` at the start or in the middle anchors the pattern at the root; `*`,
# `?`, `[abc]`, `**`; the last pattern matching a path, or a folder it is in, decides), then
# Isoloom's outputs, version control and the tools' state. Read as regular expressions, as the
# Vagrantfiles do.
locals {
  project_ignore_lines = [for l in split("\n", "${replace(try(file("${local.root}/.isoloomignore"), ""), "\r", "")}\n/.isoloom*\n.git/\n.terraform/\n*.tfstate\n*.tfstate.*\n.terraform.tfstate.lock.info\ncrash.log\ncrash.*.log\n.vagrant/\n") : trimspace(l)]
  project_ignore_pats  = [for l in local.project_ignore_lines : { keep = startswith(l, "!"), pat = trimprefix(l, "!") } if l != "" && !startswith(l, "#")]
  project_ignore_globs = [for r in local.project_ignore_pats : merge(r, { glob = trimsuffix(trimsuffix(trimsuffix(r.pat, "/"), "/**"), "/") })]
  project_ignore = [for r in local.project_ignore_globs : {
    keep = r.keep
    re = format(r.glob == r.pat ? "^%s(/|$)" : "^%s/", replace(replace(replace(replace(replace(replace(replace(replace(
      length(split("/", r.glob)) > 1 ? trimprefix(r.glob, "/") : "**/${r.glob}",
    "/[.+^$(){}|\\\\]/", "\\$0"), "[!", "[^"), "**/", "\u0001"), "**", "\u0002"), "*", "[^/]*"), "?", "[^/]"), "\u0001", "(.*/)?"), "\u0002", ".*"))
  } if r.glob != ""]
  # Each file: whether it goes (the last matching pattern decides; none: it goes).
  project_keep    = { for f in fileset(local.root, "**") : f => reverse(concat([true], [for r in local.project_ignore : r.keep if length(regexall(r.re, f)) > 0]))[0] }
  project_ignored = [for f, keep in local.project_keep : f if !keep]
}

# What `tar` leaves out of the project's archive: .isoloomignore's files, from the archive's top
# folder, their wildcard characters escaped.
resource "local_file" "isoloom_project" {
  filename = "${path.module}/.isoloom-project-ignored.txt"
  content  = join("", [for f in local.project_ignored : "${replace("${basename(local.root)}/${f}", "/[\\\\*?\\[]/", "\\$0")}\n"])
}

## .isoloom/cloud-docker/azure/main.tf
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  terraform -chdir=.isoloom/cloud-docker/azure init && terraform -chdir=.isoloom/cloud-docker/azure apply \
#           -var allowed_cidr=<your IP>/32 -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)" -var ssh_private_key_file=~/.ssh/id_ed25519
# Stop:   terraform -chdir=.isoloom/cloud-docker/azure destroy (same variables)

terraform {
  required_version = ">= 1.6.0"
  backend "local" {}
  required_providers {
    azurerm = { source = "hashicorp/azurerm", version = "~> 5.8.0" }
    local   = { source = "hashicorp/local", version = "~> 2.9.1" }
  }
}

variable "subscription_id" {
  type        = string
  default     = null
  description = "Default: ARM_SUBSCRIPTION_ID from the environment"
}

variable "region" {
  type    = string
  default = "swedencentral"
}

variable "size" {
  type    = string
  default = "Standard_D2als_v6"
}

variable "allowed_cidr" {
  type        = string
  description = "Who may reach the machines (SSH and the published ports), e.g. your IP/32"
}

variable "ssh_public_key" {
  type        = string
  description = "The SSH public key the machines let in: Terraform signs in with its private half (`ssh_private_key_file`) to set them up or wait for their set-up, and so can you, to run the checks"
}

variable "ssh_private_key_file" {
  type        = string
  description = "The private key of ssh_public_key (a path, ~ allowed): Terraform signs in to the machines with it to bring the project in and wait for their set-up"
}

variable "expires_at" {
  type        = string
  default     = ""
  description = "When the environment should end, in Unix seconds (empty: no end): a tag on every resource, so a reaper finds what to destroy, and the time the machines shut themselves down"
}

provider "azurerm" {
  features {}
  subscription_id = var.subscription_id
}

resource "terraform_data" "id" {
  input = substr(replace(uuid(), "-", ""), 0, 8)
  lifecycle {
    ignore_changes = [input]
  }
}

locals {
  name = "isoloom-configured-app-${terraform_data.id.output}"
  root = abspath("${path.module}/../../..")
  tags = {
    isoloom-environment = "configured-app"
    managed-by          = "isoloom"
    isoloom-instance    = local.name
    isoloom-expires-at  = var.expires_at
  }
}

resource "azurerm_resource_group" "env" {
  name     = local.name
  location = var.region
  tags     = local.tags
}

resource "azurerm_virtual_network" "env" {
  name                = local.name
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  address_space       = ["10.42.0.0/16"]
}

resource "azurerm_subnet" "env" {
  name                 = local.name
  resource_group_name  = azurerm_resource_group.env.name
  virtual_network_name = azurerm_virtual_network.env.name
  address_prefixes     = ["10.42.1.0/24"]
}

resource "azurerm_public_ip" "env" {
  name                = local.name
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  allocation_method   = "Static"
  sku                 = "Standard"
}

resource "azurerm_network_security_group" "env" {
  name                = local.name
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  security_rule {
    name                       = "ssh-and-published"
    priority                   = 100
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_ranges    = ["22", "8086"]
    source_address_prefix      = var.allowed_cidr
    destination_address_prefix = "*"
  }
}

resource "azurerm_network_interface" "env" {
  name                = local.name
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  ip_configuration {
    name                          = "env"
    subnet_id                     = azurerm_subnet.env.id
    private_ip_address_allocation = "Dynamic"
    public_ip_address_id          = azurerm_public_ip.env.id
  }
}

resource "azurerm_network_interface_security_group_association" "env" {
  network_interface_id      = azurerm_network_interface.env.id
  network_security_group_id = azurerm_network_security_group.env.id
}

resource "azurerm_linux_virtual_machine" "env" {
  name                  = local.name
  resource_group_name   = azurerm_resource_group.env.name
  location              = var.region
  tags                  = local.tags
  size                  = var.size
  custom_data           = base64encode("#!/bin/sh\n# Isoloom: this machine sets itself up. Its progress is in /var/lib/isoloom/ready (isoloom-ready/1), its output in /var/log/isoloom-setup.log. The project comes over SSH from Terraform.\nmkdir -p /var/lib/isoloom\nrm -f /var/lib/isoloom/setup.sh.new\n(umask 077 && cat > /var/lib/isoloom/setup.sh.new) <<'ISOLOOM_SETUP'\n#!/bin/sh\numask 022\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\nstate=$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\npart=$(cat /var/lib/isoloom/part 2>/dev/null || echo 1)\ncase \"$state\" in ready|\"failed: \"*) exit 0 ;; esac\nif [ \"$part\" = 1 ]; then\necho 'running: waiting for the project (Terraform brings it in over SSH)' > /var/lib/isoloom/ready; { i=0; until [ -f /var/lib/isoloom/project-delivered ]; do [ \"$i\" -gt 0 ] || echo 'waiting for the project, which Terraform brings in over SSH during its apply'; i=$((i+5)); if [ \"$i\" -gt 2400 ]; then echo 'the project never came: Terraform brings it in over SSH during its apply (its terraform_data.isoloom_ready_<machine>), with ssh_private_key_file' >&2; exit 1; fi; sleep 5; done; } || { echo 'failed: waiting for the project (Terraform brings it in over SSH)' > /var/lib/isoloom/ready; exit 1; }\necho 'running: Docker' > /var/lib/isoloom/ready; { sh -c 'set -e\ncloud-init status --wait >/dev/null 2>&1 || true\ncommand -v docker >/dev/null || if command -v apt-get >/dev/null; then (\n  set -e\n  export DEBIAN_FRONTEND=noninteractive\n  apt-get update -qq\n  apt-get install -y -qq ca-certificates curl\n  install -m 0755 -d /etc/apt/keyrings\n  k=$(mktemp)\n  # shellcheck disable=SC1091,SC2154 # /etc/os-release is on the guest, not here.\n  _id=$(. /etc/os-release && printf %s \"$ID\")\n  # shellcheck disable=SC1091,SC2154\n  _cn=$(. /etc/os-release && printf %s \"$VERSION_CODENAME\")\n  curl -fsSL \"https://download.docker.com/linux/$_id/gpg\" -o \"$k\"\n  echo \"1500c1f56fa9e26b9b8f42452a553675796ade0807cdce11975eb98170b3a570  $k\" | sha256sum -c -\n  install -m 0644 \"$k\" /etc/apt/keyrings/docker.asc\n  rm -f \"$k\"\n  echo \"deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/$_id $_cn stable\" > /etc/apt/sources.list.d/docker.list\n  apt-get update -qq\n  v=$(apt-cache madison docker-ce | awk '\\''$3 ~ /(^|:)29[.]9[.]0/ { print $3; exit }'\\'')\n  [ -n \"$v\" ] || { echo \"docker-ce 29.9.0 is not in Docker'\\''s apt repository\" >&2; exit 1; }\n  apt-get install -y -qq --allow-downgrades \"docker-ce=$v\" \"docker-ce-cli=$v\" containerd.io docker-buildx-plugin \"docker-compose-plugin=5.6.0-*\"\n  # A container pinned to x86 (its spec'\\''s hardware.arch, or an image published for x86 only): on\n  # another CPU (an Apple Silicon Mac'\\''s VM, an Arm cloud VM) the engine runs it through QEMU'\\''s\n  # user-mode emulation, which Debian registers with binfmt for every container (Docker Desktop\n  # does the same on its own).\n  [ \"$(dpkg --print-architecture)\" = amd64 ] || apt-get install -y -qq qemu-user-static binfmt-support\n)\nelse\n  curl -fsSL https://get.docker.com | VERSION=29.9.0 sh\nfi\ncat > /etc/systemd/system/isoloom-published.service <<'\\''UNIT'\\''\n[Unit]\nDescription=Isoloom: published ports reach containers of networks without a default route\nAfter=docker.service\nWants=docker.service\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=/bin/sh -c '\\''iptables -t nat -C POSTROUTING -m conntrack --ctstate DNAT -o br-+ -j MASQUERADE 2>/dev/null || iptables -t nat -I POSTROUTING -m conntrack --ctstate DNAT -o br-+ -j MASQUERADE'\\''\n\n[Install]\nWantedBy=multi-user.target\nUNIT\nsystemctl daemon-reload\nsystemctl enable --now isoloom-published.service\n'; } || { echo 'failed: Docker' > /var/lib/isoloom/ready; exit 1; }\necho 'running: the containers (1)' > /var/lib/isoloom/ready; { sh -c 'cd /opt/isoloom && env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name configured-app --file .isoloom/docker/compose.yml up --detach --build --pull missing --remove-orphans --wait --wait-timeout 600'; } || { echo 'failed: the containers (1)' > /var/lib/isoloom/ready; exit 1; }\nfi\necho ready > /var/lib/isoloom/ready\nrm -f /var/lib/isoloom/part\nexit 0\nISOLOOM_SETUP\nmv -f /var/lib/isoloom/setup.sh.new /var/lib/isoloom/setup.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-setup.service <<'ISOLOOM_UNIT'\n[Unit]\nDescription=Isoloom: the machine's set-up\nWants=network-online.target\nAfter=network-online.target cloud-final.service google-startup-scripts.service\n\n[Service]\nType=oneshot\nExecStart=/bin/sh /var/lib/isoloom/setup.sh\nStandardOutput=append:/var/log/isoloom-setup.log\nStandardError=append:/var/log/isoloom-setup.log\nTimeoutStartSec=0\n\n[Install]\nWantedBy=multi-user.target\nISOLOOM_UNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-setup.service >/dev/null 2>&1\nsystemctl start --no-block isoloom-setup.service\nelse\nnohup sh /var/lib/isoloom/setup.sh >> /var/log/isoloom-setup.log 2>&1 &\nfi\n")
  admin_username        = "isoloom"
  network_interface_ids = [azurerm_network_interface.env.id]
  admin_ssh_key {
    username   = "isoloom"
    public_key = var.ssh_public_key
  }
  os_disk {
    caching              = "ReadWrite"
    storage_account_type = "StandardSSD_LRS"
    disk_size_gb         = 40
  }
  source_image_reference {
    publisher = "Debian"
    offer     = "debian-12"
    sku       = "12-gen2"
    version   = "latest"
  }
  depends_on = [azurerm_network_interface_security_group_association.env]
  lifecycle {
    ignore_changes = [custom_data]
  }
}

resource "terraform_data" "isoloom_ready_docker_host" {
  triggers_replace = [azurerm_linux_virtual_machine.env.id]
  connection {
    type        = "ssh"
    host        = azurerm_public_ip.env.ip_address
    user        = "isoloom"
    private_key = file(pathexpand(var.ssh_private_key_file))
    timeout     = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-ready_docker_host.tgz\" --exclude=\"${basename(local.root)}/.isoloom*\" --exclude=\".git\" --exclude=\".terraform\" --exclude=\"*.tfstate\" --exclude=\"*.tfstate.*\" --exclude=\".terraform.tfstate.lock.info\" --exclude=\"crash.log\" --exclude=\"crash.*.log\" --exclude=\".vagrant\" -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-ready_docker_host.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-outputs-docker_host.tgz\" -C \"${abspath(local.root)}\" .isoloom/docker .isoloom/configure"
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-outputs-docker_host.tgz"
    destination = "/tmp/isoloom-outputs.tgz"
  }
  provisioner "remote-exec" {
    inline = [
      "sudo sh -c 'rm -rf /opt/isoloom && mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz && tar -xzf /tmp/isoloom-outputs.tgz -C /opt/isoloom && rm -f /tmp/isoloom-outputs.tgz && mkdir -p /var/lib/isoloom && touch /var/lib/isoloom/project-delivered'"
    ]
  }
  provisioner "remote-exec" {
    inline = [
      "sh -c 't=0\nif command -v cloud-init >/dev/null 2>&1; then sudo cloud-init status --wait >/dev/null 2>&1 || true; fi\nwhile :; do\ns=$(sudo head -n1 /var/lib/isoloom/ready 2>/dev/null)\ncase \"$s\" in\nready) echo \"docker-host: set up\"; exit 0 ;;\n\"failed: \"*) echo \"docker-host: its set-up stopped ($s); the end of /var/log/isoloom-setup.log:\"; sudo tail -n 40 /var/log/isoloom-setup.log 2>/dev/null; exit 1 ;;\nesac\nif [ \"$t\" -ge 2400 ]; then echo \"docker-host: not set up after 2400 s ($${s:-no ready file}); the end of /var/log/isoloom-setup.log:\"; sudo tail -n 40 /var/log/isoloom-setup.log 2>/dev/null; exit 1; fi\nsleep 5; t=$((t + 5))\ndone'"
    ]
  }
}

output "ip" {
  value = azurerm_public_ip.env.ip_address
}

output "ssh_user" {
  value = "isoloom"
}

# The project's files the machines don't get: what .isoloomignore at the project's root lists
# (gitignore-style: one pattern per line, `#` comments, `!` brings a path back, a trailing `/`
# matches folders only, a `/` at the start or in the middle anchors the pattern at the root; `*`,
# `?`, `[abc]`, `**`; the last pattern matching a path, or a folder it is in, decides), then
# Isoloom's outputs, version control and the tools' state. Read as regular expressions, as the
# Vagrantfiles do.
locals {
  project_ignore_lines = [for l in split("\n", "${replace(try(file("${local.root}/.isoloomignore"), ""), "\r", "")}\n/.isoloom*\n.git/\n.terraform/\n*.tfstate\n*.tfstate.*\n.terraform.tfstate.lock.info\ncrash.log\ncrash.*.log\n.vagrant/\n") : trimspace(l)]
  project_ignore_pats  = [for l in local.project_ignore_lines : { keep = startswith(l, "!"), pat = trimprefix(l, "!") } if l != "" && !startswith(l, "#")]
  project_ignore_globs = [for r in local.project_ignore_pats : merge(r, { glob = trimsuffix(trimsuffix(trimsuffix(r.pat, "/"), "/**"), "/") })]
  project_ignore = [for r in local.project_ignore_globs : {
    keep = r.keep
    re = format(r.glob == r.pat ? "^%s(/|$)" : "^%s/", replace(replace(replace(replace(replace(replace(replace(replace(
      length(split("/", r.glob)) > 1 ? trimprefix(r.glob, "/") : "**/${r.glob}",
    "/[.+^$(){}|\\\\]/", "\\$0"), "[!", "[^"), "**/", "\u0001"), "**", "\u0002"), "*", "[^/]*"), "?", "[^/]"), "\u0001", "(.*/)?"), "\u0002", ".*"))
  } if r.glob != ""]
  # Each file: whether it goes (the last matching pattern decides; none: it goes).
  project_keep    = { for f in fileset(local.root, "**") : f => reverse(concat([true], [for r in local.project_ignore : r.keep if length(regexall(r.re, f)) > 0]))[0] }
  project_ignored = [for f, keep in local.project_keep : f if !keep]
}

# What `tar` leaves out of the project's archive: .isoloomignore's files, from the archive's top
# folder, their wildcard characters escaped.
resource "local_file" "isoloom_project" {
  filename = "${path.module}/.isoloom-project-ignored.txt"
  content  = join("", [for f in local.project_ignored : "${replace("${basename(local.root)}/${f}", "/[\\\\*?\\[]/", "\\$0")}\n"])
}

## .isoloom/cloud-docker/digitalocean/main.tf
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Auth:   export DIGITALOCEAN_TOKEN=<token>
# Start:  terraform -chdir=.isoloom/cloud-docker/digitalocean init && terraform -chdir=.isoloom/cloud-docker/digitalocean apply \
#           -var allowed_cidr=<your IP>/32 -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)" -var ssh_private_key_file=~/.ssh/id_ed25519
# Stop:   terraform -chdir=.isoloom/cloud-docker/digitalocean destroy (same variables)

terraform {
  required_version = ">= 1.6.0"
  backend "local" {}
  required_providers {
    digitalocean = { source = "digitalocean/digitalocean", version = "~> 2.103.0" }
    local        = { source = "hashicorp/local", version = "~> 2.9.1" }
  }
}

variable "region" {
  type    = string
  default = "fra1"
}

variable "size" {
  type    = string
  default = "s-2vcpu-2gb"
}

variable "allowed_cidr" {
  type        = string
  description = "Who may reach the machines (SSH and the published ports), e.g. your IP/32"
}

variable "ssh_public_key" {
  type        = string
  description = "The SSH public key the machines let in: Terraform signs in with its private half (`ssh_private_key_file`) to set them up or wait for their set-up, and so can you, to run the checks"
}

variable "ssh_private_key_file" {
  type        = string
  description = "The private key of ssh_public_key (a path, ~ allowed): Terraform signs in to the machines with it to bring the project in and wait for their set-up"
}

variable "expires_at" {
  type        = string
  default     = ""
  description = "When the environment should end, in Unix seconds (empty: no end): a tag on every resource, so a reaper finds what to destroy, and the time the machines shut themselves down"
}

provider "digitalocean" {}

resource "terraform_data" "id" {
  input = substr(replace(uuid(), "-", ""), 0, 8)
  lifecycle {
    ignore_changes = [input]
  }
}

locals {
  name = "isoloom-configured-app-${terraform_data.id.output}"
  root = abspath("${path.module}/../../..")
}

resource "digitalocean_vpc" "env" {
  name     = local.name
  region   = var.region
  ip_range = "10.42.1.0/24"
}

resource "digitalocean_ssh_key" "env" {
  name       = local.name
  public_key = var.ssh_public_key
}

resource "digitalocean_droplet" "env" {
  name      = local.name
  region    = var.region
  size      = var.size
  image     = "debian-12-x64"
  vpc_uuid  = digitalocean_vpc.env.id
  ssh_keys  = [digitalocean_ssh_key.env.id]
  user_data = "#!/bin/sh\n# Isoloom: this machine sets itself up. Its progress is in /var/lib/isoloom/ready (isoloom-ready/1), its output in /var/log/isoloom-setup.log. The project comes over SSH from Terraform.\nmkdir -p /var/lib/isoloom\nrm -f /var/lib/isoloom/setup.sh.new\n(umask 077 && cat > /var/lib/isoloom/setup.sh.new) <<'ISOLOOM_SETUP'\n#!/bin/sh\numask 022\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\nstate=$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\npart=$(cat /var/lib/isoloom/part 2>/dev/null || echo 1)\ncase \"$state\" in ready|\"failed: \"*) exit 0 ;; esac\nif [ \"$part\" = 1 ]; then\necho 'running: waiting for the project (Terraform brings it in over SSH)' > /var/lib/isoloom/ready; { i=0; until [ -f /var/lib/isoloom/project-delivered ]; do [ \"$i\" -gt 0 ] || echo 'waiting for the project, which Terraform brings in over SSH during its apply'; i=$((i+5)); if [ \"$i\" -gt 2400 ]; then echo 'the project never came: Terraform brings it in over SSH during its apply (its terraform_data.isoloom_ready_<machine>), with ssh_private_key_file' >&2; exit 1; fi; sleep 5; done; } || { echo 'failed: waiting for the project (Terraform brings it in over SSH)' > /var/lib/isoloom/ready; exit 1; }\necho 'running: Docker' > /var/lib/isoloom/ready; { sh -c 'set -e\ncloud-init status --wait >/dev/null 2>&1 || true\ncommand -v docker >/dev/null || if command -v apt-get >/dev/null; then (\n  set -e\n  export DEBIAN_FRONTEND=noninteractive\n  apt-get update -qq\n  apt-get install -y -qq ca-certificates curl\n  install -m 0755 -d /etc/apt/keyrings\n  k=$(mktemp)\n  # shellcheck disable=SC1091,SC2154 # /etc/os-release is on the guest, not here.\n  _id=$(. /etc/os-release && printf %s \"$ID\")\n  # shellcheck disable=SC1091,SC2154\n  _cn=$(. /etc/os-release && printf %s \"$VERSION_CODENAME\")\n  curl -fsSL \"https://download.docker.com/linux/$_id/gpg\" -o \"$k\"\n  echo \"1500c1f56fa9e26b9b8f42452a553675796ade0807cdce11975eb98170b3a570  $k\" | sha256sum -c -\n  install -m 0644 \"$k\" /etc/apt/keyrings/docker.asc\n  rm -f \"$k\"\n  echo \"deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/$_id $_cn stable\" > /etc/apt/sources.list.d/docker.list\n  apt-get update -qq\n  v=$(apt-cache madison docker-ce | awk '\\''$3 ~ /(^|:)29[.]9[.]0/ { print $3; exit }'\\'')\n  [ -n \"$v\" ] || { echo \"docker-ce 29.9.0 is not in Docker'\\''s apt repository\" >&2; exit 1; }\n  apt-get install -y -qq --allow-downgrades \"docker-ce=$v\" \"docker-ce-cli=$v\" containerd.io docker-buildx-plugin \"docker-compose-plugin=5.6.0-*\"\n  # A container pinned to x86 (its spec'\\''s hardware.arch, or an image published for x86 only): on\n  # another CPU (an Apple Silicon Mac'\\''s VM, an Arm cloud VM) the engine runs it through QEMU'\\''s\n  # user-mode emulation, which Debian registers with binfmt for every container (Docker Desktop\n  # does the same on its own).\n  [ \"$(dpkg --print-architecture)\" = amd64 ] || apt-get install -y -qq qemu-user-static binfmt-support\n)\nelse\n  curl -fsSL https://get.docker.com | VERSION=29.9.0 sh\nfi\ncat > /etc/systemd/system/isoloom-published.service <<'\\''UNIT'\\''\n[Unit]\nDescription=Isoloom: published ports reach containers of networks without a default route\nAfter=docker.service\nWants=docker.service\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=/bin/sh -c '\\''iptables -t nat -C POSTROUTING -m conntrack --ctstate DNAT -o br-+ -j MASQUERADE 2>/dev/null || iptables -t nat -I POSTROUTING -m conntrack --ctstate DNAT -o br-+ -j MASQUERADE'\\''\n\n[Install]\nWantedBy=multi-user.target\nUNIT\nsystemctl daemon-reload\nsystemctl enable --now isoloom-published.service\n'; } || { echo 'failed: Docker' > /var/lib/isoloom/ready; exit 1; }\necho 'running: the containers (1)' > /var/lib/isoloom/ready; { sh -c 'cd /opt/isoloom && env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name configured-app --file .isoloom/docker/compose.yml up --detach --build --pull missing --remove-orphans --wait --wait-timeout 600'; } || { echo 'failed: the containers (1)' > /var/lib/isoloom/ready; exit 1; }\nfi\necho ready > /var/lib/isoloom/ready\nrm -f /var/lib/isoloom/part\nexit 0\nISOLOOM_SETUP\nmv -f /var/lib/isoloom/setup.sh.new /var/lib/isoloom/setup.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-setup.service <<'ISOLOOM_UNIT'\n[Unit]\nDescription=Isoloom: the machine's set-up\nWants=network-online.target\nAfter=network-online.target cloud-final.service google-startup-scripts.service\n\n[Service]\nType=oneshot\nExecStart=/bin/sh /var/lib/isoloom/setup.sh\nStandardOutput=append:/var/log/isoloom-setup.log\nStandardError=append:/var/log/isoloom-setup.log\nTimeoutStartSec=0\n\n[Install]\nWantedBy=multi-user.target\nISOLOOM_UNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-setup.service >/dev/null 2>&1\nsystemctl start --no-block isoloom-setup.service\nelse\nnohup sh /var/lib/isoloom/setup.sh >> /var/log/isoloom-setup.log 2>&1 &\nfi\n"
  tags      = concat(["isoloom", "configured-app", local.name], var.expires_at == "" ? [] : ["isoloom-expires-${var.expires_at}"])
  lifecycle {
    ignore_changes = [user_data]
  }
}

resource "digitalocean_firewall" "env" {
  name        = local.name
  droplet_ids = [digitalocean_droplet.env.id]
  inbound_rule {
    protocol         = "tcp"
    port_range       = "22"
    source_addresses = [var.allowed_cidr]
  }
  inbound_rule {
    protocol         = "tcp"
    port_range       = "8086"
    source_addresses = [var.allowed_cidr]
  }
  outbound_rule {
    protocol              = "tcp"
    port_range            = "1-65535"
    destination_addresses = ["0.0.0.0/0", "::/0"]
  }
  outbound_rule {
    protocol              = "udp"
    port_range            = "1-65535"
    destination_addresses = ["0.0.0.0/0", "::/0"]
  }
  outbound_rule {
    protocol              = "icmp"
    destination_addresses = ["0.0.0.0/0", "::/0"]
  }
}

resource "terraform_data" "isoloom_ready_docker_host" {
  triggers_replace = [digitalocean_droplet.env.id]
  connection {
    type        = "ssh"
    host        = digitalocean_droplet.env.ipv4_address
    user        = "root"
    private_key = file(pathexpand(var.ssh_private_key_file))
    timeout     = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-ready_docker_host.tgz\" --exclude=\"${basename(local.root)}/.isoloom*\" --exclude=\".git\" --exclude=\".terraform\" --exclude=\"*.tfstate\" --exclude=\"*.tfstate.*\" --exclude=\".terraform.tfstate.lock.info\" --exclude=\"crash.log\" --exclude=\"crash.*.log\" --exclude=\".vagrant\" -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-ready_docker_host.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-outputs-docker_host.tgz\" -C \"${abspath(local.root)}\" .isoloom/docker .isoloom/configure"
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-outputs-docker_host.tgz"
    destination = "/tmp/isoloom-outputs.tgz"
  }
  provisioner "remote-exec" {
    inline = [
      "sh -c 'rm -rf /opt/isoloom && mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz && tar -xzf /tmp/isoloom-outputs.tgz -C /opt/isoloom && rm -f /tmp/isoloom-outputs.tgz && mkdir -p /var/lib/isoloom && touch /var/lib/isoloom/project-delivered'"
    ]
  }
  provisioner "remote-exec" {
    inline = [
      "sh -c 't=0\nif command -v cloud-init >/dev/null 2>&1; then cloud-init status --wait >/dev/null 2>&1 || true; fi\nwhile :; do\ns=$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\ncase \"$s\" in\nready) echo \"docker-host: set up\"; exit 0 ;;\n\"failed: \"*) echo \"docker-host: its set-up stopped ($s); the end of /var/log/isoloom-setup.log:\"; tail -n 40 /var/log/isoloom-setup.log 2>/dev/null; exit 1 ;;\nesac\nif [ \"$t\" -ge 2400 ]; then echo \"docker-host: not set up after 2400 s ($${s:-no ready file}); the end of /var/log/isoloom-setup.log:\"; tail -n 40 /var/log/isoloom-setup.log 2>/dev/null; exit 1; fi\nsleep 5; t=$((t + 5))\ndone'"
    ]
  }
}

output "ip" {
  value = digitalocean_droplet.env.ipv4_address
}

output "ssh_user" {
  value = "root"
}

# The project's files the machines don't get: what .isoloomignore at the project's root lists
# (gitignore-style: one pattern per line, `#` comments, `!` brings a path back, a trailing `/`
# matches folders only, a `/` at the start or in the middle anchors the pattern at the root; `*`,
# `?`, `[abc]`, `**`; the last pattern matching a path, or a folder it is in, decides), then
# Isoloom's outputs, version control and the tools' state. Read as regular expressions, as the
# Vagrantfiles do.
locals {
  project_ignore_lines = [for l in split("\n", "${replace(try(file("${local.root}/.isoloomignore"), ""), "\r", "")}\n/.isoloom*\n.git/\n.terraform/\n*.tfstate\n*.tfstate.*\n.terraform.tfstate.lock.info\ncrash.log\ncrash.*.log\n.vagrant/\n") : trimspace(l)]
  project_ignore_pats  = [for l in local.project_ignore_lines : { keep = startswith(l, "!"), pat = trimprefix(l, "!") } if l != "" && !startswith(l, "#")]
  project_ignore_globs = [for r in local.project_ignore_pats : merge(r, { glob = trimsuffix(trimsuffix(trimsuffix(r.pat, "/"), "/**"), "/") })]
  project_ignore = [for r in local.project_ignore_globs : {
    keep = r.keep
    re = format(r.glob == r.pat ? "^%s(/|$)" : "^%s/", replace(replace(replace(replace(replace(replace(replace(replace(
      length(split("/", r.glob)) > 1 ? trimprefix(r.glob, "/") : "**/${r.glob}",
    "/[.+^$(){}|\\\\]/", "\\$0"), "[!", "[^"), "**/", "\u0001"), "**", "\u0002"), "*", "[^/]*"), "?", "[^/]"), "\u0001", "(.*/)?"), "\u0002", ".*"))
  } if r.glob != ""]
  # Each file: whether it goes (the last matching pattern decides; none: it goes).
  project_keep    = { for f in fileset(local.root, "**") : f => reverse(concat([true], [for r in local.project_ignore : r.keep if length(regexall(r.re, f)) > 0]))[0] }
  project_ignored = [for f, keep in local.project_keep : f if !keep]
}

# What `tar` leaves out of the project's archive: .isoloomignore's files, from the archive's top
# folder, their wildcard characters escaped.
resource "local_file" "isoloom_project" {
  filename = "${path.module}/.isoloom-project-ignored.txt"
  content  = join("", [for f in local.project_ignored : "${replace("${basename(local.root)}/${f}", "/[\\\\*?\\[]/", "\\$0")}\n"])
}

## .isoloom/cloud-docker/gcp/main.tf
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  terraform -chdir=.isoloom/cloud-docker/gcp init && terraform -chdir=.isoloom/cloud-docker/gcp apply \
#           -var billing_account=<id> -var allowed_cidr=<your IP>/32 -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)" -var ssh_private_key_file=~/.ssh/id_ed25519
# Stop:   terraform -chdir=.isoloom/cloud-docker/gcp destroy (same variables)

terraform {
  required_version = ">= 1.6.0"
  backend "local" {}
  required_providers {
    google = { source = "hashicorp/google", version = "~> 8.5.0" }
    local  = { source = "hashicorp/local", version = "~> 2.9.1" }
  }
}

variable "project" {
  type        = string
  default     = ""
  description = "An existing project; or leave empty and give billing_account for a project of its own"
}

variable "billing_account" {
  type        = string
  default     = ""
  description = "With no project: create one for this environment, billed here, deleted with it"
}

variable "org_id" {
  type    = string
  default = ""
}

variable "region" {
  type    = string
  default = "europe-west9"
}

variable "machine_type" {
  type    = string
  default = "e2-medium"
}

variable "allowed_cidr" {
  type        = string
  description = "Who may reach the machines (SSH and the published ports), e.g. your IP/32"
}

variable "ssh_public_key" {
  type        = string
  description = "The SSH public key the machines let in: Terraform signs in with its private half (`ssh_private_key_file`) to set them up or wait for their set-up, and so can you, to run the checks"
}

variable "ssh_private_key_file" {
  type        = string
  description = "The private key of ssh_public_key (a path, ~ allowed): Terraform signs in to the machines with it to bring the project in and wait for their set-up"
}

variable "expires_at" {
  type        = string
  default     = ""
  description = "When the environment should end, in Unix seconds (empty: no end): a tag on every resource, so a reaper finds what to destroy, and the time the machines shut themselves down"
}

provider "google" {
  region = var.region
}

# A project of its own when none is given: everything goes when the environment is destroyed.
resource "google_project" "env" {
  count               = var.project == "" ? 1 : 0
  name                = "isoloom-configured-app"
  project_id          = "isoloom-${terraform_data.id.output}"
  billing_account     = var.billing_account
  org_id              = var.org_id == "" ? null : var.org_id
  deletion_policy     = "DELETE"
  auto_create_network = false
  labels = {
    isoloom-environment = "configured-app"
    managed-by          = "isoloom"
    isoloom-instance    = local.name
    isoloom-expires-at  = var.expires_at
  }
}

resource "google_project_service" "compute" {
  count              = var.project == "" ? 1 : 0
  project            = google_project.env[0].project_id
  service            = "compute.googleapis.com"
  disable_on_destroy = false
}

resource "terraform_data" "id" {
  input = substr(replace(uuid(), "-", ""), 0, 8)
  lifecycle {
    ignore_changes = [input]
  }
}

locals {
  name    = "isoloom-configured-app-${terraform_data.id.output}"
  root    = abspath("${path.module}/../../..")
  project = var.project != "" ? var.project : google_project_service.compute[0].project
  zone    = "${var.region}-a"
}

resource "google_compute_network" "env" {
  project                 = local.project
  name                    = local.name
  auto_create_subnetworks = false
}

resource "google_compute_subnetwork" "env" {
  project       = local.project
  name          = local.name
  network       = google_compute_network.env.id
  ip_cidr_range = "10.42.1.0/24"
  region        = var.region
}

resource "google_compute_firewall" "env" {
  project       = local.project
  name          = local.name
  network       = google_compute_network.env.id
  source_ranges = [var.allowed_cidr]
  allow {
    protocol = "tcp"
    ports    = ["22", "8086"]
  }
}

resource "google_compute_instance" "env" {
  project      = local.project
  name         = local.name
  machine_type = var.machine_type
  zone         = local.zone
  labels = {
    isoloom-environment = "configured-app"
    managed-by          = "isoloom"
    isoloom-instance    = local.name
    isoloom-expires-at  = var.expires_at
  }
  boot_disk {
    initialize_params {
      image = "debian-cloud/debian-12"
      size  = 40
      labels = {
        isoloom-environment = "configured-app"
        managed-by          = "isoloom"
        isoloom-instance    = local.name
        isoloom-expires-at  = var.expires_at
      }
    }
  }
  network_interface {
    subnetwork = google_compute_subnetwork.env.id
    access_config {}
  }
  metadata = {
    ssh-keys       = "admin:${var.ssh_public_key}"
    startup-script = "#!/bin/sh\n# Isoloom: this machine sets itself up. Its progress is in /var/lib/isoloom/ready (isoloom-ready/1), its output in /var/log/isoloom-setup.log. The project comes over SSH from Terraform.\nmkdir -p /var/lib/isoloom\nrm -f /var/lib/isoloom/setup.sh.new\n(umask 077 && cat > /var/lib/isoloom/setup.sh.new) <<'ISOLOOM_SETUP'\n#!/bin/sh\numask 022\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\nstate=$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\npart=$(cat /var/lib/isoloom/part 2>/dev/null || echo 1)\ncase \"$state\" in ready|\"failed: \"*) exit 0 ;; esac\nif [ \"$part\" = 1 ]; then\necho 'running: waiting for the project (Terraform brings it in over SSH)' > /var/lib/isoloom/ready; { i=0; until [ -f /var/lib/isoloom/project-delivered ]; do [ \"$i\" -gt 0 ] || echo 'waiting for the project, which Terraform brings in over SSH during its apply'; i=$((i+5)); if [ \"$i\" -gt 2400 ]; then echo 'the project never came: Terraform brings it in over SSH during its apply (its terraform_data.isoloom_ready_<machine>), with ssh_private_key_file' >&2; exit 1; fi; sleep 5; done; } || { echo 'failed: waiting for the project (Terraform brings it in over SSH)' > /var/lib/isoloom/ready; exit 1; }\necho 'running: Docker' > /var/lib/isoloom/ready; { sh -c 'set -e\ncloud-init status --wait >/dev/null 2>&1 || true\ncommand -v docker >/dev/null || if command -v apt-get >/dev/null; then (\n  set -e\n  export DEBIAN_FRONTEND=noninteractive\n  apt-get update -qq\n  apt-get install -y -qq ca-certificates curl\n  install -m 0755 -d /etc/apt/keyrings\n  k=$(mktemp)\n  # shellcheck disable=SC1091,SC2154 # /etc/os-release is on the guest, not here.\n  _id=$(. /etc/os-release && printf %s \"$ID\")\n  # shellcheck disable=SC1091,SC2154\n  _cn=$(. /etc/os-release && printf %s \"$VERSION_CODENAME\")\n  curl -fsSL \"https://download.docker.com/linux/$_id/gpg\" -o \"$k\"\n  echo \"1500c1f56fa9e26b9b8f42452a553675796ade0807cdce11975eb98170b3a570  $k\" | sha256sum -c -\n  install -m 0644 \"$k\" /etc/apt/keyrings/docker.asc\n  rm -f \"$k\"\n  echo \"deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/$_id $_cn stable\" > /etc/apt/sources.list.d/docker.list\n  apt-get update -qq\n  v=$(apt-cache madison docker-ce | awk '\\''$3 ~ /(^|:)29[.]9[.]0/ { print $3; exit }'\\'')\n  [ -n \"$v\" ] || { echo \"docker-ce 29.9.0 is not in Docker'\\''s apt repository\" >&2; exit 1; }\n  apt-get install -y -qq --allow-downgrades \"docker-ce=$v\" \"docker-ce-cli=$v\" containerd.io docker-buildx-plugin \"docker-compose-plugin=5.6.0-*\"\n  # A container pinned to x86 (its spec'\\''s hardware.arch, or an image published for x86 only): on\n  # another CPU (an Apple Silicon Mac'\\''s VM, an Arm cloud VM) the engine runs it through QEMU'\\''s\n  # user-mode emulation, which Debian registers with binfmt for every container (Docker Desktop\n  # does the same on its own).\n  [ \"$(dpkg --print-architecture)\" = amd64 ] || apt-get install -y -qq qemu-user-static binfmt-support\n)\nelse\n  curl -fsSL https://get.docker.com | VERSION=29.9.0 sh\nfi\ncat > /etc/systemd/system/isoloom-published.service <<'\\''UNIT'\\''\n[Unit]\nDescription=Isoloom: published ports reach containers of networks without a default route\nAfter=docker.service\nWants=docker.service\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=/bin/sh -c '\\''iptables -t nat -C POSTROUTING -m conntrack --ctstate DNAT -o br-+ -j MASQUERADE 2>/dev/null || iptables -t nat -I POSTROUTING -m conntrack --ctstate DNAT -o br-+ -j MASQUERADE'\\''\n\n[Install]\nWantedBy=multi-user.target\nUNIT\nsystemctl daemon-reload\nsystemctl enable --now isoloom-published.service\n'; } || { echo 'failed: Docker' > /var/lib/isoloom/ready; exit 1; }\necho 'running: the containers (1)' > /var/lib/isoloom/ready; { sh -c 'cd /opt/isoloom && env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name configured-app --file .isoloom/docker/compose.yml up --detach --build --pull missing --remove-orphans --wait --wait-timeout 600'; } || { echo 'failed: the containers (1)' > /var/lib/isoloom/ready; exit 1; }\nfi\necho ready > /var/lib/isoloom/ready\nrm -f /var/lib/isoloom/part\nexit 0\nISOLOOM_SETUP\nmv -f /var/lib/isoloom/setup.sh.new /var/lib/isoloom/setup.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-setup.service <<'ISOLOOM_UNIT'\n[Unit]\nDescription=Isoloom: the machine's set-up\nWants=network-online.target\nAfter=network-online.target cloud-final.service google-startup-scripts.service\n\n[Service]\nType=oneshot\nExecStart=/bin/sh /var/lib/isoloom/setup.sh\nStandardOutput=append:/var/log/isoloom-setup.log\nStandardError=append:/var/log/isoloom-setup.log\nTimeoutStartSec=0\n\n[Install]\nWantedBy=multi-user.target\nISOLOOM_UNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-setup.service >/dev/null 2>&1\nsystemctl start --no-block isoloom-setup.service\nelse\nnohup sh /var/lib/isoloom/setup.sh >> /var/log/isoloom-setup.log 2>&1 &\nfi\n"
  }
}

resource "terraform_data" "isoloom_ready_docker_host" {
  triggers_replace = [google_compute_instance.env.id]
  connection {
    type        = "ssh"
    host        = google_compute_instance.env.network_interface[0].access_config[0].nat_ip
    user        = "admin"
    private_key = file(pathexpand(var.ssh_private_key_file))
    timeout     = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-ready_docker_host.tgz\" --exclude=\"${basename(local.root)}/.isoloom*\" --exclude=\".git\" --exclude=\".terraform\" --exclude=\"*.tfstate\" --exclude=\"*.tfstate.*\" --exclude=\".terraform.tfstate.lock.info\" --exclude=\"crash.log\" --exclude=\"crash.*.log\" --exclude=\".vagrant\" -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-ready_docker_host.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-outputs-docker_host.tgz\" -C \"${abspath(local.root)}\" .isoloom/docker .isoloom/configure"
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-outputs-docker_host.tgz"
    destination = "/tmp/isoloom-outputs.tgz"
  }
  provisioner "remote-exec" {
    inline = [
      "sudo sh -c 'rm -rf /opt/isoloom && mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz && tar -xzf /tmp/isoloom-outputs.tgz -C /opt/isoloom && rm -f /tmp/isoloom-outputs.tgz && mkdir -p /var/lib/isoloom && touch /var/lib/isoloom/project-delivered'"
    ]
  }
  provisioner "remote-exec" {
    inline = [
      "sh -c 't=0\nif command -v cloud-init >/dev/null 2>&1; then sudo cloud-init status --wait >/dev/null 2>&1 || true; fi\nwhile :; do\ns=$(sudo head -n1 /var/lib/isoloom/ready 2>/dev/null)\ncase \"$s\" in\nready) echo \"docker-host: set up\"; exit 0 ;;\n\"failed: \"*) echo \"docker-host: its set-up stopped ($s); the end of /var/log/isoloom-setup.log:\"; sudo tail -n 40 /var/log/isoloom-setup.log 2>/dev/null; exit 1 ;;\nesac\nif [ \"$t\" -ge 2400 ]; then echo \"docker-host: not set up after 2400 s ($${s:-no ready file}); the end of /var/log/isoloom-setup.log:\"; sudo tail -n 40 /var/log/isoloom-setup.log 2>/dev/null; exit 1; fi\nsleep 5; t=$((t + 5))\ndone'"
    ]
  }
}

output "ip" {
  value = google_compute_instance.env.network_interface[0].access_config[0].nat_ip
}

output "ssh_user" {
  value = "admin"
}

# The project's files the machines don't get: what .isoloomignore at the project's root lists
# (gitignore-style: one pattern per line, `#` comments, `!` brings a path back, a trailing `/`
# matches folders only, a `/` at the start or in the middle anchors the pattern at the root; `*`,
# `?`, `[abc]`, `**`; the last pattern matching a path, or a folder it is in, decides), then
# Isoloom's outputs, version control and the tools' state. Read as regular expressions, as the
# Vagrantfiles do.
locals {
  project_ignore_lines = [for l in split("\n", "${replace(try(file("${local.root}/.isoloomignore"), ""), "\r", "")}\n/.isoloom*\n.git/\n.terraform/\n*.tfstate\n*.tfstate.*\n.terraform.tfstate.lock.info\ncrash.log\ncrash.*.log\n.vagrant/\n") : trimspace(l)]
  project_ignore_pats  = [for l in local.project_ignore_lines : { keep = startswith(l, "!"), pat = trimprefix(l, "!") } if l != "" && !startswith(l, "#")]
  project_ignore_globs = [for r in local.project_ignore_pats : merge(r, { glob = trimsuffix(trimsuffix(trimsuffix(r.pat, "/"), "/**"), "/") })]
  project_ignore = [for r in local.project_ignore_globs : {
    keep = r.keep
    re = format(r.glob == r.pat ? "^%s(/|$)" : "^%s/", replace(replace(replace(replace(replace(replace(replace(replace(
      length(split("/", r.glob)) > 1 ? trimprefix(r.glob, "/") : "**/${r.glob}",
    "/[.+^$(){}|\\\\]/", "\\$0"), "[!", "[^"), "**/", "\u0001"), "**", "\u0002"), "*", "[^/]*"), "?", "[^/]"), "\u0001", "(.*/)?"), "\u0002", ".*"))
  } if r.glob != ""]
  # Each file: whether it goes (the last matching pattern decides; none: it goes).
  project_keep    = { for f in fileset(local.root, "**") : f => reverse(concat([true], [for r in local.project_ignore : r.keep if length(regexall(r.re, f)) > 0]))[0] }
  project_ignored = [for f, keep in local.project_keep : f if !keep]
}

# What `tar` leaves out of the project's archive: .isoloomignore's files, from the archive's top
# folder, their wildcard characters escaped.
resource "local_file" "isoloom_project" {
  filename = "${path.module}/.isoloom-project-ignored.txt"
  content  = join("", [for f in local.project_ignored : "${replace("${basename(local.root)}/${f}", "/[\\\\*?\\[]/", "\\$0")}\n"])
}

## .isoloom/cloud-docker/linode/main.tf
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Auth:   export LINODE_TOKEN=<token> (the provider reads it).
# Start:  terraform -chdir=.isoloom/cloud-docker/linode init && terraform -chdir=.isoloom/cloud-docker/linode apply \
#           -var allowed_cidr=<your IP>/32 -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)" -var ssh_private_key_file=~/.ssh/id_ed25519
# Stop:   terraform -chdir=.isoloom/cloud-docker/linode destroy (same variables)

terraform {
  required_version = ">= 1.6.0"
  backend "local" {}
  required_providers {
    linode = { source = "linode/linode", version = "~> 4.7.0" }
    local  = { source = "hashicorp/local", version = "~> 2.9.1" }
  }
}

variable "region" {
  type    = string
  default = "fr-par"
}

variable "type" {
  type    = string
  default = "g6-standard-2"
}

variable "allowed_cidr" {
  type        = string
  description = "Who may reach the machines (SSH and the published ports), e.g. your IP/32"
}

variable "ssh_public_key" {
  type        = string
  description = "The SSH public key the machines let in: Terraform signs in with its private half (`ssh_private_key_file`) to set them up or wait for their set-up, and so can you, to run the checks"
}

variable "ssh_private_key_file" {
  type        = string
  description = "The private key of ssh_public_key (a path, ~ allowed): Terraform signs in to the machines with it to bring the project in and wait for their set-up"
}

variable "expires_at" {
  type        = string
  default     = ""
  description = "When the environment should end, in Unix seconds (empty: no end): a tag on every resource, so a reaper finds what to destroy, and the time the machines shut themselves down"
}

provider "linode" {}

resource "terraform_data" "id" {
  input = substr(replace(uuid(), "-", ""), 0, 8)
  lifecycle {
    ignore_changes = [input]
  }
}

locals {
  name = "isoloom-configured-app-${terraform_data.id.output}"
  root = abspath("${path.module}/../../..")
}

resource "linode_instance" "env" {
  label           = local.name
  region          = var.region
  type            = var.type
  image           = "linode/debian12"
  authorized_keys = [trimspace(var.ssh_public_key)]
  metadata {
    user_data = base64encode("#!/bin/sh\n# Isoloom: this machine sets itself up. Its progress is in /var/lib/isoloom/ready (isoloom-ready/1), its output in /var/log/isoloom-setup.log. The project comes over SSH from Terraform.\nmkdir -p /var/lib/isoloom\nrm -f /var/lib/isoloom/setup.sh.new\n(umask 077 && cat > /var/lib/isoloom/setup.sh.new) <<'ISOLOOM_SETUP'\n#!/bin/sh\numask 022\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\nstate=$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\npart=$(cat /var/lib/isoloom/part 2>/dev/null || echo 1)\ncase \"$state\" in ready|\"failed: \"*) exit 0 ;; esac\nif [ \"$part\" = 1 ]; then\necho 'running: waiting for the project (Terraform brings it in over SSH)' > /var/lib/isoloom/ready; { i=0; until [ -f /var/lib/isoloom/project-delivered ]; do [ \"$i\" -gt 0 ] || echo 'waiting for the project, which Terraform brings in over SSH during its apply'; i=$((i+5)); if [ \"$i\" -gt 2400 ]; then echo 'the project never came: Terraform brings it in over SSH during its apply (its terraform_data.isoloom_ready_<machine>), with ssh_private_key_file' >&2; exit 1; fi; sleep 5; done; } || { echo 'failed: waiting for the project (Terraform brings it in over SSH)' > /var/lib/isoloom/ready; exit 1; }\necho 'running: Docker' > /var/lib/isoloom/ready; { sh -c 'set -e\ncloud-init status --wait >/dev/null 2>&1 || true\ncommand -v docker >/dev/null || if command -v apt-get >/dev/null; then (\n  set -e\n  export DEBIAN_FRONTEND=noninteractive\n  apt-get update -qq\n  apt-get install -y -qq ca-certificates curl\n  install -m 0755 -d /etc/apt/keyrings\n  k=$(mktemp)\n  # shellcheck disable=SC1091,SC2154 # /etc/os-release is on the guest, not here.\n  _id=$(. /etc/os-release && printf %s \"$ID\")\n  # shellcheck disable=SC1091,SC2154\n  _cn=$(. /etc/os-release && printf %s \"$VERSION_CODENAME\")\n  curl -fsSL \"https://download.docker.com/linux/$_id/gpg\" -o \"$k\"\n  echo \"1500c1f56fa9e26b9b8f42452a553675796ade0807cdce11975eb98170b3a570  $k\" | sha256sum -c -\n  install -m 0644 \"$k\" /etc/apt/keyrings/docker.asc\n  rm -f \"$k\"\n  echo \"deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/$_id $_cn stable\" > /etc/apt/sources.list.d/docker.list\n  apt-get update -qq\n  v=$(apt-cache madison docker-ce | awk '\\''$3 ~ /(^|:)29[.]9[.]0/ { print $3; exit }'\\'')\n  [ -n \"$v\" ] || { echo \"docker-ce 29.9.0 is not in Docker'\\''s apt repository\" >&2; exit 1; }\n  apt-get install -y -qq --allow-downgrades \"docker-ce=$v\" \"docker-ce-cli=$v\" containerd.io docker-buildx-plugin \"docker-compose-plugin=5.6.0-*\"\n  # A container pinned to x86 (its spec'\\''s hardware.arch, or an image published for x86 only): on\n  # another CPU (an Apple Silicon Mac'\\''s VM, an Arm cloud VM) the engine runs it through QEMU'\\''s\n  # user-mode emulation, which Debian registers with binfmt for every container (Docker Desktop\n  # does the same on its own).\n  [ \"$(dpkg --print-architecture)\" = amd64 ] || apt-get install -y -qq qemu-user-static binfmt-support\n)\nelse\n  curl -fsSL https://get.docker.com | VERSION=29.9.0 sh\nfi\ncat > /etc/systemd/system/isoloom-published.service <<'\\''UNIT'\\''\n[Unit]\nDescription=Isoloom: published ports reach containers of networks without a default route\nAfter=docker.service\nWants=docker.service\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=/bin/sh -c '\\''iptables -t nat -C POSTROUTING -m conntrack --ctstate DNAT -o br-+ -j MASQUERADE 2>/dev/null || iptables -t nat -I POSTROUTING -m conntrack --ctstate DNAT -o br-+ -j MASQUERADE'\\''\n\n[Install]\nWantedBy=multi-user.target\nUNIT\nsystemctl daemon-reload\nsystemctl enable --now isoloom-published.service\n'; } || { echo 'failed: Docker' > /var/lib/isoloom/ready; exit 1; }\necho 'running: the containers (1)' > /var/lib/isoloom/ready; { sh -c 'cd /opt/isoloom && env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name configured-app --file .isoloom/docker/compose.yml up --detach --build --pull missing --remove-orphans --wait --wait-timeout 600'; } || { echo 'failed: the containers (1)' > /var/lib/isoloom/ready; exit 1; }\nfi\necho ready > /var/lib/isoloom/ready\nrm -f /var/lib/isoloom/part\nexit 0\nISOLOOM_SETUP\nmv -f /var/lib/isoloom/setup.sh.new /var/lib/isoloom/setup.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-setup.service <<'ISOLOOM_UNIT'\n[Unit]\nDescription=Isoloom: the machine's set-up\nWants=network-online.target\nAfter=network-online.target cloud-final.service google-startup-scripts.service\n\n[Service]\nType=oneshot\nExecStart=/bin/sh /var/lib/isoloom/setup.sh\nStandardOutput=append:/var/log/isoloom-setup.log\nStandardError=append:/var/log/isoloom-setup.log\nTimeoutStartSec=0\n\n[Install]\nWantedBy=multi-user.target\nISOLOOM_UNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-setup.service >/dev/null 2>&1\nsystemctl start --no-block isoloom-setup.service\nelse\nnohup sh /var/lib/isoloom/setup.sh >> /var/log/isoloom-setup.log 2>&1 &\nfi\n")
  }
  tags = concat(["isoloom", "configured-app", local.name], var.expires_at == "" ? [] : ["isoloom-expires-${var.expires_at}"])
  lifecycle {
    ignore_changes = [metadata[0].user_data]
  }
}

resource "linode_firewall" "env" {
  label           = local.name
  tags            = concat(["isoloom", "configured-app", local.name], var.expires_at == "" ? [] : ["isoloom-expires-${var.expires_at}"])
  inbound_policy  = "DROP"
  outbound_policy = "ACCEPT"
  inbound {
    label    = "ssh-and-published"
    action   = "ACCEPT"
    protocol = "TCP"
    ports    = "22,8086"
    ipv4     = [var.allowed_cidr]
  }
  linodes = [linode_instance.env.id]
}

resource "terraform_data" "isoloom_ready_docker_host" {
  triggers_replace = [linode_instance.env.id]
  connection {
    type        = "ssh"
    host        = one(linode_instance.env.ipv4)
    user        = "root"
    private_key = file(pathexpand(var.ssh_private_key_file))
    timeout     = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-ready_docker_host.tgz\" --exclude=\"${basename(local.root)}/.isoloom*\" --exclude=\".git\" --exclude=\".terraform\" --exclude=\"*.tfstate\" --exclude=\"*.tfstate.*\" --exclude=\".terraform.tfstate.lock.info\" --exclude=\"crash.log\" --exclude=\"crash.*.log\" --exclude=\".vagrant\" -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-ready_docker_host.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-outputs-docker_host.tgz\" -C \"${abspath(local.root)}\" .isoloom/docker .isoloom/configure"
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-outputs-docker_host.tgz"
    destination = "/tmp/isoloom-outputs.tgz"
  }
  provisioner "remote-exec" {
    inline = [
      "sh -c 'rm -rf /opt/isoloom && mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz && tar -xzf /tmp/isoloom-outputs.tgz -C /opt/isoloom && rm -f /tmp/isoloom-outputs.tgz && mkdir -p /var/lib/isoloom && touch /var/lib/isoloom/project-delivered'"
    ]
  }
  provisioner "remote-exec" {
    inline = [
      "sh -c 't=0\nif command -v cloud-init >/dev/null 2>&1; then cloud-init status --wait >/dev/null 2>&1 || true; fi\nwhile :; do\ns=$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\ncase \"$s\" in\nready) echo \"docker-host: set up\"; exit 0 ;;\n\"failed: \"*) echo \"docker-host: its set-up stopped ($s); the end of /var/log/isoloom-setup.log:\"; tail -n 40 /var/log/isoloom-setup.log 2>/dev/null; exit 1 ;;\nesac\nif [ \"$t\" -ge 2400 ]; then echo \"docker-host: not set up after 2400 s ($${s:-no ready file}); the end of /var/log/isoloom-setup.log:\"; tail -n 40 /var/log/isoloom-setup.log 2>/dev/null; exit 1; fi\nsleep 5; t=$((t + 5))\ndone'"
    ]
  }
}

output "ip" {
  value = one(linode_instance.env.ipv4)
}

output "ssh_user" {
  value = "root"
}

# The project's files the machines don't get: what .isoloomignore at the project's root lists
# (gitignore-style: one pattern per line, `#` comments, `!` brings a path back, a trailing `/`
# matches folders only, a `/` at the start or in the middle anchors the pattern at the root; `*`,
# `?`, `[abc]`, `**`; the last pattern matching a path, or a folder it is in, decides), then
# Isoloom's outputs, version control and the tools' state. Read as regular expressions, as the
# Vagrantfiles do.
locals {
  project_ignore_lines = [for l in split("\n", "${replace(try(file("${local.root}/.isoloomignore"), ""), "\r", "")}\n/.isoloom*\n.git/\n.terraform/\n*.tfstate\n*.tfstate.*\n.terraform.tfstate.lock.info\ncrash.log\ncrash.*.log\n.vagrant/\n") : trimspace(l)]
  project_ignore_pats  = [for l in local.project_ignore_lines : { keep = startswith(l, "!"), pat = trimprefix(l, "!") } if l != "" && !startswith(l, "#")]
  project_ignore_globs = [for r in local.project_ignore_pats : merge(r, { glob = trimsuffix(trimsuffix(trimsuffix(r.pat, "/"), "/**"), "/") })]
  project_ignore = [for r in local.project_ignore_globs : {
    keep = r.keep
    re = format(r.glob == r.pat ? "^%s(/|$)" : "^%s/", replace(replace(replace(replace(replace(replace(replace(replace(
      length(split("/", r.glob)) > 1 ? trimprefix(r.glob, "/") : "**/${r.glob}",
    "/[.+^$(){}|\\\\]/", "\\$0"), "[!", "[^"), "**/", "\u0001"), "**", "\u0002"), "*", "[^/]*"), "?", "[^/]"), "\u0001", "(.*/)?"), "\u0002", ".*"))
  } if r.glob != ""]
  # Each file: whether it goes (the last matching pattern decides; none: it goes).
  project_keep    = { for f in fileset(local.root, "**") : f => reverse(concat([true], [for r in local.project_ignore : r.keep if length(regexall(r.re, f)) > 0]))[0] }
  project_ignored = [for f, keep in local.project_keep : f if !keep]
}

# What `tar` leaves out of the project's archive: .isoloomignore's files, from the archive's top
# folder, their wildcard characters escaped.
resource "local_file" "isoloom_project" {
  filename = "${path.module}/.isoloom-project-ignored.txt"
  content  = join("", [for f in local.project_ignored : "${replace("${basename(local.root)}/${f}", "/[\\\\*?\\[]/", "\\$0")}\n"])
}

## .isoloom/cloud-docker/oci/main.tf
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  terraform -chdir=.isoloom/cloud-docker/oci init && terraform -chdir=.isoloom/cloud-docker/oci apply \
#           -var compartment_id=<compartment ocid> -var allowed_cidr=<your IP>/32 \
#           -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)" -var ssh_private_key_file=~/.ssh/id_ed25519
# Stop:   terraform -chdir=.isoloom/cloud-docker/oci destroy (same variables)
# Auth:   the oci provider reads ~/.oci/config; region defaults, override with -var region=<id>.

terraform {
  required_version = ">= 1.6.0"
  backend "local" {}
  required_providers {
    oci   = { source = "oracle/oci", version = "~> 9.8.0" }
    local = { source = "hashicorp/local", version = "~> 2.9.1" }
  }
}

variable "compartment_id" {
  type        = string
  description = "The compartment the environment goes in"
}

variable "region" {
  type        = string
  default     = "eu-paris-1"
  description = "The OCI region to launch in"
}

variable "config_file_profile" {
  type        = string
  default     = "DEFAULT"
  description = "The profile of the OCI CLI's configuration (~/.oci/config) the provider signs in with"
}

variable "allowed_cidr" {
  type        = string
  description = "Who may reach the machines (SSH and the published ports), e.g. your IP/32"
}

variable "ssh_public_key" {
  type        = string
  description = "The SSH public key the machines let in: Terraform signs in with its private half (`ssh_private_key_file`) to set them up or wait for their set-up, and so can you, to run the checks"
}

variable "ssh_private_key_file" {
  type        = string
  description = "The private key of ssh_public_key (a path, ~ allowed): Terraform signs in to the machines with it to bring the project in and wait for their set-up"
}

variable "expires_at" {
  type        = string
  default     = ""
  description = "When the environment should end, in Unix seconds (empty: no end): a tag on every resource, so a reaper finds what to destroy, and the time the machines shut themselves down"
}

provider "oci" {
  region              = var.region
  config_file_profile = var.config_file_profile
}

resource "terraform_data" "id" {
  input = substr(replace(uuid(), "-", ""), 0, 8)
  lifecycle {
    ignore_changes = [input]
  }
}

locals {
  name = "isoloom-configured-app-${terraform_data.id.output}"
  root = abspath("${path.module}/../../..")
  tags = merge({ isoloom-environment = "configured-app", managed-by = "isoloom", isoloom-instance = local.name }, var.expires_at == "" ? {} : { isoloom-expires-at = var.expires_at })
}

data "oci_identity_availability_domains" "ads" {
  compartment_id = var.compartment_id
}

data "oci_core_images" "ubuntu_2404" {
  compartment_id           = var.compartment_id
  operating_system         = "Canonical Ubuntu"
  operating_system_version = "24.04"
  shape                    = "VM.Standard.E4.Flex"
  sort_by                  = "TIMECREATED"
  sort_order               = "DESC"
}

resource "oci_core_vcn" "env" {
  compartment_id = var.compartment_id
  freeform_tags  = local.tags
  display_name   = local.name
  cidr_blocks    = ["10.42.0.0/16"]
}

resource "oci_core_internet_gateway" "env" {
  compartment_id = var.compartment_id
  freeform_tags  = local.tags
  vcn_id         = oci_core_vcn.env.id
  display_name   = local.name
}

resource "oci_core_route_table" "env" {
  compartment_id = var.compartment_id
  freeform_tags  = local.tags
  vcn_id         = oci_core_vcn.env.id
  route_rules {
    destination       = "0.0.0.0/0"
    network_entity_id = oci_core_internet_gateway.env.id
  }
}

resource "oci_core_security_list" "env" {
  compartment_id = var.compartment_id
  freeform_tags  = local.tags
  vcn_id         = oci_core_vcn.env.id
  display_name   = local.name
  egress_security_rules {
    destination = "0.0.0.0/0"
    protocol    = "all"
  }
  ingress_security_rules {
    source   = var.allowed_cidr
    protocol = "6"
    tcp_options {
      min = 22
      max = 22
    }
  }
  ingress_security_rules {
    source   = var.allowed_cidr
    protocol = "6"
    tcp_options {
      min = 8086
      max = 8086
    }
  }
}

resource "oci_core_subnet" "env" {
  compartment_id    = var.compartment_id
  freeform_tags     = local.tags
  vcn_id            = oci_core_vcn.env.id
  cidr_block        = "10.42.1.0/24"
  display_name      = local.name
  route_table_id    = oci_core_route_table.env.id
  security_list_ids = [oci_core_security_list.env.id]
}

resource "oci_core_instance" "env" {
  compartment_id      = var.compartment_id
  freeform_tags       = local.tags
  availability_domain = data.oci_identity_availability_domains.ads.availability_domains[0].name
  display_name        = local.name
  shape               = "VM.Standard.E4.Flex"
  shape_config {
    ocpus         = 1
    memory_in_gbs = 4
  }
  source_details {
    source_type             = "image"
    source_id               = data.oci_core_images.ubuntu_2404.images[0].id
    boot_volume_size_in_gbs = 50
  }
  create_vnic_details {
    subnet_id        = oci_core_subnet.env.id
    assign_public_ip = true
  }
  metadata = {
    ssh_authorized_keys = var.ssh_public_key
    user_data           = base64encode("#!/bin/sh\n# Isoloom: this machine sets itself up. Its progress is in /var/lib/isoloom/ready (isoloom-ready/1), its output in /var/log/isoloom-setup.log. The project comes over SSH from Terraform.\nmkdir -p /var/lib/isoloom\nrm -f /var/lib/isoloom/setup.sh.new\n(umask 077 && cat > /var/lib/isoloom/setup.sh.new) <<'ISOLOOM_SETUP'\n#!/bin/sh\numask 022\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\nstate=$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\npart=$(cat /var/lib/isoloom/part 2>/dev/null || echo 1)\ncase \"$state\" in ready|\"failed: \"*) exit 0 ;; esac\nif [ \"$part\" = 1 ]; then\necho 'running: waiting for the project (Terraform brings it in over SSH)' > /var/lib/isoloom/ready; { i=0; until [ -f /var/lib/isoloom/project-delivered ]; do [ \"$i\" -gt 0 ] || echo 'waiting for the project, which Terraform brings in over SSH during its apply'; i=$((i+5)); if [ \"$i\" -gt 2400 ]; then echo 'the project never came: Terraform brings it in over SSH during its apply (its terraform_data.isoloom_ready_<machine>), with ssh_private_key_file' >&2; exit 1; fi; sleep 5; done; } || { echo 'failed: waiting for the project (Terraform brings it in over SSH)' > /var/lib/isoloom/ready; exit 1; }\necho 'running: Docker' > /var/lib/isoloom/ready; { sh -c 'set -e\ncloud-init status --wait >/dev/null 2>&1 || true\ncommand -v docker >/dev/null || if command -v apt-get >/dev/null; then (\n  set -e\n  export DEBIAN_FRONTEND=noninteractive\n  apt-get update -qq\n  apt-get install -y -qq ca-certificates curl\n  install -m 0755 -d /etc/apt/keyrings\n  k=$(mktemp)\n  # shellcheck disable=SC1091,SC2154 # /etc/os-release is on the guest, not here.\n  _id=$(. /etc/os-release && printf %s \"$ID\")\n  # shellcheck disable=SC1091,SC2154\n  _cn=$(. /etc/os-release && printf %s \"$VERSION_CODENAME\")\n  curl -fsSL \"https://download.docker.com/linux/$_id/gpg\" -o \"$k\"\n  echo \"1500c1f56fa9e26b9b8f42452a553675796ade0807cdce11975eb98170b3a570  $k\" | sha256sum -c -\n  install -m 0644 \"$k\" /etc/apt/keyrings/docker.asc\n  rm -f \"$k\"\n  echo \"deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/$_id $_cn stable\" > /etc/apt/sources.list.d/docker.list\n  apt-get update -qq\n  v=$(apt-cache madison docker-ce | awk '\\''$3 ~ /(^|:)29[.]9[.]0/ { print $3; exit }'\\'')\n  [ -n \"$v\" ] || { echo \"docker-ce 29.9.0 is not in Docker'\\''s apt repository\" >&2; exit 1; }\n  apt-get install -y -qq --allow-downgrades \"docker-ce=$v\" \"docker-ce-cli=$v\" containerd.io docker-buildx-plugin \"docker-compose-plugin=5.6.0-*\"\n  # A container pinned to x86 (its spec'\\''s hardware.arch, or an image published for x86 only): on\n  # another CPU (an Apple Silicon Mac'\\''s VM, an Arm cloud VM) the engine runs it through QEMU'\\''s\n  # user-mode emulation, which Debian registers with binfmt for every container (Docker Desktop\n  # does the same on its own).\n  [ \"$(dpkg --print-architecture)\" = amd64 ] || apt-get install -y -qq qemu-user-static binfmt-support\n)\nelse\n  curl -fsSL https://get.docker.com | VERSION=29.9.0 sh\nfi\ncat > /etc/systemd/system/isoloom-published.service <<'\\''UNIT'\\''\n[Unit]\nDescription=Isoloom: published ports reach containers of networks without a default route\nAfter=docker.service\nWants=docker.service\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=/bin/sh -c '\\''iptables -t nat -C POSTROUTING -m conntrack --ctstate DNAT -o br-+ -j MASQUERADE 2>/dev/null || iptables -t nat -I POSTROUTING -m conntrack --ctstate DNAT -o br-+ -j MASQUERADE'\\''\n\n[Install]\nWantedBy=multi-user.target\nUNIT\nsystemctl daemon-reload\nsystemctl enable --now isoloom-published.service\n'; } || { echo 'failed: Docker' > /var/lib/isoloom/ready; exit 1; }\necho 'running: the containers (1)' > /var/lib/isoloom/ready; { sh -c 'cd /opt/isoloom && env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name configured-app --file .isoloom/docker/compose.yml up --detach --build --pull missing --remove-orphans --wait --wait-timeout 600'; } || { echo 'failed: the containers (1)' > /var/lib/isoloom/ready; exit 1; }\nfi\necho ready > /var/lib/isoloom/ready\nrm -f /var/lib/isoloom/part\nexit 0\nISOLOOM_SETUP\nmv -f /var/lib/isoloom/setup.sh.new /var/lib/isoloom/setup.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-setup.service <<'ISOLOOM_UNIT'\n[Unit]\nDescription=Isoloom: the machine's set-up\nWants=network-online.target\nAfter=network-online.target cloud-final.service google-startup-scripts.service\n\n[Service]\nType=oneshot\nExecStart=/bin/sh /var/lib/isoloom/setup.sh\nStandardOutput=append:/var/log/isoloom-setup.log\nStandardError=append:/var/log/isoloom-setup.log\nTimeoutStartSec=0\n\n[Install]\nWantedBy=multi-user.target\nISOLOOM_UNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-setup.service >/dev/null 2>&1\nsystemctl start --no-block isoloom-setup.service\nelse\nnohup sh /var/lib/isoloom/setup.sh >> /var/log/isoloom-setup.log 2>&1 &\nfi\n")
  }
  lifecycle {
    ignore_changes = [metadata["user_data"]]
  }
}

resource "terraform_data" "isoloom_ready_docker_host" {
  triggers_replace = [oci_core_instance.env.id]
  connection {
    type        = "ssh"
    host        = oci_core_instance.env.public_ip
    user        = "ubuntu"
    private_key = file(pathexpand(var.ssh_private_key_file))
    timeout     = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-ready_docker_host.tgz\" --exclude=\"${basename(local.root)}/.isoloom*\" --exclude=\".git\" --exclude=\".terraform\" --exclude=\"*.tfstate\" --exclude=\"*.tfstate.*\" --exclude=\".terraform.tfstate.lock.info\" --exclude=\"crash.log\" --exclude=\"crash.*.log\" --exclude=\".vagrant\" -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-ready_docker_host.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-outputs-docker_host.tgz\" -C \"${abspath(local.root)}\" .isoloom/docker .isoloom/configure"
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-outputs-docker_host.tgz"
    destination = "/tmp/isoloom-outputs.tgz"
  }
  provisioner "remote-exec" {
    inline = [
      "sudo sh -c 'rm -rf /opt/isoloom && mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz && tar -xzf /tmp/isoloom-outputs.tgz -C /opt/isoloom && rm -f /tmp/isoloom-outputs.tgz && mkdir -p /var/lib/isoloom && touch /var/lib/isoloom/project-delivered'"
    ]
  }
  provisioner "remote-exec" {
    inline = [
      "sh -c 't=0\nif command -v cloud-init >/dev/null 2>&1; then sudo cloud-init status --wait >/dev/null 2>&1 || true; fi\nwhile :; do\ns=$(sudo head -n1 /var/lib/isoloom/ready 2>/dev/null)\ncase \"$s\" in\nready) echo \"docker-host: set up\"; exit 0 ;;\n\"failed: \"*) echo \"docker-host: its set-up stopped ($s); the end of /var/log/isoloom-setup.log:\"; sudo tail -n 40 /var/log/isoloom-setup.log 2>/dev/null; exit 1 ;;\nesac\nif [ \"$t\" -ge 2400 ]; then echo \"docker-host: not set up after 2400 s ($${s:-no ready file}); the end of /var/log/isoloom-setup.log:\"; sudo tail -n 40 /var/log/isoloom-setup.log 2>/dev/null; exit 1; fi\nsleep 5; t=$((t + 5))\ndone'"
    ]
  }
}

output "ip" {
  value = oci_core_instance.env.public_ip
}

output "ssh_user" {
  value = "ubuntu"
}

# The project's files the machines don't get: what .isoloomignore at the project's root lists
# (gitignore-style: one pattern per line, `#` comments, `!` brings a path back, a trailing `/`
# matches folders only, a `/` at the start or in the middle anchors the pattern at the root; `*`,
# `?`, `[abc]`, `**`; the last pattern matching a path, or a folder it is in, decides), then
# Isoloom's outputs, version control and the tools' state. Read as regular expressions, as the
# Vagrantfiles do.
locals {
  project_ignore_lines = [for l in split("\n", "${replace(try(file("${local.root}/.isoloomignore"), ""), "\r", "")}\n/.isoloom*\n.git/\n.terraform/\n*.tfstate\n*.tfstate.*\n.terraform.tfstate.lock.info\ncrash.log\ncrash.*.log\n.vagrant/\n") : trimspace(l)]
  project_ignore_pats  = [for l in local.project_ignore_lines : { keep = startswith(l, "!"), pat = trimprefix(l, "!") } if l != "" && !startswith(l, "#")]
  project_ignore_globs = [for r in local.project_ignore_pats : merge(r, { glob = trimsuffix(trimsuffix(trimsuffix(r.pat, "/"), "/**"), "/") })]
  project_ignore = [for r in local.project_ignore_globs : {
    keep = r.keep
    re = format(r.glob == r.pat ? "^%s(/|$)" : "^%s/", replace(replace(replace(replace(replace(replace(replace(replace(
      length(split("/", r.glob)) > 1 ? trimprefix(r.glob, "/") : "**/${r.glob}",
    "/[.+^$(){}|\\\\]/", "\\$0"), "[!", "[^"), "**/", "\u0001"), "**", "\u0002"), "*", "[^/]*"), "?", "[^/]"), "\u0001", "(.*/)?"), "\u0002", ".*"))
  } if r.glob != ""]
  # Each file: whether it goes (the last matching pattern decides; none: it goes).
  project_keep    = { for f in fileset(local.root, "**") : f => reverse(concat([true], [for r in local.project_ignore : r.keep if length(regexall(r.re, f)) > 0]))[0] }
  project_ignored = [for f, keep in local.project_keep : f if !keep]
}

# What `tar` leaves out of the project's archive: .isoloomignore's files, from the archive's top
# folder, their wildcard characters escaped.
resource "local_file" "isoloom_project" {
  filename = "${path.module}/.isoloom-project-ignored.txt"
  content  = join("", [for f in local.project_ignored : "${replace("${basename(local.root)}/${f}", "/[\\\\*?\\[]/", "\\$0")}\n"])
}

