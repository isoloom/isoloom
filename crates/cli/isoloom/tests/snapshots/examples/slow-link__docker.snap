## .isoloom/docker/checks/user.sh
#!/bin/sh
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# The environment's checks, from user. `isoloom test` runs it and reads the PASS/FAIL lines.
passed=0; failed=0
pass() { passed=$((passed+1)); echo "isoloom-check: PASS $1"; }
fail() { failed=$((failed+1)); echo "isoloom-check: FAIL $1: $2"; }
# _http URL [follow] -> the status code, 000 when nothing answers (curl, else wget, else bash):
# the first answer's, or with `follow` the last one's after at most 5 redirects (bash: the first).
_http() {
  if command -v curl >/dev/null 2>&1; then
    if [ -n "$2" ]; then set -- "$1" -L --max-redirs 5; else set -- "$1"; fi
    c=$(curl -sk -o /dev/null -m 5 -w '%{http_code}' "$@" 2>/dev/null)
  elif command -v wget >/dev/null 2>&1; then
    # wget follows redirects whatever it's told (busybox's can't be told): -S prints each answer.
    if [ -n "$2" ]; then _n=6; else _n=1; fi
    c=$(wget -q -S -O /dev/null -T 5 --no-check-certificate "$1" 2>&1 | sed -n 's/^ *HTTP\/[0-9.]* \([0-9][0-9][0-9]\).*/\1/p' | head -n $_n | tail -n 1)
  else
    u=${1#*://}; hp=${u%%/*}; p=/${u#*/}; [ "$u" = "$hp" ] && p=/
    h=${hp%%:*}; port=${hp#*:}; [ "$hp" = "$h" ] && port=80
    # shellcheck disable=SC2016 # the inner bash expands $H, $P and $U, for its /dev/tcp
    c=$(H=$h P=$port U=$p timeout 5 bash -c 'exec 3<>/dev/tcp/$H/$P && printf "GET %s HTTP/1.0\r\nHost: %s\r\n\r\n" "$U" "$H" >&3 && read -r l <&3 && echo "$l"' 2>/dev/null | sed -n 's/^HTTP\/[0-9.]* \([0-9][0-9][0-9]\).*/\1/p')
  fi
  echo "${c:-000}"
}
_http_is() { [ "$(_http "$1" "$3")" = "$2" ]; }
# _req STATUS|any TEXT CURL-ARGS... -> 0 when the request gets that status (any answer for `any`)
# and its body contains TEXT (if any); $out says why not. Needs curl.
_req() {
  want=$1; text=$2; shift 2
  command -v curl >/dev/null 2>&1 || { out="curl is needed for this check"; return 1; }
  b=$(mktemp); c=$(curl -sk -m 10 -o "$b" -w '%{http_code}' "$@" 2>/dev/null); c=${c:-000}; r=0
  if [ "$want" = any ]; then [ "$c" != 000 ] || r=1; else [ "$c" = "$want" ] || r=1; fi
  if [ $r = 1 ]; then out="expected HTTP $want, got $c"
  elif [ -n "$text" ] && ! grep -qF -- "$text" "$b"; then r=1; out="HTTP $c, but the response doesn't contain the expected text"
  fi
  rm -f "$b"; return $r
}
_http_any() { [ "$(_http "$1" "$2")" != 000 ]; }
# _tcp HOST PORT -> 0 when it connects (nc, else bash).
_tcp() {
  if command -v nc >/dev/null 2>&1; then nc -z -w 5 "$1" "$2" >/dev/null 2>&1
  else
    # shellcheck disable=SC2016 # the inner bash expands $H and $P, for its /dev/tcp
    H=$1 P=$2 timeout 5 bash -c 'exec 3<>/dev/tcp/$H/$P' >/dev/null 2>&1
  fi
}
# _tcp_read HOST PORT LINE TEXT -> 0 when the bytes read within 5s of connecting (after writing
# LINE and a newline, if any) contain TEXT; $out says why not (nc, else bash). Stdin stays open
# while reading (some nc quit at its end), and nc is stopped after 5s whatever its flavor.
_tcp_read() {
  f=$(mktemp); i=0; r=1
  if command -v nc >/dev/null 2>&1; then
    { [ -z "$3" ] || printf '%s\n' "$3"; j=0; while [ ! -e "$f.end" ] && [ $j -lt 6 ]; do sleep 1; j=$((j+1)); done; } | nc "$1" "$2" >"$f" 2>/dev/null &
  else
    # shellcheck disable=SC2016 # the inner bash expands $H, $P and $L, for its /dev/tcp
    H=$1 P=$2 L=$3 timeout 6 bash -c 'exec 3<>/dev/tcp/$H/$P || exit 1; [ -z "$L" ] || printf "%s\n" "$L" >&3; cat <&3' >"$f" 2>/dev/null &
  fi
  p=$!
  while :; do
    if grep -qF -- "$4" "$f"; then r=0; break; fi
    if [ $i -ge 5 ] || ! kill -0 $p 2>/dev/null; then break; fi
    sleep 1; i=$((i+1))
  done
  [ $r = 0 ] || ! grep -qF -- "$4" "$f" || r=0
  touch "$f.end"; kill $p 2>/dev/null
  if [ $r = 1 ]; then
    if [ -s "$f" ]; then out="$1:$2 answered \"$(head -c 100 "$f" | tr -d '\000\r' | tr '\n\t' '  ')\", without the expected text"
    elif [ $i -lt 5 ]; then out="$1:$2 refused the connection or closed it without a word"
    else out="nothing read from $1:$2 within 5s"; fi
  fi
  rm -f "$f" "$f.end"; return $r
}
# _exec COMMAND TEXT -> 0 when the command succeeds and its output contains TEXT (if any).
_exec() { out=$(sh -c "$1" 2>&1) && { [ -z "$2" ] || printf '%s\n' "$out" | grep -qF -- "$2"; }; }
# _retry SECONDS COMMAND... -> keeps trying every 2s until it passes or the time is up.
_retry() { _end=$(( $(date +%s) + $1 )); shift; while ! "$@"; do [ "$(date +%s)" -lt "$_end" ] || return 1; sleep 2; done; }

echo '== checks/slow-but-there.sh'
if _retry 0 sh -c 'cd /isoloom/project && sh checks/slow-but-there.sh'; then pass 'the far site answers, slowly'; else fail 'the far site answers, slowly' "checks/slow-but-there.sh exited non-zero"; fi

if [ "${ISOLOOM_DERIVED:-1}" != 0 ]; then
if _retry 30 _http_any 'http://10.75.2.10:80/'; then pass 'web:80 from user'; else fail 'web:80 from user' "nothing answers at http://10.75.2.10:80/"; fi
fi

echo "isoloom-check: END $passed passed, $failed failed"
[ "$failed" -eq 0 ]

## .isoloom/docker/compose.yml
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  docker compose -f .isoloom/docker/compose.yml up -d --wait
# Checks: isoloom test docker (or: docker compose -f .isoloom/docker/compose.yml --profile check run --rm isoloom-check, and isoloom-check-<machine>)
# Stop:   docker compose -f .isoloom/docker/compose.yml down -v

name: slow-link
services:
  isoloom-router:
    image: alpine:3.20
    sysctls:
      net.ipv4.ip_forward: '1'
    init: true
    entrypoint:
    - /bin/sh
    - -c
    - apk add --no-cache nftables iproute2 >/dev/null && printf '%s' "$$RULES" | nft -f - && printf '%s' "$$TC" | sh && exec sleep infinity
    hostname: isoloom-router
    networks:
      branch:
        ipv4_address: 10.75.1.254
      far:
        ipv4_address: 10.75.2.254
    cap_add:
    - NET_ADMIN
    environment:
      RULES: |
        table inet isoloom {
          chain forward {
            type filter hook forward priority 0; policy drop;
            ct state established,related accept
            ip saddr 10.75.1.0/24 ip daddr 10.75.2.0/24 meta l4proto { tcp, udp } th dport { 80 } accept
            ip saddr 10.75.1.0/24 ip daddr 10.75.2.0/24 icmp type echo-request accept
          }
        }
      TC: |
        IF=$$(ip -o -4 addr show | awk '$$4 ~ /^10\.75\.2\.254\//{print $$2}' | head -n 1); [ -n "$$IF" ] && tc qdisc replace dev "$$IF" root netem delay 80ms 10ms loss 1% rate 10mbit
    healthcheck:
      test:
      - CMD-SHELL
      - nft list table inet isoloom >/dev/null 2>&1
      interval: 3s
      timeout: 3s
      retries: 60
    labels:
      isoloom.managed: 'true'
      isoloom.environment: slow-link
    restart: unless-stopped
  web:
    build:
      context: ../../build/web
      dockerfile: ../web.Dockerfile
      args:
        NGINX_TAG: 1.27-alpine
      labels:
        isoloom.managed: 'true'
        isoloom.environment: slow-link
    image: isoloom/slow-link-web
    platform: linux/amd64
    hostname: web
    networks:
      far:
        ipv4_address: 10.75.2.10
    extra_hosts:
    - user:10.75.1.10
    volumes:
    - isoloom-probe-amd64:/.isoloom-probe:ro
    healthcheck:
      test:
      - CMD
      - /.isoloom-probe/busybox
      - sh
      - -c
      - /.isoloom-probe/busybox nc -z -w 2 127.0.0.1 80
      interval: 5s
      timeout: 3s
      retries: 60
      start_period: 10s
    depends_on:
      isoloom-probe-amd64:
        condition: service_completed_successfully
    labels:
      isoloom.port.web: http:80
      isoloom.managed: 'true'
      isoloom.environment: slow-link
    restart: unless-stopped
  web-routes:
    image: nicolaka/netshoot:v0.13
    init: true
    entrypoint:
    - /bin/sh
    - -c
    - ip route replace 10.75.1.0/24 via 10.75.2.254 && (IF=$$(ip -o -4 addr show | awk '$$4 ~ /^10\.75\.2\.10\//{print $$2}' | head -n 1); [ -n "$$IF" ] && tc qdisc replace dev "$$IF" root netem delay 80ms 10ms loss 1% rate 10mbit) && while ip -o -4 addr show | grep -qv ' lo '; do sleep 2; done; exit 1
    network_mode: service:web
    cap_add:
    - NET_ADMIN
    healthcheck:
      test:
      - CMD-SHELL
      - ip route show 10.75.1.0/24 | grep -q via && tc qdisc show | grep -q netem
      interval: 2s
      timeout: 2s
      retries: 30
    depends_on:
      web:
        condition: service_started
      isoloom-router:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: slow-link
    restart: unless-stopped
  user:
    image: debian:12@sha256:2c037a04925515fdd6ea85ea14a682d0e79931f5e9f5d07b6dbfc6ba12f9e858
    platform: linux/amd64
    init: true
    entrypoint:
    - sleep
    - infinity
    hostname: user
    networks:
      branch:
        ipv4_address: 10.75.1.10
    extra_hosts:
    - web:10.75.2.10
    labels:
      isoloom.managed: 'true'
      isoloom.environment: slow-link
    restart: unless-stopped
  user-routes:
    image: alpine:3.20
    init: true
    entrypoint:
    - /bin/sh
    - -c
    - ip route replace 10.75.2.0/24 via 10.75.1.254 && while ip -o -4 addr show | grep -qv ' lo '; do sleep 2; done; exit 1
    network_mode: service:user
    cap_add:
    - NET_ADMIN
    healthcheck:
      test:
      - CMD-SHELL
      - ip route show 10.75.2.0/24 | grep -q via
      interval: 2s
      timeout: 2s
      retries: 30
    depends_on:
      user:
        condition: service_started
      isoloom-router:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: slow-link
    restart: unless-stopped
  isoloom-check:
    image: curlimages/curl:8.11.1
    profiles:
    - check
    entrypoint:
    - /bin/sh
    - /isoloom/run.sh
    network_mode: service:user
    volumes:
    - ./checks/user.sh:/isoloom/run.sh:ro
    - ../..:/isoloom/project:ro
    depends_on:
      web:
        condition: service_healthy
      web-routes:
        condition: service_healthy
      user-routes:
        condition: service_healthy
      user:
        condition: service_started
    labels:
      isoloom.managed: 'true'
      isoloom.environment: slow-link
  isoloom-tool-shell:
    image: nicolaka/netshoot
    init: true
    entrypoint:
    - sleep
    - infinity
    hostname: shell
    networks:
      branch:
        ipv4_address: 10.75.1.252
      far:
        ipv4_address: 10.75.2.252
    cap_add:
    - NET_ADMIN
    - NET_RAW
    labels:
      isoloom.managed: 'true'
      isoloom.environment: slow-link
    restart: unless-stopped
  isoloom-probe-amd64:
    image: busybox:1.37.0-musl
    platform: linux/amd64
    entrypoint:
    - /bin/cp
    - /bin/busybox
    - /probe/busybox
    network_mode: none
    volumes:
    - isoloom-probe-amd64:/probe
    labels:
      isoloom.managed: 'true'
      isoloom.environment: slow-link
    restart: no
networks:
  branch:
    ipam:
      config:
      - subnet: 10.75.1.0/24
        gateway: 10.75.1.1
    labels:
      isoloom.managed: 'true'
      isoloom.environment: slow-link
  far:
    ipam:
      config:
      - subnet: 10.75.2.0/24
        gateway: 10.75.2.1
    labels:
      isoloom.managed: 'true'
      isoloom.environment: slow-link
volumes:
  isoloom-probe-amd64:
    labels:
      isoloom.managed: 'true'
      isoloom.environment: slow-link

## .isoloom/docker/run.json
{
  "$schema": "https://www.isoloom.com/schema/run-manifest/v0.json",
  "manifest_version": 0,
  "generator": {
    "name": "isoloom",
    "version": "0.10.1"
  },
  "lab": {
    "name": "slow-link",
    "instance": null,
    "message": null
  },
  "target": "docker",
  "driver": "compose",
  "hosts": [
    "linux",
    "macos",
    "windows"
  ],
  "tools": [
    {
      "name": "docker",
      "probe": [
        "docker",
        "info",
        "--format",
        "{{.ServerVersion}}"
      ]
    },
    {
      "name": "docker-compose",
      "probe": [
        "docker",
        "compose",
        "version",
        "--short"
      ],
      "min_version": "2.17.0"
    }
  ],
  "identity": {
    "compose": {
      "project": "${run.name}",
      "files": [
        "compose.yml",
        "${run.state_dir}/ports.yml"
      ],
      "pinned_ports_file": "${run.state_dir}/ports.yml"
    }
  },
  "params": [
    {
      "name": "ISOLOOM_DERIVED",
      "description": "0: the checks derived from the spec (reachability, no internet) are skipped.",
      "default": "1",
      "values": [
        "0",
        "1"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_DERIVED",
          "steps": [
            "check-user"
          ]
        }
      ]
    }
  ],
  "secrets": [],
  "networks": [
    {
      "name": "branch",
      "cidr": "10.75.1.0/24",
      "internet": true,
      "native": "${run.name}_branch"
    },
    {
      "name": "far",
      "cidr": "10.75.2.0/24",
      "internet": true,
      "native": "${run.name}_far"
    }
  ],
  "machines": [
    {
      "name": "isoloom-router",
      "role": "infra",
      "addresses": {
        "branch": "10.75.1.254",
        "far": "10.75.2.254"
      },
      "native": {
        "service": "isoloom-router"
      }
    },
    {
      "name": "web",
      "role": "target",
      "arch": "amd64",
      "addresses": {
        "far": "10.75.2.10"
      },
      "native": {
        "service": "web"
      },
      "ports": [
        {
          "name": "web",
          "port": 80,
          "protocol": "tcp",
          "http": true
        }
      ]
    },
    {
      "name": "web-routes",
      "role": "infra",
      "of": "web",
      "addresses": {},
      "native": {
        "service": "web-routes"
      }
    },
    {
      "name": "user",
      "role": "access",
      "arch": "amd64",
      "addresses": {
        "branch": "10.75.1.10"
      },
      "native": {
        "service": "user"
      }
    },
    {
      "name": "user-routes",
      "role": "infra",
      "of": "user",
      "addresses": {},
      "native": {
        "service": "user-routes"
      }
    },
    {
      "name": "isoloom-check",
      "role": "check",
      "of": "user",
      "addresses": {},
      "native": {
        "service": "isoloom-check"
      }
    },
    {
      "name": "isoloom-tool-shell",
      "role": "tool",
      "addresses": {},
      "native": {
        "service": "isoloom-tool-shell"
      }
    },
    {
      "name": "isoloom-probe-amd64",
      "role": "infra",
      "addresses": {},
      "native": {
        "service": "isoloom-probe-amd64"
      }
    }
  ],
  "lifecycle": {
    "up": [
      {
        "id": "pin-ports",
        "note": "Picking the lab's host ports…",
        "action": "compose.pin_ports"
      },
      {
        "id": "ports-free",
        "action": "compose.check_ports_free"
      },
      {
        "id": "stale-networks",
        "action": "compose.remove_stale_networks",
        "failure": "tolerate"
      },
      {
        "id": "up",
        "note": "Starting the lab's containers…",
        "argv": [
          "docker",
          "compose",
          "--project-name",
          "${run.name}",
          "--file",
          "compose.yml",
          "--file",
          "${run.state_dir}/ports.yml",
          "up",
          "--detach",
          "--build",
          "--pull",
          "missing",
          "--wait",
          "--wait-timeout",
          "600"
        ],
        "timeout_s": 1800
      }
    ],
    "down": [
      {
        "id": "down",
        "argv": [
          "docker",
          "compose",
          "--project-name",
          "${run.name}",
          "--file",
          "compose.yml",
          "--file",
          "${run.state_dir}/ports.yml",
          "--profile",
          "check",
          "down",
          "--volumes",
          "--remove-orphans"
        ],
        "timeout_s": 300,
        "when": "always"
      },
      {
        "id": "containers",
        "action": "compose.remove_containers",
        "when": "always",
        "failure": "tolerate"
      },
      {
        "id": "networks",
        "action": "compose.remove_networks",
        "when": "always",
        "failure": "tolerate"
      }
    ],
    "park": {
      "pause": [
        {
          "id": "stop",
          "argv": [
            "docker",
            "compose",
            "--project-name",
            "${run.name}",
            "--file",
            "compose.yml",
            "--file",
            "${run.state_dir}/ports.yml",
            "stop"
          ],
          "timeout_s": 300
        }
      ],
      "shutdown": [
        {
          "id": "stop",
          "argv": [
            "docker",
            "compose",
            "--project-name",
            "${run.name}",
            "--file",
            "compose.yml",
            "--file",
            "${run.state_dir}/ports.yml",
            "stop"
          ],
          "timeout_s": 300
        }
      ]
    },
    "resume": [
      {
        "id": "start",
        "argv": [
          "docker",
          "compose",
          "--project-name",
          "${run.name}",
          "--file",
          "compose.yml",
          "--file",
          "${run.state_dir}/ports.yml",
          "start"
        ],
        "timeout_s": 600
      }
    ],
    "status": {
      "id": "ps",
      "argv": [
        "docker",
        "compose",
        "--project-name",
        "${run.name}",
        "--file",
        "compose.yml",
        "--file",
        "${run.state_dir}/ports.yml",
        "ps",
        "--all",
        "--format",
        "json"
      ],
      "timeout_s": 25
    }
  },
  "ready": [
    {
      "kind": "step_ok",
      "step": "up",
      "means": "every long-running service is healthy (`--wait`: each port's probe, the route keepers, the machines' own healthchecks)"
    }
  ],
  "outputs": [],
  "checks": {
    "protocol": "isoloom-check/1",
    "setup": [],
    "runners": [
      {
        "id": "isoloom-check",
        "from": "from user",
        "checks": [
          {
            "name": "the far site answers, slowly",
            "kind": "script",
            "wait_s": 0,
            "derived": false
          },
          {
            "name": "web:80 from user",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          }
        ],
        "step": {
          "id": "check-user",
          "argv": [
            "docker",
            "compose",
            "--project-name",
            "${run.name}",
            "--file",
            "compose.yml",
            "--file",
            "${run.state_dir}/ports.yml",
            "--profile",
            "check",
            "run",
            "--rm",
            "--no-deps",
            "--env",
            "ISOLOOM_DERIVED",
            "isoloom-check"
          ],
          "timeout_s": 120
        },
        "on_timeout": [
          {
            "id": "rm-check-user",
            "action": "compose.remove_containers",
            "with": {
              "one_off": "true",
              "service": "isoloom-check"
            },
            "failure": "tolerate"
          }
        ]
      }
    ],
    "teardown": []
  },
  "recovery": {
    "stale_markers": [
      "is already in use by container",
      "network with name",
      "has incorrect label"
    ],
    "steps": [
      {
        "id": "containers",
        "action": "compose.remove_containers",
        "when": "always",
        "failure": "tolerate"
      },
      {
        "id": "networks",
        "action": "compose.remove_networks",
        "when": "always",
        "failure": "tolerate"
      }
    ],
    "retries": 1
  }
}

