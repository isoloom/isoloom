{
  "generated_by_isoloom": "from isoloom.yml; don't edit: change the spec and run `isoloom generate` (`isoloom check` fails when this file is out of date)",
  "resolved_version": 3,
  "name": "slow-link",
  "instance": null,
  "inputs": [],
  "networks": {
    "branch": {
      "cidr": "10.75.1.0/24",
      "docker_cidr": "10.75.1.0/24",
      "internet": true,
      "gateway": null,
      "gateway_address": "10.75.1.1",
      "router": "10.75.1.254",
      "controller": "10.75.1.253"
    },
    "far": {
      "cidr": "10.75.2.0/24",
      "docker_cidr": "10.75.2.0/24",
      "internet": true,
      "gateway": null,
      "gateway_address": "10.75.2.1",
      "router": "10.75.2.254",
      "controller": "10.75.2.253"
