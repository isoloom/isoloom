# _retry SECONDS COMMAND... -> keeps trying every 2s until it passes or the time is up.
_retry() { _end=$(( $(date +%s) + $1 )); shift; while ! "$@"; do [ "$(date +%s)" -lt "$_end" ] || return 1; sleep 2; done; }

if [ "${ISOLOOM_DERIVED:-1}" != 0 ]; then
if _retry 30 _tcp '10.30.20.20' 8080; then pass 'app:8080 from gateway'; else fail 'app:8080 from gateway' "nothing listens at 10.30.20.20:8080"; fi
fi

if [ "${ISOLOOM_DERIVED:-1}" != 0 ]; then
if _retry 30 _tcp '10.30.20.30' 5432; then pass 'db:5432 from gateway'; else fail 'db:5432 from gateway' "nothing listens at 10.30.20.30:5432"; fi
fi

echo "isoloom-check: END $passed passed, $failed failed"
[ "$failed" -eq 0 ]

## .isoloom/cloud-vm/checks/user.sh
#!/bin/sh
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# The environment's checks, from user: each prints a PASS or FAIL line.
passed=0; failed=0
pass() { passed=$((passed+1)); echo "isoloom-check: PASS $1"; }
fail() { failed=$((failed+1)); echo "isoloom-check: FAIL $1: $2"; }
# _http URL [follow] -> the status code, 000 when nothing answers (curl, else wget, else bash):
# the first answer's, or with `follow` the last one's after at most 5 redirects (bash: the first).
_http() {
  if command -v curl >/dev/null 2>&1; then
    if [ -n "$2" ]; then set -- "$1" -L --max-redirs 5; else set -- "$1"; fi
    c=$(curl -sk -o /dev/null -m 5 -w '%{http_code}' "$@" 2>/dev/null)
  elif command -v wget >/dev/null 2>&1; then
    # wget follows redirects whatever it's told (busybox's can't be told): -S prints each answer.
    if [ -n "$2" ]; then _n=6; else _n=1; fi
    c=$(wget -q -S -O /dev/null -T 5 --no-check-certificate "$1" 2>&1 | sed -n 's/^ *HTTP\/[0-9.]* \([0-9][0-9][0-9]\).*/\1/p' | head -n $_n | tail -n 1)
  else
    u=${1#*://}; hp=${u%%/*}; p=/${u#*/}; [ "$u" = "$hp" ] && p=/
    h=${hp%%:*}; port=${hp#*:}; [ "$hp" = "$h" ] && port=80
    # shellcheck disable=SC2016 # the inner bash expands $H, $P and $U, for its /dev/tcp
    c=$(H=$h P=$port U=$p timeout 5 bash -c 'exec 3<>/dev/tcp/$H/$P && printf "GET %s HTTP/1.0\r\nHost: %s\r\n\r\n" "$U" "$H" >&3 && read -r l <&3 && echo "$l"' 2>/dev/null | sed -n 's/^HTTP\/[0-9.]* \([0-9][0-9][0-9]\).*/\1/p')
  fi
  echo "${c:-000}"
}
_http_is() { [ "$(_http "$1" "$3")" = "$2" ]; }
# _req STATUS|any TEXT CURL-ARGS... -> 0 when the request gets that status (any answer for `any`)
# and its body contains TEXT (if any); $out says why not. Needs curl.
_req() {
  want=$1; text=$2; shift 2
  command -v curl >/dev/null 2>&1 || { out="curl is needed for this check"; return 1; }
  b=$(mktemp); c=$(curl -sk -m 10 -o "$b" -w '%{http_code}' "$@" 2>/dev/null); c=${c:-000}; r=0
  if [ "$want" = any ]; then [ "$c" != 000 ] || r=1; else [ "$c" = "$want" ] || r=1; fi
  if [ $r = 1 ]; then out="expected HTTP $want, got $c"
  elif [ -n "$text" ] && ! grep -qF -- "$text" "$b"; then r=1; out="HTTP $c, but the response doesn't contain the expected text"
  fi
  rm -f "$b"; return $r
}
_http_any() { [ "$(_http "$1" "$2")" != 000 ]; }
# _tcp HOST PORT -> 0 when it connects (nc, else bash).
_tcp() {
  if command -v nc >/dev/null 2>&1; then nc -z -w 5 "$1" "$2" >/dev/null 2>&1
  else
    # shellcheck disable=SC2016 # the inner bash expands $H and $P, for its /dev/tcp
    H=$1 P=$2 timeout 5 bash -c 'exec 3<>/dev/tcp/$H/$P' >/dev/null 2>&1
  fi
}
# _tcp_read HOST PORT LINE TEXT -> 0 when the bytes read within 5s of connecting (after writing
# LINE and a newline, if any) contain TEXT; $out says why not (nc, else bash). Stdin stays open
# while reading (some nc quit at its end), and nc is stopped after 5s whatever its flavor.
_tcp_read() {
  f=$(mktemp); i=0; r=1
  if command -v nc >/dev/null 2>&1; then
    { [ -z "$3" ] || printf '%s\n' "$3"; j=0; while [ ! -e "$f.end" ] && [ $j -lt 6 ]; do sleep 1; j=$((j+1)); done; } | nc "$1" "$2" >"$f" 2>/dev/null &
  else
    # shellcheck disable=SC2016 # the inner bash expands $H, $P and $L, for its /dev/tcp
    H=$1 P=$2 L=$3 timeout 6 bash -c 'exec 3<>/dev/tcp/$H/$P || exit 1; [ -z "$L" ] || printf "%s\n" "$L" >&3; cat <&3' >"$f" 2>/dev/null &
  fi
  p=$!
  while :; do
    if grep -qF -- "$4" "$f"; then r=0; break; fi
    if [ $i -ge 5 ] || ! kill -0 $p 2>/dev/null; then break; fi
    sleep 1; i=$((i+1))
  done
  [ $r = 0 ] || ! grep -qF -- "$4" "$f" || r=0
  touch "$f.end"; kill $p 2>/dev/null
  if [ $r = 1 ]; then
    if [ -s "$f" ]; then out="$1:$2 answered \"$(head -c 100 "$f" | tr -d '\000\r' | tr '\n\t' '  ')\", without the expected text"
    elif [ $i -lt 5 ]; then out="$1:$2 refused the connection or closed it without a word"
    else out="nothing read from $1:$2 within 5s"; fi
  fi
  rm -f "$f" "$f.end"; return $r
}
# _exec COMMAND TEXT -> 0 when the command succeeds and its output contains TEXT (if any).
_exec() { out=$(sh -c "$1" 2>&1) && { [ -z "$2" ] || printf '%s\n' "$out" | grep -qF -- "$2"; }; }
# _retry SECONDS COMMAND... -> keeps trying every 2s until it passes or the time is up.
_retry() { _end=$(( $(date +%s) + $1 )); shift; while ! "$@"; do [ "$(date +%s)" -lt "$_end" ] || return 1; sleep 2; done; }

echo '== checks/dmz-reachable.sh'
if _retry 0 sh -c 'cd /opt/isoloom && sh '\''checks/dmz-reachable.sh'\'''; then pass 'checks/dmz-reachable.sh'; else fail 'checks/dmz-reachable.sh' "checks/dmz-reachable.sh exited non-zero"; fi

echo '== checks/internal-not-reachable-from-access.sh'
if _retry 0 sh -c 'cd /opt/isoloom && sh '\''checks/internal-not-reachable-from-access.sh'\'''; then pass 'checks/internal-not-reachable-from-access.sh'; else fail 'checks/internal-not-reachable-from-access.sh' "checks/internal-not-reachable-from-access.sh exited non-zero"; fi

if [ "${ISOLOOM_DERIVED:-1}" != 0 ]; then
if _retry 30 _tcp '10.30.10.10' 80; then pass 'gateway:80 on dmz from user'; else fail 'gateway:80 on dmz from user' "nothing listens at 10.30.10.10:80"; fi
fi

if [ "${ISOLOOM_DERIVED:-1}" != 0 ]; then
if _retry 30 _tcp '10.30.10.10' 22; then pass 'gateway:22 on dmz from user'; else fail 'gateway:22 on dmz from user' "nothing listens at 10.30.10.10:22"; fi
fi

if [ "${ISOLOOM_DERIVED:-1}" != 0 ]; then
if _tcp '10.30.20.20' 8080; then fail 'app:8080 blocked from user' "10.30.20.20:8080 answered; it should be blocked"; else pass 'app:8080 blocked from user'; fi
fi

if [ "${ISOLOOM_DERIVED:-1}" != 0 ]; then
if _tcp '10.30.20.30' 5432; then fail 'db:5432 blocked from user' "10.30.20.30:5432 answered; it should be blocked"; else pass 'db:5432 blocked from user'; fi
fi

echo "isoloom-check: END $passed passed, $failed failed"
[ "$failed" -eq 0 ]

## .isoloom/cloud-vm/gcp/main.tf
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  terraform -chdir=.isoloom/cloud-vm/gcp init && terraform -chdir=.isoloom/cloud-vm/gcp apply \
#           -var billing_account=<id> -var allowed_cidr=<your IP>/32 -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)" -var ssh_private_key_file=~/.ssh/id_ed25519
# Stop:   terraform -chdir=.isoloom/cloud-vm/gcp destroy (same variables)

terraform {
  required_version = ">= 1.6.0"
  backend "local" {}
  required_providers {
    google = { source = "hashicorp/google", version = "~> 8.5.0" }
    local  = { source = "hashicorp/local", version = "~> 2.9.1" }
  }
}

variable "project" {
  type        = string
  default     = ""
  description = "An existing project; or leave empty and give billing_account for a project of its own"
}

variable "billing_account" {
  type        = string
  default     = ""
  description = "With no project: create one for this environment, billed here, deleted with it"
}

variable "org_id" {
  type    = string
  default = ""
}

variable "region" {
  type    = string
  default = "europe-west9"
}

variable "allowed_cidr" {
  type        = string
  description = "Who may reach the machines (SSH and the published ports), e.g. your IP/32"
}

variable "ssh_public_key" {
  type        = string
  description = "The SSH public key the machines let in: Terraform signs in with its private half (`ssh_private_key_file`) to set them up or wait for their set-up, and so can you, to run the checks"
}

variable "ssh_private_key_file" {
  type        = string
  description = "The private key of ssh_public_key (a path, ~ allowed): Terraform signs in to the machines with it to bring the project in and wait for their set-up"
}

variable "expires_at" {
  type        = string
  default     = ""
  description = "When the environment should end, in Unix seconds (empty: no end): a tag on every resource, so a reaper finds what to destroy, and the time the machines shut themselves down"
}

provider "google" {
  region = var.region
}

# A project of its own when none is given: everything goes when the environment is destroyed.
resource "google_project" "env" {
  count               = var.project == "" ? 1 : 0
  name                = "isoloom-dmz-jump"
  project_id          = "isoloom-${terraform_data.id.output}"
  billing_account     = var.billing_account
  org_id              = var.org_id == "" ? null : var.org_id
  deletion_policy     = "DELETE"
  auto_create_network = false
  labels = {
    isoloom-environment = "dmz-jump"
    managed-by          = "isoloom"
    isoloom-instance    = local.name
    isoloom-expires-at  = var.expires_at
  }
}

resource "google_project_service" "compute" {
  count              = var.project == "" ? 1 : 0
  project            = google_project.env[0].project_id
  service            = "compute.googleapis.com"
  disable_on_destroy = false
}

resource "terraform_data" "id" {
  input = substr(replace(uuid(), "-", ""), 0, 8)
  lifecycle {
    ignore_changes = [input]
  }
}

locals {
  name    = "isoloom-dmz-jump-${terraform_data.id.output}"
  root    = abspath("${path.module}/../../..")
  project = var.project != "" ? var.project : google_project_service.compute[0].project
  zone    = "${var.region}-a"
}

# The environment's networks: a VPC network each, holding a subnetwork with its exact range.
resource "google_compute_network" "dmz" {
  project                 = local.project
  name                    = "${local.name}-dmz"
  auto_create_subnetworks = false
  mtu                     = 1500
}

resource "google_compute_subnetwork" "dmz" {
  project       = local.project
  name          = "${local.name}-dmz"
  network       = google_compute_network.dmz.id
  ip_cidr_range = "10.30.10.0/24"
  region        = var.region
}

resource "google_compute_network" "internal" {
  project                 = local.project
  name                    = "${local.name}-internal"
  auto_create_subnetworks = false
  mtu                     = 1500
}

resource "google_compute_subnetwork" "internal" {
  project       = local.project
  name          = "${local.name}-internal"
  network       = google_compute_network.internal.id
  ip_cidr_range = "10.30.20.0/24"
  region        = var.region
}

resource "google_compute_network" "access" {
  project                 = local.project
  name                    = "${local.name}-access"
  auto_create_subnetworks = false
  mtu                     = 1500
}

resource "google_compute_subnetwork" "access" {
  project       = local.project
  name          = "${local.name}-access"
  network       = google_compute_network.access.id
  ip_cidr_range = "10.30.99.0/24"
  region        = var.region
}

resource "google_compute_network_peering" "dmz_internal" {
  name                 = "${local.name}-dmz-internal"
  network              = google_compute_network.dmz.self_link
  peer_network         = google_compute_network.internal.self_link
  export_custom_routes = true
  import_custom_routes = true
}

resource "google_compute_network_peering" "internal_dmz" {
  name                 = "${local.name}-internal-dmz"
  network              = google_compute_network.internal.self_link
  peer_network         = google_compute_network.dmz.self_link
  export_custom_routes = true
  import_custom_routes = true
  depends_on           = [google_compute_network_peering.dmz_internal]
}

resource "google_compute_network_peering" "dmz_access" {
  name                 = "${local.name}-dmz-access"
  network              = google_compute_network.dmz.self_link
  peer_network         = google_compute_network.access.self_link
  export_custom_routes = true
  import_custom_routes = true
  depends_on           = [google_compute_network_peering.internal_dmz]
}

resource "google_compute_network_peering" "access_dmz" {
  name                 = "${local.name}-access-dmz"
  network              = google_compute_network.access.self_link
  peer_network         = google_compute_network.dmz.self_link
  export_custom_routes = true
  import_custom_routes = true
  depends_on           = [google_compute_network_peering.dmz_access]
}

resource "google_compute_network_peering" "internal_access" {
  name                 = "${local.name}-internal-access"
  network              = google_compute_network.internal.self_link
  peer_network         = google_compute_network.access.self_link
  export_custom_routes = true
  import_custom_routes = true
  depends_on           = [google_compute_network_peering.access_dmz]
}

resource "google_compute_network_peering" "access_internal" {
  name                 = "${local.name}-access-internal"
  network              = google_compute_network.access.self_link
  peer_network         = google_compute_network.internal.self_link
  export_custom_routes = true
  import_custom_routes = true
  depends_on           = [google_compute_network_peering.internal_access]
}

# Machine `gateway`: what may reach it.
resource "google_compute_firewall" "gateway_net_dmz" {
  project       = local.project
  name          = "${local.name}-gateway-net-dmz"
  network       = google_compute_network.dmz.id
  direction     = "INGRESS"
  source_ranges = ["10.30.10.0/24"]
  target_tags   = ["${local.name}-gateway"]
  allow {
    protocol = "all"
  }
}

resource "google_compute_firewall" "gateway_net_internal" {
  project       = local.project
  name          = "${local.name}-gateway-net-internal"
  network       = google_compute_network.internal.id
  direction     = "INGRESS"
  source_ranges = ["10.30.20.0/24"]
  target_tags   = ["${local.name}-gateway"]
  allow {
    protocol = "all"
  }
}

resource "google_compute_firewall" "gateway_ssh" {
  project       = local.project
  name          = "${local.name}-gateway-ssh"
  network       = google_compute_network.dmz.id
  direction     = "INGRESS"
  source_ranges = [var.allowed_cidr]
  target_tags   = ["${local.name}-gateway"]
  allow {
    protocol = "tcp"
    ports    = ["22"]
  }
}

resource "google_compute_firewall" "gateway_reach_access" {
  project       = local.project
  name          = "${local.name}-gateway-reach-access"
  network       = google_compute_network.dmz.id
  direction     = "INGRESS"
  source_ranges = ["10.30.99.0/24"]
  target_tags   = ["${local.name}-gateway"]
  allow {
    protocol = "all"
  }
}

resource "google_compute_instance" "gateway" {
  project      = local.project
  name         = "${local.name}-gateway"
  machine_type = "e2-small"
  zone         = local.zone
  tags         = ["${local.name}-gateway"]
  boot_disk {
    initialize_params {
      image = "debian-cloud/debian-12"
      labels = {
        isoloom-environment = "dmz-jump"
        managed-by          = "isoloom"
        isoloom-instance    = local.name
        isoloom-expires-at  = var.expires_at
      }
      size = 20
    }
  }
  network_interface {
    subnetwork = google_compute_subnetwork.dmz.id
    network_ip = "10.30.10.10"
    access_config {}
  }
  network_interface {
    subnetwork = google_compute_subnetwork.internal.id
    network_ip = "10.30.20.10"
  }
  metadata                = { ssh-keys = "admin:${var.ssh_public_key}" }
  metadata_startup_script = "#!/bin/sh\n# Isoloom: this machine sets itself up. Its progress is in /var/lib/isoloom/ready (isoloom-ready/1), its output in /var/log/isoloom-setup.log. The project comes over SSH from Terraform.\nmkdir -p /var/lib/isoloom\nrm -f /var/lib/isoloom/setup.sh.new\n(umask 077 && cat > /var/lib/isoloom/setup.sh.new) <<'ISOLOOM_SETUP'\n#!/bin/sh\numask 022\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\nstate=$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\npart=$(cat /var/lib/isoloom/part 2>/dev/null || echo 1)\nif [ \"$state\" = ready ] || [ \"$part\" != 1 ]; then\nIF=$(ip -o link | grep -i \"${"42:01:0a:1e:14:0a"}\" | awk -F': ' '{print $2}'); sudo ip link set \"$IF\" up && (ip -4 addr show \"$IF\" | grep -q 10.30.20.10/ || sudo ip addr add 10.30.20.10/24 dev \"$IF\")\nfi\ncase \"$state\" in ready|\"failed: \"*) exit 0 ;; esac\nif [ \"$part\" = 1 ]; then\necho 'running: its host name' > /var/lib/isoloom/ready; { hostnamectl set-hostname gateway 2>/dev/null || hostname gateway; grep -q ' gateway$' /etc/hosts || echo '127.0.1.1 gateway' >> /etc/hosts; [ ! -d /etc/cloud/cloud.cfg.d ] || echo 'preserve_hostname: true' > /etc/cloud/cloud.cfg.d/99-isoloom-hostname.cfg; } || { echo 'failed: its host name' > /var/lib/isoloom/ready; exit 1; }\necho 'running: waiting for the project (Terraform brings it in over SSH)' > /var/lib/isoloom/ready; { i=0; until [ -f /var/lib/isoloom/project-delivered ]; do [ \"$i\" -gt 0 ] || echo 'waiting for the project, which Terraform brings in over SSH during its apply'; i=$((i+5)); if [ \"$i\" -gt 2400 ]; then echo 'the project never came: Terraform brings it in over SSH during its apply (its terraform_data.isoloom_ready_<machine>), with ssh_private_key_file' >&2; exit 1; fi; sleep 5; done; } || { echo 'failed: waiting for the project (Terraform brings it in over SSH)' > /var/lib/isoloom/ready; exit 1; }\necho 'running: the machine'\\''s interfaces' > /var/lib/isoloom/ready; { IF=$(ip -o link | grep -i \"${"42:01:0a:1e:14:0a"}\" | awk -F': ' '{print $2}'); sudo ip link set \"$IF\" up && (ip -4 addr show \"$IF\" | grep -q 10.30.20.10/ || sudo ip addr add 10.30.20.10/24 dev \"$IF\"); } || { echo 'failed: the machine'\\''s interfaces' > /var/lib/isoloom/ready; exit 1; }\necho 'running: hosts file' > /var/lib/isoloom/ready; { sh -c 'printf '\\''%s\\n'\\'' '\\''10.30.10.10 gateway'\\'' '\\''10.30.20.20 app'\\'' '\\''10.30.20.30 db'\\'' '\\''10.30.99.10 user'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'; } || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }\necho 'running: provision/gateway.yml' > /var/lib/isoloom/ready; { sh -c 'set -e\npkg() { if command -v apt-get >/dev/null; then apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \"$@\"; elif command -v dnf >/dev/null; then dnf install -y -q \"$@\"; elif command -v apk >/dev/null; then apk add -q --no-cache \"$@\"; else yum install -y -q \"$@\"; fi; }\ncommand -v ansible-playbook >/dev/null || pkg ansible-core\ncd /opt/isoloom && sh -c '\\''ansible-playbook -c local -i gateway, '\\''\\'\\'''\\''provision/gateway.yml'\\''\\'\\'''\\'''\\'''; } || { echo 'failed: provision/gateway.yml' > /var/lib/isoloom/ready; exit 1; }\necho 'running: health check' > /var/lib/isoloom/ready; { sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'; } || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }\nfi\necho ready > /var/lib/isoloom/ready\nrm -f /var/lib/isoloom/part\nexit 0\nISOLOOM_SETUP\nmv -f /var/lib/isoloom/setup.sh.new /var/lib/isoloom/setup.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-setup.service <<'ISOLOOM_UNIT'\n[Unit]\nDescription=Isoloom: the machine's set-up\nWants=network-online.target\nAfter=network-online.target cloud-final.service google-startup-scripts.service\n\n[Service]\nType=oneshot\nExecStart=/bin/sh /var/lib/isoloom/setup.sh\nStandardOutput=append:/var/log/isoloom-setup.log\nStandardError=append:/var/log/isoloom-setup.log\nTimeoutStartSec=0\n\n[Install]\nWantedBy=multi-user.target\nISOLOOM_UNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-setup.service >/dev/null 2>&1\nsystemctl start --no-block isoloom-setup.service\nelse\nnohup sh /var/lib/isoloom/setup.sh >> /var/log/isoloom-setup.log 2>&1 &\nfi\n"
  labels = {
    isoloom-environment = "dmz-jump"
    managed-by          = "isoloom"
    isoloom-instance    = local.name
    isoloom-expires-at  = var.expires_at
  }
  lifecycle {
    ignore_changes = [metadata_startup_script]
  }
  can_ip_forward = true
}

# Machine `app`: what may reach it.
resource "google_compute_firewall" "app_net_internal" {
  project       = local.project
  name          = "${local.name}-app-net-internal"
  network       = google_compute_network.internal.id
  direction     = "INGRESS"
  source_ranges = ["10.30.20.0/24"]
  target_tags   = ["${local.name}-app"]
  allow {
    protocol = "all"
  }
}

resource "google_compute_firewall" "app_ssh" {
  project       = local.project
  name          = "${local.name}-app-ssh"
  network       = google_compute_network.internal.id
  direction     = "INGRESS"
  source_ranges = [var.allowed_cidr]
  target_tags   = ["${local.name}-app"]
  allow {
    protocol = "tcp"
    ports    = ["22"]
  }
}

resource "google_compute_firewall" "app_reach_dmz" {
  project       = local.project
  name          = "${local.name}-app-reach-dmz"
  network       = google_compute_network.internal.id
  direction     = "INGRESS"
  source_ranges = ["10.30.10.0/24"]
  target_tags   = ["${local.name}-app"]
  allow {
    protocol = "tcp"
    ports    = ["8080", "5432"]
  }
  allow {
    protocol = "udp"
    ports    = ["8080", "5432"]
  }
}

resource "google_compute_firewall" "app_environment_internal" {
  project            = local.project
  name               = "${local.name}-app-environment-internal"
  network            = google_compute_network.internal.id
  direction          = "EGRESS"
  priority           = 900
  destination_ranges = ["10.30.10.0/24", "10.30.20.0/24", "10.30.99.0/24"]
  target_tags        = ["${local.name}-app"]
  allow {
    protocol = "all"
  }
  depends_on = [
    terraform_data.isoloom_ready_gateway,
    terraform_data.isoloom_ready_app,
    terraform_data.isoloom_ready_db,
    terraform_data.isoloom_ready_user
  ]
}

resource "google_compute_firewall" "app_sealed_internal" {
  project            = local.project
  name               = "${local.name}-app-sealed-internal"
  network            = google_compute_network.internal.id
  direction          = "EGRESS"
  priority           = 1000
  destination_ranges = ["0.0.0.0/0"]
  target_tags        = ["${local.name}-app"]
  deny {
    protocol = "all"
  }
  depends_on = [
    terraform_data.isoloom_ready_gateway,
    terraform_data.isoloom_ready_app,
    terraform_data.isoloom_ready_db,
    terraform_data.isoloom_ready_user
  ]
}

resource "google_compute_instance" "app" {
  project      = local.project
  name         = "${local.name}-app"
  machine_type = "e2-small"
  zone         = local.zone
  tags         = ["${local.name}-app"]
  boot_disk {
    initialize_params {
      image = "debian-cloud/debian-12"
      labels = {
        isoloom-environment = "dmz-jump"
        managed-by          = "isoloom"
        isoloom-instance    = local.name
        isoloom-expires-at  = var.expires_at
      }
      size = 20
    }
  }
  network_interface {
    subnetwork = google_compute_subnetwork.internal.id
    network_ip = "10.30.20.20"
    access_config {}
  }
  metadata                = { ssh-keys = "admin:${var.ssh_public_key}" }
  metadata_startup_script = "#!/bin/sh\n# Isoloom: this machine sets itself up. Its progress is in /var/lib/isoloom/ready (isoloom-ready/1), its output in /var/log/isoloom-setup.log. The project comes over SSH from Terraform.\nmkdir -p /var/lib/isoloom\nrm -f /var/lib/isoloom/setup.sh.new\n(umask 077 && cat > /var/lib/isoloom/setup.sh.new) <<'ISOLOOM_SETUP'\n#!/bin/sh\numask 022\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\nstate=$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\npart=$(cat /var/lib/isoloom/part 2>/dev/null || echo 1)\ncase \"$state\" in ready|\"failed: \"*) exit 0 ;; esac\nif [ \"$part\" = 1 ]; then\necho 'running: its host name' > /var/lib/isoloom/ready; { hostnamectl set-hostname app 2>/dev/null || hostname app; grep -q ' app$' /etc/hosts || echo '127.0.1.1 app' >> /etc/hosts; [ ! -d /etc/cloud/cloud.cfg.d ] || echo 'preserve_hostname: true' > /etc/cloud/cloud.cfg.d/99-isoloom-hostname.cfg; } || { echo 'failed: its host name' > /var/lib/isoloom/ready; exit 1; }\necho 'running: waiting for the project (Terraform brings it in over SSH)' > /var/lib/isoloom/ready; { i=0; until [ -f /var/lib/isoloom/project-delivered ]; do [ \"$i\" -gt 0 ] || echo 'waiting for the project, which Terraform brings in over SSH during its apply'; i=$((i+5)); if [ \"$i\" -gt 2400 ]; then echo 'the project never came: Terraform brings it in over SSH during its apply (its terraform_data.isoloom_ready_<machine>), with ssh_private_key_file' >&2; exit 1; fi; sleep 5; done; } || { echo 'failed: waiting for the project (Terraform brings it in over SSH)' > /var/lib/isoloom/ready; exit 1; }\necho 'running: hosts file' > /var/lib/isoloom/ready; { sh -c 'printf '\\''%s\\n'\\'' '\\''10.30.20.10 gateway'\\'' '\\''10.30.20.20 app'\\'' '\\''10.30.20.30 db'\\'' '\\''10.30.99.10 user'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'; } || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }\necho 'running: provision/app.yml' > /var/lib/isoloom/ready; { sh -c 'set -e\npkg() { if command -v apt-get >/dev/null; then apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \"$@\"; elif command -v dnf >/dev/null; then dnf install -y -q \"$@\"; elif command -v apk >/dev/null; then apk add -q --no-cache \"$@\"; else yum install -y -q \"$@\"; fi; }\ncommand -v ansible-playbook >/dev/null || pkg ansible-core\ncd /opt/isoloom && sh -c '\\''ansible-playbook -c local -i app, '\\''\\'\\'''\\''provision/app.yml'\\''\\'\\'''\\'''\\'''; } || { echo 'failed: provision/app.yml' > /var/lib/isoloom/ready; exit 1; }\necho 'running: closing the internet' > /var/lib/isoloom/ready; { sh -c 'pkg() { if command -v apt-get >/dev/null; then apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \"$@\"; elif command -v dnf >/dev/null; then dnf install -y -q \"$@\"; elif command -v apk >/dev/null; then apk add -q --no-cache \"$@\"; else yum install -y -q \"$@\"; fi; }\ncommand -v nft >/dev/null || pkg nftables\nprintf '\\''%s\\n'\\'' '\\''table inet isoloom-egress'\\'' '\\''delete table inet isoloom-egress'\\'' '\\''table inet isoloom-egress {'\\'' '\\''  chain output {'\\'' '\\''    type filter hook output priority 0; policy accept;'\\'' '\\''    oifname \"lo\" accept'\\'' '\\''    ip daddr != { 10.30.10.0/24, 10.30.20.0/24, 10.30.99.0/24 } ct state new drop'\\'' '\\''  }'\\'' '\\''}'\\'' > /etc/isoloom-egress.nft\nmkdir -p /etc/isoloom\ncat > /etc/isoloom/egress.sh <<'\\''EGRESS'\\''\n#!/bin/sh\n# No new connection leaves the isoloom networks\nnft -f /etc/isoloom-egress.nft\nexit 0\nEGRESS\nchmod +x /etc/isoloom/egress.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-egress.service <<'\\''UNIT'\\''\n[Unit]\nDescription=No new connection leaves the isoloom networks\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=-/etc/isoloom/egress.sh\n\n[Install]\nWantedBy=multi-user.target\nUNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-egress.service\nsystemctl restart isoloom-egress.service\nelse\nmkdir -p /etc/local.d && ln -sf /etc/isoloom/egress.sh /etc/local.d/isoloom-egress.start\nrc-update add local default >/dev/null 2>&1 || true\n/etc/isoloom/egress.sh || true\nfi'; } || { echo 'failed: closing the internet' > /var/lib/isoloom/ready; exit 1; }\necho 'running: health check' > /var/lib/isoloom/ready; { sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'; } || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }\nfi\necho ready > /var/lib/isoloom/ready\nrm -f /var/lib/isoloom/part\nexit 0\nISOLOOM_SETUP\nmv -f /var/lib/isoloom/setup.sh.new /var/lib/isoloom/setup.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-setup.service <<'ISOLOOM_UNIT'\n[Unit]\nDescription=Isoloom: the machine's set-up\nWants=network-online.target\nAfter=network-online.target cloud-final.service google-startup-scripts.service\n\n[Service]\nType=oneshot\nExecStart=/bin/sh /var/lib/isoloom/setup.sh\nStandardOutput=append:/var/log/isoloom-setup.log\nStandardError=append:/var/log/isoloom-setup.log\nTimeoutStartSec=0\n\n[Install]\nWantedBy=multi-user.target\nISOLOOM_UNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-setup.service >/dev/null 2>&1\nsystemctl start --no-block isoloom-setup.service\nelse\nnohup sh /var/lib/isoloom/setup.sh >> /var/log/isoloom-setup.log 2>&1 &\nfi\n"
  labels = {
    isoloom-environment = "dmz-jump"
    managed-by          = "isoloom"
    isoloom-instance    = local.name
    isoloom-expires-at  = var.expires_at
  }
  lifecycle {
    ignore_changes = [metadata_startup_script]
  }
}

# Machine `db`: what may reach it.
resource "google_compute_firewall" "db_net_internal" {
  project       = local.project
  name          = "${local.name}-db-net-internal"
