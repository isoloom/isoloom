  security_list_ids = [oci_core_security_list.internal.id]
  lifecycle {
    ignore_changes = [route_table_id]
  }
}

# The seal of `internal`: once every machine is set up, its subnet goes out to allowed_cidr alone.
resource "oci_core_route_table" "sealed_internal" {
  compartment_id = var.compartment_id
  freeform_tags  = local.tags
  vcn_id         = oci_core_vcn.env.id
  display_name   = "${local.name}-internal-sealed"
  route_rules {
    destination       = var.allowed_cidr
    network_entity_id = oci_core_internet_gateway.env.id
  }
}

resource "oci_core_route_table_attachment" "sealed_internal" {
  subnet_id      = oci_core_subnet.internal.id
  route_table_id = oci_core_route_table.sealed_internal.id
  depends_on = [
    terraform_data.isoloom_ready_gateway,
    terraform_data.isoloom_ready_app,
    terraform_data.isoloom_ready_db,
    terraform_data.isoloom_ready_user
  ]
}

