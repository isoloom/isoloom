_retry() { _end=$(( $(date +%s) + $1 )); shift; while ! "$@"; do [ "$(date +%s)" -lt "$_end" ] || return 1; sleep 2; done; }

echo '== checks/dmz-reachable.sh'
if _retry 0 sh -c 'cd /opt/isoloom && sh checks/dmz-reachable.sh'; then pass 'checks/dmz-reachable.sh'; else fail 'checks/dmz-reachable.sh' "checks/dmz-reachable.sh exited non-zero"; fi

echo '== checks/internal-not-reachable-from-access.sh'
if _retry 0 sh -c 'cd /opt/isoloom && sh checks/internal-not-reachable-from-access.sh'; then pass 'checks/internal-not-reachable-from-access.sh'; else fail 'checks/internal-not-reachable-from-access.sh' "checks/internal-not-reachable-from-access.sh exited non-zero"; fi

