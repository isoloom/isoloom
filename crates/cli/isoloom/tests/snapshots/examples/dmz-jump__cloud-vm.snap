---
source: crates/cli/isoloom/tests/example_snapshots.rs
---
# isoloom targets
✓ cloud-vm
    ✗ digitalocean (DigitalOcean cloud-vm takes one machine on one network: a droplet joins one VPC, at a private address DigitalOcean picks, so other machines couldn't reach it at its spec address)
    ✗ linode (machine `gateway` is on several networks: a Linode instance has one VPC interface)

# isoloom generate --target cloud-vm (exit 0)
✓ .isoloom/cloud-vm/aws/main.tf
✓ .isoloom/cloud-vm/azure/main.tf
✓ .isoloom/cloud-vm/gcp/main.tf
✓ .isoloom/cloud-vm/oci/main.tf
✓ .isoloom/cloud-vm/checks/user.sh
✓ .isoloom/cloud-vm/checks/gateway.sh
✓ .isoloom/cloud-vm/checks/app.sh
✓ .isoloom/cloud-vm/checks/db.sh
✓ .isoloom/cloud-vm/aws/run.json
✓ .isoloom/cloud-vm/azure/run.json
✓ .isoloom/cloud-vm/gcp/run.json
✓ .isoloom/cloud-vm/oci/run.json
✓ .isoloom/resolved.json
✓ .isoloom/.gitignore

## .isoloom/.generated
# The files isoloom generate wrote here, which it removes once it no longer writes them. Don't edit.
.isoloom/.gitignore
.isoloom/cloud-vm/aws/main.tf
.isoloom/cloud-vm/aws/run.json
.isoloom/cloud-vm/azure/main.tf
.isoloom/cloud-vm/azure/run.json
.isoloom/cloud-vm/checks/app.sh
.isoloom/cloud-vm/checks/db.sh
.isoloom/cloud-vm/checks/gateway.sh
.isoloom/cloud-vm/checks/user.sh
.isoloom/cloud-vm/gcp/main.tf
.isoloom/cloud-vm/gcp/run.json
.isoloom/cloud-vm/oci/main.tf
.isoloom/cloud-vm/oci/run.json
.isoloom/resolved.json

## .isoloom/.gitignore: identical in the `docker` snapshot

## .isoloom/cloud-vm/aws/main.tf
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  terraform -chdir=.isoloom/cloud-vm/aws init && terraform -chdir=.isoloom/cloud-vm/aws apply \
#           -var allowed_cidr=<your IP>/32 -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)"
# Stop:   terraform -chdir=.isoloom/cloud-vm/aws destroy (same variables)
# Then:   the machines wait for the project: run the lab through the runner (run.json) beside this file,
#         which delivers the project over SSH, waits for each set-up and runs the checks.

terraform {
  required_version = ">= 1.6.0"
  backend "local" {}
  required_providers {
    aws = { source = "hashicorp/aws", version = "~> 6.67.0" }
  }
}

variable "region" {
  type    = string
  default = "eu-west-3"
}

variable "isoloom_sealed" {
  type        = bool
  default     = false
  description = "Close the internet to the machines of every `internet: false` network, at the network: the runner sets it once the machines are set up"
}

variable "allowed_cidr" {
  type        = string
  description = "Who may reach the machines (SSH and the published ports), e.g. your IP/32"
}

variable "ssh_public_key" {
  type        = string
  description = "The SSH public key the machines let in: whoever holds its private key signs in, as the runner (run.json) does to deliver the project and run the checks"
}

variable "expires_at" {
  type        = string
  default     = ""
  description = "When the environment should end, in Unix seconds (empty: no end): a tag on every resource, so a reaper finds what to destroy, and the time the machines shut themselves down"
}

provider "aws" {
  region = var.region
  default_tags {
    tags = {
      isoloom-environment = "dmz-jump"
      managed-by          = "isoloom"
      isoloom-instance    = local.name
      isoloom-expires-at  = var.expires_at
    }
  }
}

resource "terraform_data" "id" {
  input = substr(replace(uuid(), "-", ""), 0, 8)
  lifecycle {
    ignore_changes = [input]
  }
}

locals {
  name = "isoloom-dmz-jump-${terraform_data.id.output}"
}

data "aws_availability_zones" "available" {
  state = "available"
}

# The environment's networks: one VPC, a subnet per network with its exact range.
resource "aws_vpc" "env" {
  cidr_block = "10.30.10.0/24"
  tags       = { Name = local.name }
}

resource "aws_vpc_ipv4_cidr_block_association" "internal" {
  vpc_id     = aws_vpc.env.id
  cidr_block = "10.30.20.0/24"
}

resource "aws_vpc_ipv4_cidr_block_association" "access" {
  vpc_id     = aws_vpc.env.id
  cidr_block = "10.30.99.0/24"
}

resource "aws_internet_gateway" "env" {
  vpc_id = aws_vpc.env.id
}

resource "aws_route_table" "env" {
  vpc_id = aws_vpc.env.id
  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.env.id
  }
}

# The networks without internet: theirs until the run is sealed, then allowed_cidr's replies only.
resource "aws_route_table" "sealed" {
  vpc_id = aws_vpc.env.id
  route {
    cidr_block = var.isoloom_sealed ? var.allowed_cidr : "0.0.0.0/0"
    gateway_id = aws_internet_gateway.env.id
  }
}

resource "aws_subnet" "dmz" {
  vpc_id            = aws_vpc.env.id
  cidr_block        = "10.30.10.0/24"
  availability_zone = data.aws_availability_zones.available.names[0]
  tags              = { Name = "${local.name}-dmz" }
}

resource "aws_route_table_association" "dmz" {
  subnet_id      = aws_subnet.dmz.id
  route_table_id = aws_route_table.env.id
}

resource "aws_subnet" "internal" {
  vpc_id            = aws_vpc.env.id
  cidr_block        = "10.30.20.0/24"
  availability_zone = data.aws_availability_zones.available.names[0]
  tags              = { Name = "${local.name}-internal" }
  depends_on        = [aws_vpc_ipv4_cidr_block_association.internal]
}

resource "aws_route_table_association" "internal" {
  subnet_id      = aws_subnet.internal.id
  route_table_id = aws_route_table.sealed.id
}

resource "aws_subnet" "access" {
  vpc_id            = aws_vpc.env.id
  cidr_block        = "10.30.99.0/24"
  availability_zone = data.aws_availability_zones.available.names[0]
  tags              = { Name = "${local.name}-access" }
  depends_on        = [aws_vpc_ipv4_cidr_block_association.access]
}

resource "aws_route_table_association" "access" {
  subnet_id      = aws_subnet.access.id
  route_table_id = aws_route_table.env.id
}

resource "aws_key_pair" "env" {
  key_name   = local.name
  public_key = var.ssh_public_key
}

data "aws_ami" "debian_12" {
  most_recent = true
  owners      = ["136693071363"]
  filter {
    name   = "name"
    values = ["debian-12-amd64-*"]
  }
  filter {
    name   = "architecture"
    values = ["x86_64"]
  }
}

# Machine `gateway`: what may reach it.
resource "aws_security_group" "gateway" {
  name   = "${local.name}-gateway"
  vpc_id = aws_vpc.env.id
  ingress {
    description = "its network (dmz)"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["10.30.10.0/24"]
  }
  ingress {
    description = "its network (internal)"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["10.30.20.0/24"]
  }
  ingress {
    description = "SSH from allowed_cidr"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [var.allowed_cidr]
  }
  ingress {
    description = "reach from access"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["10.30.99.0/24"]
  }
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_network_interface" "gateway_dmz" {
  subnet_id         = aws_subnet.dmz.id
  private_ips       = ["10.30.10.10"]
  security_groups   = [aws_security_group.gateway.id]
  source_dest_check = false
  tags              = { Name = "${local.name}-gateway-dmz" }
}

resource "aws_network_interface" "gateway_internal" {
  subnet_id         = aws_subnet.internal.id
  private_ips       = ["10.30.20.10"]
  security_groups   = [aws_security_group.gateway.id]
  source_dest_check = false
  tags              = { Name = "${local.name}-gateway-internal" }
}

resource "aws_instance" "gateway" {
  instance_initiated_shutdown_behavior = "terminate"
  metadata_options {
    http_tokens = "required"
  }
  ami              = data.aws_ami.debian_12.id
  instance_type    = "t3.micro"
  user_data_base64 = base64gzip("#!/bin/sh\n# Isoloom: this machine sets itself up. Its progress is in /var/lib/isoloom/ready (isoloom-ready/1), its output in /var/log/isoloom-setup.log. The project comes over SSH from the runner (run.json).\nmkdir -p /var/lib/isoloom\nrm -f /var/lib/isoloom/setup.sh.new\n(umask 077 && cat > /var/lib/isoloom/setup.sh.new) <<'ISOLOOM_SETUP'\n#!/bin/sh\numask 022\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\nstate=$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\npart=$(cat /var/lib/isoloom/part 2>/dev/null || echo 1)\nif [ \"$state\" = ready ] || [ \"$part\" != 1 ]; then\nIF=$(ip -o link | grep -i \"${lower(aws_network_interface.gateway_internal.mac_address)}\" | awk -F': ' '{print $2}'); sudo ip link set \"$IF\" up && (ip -4 addr show \"$IF\" | grep -q 10.30.20.10/ || sudo ip addr add 10.30.20.10/24 dev \"$IF\")\nfi\ncase \"$state\" in ready|failed:*) exit 0 ;; esac\nif [ \"$part\" = 1 ]; then\necho 'running: its host name' > /var/lib/isoloom/ready; { hostnamectl set-hostname gateway 2>/dev/null || hostname gateway; grep -q ' gateway$' /etc/hosts || echo '127.0.1.1 gateway' >> /etc/hosts; [ ! -d /etc/cloud/cloud.cfg.d ] || echo 'preserve_hostname: true' > /etc/cloud/cloud.cfg.d/99-isoloom-hostname.cfg; } || { echo 'failed: its host name' > /var/lib/isoloom/ready; exit 1; }\necho 'running: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; { i=0; until [ -f /var/lib/isoloom/project-delivered ]; do [ \"$i\" -gt 0 ] || echo 'waiting for the project, which the runner (run.json) delivers over SSH'; i=$((i+5)); if [ \"$i\" -gt 2400 ]; then echo 'the project never came: start the lab through the runner (run.json), which delivers it over SSH' >&2; exit 1; fi; sleep 5; done; } || { echo 'failed: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; exit 1; }\necho 'running: the machine'\\''s interfaces' > /var/lib/isoloom/ready; { IF=$(ip -o link | grep -i \"${lower(aws_network_interface.gateway_internal.mac_address)}\" | awk -F': ' '{print $2}'); sudo ip link set \"$IF\" up && (ip -4 addr show \"$IF\" | grep -q 10.30.20.10/ || sudo ip addr add 10.30.20.10/24 dev \"$IF\"); } || { echo 'failed: the machine'\\''s interfaces' > /var/lib/isoloom/ready; exit 1; }\necho 'running: hosts file' > /var/lib/isoloom/ready; { sh -c 'printf '\\''%s\\n'\\'' '\\''10.30.10.10 gateway'\\'' '\\''10.30.20.20 app'\\'' '\\''10.30.20.30 db'\\'' '\\''10.30.99.10 user'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'; } || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }\necho 'running: provision/gateway.yml' > /var/lib/isoloom/ready; { sh -c 'pkg() { if command -v apt-get >/dev/null; then apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \"$@\"; elif command -v dnf >/dev/null; then dnf install -y -q \"$@\"; else yum install -y -q \"$@\"; fi; }\ncommand -v ansible-playbook >/dev/null || pkg ansible-core\ncd /opt/isoloom && sh -c '\\''ansible-playbook -c local -i gateway, provision/gateway.yml'\\'''; } || { echo 'failed: provision/gateway.yml' > /var/lib/isoloom/ready; exit 1; }\necho 'running: health check' > /var/lib/isoloom/ready; { sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'; } || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }\nfi\necho ready > /var/lib/isoloom/ready\nrm -f /var/lib/isoloom/part\nexit 0\nISOLOOM_SETUP\nmv -f /var/lib/isoloom/setup.sh.new /var/lib/isoloom/setup.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-setup.service <<'ISOLOOM_UNIT'\n[Unit]\nDescription=Isoloom: the machine's set-up\nWants=network-online.target\nAfter=network-online.target cloud-final.service google-startup-scripts.service\n\n[Service]\nType=oneshot\nExecStart=/bin/sh /var/lib/isoloom/setup.sh\nStandardOutput=append:/var/log/isoloom-setup.log\nStandardError=append:/var/log/isoloom-setup.log\nTimeoutStartSec=0\n\n[Install]\nWantedBy=multi-user.target\nISOLOOM_UNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-setup.service >/dev/null 2>&1\nsystemctl start --no-block isoloom-setup.service\nelse\nnohup sh /var/lib/isoloom/setup.sh >> /var/log/isoloom-setup.log 2>&1 &\nfi\n")
  lifecycle {
    ignore_changes = [user_data_base64]
  }
  key_name = aws_key_pair.env.key_name
  primary_network_interface {
    network_interface_id = aws_network_interface.gateway_dmz.id
  }
  root_block_device {
    volume_size = 20
    volume_type = "gp3"
    encrypted   = true
  }
  tags = { Name = "${local.name}-gateway" }
}

resource "aws_network_interface_attachment" "gateway_internal" {
  instance_id          = aws_instance.gateway.id
  network_interface_id = aws_network_interface.gateway_internal.id
  device_index         = 1
}

resource "aws_eip" "gateway" {
  network_interface = aws_network_interface.gateway_dmz.id
  depends_on        = [aws_internet_gateway.env]
}

# Machine `app`: what may reach it.
resource "aws_security_group" "app" {
  name   = "${local.name}-app"
  vpc_id = aws_vpc.env.id
  ingress {
    description = "its network (internal)"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["10.30.20.0/24"]
  }
  ingress {
    description = "SSH from allowed_cidr"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [var.allowed_cidr]
  }
  ingress {
    description = "reach from dmz"
    from_port   = 8080
    to_port     = 8080
    protocol    = "tcp"
    cidr_blocks = ["10.30.10.0/24"]
  }
  ingress {
    description = "reach from dmz"
    from_port   = 8080
    to_port     = 8080
    protocol    = "udp"
    cidr_blocks = ["10.30.10.0/24"]
  }
  ingress {
    description = "reach from dmz"
    from_port   = 5432
    to_port     = 5432
    protocol    = "tcp"
    cidr_blocks = ["10.30.10.0/24"]
  }
  ingress {
    description = "reach from dmz"
    from_port   = 5432
    to_port     = 5432
    protocol    = "udp"
    cidr_blocks = ["10.30.10.0/24"]
  }
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = var.isoloom_sealed ? ["10.30.10.0/24", "10.30.20.0/24", "10.30.99.0/24"] : ["0.0.0.0/0"]
  }
}

resource "aws_instance" "app" {
  instance_initiated_shutdown_behavior = "terminate"
  metadata_options {
    http_tokens = "required"
  }
  ami              = data.aws_ami.debian_12.id
  instance_type    = "t3.micro"
  user_data_base64 = base64gzip("#!/bin/sh\n# Isoloom: this machine sets itself up. Its progress is in /var/lib/isoloom/ready (isoloom-ready/1), its output in /var/log/isoloom-setup.log. The project comes over SSH from the runner (run.json).\nmkdir -p /var/lib/isoloom\nrm -f /var/lib/isoloom/setup.sh.new\n(umask 077 && cat > /var/lib/isoloom/setup.sh.new) <<'ISOLOOM_SETUP'\n#!/bin/sh\numask 022\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\nstate=$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\npart=$(cat /var/lib/isoloom/part 2>/dev/null || echo 1)\ncase \"$state\" in ready|failed:*) exit 0 ;; esac\nif [ \"$part\" = 1 ]; then\necho 'running: its host name' > /var/lib/isoloom/ready; { hostnamectl set-hostname app 2>/dev/null || hostname app; grep -q ' app$' /etc/hosts || echo '127.0.1.1 app' >> /etc/hosts; [ ! -d /etc/cloud/cloud.cfg.d ] || echo 'preserve_hostname: true' > /etc/cloud/cloud.cfg.d/99-isoloom-hostname.cfg; } || { echo 'failed: its host name' > /var/lib/isoloom/ready; exit 1; }\necho 'running: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; { i=0; until [ -f /var/lib/isoloom/project-delivered ]; do [ \"$i\" -gt 0 ] || echo 'waiting for the project, which the runner (run.json) delivers over SSH'; i=$((i+5)); if [ \"$i\" -gt 2400 ]; then echo 'the project never came: start the lab through the runner (run.json), which delivers it over SSH' >&2; exit 1; fi; sleep 5; done; } || { echo 'failed: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; exit 1; }\necho 'running: hosts file' > /var/lib/isoloom/ready; { sh -c 'printf '\\''%s\\n'\\'' '\\''10.30.20.10 gateway'\\'' '\\''10.30.20.20 app'\\'' '\\''10.30.20.30 db'\\'' '\\''10.30.99.10 user'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'; } || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }\necho 'running: provision/app.yml' > /var/lib/isoloom/ready; { sh -c 'pkg() { if command -v apt-get >/dev/null; then apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \"$@\"; elif command -v dnf >/dev/null; then dnf install -y -q \"$@\"; else yum install -y -q \"$@\"; fi; }\ncommand -v ansible-playbook >/dev/null || pkg ansible-core\ncd /opt/isoloom && sh -c '\\''ansible-playbook -c local -i app, provision/app.yml'\\'''; } || { echo 'failed: provision/app.yml' > /var/lib/isoloom/ready; exit 1; }\necho 'running: closing the internet' > /var/lib/isoloom/ready; { sh -c 'pkg() { if command -v apt-get >/dev/null; then apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \"$@\"; elif command -v dnf >/dev/null; then dnf install -y -q \"$@\"; else yum install -y -q \"$@\"; fi; }\ncommand -v nft >/dev/null || if command -v apk >/dev/null; then apk add -q --no-cache nftables; else pkg nftables; fi\nprintf '\\''%s\\n'\\'' '\\''table inet isoloom-egress'\\'' '\\''delete table inet isoloom-egress'\\'' '\\''table inet isoloom-egress {'\\'' '\\''  chain output {'\\'' '\\''    type filter hook output priority 0; policy accept;'\\'' '\\''    oifname \"lo\" accept'\\'' '\\''    ip daddr != { 10.30.10.0/24, 10.30.20.0/24, 10.30.99.0/24 } ct state new drop'\\'' '\\''  }'\\'' '\\''}'\\'' > /etc/isoloom-egress.nft\nmkdir -p /etc/isoloom\ncat > /etc/isoloom/egress.sh <<'\\''EGRESS'\\''\n#!/bin/sh\n# No new connection leaves the isoloom networks\nnft -f /etc/isoloom-egress.nft\nexit 0\nEGRESS\nchmod +x /etc/isoloom/egress.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-egress.service <<'\\''UNIT'\\''\n[Unit]\nDescription=No new connection leaves the isoloom networks\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=-/etc/isoloom/egress.sh\n\n[Install]\nWantedBy=multi-user.target\nUNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-egress.service\nsystemctl restart isoloom-egress.service\nelse\nmkdir -p /etc/local.d && ln -sf /etc/isoloom/egress.sh /etc/local.d/isoloom-egress.start\nrc-update add local default >/dev/null 2>&1 || true\n/etc/isoloom/egress.sh || true\nfi'; } || { echo 'failed: closing the internet' > /var/lib/isoloom/ready; exit 1; }\necho 'running: health check' > /var/lib/isoloom/ready; { sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'; } || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }\nfi\necho ready > /var/lib/isoloom/ready\nrm -f /var/lib/isoloom/part\nexit 0\nISOLOOM_SETUP\nmv -f /var/lib/isoloom/setup.sh.new /var/lib/isoloom/setup.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-setup.service <<'ISOLOOM_UNIT'\n[Unit]\nDescription=Isoloom: the machine's set-up\nWants=network-online.target\nAfter=network-online.target cloud-final.service google-startup-scripts.service\n\n[Service]\nType=oneshot\nExecStart=/bin/sh /var/lib/isoloom/setup.sh\nStandardOutput=append:/var/log/isoloom-setup.log\nStandardError=append:/var/log/isoloom-setup.log\nTimeoutStartSec=0\n\n[Install]\nWantedBy=multi-user.target\nISOLOOM_UNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-setup.service >/dev/null 2>&1\nsystemctl start --no-block isoloom-setup.service\nelse\nnohup sh /var/lib/isoloom/setup.sh >> /var/log/isoloom-setup.log 2>&1 &\nfi\n")
  lifecycle {
    ignore_changes = [user_data_base64]
  }
  subnet_id                   = aws_subnet.internal.id
  private_ip                  = "10.30.20.20"
  associate_public_ip_address = true
  key_name                    = aws_key_pair.env.key_name
  vpc_security_group_ids      = [aws_security_group.app.id]
  root_block_device {
    volume_size = 20
    volume_type = "gp3"
    encrypted   = true
  }
  tags = { Name = "${local.name}-app" }
}

# Machine `db`: what may reach it.
resource "aws_security_group" "db" {
  name   = "${local.name}-db"
  vpc_id = aws_vpc.env.id
  ingress {
    description = "its network (internal)"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["10.30.20.0/24"]
  }
  ingress {
    description = "SSH from allowed_cidr"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [var.allowed_cidr]
  }
  ingress {
    description = "reach from dmz"
    from_port   = 8080
    to_port     = 8080
    protocol    = "tcp"
    cidr_blocks = ["10.30.10.0/24"]
  }
  ingress {
    description = "reach from dmz"
    from_port   = 8080
    to_port     = 8080
    protocol    = "udp"
    cidr_blocks = ["10.30.10.0/24"]
  }
  ingress {
    description = "reach from dmz"
    from_port   = 5432
    to_port     = 5432
    protocol    = "tcp"
    cidr_blocks = ["10.30.10.0/24"]
  }
  ingress {
    description = "reach from dmz"
    from_port   = 5432
    to_port     = 5432
    protocol    = "udp"
    cidr_blocks = ["10.30.10.0/24"]
  }
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = var.isoloom_sealed ? ["10.30.10.0/24", "10.30.20.0/24", "10.30.99.0/24"] : ["0.0.0.0/0"]
  }
}

resource "aws_instance" "db" {
  instance_initiated_shutdown_behavior = "terminate"
  metadata_options {
    http_tokens = "required"
  }
  ami              = data.aws_ami.debian_12.id
  instance_type    = "t3.micro"
  user_data_base64 = base64gzip("#!/bin/sh\n# Isoloom: this machine sets itself up. Its progress is in /var/lib/isoloom/ready (isoloom-ready/1), its output in /var/log/isoloom-setup.log. The project comes over SSH from the runner (run.json).\nmkdir -p /var/lib/isoloom\nrm -f /var/lib/isoloom/setup.sh.new\n(umask 077 && cat > /var/lib/isoloom/setup.sh.new) <<'ISOLOOM_SETUP'\n#!/bin/sh\numask 022\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\nstate=$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\npart=$(cat /var/lib/isoloom/part 2>/dev/null || echo 1)\ncase \"$state\" in ready|failed:*) exit 0 ;; esac\nif [ \"$part\" = 1 ]; then\necho 'running: its host name' > /var/lib/isoloom/ready; { hostnamectl set-hostname db 2>/dev/null || hostname db; grep -q ' db$' /etc/hosts || echo '127.0.1.1 db' >> /etc/hosts; [ ! -d /etc/cloud/cloud.cfg.d ] || echo 'preserve_hostname: true' > /etc/cloud/cloud.cfg.d/99-isoloom-hostname.cfg; } || { echo 'failed: its host name' > /var/lib/isoloom/ready; exit 1; }\necho 'running: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; { i=0; until [ -f /var/lib/isoloom/project-delivered ]; do [ \"$i\" -gt 0 ] || echo 'waiting for the project, which the runner (run.json) delivers over SSH'; i=$((i+5)); if [ \"$i\" -gt 2400 ]; then echo 'the project never came: start the lab through the runner (run.json), which delivers it over SSH' >&2; exit 1; fi; sleep 5; done; } || { echo 'failed: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; exit 1; }\necho 'running: hosts file' > /var/lib/isoloom/ready; { sh -c 'printf '\\''%s\\n'\\'' '\\''10.30.20.10 gateway'\\'' '\\''10.30.20.20 app'\\'' '\\''10.30.20.30 db'\\'' '\\''10.30.99.10 user'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'; } || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }\necho 'running: provision/db.yml' > /var/lib/isoloom/ready; { sh -c 'pkg() { if command -v apt-get >/dev/null; then apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \"$@\"; elif command -v dnf >/dev/null; then dnf install -y -q \"$@\"; else yum install -y -q \"$@\"; fi; }\ncommand -v ansible-playbook >/dev/null || pkg ansible-core\ncd /opt/isoloom && sh -c '\\''ansible-playbook -c local -i db, provision/db.yml'\\'''; } || { echo 'failed: provision/db.yml' > /var/lib/isoloom/ready; exit 1; }\necho 'running: closing the internet' > /var/lib/isoloom/ready; { sh -c 'pkg() { if command -v apt-get >/dev/null; then apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \"$@\"; elif command -v dnf >/dev/null; then dnf install -y -q \"$@\"; else yum install -y -q \"$@\"; fi; }\ncommand -v nft >/dev/null || if command -v apk >/dev/null; then apk add -q --no-cache nftables; else pkg nftables; fi\nprintf '\\''%s\\n'\\'' '\\''table inet isoloom-egress'\\'' '\\''delete table inet isoloom-egress'\\'' '\\''table inet isoloom-egress {'\\'' '\\''  chain output {'\\'' '\\''    type filter hook output priority 0; policy accept;'\\'' '\\''    oifname \"lo\" accept'\\'' '\\''    ip daddr != { 10.30.10.0/24, 10.30.20.0/24, 10.30.99.0/24 } ct state new drop'\\'' '\\''  }'\\'' '\\''}'\\'' > /etc/isoloom-egress.nft\nmkdir -p /etc/isoloom\ncat > /etc/isoloom/egress.sh <<'\\''EGRESS'\\''\n#!/bin/sh\n# No new connection leaves the isoloom networks\nnft -f /etc/isoloom-egress.nft\nexit 0\nEGRESS\nchmod +x /etc/isoloom/egress.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-egress.service <<'\\''UNIT'\\''\n[Unit]\nDescription=No new connection leaves the isoloom networks\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=-/etc/isoloom/egress.sh\n\n[Install]\nWantedBy=multi-user.target\nUNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-egress.service\nsystemctl restart isoloom-egress.service\nelse\nmkdir -p /etc/local.d && ln -sf /etc/isoloom/egress.sh /etc/local.d/isoloom-egress.start\nrc-update add local default >/dev/null 2>&1 || true\n/etc/isoloom/egress.sh || true\nfi'; } || { echo 'failed: closing the internet' > /var/lib/isoloom/ready; exit 1; }\necho 'running: health check' > /var/lib/isoloom/ready; { sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'; } || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }\nfi\necho ready > /var/lib/isoloom/ready\nrm -f /var/lib/isoloom/part\nexit 0\nISOLOOM_SETUP\nmv -f /var/lib/isoloom/setup.sh.new /var/lib/isoloom/setup.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-setup.service <<'ISOLOOM_UNIT'\n[Unit]\nDescription=Isoloom: the machine's set-up\nWants=network-online.target\nAfter=network-online.target cloud-final.service google-startup-scripts.service\n\n[Service]\nType=oneshot\nExecStart=/bin/sh /var/lib/isoloom/setup.sh\nStandardOutput=append:/var/log/isoloom-setup.log\nStandardError=append:/var/log/isoloom-setup.log\nTimeoutStartSec=0\n\n[Install]\nWantedBy=multi-user.target\nISOLOOM_UNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-setup.service >/dev/null 2>&1\nsystemctl start --no-block isoloom-setup.service\nelse\nnohup sh /var/lib/isoloom/setup.sh >> /var/log/isoloom-setup.log 2>&1 &\nfi\n")
  lifecycle {
    ignore_changes = [user_data_base64]
  }
  subnet_id                   = aws_subnet.internal.id
  private_ip                  = "10.30.20.30"
  associate_public_ip_address = true
  key_name                    = aws_key_pair.env.key_name
  vpc_security_group_ids      = [aws_security_group.db.id]
  root_block_device {
    volume_size = 20
    volume_type = "gp3"
    encrypted   = true
  }
  tags = { Name = "${local.name}-db" }
}

# Machine `user`: what may reach it.
resource "aws_security_group" "user" {
  name   = "${local.name}-user"
  vpc_id = aws_vpc.env.id
  ingress {
    description = "its network (access)"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["10.30.99.0/24"]
  }
  ingress {
    description = "SSH from allowed_cidr"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [var.allowed_cidr]
  }
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_instance" "user" {
  instance_initiated_shutdown_behavior = "terminate"
  metadata_options {
    http_tokens = "required"
  }
  ami              = data.aws_ami.debian_12.id
  instance_type    = "t3.micro"
  user_data_base64 = base64gzip("#!/bin/sh\n# Isoloom: this machine sets itself up. Its progress is in /var/lib/isoloom/ready (isoloom-ready/1), its output in /var/log/isoloom-setup.log. The project comes over SSH from the runner (run.json).\nmkdir -p /var/lib/isoloom\nrm -f /var/lib/isoloom/setup.sh.new\n(umask 077 && cat > /var/lib/isoloom/setup.sh.new) <<'ISOLOOM_SETUP'\n#!/bin/sh\numask 022\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\nstate=$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\npart=$(cat /var/lib/isoloom/part 2>/dev/null || echo 1)\ncase \"$state\" in ready|failed:*) exit 0 ;; esac\nif [ \"$part\" = 1 ]; then\necho 'running: its host name' > /var/lib/isoloom/ready; { hostnamectl set-hostname user 2>/dev/null || hostname user; grep -q ' user$' /etc/hosts || echo '127.0.1.1 user' >> /etc/hosts; [ ! -d /etc/cloud/cloud.cfg.d ] || echo 'preserve_hostname: true' > /etc/cloud/cloud.cfg.d/99-isoloom-hostname.cfg; } || { echo 'failed: its host name' > /var/lib/isoloom/ready; exit 1; }\necho 'running: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; { i=0; until [ -f /var/lib/isoloom/project-delivered ]; do [ \"$i\" -gt 0 ] || echo 'waiting for the project, which the runner (run.json) delivers over SSH'; i=$((i+5)); if [ \"$i\" -gt 2400 ]; then echo 'the project never came: start the lab through the runner (run.json), which delivers it over SSH' >&2; exit 1; fi; sleep 5; done; } || { echo 'failed: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; exit 1; }\necho 'running: hosts file' > /var/lib/isoloom/ready; { sh -c 'printf '\\''%s\\n'\\'' '\\''10.30.10.10 gateway'\\'' '\\''10.30.20.20 app'\\'' '\\''10.30.20.30 db'\\'' '\\''10.30.99.10 user'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'; } || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }\necho 'running: health check' > /var/lib/isoloom/ready; { sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'; } || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }\nfi\necho ready > /var/lib/isoloom/ready\nrm -f /var/lib/isoloom/part\nexit 0\nISOLOOM_SETUP\nmv -f /var/lib/isoloom/setup.sh.new /var/lib/isoloom/setup.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-setup.service <<'ISOLOOM_UNIT'\n[Unit]\nDescription=Isoloom: the machine's set-up\nWants=network-online.target\nAfter=network-online.target cloud-final.service google-startup-scripts.service\n\n[Service]\nType=oneshot\nExecStart=/bin/sh /var/lib/isoloom/setup.sh\nStandardOutput=append:/var/log/isoloom-setup.log\nStandardError=append:/var/log/isoloom-setup.log\nTimeoutStartSec=0\n\n[Install]\nWantedBy=multi-user.target\nISOLOOM_UNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-setup.service >/dev/null 2>&1\nsystemctl start --no-block isoloom-setup.service\nelse\nnohup sh /var/lib/isoloom/setup.sh >> /var/log/isoloom-setup.log 2>&1 &\nfi\n")
  lifecycle {
    ignore_changes = [user_data_base64]
  }
  subnet_id                   = aws_subnet.access.id
  private_ip                  = "10.30.99.10"
  associate_public_ip_address = true
  key_name                    = aws_key_pair.env.key_name
  vpc_security_group_ids      = [aws_security_group.user.id]
  root_block_device {
    volume_size = 20
    volume_type = "gp3"
    encrypted   = true
  }
  tags = { Name = "${local.name}-user" }
}

output "machines" {
  value = {
    gateway = aws_eip.gateway.public_ip
    app     = aws_instance.app.public_ip
    db      = aws_instance.db.public_ip
    user    = aws_instance.user.public_ip
  }
}

output "address_gateway" {
  value = aws_eip.gateway.public_ip
}

output "ssh_user_gateway" {
  value = "admin"
}

output "address_app" {
  value = aws_instance.app.public_ip
}

output "ssh_user_app" {
  value = "admin"
}

output "address_db" {
  value = aws_instance.db.public_ip
}

output "ssh_user_db" {
  value = "admin"
}

output "address_user" {
  value = aws_instance.user.public_ip
}

output "ssh_user_user" {
  value = "admin"
}

output "ssh_users" {
  value = { gateway = "admin", app = "admin", db = "admin", user = "admin" }
}

output "ip" {
  value = aws_instance.user.public_ip
}

output "ready_file" {
  value = "/var/lib/isoloom/ready"
}

# The checks: each runner on the machine it stands for (ssh <user>@<host> '<command>'), or the runner (run.json).
output "checks" {
  value = [
    {
      position = "user"
      machine  = "user"
      host     = aws_instance.user.public_ip
      user     = "admin"
      command  = "cd /opt/isoloom && sh .isoloom/cloud-vm/checks/user.sh"
    },
    {
      position = "gateway"
      machine  = "gateway"
      host     = aws_eip.gateway.public_ip
      user     = "admin"
      command  = "cd /opt/isoloom && sh .isoloom/cloud-vm/checks/gateway.sh"
    },
    {
      position = "app"
      machine  = "app"
      host     = aws_instance.app.public_ip
      user     = "admin"
      command  = "cd /opt/isoloom && sh .isoloom/cloud-vm/checks/app.sh"
    },
    {
      position = "db"
      machine  = "db"
      host     = aws_instance.db.public_ip
      user     = "admin"
      command  = "cd /opt/isoloom && sh .isoloom/cloud-vm/checks/db.sh"
    }
  ]
}

## .isoloom/cloud-vm/aws/run.json
{
  "$schema": "https://raw.githubusercontent.com/isoloom/isoloom/main/schemas/run-manifest-v1.schema.json",
  "manifest_version": 1,
  "generator": {
    "name": "isoloom",
    "version": "1.0.9"
  },
  "environment": {
    "name": "dmz-jump",
    "instance": null,
    "message": null
  },
  "target": "cloud-vm",
  "cloud": "aws",
  "driver": "terraform",
  "hosts": [
    "linux",
    "macos",
    "windows"
  ],
  "tools": [
    {
      "name": "terraform",
      "probe": [
        "terraform",
        "version"
      ],
      "min_version": "1.6.0"
    },
    {
      "name": "ssh",
      "probe": [
        "ssh",
        "-V"
      ]
    }
  ],
  "identity": {
    "terraform": {
      "module": ".",
      "state": "runner"
    }
  },
  "params": [
    {
      "name": "region",
      "description": "The module's `region`.",
      "default": "eu-west-3",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "region"
        }
      ]
    },
    {
      "name": "allowed_cidr",
      "description": "Who may reach the machines (SSH and the published ports), e.g. your IP/32.",
      "required": true,
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "allowed_cidr"
        }
      ]
    },
    {
      "name": "AWS_PROFILE",
      "description": "The AWS CLI profile the provider signs in with (its credentials and settings), when no keys are given.",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "AWS_PROFILE",
          "steps": [
            "init",
            "apply",
            "destroy",
            "seal"
          ]
        }
      ]
    },
    {
      "name": "isoloom_sealed",
      "description": "true once the machines are set up: the internet is closed to the `internet: false` networks, at the network.",
      "default": "false",
      "values": [
        "true",
        "false"
      ],
      "set_by": "runner",
      "deliver": [
        {
          "via": "tf_var",
          "var": "isoloom_sealed"
        }
      ]
    },
    {
      "name": "ISOLOOM_DERIVED",
      "description": "0: the checks derived from the spec (reachability, no internet) are skipped.",
      "default": "1",
      "values": [
        "0",
        "1"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_DERIVED",
          "steps": [
            "check-user",
            "check-gateway",
            "check-app",
            "check-db"
          ]
        }
      ]
    }
  ],
  "secrets": [
    {
      "name": "AWS_ACCESS_KEY_ID",
      "kind": "connection",
      "required": false,
      "sensitive": true,
      "source": {
        "store": "env",
        "reference": "AWS_ACCESS_KEY_ID"
      },
      "deliver": [
        {
          "via": "env",
          "var": "AWS_ACCESS_KEY_ID",
          "steps": [
            "init",
            "apply",
            "destroy",
            "seal"
          ]
        }
      ]
    },
    {
      "name": "AWS_SECRET_ACCESS_KEY",
      "kind": "connection",
      "required": false,
      "sensitive": true,
      "source": {
        "store": "env",
        "reference": "AWS_SECRET_ACCESS_KEY"
      },
      "deliver": [
        {
          "via": "env",
          "var": "AWS_SECRET_ACCESS_KEY",
          "steps": [
            "init",
            "apply",
            "destroy",
            "seal"
          ]
        }
      ]
    },
    {
      "name": "AWS_SESSION_TOKEN",
      "kind": "connection",
      "required": false,
      "sensitive": true,
      "source": {
        "store": "env",
        "reference": "AWS_SESSION_TOKEN"
      },
      "deliver": [
        {
          "via": "env",
          "var": "AWS_SESSION_TOKEN",
          "steps": [
            "init",
            "apply",
            "destroy",
            "seal"
          ]
        }
      ]
    }
  ],
  "networks": [
    {
      "name": "dmz",
      "cidr": "10.30.10.0/24",
      "internet": true,
      "native": "dmz"
    },
    {
      "name": "internal",
      "cidr": "10.30.20.0/24",
      "internet": false,
      "native": "internal"
    },
    {
      "name": "access",
      "cidr": "10.30.99.0/24",
      "internet": true,
      "native": "access"
    }
  ],
  "machines": [
    {
      "name": "gateway",
      "role": "member",
      "os": "debian-12",
      "arch": "amd64",
      "resources": {
        "cpus": 1,
        "memory_mb": 1024
      },
      "addresses": {
        "dmz": "10.30.10.10",
        "internal": "10.30.20.10"
      },
      "ports": [
        {
          "name": "web",
          "port": 80,
          "protocol": "tcp",
          "http": false
        },
        {
          "name": "ssh",
          "port": 22,
          "protocol": "tcp",
          "http": false
        }
      ]
    },
    {
      "name": "app",
      "role": "member",
      "os": "debian-12",
      "arch": "amd64",
      "resources": {
        "cpus": 1,
        "memory_mb": 1024
      },
      "addresses": {
        "internal": "10.30.20.20"
      },
      "ports": [
        {
          "name": "api",
          "port": 8080,
          "protocol": "tcp",
          "http": false
        }
      ]
    },
    {
      "name": "db",
      "role": "member",
      "os": "debian-12",
      "arch": "amd64",
      "resources": {
        "cpus": 1,
        "memory_mb": 1024
      },
      "addresses": {
        "internal": "10.30.20.30"
      },
      "ports": [
        {
          "name": "postgres",
          "port": 5432,
          "protocol": "tcp",
          "http": false
        }
      ]
    },
    {
      "name": "user",
      "role": "access",
      "os": "debian-12",
      "arch": "amd64",
      "resources": {
        "cpus": 1,
        "memory_mb": 1024
      },
      "addresses": {
        "access": "10.30.99.10"
      }
    }
  ],
  "lifecycle": {
    "up": [
      {
        "id": "clear-lock",
        "action": "terraform.clear_lock"
      },
      {
        "id": "init",
        "note": "Preparing Terraform and its providers…",
        "argv": [
          "terraform",
          "init",
          "-input=false",
          "-no-color",
          "-backend-config=path=${run.state_dir}/terraform.tfstate"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 900
      },
      {
        "id": "apply",
        "note": "Creating the lab's machines in the cloud…",
        "argv": [
          "terraform",
          "apply",
          "-auto-approve",
          "-input=false",
          "-no-color"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 3600
      },
      {
        "id": "archive",
        "note": "Archiving the project…",
        "action": "project.archive",
        "with": {
          "root": "../../.."
        }
      },
      {
        "id": "deliver-gateway",
        "note": "Copying the project into gateway…",
        "action": "ssh.run",
        "with": {
          "command": "sudo sh -c 'mkdir -p /opt/isoloom /var/lib/isoloom && tar -xzf - -C /opt/isoloom && touch /var/lib/isoloom/project-delivered'",
          "host": "${outputs.address_gateway}",
          "user": "admin",
          "wait_s": "900"
        },
        "stdin": "${run.state_dir}/project.tgz",
        "timeout_s": 1500
      },
      {
        "id": "deliver-app",
        "note": "Copying the project into app…",
        "action": "ssh.run",
        "with": {
          "command": "sudo sh -c 'mkdir -p /opt/isoloom /var/lib/isoloom && tar -xzf - -C /opt/isoloom && touch /var/lib/isoloom/project-delivered'",
          "host": "${outputs.address_app}",
          "user": "admin",
          "wait_s": "900"
        },
        "stdin": "${run.state_dir}/project.tgz",
        "timeout_s": 1500
      },
      {
        "id": "deliver-db",
        "note": "Copying the project into db…",
        "action": "ssh.run",
        "with": {
          "command": "sudo sh -c 'mkdir -p /opt/isoloom /var/lib/isoloom && tar -xzf - -C /opt/isoloom && touch /var/lib/isoloom/project-delivered'",
          "host": "${outputs.address_db}",
          "user": "admin",
          "wait_s": "900"
        },
        "stdin": "${run.state_dir}/project.tgz",
        "timeout_s": 1500
      },
      {
        "id": "deliver-user",
        "note": "Copying the project into user…",
        "action": "ssh.run",
        "with": {
          "command": "sudo sh -c 'mkdir -p /opt/isoloom /var/lib/isoloom && tar -xzf - -C /opt/isoloom && touch /var/lib/isoloom/project-delivered'",
          "host": "${outputs.address_user}",
          "user": "admin",
          "wait_s": "900"
        },
        "stdin": "${run.state_dir}/project.tgz",
        "timeout_s": 1500
      }
    ],
    "down": [
      {
        "id": "clear-lock",
        "action": "terraform.clear_lock"
      },
      {
        "id": "init",
        "note": "Preparing Terraform and its providers…",
        "argv": [
          "terraform",
          "init",
          "-input=false",
          "-no-color",
          "-backend-config=path=${run.state_dir}/terraform.tfstate"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 900
      },
      {
        "id": "destroy",
        "note": "Removing the lab from the cloud…",
        "argv": [
          "terraform",
          "destroy",
          "-auto-approve",
          "-input=false",
          "-no-color"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 3600
      }
    ],
    "seal": {
      "param": "isoloom_sealed",
      "steps": [
        {
          "id": "seal",
          "note": "Closing the internet to the networks without it…",
          "argv": [
            "terraform",
            "apply",
            "-auto-approve",
            "-input=false",
            "-no-color"
          ],
          "env": {
            "TF_DATA_DIR": "${run.state_dir}/.terraform",
            "TF_INPUT": "0",
            "TF_IN_AUTOMATION": "1",
            "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
          },
          "timeout_s": 3600
        }
      ]
    },
    "status": {
      "id": "state",
      "action": "terraform.read_state"
    }
  },
  "ready": [
    {
      "kind": "step_ok",
      "step": "apply",
      "means": "the machines exist and booted; each sets itself up from its user data once the project is in"
    },
    {
      "kind": "ready_file",
      "host": "${outputs.address_gateway}",
      "user": "admin",
      "path": "${outputs.ready_file}",
      "log": "/var/log/isoloom-setup.log",
      "grammar": "isoloom-ready/1",
      "timeout_s": 2400,
      "unreachable_timeout_s": 600,
      "interval_s": 10
    },
    {
      "kind": "ready_file",
      "host": "${outputs.address_app}",
      "user": "admin",
      "path": "${outputs.ready_file}",
      "log": "/var/log/isoloom-setup.log",
      "grammar": "isoloom-ready/1",
      "timeout_s": 2400,
      "unreachable_timeout_s": 600,
      "interval_s": 10
    },
    {
      "kind": "ready_file",
      "host": "${outputs.address_db}",
      "user": "admin",
      "path": "${outputs.ready_file}",
      "log": "/var/log/isoloom-setup.log",
      "grammar": "isoloom-ready/1",
      "timeout_s": 2400,
      "unreachable_timeout_s": 600,
      "interval_s": 10
    },
    {
      "kind": "ready_file",
      "host": "${outputs.address_user}",
      "user": "admin",
      "path": "${outputs.ready_file}",
      "log": "/var/log/isoloom-setup.log",
      "grammar": "isoloom-ready/1",
      "timeout_s": 2400,
      "unreachable_timeout_s": 600,
      "interval_s": 10
    }
  ],
  "outputs": [
    {
      "name": "ip",
      "description": "Where to stand: the access machine's public address (the first Linux machine's, else the controller's).",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ip"
      }
    },
    {
      "name": "ready_file",
      "description": "Where each Linux machine's set-up says how far it got (isoloom-ready/1).",
      "role": "info",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ready_file"
      }
    },
    {
      "name": "address_gateway",
      "description": "gateway's public address: the runner's SSH and its published ports reach it there.",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "address_gateway"
      }
    },
    {
      "name": "ssh_user_gateway",
      "description": "The user the runner's key lets in on gateway.",
      "role": "info",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ssh_user_gateway"
      }
    },
    {
      "name": "address_app",
      "description": "app's public address: the runner's SSH and its published ports reach it there.",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "address_app"
      }
    },
    {
      "name": "ssh_user_app",
      "description": "The user the runner's key lets in on app.",
      "role": "info",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ssh_user_app"
      }
    },
    {
      "name": "address_db",
      "description": "db's public address: the runner's SSH and its published ports reach it there.",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "address_db"
      }
    },
    {
      "name": "ssh_user_db",
      "description": "The user the runner's key lets in on db.",
      "role": "info",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ssh_user_db"
      }
    },
    {
      "name": "address_user",
      "description": "user's public address: the runner's SSH and its published ports reach it there.",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "address_user"
      }
    },
    {
      "name": "ssh_user_user",
      "description": "The user the runner's key lets in on user.",
      "role": "info",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ssh_user_user"
      }
    }
  ],
  "checks": {
    "protocol": "isoloom-check/1",
    "setup": [],
    "runners": [
      {
        "id": "user",
        "from": "from user",
        "checks": [
          {
            "name": "checks/dmz-reachable.sh",
            "kind": "script",
            "wait_s": 0,
            "derived": false
          },
          {
            "name": "checks/internal-not-reachable-from-access.sh",
            "kind": "script",
            "wait_s": 0,
            "derived": false
          },
          {
            "name": "gateway:80 on dmz from user",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "gateway:22 on dmz from user",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "app:8080 blocked from user",
            "kind": "tcp",
            "wait_s": 0,
            "derived": true
          },
          {
            "name": "db:5432 blocked from user",
            "kind": "tcp",
            "wait_s": 0,
            "derived": true
          }
        ],
        "step": {
          "id": "check-user",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} sh .isoloom/cloud-vm/checks/user.sh",
            "host": "${outputs.address_user}",
            "user": "admin"
          },
          "timeout_s": 210
        }
      },
      {
        "id": "gateway",
        "from": "from gateway",
        "checks": [
          {
            "name": "app:8080 from gateway",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "db:5432 from gateway",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          }
        ],
        "step": {
          "id": "check-gateway",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} sh .isoloom/cloud-vm/checks/gateway.sh",
            "host": "${outputs.address_gateway}",
            "user": "admin"
          },
          "timeout_s": 150
        }
      },
      {
        "id": "app",
        "from": "from app",
        "checks": [
          {
            "name": "gateway:80 on internal from app",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "gateway:22 on internal from app",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "db:5432 from app",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "no internet from app",
            "kind": "http",
            "wait_s": 0,
            "derived": true
          }
        ],
        "step": {
          "id": "check-app",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} sh .isoloom/cloud-vm/checks/app.sh",
            "host": "${outputs.address_app}",
            "user": "admin"
          },
          "timeout_s": 210
        }
      },
      {
        "id": "db",
        "from": "from db",
        "checks": [
          {
            "name": "gateway:80 on internal from db",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "gateway:22 on internal from db",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "app:8080 from db",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "no internet from db",
            "kind": "http",
            "wait_s": 0,
            "derived": true
          }
        ],
        "step": {
          "id": "check-db",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} sh .isoloom/cloud-vm/checks/db.sh",
            "host": "${outputs.address_db}",
            "user": "admin"
          },
          "timeout_s": 210
        }
      }
    ],
    "teardown": []
  },
  "recovery": {
    "retries": 0,
    "apply_retries": 1
  },
  "expiry": {
    "tf_var": "expires_at",
    "unit": "unix_seconds",
    "default_minutes": 240
  }
}

## .isoloom/cloud-vm/azure/main.tf
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  terraform -chdir=.isoloom/cloud-vm/azure init && terraform -chdir=.isoloom/cloud-vm/azure apply \
#           -var allowed_cidr=<your IP>/32 -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)"
# Stop:   terraform -chdir=.isoloom/cloud-vm/azure destroy (same variables)
# Then:   the machines wait for the project: run the lab through the runner (run.json) beside this file,
#         which delivers the project over SSH, waits for each set-up and runs the checks.

terraform {
  required_version = ">= 1.6.0"
  backend "local" {}
  required_providers {
    azurerm = { source = "hashicorp/azurerm", version = "~> 5.8.0" }
  }
}

variable "subscription_id" {
  type        = string
  default     = null
  description = "Default: ARM_SUBSCRIPTION_ID from the environment"
}

variable "region" {
  type    = string
  default = "swedencentral"
}

variable "isoloom_sealed" {
  type        = bool
  default     = false
  description = "Close the internet to the machines of every `internet: false` network, at the network: the runner sets it once the machines are set up"
}

variable "allowed_cidr" {
  type        = string
  description = "Who may reach the machines (SSH and the published ports), e.g. your IP/32"
}

variable "ssh_public_key" {
  type        = string
  description = "The SSH public key the machines let in: whoever holds its private key signs in, as the runner (run.json) does to deliver the project and run the checks"
}

variable "expires_at" {
  type        = string
  default     = ""
  description = "When the environment should end, in Unix seconds (empty: no end): a tag on every resource, so a reaper finds what to destroy, and the time the machines shut themselves down"
}

provider "azurerm" {
  features {}
  subscription_id = var.subscription_id
}

resource "terraform_data" "id" {
  input = substr(replace(uuid(), "-", ""), 0, 8)
  lifecycle {
    ignore_changes = [input]
  }
}

locals {
  name = "isoloom-dmz-jump-${terraform_data.id.output}"
  tags = {
    isoloom-environment = "dmz-jump"
    managed-by          = "isoloom"
    isoloom-instance    = local.name
    isoloom-expires-at  = var.expires_at
  }
}

resource "azurerm_resource_group" "env" {
  name     = local.name
  location = var.region
  tags     = local.tags
}

# The environment's networks: one virtual network, a subnet per network with its exact range.
resource "azurerm_virtual_network" "env" {
  name                = local.name
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  address_space       = ["10.30.10.0/24", "10.30.20.0/24", "10.30.99.0/24"]
}

resource "azurerm_subnet" "dmz" {
  name                            = "dmz"
  resource_group_name             = azurerm_resource_group.env.name
  virtual_network_name            = azurerm_virtual_network.env.name
  address_prefixes                = ["10.30.10.0/24"]
  default_outbound_access_enabled = true
}

resource "azurerm_subnet" "internal" {
  name                            = "internal"
  resource_group_name             = azurerm_resource_group.env.name
  virtual_network_name            = azurerm_virtual_network.env.name
  address_prefixes                = ["10.30.20.0/24"]
  default_outbound_access_enabled = false
}

resource "azurerm_subnet" "access" {
  name                            = "access"
  resource_group_name             = azurerm_resource_group.env.name
  virtual_network_name            = azurerm_virtual_network.env.name
  address_prefixes                = ["10.30.99.0/24"]
  default_outbound_access_enabled = true
}

# Machine `gateway`: what may reach it.
resource "azurerm_network_security_group" "gateway" {
  name                = "${local.name}-gateway"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  security_rule {
    name                       = "net-dmz"
    priority                   = 100
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "10.30.10.0/24"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "net-internal"
    priority                   = 110
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "10.30.20.0/24"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "ssh"
    priority                   = 120
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_range     = "22"
    source_address_prefix      = var.allowed_cidr
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "reach-0-access"
    priority                   = 130
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "10.30.99.0/24"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "deny-rest-of-vnet"
    priority                   = 4000
    direction                  = "Inbound"
    access                     = "Deny"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "VirtualNetwork"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "outbound"
    priority                   = 100
    direction                  = "Outbound"
    access                     = "Allow"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "*"
    destination_address_prefix = "*"
  }
}

resource "azurerm_public_ip" "gateway" {
  name                = "${local.name}-gateway"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  allocation_method   = "Static"
  sku                 = "Standard"
}

resource "azurerm_network_interface" "gateway_dmz" {
  name                  = "${local.name}-gateway-dmz"
  resource_group_name   = azurerm_resource_group.env.name
  location              = var.region
  tags                  = local.tags
  ip_forwarding_enabled = true
  ip_configuration {
    name                          = "primary"
    subnet_id                     = azurerm_subnet.dmz.id
    private_ip_address_allocation = "Static"
    private_ip_address            = "10.30.10.10"
    public_ip_address_id          = azurerm_public_ip.gateway.id
  }
}

resource "azurerm_network_interface_security_group_association" "gateway_dmz" {
  network_interface_id      = azurerm_network_interface.gateway_dmz.id
  network_security_group_id = azurerm_network_security_group.gateway.id
}

resource "azurerm_network_interface" "gateway_internal" {
  name                  = "${local.name}-gateway-internal"
  resource_group_name   = azurerm_resource_group.env.name
  location              = var.region
  tags                  = local.tags
  ip_forwarding_enabled = true
  ip_configuration {
    name                          = "primary"
    subnet_id                     = azurerm_subnet.internal.id
    private_ip_address_allocation = "Static"
    private_ip_address            = "10.30.20.10"
  }
}

resource "azurerm_network_interface_security_group_association" "gateway_internal" {
  network_interface_id      = azurerm_network_interface.gateway_internal.id
  network_security_group_id = azurerm_network_security_group.gateway.id
}

resource "azurerm_linux_virtual_machine" "gateway" {
  name                  = "${local.name}-gateway"
  resource_group_name   = azurerm_resource_group.env.name
  location              = var.region
  tags                  = local.tags
  size                  = "Standard_B2ts_v2"
  admin_username        = "isoloom"
  network_interface_ids = [azurerm_network_interface.gateway_dmz.id, azurerm_network_interface.gateway_internal.id]
  custom_data           = base64encode("#!/bin/sh\n# Isoloom: this machine sets itself up. Its progress is in /var/lib/isoloom/ready (isoloom-ready/1), its output in /var/log/isoloom-setup.log. The project comes over SSH from the runner (run.json).\nmkdir -p /var/lib/isoloom\nrm -f /var/lib/isoloom/setup.sh.new\n(umask 077 && cat > /var/lib/isoloom/setup.sh.new) <<'ISOLOOM_SETUP'\n#!/bin/sh\numask 022\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\nstate=$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\npart=$(cat /var/lib/isoloom/part 2>/dev/null || echo 1)\nif [ \"$state\" = ready ] || [ \"$part\" != 1 ]; then\nIF=$(ip -o link | grep -i \"${lower(replace(azurerm_network_interface.gateway_internal.mac_address, "-", ":"))}\" | awk -F': ' '{print $2}'); sudo ip link set \"$IF\" up && (ip -4 addr show \"$IF\" | grep -q 10.30.20.10/ || sudo ip addr add 10.30.20.10/24 dev \"$IF\")\nfi\ncase \"$state\" in ready|failed:*) exit 0 ;; esac\nif [ \"$part\" = 1 ]; then\necho 'running: its host name' > /var/lib/isoloom/ready; { hostnamectl set-hostname gateway 2>/dev/null || hostname gateway; grep -q ' gateway$' /etc/hosts || echo '127.0.1.1 gateway' >> /etc/hosts; [ ! -d /etc/cloud/cloud.cfg.d ] || echo 'preserve_hostname: true' > /etc/cloud/cloud.cfg.d/99-isoloom-hostname.cfg; } || { echo 'failed: its host name' > /var/lib/isoloom/ready; exit 1; }\necho 'running: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; { i=0; until [ -f /var/lib/isoloom/project-delivered ]; do [ \"$i\" -gt 0 ] || echo 'waiting for the project, which the runner (run.json) delivers over SSH'; i=$((i+5)); if [ \"$i\" -gt 2400 ]; then echo 'the project never came: start the lab through the runner (run.json), which delivers it over SSH' >&2; exit 1; fi; sleep 5; done; } || { echo 'failed: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; exit 1; }\necho 'running: the machine'\\''s interfaces' > /var/lib/isoloom/ready; { IF=$(ip -o link | grep -i \"${lower(replace(azurerm_network_interface.gateway_internal.mac_address, "-", ":"))}\" | awk -F': ' '{print $2}'); sudo ip link set \"$IF\" up && (ip -4 addr show \"$IF\" | grep -q 10.30.20.10/ || sudo ip addr add 10.30.20.10/24 dev \"$IF\"); } || { echo 'failed: the machine'\\''s interfaces' > /var/lib/isoloom/ready; exit 1; }\necho 'running: hosts file' > /var/lib/isoloom/ready; { sh -c 'printf '\\''%s\\n'\\'' '\\''10.30.10.10 gateway'\\'' '\\''10.30.20.20 app'\\'' '\\''10.30.20.30 db'\\'' '\\''10.30.99.10 user'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'; } || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }\necho 'running: provision/gateway.yml' > /var/lib/isoloom/ready; { sh -c 'pkg() { if command -v apt-get >/dev/null; then apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \"$@\"; elif command -v dnf >/dev/null; then dnf install -y -q \"$@\"; else yum install -y -q \"$@\"; fi; }\ncommand -v ansible-playbook >/dev/null || pkg ansible-core\ncd /opt/isoloom && sh -c '\\''ansible-playbook -c local -i gateway, provision/gateway.yml'\\'''; } || { echo 'failed: provision/gateway.yml' > /var/lib/isoloom/ready; exit 1; }\necho 'running: health check' > /var/lib/isoloom/ready; { sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'; } || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }\nfi\necho ready > /var/lib/isoloom/ready\nrm -f /var/lib/isoloom/part\nexit 0\nISOLOOM_SETUP\nmv -f /var/lib/isoloom/setup.sh.new /var/lib/isoloom/setup.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-setup.service <<'ISOLOOM_UNIT'\n[Unit]\nDescription=Isoloom: the machine's set-up\nWants=network-online.target\nAfter=network-online.target cloud-final.service google-startup-scripts.service\n\n[Service]\nType=oneshot\nExecStart=/bin/sh /var/lib/isoloom/setup.sh\nStandardOutput=append:/var/log/isoloom-setup.log\nStandardError=append:/var/log/isoloom-setup.log\nTimeoutStartSec=0\n\n[Install]\nWantedBy=multi-user.target\nISOLOOM_UNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-setup.service >/dev/null 2>&1\nsystemctl start --no-block isoloom-setup.service\nelse\nnohup sh /var/lib/isoloom/setup.sh >> /var/log/isoloom-setup.log 2>&1 &\nfi\n")
  admin_ssh_key {
    username   = "isoloom"
    public_key = var.ssh_public_key
  }
  os_disk {
    caching              = "ReadWrite"
    storage_account_type = "StandardSSD_LRS"
    disk_size_gb         = 30
  }
  source_image_reference {
    publisher = "Debian"
    offer     = "debian-12"
    sku       = "12-gen2"
    version   = "latest"
  }
  lifecycle {
    ignore_changes = [custom_data]
  }
}

# Machine `app`: what may reach it.
resource "azurerm_network_security_group" "app" {
  name                = "${local.name}-app"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  security_rule {
    name                       = "net-internal"
    priority                   = 100
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "10.30.20.0/24"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "ssh"
    priority                   = 110
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_range     = "22"
    source_address_prefix      = var.allowed_cidr
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "reach-0-dmz-8080-tcp"
    priority                   = 120
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_range     = "8080"
    source_address_prefix      = "10.30.10.0/24"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "reach-0-dmz-8080-udp"
    priority                   = 130
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Udp"
    source_port_range          = "*"
    destination_port_range     = "8080"
    source_address_prefix      = "10.30.10.0/24"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "reach-0-dmz-5432-tcp"
    priority                   = 140
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_range     = "5432"
    source_address_prefix      = "10.30.10.0/24"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "reach-0-dmz-5432-udp"
    priority                   = 150
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Udp"
    source_port_range          = "*"
    destination_port_range     = "5432"
    source_address_prefix      = "10.30.10.0/24"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "deny-rest-of-vnet"
    priority                   = 4000
    direction                  = "Inbound"
    access                     = "Deny"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "VirtualNetwork"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "outbound"
    priority                   = 100
    direction                  = "Outbound"
    access                     = var.isoloom_sealed ? "Deny" : "Allow"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "*"
    destination_address_prefix = var.isoloom_sealed ? "Internet" : "*"
  }
}

