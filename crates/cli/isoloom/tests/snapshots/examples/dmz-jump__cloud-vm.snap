if _tcp '10.30.20.20' 8080; then fail 'app:8080 blocked from user' "10.30.20.20:8080 answered; it should be blocked"; else pass 'app:8080 blocked from user'; fi
fi

if [ "${ISOLOOM_DERIVED:-1}" != 0 ]; then
if _tcp '10.30.20.30' 5432; then fail 'db:5432 blocked from user' "10.30.20.30:5432 answered; it should be blocked"; else pass 'db:5432 blocked from user'; fi
fi

echo "isoloom-check: END $passed passed, $failed failed"
[ "$failed" -eq 0 ]

## .isoloom/cloud-vm/gcp/main.tf
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  terraform -chdir=.isoloom/cloud-vm/gcp init && terraform -chdir=.isoloom/cloud-vm/gcp apply \
#           -var billing_account=<id> -var allowed_cidr=<your IP>/32 -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)"
# Stop:   terraform -chdir=.isoloom/cloud-vm/gcp destroy (same variables)
# Then:   the machines wait for the project: run the lab through the runner (run.json) beside this file,
#         which delivers the project over SSH, waits for each set-up and runs the checks.

terraform {
  required_version = ">= 1.6.0"
  backend "local" {}
  required_providers {
    google = { source = "hashicorp/google", version = "~> 8.5.0" }
  }
}

variable "project" {
  type        = string
  default     = ""
  description = "An existing project; or leave empty and give billing_account for a project of its own"
}

variable "billing_account" {
  type        = string
  default     = ""
  description = "With no project: create one for this environment, billed here, deleted with it"
}

variable "org_id" {
  type    = string
  default = ""
}

variable "region" {
  type    = string
  default = "europe-west9"
}

variable "isoloom_sealed" {
  type        = bool
  default     = false
  description = "Close the internet to the machines of every `internet: false` network, at the network: the runner sets it once the machines are set up"
}

variable "allowed_cidr" {
  type        = string
  description = "Who may reach the machines (SSH and the published ports), e.g. your IP/32"
}

variable "ssh_public_key" {
  type        = string
  description = "The SSH public key the machines let in: whoever holds its private key signs in, as the runner (run.json) does to deliver the project and run the checks"
}

variable "expires_at" {
  type        = string
  default     = ""
  description = "When the environment should end, in Unix seconds (empty: no end): a tag on every resource, so a reaper finds what to destroy, and the time the machines shut themselves down"
}

provider "google" {
  region = var.region
}

# A project of its own when none is given: everything goes when the environment is destroyed.
resource "google_project" "env" {
  count               = var.project == "" ? 1 : 0
  name                = "isoloom-dmz-jump"
  project_id          = "isoloom-${terraform_data.id.output}"
  billing_account     = var.billing_account
  org_id              = var.org_id == "" ? null : var.org_id
  deletion_policy     = "DELETE"
  auto_create_network = false
  labels = {
    isoloom-environment = "dmz-jump"
    managed-by          = "isoloom"
    isoloom-instance    = local.name
    isoloom-expires-at  = var.expires_at
  }
}

resource "google_project_service" "compute" {
  count              = var.project == "" ? 1 : 0
  project            = google_project.env[0].project_id
  service            = "compute.googleapis.com"
  disable_on_destroy = false
}

resource "terraform_data" "id" {
  input = substr(replace(uuid(), "-", ""), 0, 8)
  lifecycle {
    ignore_changes = [input]
  }
}

locals {
  name    = "isoloom-dmz-jump-${terraform_data.id.output}"
  project = var.project != "" ? var.project : google_project_service.compute[0].project
  zone    = "${var.region}-a"
}

# The environment's networks: a VPC network each, holding a subnetwork with its exact range.
resource "google_compute_network" "dmz" {
  project                 = local.project
  name                    = "${local.name}-dmz"
  auto_create_subnetworks = false
  mtu                     = 1500
}

resource "google_compute_subnetwork" "dmz" {
  project       = local.project
  name          = "${local.name}-dmz"
  network       = google_compute_network.dmz.id
  ip_cidr_range = "10.30.10.0/24"
  region        = var.region
}

resource "google_compute_network" "internal" {
  project                 = local.project
  name                    = "${local.name}-internal"
  auto_create_subnetworks = false
  mtu                     = 1500
}

resource "google_compute_subnetwork" "internal" {
  project       = local.project
  name          = "${local.name}-internal"
  network       = google_compute_network.internal.id
  ip_cidr_range = "10.30.20.0/24"
  region        = var.region
}

resource "google_compute_network" "access" {
  project                 = local.project
  name                    = "${local.name}-access"
  auto_create_subnetworks = false
  mtu                     = 1500
}

resource "google_compute_subnetwork" "access" {
  project       = local.project
  name          = "${local.name}-access"
  network       = google_compute_network.access.id
  ip_cidr_range = "10.30.99.0/24"
  region        = var.region
}

resource "google_compute_network_peering" "dmz_internal" {
  name                 = "${local.name}-dmz-internal"
  network              = google_compute_network.dmz.self_link
  peer_network         = google_compute_network.internal.self_link
  export_custom_routes = true
  import_custom_routes = true
}

resource "google_compute_network_peering" "internal_dmz" {
  name                 = "${local.name}-internal-dmz"
  network              = google_compute_network.internal.self_link
  peer_network         = google_compute_network.dmz.self_link
  export_custom_routes = true
  import_custom_routes = true
  depends_on           = [google_compute_network_peering.dmz_internal]
}

resource "google_compute_network_peering" "dmz_access" {
  name                 = "${local.name}-dmz-access"
  network              = google_compute_network.dmz.self_link
  peer_network         = google_compute_network.access.self_link
  export_custom_routes = true
  import_custom_routes = true
  depends_on           = [google_compute_network_peering.internal_dmz]
}

resource "google_compute_network_peering" "access_dmz" {
  name                 = "${local.name}-access-dmz"
  network              = google_compute_network.access.self_link
  peer_network         = google_compute_network.dmz.self_link
  export_custom_routes = true
  import_custom_routes = true
  depends_on           = [google_compute_network_peering.dmz_access]
}

resource "google_compute_network_peering" "internal_access" {
  name                 = "${local.name}-internal-access"
  network              = google_compute_network.internal.self_link
  peer_network         = google_compute_network.access.self_link
  export_custom_routes = true
  import_custom_routes = true
  depends_on           = [google_compute_network_peering.access_dmz]
}

resource "google_compute_network_peering" "access_internal" {
  name                 = "${local.name}-access-internal"
  network              = google_compute_network.access.self_link
  peer_network         = google_compute_network.internal.self_link
  export_custom_routes = true
  import_custom_routes = true
  depends_on           = [google_compute_network_peering.internal_access]
}

# Machine `gateway`: what may reach it.
resource "google_compute_firewall" "gateway_net_dmz" {
  project       = local.project
  name          = "${local.name}-gateway-net-dmz"
  network       = google_compute_network.dmz.id
  direction     = "INGRESS"
  source_ranges = ["10.30.10.0/24"]
  target_tags   = ["${local.name}-gateway"]
  allow {
    protocol = "all"
  }
}

resource "google_compute_firewall" "gateway_net_internal" {
  project       = local.project
  name          = "${local.name}-gateway-net-internal"
  network       = google_compute_network.internal.id
  direction     = "INGRESS"
  source_ranges = ["10.30.20.0/24"]
  target_tags   = ["${local.name}-gateway"]
  allow {
    protocol = "all"
  }
}

resource "google_compute_firewall" "gateway_ssh" {
  project       = local.project
  name          = "${local.name}-gateway-ssh"
  network       = google_compute_network.dmz.id
  direction     = "INGRESS"
  source_ranges = [var.allowed_cidr]
  target_tags   = ["${local.name}-gateway"]
  allow {
    protocol = "tcp"
    ports    = ["22"]
  }
}

resource "google_compute_firewall" "gateway_reach_access" {
  project       = local.project
  name          = "${local.name}-gateway-reach-access"
  network       = google_compute_network.dmz.id
  direction     = "INGRESS"
  source_ranges = ["10.30.99.0/24"]
  target_tags   = ["${local.name}-gateway"]
  allow {
    protocol = "all"
  }
}

resource "google_compute_instance" "gateway" {
  project      = local.project
  name         = "${local.name}-gateway"
  machine_type = "e2-small"
  zone         = local.zone
  tags         = ["${local.name}-gateway"]
  boot_disk {
    initialize_params {
      image = "debian-cloud/debian-12"
      labels = {
        isoloom-environment = "dmz-jump"
        managed-by          = "isoloom"
        isoloom-instance    = local.name
        isoloom-expires-at  = var.expires_at
      }
      size = 20
    }
  }
  network_interface {
    subnetwork = google_compute_subnetwork.dmz.id
    network_ip = "10.30.10.10"
    access_config {}
  }
  network_interface {
    subnetwork = google_compute_subnetwork.internal.id
    network_ip = "10.30.20.10"
  }
  metadata                = { ssh-keys = "admin:${var.ssh_public_key}" }
  metadata_startup_script = "#!/bin/sh\n# Isoloom: this machine sets itself up. Its progress is in /var/lib/isoloom/ready (isoloom-ready/1), its output in /var/log/isoloom-setup.log. The project comes over SSH from the runner (run.json).\nmkdir -p /var/lib/isoloom\nrm -f /var/lib/isoloom/setup.sh.new\n(umask 077 && cat > /var/lib/isoloom/setup.sh.new) <<'ISOLOOM_SETUP'\n#!/bin/sh\numask 022\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\nstate=$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\npart=$(cat /var/lib/isoloom/part 2>/dev/null || echo 1)\nif [ \"$state\" = ready ] || [ \"$part\" != 1 ]; then\nIF=$(ip -o link | grep -i \"${"42:01:0a:1e:14:0a"}\" | awk -F': ' '{print $2}'); sudo ip link set \"$IF\" up && (ip -4 addr show \"$IF\" | grep -q 10.30.20.10/ || sudo ip addr add 10.30.20.10/24 dev \"$IF\")\nfi\ncase \"$state\" in ready|failed:*) exit 0 ;; esac\nif [ \"$part\" = 1 ]; then\necho 'running: its host name' > /var/lib/isoloom/ready; { hostnamectl set-hostname gateway 2>/dev/null || hostname gateway; grep -q ' gateway$' /etc/hosts || echo '127.0.1.1 gateway' >> /etc/hosts; [ ! -d /etc/cloud/cloud.cfg.d ] || echo 'preserve_hostname: true' > /etc/cloud/cloud.cfg.d/99-isoloom-hostname.cfg; } || { echo 'failed: its host name' > /var/lib/isoloom/ready; exit 1; }\necho 'running: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; { i=0; until [ -f /var/lib/isoloom/project-delivered ]; do [ \"$i\" -gt 0 ] || echo 'waiting for the project, which the runner (run.json) delivers over SSH'; i=$((i+5)); if [ \"$i\" -gt 2400 ]; then echo 'the project never came: start the lab through the runner (run.json), which delivers it over SSH' >&2; exit 1; fi; sleep 5; done; } || { echo 'failed: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; exit 1; }\necho 'running: the machine'\\''s interfaces' > /var/lib/isoloom/ready; { IF=$(ip -o link | grep -i \"${"42:01:0a:1e:14:0a"}\" | awk -F': ' '{print $2}'); sudo ip link set \"$IF\" up && (ip -4 addr show \"$IF\" | grep -q 10.30.20.10/ || sudo ip addr add 10.30.20.10/24 dev \"$IF\"); } || { echo 'failed: the machine'\\''s interfaces' > /var/lib/isoloom/ready; exit 1; }\necho 'running: hosts file' > /var/lib/isoloom/ready; { sh -c 'printf '\\''%s\\n'\\'' '\\''10.30.10.10 gateway'\\'' '\\''10.30.20.20 app'\\'' '\\''10.30.20.30 db'\\'' '\\''10.30.99.10 user'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'; } || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }\necho 'running: provision/gateway.yml' > /var/lib/isoloom/ready; { sh -c 'pkg() { if command -v apt-get >/dev/null; then apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \"$@\"; elif command -v dnf >/dev/null; then dnf install -y -q \"$@\"; else yum install -y -q \"$@\"; fi; }\ncommand -v ansible-playbook >/dev/null || pkg ansible-core\ncd /opt/isoloom && sh -c '\\''ansible-playbook -c local -i gateway, provision/gateway.yml'\\'''; } || { echo 'failed: provision/gateway.yml' > /var/lib/isoloom/ready; exit 1; }\necho 'running: health check' > /var/lib/isoloom/ready; { sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'; } || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }\nfi\necho ready > /var/lib/isoloom/ready\nrm -f /var/lib/isoloom/part\nexit 0\nISOLOOM_SETUP\nmv -f /var/lib/isoloom/setup.sh.new /var/lib/isoloom/setup.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-setup.service <<'ISOLOOM_UNIT'\n[Unit]\nDescription=Isoloom: the machine's set-up\nWants=network-online.target\nAfter=network-online.target cloud-final.service google-startup-scripts.service\n\n[Service]\nType=oneshot\nExecStart=/bin/sh /var/lib/isoloom/setup.sh\nStandardOutput=append:/var/log/isoloom-setup.log\nStandardError=append:/var/log/isoloom-setup.log\nTimeoutStartSec=0\n\n[Install]\nWantedBy=multi-user.target\nISOLOOM_UNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-setup.service >/dev/null 2>&1\nsystemctl start --no-block isoloom-setup.service\nelse\nnohup sh /var/lib/isoloom/setup.sh >> /var/log/isoloom-setup.log 2>&1 &\nfi\n"
  labels = {
    isoloom-environment = "dmz-jump"
    managed-by          = "isoloom"
    isoloom-instance    = local.name
    isoloom-expires-at  = var.expires_at
  }
  lifecycle {
    ignore_changes = [metadata_startup_script]
  }
  can_ip_forward = true
}

# Machine `app`: what may reach it.
resource "google_compute_firewall" "app_net_internal" {
  project       = local.project
  name          = "${local.name}-app-net-internal"
  network       = google_compute_network.internal.id
  direction     = "INGRESS"
  source_ranges = ["10.30.20.0/24"]
  target_tags   = ["${local.name}-app"]
  allow {
    protocol = "all"
  }
}

resource "google_compute_firewall" "app_ssh" {
  project       = local.project
  name          = "${local.name}-app-ssh"
  network       = google_compute_network.internal.id
  direction     = "INGRESS"
  source_ranges = [var.allowed_cidr]
  target_tags   = ["${local.name}-app"]
  allow {
    protocol = "tcp"
    ports    = ["22"]
  }
}

resource "google_compute_firewall" "app_reach_dmz" {
  project       = local.project
  name          = "${local.name}-app-reach-dmz"
  network       = google_compute_network.internal.id
  direction     = "INGRESS"
  source_ranges = ["10.30.10.0/24"]
  target_tags   = ["${local.name}-app"]
  allow {
    protocol = "tcp"
    ports    = ["8080", "5432"]
  }
  allow {
    protocol = "udp"
    ports    = ["8080", "5432"]
  }
}

resource "google_compute_firewall" "app_lab_internal" {
  count              = var.isoloom_sealed ? 1 : 0
  project            = local.project
  name               = "${local.name}-app-lab-internal"
  network            = google_compute_network.internal.id
  direction          = "EGRESS"
  priority           = 900
  destination_ranges = ["10.30.10.0/24", "10.30.20.0/24", "10.30.99.0/24"]
  target_tags        = ["${local.name}-app"]
  allow {
    protocol = "all"
  }
}

resource "google_compute_firewall" "app_sealed_internal" {
  count              = var.isoloom_sealed ? 1 : 0
  project            = local.project
  name               = "${local.name}-app-sealed-internal"
  network            = google_compute_network.internal.id
  direction          = "EGRESS"
  priority           = 1000
  destination_ranges = ["0.0.0.0/0"]
  target_tags        = ["${local.name}-app"]
  deny {
    protocol = "all"
  }
}

resource "google_compute_instance" "app" {
  project      = local.project
  name         = "${local.name}-app"
  machine_type = "e2-small"
  zone         = local.zone
  tags         = ["${local.name}-app"]
  boot_disk {
    initialize_params {
      image = "debian-cloud/debian-12"
      labels = {
        isoloom-environment = "dmz-jump"
        managed-by          = "isoloom"
        isoloom-instance    = local.name
        isoloom-expires-at  = var.expires_at
      }
      size = 20
    }
  }
  network_interface {
    subnetwork = google_compute_subnetwork.internal.id
    network_ip = "10.30.20.20"
    access_config {}
  }
  metadata                = { ssh-keys = "admin:${var.ssh_public_key}" }
  metadata_startup_script = "#!/bin/sh\n# Isoloom: this machine sets itself up. Its progress is in /var/lib/isoloom/ready (isoloom-ready/1), its output in /var/log/isoloom-setup.log. The project comes over SSH from the runner (run.json).\nmkdir -p /var/lib/isoloom\nrm -f /var/lib/isoloom/setup.sh.new\n(umask 077 && cat > /var/lib/isoloom/setup.sh.new) <<'ISOLOOM_SETUP'\n#!/bin/sh\numask 022\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\nstate=$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\npart=$(cat /var/lib/isoloom/part 2>/dev/null || echo 1)\ncase \"$state\" in ready|failed:*) exit 0 ;; esac\nif [ \"$part\" = 1 ]; then\necho 'running: its host name' > /var/lib/isoloom/ready; { hostnamectl set-hostname app 2>/dev/null || hostname app; grep -q ' app$' /etc/hosts || echo '127.0.1.1 app' >> /etc/hosts; [ ! -d /etc/cloud/cloud.cfg.d ] || echo 'preserve_hostname: true' > /etc/cloud/cloud.cfg.d/99-isoloom-hostname.cfg; } || { echo 'failed: its host name' > /var/lib/isoloom/ready; exit 1; }\necho 'running: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; { i=0; until [ -f /var/lib/isoloom/project-delivered ]; do [ \"$i\" -gt 0 ] || echo 'waiting for the project, which the runner (run.json) delivers over SSH'; i=$((i+5)); if [ \"$i\" -gt 2400 ]; then echo 'the project never came: start the lab through the runner (run.json), which delivers it over SSH' >&2; exit 1; fi; sleep 5; done; } || { echo 'failed: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; exit 1; }\necho 'running: hosts file' > /var/lib/isoloom/ready; { sh -c 'printf '\\''%s\\n'\\'' '\\''10.30.20.10 gateway'\\'' '\\''10.30.20.20 app'\\'' '\\''10.30.20.30 db'\\'' '\\''10.30.99.10 user'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'; } || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }\necho 'running: provision/app.yml' > /var/lib/isoloom/ready; { sh -c 'pkg() { if command -v apt-get >/dev/null; then apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \"$@\"; elif command -v dnf >/dev/null; then dnf install -y -q \"$@\"; else yum install -y -q \"$@\"; fi; }\ncommand -v ansible-playbook >/dev/null || pkg ansible-core\ncd /opt/isoloom && sh -c '\\''ansible-playbook -c local -i app, provision/app.yml'\\'''; } || { echo 'failed: provision/app.yml' > /var/lib/isoloom/ready; exit 1; }\necho 'running: closing the internet' > /var/lib/isoloom/ready; { sh -c 'pkg() { if command -v apt-get >/dev/null; then apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \"$@\"; elif command -v dnf >/dev/null; then dnf install -y -q \"$@\"; else yum install -y -q \"$@\"; fi; }\ncommand -v nft >/dev/null || if command -v apk >/dev/null; then apk add -q --no-cache nftables; else pkg nftables; fi\nprintf '\\''%s\\n'\\'' '\\''table inet isoloom-egress'\\'' '\\''delete table inet isoloom-egress'\\'' '\\''table inet isoloom-egress {'\\'' '\\''  chain output {'\\'' '\\''    type filter hook output priority 0; policy accept;'\\'' '\\''    oifname \"lo\" accept'\\'' '\\''    ip daddr != { 10.30.10.0/24, 10.30.20.0/24, 10.30.99.0/24 } ct state new drop'\\'' '\\''  }'\\'' '\\''}'\\'' > /etc/isoloom-egress.nft\nmkdir -p /etc/isoloom\ncat > /etc/isoloom/egress.sh <<'\\''EGRESS'\\''\n#!/bin/sh\n# No new connection leaves the isoloom networks\nnft -f /etc/isoloom-egress.nft\nexit 0\nEGRESS\nchmod +x /etc/isoloom/egress.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-egress.service <<'\\''UNIT'\\''\n[Unit]\nDescription=No new connection leaves the isoloom networks\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=-/etc/isoloom/egress.sh\n\n[Install]\nWantedBy=multi-user.target\nUNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-egress.service\nsystemctl restart isoloom-egress.service\nelse\nmkdir -p /etc/local.d && ln -sf /etc/isoloom/egress.sh /etc/local.d/isoloom-egress.start\nrc-update add local default >/dev/null 2>&1 || true\n/etc/isoloom/egress.sh || true\nfi'; } || { echo 'failed: closing the internet' > /var/lib/isoloom/ready; exit 1; }\necho 'running: health check' > /var/lib/isoloom/ready; { sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'; } || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }\nfi\necho ready > /var/lib/isoloom/ready\nrm -f /var/lib/isoloom/part\nexit 0\nISOLOOM_SETUP\nmv -f /var/lib/isoloom/setup.sh.new /var/lib/isoloom/setup.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-setup.service <<'ISOLOOM_UNIT'\n[Unit]\nDescription=Isoloom: the machine's set-up\nWants=network-online.target\nAfter=network-online.target cloud-final.service google-startup-scripts.service\n\n[Service]\nType=oneshot\nExecStart=/bin/sh /var/lib/isoloom/setup.sh\nStandardOutput=append:/var/log/isoloom-setup.log\nStandardError=append:/var/log/isoloom-setup.log\nTimeoutStartSec=0\n\n[Install]\nWantedBy=multi-user.target\nISOLOOM_UNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-setup.service >/dev/null 2>&1\nsystemctl start --no-block isoloom-setup.service\nelse\nnohup sh /var/lib/isoloom/setup.sh >> /var/log/isoloom-setup.log 2>&1 &\nfi\n"
  labels = {
    isoloom-environment = "dmz-jump"
    managed-by          = "isoloom"
    isoloom-instance    = local.name
    isoloom-expires-at  = var.expires_at
  }
  lifecycle {
    ignore_changes = [metadata_startup_script]
  }
}

