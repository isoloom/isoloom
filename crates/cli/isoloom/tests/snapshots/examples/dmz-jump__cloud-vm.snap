resource "terraform_data" "isoloom_ready_gateway" {
  triggers_replace = [aws_instance.gateway.id]
  connection {
    type        = "ssh"
    host        = aws_eip.gateway.public_ip
    user        = "admin"
    private_key = file(pathexpand(var.ssh_private_key_file))
    timeout     = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-ready_gateway.tgz\" --exclude=\"${basename(local.root)}/.isoloom*\" --exclude=\".git\" --exclude=\".terraform\" --exclude=\"*.tfstate\" --exclude=\"*.tfstate.*\" --exclude=\".terraform.tfstate.lock.info\" --exclude=\"crash.log\" --exclude=\"crash.*.log\" --exclude=\".vagrant\" -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-ready_gateway.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-outputs-gateway.tgz\" -C \"${abspath(local.root)}\" .isoloom/cloud-vm/checks"
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-outputs-gateway.tgz"
    destination = "/tmp/isoloom-outputs.tgz"
  }
  provisioner "remote-exec" {
    inline = [
      "sudo sh -c 'rm -rf /opt/isoloom && mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz && tar -xzf /tmp/isoloom-outputs.tgz -C /opt/isoloom && rm -f /tmp/isoloom-outputs.tgz && mkdir -p /var/lib/isoloom && touch /var/lib/isoloom/project-delivered'"
    ]
  }
  provisioner "remote-exec" {
    inline = [
      "sh -c 't=0\nif command -v cloud-init >/dev/null 2>&1; then sudo cloud-init status --wait >/dev/null 2>&1 || true; fi\nwhile :; do\ns=$(sudo head -n1 /var/lib/isoloom/ready 2>/dev/null)\ncase \"$s\" in\nready) echo \"gateway: set up\"; exit 0 ;;\n\"failed: \"*) echo \"gateway: its set-up stopped ($s); the end of /var/log/isoloom-setup.log:\"; sudo tail -n 40 /var/log/isoloom-setup.log 2>/dev/null; exit 1 ;;\nesac\nif [ \"$t\" -ge 2400 ]; then echo \"gateway: not set up after 2400 s ($${s:-no ready file}); the end of /var/log/isoloom-setup.log:\"; sudo tail -n 40 /var/log/isoloom-setup.log 2>/dev/null; exit 1; fi\nsleep 5; t=$((t + 5))\ndone'"
    ]
  }
}

resource "terraform_data" "isoloom_ready_app" {
  triggers_replace = [aws_instance.app.id]
  connection {
    type        = "ssh"
    host        = aws_instance.app.public_ip
    user        = "admin"
    private_key = file(pathexpand(var.ssh_private_key_file))
    timeout     = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-ready_app.tgz\" --exclude=\"${basename(local.root)}/.isoloom*\" --exclude=\".git\" --exclude=\".terraform\" --exclude=\"*.tfstate\" --exclude=\"*.tfstate.*\" --exclude=\".terraform.tfstate.lock.info\" --exclude=\"crash.log\" --exclude=\"crash.*.log\" --exclude=\".vagrant\" -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-ready_app.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-outputs-app.tgz\" -C \"${abspath(local.root)}\" .isoloom/cloud-vm/checks"
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-outputs-app.tgz"
    destination = "/tmp/isoloom-outputs.tgz"
  }
  provisioner "remote-exec" {
    inline = [
      "sudo sh -c 'rm -rf /opt/isoloom && mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz && tar -xzf /tmp/isoloom-outputs.tgz -C /opt/isoloom && rm -f /tmp/isoloom-outputs.tgz && mkdir -p /var/lib/isoloom && touch /var/lib/isoloom/project-delivered'"
    ]
  }
  provisioner "remote-exec" {
    inline = [
      "sh -c 't=0\nif command -v cloud-init >/dev/null 2>&1; then sudo cloud-init status --wait >/dev/null 2>&1 || true; fi\nwhile :; do\ns=$(sudo head -n1 /var/lib/isoloom/ready 2>/dev/null)\ncase \"$s\" in\nready) echo \"app: set up\"; exit 0 ;;\n\"failed: \"*) echo \"app: its set-up stopped ($s); the end of /var/log/isoloom-setup.log:\"; sudo tail -n 40 /var/log/isoloom-setup.log 2>/dev/null; exit 1 ;;\nesac\nif [ \"$t\" -ge 2400 ]; then echo \"app: not set up after 2400 s ($${s:-no ready file}); the end of /var/log/isoloom-setup.log:\"; sudo tail -n 40 /var/log/isoloom-setup.log 2>/dev/null; exit 1; fi\nsleep 5; t=$((t + 5))\ndone'"
    ]
  }
}

resource "terraform_data" "isoloom_ready_db" {
  triggers_replace = [aws_instance.db.id]
  connection {
    type        = "ssh"
    host        = aws_instance.db.public_ip
    user        = "admin"
    private_key = file(pathexpand(var.ssh_private_key_file))
    timeout     = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-ready_db.tgz\" --exclude=\"${basename(local.root)}/.isoloom*\" --exclude=\".git\" --exclude=\".terraform\" --exclude=\"*.tfstate\" --exclude=\"*.tfstate.*\" --exclude=\".terraform.tfstate.lock.info\" --exclude=\"crash.log\" --exclude=\"crash.*.log\" --exclude=\".vagrant\" -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-ready_db.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-outputs-db.tgz\" -C \"${abspath(local.root)}\" .isoloom/cloud-vm/checks"
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-outputs-db.tgz"
    destination = "/tmp/isoloom-outputs.tgz"
  }
  provisioner "remote-exec" {
    inline = [
      "sudo sh -c 'rm -rf /opt/isoloom && mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz && tar -xzf /tmp/isoloom-outputs.tgz -C /opt/isoloom && rm -f /tmp/isoloom-outputs.tgz && mkdir -p /var/lib/isoloom && touch /var/lib/isoloom/project-delivered'"
    ]
  }
  provisioner "remote-exec" {
    inline = [
      "sh -c 't=0\nif command -v cloud-init >/dev/null 2>&1; then sudo cloud-init status --wait >/dev/null 2>&1 || true; fi\nwhile :; do\ns=$(sudo head -n1 /var/lib/isoloom/ready 2>/dev/null)\ncase \"$s\" in\nready) echo \"db: set up\"; exit 0 ;;\n\"failed: \"*) echo \"db: its set-up stopped ($s); the end of /var/log/isoloom-setup.log:\"; sudo tail -n 40 /var/log/isoloom-setup.log 2>/dev/null; exit 1 ;;\nesac\nif [ \"$t\" -ge 2400 ]; then echo \"db: not set up after 2400 s ($${s:-no ready file}); the end of /var/log/isoloom-setup.log:\"; sudo tail -n 40 /var/log/isoloom-setup.log 2>/dev/null; exit 1; fi\nsleep 5; t=$((t + 5))\ndone'"
    ]
  }
}

resource "terraform_data" "isoloom_ready_user" {
  triggers_replace = [aws_instance.user.id]
  connection {
    type        = "ssh"
    host        = aws_instance.user.public_ip
    user        = "admin"
    private_key = file(pathexpand(var.ssh_private_key_file))
    timeout     = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-ready_user.tgz\" --exclude=\"${basename(local.root)}/.isoloom*\" --exclude=\".git\" --exclude=\".terraform\" --exclude=\"*.tfstate\" --exclude=\"*.tfstate.*\" --exclude=\".terraform.tfstate.lock.info\" --exclude=\"crash.log\" --exclude=\"crash.*.log\" --exclude=\".vagrant\" -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-ready_user.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-outputs-user.tgz\" -C \"${abspath(local.root)}\" .isoloom/cloud-vm/checks"
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-outputs-user.tgz"
    destination = "/tmp/isoloom-outputs.tgz"
  }
  provisioner "remote-exec" {
    inline = [
      "sudo sh -c 'rm -rf /opt/isoloom && mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz && tar -xzf /tmp/isoloom-outputs.tgz -C /opt/isoloom && rm -f /tmp/isoloom-outputs.tgz && mkdir -p /var/lib/isoloom && touch /var/lib/isoloom/project-delivered'"
    ]
  }
  provisioner "remote-exec" {
    inline = [
      "sh -c 't=0\nif command -v cloud-init >/dev/null 2>&1; then sudo cloud-init status --wait >/dev/null 2>&1 || true; fi\nwhile :; do\ns=$(sudo head -n1 /var/lib/isoloom/ready 2>/dev/null)\ncase \"$s\" in\nready) echo \"user: set up\"; exit 0 ;;\n\"failed: \"*) echo \"user: its set-up stopped ($s); the end of /var/log/isoloom-setup.log:\"; sudo tail -n 40 /var/log/isoloom-setup.log 2>/dev/null; exit 1 ;;\nesac\nif [ \"$t\" -ge 2400 ]; then echo \"user: not set up after 2400 s ($${s:-no ready file}); the end of /var/log/isoloom-setup.log:\"; sudo tail -n 40 /var/log/isoloom-setup.log 2>/dev/null; exit 1; fi\nsleep 5; t=$((t + 5))\ndone'"
    ]
  }
}

output "machines" {
  value = {
    gateway = aws_eip.gateway.public_ip
    app     = aws_instance.app.public_ip
    db      = aws_instance.db.public_ip
    user    = aws_instance.user.public_ip
  }
}

output "address_gateway" {
  value = aws_eip.gateway.public_ip
}

output "ssh_user_gateway" {
  value = "admin"
}

output "address_app" {
  value = aws_instance.app.public_ip
}

output "ssh_user_app" {
  value = "admin"
}

output "address_db" {
  value = aws_instance.db.public_ip
}

output "ssh_user_db" {
  value = "admin"
}

output "address_user" {
  value = aws_instance.user.public_ip
}

output "ssh_user_user" {
  value = "admin"
}

output "ssh_users" {
  value = { gateway = "admin", app = "admin", db = "admin", user = "admin" }
}

output "ip" {
  value = aws_instance.user.public_ip
}

output "ready_file" {
  value = "/var/lib/isoloom/ready"
}

# The checks: each runner on the machine it stands for (ssh <user>@<host> '<command>').
output "checks" {
  value = [
    {
      position = "user"
      machine  = "user"
      host     = aws_instance.user.public_ip
      user     = "admin"
      command  = "cd /opt/isoloom && sh '.isoloom/cloud-vm/checks/user.sh'"
    },
    {
      position = "gateway"
      machine  = "gateway"
      host     = aws_eip.gateway.public_ip
      user     = "admin"
      command  = "cd /opt/isoloom && sh '.isoloom/cloud-vm/checks/gateway.sh'"
    },
    {
      position = "app"
      machine  = "app"
      host     = aws_instance.app.public_ip
      user     = "admin"
      command  = "cd /opt/isoloom && sh '.isoloom/cloud-vm/checks/app.sh'"
    },
    {
      position = "db"
      machine  = "db"
      host     = aws_instance.db.public_ip
      user     = "admin"
      command  = "cd /opt/isoloom && sh '.isoloom/cloud-vm/checks/db.sh'"
    }
  ]
}

# The project's files the machines don't get: what .isoloomignore at the project's root lists
# (gitignore-style: one pattern per line, `#` comments, `!` brings a path back, a trailing `/`
# matches folders only, a `/` at the start or in the middle anchors the pattern at the root; `*`,
# `?`, `[abc]`, `**`; the last pattern matching a path, or a folder it is in, decides), then
# Isoloom's outputs, version control and the tools' state. Read as regular expressions, as the
# Vagrantfiles do.
locals {
  project_ignore_lines = [for l in split("\n", "${replace(try(file("${local.root}/.isoloomignore"), ""), "\r", "")}\n/.isoloom*\n.git/\n.terraform/\n*.tfstate\n*.tfstate.*\n.terraform.tfstate.lock.info\ncrash.log\ncrash.*.log\n.vagrant/\n") : trimspace(l)]
  project_ignore_pats  = [for l in local.project_ignore_lines : { keep = startswith(l, "!"), pat = trimprefix(l, "!") } if l != "" && !startswith(l, "#")]
  project_ignore_globs = [for r in local.project_ignore_pats : merge(r, { glob = trimsuffix(trimsuffix(trimsuffix(r.pat, "/"), "/**"), "/") })]
  project_ignore = [for r in local.project_ignore_globs : {
    keep = r.keep
    re = format(r.glob == r.pat ? "^%s(/|$)" : "^%s/", replace(replace(replace(replace(replace(replace(replace(replace(
      length(split("/", r.glob)) > 1 ? trimprefix(r.glob, "/") : "**/${r.glob}",
    "/[.+^$(){}|\\\\]/", "\\$0"), "[!", "[^"), "**/", "\u0001"), "**", "\u0002"), "*", "[^/]*"), "?", "[^/]"), "\u0001", "(.*/)?"), "\u0002", ".*"))
  } if r.glob != ""]
  # Each file: whether it goes (the last matching pattern decides; none: it goes).
  project_keep    = { for f in fileset(local.root, "**") : f => reverse(concat([true], [for r in local.project_ignore : r.keep if length(regexall(r.re, f)) > 0]))[0] }
  project_ignored = [for f, keep in local.project_keep : f if !keep]
}

# What `tar` leaves out of the project's archive: .isoloomignore's files, from the archive's top
# folder, their wildcard characters escaped.
resource "local_file" "isoloom_project" {
  filename = "${path.module}/.isoloom-project-ignored.txt"
  content  = join("", [for f in local.project_ignored : "${replace("${basename(local.root)}/${f}", "/[\\\\*?\\[]/", "\\$0")}\n"])
}

## .isoloom/cloud-vm/azure/main.tf
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  terraform -chdir=.isoloom/cloud-vm/azure init && terraform -chdir=.isoloom/cloud-vm/azure apply \
#           -var allowed_cidr=<your IP>/32 -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)" -var ssh_private_key_file=~/.ssh/id_ed25519
# Stop:   terraform -chdir=.isoloom/cloud-vm/azure destroy (same variables)

terraform {
  required_version = ">= 1.6.0"
  backend "local" {}
  required_providers {
    azurerm = { source = "hashicorp/azurerm", version = "~> 5.8.0" }
    local   = { source = "hashicorp/local", version = "~> 2.9.1" }
  }
}

variable "subscription_id" {
  type        = string
  default     = null
  description = "Default: ARM_SUBSCRIPTION_ID from the environment"
}

variable "region" {
  type    = string
  default = "swedencentral"
}

variable "allowed_cidr" {
  type        = string
  description = "Who may reach the machines (SSH and the published ports), e.g. your IP/32"
}

variable "ssh_public_key" {
  type        = string
  description = "The SSH public key the machines let in: Terraform signs in with its private half (`ssh_private_key_file`) to set them up or wait for their set-up, and so can you, to run the checks"
}

variable "ssh_private_key_file" {
  type        = string
  description = "The private key of ssh_public_key (a path, ~ allowed): Terraform signs in to the machines with it to bring the project in and wait for their set-up"
}

variable "expires_at" {
  type        = string
  default     = ""
  description = "When the environment should end, in Unix seconds (empty: no end): a tag on every resource, so a reaper finds what to destroy, and the time the machines shut themselves down"
}

provider "azurerm" {
  features {}
  subscription_id = var.subscription_id
}

resource "terraform_data" "id" {
  input = substr(replace(uuid(), "-", ""), 0, 8)
  lifecycle {
    ignore_changes = [input]
  }
}

locals {
  name = "isoloom-dmz-jump-${terraform_data.id.output}"
  root = abspath("${path.module}/../../..")
  tags = {
    isoloom-environment = "dmz-jump"
    managed-by          = "isoloom"
    isoloom-instance    = local.name
    isoloom-expires-at  = var.expires_at
  }
}

resource "azurerm_resource_group" "env" {
  name     = local.name
  location = var.region
  tags     = local.tags
}

# The environment's networks: one virtual network, a subnet per network with its exact range.
resource "azurerm_virtual_network" "env" {
  name                = local.name
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  address_space       = ["10.30.10.0/24", "10.30.20.0/24", "10.30.99.0/24"]
}

resource "azurerm_subnet" "dmz" {
  name                            = "dmz"
  resource_group_name             = azurerm_resource_group.env.name
  virtual_network_name            = azurerm_virtual_network.env.name
  address_prefixes                = ["10.30.10.0/24"]
  default_outbound_access_enabled = true
}

resource "azurerm_subnet" "internal" {
  name                            = "internal"
  resource_group_name             = azurerm_resource_group.env.name
  virtual_network_name            = azurerm_virtual_network.env.name
  address_prefixes                = ["10.30.20.0/24"]
  default_outbound_access_enabled = false
}

resource "azurerm_subnet" "access" {
  name                            = "access"
  resource_group_name             = azurerm_resource_group.env.name
  virtual_network_name            = azurerm_virtual_network.env.name
  address_prefixes                = ["10.30.99.0/24"]
  default_outbound_access_enabled = true
}

# The seal: once every machine is set up, the networks without internet lose the internet out, at their subnets.
resource "azurerm_network_security_group" "sealed" {
  name                = "${local.name}-sealed"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  security_rule {
    name                       = "vnet-in"
    priority                   = 100
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "VirtualNetwork"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "allowed-in"
    priority                   = 110
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = var.allowed_cidr
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "no-internet-out"
    priority                   = 100
    direction                  = "Outbound"
    access                     = "Deny"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "*"
    destination_address_prefix = "Internet"
  }
}

resource "azurerm_subnet_network_security_group_association" "sealed_internal" {
  subnet_id                 = azurerm_subnet.internal.id
  network_security_group_id = azurerm_network_security_group.sealed.id
  depends_on = [
    terraform_data.isoloom_ready_gateway,
    terraform_data.isoloom_ready_app,
    terraform_data.isoloom_ready_db,
    terraform_data.isoloom_ready_user
  ]
}

# Machine `gateway`: what may reach it.
resource "azurerm_network_security_group" "gateway" {
  name                = "${local.name}-gateway"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  security_rule {
    name                       = "net-dmz"
    priority                   = 100
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "10.30.10.0/24"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "net-internal"
    priority                   = 110
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "10.30.20.0/24"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "ssh"
    priority                   = 120
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_range     = "22"
    source_address_prefix      = var.allowed_cidr
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "reach-0-access"
    priority                   = 130
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "10.30.99.0/24"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "deny-rest-of-vnet"
    priority                   = 4000
    direction                  = "Inbound"
    access                     = "Deny"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "VirtualNetwork"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "outbound"
    priority                   = 100
    direction                  = "Outbound"
    access                     = "Allow"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "*"
    destination_address_prefix = "*"
  }
}

resource "azurerm_public_ip" "gateway" {
  name                = "${local.name}-gateway"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  allocation_method   = "Static"
  sku                 = "Standard"
}

resource "azurerm_network_interface" "gateway_dmz" {
  name                  = "${local.name}-gateway-dmz"
  resource_group_name   = azurerm_resource_group.env.name
  location              = var.region
  tags                  = local.tags
  ip_forwarding_enabled = true
  ip_configuration {
    name                          = "primary"
    subnet_id                     = azurerm_subnet.dmz.id
    private_ip_address_allocation = "Static"
    private_ip_address            = "10.30.10.10"
    public_ip_address_id          = azurerm_public_ip.gateway.id
  }
}

resource "azurerm_network_interface_security_group_association" "gateway_dmz" {
  network_interface_id      = azurerm_network_interface.gateway_dmz.id
  network_security_group_id = azurerm_network_security_group.gateway.id
}

resource "azurerm_network_interface" "gateway_internal" {
  name                  = "${local.name}-gateway-internal"
  resource_group_name   = azurerm_resource_group.env.name
  location              = var.region
  tags                  = local.tags
  ip_forwarding_enabled = true
  ip_configuration {
    name                          = "primary"
    subnet_id                     = azurerm_subnet.internal.id
    private_ip_address_allocation = "Static"
    private_ip_address            = "10.30.20.10"
  }
}

resource "azurerm_network_interface_security_group_association" "gateway_internal" {
  network_interface_id      = azurerm_network_interface.gateway_internal.id
  network_security_group_id = azurerm_network_security_group.gateway.id
}

resource "azurerm_linux_virtual_machine" "gateway" {
  name                  = "${local.name}-gateway"
  resource_group_name   = azurerm_resource_group.env.name
  location              = var.region
  tags                  = local.tags
  size                  = "Standard_B2ts_v2"
  admin_username        = "isoloom"
  network_interface_ids = [azurerm_network_interface.gateway_dmz.id, azurerm_network_interface.gateway_internal.id]
  custom_data           = base64encode("#!/bin/sh\n# Isoloom: this machine sets itself up. Its progress is in /var/lib/isoloom/ready (isoloom-ready/1), its output in /var/log/isoloom-setup.log. The project comes over SSH from Terraform.\nmkdir -p /var/lib/isoloom\nrm -f /var/lib/isoloom/setup.sh.new\n(umask 077 && cat > /var/lib/isoloom/setup.sh.new) <<'ISOLOOM_SETUP'\n#!/bin/sh\numask 022\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\nstate=$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\npart=$(cat /var/lib/isoloom/part 2>/dev/null || echo 1)\nif [ \"$state\" = ready ] || [ \"$part\" != 1 ]; then\nIF=$(ip -o link | grep -i \"${lower(replace(azurerm_network_interface.gateway_internal.mac_address, "-", ":"))}\" | awk -F': ' '{print $2}'); sudo ip link set \"$IF\" up && (ip -4 addr show \"$IF\" | grep -q 10.30.20.10/ || sudo ip addr add 10.30.20.10/24 dev \"$IF\")\nfi\ncase \"$state\" in ready|\"failed: \"*) exit 0 ;; esac\nif [ \"$part\" = 1 ]; then\necho 'running: its host name' > /var/lib/isoloom/ready; { hostnamectl set-hostname gateway 2>/dev/null || hostname gateway; grep -q ' gateway$' /etc/hosts || echo '127.0.1.1 gateway' >> /etc/hosts; [ ! -d /etc/cloud/cloud.cfg.d ] || echo 'preserve_hostname: true' > /etc/cloud/cloud.cfg.d/99-isoloom-hostname.cfg; } || { echo 'failed: its host name' > /var/lib/isoloom/ready; exit 1; }\necho 'running: waiting for the project (Terraform brings it in over SSH)' > /var/lib/isoloom/ready; { i=0; until [ -f /var/lib/isoloom/project-delivered ]; do [ \"$i\" -gt 0 ] || echo 'waiting for the project, which Terraform brings in over SSH during its apply'; i=$((i+5)); if [ \"$i\" -gt 2400 ]; then echo 'the project never came: Terraform brings it in over SSH during its apply (its terraform_data.isoloom_ready_<machine>), with ssh_private_key_file' >&2; exit 1; fi; sleep 5; done; } || { echo 'failed: waiting for the project (Terraform brings it in over SSH)' > /var/lib/isoloom/ready; exit 1; }\necho 'running: the machine'\\''s interfaces' > /var/lib/isoloom/ready; { IF=$(ip -o link | grep -i \"${lower(replace(azurerm_network_interface.gateway_internal.mac_address, "-", ":"))}\" | awk -F': ' '{print $2}'); sudo ip link set \"$IF\" up && (ip -4 addr show \"$IF\" | grep -q 10.30.20.10/ || sudo ip addr add 10.30.20.10/24 dev \"$IF\"); } || { echo 'failed: the machine'\\''s interfaces' > /var/lib/isoloom/ready; exit 1; }\necho 'running: hosts file' > /var/lib/isoloom/ready; { sh -c 'printf '\\''%s\\n'\\'' '\\''10.30.10.10 gateway'\\'' '\\''10.30.20.20 app'\\'' '\\''10.30.20.30 db'\\'' '\\''10.30.99.10 user'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'; } || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }\necho 'running: provision/gateway.yml' > /var/lib/isoloom/ready; { sh -c 'set -e\npkg() { if command -v apt-get >/dev/null; then apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \"$@\"; elif command -v dnf >/dev/null; then dnf install -y -q \"$@\"; elif command -v apk >/dev/null; then apk add -q --no-cache \"$@\"; else yum install -y -q \"$@\"; fi; }\ncommand -v ansible-playbook >/dev/null || pkg ansible-core\ncd /opt/isoloom && sh -c '\\''ansible-playbook -c local -i gateway, '\\''\\'\\'''\\''provision/gateway.yml'\\''\\'\\'''\\'''\\'''; } || { echo 'failed: provision/gateway.yml' > /var/lib/isoloom/ready; exit 1; }\necho 'running: health check' > /var/lib/isoloom/ready; { sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'; } || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }\nfi\necho ready > /var/lib/isoloom/ready\nrm -f /var/lib/isoloom/part\nexit 0\nISOLOOM_SETUP\nmv -f /var/lib/isoloom/setup.sh.new /var/lib/isoloom/setup.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-setup.service <<'ISOLOOM_UNIT'\n[Unit]\nDescription=Isoloom: the machine's set-up\nWants=network-online.target\nAfter=network-online.target cloud-final.service google-startup-scripts.service\n\n[Service]\nType=oneshot\nExecStart=/bin/sh /var/lib/isoloom/setup.sh\nStandardOutput=append:/var/log/isoloom-setup.log\nStandardError=append:/var/log/isoloom-setup.log\nTimeoutStartSec=0\n\n[Install]\nWantedBy=multi-user.target\nISOLOOM_UNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-setup.service >/dev/null 2>&1\nsystemctl start --no-block isoloom-setup.service\nelse\nnohup sh /var/lib/isoloom/setup.sh >> /var/log/isoloom-setup.log 2>&1 &\nfi\n")
  admin_ssh_key {
    username   = "isoloom"
    public_key = var.ssh_public_key
  }
  os_disk {
    caching              = "ReadWrite"
    storage_account_type = "StandardSSD_LRS"
    disk_size_gb         = 30
  }
  source_image_reference {
    publisher = "Debian"
    offer     = "debian-12"
    sku       = "12-gen2"
    version   = "latest"
  }
  lifecycle {
    ignore_changes = [custom_data]
  }
}

# Machine `app`: what may reach it.
resource "azurerm_network_security_group" "app" {
  name                = "${local.name}-app"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  security_rule {
    name                       = "net-internal"
    priority                   = 100
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "10.30.20.0/24"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "ssh"
    priority                   = 110
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_range     = "22"
    source_address_prefix      = var.allowed_cidr
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "reach-0-dmz-8080-tcp"
    priority                   = 120
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_range     = "8080"
    source_address_prefix      = "10.30.10.0/24"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "reach-0-dmz-8080-udp"
    priority                   = 130
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Udp"
    source_port_range          = "*"
    destination_port_range     = "8080"
    source_address_prefix      = "10.30.10.0/24"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "reach-0-dmz-5432-tcp"
    priority                   = 140
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_range     = "5432"
    source_address_prefix      = "10.30.10.0/24"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "reach-0-dmz-5432-udp"
    priority                   = 150
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Udp"
    source_port_range          = "*"
    destination_port_range     = "5432"
    source_address_prefix      = "10.30.10.0/24"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "deny-rest-of-vnet"
    priority                   = 4000
    direction                  = "Inbound"
    access                     = "Deny"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "VirtualNetwork"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "outbound"
    priority                   = 100
    direction                  = "Outbound"
    access                     = "Allow"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "*"
    destination_address_prefix = "*"
  }
}

