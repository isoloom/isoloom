  metadata_startup_script = "#!/bin/sh\n# Isoloom: this machine sets itself up. Its progress is in /var/lib/isoloom/ready (isoloom-ready/1), its output in /var/log/isoloom-setup.log. The project comes over SSH from the runner (run.json).\nmkdir -p /var/lib/isoloom\nrm -f /var/lib/isoloom/setup.sh.new\n(umask 077 && cat > /var/lib/isoloom/setup.sh.new) <<'ISOLOOM_SETUP'\n#!/bin/sh\numask 022\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\nstate=$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\npart=$(cat /var/lib/isoloom/part 2>/dev/null || echo 1)\ncase \"$state\" in ready|failed:*) exit 0 ;; esac\nif [ \"$part\" = 1 ]; then\necho 'running: its host name' > /var/lib/isoloom/ready; { hostnamectl set-hostname db 2>/dev/null || hostname db; grep -q ' db$' /etc/hosts || echo '127.0.1.1 db' >> /etc/hosts; [ ! -d /etc/cloud/cloud.cfg.d ] || echo 'preserve_hostname: true' > /etc/cloud/cloud.cfg.d/99-isoloom-hostname.cfg; } || { echo 'failed: its host name' > /var/lib/isoloom/ready; exit 1; }\necho 'running: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; { i=0; until [ -f /var/lib/isoloom/project-delivered ]; do [ \"$i\" -gt 0 ] || echo 'waiting for the project, which the runner (run.json) delivers over SSH'; i=$((i+5)); if [ \"$i\" -gt 2400 ]; then echo 'the project never came: start the lab through the runner (run.json), which delivers it over SSH' >&2; exit 1; fi; sleep 5; done; } || { echo 'failed: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; exit 1; }\necho 'running: hosts file' > /var/lib/isoloom/ready; { sh -c 'printf '\\''%s\\n'\\'' '\\''10.30.20.10 gateway'\\'' '\\''10.30.20.20 app'\\'' '\\''10.30.20.30 db'\\'' '\\''10.30.99.10 user'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'; } || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }\necho 'running: provision/db.yml' > /var/lib/isoloom/ready; { sh -c 'pkg() { if command -v apt-get >/dev/null; then apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \"$@\"; elif command -v dnf >/dev/null; then dnf install -y -q \"$@\"; else yum install -y -q \"$@\"; fi; }\ncommand -v ansible-playbook >/dev/null || pkg ansible-core\ncd /opt/isoloom && sh -c '\\''ansible-playbook -c local -i db, provision/db.yml'\\'''; } || { echo 'failed: provision/db.yml' > /var/lib/isoloom/ready; exit 1; }\necho 'running: closing the internet' > /var/lib/isoloom/ready; { sh -c 'pkg() { if command -v apt-get >/dev/null; then apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \"$@\"; elif command -v dnf >/dev/null; then dnf install -y -q \"$@\"; else yum install -y -q \"$@\"; fi; }\ncommand -v nft >/dev/null || if command -v apk >/dev/null; then apk add -q --no-cache nftables; else pkg nftables; fi\nprintf '\\''%s\\n'\\'' '\\''table inet isoloom-egress'\\'' '\\''delete table inet isoloom-egress'\\'' '\\''table inet isoloom-egress {'\\'' '\\''  chain output {'\\'' '\\''    type filter hook output priority 0; policy accept;'\\'' '\\''    oifname \"lo\" accept'\\'' '\\''    ip daddr != { 10.30.10.0/24, 10.30.20.0/24, 10.30.99.0/24 } ct state new drop'\\'' '\\''  }'\\'' '\\''}'\\'' > /etc/isoloom-egress.nft\nmkdir -p /etc/isoloom\ncat > /etc/isoloom/egress.sh <<'\\''EGRESS'\\''\n#!/bin/sh\n# No new connection leaves the isoloom networks\nnft -f /etc/isoloom-egress.nft\nexit 0\nEGRESS\nchmod +x /etc/isoloom/egress.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-egress.service <<'\\''UNIT'\\''\n[Unit]\nDescription=No new connection leaves the isoloom networks\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=-/etc/isoloom/egress.sh\n\n[Install]\nWantedBy=multi-user.target\nUNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-egress.service\nsystemctl restart isoloom-egress.service\nelse\nmkdir -p /etc/local.d && ln -sf /etc/isoloom/egress.sh /etc/local.d/isoloom-egress.start\nrc-update add local default >/dev/null 2>&1 || true\n/etc/isoloom/egress.sh || true\nfi'; } || { echo 'failed: closing the internet' > /var/lib/isoloom/ready; exit 1; }\necho 'running: health check' > /var/lib/isoloom/ready; { sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'; } || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }\nfi\necho ready > /var/lib/isoloom/ready\nrm -f /var/lib/isoloom/part\nexit 0\nISOLOOM_SETUP\nmv -f /var/lib/isoloom/setup.sh.new /var/lib/isoloom/setup.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-setup.service <<'ISOLOOM_UNIT'\n[Unit]\nDescription=Isoloom: the machine's set-up\nWants=network-online.target\nAfter=network-online.target cloud-final.service google-startup-scripts.service\n\n[Service]\nType=oneshot\nExecStart=/bin/sh /var/lib/isoloom/setup.sh\nStandardOutput=append:/var/log/isoloom-setup.log\nStandardError=append:/var/log/isoloom-setup.log\nTimeoutStartSec=0\n\n[Install]\nWantedBy=multi-user.target\nISOLOOM_UNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-setup.service >/dev/null 2>&1\nsystemctl start --no-block isoloom-setup.service\nelse\nnohup sh /var/lib/isoloom/setup.sh >> /var/log/isoloom-setup.log 2>&1 &\nfi\n"
  labels = {
    isoloom-environment = "dmz-jump"
    managed-by          = "isoloom"
    isoloom-instance    = local.name
    isoloom-expires-at  = var.expires_at
  }
  lifecycle {
    ignore_changes = [metadata_startup_script]
  }
}

# Machine `user`: what may reach it.
resource "google_compute_firewall" "user_net_access" {
  project       = local.project
  name          = "${local.name}-user-net-access"
  network       = google_compute_network.access.id
  direction     = "INGRESS"
  source_ranges = ["10.30.99.0/24"]
  target_tags   = ["${local.name}-user"]
  allow {
    protocol = "all"
  }
}

resource "google_compute_firewall" "user_ssh" {
  project       = local.project
  name          = "${local.name}-user-ssh"
  network       = google_compute_network.access.id
  direction     = "INGRESS"
  source_ranges = [var.allowed_cidr]
  target_tags   = ["${local.name}-user"]
  allow {
    protocol = "tcp"
    ports    = ["22"]
  }
}

resource "google_compute_instance" "user" {
  project      = local.project
  name         = "${local.name}-user"
  machine_type = "e2-small"
  zone         = local.zone
  tags         = ["${local.name}-user"]
  boot_disk {
    initialize_params {
      image = "debian-cloud/debian-12"
      labels = {
        isoloom-environment = "dmz-jump"
        managed-by          = "isoloom"
        isoloom-instance    = local.name
        isoloom-expires-at  = var.expires_at
      }
      size = 20
    }
  }
  network_interface {
    subnetwork = google_compute_subnetwork.access.id
    network_ip = "10.30.99.10"
    access_config {}
  }
  metadata                = { ssh-keys = "admin:${var.ssh_public_key}" }
  metadata_startup_script = "#!/bin/sh\n# Isoloom: this machine sets itself up. Its progress is in /var/lib/isoloom/ready (isoloom-ready/1), its output in /var/log/isoloom-setup.log. The project comes over SSH from the runner (run.json).\nmkdir -p /var/lib/isoloom\nrm -f /var/lib/isoloom/setup.sh.new\n(umask 077 && cat > /var/lib/isoloom/setup.sh.new) <<'ISOLOOM_SETUP'\n#!/bin/sh\numask 022\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\nstate=$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\npart=$(cat /var/lib/isoloom/part 2>/dev/null || echo 1)\ncase \"$state\" in ready|failed:*) exit 0 ;; esac\nif [ \"$part\" = 1 ]; then\necho 'running: its host name' > /var/lib/isoloom/ready; { hostnamectl set-hostname user 2>/dev/null || hostname user; grep -q ' user$' /etc/hosts || echo '127.0.1.1 user' >> /etc/hosts; [ ! -d /etc/cloud/cloud.cfg.d ] || echo 'preserve_hostname: true' > /etc/cloud/cloud.cfg.d/99-isoloom-hostname.cfg; } || { echo 'failed: its host name' > /var/lib/isoloom/ready; exit 1; }\necho 'running: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; { i=0; until [ -f /var/lib/isoloom/project-delivered ]; do [ \"$i\" -gt 0 ] || echo 'waiting for the project, which the runner (run.json) delivers over SSH'; i=$((i+5)); if [ \"$i\" -gt 2400 ]; then echo 'the project never came: start the lab through the runner (run.json), which delivers it over SSH' >&2; exit 1; fi; sleep 5; done; } || { echo 'failed: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; exit 1; }\necho 'running: hosts file' > /var/lib/isoloom/ready; { sh -c 'printf '\\''%s\\n'\\'' '\\''10.30.10.10 gateway'\\'' '\\''10.30.20.20 app'\\'' '\\''10.30.20.30 db'\\'' '\\''10.30.99.10 user'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'; } || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }\necho 'running: health check' > /var/lib/isoloom/ready; { sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'; } || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }\nfi\necho ready > /var/lib/isoloom/ready\nrm -f /var/lib/isoloom/part\nexit 0\nISOLOOM_SETUP\nmv -f /var/lib/isoloom/setup.sh.new /var/lib/isoloom/setup.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-setup.service <<'ISOLOOM_UNIT'\n[Unit]\nDescription=Isoloom: the machine's set-up\nWants=network-online.target\nAfter=network-online.target cloud-final.service google-startup-scripts.service\n\n[Service]\nType=oneshot\nExecStart=/bin/sh /var/lib/isoloom/setup.sh\nStandardOutput=append:/var/log/isoloom-setup.log\nStandardError=append:/var/log/isoloom-setup.log\nTimeoutStartSec=0\n\n[Install]\nWantedBy=multi-user.target\nISOLOOM_UNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-setup.service >/dev/null 2>&1\nsystemctl start --no-block isoloom-setup.service\nelse\nnohup sh /var/lib/isoloom/setup.sh >> /var/log/isoloom-setup.log 2>&1 &\nfi\n"
  labels = {
    isoloom-environment = "dmz-jump"
    managed-by          = "isoloom"
    isoloom-instance    = local.name
    isoloom-expires-at  = var.expires_at
  }
  lifecycle {
    ignore_changes = [metadata_startup_script]
  }
}

output "machines" {
  value = {
    gateway = google_compute_instance.gateway.network_interface[0].access_config[0].nat_ip
    app     = google_compute_instance.app.network_interface[0].access_config[0].nat_ip
    db      = google_compute_instance.db.network_interface[0].access_config[0].nat_ip
    user    = google_compute_instance.user.network_interface[0].access_config[0].nat_ip
  }
}

output "address_gateway" {
  value = google_compute_instance.gateway.network_interface[0].access_config[0].nat_ip
}

output "ssh_user_gateway" {
  value = "admin"
}

output "address_app" {
  value = google_compute_instance.app.network_interface[0].access_config[0].nat_ip
}

output "ssh_user_app" {
  value = "admin"
}

output "address_db" {
  value = google_compute_instance.db.network_interface[0].access_config[0].nat_ip
}

output "ssh_user_db" {
  value = "admin"
}

output "address_user" {
  value = google_compute_instance.user.network_interface[0].access_config[0].nat_ip
}

output "ssh_user_user" {
  value = "admin"
}

output "ssh_users" {
  value = { gateway = "admin", app = "admin", db = "admin", user = "admin" }
}

output "ip" {
  value = google_compute_instance.user.network_interface[0].access_config[0].nat_ip
}

output "ready_file" {
  value = "/var/lib/isoloom/ready"
}

# The checks: each runner on the machine it stands for (ssh <user>@<host> '<command>'), or the runner (run.json).
output "checks" {
  value = [
    {
      position = "user"
      machine  = "user"
      host     = google_compute_instance.user.network_interface[0].access_config[0].nat_ip
      user     = "admin"
      command  = "cd /opt/isoloom && sh .isoloom/cloud-vm/checks/user.sh"
    },
    {
      position = "gateway"
      machine  = "gateway"
      host     = google_compute_instance.gateway.network_interface[0].access_config[0].nat_ip
      user     = "admin"
      command  = "cd /opt/isoloom && sh .isoloom/cloud-vm/checks/gateway.sh"
    },
    {
      position = "app"
      machine  = "app"
      host     = google_compute_instance.app.network_interface[0].access_config[0].nat_ip
      user     = "admin"
      command  = "cd /opt/isoloom && sh .isoloom/cloud-vm/checks/app.sh"
    },
    {
      position = "db"
      machine  = "db"
      host     = google_compute_instance.db.network_interface[0].access_config[0].nat_ip
      user     = "admin"
      command  = "cd /opt/isoloom && sh .isoloom/cloud-vm/checks/db.sh"
    }
  ]
}

## .isoloom/cloud-vm/gcp/run.json
{
  "$schema": "https://raw.githubusercontent.com/isoloom/isoloom/main/schemas/run-manifest-v1.schema.json",
  "manifest_version": 1,
  "generator": {
    "name": "isoloom",
    "version": "1.0.9"
  },
  "environment": {
    "name": "dmz-jump",
    "instance": null,
    "message": null
  },
  "target": "cloud-vm",
  "cloud": "gcp",
  "driver": "terraform",
  "hosts": [
    "linux",
    "macos",
    "windows"
  ],
  "tools": [
    {
      "name": "terraform",
      "probe": [
        "terraform",
        "version"
      ],
      "min_version": "1.6.0"
    },
    {
      "name": "ssh",
      "probe": [
        "ssh",
        "-V"
      ]
    }
  ],
  "identity": {
    "terraform": {
      "module": ".",
      "state": "runner"
    }
  },
  "params": [
    {
      "name": "project",
      "description": "An existing project; or leave empty and give billing_account for a project of its own.",
      "default": "",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "project"
        }
      ]
    },
    {
      "name": "billing_account",
      "description": "With no project: create one for this environment, billed here, deleted with it.",
      "default": "",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "billing_account"
        }
      ]
    },
    {
      "name": "org_id",
      "description": "The module's `org_id`.",
      "default": "",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "org_id"
        }
      ]
    },
    {
      "name": "region",
      "description": "The module's `region`.",
      "default": "europe-west9",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "region"
        }
      ]
    },
    {
      "name": "allowed_cidr",
      "description": "Who may reach the machines (SSH and the published ports), e.g. your IP/32.",
      "required": true,
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "allowed_cidr"
        }
      ]
    },
    {
      "name": "isoloom_sealed",
      "description": "true once the machines are set up: the internet is closed to the `internet: false` networks, at the network.",
      "default": "false",
      "values": [
        "true",
        "false"
      ],
      "set_by": "runner",
      "deliver": [
        {
          "via": "tf_var",
          "var": "isoloom_sealed"
        }
      ]
    },
    {
      "name": "ISOLOOM_DERIVED",
      "description": "0: the checks derived from the spec (reachability, no internet) are skipped.",
      "default": "1",
      "values": [
        "0",
        "1"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_DERIVED",
          "steps": [
            "check-user",
            "check-gateway",
            "check-app",
            "check-db"
          ]
        }
      ]
    }
  ],
  "secrets": [
    {
      "name": "GOOGLE_OAUTH_ACCESS_TOKEN",
      "kind": "connection",
      "required": false,
      "sensitive": true,
      "source": {
        "store": "env",
        "reference": "GOOGLE_OAUTH_ACCESS_TOKEN"
      },
      "deliver": [
        {
          "via": "env",
          "var": "GOOGLE_OAUTH_ACCESS_TOKEN",
          "steps": [
            "init",
            "apply",
            "destroy",
            "seal"
          ]
        }
      ]
    },
    {
      "name": "GOOGLE_CREDENTIALS",
      "kind": "connection",
      "required": false,
      "sensitive": true,
      "source": {
        "store": "env",
        "reference": "GOOGLE_CREDENTIALS"
      },
      "deliver": [
        {
          "via": "env",
          "var": "GOOGLE_CREDENTIALS",
          "steps": [
            "init",
            "apply",
            "destroy",
            "seal"
          ]
        }
      ]
    }
  ],
  "networks": [
    {
      "name": "dmz",
      "cidr": "10.30.10.0/24",
      "internet": true,
      "native": "dmz"
    },
    {
      "name": "internal",
      "cidr": "10.30.20.0/24",
      "internet": false,
      "native": "internal"
    },
    {
      "name": "access",
      "cidr": "10.30.99.0/24",
      "internet": true,
      "native": "access"
    }
  ],
  "machines": [
    {
      "name": "gateway",
      "role": "member",
      "os": "debian-12",
      "arch": "amd64",
      "resources": {
        "cpus": 1,
        "memory_mb": 1024
      },
      "addresses": {
        "dmz": "10.30.10.10",
        "internal": "10.30.20.10"
      },
      "ports": [
        {
          "name": "web",
          "port": 80,
          "protocol": "tcp",
          "http": false
        },
        {
          "name": "ssh",
          "port": 22,
          "protocol": "tcp",
          "http": false
        }
      ]
    },
    {
      "name": "app",
      "role": "member",
      "os": "debian-12",
      "arch": "amd64",
      "resources": {
        "cpus": 1,
        "memory_mb": 1024
      },
      "addresses": {
        "internal": "10.30.20.20"
      },
      "ports": [
        {
          "name": "api",
          "port": 8080,
          "protocol": "tcp",
          "http": false
        }
      ]
    },
    {
      "name": "db",
      "role": "member",
      "os": "debian-12",
      "arch": "amd64",
      "resources": {
        "cpus": 1,
        "memory_mb": 1024
      },
      "addresses": {
        "internal": "10.30.20.30"
      },
      "ports": [
        {
          "name": "postgres",
          "port": 5432,
          "protocol": "tcp",
          "http": false
        }
      ]
    },
    {
      "name": "user",
      "role": "access",
      "os": "debian-12",
      "arch": "amd64",
      "resources": {
        "cpus": 1,
        "memory_mb": 1024
      },
      "addresses": {
        "access": "10.30.99.10"
      }
    }
  ],
  "lifecycle": {
    "up": [
      {
        "id": "clear-lock",
        "action": "terraform.clear_lock"
      },
      {
        "id": "init",
        "note": "Preparing Terraform and its providers…",
        "argv": [
          "terraform",
          "init",
          "-input=false",
          "-no-color",
          "-backend-config=path=${run.state_dir}/terraform.tfstate"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 900
      },
      {
        "id": "apply",
        "note": "Creating the lab's machines in the cloud…",
        "argv": [
          "terraform",
          "apply",
          "-auto-approve",
          "-input=false",
          "-no-color"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 3600
      },
      {
        "id": "archive",
        "note": "Archiving the project…",
        "action": "project.archive",
        "with": {
          "root": "../../.."
        }
      },
      {
        "id": "deliver-gateway",
        "note": "Copying the project into gateway…",
        "action": "ssh.run",
        "with": {
          "command": "sudo sh -c 'mkdir -p /opt/isoloom /var/lib/isoloom && tar -xzf - -C /opt/isoloom && touch /var/lib/isoloom/project-delivered'",
          "host": "${outputs.address_gateway}",
          "user": "admin",
          "wait_s": "900"
        },
        "stdin": "${run.state_dir}/project.tgz",
        "timeout_s": 1500
      },
      {
        "id": "deliver-app",
        "note": "Copying the project into app…",
        "action": "ssh.run",
        "with": {
          "command": "sudo sh -c 'mkdir -p /opt/isoloom /var/lib/isoloom && tar -xzf - -C /opt/isoloom && touch /var/lib/isoloom/project-delivered'",
          "host": "${outputs.address_app}",
          "user": "admin",
          "wait_s": "900"
        },
        "stdin": "${run.state_dir}/project.tgz",
        "timeout_s": 1500
      },
      {
        "id": "deliver-db",
        "note": "Copying the project into db…",
        "action": "ssh.run",
        "with": {
          "command": "sudo sh -c 'mkdir -p /opt/isoloom /var/lib/isoloom && tar -xzf - -C /opt/isoloom && touch /var/lib/isoloom/project-delivered'",
          "host": "${outputs.address_db}",
          "user": "admin",
          "wait_s": "900"
        },
        "stdin": "${run.state_dir}/project.tgz",
        "timeout_s": 1500
      },
      {
        "id": "deliver-user",
        "note": "Copying the project into user…",
        "action": "ssh.run",
        "with": {
          "command": "sudo sh -c 'mkdir -p /opt/isoloom /var/lib/isoloom && tar -xzf - -C /opt/isoloom && touch /var/lib/isoloom/project-delivered'",
          "host": "${outputs.address_user}",
          "user": "admin",
          "wait_s": "900"
        },
        "stdin": "${run.state_dir}/project.tgz",
        "timeout_s": 1500
      }
    ],
    "down": [
      {
        "id": "clear-lock",
        "action": "terraform.clear_lock"
      },
      {
        "id": "init",
        "note": "Preparing Terraform and its providers…",
        "argv": [
          "terraform",
          "init",
          "-input=false",
          "-no-color",
          "-backend-config=path=${run.state_dir}/terraform.tfstate"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 900
      },
      {
        "id": "destroy",
        "note": "Removing the lab from the cloud…",
        "argv": [
          "terraform",
          "destroy",
          "-auto-approve",
          "-input=false",
          "-no-color"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 3600
      }
    ],
    "seal": {
      "param": "isoloom_sealed",
      "steps": [
        {
          "id": "seal",
          "note": "Closing the internet to the networks without it…",
          "argv": [
            "terraform",
            "apply",
            "-auto-approve",
            "-input=false",
            "-no-color"
          ],
          "env": {
            "TF_DATA_DIR": "${run.state_dir}/.terraform",
            "TF_INPUT": "0",
            "TF_IN_AUTOMATION": "1",
            "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
          },
          "timeout_s": 3600
        }
      ]
    },
    "status": {
      "id": "state",
      "action": "terraform.read_state"
    }
  },
  "ready": [
    {
      "kind": "step_ok",
      "step": "apply",
      "means": "the machines exist and booted; each sets itself up from its user data once the project is in"
    },
    {
      "kind": "ready_file",
      "host": "${outputs.address_gateway}",
      "user": "admin",
      "path": "${outputs.ready_file}",
      "log": "/var/log/isoloom-setup.log",
      "grammar": "isoloom-ready/1",
      "timeout_s": 2400,
      "unreachable_timeout_s": 600,
      "interval_s": 10
    },
    {
      "kind": "ready_file",
      "host": "${outputs.address_app}",
      "user": "admin",
      "path": "${outputs.ready_file}",
      "log": "/var/log/isoloom-setup.log",
      "grammar": "isoloom-ready/1",
      "timeout_s": 2400,
      "unreachable_timeout_s": 600,
      "interval_s": 10
    },
    {
      "kind": "ready_file",
      "host": "${outputs.address_db}",
      "user": "admin",
      "path": "${outputs.ready_file}",
      "log": "/var/log/isoloom-setup.log",
      "grammar": "isoloom-ready/1",
      "timeout_s": 2400,
      "unreachable_timeout_s": 600,
      "interval_s": 10
    },
    {
      "kind": "ready_file",
      "host": "${outputs.address_user}",
      "user": "admin",
      "path": "${outputs.ready_file}",
      "log": "/var/log/isoloom-setup.log",
      "grammar": "isoloom-ready/1",
      "timeout_s": 2400,
      "unreachable_timeout_s": 600,
      "interval_s": 10
    }
  ],
  "outputs": [
    {
      "name": "ip",
      "description": "Where to stand: the access machine's public address (the first Linux machine's, else the controller's).",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ip"
      }
    },
    {
      "name": "ready_file",
      "description": "Where each Linux machine's set-up says how far it got (isoloom-ready/1).",
      "role": "info",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ready_file"
      }
    },
    {
      "name": "address_gateway",
      "description": "gateway's public address: the runner's SSH and its published ports reach it there.",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "address_gateway"
      }
    },
    {
      "name": "ssh_user_gateway",
      "description": "The user the runner's key lets in on gateway.",
      "role": "info",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ssh_user_gateway"
      }
    },
    {
      "name": "address_app",
      "description": "app's public address: the runner's SSH and its published ports reach it there.",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "address_app"
      }
    },
    {
      "name": "ssh_user_app",
      "description": "The user the runner's key lets in on app.",
      "role": "info",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ssh_user_app"
      }
    },
    {
      "name": "address_db",
      "description": "db's public address: the runner's SSH and its published ports reach it there.",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "address_db"
      }
    },
    {
      "name": "ssh_user_db",
      "description": "The user the runner's key lets in on db.",
      "role": "info",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ssh_user_db"
      }
    },
    {
      "name": "address_user",
      "description": "user's public address: the runner's SSH and its published ports reach it there.",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "address_user"
      }
    },
    {
      "name": "ssh_user_user",
      "description": "The user the runner's key lets in on user.",
      "role": "info",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ssh_user_user"
      }
    }
  ],
  "checks": {
    "protocol": "isoloom-check/1",
    "setup": [],
    "runners": [
      {
        "id": "user",
        "from": "from user",
        "checks": [
          {
            "name": "checks/dmz-reachable.sh",
            "kind": "script",
            "wait_s": 0,
            "derived": false
          },
          {
            "name": "checks/internal-not-reachable-from-access.sh",
            "kind": "script",
            "wait_s": 0,
            "derived": false
          },
          {
            "name": "gateway:80 on dmz from user",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "gateway:22 on dmz from user",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "app:8080 blocked from user",
            "kind": "tcp",
            "wait_s": 0,
            "derived": true
          },
          {
            "name": "db:5432 blocked from user",
            "kind": "tcp",
            "wait_s": 0,
            "derived": true
          }
        ],
        "step": {
          "id": "check-user",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} sh .isoloom/cloud-vm/checks/user.sh",
            "host": "${outputs.address_user}",
            "user": "admin"
          },
          "timeout_s": 210
        }
      },
      {
        "id": "gateway",
        "from": "from gateway",
        "checks": [
          {
            "name": "app:8080 from gateway",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "db:5432 from gateway",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          }
        ],
        "step": {
          "id": "check-gateway",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} sh .isoloom/cloud-vm/checks/gateway.sh",
            "host": "${outputs.address_gateway}",
            "user": "admin"
          },
          "timeout_s": 150
        }
      },
      {
        "id": "app",
        "from": "from app",
        "checks": [
          {
            "name": "gateway:80 on internal from app",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "gateway:22 on internal from app",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "db:5432 from app",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "no internet from app",
            "kind": "http",
            "wait_s": 0,
            "derived": true
          }
        ],
        "step": {
          "id": "check-app",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} sh .isoloom/cloud-vm/checks/app.sh",
            "host": "${outputs.address_app}",
            "user": "admin"
          },
          "timeout_s": 210
        }
      },
      {
        "id": "db",
        "from": "from db",
        "checks": [
          {
            "name": "gateway:80 on internal from db",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "gateway:22 on internal from db",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "app:8080 from db",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "no internet from db",
            "kind": "http",
            "wait_s": 0,
            "derived": true
          }
        ],
        "step": {
          "id": "check-db",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} sh .isoloom/cloud-vm/checks/db.sh",
            "host": "${outputs.address_db}",
            "user": "admin"
          },
          "timeout_s": 210
        }
      }
    ],
    "teardown": []
  },
  "recovery": {
    "retries": 0,
    "apply_retries": 1
  },
  "expiry": {
    "tf_var": "expires_at",
    "unit": "unix_seconds",
    "default_minutes": 240
  }
}

## .isoloom/cloud-vm/oci/main.tf
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  terraform -chdir=.isoloom/cloud-vm/oci init && terraform -chdir=.isoloom/cloud-vm/oci apply \
#           -var compartment_id=<compartment ocid> -var allowed_cidr=<your IP>/32 \
#           -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)"
# Stop:   terraform -chdir=.isoloom/cloud-vm/oci destroy (same variables)
# Auth:   the oci provider reads ~/.oci/config; region defaults, override with -var region=<id>.
# Then:   the machines wait for the project: run the lab through the runner (run.json) beside this file,
#         which delivers the project over SSH, waits for each set-up and runs the checks.

terraform {
  required_version = ">= 1.6.0"
  backend "local" {}
  required_providers {
    oci = { source = "oracle/oci", version = "~> 9.8.0" }
  }
}

variable "compartment_id" {
  type        = string
  description = "The compartment the environment goes in"
}

variable "region" {
  type        = string
  default     = "eu-paris-1"
  description = "The OCI region to launch in"
}

variable "config_file_profile" {
  type        = string
  default     = "DEFAULT"
  description = "The profile of the OCI CLI's configuration (~/.oci/config) the provider signs in with"
}

variable "isoloom_sealed" {
  type        = bool
  default     = false
  description = "Close the internet to the machines of every `internet: false` network, at the network: the runner sets it once the machines are set up"
}

variable "allowed_cidr" {
  type        = string
  description = "Who may reach the machines (SSH and the published ports), e.g. your IP/32"
}

variable "ssh_public_key" {
  type        = string
  description = "The SSH public key the machines let in: whoever holds its private key signs in, as the runner (run.json) does to deliver the project and run the checks"
}

variable "expires_at" {
  type        = string
  default     = ""
  description = "When the environment should end, in Unix seconds (empty: no end): a tag on every resource, so a reaper finds what to destroy, and the time the machines shut themselves down"
}

provider "oci" {
  region              = var.region
  config_file_profile = var.config_file_profile
}

resource "terraform_data" "id" {
  input = substr(replace(uuid(), "-", ""), 0, 8)
  lifecycle {
    ignore_changes = [input]
  }
}

locals {
  name = "isoloom-dmz-jump-${terraform_data.id.output}"
  tags = merge({ isoloom-environment = "dmz-jump", managed-by = "isoloom", isoloom-instance = local.name }, var.expires_at == "" ? {} : { isoloom-expires-at = var.expires_at })
}

# The compartment's availability domains; the instances land in the first.
data "oci_identity_availability_domains" "ads" {
  compartment_id = var.compartment_id
}

# Ubuntu 24.04: Oracle Cloud has no Debian image of its own.
data "oci_core_images" "ubuntu_2404" {
  compartment_id           = var.compartment_id
  operating_system         = "Canonical Ubuntu"
  operating_system_version = "24.04"
  shape                    = "VM.Standard.E4.Flex"
  sort_by                  = "TIMECREATED"
  sort_order               = "DESC"
}

# The environment's networks: a VCN holding each one's block, routed to the internet.
resource "oci_core_vcn" "env" {
  compartment_id = var.compartment_id
  freeform_tags  = local.tags
  display_name   = local.name
  cidr_blocks    = ["10.30.10.0/24", "10.30.20.0/24", "10.30.99.0/24"]
}

resource "oci_core_internet_gateway" "env" {
  compartment_id = var.compartment_id
  freeform_tags  = local.tags
  vcn_id         = oci_core_vcn.env.id
  display_name   = local.name
}

resource "oci_core_route_table" "env" {
  compartment_id = var.compartment_id
  freeform_tags  = local.tags
  vcn_id         = oci_core_vcn.env.id
  display_name   = local.name
  route_rules {
    destination       = "0.0.0.0/0"
    network_entity_id = oci_core_internet_gateway.env.id
  }
}

# Network `dmz`: what may reach its machines, and where they may go.
resource "oci_core_security_list" "dmz" {
  compartment_id = var.compartment_id
  freeform_tags  = local.tags
  vcn_id         = oci_core_vcn.env.id
  display_name   = "${local.name}-dmz"
  ingress_security_rules {
    description = "its own network"
    source      = "10.30.10.0/24"
    protocol    = "all"
  }
  ingress_security_rules {
    description = "reach from access"
    source      = "10.30.99.0/24"
    protocol    = "all"
  }
  ingress_security_rules {
    description = "SSH from allowed_cidr"
    source      = var.allowed_cidr
    protocol    = "6"
    tcp_options {
      min = 22
      max = 22
    }
  }
  ingress_security_rules {
    description = "path MTU discovery"
    source      = "0.0.0.0/0"
    protocol    = "1"
    icmp_options {
      type = 3
      code = 4
    }
  }
  egress_security_rules {
    description = "its own network"
    destination = "10.30.10.0/24"
    protocol    = "all"
  }
  egress_security_rules {
    description = "reach to internal"
    destination = "10.30.20.0/24"
    protocol    = "6"
    tcp_options {
      min = 8080
      max = 8080
    }
  }
  egress_security_rules {
    description = "reach to internal"
    destination = "10.30.20.0/24"
    protocol    = "17"
    udp_options {
      min = 8080
      max = 8080
    }
  }
  egress_security_rules {
    description = "reach to internal"
    destination = "10.30.20.0/24"
    protocol    = "6"
    tcp_options {
      min = 5432
      max = 5432
    }
  }
  egress_security_rules {
    description = "reach to internal"
    destination = "10.30.20.0/24"
    protocol    = "17"
    udp_options {
      min = 5432
      max = 5432
    }
  }
  egress_security_rules {
    description = "the internet"
    destination = "0.0.0.0/5"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "8.0.0.0/7"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "11.0.0.0/8"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "12.0.0.0/6"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "16.0.0.0/4"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "32.0.0.0/3"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "64.0.0.0/2"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "128.0.0.0/3"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "160.0.0.0/5"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "168.0.0.0/6"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "172.0.0.0/12"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "172.32.0.0/11"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "172.64.0.0/10"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "172.128.0.0/9"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "173.0.0.0/8"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "174.0.0.0/7"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "176.0.0.0/4"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "192.0.0.0/9"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "192.128.0.0/11"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "192.160.0.0/13"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "192.169.0.0/16"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "192.170.0.0/15"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "192.172.0.0/14"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "192.176.0.0/12"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "192.192.0.0/10"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "193.0.0.0/8"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "194.0.0.0/7"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "196.0.0.0/6"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "200.0.0.0/5"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "208.0.0.0/4"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "224.0.0.0/3"
    protocol    = "all"
  }
  egress_security_rules {
    description = "path MTU discovery"
    destination = "0.0.0.0/0"
    protocol    = "1"
    icmp_options {
      type = 3
      code = 4
    }
  }
}

resource "oci_core_subnet" "dmz" {
  compartment_id    = var.compartment_id
  freeform_tags     = local.tags
  vcn_id            = oci_core_vcn.env.id
  cidr_block        = "10.30.10.0/24"
  display_name      = "${local.name}-dmz"
  route_table_id    = oci_core_route_table.env.id
  security_list_ids = [oci_core_security_list.dmz.id]
}

# Network `internal`: what may reach its machines, and where they may go.
resource "oci_core_security_list" "internal" {
  compartment_id = var.compartment_id
  freeform_tags  = local.tags
  vcn_id         = oci_core_vcn.env.id
  display_name   = "${local.name}-internal"
  ingress_security_rules {
    description = "its own network"
    source      = "10.30.20.0/24"
    protocol    = "all"
  }
  ingress_security_rules {
    description = "reach from dmz"
    source      = "10.30.10.0/24"
    protocol    = "6"
    tcp_options {
      min = 8080
      max = 8080
    }
  }
  ingress_security_rules {
    description = "reach from dmz"
    source      = "10.30.10.0/24"
    protocol    = "17"
    udp_options {
      min = 8080
      max = 8080
    }
  }
  ingress_security_rules {
    description = "reach from dmz"
    source      = "10.30.10.0/24"
    protocol    = "6"
    tcp_options {
      min = 5432
      max = 5432
    }
  }
  ingress_security_rules {
    description = "reach from dmz"
    source      = "10.30.10.0/24"
    protocol    = "17"
    udp_options {
      min = 5432
      max = 5432
    }
  }
  ingress_security_rules {
    description = "SSH from allowed_cidr"
    source      = var.allowed_cidr
    protocol    = "6"
    tcp_options {
      min = 22
      max = 22
    }
  }
  ingress_security_rules {
    description = "path MTU discovery"
    source      = "0.0.0.0/0"
    protocol    = "1"
    icmp_options {
      type = 3
      code = 4
    }
  }
  egress_security_rules {
    description = "its own network"
    destination = "10.30.20.0/24"
    protocol    = "all"
  }
  dynamic "egress_security_rules" {
    for_each = var.isoloom_sealed ? [] : ["0.0.0.0/5", "8.0.0.0/7", "11.0.0.0/8", "12.0.0.0/6", "16.0.0.0/4", "32.0.0.0/3", "64.0.0.0/2", "128.0.0.0/3", "160.0.0.0/5", "168.0.0.0/6", "172.0.0.0/12", "172.32.0.0/11", "172.64.0.0/10", "172.128.0.0/9", "173.0.0.0/8", "174.0.0.0/7", "176.0.0.0/4", "192.0.0.0/9", "192.128.0.0/11", "192.160.0.0/13", "192.169.0.0/16", "192.170.0.0/15", "192.172.0.0/14", "192.176.0.0/12", "192.192.0.0/10", "193.0.0.0/8", "194.0.0.0/7", "196.0.0.0/6", "200.0.0.0/5", "208.0.0.0/4", "224.0.0.0/3"]
    content {
      description = "the internet, until the run is sealed"
      destination = egress_security_rules.value
      protocol    = "all"
    }
  }
  egress_security_rules {
    description = "path MTU discovery"
    destination = "0.0.0.0/0"
    protocol    = "1"
    icmp_options {
      type = 3
      code = 4
    }
  }
}

