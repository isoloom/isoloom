fi

echo "isoloom-check: END $passed passed, $failed failed"
[ "$failed" -eq 0 ]

## .isoloom/docker/compose.yml
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  docker compose -f .isoloom/docker/compose.yml up -d --wait
# Checks: isothrum check . (or: docker compose -f .isoloom/docker/compose.yml --profile check run --rm isoloom-check, and isoloom-check-<machine>)
# Stop:   docker compose -f .isoloom/docker/compose.yml down -v

name: cisco-switch
services:
  sw1:
    image: vrnetlab/cisco_iol:L2-17.12.01
    platform: linux/amd64
    entrypoint:
    - /bin/sh
    - -c
    - cat /iol/base.txt /iol/own.txt > /iol/config.txt 2>/dev/null; echo end >> /iol/config.txt; exec /entrypoint.sh
    hostname: sw1
    networks:
      isoloom-mgmt:
        ipv4_address: 10.255.255.10
        interface_name: eth0
        priority: 1000
      office-vlan10:
        ipv4_address: 10.92.10.253
        interface_name: eth1
        priority: 999
      office-vlan20:
        ipv4_address: 10.92.20.253
        interface_name: eth2
        priority: 998
      isoloom-trunk-office-files:
        interface_name: eth3
        priority: 997
    cap_add:
    - NET_ADMIN
    - NET_RAW
    extra_hosts:
    - files:10.92.10.10
    - staff:10.92.10.20
    - guest:10.92.20.20
    environment:
      IOL_PID: '1'
    volumes:
    - ./appliances/sw1/base.txt:/iol/base.txt:ro
    - ./appliances/sw1/NETMAP:/iol/NETMAP:ro
    - ./appliances/sw1/iouyap.ini:/iol/iouyap.ini:ro
    - ../../configs/sw1.cfg:/iol/own.txt:ro
    labels:
      isoloom.managed: 'true'
      isoloom.environment: cisco-switch
    restart: unless-stopped
  sw1-routes:
    image: alpine:3.20
    init: true
    entrypoint:
    - /bin/sh
    - -c
    - ip addr flush dev eth1 && ip addr flush dev eth2 && ip addr flush dev eth3 && while ip -o -4 addr show | grep -qv ' lo '; do sleep 2; done; exit 1
    network_mode: service:sw1
    cap_add:
    - NET_ADMIN
    healthcheck:
      test:
      - CMD-SHELL
      - '! ip -o -4 addr show | grep -q '' eth[1-9]'''
      interval: 2s
      timeout: 2s
      retries: 30
    depends_on:
      sw1:
        condition: service_started
    labels:
      isoloom.managed: 'true'
      isoloom.environment: cisco-switch
    restart: unless-stopped
  files:
    image: nginx:1.27-alpine
    platform: linux/amd64
    hostname: files
    networks:
      isoloom-trunk-office-files:
        mac_address: 02:1e:72:d0:bc:1c
    extra_hosts:
    - staff:10.92.10.20
    - guest:10.92.20.20
    volumes:
    - isoloom-probe-amd64:/.isoloom-probe:ro
    healthcheck:
      test:
      - CMD
      - /.isoloom-probe/busybox
      - sh
      - -c
      - /.isoloom-probe/busybox nc -z -w 2 127.0.0.1 80
      interval: 5s
      timeout: 3s
      retries: 60
      start_period: 10s
    depends_on:
      isoloom-probe-amd64:
        condition: service_completed_successfully
    labels:
      isoloom.port.web: http:80
      isoloom.managed: 'true'
      isoloom.environment: cisco-switch
    restart: unless-stopped
  files-routes:
    image: nicolaka/netshoot:v0.13
    init: true
    entrypoint:
    - /bin/sh
    - -c
    - 'IF=$$(ip -o link | awk ''tolower($$0) ~ /02:1e:72:d0:bc:1c/ {print $$2}'' | cut -d@ -f1 | tr -d : | head -n 1) && ip addr flush dev $$IF && ip link set $$IF down && ip link set $$IF name office && ip link set office up && ip link add link office name office.10 type vlan id 10 && ip addr add 10.92.10.10/24 dev office.10 && ip link set office.10 up && ip link add link office name office.20 type vlan id 20 && ip addr add 10.92.20.10/24 dev office.20 && ip link set office.20 up && while ip -o -4 addr show | grep -qv '' lo ''; do sleep 2; done; exit 1'
    network_mode: service:files
    cap_add:
    - NET_ADMIN
    healthcheck:
      test:
      - CMD-SHELL
      - ip link show office.10 | grep -q 'UP' && ip link show office.20 | grep -q 'UP'
      interval: 2s
      timeout: 2s
      retries: 30
    depends_on:
      files:
        condition: service_started
      sw1:
        condition: service_started
    labels:
      isoloom.managed: 'true'
      isoloom.environment: cisco-switch
    restart: unless-stopped
  staff:
    image: alpine:3.19@sha256:6baf43584bcb78f2e5847d1de515f23499913ac9f12bdf834811a3145eb11ca1
    platform: linux/amd64
    init: true
    entrypoint:
    - sleep
    - infinity
    hostname: staff
    networks:
      office-vlan10:
        ipv4_address: 10.92.10.20
    extra_hosts:
    - files:10.92.10.10
    - guest:10.92.20.20
    labels:
      isoloom.managed: 'true'
      isoloom.environment: cisco-switch
    restart: unless-stopped
  guest:
    image: alpine:3.19@sha256:6baf43584bcb78f2e5847d1de515f23499913ac9f12bdf834811a3145eb11ca1
    platform: linux/amd64
    init: true
    entrypoint:
    - sleep
    - infinity
    hostname: guest
    networks:
      office-vlan20:
        ipv4_address: 10.92.20.20
    extra_hosts:
    - files:10.92.20.10
    - staff:10.92.10.20
    labels:
      isoloom.managed: 'true'
      isoloom.environment: cisco-switch
    restart: unless-stopped
  isoloom-check-files:
    image: curlimages/curl:8.11.1
    profiles:
    - check
    entrypoint:
    - /bin/sh
    - /isoloom/run.sh
    network_mode: service:files
    volumes:
    - ./checks/files.sh:/isoloom/run.sh:ro
    depends_on:
      sw1-routes:
        condition: service_healthy
      files:
        condition: service_healthy
      files-routes:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: cisco-switch
  isoloom-check-staff:
    image: curlimages/curl:8.11.1
    profiles:
    - check
    entrypoint:
    - /bin/sh
    - /isoloom/run.sh
    network_mode: service:staff
    volumes:
    - ./checks/staff.sh:/isoloom/run.sh:ro
    depends_on:
      sw1-routes:
        condition: service_healthy
      files:
        condition: service_healthy
      files-routes:
        condition: service_healthy
      staff:
        condition: service_started
    labels:
      isoloom.managed: 'true'
      isoloom.environment: cisco-switch
  isoloom-check-guest:
    image: curlimages/curl:8.11.1
    profiles:
    - check
    entrypoint:
    - /bin/sh
    - /isoloom/run.sh
    network_mode: service:guest
    volumes:
    - ./checks/guest.sh:/isoloom/run.sh:ro
    depends_on:
      sw1-routes:
        condition: service_healthy
      files:
        condition: service_healthy
      files-routes:
        condition: service_healthy
      guest:
        condition: service_started
    labels:
      isoloom.managed: 'true'
      isoloom.environment: cisco-switch
  isoloom-probe-amd64:
    image: busybox:1.37.0-musl
    platform: linux/amd64
    entrypoint:
    - /bin/cp
    - /bin/busybox
    - /probe/busybox
    network_mode: none
    volumes:
    - isoloom-probe-amd64:/probe
    labels:
      isoloom.managed: 'true'
      isoloom.environment: cisco-switch
    restart: no
networks:
  office-vlan10:
    ipam:
      config:
      - subnet: 10.92.10.0/24
        gateway: 10.92.10.1
    internal: true
    labels:
      isoloom.managed: 'true'
      isoloom.environment: cisco-switch
  office-vlan20:
    ipam:
      config:
      - subnet: 10.92.20.0/24
        gateway: 10.92.20.1
    internal: true
    labels:
      isoloom.managed: 'true'
      isoloom.environment: cisco-switch
  isoloom-trunk-office-files:
    internal: true
    labels:
      isoloom.managed: 'true'
      isoloom.environment: cisco-switch
  isoloom-mgmt:
    ipam:
      config:
      - subnet: 10.255.255.0/24
    labels:
      isoloom.managed: 'true'
      isoloom.environment: cisco-switch
volumes:
  isoloom-probe-amd64:
    labels:
      isoloom.managed: 'true'
      isoloom.environment: cisco-switch

## .isoloom/docker/run.json
{
  "$schema": "https://www.isoloom.com/schema/run-manifest/v0.json",
  "manifest_version": 0,
  "generator": {
    "name": "isoloom",
    "version": "1.0.0"
  },
  "environment": {
    "name": "cisco-switch",
    "instance": null,
    "message": null
  },
  "target": "docker",
  "driver": "compose",
  "hosts": [
    "linux",
    "macos",
    "windows"
  ],
  "tools": [
    {
      "name": "docker",
      "probe": [
        "docker",
        "info",
        "--format",
        "{{.ServerVersion}}"
      ]
    },
    {
      "name": "docker-compose",
      "probe": [
        "docker",
        "compose",
        "version",
        "--short"
      ],
      "min_version": "2.17.0"
    }
  ],
  "identity": {
    "compose": {
      "project": "${run.name}",
      "files": [
        "compose.yml",
        "${run.state_dir}/ports.yml"
      ],
      "pinned_ports_file": "${run.state_dir}/ports.yml"
    }
  },
  "params": [
    {
      "name": "ISOLOOM_DERIVED",
      "description": "0: the checks derived from the spec (reachability, no internet) are skipped.",
      "default": "1",
      "values": [
        "0",
        "1"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_DERIVED",
          "steps": [
            "check-files",
            "check-staff",
            "check-guest"
          ]
        }
      ]
    }
  ],
  "secrets": [],
  "networks": [
    {
      "name": "office-vlan10",
      "cidr": "10.92.10.0/24",
      "internet": false,
      "native": "${run.name}_office-vlan10"
    },
    {
      "name": "office-vlan20",
      "cidr": "10.92.20.0/24",
      "internet": false,
      "native": "${run.name}_office-vlan20"
    }
  ],
  "machines": [
    {
      "name": "sw1",
      "role": "target",
      "arch": "amd64",
      "addresses": {},
      "native": {
        "service": "sw1"
      }
    },
    {
      "name": "sw1-routes",
      "role": "infra",
      "of": "sw1",
      "addresses": {},
      "native": {
        "service": "sw1-routes"
      }
    },
    {
      "name": "files",
      "role": "target",
      "arch": "amd64",
      "addresses": {
        "office-vlan10": "10.92.10.10",
        "office-vlan20": "10.92.20.10"
      },
      "native": {
        "service": "files"
      },
      "ports": [
        {
          "name": "web",
          "port": 80,
          "protocol": "tcp",
          "http": true
        }
      ]
    },
    {
      "name": "files-routes",
      "role": "infra",
      "of": "files",
      "addresses": {},
      "native": {
        "service": "files-routes"
      }
    },
    {
      "name": "staff",
      "role": "target",
      "arch": "amd64",
      "addresses": {
        "office-vlan10": "10.92.10.20"
      },
      "native": {
        "service": "staff"
      }
    },
    {
      "name": "guest",
      "role": "target",
      "arch": "amd64",
      "addresses": {
        "office-vlan20": "10.92.20.20"
      },
      "native": {
        "service": "guest"
      }
    },
    {
      "name": "isoloom-check-files",
      "role": "check",
      "of": "files",
      "addresses": {},
      "native": {
        "service": "isoloom-check-files"
      }
    },
    {
      "name": "isoloom-check-staff",
      "role": "check",
      "of": "staff",
      "addresses": {},
      "native": {
        "service": "isoloom-check-staff"
      }
    },
    {
      "name": "isoloom-check-guest",
      "role": "check",
      "of": "guest",
      "addresses": {},
      "native": {
        "service": "isoloom-check-guest"
      }
    },
    {
      "name": "isoloom-probe-amd64",
      "role": "infra",
      "addresses": {},
      "native": {
        "service": "isoloom-probe-amd64"
      }
    }
  ],
  "lifecycle": {
    "up": [
      {
        "id": "pin-ports",
        "note": "Picking the lab's host ports…",
        "action": "compose.pin_ports"
      },
      {
        "id": "ports-free",
        "action": "compose.check_ports_free"
      },
      {
        "id": "stale-networks",
        "action": "compose.remove_stale_networks",
        "failure": "tolerate"
      },
      {
        "id": "up",
        "note": "Starting the lab's containers…",
        "argv": [
          "docker",
          "compose",
          "--project-name",
          "${run.name}",
          "--file",
          "compose.yml",
          "--file",
          "${run.state_dir}/ports.yml",
          "up",
          "--detach",
          "--build",
          "--pull",
          "missing",
          "--wait",
          "--wait-timeout",
          "600"
        ],
        "timeout_s": 1800
      }
    ],
    "down": [
      {
        "id": "down",
        "argv": [
          "docker",
          "compose",
          "--project-name",
          "${run.name}",
          "--file",
          "compose.yml",
          "--file",
          "${run.state_dir}/ports.yml",
          "--profile",
          "check",
          "down",
          "--volumes",
          "--remove-orphans"
        ],
        "timeout_s": 300,
        "when": "always"
      },
      {
        "id": "containers",
        "action": "compose.remove_containers",
        "when": "always",
        "failure": "tolerate"
      },
      {
        "id": "networks",
        "action": "compose.remove_networks",
        "when": "always",
        "failure": "tolerate"
      }
    ],
    "park": {
      "pause": [
        {
          "id": "stop",
          "argv": [
            "docker",
            "compose",
            "--project-name",
            "${run.name}",
            "--file",
            "compose.yml",
            "--file",
            "${run.state_dir}/ports.yml",
            "stop"
          ],
          "timeout_s": 300
        }
      ],
      "shutdown": [
        {
          "id": "stop",
          "argv": [
            "docker",
            "compose",
            "--project-name",
            "${run.name}",
            "--file",
            "compose.yml",
            "--file",
            "${run.state_dir}/ports.yml",
            "stop"
          ],
          "timeout_s": 300
        }
      ]
    },
    "resume": [
      {
        "id": "start",
        "argv": [
          "docker",
          "compose",
          "--project-name",
          "${run.name}",
          "--file",
          "compose.yml",
          "--file",
          "${run.state_dir}/ports.yml",
          "start"
        ],
        "timeout_s": 600
      }
    ],
    "status": {
      "id": "ps",
      "argv": [
        "docker",
        "compose",
        "--project-name",
        "${run.name}",
        "--file",
        "compose.yml",
        "--file",
        "${run.state_dir}/ports.yml",
        "ps",
        "--all",
        "--format",
        "json"
      ],
      "timeout_s": 25
    }
  },
  "ready": [
    {
      "kind": "step_ok",
      "step": "up",
      "means": "every long-running service is healthy (`--wait`: each port's probe, the route keepers, the machines' own healthchecks)"
    }
  ],
  "outputs": [],
  "checks": {
    "protocol": "isoloom-check/1",
    "setup": [],
    "runners": [
      {
        "id": "isoloom-check-files",
        "from": "from files",
        "checks": [
          {
            "name": "no internet from files",
            "kind": "http",
            "wait_s": 0,
            "derived": true
          }
        ],
        "step": {
          "id": "check-files",
          "argv": [
            "docker",
            "compose",
            "--project-name",
            "${run.name}",
            "--file",
            "compose.yml",
            "--file",
            "${run.state_dir}/ports.yml",
            "--profile",
            "check",
            "run",
            "--rm",
            "--no-deps",
            "--env",
            "ISOLOOM_DERIVED",
            "isoloom-check-files"
          ],
          "timeout_s": 75
        },
        "on_timeout": [
          {
            "id": "rm-check-files",
            "action": "compose.remove_containers",
            "with": {
              "one_off": "true",
              "service": "isoloom-check-files"
            },
            "failure": "tolerate"
          }
        ]
      },
      {
        "id": "isoloom-check-staff",
        "from": "from staff",
        "checks": [
          {
            "name": "staff reach the file server through the switch (VLAN 10, tagged on its trunk)",
            "kind": "http",
            "wait_s": 180,
            "derived": false
          },
          {
            "name": "files:80 on office-vlan10 from staff",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "no internet from staff",
            "kind": "http",
            "wait_s": 0,
            "derived": true
          }
        ],
        "step": {
          "id": "check-staff",
          "argv": [
            "docker",
            "compose",
            "--project-name",
            "${run.name}",
            "--file",
            "compose.yml",
            "--file",
            "${run.state_dir}/ports.yml",
            "--profile",
            "check",
            "run",
            "--rm",
            "--no-deps",
            "--env",
            "ISOLOOM_DERIVED",
            "isoloom-check-staff"
          ],
          "timeout_s": 315
        },
        "on_timeout": [
          {
            "id": "rm-check-staff",
            "action": "compose.remove_containers",
            "with": {
              "one_off": "true",
              "service": "isoloom-check-staff"
            },
            "failure": "tolerate"
          }
        ]
      },
      {
        "id": "isoloom-check-guest",
        "from": "from guest",
        "checks": [
          {
            "name": "guests too, on VLAN 20",
            "kind": "http",
            "wait_s": 180,
            "derived": false
          },
          {
            "name": "files:80 on office-vlan20 from guest",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "no internet from guest",
            "kind": "http",
            "wait_s": 0,
            "derived": true
          }
        ],
        "step": {
          "id": "check-guest",
          "argv": [
            "docker",
            "compose",
            "--project-name",
            "${run.name}",
            "--file",
            "compose.yml",
            "--file",
            "${run.state_dir}/ports.yml",
            "--profile",
            "check",
            "run",
            "--rm",
            "--no-deps",
            "--env",
            "ISOLOOM_DERIVED",
            "isoloom-check-guest"
          ],
          "timeout_s": 315
        },
        "on_timeout": [
          {
            "id": "rm-check-guest",
            "action": "compose.remove_containers",
            "with": {
              "one_off": "true",
              "service": "isoloom-check-guest"
            },
            "failure": "tolerate"
          }
        ]
      }
    ],
    "teardown": []
  },
  "recovery": {
    "stale_markers": [
      "is already in use by container",
      "network with name",
      "has incorrect label"
    ],
    "steps": [
      {
        "id": "containers",
        "action": "compose.remove_containers",
        "when": "always",
        "failure": "tolerate"
      },
      {
        "id": "networks",
        "action": "compose.remove_networks",
        "when": "always",
        "failure": "tolerate"
      }
    ],
    "retries": 1
  }
}

