      "external": "overrides.external.machines.sw1: the external target reaches machines that exist already, and `sw1` names no host",
      "cloud-services": "left out by `targets:`"
    },
    "clouds": {}
  },
  "checks": {
    "default_position": "networks",
    "positions": [
      {
        "position": "files",
        "machine": "files",
        "runner": "isoloom-check-files",
        "checks": [
          {
            "name": "no internet from files",
            "derived": true,
            "kind": "http",
            "target": "http://1.1.1.1/",
            "expect": "blocked",
            "wait": 0
          }
        ]
      },
      {
        "position": "staff",
        "machine": "staff",
        "runner": "isoloom-check-staff",
        "checks": [
          {
            "name": "staff reach the file server through the switch (VLAN 10, tagged on its trunk)",
            "derived": false,
            "kind": "http",
            "target": "http://10.92.10.10/",
            "expect": "200",
            "wait": 180
          },
          {
            "name": "files:80 on office-vlan10 from staff",
            "derived": true,
            "kind": "http",
            "target": "http://10.92.10.10:80/",
            "expect": "any",
            "wait": 30
          },
          {
            "name": "no internet from staff",
            "derived": true,
            "kind": "http",
            "target": "http://1.1.1.1/",
            "expect": "blocked",
            "wait": 0
          }
        ]
      },
      {
        "position": "guest",
        "machine": "guest",
        "runner": "isoloom-check-guest",
        "checks": [
          {
            "name": "guests too, on VLAN 20",
            "derived": false,
            "kind": "http",
            "target": "http://10.92.20.10/",
            "expect": "200",
            "wait": 180
          },
          {
            "name": "files:80 on office-vlan20 from guest",
            "derived": true,
            "kind": "http",
            "target": "http://10.92.20.10:80/",
            "expect": "any",
            "wait": 30
          },
          {
            "name": "no internet from guest",
            "derived": true,
            "kind": "http",
            "target": "http://1.1.1.1/",
            "expect": "blocked",
            "wait": 0
          }
        ]
      }
    ]
  }
