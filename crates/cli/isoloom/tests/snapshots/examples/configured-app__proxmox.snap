  isoloom_fetch "$1" "$_tmp" || {
    rm -f "$_tmp"
    isoloom_fail "downloading $1 failed"
    return 1
  }
  _got=$(isoloom_sha256 "$_tmp")
  if [ "$_got" != "$3" ]; then
    rm -f "$_tmp"
    isoloom_fail "$1 has SHA-256 $_got, not $3: the file changed upstream, or the pin is wrong"
    return 1
  fi
  mv -f "$_tmp" "$2" && isoloom_changed "$2"
