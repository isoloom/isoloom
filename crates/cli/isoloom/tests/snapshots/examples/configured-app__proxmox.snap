        mkdir -p "$_to" || exit 1
        isoloom_changed "$_to"
      fi
    else
      isoloom_put "$_from" "$_to" || exit 1
    fi
    isoloom_attrs "$_to" "$3" "$4" "$5" || exit 1
  done
}
isoloom_restart_due() {
  [ -n "${ISOLOOM_CHANGED:-}" ] && [ -e "$ISOLOOM_CHANGED" ]
}
isoloom_unit() {
  case $2 in
    '#!/sbin/openrc-run'*)
      isoloom_text "/etc/init.d/$1" "$2" && isoloom_attrs "/etc/init.d/$1" root root 0755
