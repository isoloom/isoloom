  shift 5
  case $_state in
    directory)
      if [ ! -d "$_path" ] || [ -L "$_path" ]; then
        rm -rf "$_path" && mkdir -p "$_path" || return 1
        isoloom_changed "$_path"
      fi
      ;;
    absent)
      if [ -e "$_path" ] || [ -L "$_path" ]; then
        rm -rf "$_path" || return 1
        isoloom_changed "$_path removed"
      fi
      return 0
      ;;
