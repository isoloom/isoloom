## .isoloom/proxmox/main.tf
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  terraform -chdir=.isoloom/proxmox init && terraform -chdir=.isoloom/proxmox apply -var proxmox_endpoint=https://<server>:8006/ -var proxmox_api_token=<user@realm!name=secret> \
#           -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)" -var ssh_private_key_file=~/.ssh/id_ed25519
# Stop:   terraform -chdir=.isoloom/proxmox destroy (same variables)

terraform {
  required_version = ">= 1.6.0"
  backend "local" {}
  required_providers {
    proxmox = { source = "bpg/proxmox", version = "~> 0.116.1" }
    tls     = { source = "hashicorp/tls", version = "~> 4.4.1" }
  }
}

variable "proxmox_endpoint" {
  type        = string
  description = "https://<server>:8006/"
}

variable "proxmox_api_token" {
  type        = string
  default     = ""
  sensitive   = true
  description = "user@realm!name=secret; or use proxmox_username and proxmox_password"
}

variable "proxmox_username" {
  type    = string
  default = "root@pam"
}

variable "proxmox_password" {
  type      = string
  default   = ""
  sensitive = true
}

variable "proxmox_insecure" {
  type        = bool
  default     = false
  description = "Accept the server's self-signed certificate (TLS isn't verified)"
}

variable "proxmox_ssh_username" {
  type        = string
  default     = "root"
  description = "Uploading cloud-init snippets goes over SSH to the node"
}

variable "proxmox_ssh_private_key_file" {
  type    = string
  default = ""
}

variable "proxmox_ssh_address" {
  type        = string
  default     = ""
  description = "The node's SSH address, when the API reports one this machine can't reach"
}

variable "node" {
  type        = string
  description = "The Proxmox node the VMs go on (`pvesh get /nodes` lists them)"
  validation {
    condition     = var.node != ""
    error_message = "Set `node` to the Proxmox node the environment's VMs go on (`pvesh get /nodes` lists them)."
  }
}

variable "datastore" {
  type        = string
  default     = "local-lvm"
  description = "Where VM disks go"
}

variable "image_datastore" {
  type        = string
  default     = "local"
  description = "A datastore with 'iso' content, for cloud images"
}

variable "snippets_datastore" {
  type        = string
  default     = "local"
  description = "A datastore with 'snippets' content, for cloud-init"
}

variable "uplink_bridge" {
  type        = string
  default     = "vmbr0"
  description = "The bridge the router reaches the internet through"
}

variable "slot" {
  type        = number
  default     = 1
  description = "1 to 99, unique per environment on this server (SDN ids are short)"
  validation {
    condition     = var.slot >= 1 && var.slot <= 99
    error_message = "slot is 1 to 99."
  }
}

variable "ssh_public_key" {
  type        = string
  description = "The SSH public key the machines let in: Terraform signs in with its private half (`ssh_private_key_file`) to set them up or wait for their set-up, and so can you, to run the checks"
}

variable "ssh_private_key_file" {
  type        = string
  description = "The private key of ssh_public_key (a path, ~ allowed): Terraform signs in to the machines with it to bring the project in and wait for their set-up"
}

provider "proxmox" {
  endpoint  = var.proxmox_endpoint
  api_token = var.proxmox_api_token != "" ? var.proxmox_api_token : null
  username  = var.proxmox_api_token != "" ? null : var.proxmox_username
  password  = var.proxmox_api_token != "" ? null : var.proxmox_password
  insecure  = var.proxmox_insecure
  ssh {
    agent       = false
    username    = var.proxmox_ssh_username
    password    = var.proxmox_ssh_private_key_file != "" ? null : var.proxmox_password
    private_key = var.proxmox_ssh_private_key_file != "" ? file(var.proxmox_ssh_private_key_file) : null
    dynamic "node" {
      for_each = var.proxmox_ssh_address == "" ? [] : [1]
      content {
        name    = var.node
        address = var.proxmox_ssh_address
      }
    }
  }
}

# The project, written to /opt/isoloom in each machine that has steps; the `isoloom` user on every VM.
locals {
  zone          = "iso${var.slot}"
  root          = abspath("${path.module}/../..")
  project_files = [for f in local.project_paths : { path = "/opt/isoloom/${f}", encoding = "b64", content = filebase64("${local.root}/${f}") }]
  users         = var.ssh_public_key == "" ? [] : [{ name = "isoloom", sudo = "ALL=(ALL) NOPASSWD:ALL", shell = "/bin/bash", ssh_authorized_keys = [var.ssh_public_key] }]
}

# The environment's VMs and containers, together in a pool of their own.
resource "proxmox_virtual_environment_pool" "env" {
  pool_id = local.zone
  comment = "Isoloom: configured-app"
}

# Applies the SDN deletions on destroy, once the zone and its VNets are gone: every SDN object depends on it, so it goes last.
resource "proxmox_sdn_applier" "finalizer" {}

# The environment's networks: an SDN simple zone, a VNet per network.
resource "proxmox_sdn_zone_simple" "env" {
  id         = local.zone
  nodes      = [var.node]
  depends_on = [proxmox_sdn_applier.finalizer]
}

# Network `lab`: 10.66.0.0/24
resource "proxmox_sdn_vnet" "lab" {
  id   = "i${var.slot}n0"
  zone = proxmox_sdn_zone_simple.env.id
}

# Applies the SDN objects once created, and again whenever one of them is replaced.
resource "proxmox_sdn_applier" "env" {
  lifecycle {
    replace_triggered_by = [proxmox_sdn_zone_simple.env, proxmox_sdn_vnet.lab]
  }
  depends_on = [proxmox_sdn_vnet.lab]
}

# The `debian-12` cloud image, per environment: a shared file would go with whichever environment is destroyed first.
resource "proxmox_download_file" "debian_12" {
  node_name           = var.node
  datastore_id        = var.image_datastore
  content_type        = "iso"
  url                 = "https://cloud.debian.org/images/cloud/bookworm/20261015-2632/debian-12-genericcloud-amd64-20261015-2632.qcow2"
  file_name           = "iso${var.slot}-debian-12.img"
  overwrite_unmanaged = true
  checksum            = "56c0bd55b6623f2739f377e983d2872e7b208d0cb9c3ba4e93d3f72929026da03637c598b3bd472b29998c31c8a4c17d8e6ae1c556852a8b83a66a09bf5c2b37"
  checksum_algorithm  = "sha512"
}

# The `ubuntu-24.04` cloud image, per environment: a shared file would go with whichever environment is destroyed first.
resource "proxmox_download_file" "ubuntu_24_04" {
  node_name           = var.node
  datastore_id        = var.image_datastore
  content_type        = "iso"
  url                 = "https://cloud-images.ubuntu.com/noble/20260926/noble-server-cloudimg-amd64.img"
  file_name           = "iso${var.slot}-ubuntu-24.04.img"
  overwrite_unmanaged = true
  checksum            = "6a81c37564db9b1ee84e141922625e1d7c5b389b99bb3c572e0243607d5bb4d2"
  checksum_algorithm  = "sha256"
}

# Network `lab`, for the machines' firewall rules.
resource "proxmox_virtual_environment_firewall_ipset" "lab" {
  name    = "iso${var.slot}n0"
  comment = "configured-app: network lab"
  cidr {
    name = "10.66.0.0/24"
  }
}

# The router: forwards between networks with the reach rules, and to the internet.
resource "proxmox_virtual_environment_file" "isoloom_router" {
  node_name    = var.node
  datastore_id = var.snippets_datastore
  content_type = "snippets"
  source_raw {
    file_name = "iso${var.slot}-isoloom-router.yaml"
    data = format("#cloud-config\n%s", yamlencode({
      hostname = "isoloom-router"
      users    = local.users
      packages = ["nftables", "qemu-guest-agent"]
      write_files = [
        {
          path    = "/etc/systemd/network/10-wan.network"
          content = join("\n", ["[Match]", "MACAddress=${format("02:15:%02x:00:00:00", var.slot)}", "", "[Network]", "DHCP=yes"])
        },
        {
          path    = "/etc/nftables.conf"
          content = "flush ruleset\ntable inet isoloom {\n  chain forward {\n    type filter hook forward priority 0; policy drop;\n    ct state established,related accept\n    ip daddr 10.66.0.10 tcp dport 80 ct status dnat accept\n    ip saddr { 10.66.0.0/24 } ip daddr != { 10.66.0.0/24 } accept\n  }\n  chain prerouting {\n    type nat hook prerouting priority -100;\n    ip saddr != { 10.66.0.0/24 } tcp dport 8086 dnat ip to 10.66.0.10:80\n  }\n  chain postrouting {\n    type nat hook postrouting priority 100;\n    ip saddr { 10.66.0.0/24 } ip daddr != { 10.66.0.0/24 } masquerade\n  }\n}\n"
        },
        { path = "/etc/sysctl.d/90-isoloom.conf", content = "net.ipv4.ip_forward=1\n" },
        {
          path = "/etc/systemd/network/20-lab.network"
          content = join("\n", [
            "[Match]",
            "MACAddress=${format("02:15:%02x:01:%02x:00", var.slot, 0)}",
            "",
            "[Network]",
            "Address=10.66.0.254/24",
            "ConfigureWithoutCarrier=yes"
          ])
        }
      ]
      runcmd = [
        "sysctl -p /etc/sysctl.d/90-isoloom.conf",
        "systemctl enable systemd-networkd",
        "systemctl restart systemd-networkd",
        "systemctl enable --now nftables",
        "nft -f /etc/nftables.conf",
        "i=0; while [ \"$i\" -lt 84 ] && ! ip -4 -o addr show scope global | awk '{split($4, a, \"/\"); print a[1]}' | grep -qvxF -e 10.66.0.254; do i=$((i + 1)); sleep 5; done; systemctl enable --now qemu-guest-agent"
      ]
    }))
  }
}

# The guest agent reports its uplink address (DHCP), for the published ports.
resource "proxmox_virtual_environment_vm" "isoloom_router" {
  name      = "iso${var.slot}-isoloom-router"
  node_name = var.node
  tags      = ["isoloom", "configured-app"]
  pool_id   = proxmox_virtual_environment_pool.env.pool_id
  on_boot   = false
  agent {
    enabled = true
    timeout = "8m"
    wait_for_ip {
      ipv4 = true
    }
  }
  stop_on_destroy = true
  lifecycle {
    postcondition {
      condition     = length([for a in try(flatten(self.ipv4_addresses), []) : a if a != "127.0.0.1" && !contains(["10.66.0.254"], a)]) > 0
      error_message = "VM `isoloom-router` got no IPv4 address on its uplink bridge `${var.uplink_bridge}` within 8m: the bridge has no DHCP, or no DNS or internet to install qemu-guest-agent, which reports the address (an IPv6 address alone isn't enough: the uplink needs IPv4 from DHCP). Give it an uplink bridge with DHCP and internet (`uplink_bridge`)."
    }
  }
  cpu {
    cores = 1
    type  = "host"
  }
  memory {
    dedicated = 512
  }
  disk {
    datastore_id = var.datastore
    file_id      = proxmox_download_file.debian_12.id
    interface    = "virtio0"
    size         = 8
  }
  network_device {
    bridge      = var.uplink_bridge
    mac_address = upper(format("02:15:%02x:00:00:00", var.slot))
  }
  network_device {
    bridge      = proxmox_sdn_vnet.lab.id
    mac_address = upper(format("02:15:%02x:01:%02x:00", var.slot, 0))
  }
  initialization {
    datastore_id      = var.datastore
    user_data_file_id = proxmox_virtual_environment_file.isoloom_router.id
    ip_config {
      ipv4 {
        address = "dhcp"
      }
    }
  }
  operating_system {
    type = "l26"
  }
  serial_device {}
  depends_on = [proxmox_sdn_applier.env]
}

# Machine `web`.
resource "proxmox_virtual_environment_file" "web" {
  node_name    = var.node
  datastore_id = var.snippets_datastore
  content_type = "snippets"
  source_raw {
    file_name = "iso${var.slot}-web.yaml"
    data = format("#cloud-config\n%s", yamlencode({
      hostname = "web"
      users    = local.users
      packages = ["nftables", "curl", "netcat-openbsd"]
      write_files = concat(local.project_files, [
        {
          path        = "/var/lib/isoloom/configure/configure-0.sh"
          encoding    = "gz+b64"
          permissions = "0700"
          content     = "<gzip 1>"
        }
      ])
      runcmd = [
        "mkdir -p /var/lib/isoloom",
        "echo 'running: hosts file' > /var/lib/isoloom/ready; sh -c 'printf '\\''%s\\n'\\'' '\\''10.66.0.10 web'\\'' '\\''10.66.0.20 api'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done' || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }",
        "echo 'running: its configuration' > /var/lib/isoloom/ready; sh /var/lib/isoloom/configure/configure-0.sh || { echo 'failed: its configuration' > /var/lib/isoloom/ready; exit 1; }",
        "echo 'running: health check' > /var/lib/isoloom/ready; sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready' || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }"
      ]
    }))
  }
}

resource "proxmox_virtual_environment_vm" "web" {
  name      = "iso${var.slot}-web"
  node_name = var.node
  tags      = ["isoloom", "configured-app"]
  pool_id   = proxmox_virtual_environment_pool.env.pool_id
  on_boot   = false
  cpu {
    cores = 1
    type  = "host"
  }
  memory {
    dedicated = 1024
  }
  disk {
    datastore_id = var.datastore
    file_id      = proxmox_download_file.debian_12.id
    interface    = "virtio0"
    size         = 20
  }
  network_device {
    bridge   = proxmox_sdn_vnet.lab.id
    firewall = true
  }
  initialization {
    datastore_id      = var.datastore
    user_data_file_id = proxmox_virtual_environment_file.web.id
    dns {
      servers = ["1.1.1.1"]
    }
    ip_config {
      ipv4 {
        address = "10.66.0.10/24"
        gateway = "10.66.0.254"
      }
    }
  }
  operating_system {
    type = "l26"
  }
  serial_device {}
  depends_on = [proxmox_virtual_environment_vm.isoloom_router]
}

# Machine `web`'s firewall: what reaches it, outside the guest.
resource "proxmox_virtual_environment_firewall_options" "web" {
  node_name     = var.node
  vm_id         = proxmox_virtual_environment_vm.web.vm_id
  enabled       = true
  input_policy  = "DROP"
  output_policy = "ACCEPT"
}

resource "proxmox_virtual_environment_firewall_rules" "web" {
  node_name = var.node
  vm_id     = proxmox_virtual_environment_vm.web.vm_id
  rule {
    type    = "in"
    action  = "ACCEPT"
    comment = "network lab"
    source  = "+${proxmox_virtual_environment_firewall_ipset.lab.name}"
  }
  rule {
    type    = "in"
    action  = "ACCEPT"
    comment = "published"
    proto   = "tcp"
    dport   = "80"
  }
}

# Machine `api`.
resource "proxmox_virtual_environment_file" "api" {
  node_name    = var.node
  datastore_id = var.snippets_datastore
  content_type = "snippets"
  source_raw {
    file_name = "iso${var.slot}-api.yaml"
    data = format("#cloud-config\n%s", yamlencode({
      hostname = "api"
      users    = local.users
      packages = ["nftables", "curl", "netcat-openbsd"]
      write_files = concat(local.project_files, [
        {
          path        = "/var/lib/isoloom/configure/configure-0.sh"
          encoding    = "gz+b64"
          permissions = "0700"
          content     = "<gzip 2>"
        }
      ])
      runcmd = [
        "mkdir -p /var/lib/isoloom",
        "echo 'running: hosts file' > /var/lib/isoloom/ready; sh -c 'printf '\\''%s\\n'\\'' '\\''10.66.0.10 web'\\'' '\\''10.66.0.20 api'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done' || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }",
        "echo 'running: its configuration' > /var/lib/isoloom/ready; sh /var/lib/isoloom/configure/configure-0.sh || { echo 'failed: its configuration' > /var/lib/isoloom/ready; exit 1; }",
        "echo 'running: health check' > /var/lib/isoloom/ready; sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready' || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }"
      ]
    }))
  }
}

resource "proxmox_virtual_environment_vm" "api" {
  name      = "iso${var.slot}-api"
  node_name = var.node
  tags      = ["isoloom", "configured-app"]
  pool_id   = proxmox_virtual_environment_pool.env.pool_id
  on_boot   = false
  cpu {
    cores = 1
    type  = "host"
  }
  memory {
    dedicated = 1024
  }
  disk {
    datastore_id = var.datastore
    file_id      = proxmox_download_file.ubuntu_24_04.id
    interface    = "virtio0"
    size         = 20
  }
  network_device {
    bridge   = proxmox_sdn_vnet.lab.id
    firewall = true
  }
  initialization {
    datastore_id      = var.datastore
    user_data_file_id = proxmox_virtual_environment_file.api.id
    dns {
      servers = ["1.1.1.1"]
    }
    ip_config {
      ipv4 {
        address = "10.66.0.20/24"
        gateway = "10.66.0.254"
      }
    }
  }
  operating_system {
    type = "l26"
  }
  serial_device {}
  depends_on = [proxmox_virtual_environment_vm.isoloom_router]
}

# Machine `api`'s firewall: what reaches it, outside the guest.
resource "proxmox_virtual_environment_firewall_options" "api" {
  node_name     = var.node
  vm_id         = proxmox_virtual_environment_vm.api.vm_id
  enabled       = true
  input_policy  = "DROP"
  output_policy = "ACCEPT"
}

resource "proxmox_virtual_environment_firewall_rules" "api" {
  node_name = var.node
  vm_id     = proxmox_virtual_environment_vm.api.vm_id
  rule {
    type    = "in"
    action  = "ACCEPT"
    comment = "network lab"
    source  = "+${proxmox_virtual_environment_firewall_ipset.lab.name}"
  }
}

resource "terraform_data" "isoloom_ready_web" {
  triggers_replace = [proxmox_virtual_environment_vm.web.id]
  connection {
    type                = "ssh"
    host                = "10.66.0.10"
    user                = "isoloom"
    private_key         = file(pathexpand(var.ssh_private_key_file))
    bastion_host        = local.router_address
    bastion_user        = "isoloom"
    bastion_private_key = file(pathexpand(var.ssh_private_key_file))
    timeout             = "10m"
  }
  provisioner "remote-exec" {
    inline = [
      "sh -c 't=0\nif command -v cloud-init >/dev/null 2>&1; then sudo cloud-init status --wait >/dev/null 2>&1 || true; fi\nwhile :; do\ns=$(sudo head -n1 /var/lib/isoloom/ready 2>/dev/null)\ncase \"$s\" in\nready) echo \"web: set up\"; exit 0 ;;\n\"failed: \"*) echo \"web: its set-up stopped ($s); the end of /var/log/cloud-init-output.log:\"; sudo tail -n 40 /var/log/cloud-init-output.log 2>/dev/null; exit 1 ;;\nesac\nif [ \"$t\" -ge 2400 ]; then echo \"web: not set up after 2400 s ($${s:-no ready file}); the end of /var/log/cloud-init-output.log:\"; sudo tail -n 40 /var/log/cloud-init-output.log 2>/dev/null; exit 1; fi\nsleep 5; t=$((t + 5))\ndone'"
    ]
  }
}

resource "terraform_data" "isoloom_ready_api" {
  triggers_replace = [proxmox_virtual_environment_vm.api.id]
  connection {
    type                = "ssh"
    host                = "10.66.0.20"
    user                = "isoloom"
    private_key         = file(pathexpand(var.ssh_private_key_file))
    bastion_host        = local.router_address
    bastion_user        = "isoloom"
    bastion_private_key = file(pathexpand(var.ssh_private_key_file))
    timeout             = "10m"
  }
  provisioner "remote-exec" {
    inline = [
      "sh -c 't=0\nif command -v cloud-init >/dev/null 2>&1; then sudo cloud-init status --wait >/dev/null 2>&1 || true; fi\nwhile :; do\ns=$(sudo head -n1 /var/lib/isoloom/ready 2>/dev/null)\ncase \"$s\" in\nready) echo \"api: set up\"; exit 0 ;;\n\"failed: \"*) echo \"api: its set-up stopped ($s); the end of /var/log/cloud-init-output.log:\"; sudo tail -n 40 /var/log/cloud-init-output.log 2>/dev/null; exit 1 ;;\nesac\nif [ \"$t\" -ge 2400 ]; then echo \"api: not set up after 2400 s ($${s:-no ready file}); the end of /var/log/cloud-init-output.log:\"; sudo tail -n 40 /var/log/cloud-init-output.log 2>/dev/null; exit 1; fi\nsleep 5; t=$((t + 5))\ndone'"
    ]
  }
}

locals {
  router_address = try([for a in try(flatten(proxmox_virtual_environment_vm.isoloom_router.ipv4_addresses), []) : a if a != "127.0.0.1" && !contains(["10.66.0.254"], a)][0], "")
}

# The router's uplink address: the environment's way in.
output "ip" {
  value = local.router_address
}

# Each Linux machine's set-up progress (`isoloom-ready/1`: `running: <step>`, `failed: <step>`, `ready`).
output "ready_file" {
  value = "/var/lib/isoloom/ready"
}

# Published services, from the router's uplink address.
output "published" {
  value = { "web/http" = "${local.router_address}:8086" }
}

# The machines, through the router: ssh -J isoloom@<ip> isoloom@<machine>.
output "machines" {
  value = { web = "10.66.0.10", api = "10.66.0.20" }
}

output "ssh_user" {
  value = "isoloom"
}

# The checks: each runner piped to its machine (ssh -J isoloom@<ip> isoloom@<host> sh -s < <script>).
output "checks" {
  value = [
    {
      position = "isoloom-networks"
      machine  = "web"
      host     = "10.66.0.10"
      user     = "isoloom"
      script   = ".isoloom/proxmox/checks/isoloom-networks.sh"
    },
    {
      position = "web"
      machine  = "web"
      host     = "10.66.0.10"
      user     = "isoloom"
      script   = ".isoloom/proxmox/checks/web.sh"
    },
    {
      position = "api"
      machine  = "api"
      host     = "10.66.0.20"
      user     = "isoloom"
      script   = ".isoloom/proxmox/checks/api.sh"
    }
  ]
}

# web's VM id: its console is asked for by it (Proxmox's vncproxy).
output "vm_id_web" {
  value = proxmox_virtual_environment_vm.web.vm_id
}

# api's VM id: its console is asked for by it (Proxmox's vncproxy).
output "vm_id_api" {
  value = proxmox_virtual_environment_vm.api.vm_id
}

# The project's files the machines don't get: what .isoloomignore at the project's root lists
# (gitignore-style: one pattern per line, `#` comments, `!` brings a path back, a trailing `/`
# matches folders only, a `/` at the start or in the middle anchors the pattern at the root; `*`,
# `?`, `[abc]`, `**`; the last pattern matching a path, or a folder it is in, decides), then
# Isoloom's outputs, version control and the tools' state. Read as regular expressions, as the
# Vagrantfiles do.
locals {
  project_ignore_lines = [for l in split("\n", "${replace(try(file("${local.root}/.isoloomignore"), ""), "\r", "")}\n/.isoloom*\n.git/\n.terraform/\n*.tfstate\n*.tfstate.*\n.terraform.tfstate.lock.info\ncrash.log\ncrash.*.log\n.vagrant/\n") : trimspace(l)]
  project_ignore_pats  = [for l in local.project_ignore_lines : { keep = startswith(l, "!"), pat = trimprefix(l, "!") } if l != "" && !startswith(l, "#")]
  project_ignore_globs = [for r in local.project_ignore_pats : merge(r, { glob = trimsuffix(trimsuffix(trimsuffix(r.pat, "/"), "/**"), "/") })]
  project_ignore = [for r in local.project_ignore_globs : {
    keep = r.keep
    re = format(r.glob == r.pat ? "^%s(/|$)" : "^%s/", replace(replace(replace(replace(replace(replace(replace(replace(
      length(split("/", r.glob)) > 1 ? trimprefix(r.glob, "/") : "**/${r.glob}",
    "/[.+^$(){}|\\\\]/", "\\$0"), "[!", "[^"), "**/", "\u0001"), "**", "\u0002"), "*", "[^/]*"), "?", "[^/]"), "\u0001", "(.*/)?"), "\u0002", ".*"))
  } if r.glob != ""]
  # Each file: whether it goes (the last matching pattern decides; none: it goes).
  project_keep  = { for f in fileset(local.root, "**") : f => reverse(concat([true], [for r in local.project_ignore : r.keep if length(regexall(r.re, f)) > 0]))[0] }
  project_paths = [for f, keep in local.project_keep : f if keep]
}
### <gzip 1> decoded
(
set -eu
isoloom_changed() {
  echo "isoloom: changed $*"
  if [ -n "${ISOLOOM_CHANGED:-}" ]; then
    mkdir -p "${ISOLOOM_CHANGED%/*}" && : >"$ISOLOOM_CHANGED"
  fi
}
isoloom_fail() {
  echo "isoloom: $*" >&2
  return 1
}
isoloom_pm() {
  for _pm in apt-get dnf yum apk; do
    if command -v "$_pm" >/dev/null 2>&1; then
      echo "${_pm%-get}"
      return 0
    fi
  done
  isoloom_fail "no package manager Isoloom knows (apt-get, dnf, yum, apk)"
}
isoloom_installed() {
  _name=${2%%=*}
  _version=
  case $2 in *=*) _version=${2#*=} ;; esac
  case $1 in
    apt)
      # shellcheck disable=SC2016 # dpkg-query's own fields, not the shell's.
      _have=$(dpkg-query -W -f='${Status} ${Version}' "$_name" 2>/dev/null) || return 1
      case $_have in "install ok installed "*) ;; *) return 1 ;; esac
      [ -z "$_version" ] || [ "${_have#install ok installed }" = "$_version" ]
      ;;
    dnf | yum)
      if [ -z "$_version" ]; then
        rpm -q --whatprovides "$_name" >/dev/null 2>&1
      else
        rpm -q "$_name-$_version" >/dev/null 2>&1
      fi
      ;;
    apk)
      if [ -z "$_version" ]; then
        apk info -e "$_name" >/dev/null 2>&1
      else
        apk list --installed "$_name" 2>/dev/null | grep -q "^$_name-$_version "
      fi
      ;;
    *) return 1 ;;
  esac
}
isoloom_install() {
  _pm=$1
  shift
  case $_pm in
    apt)
      apt-get update -qq &&
        DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends "$@" >/dev/null &&
        apt-get clean && rm -rf /var/lib/apt/lists/*
      ;;
    dnf | yum)
      for _spec do
        shift
        case $_spec in
          *=*) set -- "$@" "${_spec%%=*}-${_spec#*=}" ;;
          *) set -- "$@" "$_spec" ;;
        esac
      done
      "$_pm" install -y -q "$@" >/dev/null && "$_pm" clean all >/dev/null
      ;;
    apk) apk add --no-cache -q "$@" ;;
    *) return 1 ;;
  esac
}
isoloom_packages() {
  _pm=$(isoloom_pm) || return 1
  for _spec do
    shift
    isoloom_installed "$_pm" "$_spec" || set -- "$@" "$_spec"
  done
  [ "$#" -eq 0 ] && return 0
  isoloom_install "$_pm" "$@" || isoloom_fail "installing $* failed" || return 1
  isoloom_changed "packages $*"
}
isoloom_need() {
  _cmd=$1
  shift
  command -v "$_cmd" >/dev/null 2>&1 && return 0
  _pm=$(isoloom_pm) || return 1
  isoloom_install "$_pm" "$@" || isoloom_fail "installing $* (for $_cmd) failed" || return 1
  isoloom_changed "packages $*"
}
isoloom_sha256() {
  sha256sum "$1" | cut -d ' ' -f 1
}
isoloom_fetch() {
  if ! command -v curl >/dev/null 2>&1 && command -v wget >/dev/null 2>&1; then
    wget -q -O "$2" "$1"
    return
  fi
  isoloom_need curl curl ca-certificates || return 1
  if [ ! -s /etc/ssl/certs/ca-certificates.crt ] && [ ! -s /etc/pki/tls/certs/ca-bundle.crt ]; then
    _pm=$(isoloom_pm) || return 1
    isoloom_install "$_pm" ca-certificates || isoloom_fail "installing ca-certificates failed" || return 1
