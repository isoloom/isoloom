## .isoloom/kubernetes/checks/job.yaml
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# The environment's checks, one Job per position. Run after the environment (or `isoloom test kubernetes`):
#   kubectl -n isoloom-udp-dns delete job isoloom-check isoloom-check-dns --ignore-not-found
#   kubectl apply -k .isoloom/kubernetes/checks
#   kubectl -n isoloom-udp-dns wait --for=condition=complete job --all --timeout=300s; kubectl -n isoloom-udp-dns logs -l isoloom.com/check
apiVersion: batch/v1
kind: Job
metadata:
  name: isoloom-check
spec:
  backoffLimit: 0
  template:
    metadata:
      labels:
        net.isoloom.com/users: member
        isoloom.com/check: isoloom-check
    spec:
      restartPolicy: Never
      containers:
      - name: check
        image: curlimages/curl:8.11.1
        command:
        - /bin/sh
        - /isoloom/run/client.sh
        volumeMounts:
        - name: runner
          mountPath: /isoloom/run
        - name: scripts
          mountPath: /isoloom/scripts
      volumes:
      - name: runner
        configMap:
          name: isoloom-check-runners
          defaultMode: 493
      - name: scripts
        configMap:
          name: isoloom-scripts
          defaultMode: 493
---
apiVersion: batch/v1
kind: Job
metadata:
  name: isoloom-check-dns
spec:
  backoffLimit: 0
  template:
    metadata:
      labels:
        net.isoloom.com/servers: member
        isoloom.com/check: isoloom-check-dns
    spec:
      restartPolicy: Never
      containers:
      - name: check
        image: curlimages/curl:8.11.1
        command:
        - /bin/sh
        - /isoloom/run/dns.sh
        volumeMounts:
        - name: runner
          mountPath: /isoloom/run
      volumes:
      - name: runner
        configMap:
          name: isoloom-check-runners
          defaultMode: 493

## .isoloom/kubernetes/checks/kustomization.yaml
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
namespace: isoloom-udp-dns
resources:
- job.yaml
generatorOptions:
  disableNameSuffixHash: true
configMapGenerator:
- name: isoloom-check-runners
  files:
  - client.sh
  - dns.sh

## .isoloom/kubernetes/environment.yaml
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  kubectl apply -k .isoloom/kubernetes
#         kubectl -n isoloom-udp-dns wait --for=condition=Available deployment --all --timeout=600s
# Stop:   kubectl delete namespace isoloom-udp-dns
# Images built from the project, before starting (a local cluster sharing Docker's images:
# OrbStack, Docker Desktop; elsewhere, push them to a registry the cluster pulls from):
#   docker build -t isoloom/udp-dns-dns build/dns
#   docker build -t isoloom/udp-dns-client -f .isoloom/docker/build/client/Dockerfile .

apiVersion: v1
kind: Namespace
metadata:
  name: isoloom-udp-dns
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: dns
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      isoloom.com/machine: dns
  template:
    metadata:
      labels:
        isoloom.com/machine: dns
        net.isoloom.com/servers: member
    spec:
      hostname: dns
      initContainers:
      - name: isoloom-probe
        image: busybox:1.37.0-musl
        command:
        - /bin/cp
        - /bin/busybox
        - /probe/busybox
        volumeMounts:
        - name: isoloom-probe
          mountPath: /probe
      containers:
      - name: dns
        image: isoloom/udp-dns-dns
        imagePullPolicy: IfNotPresent
        ports:
        - containerPort: 53
          protocol: UDP
        - containerPort: 53
        readinessProbe:
          exec:
            command:
            - /.isoloom-probe/busybox
            - sh
            - -c
            - /.isoloom-probe/busybox nc -z -w 2 127.0.0.1 53
          periodSeconds: 5
          failureThreshold: 60
        volumeMounts:
        - name: isoloom-probe
          mountPath: /.isoloom-probe
          readOnly: true
      nodeSelector:
        kubernetes.io/arch: amd64
      volumes:
      - name: isoloom-probe
        emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: dns
spec:
  selector:
    isoloom.com/machine: dns
  ports:
  - name: p53-udp
    port: 53
    targetPort: 53
    protocol: UDP
  - name: p53
    port: 53
    targetPort: 53
---
apiVersion: v1
kind: Service
metadata:
  name: dns-published
spec:
  type: LoadBalancer
  selector:
    isoloom.com/machine: dns
  ports:
  - name: p10053-udp
    port: 10053
    targetPort: 53
    protocol: UDP
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: publish-dns
spec:
  podSelector:
    matchLabels:
      isoloom.com/machine: dns
  ingress:
  - from:
    - ipBlock:
        cidr: 0.0.0.0/0
    ports:
    - port: 53
      protocol: UDP
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: offline-dns
spec:
  podSelector:
    matchLabels:
      isoloom.com/machine: dns
  policyTypes:
  - Egress
  egress:
  - to:
    - podSelector: {}
  - to:
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: kube-system
    ports:
    - port: 53
      protocol: UDP
    - port: 53
      protocol: TCP
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: client
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      isoloom.com/machine: client
  template:
    metadata:
      labels:
        isoloom.com/machine: client
        net.isoloom.com/users: member
    spec:
      hostname: client
      initContainers:
      - name: wait-dns
        image: alpine:3.20
        command:
        - sh
        - -c
        - until nc -z dns 53; do sleep 2; done
      containers:
      - name: client
        image: isoloom/udp-dns-client
        imagePullPolicy: IfNotPresent
        command:
        - sleep
        - infinity
      nodeSelector:
        kubernetes.io/arch: amd64
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: offline-client
spec:
  podSelector:
    matchLabels:
      isoloom.com/machine: client
  policyTypes:
  - Egress
  egress:
  - to:
    - podSelector: {}
  - to:
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: kube-system
    ports:
    - port: 53
      protocol: UDP
    - port: 53
      protocol: TCP
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: isoloom-default-deny
spec:
  podSelector: {}
  policyTypes:
  - Ingress
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: net-servers
spec:
  podSelector:
    matchLabels:
      net.isoloom.com/servers: member
  ingress:
  - from:
    - podSelector:
        matchLabels:
          net.isoloom.com/servers: member
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: net-users
spec:
  podSelector:
    matchLabels:
      net.isoloom.com/users: member
  ingress:
  - from:
    - podSelector:
        matchLabels:
          net.isoloom.com/users: member
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: reach-0-users-servers
spec:
  podSelector:
    matchLabels:
      net.isoloom.com/servers: member
  ingress:
  - from:
    - podSelector:
        matchLabels:
          net.isoloom.com/users: member
    ports:
    - port: 53
      protocol: TCP
    - port: 53
      protocol: UDP
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: offline-isoloom-check
spec:
  podSelector:
    matchLabels:
      isoloom.com/check: isoloom-check
  policyTypes:
  - Egress
  egress:
  - to:
    - podSelector: {}
  - to:
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: kube-system
    ports:
    - port: 53
      protocol: UDP
    - port: 53
      protocol: TCP
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: offline-isoloom-check-dns
spec:
  podSelector:
    matchLabels:
      isoloom.com/check: isoloom-check-dns
  policyTypes:
  - Egress
  egress:
  - to:
    - podSelector: {}
  - to:
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: kube-system
    ports:
    - port: 53
      protocol: UDP
    - port: 53
      protocol: TCP

## .isoloom/kubernetes/kustomization.yaml
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# The project's scripts the pods run (init jobs, checks), from the chart's copies (`isoloom generate` writes them).
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
namespace: isoloom-udp-dns
resources:
- environment.yaml
generatorOptions:
  disableNameSuffixHash: true
configMapGenerator:
- name: isoloom-scripts
  files:
  - checks__resolve.sh=chart/files/project/checks/resolve.sh

## .isoloom/resolved.json: identical in the `docker` snapshot
