## .isoloom/kubernetes/chart/files/project/checks/resolve.sh
#!/bin/sh
# The DNS server answers a query over UDP (nslookup's default), through the router: the lab's
# name resolves to its address. (busybox's nslookup also asks for AAAA and exits non-zero when
# that part has no answer: the A record is what counts.)
out=$(nslookup www.lab.test dns 2>&1)
echo "$out" | grep -q 10.66.10.80 || { echo "$out"; exit 1; }
echo "www.lab.test resolves through dns"

## .isoloom/kubernetes/chart/templates/NOTES.txt
How to use it: isoloom message --target kubernetes (in the project).

Checks: helm test {{ .Release.Name }} -n {{ .Release.Namespace }}

## .isoloom/kubernetes/chart/templates/environment.yaml
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: dns
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      isoloom.com/machine: dns
  template:
    metadata:
      labels:
        isoloom.com/machine: dns
        net.isoloom.com/servers: member
    spec:
      hostname: dns
      initContainers:
      - name: isoloom-probe
        image: busybox:1.37.0-musl
        command:
        - /bin/cp
        - /bin/busybox
        - /probe/busybox
        volumeMounts:
        - name: isoloom-probe
          mountPath: /probe
      containers:
      - name: dns
        image: '{{ index .Values.images "dns" }}'
        imagePullPolicy: IfNotPresent
        ports:
        - containerPort: 53
          protocol: UDP
        - containerPort: 53
        readinessProbe:
          exec:
            command:
            - /.isoloom-probe/busybox
            - sh
            - -c
            - /.isoloom-probe/busybox nc -z -w 2 127.0.0.1 53
          periodSeconds: 5
          failureThreshold: 60
        volumeMounts:
        - name: isoloom-probe
          mountPath: /.isoloom-probe
          readOnly: true
      nodeSelector:
        kubernetes.io/arch: amd64
      volumes:
      - name: isoloom-probe
        emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: dns
spec:
  selector:
    isoloom.com/machine: dns
  ports:
  - name: p53-udp
    port: 53
    targetPort: 53
    protocol: UDP
  - name: p53
    port: 53
    targetPort: 53
---
apiVersion: v1
kind: Service
metadata:
  name: dns-published
spec:
  type: LoadBalancer
  selector:
    isoloom.com/machine: dns
  ports:
  - name: p10053-udp
    port: 10053
    targetPort: 53
    protocol: UDP
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: publish-dns
spec:
  podSelector:
    matchLabels:
      isoloom.com/machine: dns
  ingress:
  - from:
    - ipBlock:
        cidr: 0.0.0.0/0
    ports:
    - port: 53
      protocol: UDP
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: offline-dns
spec:
  podSelector:
    matchLabels:
      isoloom.com/machine: dns
  policyTypes:
  - Egress
  egress:
  - to:
    - podSelector: {}
  - to:
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: kube-system
    ports:
    - port: 53
      protocol: UDP
    - port: 53
      protocol: TCP
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: client
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      isoloom.com/machine: client
  template:
    metadata:
      labels:
        isoloom.com/machine: client
        net.isoloom.com/users: member
    spec:
      hostname: client
      initContainers:
      - name: wait-dns
        image: alpine:3.20
        command:
        - sh
        - -c
        - until nc -z dns 53; do sleep 2; done
      containers:
      - name: client
        image: '{{ index .Values.images "client" }}'
        imagePullPolicy: IfNotPresent
        command:
        - sleep
        - infinity
      nodeSelector:
        kubernetes.io/arch: amd64
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: offline-client
spec:
  podSelector:
    matchLabels:
      isoloom.com/machine: client
  policyTypes:
  - Egress
  egress:
  - to:
    - podSelector: {}
  - to:
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: kube-system
    ports:
    - port: 53
      protocol: UDP
    - port: 53
      protocol: TCP
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: isoloom-default-deny
spec:
  podSelector: {}
  policyTypes:
  - Ingress
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: net-servers
spec:
  podSelector:
    matchLabels:
      net.isoloom.com/servers: member
  ingress:
  - from:
    - podSelector:
        matchLabels:
          net.isoloom.com/servers: member
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: net-users
spec:
  podSelector:
    matchLabels:
      net.isoloom.com/users: member
  ingress:
  - from:
    - podSelector:
        matchLabels:
          net.isoloom.com/users: member
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: reach-0-users-servers
spec:
  podSelector:
    matchLabels:
      net.isoloom.com/servers: member
  ingress:
  - from:
    - podSelector:
        matchLabels:
          net.isoloom.com/users: member
    ports:
    - port: 53
      protocol: TCP
    - port: 53
      protocol: UDP
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: offline-isoloom-check
spec:
  podSelector:
    matchLabels:
      isoloom.com/check: isoloom-check
  policyTypes:
  - Egress
  egress:
  - to:
    - podSelector: {}
  - to:
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: kube-system
    ports:
    - port: 53
      protocol: UDP
    - port: 53
      protocol: TCP
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: offline-isoloom-check-dns
spec:
  podSelector:
    matchLabels:
      isoloom.com/check: isoloom-check-dns
  policyTypes:
  - Egress
  egress:
  - to:
    - podSelector: {}
  - to:
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: kube-system
    ports:
    - port: 53
      protocol: UDP
    - port: 53
      protocol: TCP

## .isoloom/kubernetes/chart/templates/scripts.yaml
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# The project's scripts (init jobs, checks): copies in files/project/, written by `isoloom generate`.
apiVersion: v1
kind: ConfigMap
metadata:
  name: isoloom-scripts
binaryData:
  checks__resolve.sh: '{{ required "files/project/checks/resolve.sh is missing: run isoloom generate" (.Files.Get "files/project/checks/resolve.sh") | b64enc }}'

## .isoloom/kubernetes/chart/templates/tests/checks.yaml
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# The checks: `helm test <release>` runs a Job per position (`exec` checks, run inside a machine,
# stay with `isoloom test kubernetes`).
apiVersion: v1
kind: ConfigMap
metadata:
  name: isoloom-check-runners
binaryData:
  client.sh: '{{ .Files.Get "files/checks/client.sh" | b64enc }}'
  dns.sh: '{{ .Files.Get "files/checks/dns.sh" | b64enc }}'
---
apiVersion: v1
kind: Pod
metadata:
  name: isoloom-check
  labels:
    net.isoloom.com/users: member
    isoloom.com/check: isoloom-check
  annotations:
    helm.sh/hook: test
    helm.sh/hook-delete-policy: before-hook-creation
spec:
  restartPolicy: Never
  containers:
  - name: check
    image: curlimages/curl:8.11.1
    command:
    - /bin/sh
    - /isoloom/run/client.sh
    volumeMounts:
    - name: runner
      mountPath: /isoloom/run
    - name: scripts
      mountPath: /isoloom/scripts
  volumes:
  - name: runner
    configMap:
      name: isoloom-check-runners
      defaultMode: 493
  - name: scripts
    configMap:
      name: isoloom-scripts
      defaultMode: 493
---
apiVersion: v1
kind: Pod
metadata:
  name: isoloom-check-dns
  labels:
    net.isoloom.com/servers: member
    isoloom.com/check: isoloom-check-dns
  annotations:
    helm.sh/hook: test
    helm.sh/hook-delete-policy: before-hook-creation
spec:
  restartPolicy: Never
  containers:
  - name: check
    image: curlimages/curl:8.11.1
    command:
    - /bin/sh
    - /isoloom/run/dns.sh
    volumeMounts:
    - name: runner
      mountPath: /isoloom/run
  volumes:
  - name: runner
    configMap:
      name: isoloom-check-runners
      defaultMode: 493

