---
source: crates/cli/isoloom/tests/example_snapshots.rs
---
# isoloom targets
✓ cloud-vm
    ✗ gcp (machine `iis`: Windows on GCP comes later)
    ✗ digitalocean (DigitalOcean cloud-vm is Linux only so far)
    ✗ linode (Linode cloud-vm is Linux only so far)
    ✗ oci (Oracle Cloud cloud-vm is Linux only so far)

# isoloom generate --target cloud-vm (exit 0)
✓ .isoloom/cloud-vm/aws/main.tf
✓ .isoloom/cloud-vm/azure/main.tf
✓ .isoloom/cloud-vm/checks/networks.sh
✓ .isoloom/configure/lib/configure.ps1
✓ .isoloom/cloud-vm/aws/run.json
✓ .isoloom/cloud-vm/azure/run.json
✓ .isoloom/resolved.json

## .isoloom/cloud-vm/aws/main.tf
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  terraform -chdir=.isoloom/cloud-vm/aws init && terraform -chdir=.isoloom/cloud-vm/aws apply \
#           -var allowed_cidr=<your IP>/32 -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)"
# Stop:   terraform -chdir=.isoloom/cloud-vm/aws destroy (same variables)
# Then:   the machines wait for the project: run the lab through the Isothrum runner (run.json
#         beside this file), which delivers the project over SSH, waits for each set-up and runs the checks.

terraform {
  required_version = ">= 1.6"
  backend "local" {}
  required_providers {
    aws    = { source = "hashicorp/aws", version = "~> 6.67.0" }
    tls    = { source = "hashicorp/tls", version = "~> 4.4.1" }
    random = { source = "hashicorp/random", version = "~> 3.9.1" }
    time   = { source = "hashicorp/time", version = "~> 0.14.2" }
    local  = { source = "hashicorp/local", version = "~> 2.9.1" }
  }
}

variable "region" {
  type    = string
  default = "eu-west-3"
}

variable "allowed_cidr" {
  type        = string
  description = "Who may reach the machines (SSH and the published ports), e.g. your IP/32"
}

variable "ssh_public_key" {
  type        = string
  description = "The key the machines let in: the Isothrum runner's (it delivers the project and runs the checks over SSH)"
}

variable "expires_at" {
  type        = string
  default     = ""
  description = "When the environment should end, in Unix seconds (empty: no end): a tag on every resource, so a reaper finds what to destroy, and the time the machines shut themselves down"
}

provider "aws" {
  region = var.region
  default_tags {
    tags = {
      isoloom-environment = "configured-windows"
      managed-by          = "isoloom"
      isoloom-instance    = local.name
      isoloom-expires-at  = var.expires_at
    }
  }
}

resource "terraform_data" "id" {
  input = substr(replace(uuid(), "-", ""), 0, 8)
  lifecycle {
    ignore_changes = [input]
  }
}

locals {
  name = "isoloom-configured-windows-${terraform_data.id.output}"
  root = abspath("${path.module}/../../..")
}

data "aws_availability_zones" "available" {
  state = "available"
}

# The environment's networks: one VPC, a subnet per network with its exact range.
resource "aws_vpc" "env" {
  cidr_block = "10.67.0.0/24"
  tags       = { Name = local.name }
}

resource "aws_internet_gateway" "env" {
  vpc_id = aws_vpc.env.id
}

resource "aws_route_table" "env" {
  vpc_id = aws_vpc.env.id
  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.env.id
  }
}

resource "aws_subnet" "lab" {
  vpc_id            = aws_vpc.env.id
  cidr_block        = "10.67.0.0/24"
  availability_zone = data.aws_availability_zones.available.names[0]
  tags              = { Name = "${local.name}-lab" }
}

resource "aws_route_table_association" "lab" {
  subnet_id      = aws_subnet.lab.id
  route_table_id = aws_route_table.env.id
}

resource "aws_key_pair" "env" {
  key_name   = local.name
  public_key = var.ssh_public_key
}

# The Windows machines' administrator password (user isoloom), for WinRM.
resource "random_password" "windows" {
  length      = 24
  special     = false
  min_upper   = 2
  min_lower   = 2
  min_numeric = 2
}

# The controller's own key: it runs the playbooks over SSH on every machine.
resource "tls_private_key" "controller" {
  algorithm = "ED25519"
}

data "aws_ami" "debian_12" {
  most_recent = true
  owners      = ["136693071363"]
  filter {
    name   = "name"
    values = ["debian-12-amd64-*"]
  }
  filter {
    name   = "architecture"
    values = ["x86_64"]
  }
}

data "aws_ami" "windows_server_2022" {
  most_recent = true
  owners      = ["801119661308"]
  filter {
    name   = "name"
    values = ["Windows_Server-2022-English-Full-Base-*"]
  }
  filter {
    name   = "architecture"
    values = ["x86_64"]
  }
}

# Machine `iis` (Windows): what may reach it.
resource "aws_security_group" "iis" {
  name   = "${local.name}-iis"
  vpc_id = aws_vpc.env.id
  ingress {
    description = "its network (lab)"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["10.67.0.0/24"]
  }
  ingress {
    description = "WinRM from allowed_cidr (its set-up)"
    from_port   = 5985
    to_port     = 5985
    protocol    = "tcp"
    cidr_blocks = [var.allowed_cidr]
  }
  ingress {
    description = "published"
    from_port   = 8087
    to_port     = 8087
    protocol    = "tcp"
    cidr_blocks = [var.allowed_cidr]
  }
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

# No key pair: AWS refuses ED25519 keys on Windows, and WinRM uses the generated password.
resource "aws_instance" "iis" {
  ami                         = data.aws_ami.windows_server_2022.id
  instance_type               = "c7i-flex.large"
  subnet_id                   = aws_subnet.lab.id
  private_ip                  = "10.67.0.10"
  associate_public_ip_address = true
  vpc_security_group_ids      = [aws_security_group.iis.id]
  user_data                   = "<powershell>\n$p = ConvertTo-SecureString '${random_password.windows.result}' -AsPlainText -Force\nNew-LocalUser -Name isoloom -Password $p -PasswordNeverExpires -AccountNeverExpires | Out-Null\nAdd-LocalGroupMember -Group Administrators -Member isoloom\nEnable-PSRemoting -Force -SkipNetworkProfileCheck | Out-Null\nSet-Item WSMan:\\localhost\\Service\\AllowUnencrypted $true\nSet-Item WSMan:\\localhost\\Service\\Auth\\Basic $true\nNew-NetFirewallRule -DisplayName 'isoloom WinRM' -Direction Inbound -Protocol TCP -LocalPort 5985 -Action Allow | Out-Null\n${var.expires_at != "" ? "Register-ScheduledTask -TaskName isoloom-expiry -Action (New-ScheduledTaskAction -Execute shutdown.exe -Argument '/s /t 0') -Trigger (New-ScheduledTaskTrigger -Once -At ([DateTimeOffset]::FromUnixTimeSeconds(${var.expires_at}).LocalDateTime)) -User SYSTEM -RunLevel Highest -Force | Out-Null" : ""}\n</powershell>\n"
  root_block_device {
    volume_size = 50
  }
  tags = { Name = "${local.name}-iis" }
}

resource "terraform_data" "iis_name" {
  triggers_replace = [aws_instance.iis.id]
  connection {
    type     = "winrm"
    host     = aws_instance.iis.public_ip
    user     = "isoloom"
    password = random_password.windows.result
    https    = false
    timeout  = "30m"
  }
  provisioner "remote-exec" {
    inline = [
      "powershell -NoProfile -Command \"if ($env:COMPUTERNAME -ne 'IIS') { Rename-Computer -NewName 'iis' -Force; shutdown /r /t 10 }\""
    ]
  }
}

resource "time_sleep" "iis_restart" {
  create_duration = "90s"
  depends_on      = [terraform_data.iis_name]
}

resource "terraform_data" "iis" {
  triggers_replace = [aws_instance.iis.id]
  connection {
    type     = "winrm"
    host     = aws_instance.iis.public_ip
    user     = "isoloom"
    password = random_password.windows.result
    https    = false
    timeout  = "30m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-iis.tgz\" --exclude=.git --exclude=.vagrant --exclude=.terraform --exclude=.isoloom-project* -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-iis.tgz"
    destination = "C:/Windows/Temp/isoloom-project.tgz"
  }
  provisioner "file" {
    content     = "$ErrorActionPreference = 'Stop'\nif ($env:COMPUTERNAME -ne 'IIS') { throw \"still named $env:COMPUTERNAME: the rename hasn't taken effect\" }\nnetsh interface portproxy add v4tov4 listenport=8087 listenaddress=0.0.0.0 connectport=80 connectaddress=127.0.0.1 | Out-Null\nNew-NetFirewallRule -DisplayName 'isoloom 80' -Direction Inbound -Protocol TCP -LocalPort 80 -Action Allow | Out-Null\nNew-NetFirewallRule -DisplayName 'isoloom 8087' -Direction Inbound -Protocol TCP -LocalPort 8087 -Action Allow | Out-Null\n$archive = 'C:\\Windows\\Temp\\isoloom-project.tgz'; $dest = 'C:\\isoloom'; $strip = 1\n# The project into a Windows machine: unpacks the tar.gz $archive into $dest (replacing an older\n# copy), leaving out the archive's first $strip folders. Plain .NET (GZipStream), so it runs on\n# every Windows Isoloom supports: PowerShell 2.0 and later, and no tar.exe before Windows Server\n# 2019. Symbolic links are left out (counted).\n& {\n  $ErrorActionPreference = 'Stop'\n  $sep = [IO.Path]::DirectorySeparatorChar\n  $new = \"$dest.new\"\n  if (Test-Path $new) { Remove-Item $new -Recurse -Force }\n  [void][IO.Directory]::CreateDirectory($new)\n  $file = New-Object IO.FileStream($archive, [IO.FileMode]::Open, [IO.FileAccess]::Read)\n  $in = New-Object IO.Compression.GZipStream($file, [IO.Compression.CompressionMode]::Decompress)\n  $utf8 = New-Object Text.UTF8Encoding($false)\n  $header = New-Object byte[] 512\n  $chunk = New-Object byte[] 65536\n  function Fill([byte[]]$b, [int]$n) {\n    $got = 0\n    while ($got -lt $n) {\n      $r = $in.Read($b, $got, $n - $got)\n      if ($r -le 0) { throw \"$archive ends early\" }\n      $got += $r\n    }\n  }\n  function Field([int]$at, [int]$len) {\n    $end = [Array]::IndexOf($header, [byte]0, $at, $len)\n    if ($end -lt 0) { $end = $at + $len }\n    $utf8.GetString($header, $at, $end - $at)\n  }\n  # Copies $size bytes to $out (or skips them, with no $out), then the padding after them.\n  function Body([long]$size, $out) {\n    $left = $size\n    while ($left -gt 0) {\n      $n = [int][Math]::Min([long]$chunk.Length, $left)\n      Fill $chunk $n\n      if ($out) { $out.Write($chunk, 0, $n) }\n      $left -= $n\n    }\n    $pad = [int]((512 - $size % 512) % 512)\n    if ($pad) { Fill $chunk $pad }\n  }\n  $pax = @{}\n  $links = 0\n  $files = 0\n  while ($true) {\n    Fill $header 512\n    if ($header[148] -eq 0) { break } # the end: zero blocks have no checksum\n    $type = [char]$header[156]\n    $sizeText = (Field 124 12).Trim()\n    $size = [long]0\n    if ($sizeText) { $size = [Convert]::ToInt64($sizeText, 8) }\n    if ($pax['size']) { $size = [long]$pax['size'] }\n    if ($type -eq 'x') {\n      # pax records (\"<length> key=value\\n\"): a long path, a large size, for the next entry.\n      $ms = New-Object IO.MemoryStream\n      Body $size $ms\n      $b = $ms.ToArray()\n      $i = 0\n      while ($i -lt $b.Length) {\n        $sp = [Array]::IndexOf($b, [byte]32, $i)\n        $len = [int]$utf8.GetString($b, $i, $sp - $i)\n        $eq = [Array]::IndexOf($b, [byte]61, $sp)\n        $pax[$utf8.GetString($b, $sp + 1, $eq - $sp - 1)] = $utf8.GetString($b, $eq + 1, $i + $len - $eq - 2)\n        $i += $len\n      }\n      continue\n    }\n    if ($type -eq 'L' -or $type -eq 'K') {\n      # GNU tar's long name (or link target) for the next entry.\n      $ms = New-Object IO.MemoryStream\n      Body $size $ms\n      if ($type -eq 'L') { $pax['path'] = $utf8.GetString($ms.ToArray()).TrimEnd([char]0) }\n      continue\n    }\n    $name = Field 0 100\n    $prefix = Field 345 155\n    if ($prefix) { $name = \"$prefix/$name\" }\n    if ($pax['path']) { $name = $pax['path'] }\n    $pax = @{}\n    $parts = @($name.Split('/') | Where-Object { $_ -ne '' -and $_ -ne '.' })\n    if ($parts.Count -le $strip) { Body $size $null; continue }\n    $path = Join-Path $new ([string]::Join([string]$sep, [string[]]($parts[$strip..($parts.Count - 1)])))\n    if ($type -eq '5' -or $type -eq '0' -or $type -eq [char]0) {\n      # A name Windows can't take (`:`, `*`, too long...) is left out, with a warning.\n      $out = $null\n      try {\n        if ($type -eq '5') {\n          [void][IO.Directory]::CreateDirectory($path)\n        } else {\n          [void][IO.Directory]::CreateDirectory([IO.Path]::GetDirectoryName($path))\n          $out = [IO.File]::Create($path)\n        }\n      } catch {\n        Write-Warning \"Not copied: $name ($($_.Exception.Message))\"\n        Body $size $null\n        continue\n      }\n      if ($out) {\n        try { Body $size $out } finally { $out.Close() }\n        $files++\n      } else {\n        Body $size $null\n      }\n    } else {\n      if ($type -eq '2') { $links++ }\n      Body $size $null\n    }\n  }\n  $in.Close()\n  if (Test-Path $dest) { Remove-Item $dest -Recurse -Force }\n  Move-Item $new $dest\n  Remove-Item $archive -Force\n  $note = ''\n  if ($links) { $note = \" ($links symbolic links left out)\" }\n  \"$files files in $dest$note\"\n}\n$h = \"$env:SystemRoot\\System32\\drivers\\etc\\hosts\"; foreach ($l in @('10.67.0.10 iis')) { if (-not (Select-String -Path $h -SimpleMatch $l -Quiet)) { Add-Content -Path $h -Value $l } }\n$ErrorActionPreference = 'Stop'\n[Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12\nfunction Write-IsoloomChange {\n    param([Parameter(Mandatory)][string] $What)\n    Write-Output \"isoloom: changed $What\"\n    if ($env:ISOLOOM_CHANGED) {\n        New-Item -ItemType Directory -Force -Path (Split-Path -Parent $env:ISOLOOM_CHANGED) | Out-Null\n        Set-Content -LiteralPath $env:ISOLOOM_CHANGED -Value 'changed'\n    }\n}\nfunction Test-IsoloomRestartDue {\n    return [bool]($env:ISOLOOM_CHANGED -and (Test-Path -LiteralPath $env:ISOLOOM_CHANGED))\n}\nfunction Get-IsoloomHash {\n    param([Parameter(Mandatory)][string] $Path)\n    return (Get-FileHash -LiteralPath $Path -Algorithm SHA256).Hash.ToLowerInvariant()\n}\nfunction Install-IsoloomFeature {\n    param([Parameter(Mandatory)][string[]] $Name)\n    $server = [bool](Get-Command -Name Get-WindowsFeature -ErrorAction SilentlyContinue)\n    foreach ($feature in $Name) {\n        if ($server) {\n            if ((Get-WindowsFeature -Name $feature).Installed) { continue }\n            $result = Install-WindowsFeature -Name $feature -IncludeManagementTools\n            if (-not $result.Success) { throw \"isoloom: installing the feature $feature failed\" }\n        } else {\n            if ((Get-WindowsOptionalFeature -Online -FeatureName $feature).State -eq 'Enabled') { continue }\n            Enable-WindowsOptionalFeature -Online -FeatureName $feature -All -NoRestart | Out-Null\n        }\n        Write-IsoloomChange -What \"feature $feature\"\n    }\n}\nfunction Copy-IsoloomFile {\n    param([Parameter(Mandatory)][string] $From, [Parameter(Mandatory)][string] $To)\n    if ((Test-Path -LiteralPath $To -PathType Leaf) -and ((Get-IsoloomHash -Path $From) -eq (Get-IsoloomHash -Path $To))) {\n        return\n    }\n    $parent = Split-Path -Parent $To\n    if ($parent) { New-Item -ItemType Directory -Force -Path $parent | Out-Null }\n    Copy-Item -LiteralPath $From -Destination $To -Force\n    Write-IsoloomChange -What $To\n}\nfunction Copy-IsoloomItem {\n    param([Parameter(Mandatory)][string] $From, [Parameter(Mandatory)][string] $To)\n    if (-not (Test-Path -LiteralPath $From -PathType Container)) {\n        Copy-IsoloomFile -From $From -To $To\n        return\n    }\n    $root = (Resolve-Path -LiteralPath $From).Path.TrimEnd('\\', '/')\n    if (-not (Test-Path -LiteralPath $To -PathType Container)) {\n        New-Item -ItemType Directory -Force -Path $To | Out-Null\n        Write-IsoloomChange -What $To\n    }\n    foreach ($entry in Get-ChildItem -LiteralPath $root -Recurse -Force) {\n        $target = Join-Path -Path $To -ChildPath $entry.FullName.Substring($root.Length).TrimStart('\\', '/')\n        if ($entry.PSIsContainer) {\n            if (Test-Path -LiteralPath $target -PathType Container) { continue }\n            New-Item -ItemType Directory -Force -Path $target | Out-Null\n            Write-IsoloomChange -What $target\n        } else {\n            Copy-IsoloomFile -From $entry.FullName -To $target\n        }\n    }\n}\nfunction Install-IsoloomTemplate {\n    param([Parameter(Mandatory)][string] $To, [Parameter(Mandatory)][AllowEmptyString()][string] $Base64)\n    $temporary = [IO.Path]::GetTempFileName()\n    try {\n        [IO.File]::WriteAllBytes($temporary, [Convert]::FromBase64String($Base64))\n        Copy-IsoloomFile -From $temporary -To $To\n    } finally {\n        Remove-Item -LiteralPath $temporary -Force -ErrorAction SilentlyContinue\n    }\n}\nfunction Install-IsoloomFile {\n    param(\n        [Parameter(Mandatory)][string] $Path,\n        [Parameter(Mandatory)][ValidateSet('directory', 'absent', 'download')][string] $State,\n        [string] $Url,\n        [string] $Sha256\n    )\n    switch ($State) {\n        'directory' {\n            if (Test-Path -LiteralPath $Path -PathType Container) { return }\n            New-Item -ItemType Directory -Force -Path $Path | Out-Null\n        }\n        'absent' {\n            if (-not (Test-Path -LiteralPath $Path)) { return }\n            Remove-Item -LiteralPath $Path -Recurse -Force\n        }\n        'download' {\n            if ((Test-Path -LiteralPath $Path -PathType Leaf) -and ((Get-IsoloomHash -Path $Path) -eq $Sha256)) { return }\n            $parent = Split-Path -Parent $Path\n            if ($parent) { New-Item -ItemType Directory -Force -Path $parent | Out-Null }\n            $temporary = \"$Path.isoloom-download\"\n            Invoke-WebRequest -UseBasicParsing -Uri $Url -OutFile $temporary\n            $got = Get-IsoloomHash -Path $temporary\n            if ($got -ne $Sha256) {\n                Remove-Item -LiteralPath $temporary -Force\n                throw \"isoloom: $Url has SHA-256 $got, not $${Sha256}: the file changed upstream, or the pin is wrong\"\n            }\n            Move-Item -LiteralPath $temporary -Destination $Path -Force\n        }\n    }\n    Write-IsoloomChange -What $Path\n}\nfunction ConvertTo-IsoloomSecure {\n    param([Parameter(Mandatory)][string] $Phrase)\n    $secure = New-Object -TypeName System.Security.SecureString\n    foreach ($character in $Phrase.ToCharArray()) { $secure.AppendChar($character) }\n    return $secure\n}\nfunction Test-IsoloomPhrase {\n    param([Parameter(Mandatory)][string] $Name, [Parameter(Mandatory)][string] $Phrase)\n    Add-Type -AssemblyName System.DirectoryServices.AccountManagement\n    $machine = New-Object -TypeName System.DirectoryServices.AccountManagement.PrincipalContext -ArgumentList 'Machine'\n    try { return $machine.ValidateCredentials($Name, $Phrase) } finally { $machine.Dispose() }\n}\nfunction Add-IsoloomMember {\n    param([Parameter(Mandatory)][string] $Group, [Parameter(Mandatory)][string] $Name)\n    $members = Get-LocalGroupMember -Group $Group | ForEach-Object { ($_.Name -split '\\\\')[-1] }\n    if ($members -contains $Name) { return }\n    Add-LocalGroupMember -Group $Group -Member $Name\n    Write-IsoloomChange -What \"$Name in $Group\"\n}\nfunction Add-IsoloomUser {\n    param([Parameter(Mandatory)][string] $Name, [string] $Phrase, [string[]] $Groups = @())\n    if (-not (Get-LocalUser -Name $Name -ErrorAction SilentlyContinue)) {\n        if ($Phrase) {\n            New-LocalUser -Name $Name -Password (ConvertTo-IsoloomSecure -Phrase $Phrase) -PasswordNeverExpires | Out-Null\n        } else {\n            New-LocalUser -Name $Name -NoPassword | Out-Null\n        }\n        Write-IsoloomChange -What \"user $Name\"\n    } elseif ($Phrase -and -not (Test-IsoloomPhrase -Name $Name -Phrase $Phrase)) {\n        Set-LocalUser -Name $Name -Password (ConvertTo-IsoloomSecure -Phrase $Phrase)\n        Write-IsoloomChange -What \"password of $Name\"\n    }\n    foreach ($group in $Groups) { Add-IsoloomMember -Group $group -Name $Name }\n}\nfunction Add-IsoloomGroup {\n    param([Parameter(Mandatory)][string] $Name)\n    if (Get-LocalGroup -Name $Name -ErrorAction SilentlyContinue) { return }\n    New-LocalGroup -Name $Name | Out-Null\n    Write-IsoloomChange -What \"group $Name\"\n}\nfunction Register-IsoloomTask {\n    param([Parameter(Mandatory)][string] $Name, [Parameter(Mandatory)][string[]] $Run, [string] $Directory)\n    $arguments = ($Run | Select-Object -Skip 1 | ForEach-Object { '\"' + ($_ -replace '\"', '\\\"') + '\"' }) -join ' '\n    $settings = @{ Execute = $Run[0] }\n    if ($arguments) { $settings.Argument = $arguments }\n    if ($Directory) { $settings.WorkingDirectory = $Directory }\n    $action = New-ScheduledTaskAction @settings\n    $task = Get-ScheduledTask -TaskName \"isoloom-$Name\" -ErrorAction SilentlyContinue\n    $same = $task -and $task.Actions[0].Execute -eq $action.Execute -and $task.Actions[0].Arguments -eq $action.Arguments -and\n        $task.Actions[0].WorkingDirectory -eq $action.WorkingDirectory\n    if ($same) { return }\n    $trigger = New-ScheduledTaskTrigger -AtStartup\n    Register-ScheduledTask -TaskName \"isoloom-$Name\" -Action $action -Trigger $trigger -User 'SYSTEM' -RunLevel Highest -Force | Out-Null\n    Write-IsoloomChange -What \"task isoloom-$Name\"\n}\nfunction Register-IsoloomTaskState {\n    param([Parameter(Mandatory)][string] $Name, [Parameter(Mandatory)][bool] $Enabled)\n    $task = Get-ScheduledTask -TaskName \"isoloom-$Name\"\n    if (-not $Enabled) {\n        if ($task.State -eq 'Running') { Stop-ScheduledTask -TaskName \"isoloom-$Name\"; Write-IsoloomChange -What \"isoloom-$Name stopped\" }\n        if ($task.State -ne 'Disabled') { Disable-ScheduledTask -TaskName \"isoloom-$Name\" | Out-Null; Write-IsoloomChange -What \"isoloom-$Name disabled\" }\n        return\n    }\n    if ($task.State -eq 'Disabled') { Enable-ScheduledTask -TaskName \"isoloom-$Name\" | Out-Null; Write-IsoloomChange -What \"isoloom-$Name enabled\" }\n    if ((Get-ScheduledTask -TaskName \"isoloom-$Name\").State -ne 'Running') {\n        Start-ScheduledTask -TaskName \"isoloom-$Name\"\n        Write-IsoloomChange -What \"isoloom-$Name started\"\n    } elseif (Test-IsoloomRestartDue) {\n        Stop-ScheduledTask -TaskName \"isoloom-$Name\"\n        Start-ScheduledTask -TaskName \"isoloom-$Name\"\n        Write-Output \"isoloom: restarted isoloom-$Name\"\n    }\n}\nfunction Register-IsoloomService {\n    param([Parameter(Mandatory)][string] $Name, [Parameter(Mandatory)][bool] $Enabled)\n    $service = Get-Service -Name $Name -ErrorAction SilentlyContinue\n    if (-not $service) { throw \"isoloom: no Windows service $${Name}: install what provides it in an earlier step\" }\n    if (-not $Enabled) {\n        if ($service.StartType -ne 'Disabled') { Set-Service -Name $Name -StartupType Disabled; Write-IsoloomChange -What \"$Name disabled\" }\n        if ($service.Status -ne 'Stopped') { Stop-Service -Name $Name -Force; Write-IsoloomChange -What \"$Name stopped\" }\n        return\n    }\n    if ($service.StartType -ne 'Automatic') { Set-Service -Name $Name -StartupType Automatic; Write-IsoloomChange -What \"$Name enabled\" }\n    if ($service.Status -ne 'Running') {\n        Start-Service -Name $Name\n        Write-IsoloomChange -What \"$Name started\"\n    } elseif (Test-IsoloomRestartDue) {\n        Restart-Service -Name $Name -Force\n        Write-Output \"isoloom: restarted $Name\"\n    }\n}\nfunction Invoke-IsoloomCommand {\n    param([Parameter(Mandatory)][string] $Run, [string] $Creates, [string] $Unless)\n    if ($Creates -and (Test-Path -LiteralPath $Creates)) { return }\n    if ($Unless -and (Test-IsoloomScript -Text $Unless)) { return }\n    if (-not (Test-IsoloomScript -Text $Run -Loud)) { throw \"isoloom: the command failed: $Run\" }\n    Write-IsoloomChange -What 'command'\n}\nfunction Test-IsoloomScript {\n    param([Parameter(Mandatory)][string] $Text, [switch] $Loud)\n    Set-Variable -Name LASTEXITCODE -Scope Global -Value 0\n    try {\n        if ($Loud) { & ([scriptblock]::Create($Text)) } else { & ([scriptblock]::Create($Text)) | Out-Null }\n    } catch {\n        if ($Loud) { Write-Error -Message $_ -ErrorAction Continue }\n        return $false\n    }\n    return (Get-Variable -Name LASTEXITCODE -Scope Global -ValueOnly) -eq 0\n}\nfunction Enable-IsoloomFirewallPort {\n    param([Parameter(Mandatory)][int] $Port, [Parameter(Mandatory)][ValidateSet('TCP', 'UDP')][string] $Protocol)\n    $name = \"isoloom-$Port-$Protocol\"\n    if (Get-NetFirewallRule -Name $name -ErrorAction SilentlyContinue) { return }\n    New-NetFirewallRule -Name $name -DisplayName \"Isoloom $Port/$Protocol\" -Direction Inbound -Action Allow -Protocol $Protocol -LocalPort $Port | Out-Null\n    Write-IsoloomChange -What \"firewall $Port/$Protocol\"\n}\n$env:ISOLOOM_CHANGED = 'C:\\Windows\\Temp\\isoloom-configure.changed'\nRemove-Item -LiteralPath $env:ISOLOOM_CHANGED -Force -ErrorAction SilentlyContinue\nSet-Location -LiteralPath 'C:\\isoloom'\nInstall-IsoloomFeature -Name 'Web-Server'\nAdd-IsoloomGroup -Name 'Site Editors'\nAdd-IsoloomUser -Name 'editor' -Phrase 'Lab-content-1' -Groups 'Site Editors'\nInstall-IsoloomFile -Path 'C:\\inetpub\\isoloom' -State directory\nCopy-IsoloomItem -From 'site/' -To 'C:\\inetpub\\wwwroot'\nInstall-IsoloomTemplate -To 'C:\\inetpub\\wwwroot\\about.txt' -Base64 'aWlzIGF0IDEwLjY3LjAuMTAsIGNvbmZpZ3VyZWQgYnkgaXNvbG9vbS4K'\nInvoke-IsoloomCommand -Run 'Set-Content -Path C:\\inetpub\\isoloom\\stamp.txt -Value configured' -Creates 'C:\\inetpub\\isoloom\\stamp.txt'\nEnable-IsoloomFirewallPort -Port 80 -Protocol TCP\nRegister-IsoloomService -Name 'W3SVC' -Enabled $true\nNew-Item -ItemType Directory -Force C:\\isoloom | Out-Null; Set-Content C:\\isoloom\\ready ready\n"
    destination = "C:/ProgramData/isoloom/setup.ps1"
  }
  provisioner "remote-exec" {
    inline = ["powershell -NoProfile -ExecutionPolicy Bypass -File C:/ProgramData/isoloom/setup.ps1"]
  }
  depends_on = [time_sleep.iis_restart]
}

# The controller (Ansible): every network may reach it, and SSH from allowed_cidr.
resource "aws_security_group" "isoloom_controller" {
  name   = "${local.name}-controller"
  vpc_id = aws_vpc.env.id
  ingress {
    description = "lab"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["10.67.0.0/24"]
  }
  ingress {
    description = "SSH from allowed_cidr"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [var.allowed_cidr]
  }
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_network_interface" "isoloom_controller_lab" {
  subnet_id         = aws_subnet.lab.id
  private_ips       = ["10.67.0.253"]
  security_groups   = [aws_security_group.isoloom_controller.id]
  source_dest_check = false
}

resource "aws_instance" "isoloom_controller" {
  ami              = data.aws_ami.debian_12.id
  instance_type    = "t3.micro"
  key_name         = aws_key_pair.env.key_name
  user_data_base64 = base64gzip("#!/bin/sh\n# Isoloom: this machine sets itself up. Its progress is in /var/lib/isoloom/ready (isoloom-ready/1), its output in /var/log/isoloom-setup.log. The Isothrum runner delivers the project over SSH.\nmkdir -p /var/lib/isoloom\ncat > /var/lib/isoloom/setup.sh.new <<'ISOLOOM_SETUP'\n#!/bin/sh\numask 022\ncase \"$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\" in ready|failed:*) exit 0 ;; esac\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\npart=$(cat /var/lib/isoloom/part 2>/dev/null || echo 1)\nif [ \"$part\" = 1 ]; then\necho 'running: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; { i=0; until [ -f /var/lib/isoloom/project-delivered ]; do i=$((i+5)); if [ $i -gt 2400 ]; then echo 'the project never came: start the lab through the Isothrum runner (run.json), which delivers it over SSH' >&2; exit 1; fi; sleep 5; done; } || { echo 'failed: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; exit 1; }\necho 'running: the controller'\\''s key' > /var/lib/isoloom/ready; { mkdir -p /etc/isoloom && (umask 077 && echo ${base64encode(tls_private_key.controller.private_key_openssh)} | base64 -d > /etc/isoloom/id_ed25519) && chmod 0600 /etc/isoloom/id_ed25519; } || { echo 'failed: the controller'\\''s key' > /var/lib/isoloom/ready; exit 1; }\necho 'running: the inventory' > /var/lib/isoloom/ready; { mkdir -p /etc/isoloom && (umask 077 && echo ${base64encode("[linux]\n\n[windows]\niis ansible_host=10.67.0.10\n\n[linux:vars]\nansible_ssh_private_key_file=/etc/isoloom/id_ed25519\nansible_become=true\n\n[windows:vars]\nansible_user=isoloom\nansible_password=${random_password.windows.result}\nansible_connection=winrm\nansible_port=5985\nansible_winrm_scheme=http\nansible_winrm_transport=basic\nansible_winrm_server_cert_validation=ignore\nansible_winrm_operation_timeout_sec=400\nansible_winrm_read_timeout_sec=500\n")} | base64 -d > /etc/isoloom/inventory.ini) && chmod 0644 /etc/isoloom/inventory.ini; } || { echo 'failed: the inventory' > /var/lib/isoloom/ready; exit 1; }\necho 'running: hosts file' > /var/lib/isoloom/ready; { sh -c 'printf '\\''%s\\n'\\'' '\\''10.67.0.10 iis'\\'' >> /etc/hosts'; } || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }\necho 'running: packages' > /var/lib/isoloom/ready; { sh -c 'DEBIAN_FRONTEND=noninteractive apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq python3-venv curl netcat-openbsd openssh-client >/dev/null'; } || { echo 'failed: packages' > /var/lib/isoloom/ready; exit 1; }\necho 'running: installing Ansible' > /var/lib/isoloom/ready; { sh -c '[ -x /opt/ansible/bin/ansible-playbook ] || { python3 -m venv /opt/ansible && /opt/ansible/bin/pip install -q '\\''ansible-core>=2.15,<2.17'\\'' pywinrm; }'; } || { echo 'failed: installing Ansible' > /var/lib/isoloom/ready; exit 1; }\necho 'running: waiting for the Windows machines' > /var/lib/isoloom/ready; { sh -c 'i=0; until /opt/ansible/bin/ansible -i /etc/isoloom/inventory.ini iis -m raw -a '\\''if (-not (Test-Path C:\\isoloom\\ready)) { exit 1 }'\\'' >/dev/null 2>&1; do i=$((i+1)); [ $i -gt 360 ] && { echo '\\''iis not ready'\\''; exit 1; }; sleep 10; done'; } || { echo 'failed: waiting for the Windows machines' > /var/lib/isoloom/ready; exit 1; }\necho 'running: the playbooks' > /var/lib/isoloom/ready; { sh -c 'set -e\nmkdir -p /tmp/isoloom-facts\nexport PATH=\"/opt/ansible/bin:$PATH\" ANSIBLE_HOST_KEY_CHECKING=False ANSIBLE_GATHERING=smart ANSIBLE_FORKS=20 ANSIBLE_PIPELINING=True ANSIBLE_CACHE_PLUGIN=jsonfile ANSIBLE_CACHE_PLUGIN_CONNECTION=/tmp/isoloom-facts ANSIBLE_CACHE_PLUGIN_TIMEOUT=7200\nmkdir -p /tmp/isoloom-retry\nexport ANSIBLE_RETRY_FILES_ENABLED=True ANSIBLE_RETRY_FILES_SAVE_PATH=/tmp/isoloom-retry\n_isoloom_pause=$${ISOLOOM_RETRY_PAUSE:-15}\n_isoloom_attempts=4\n_isoloom_transient='\\''send_input failed|the pipe has been ended|winrmtransporterror|winrmoperationtimeouterror|read timeout|bad http response returned from server|(kerberos|ntlm|credssp).*500|remote end closed connection|connection reset by peer|connection refused|connection aborted|broken pipe|timed out|failed to connect to the host via ssh|shared connection to .* closed'\\''\nretry_download() {\n  _isoloom_n=1\n  until \"$@\"; do\n    [ \"$_isoloom_n\" -lt 5 ] || return 1\n    echo \"isoloom: download failed; trying again in $((_isoloom_n * _isoloom_pause)) s ($((_isoloom_n + 1))/5)\"\n    sleep $((_isoloom_n * _isoloom_pause))\n    _isoloom_n=$((_isoloom_n + 1))\n  done\n}\nplay_hosts() {\n  awk -v transient=\"$_isoloom_transient\" '\\''\n    function commit() {\n      if (pending != \"\") { if (pending_real) real[pending] = 1; else cut[pending] = 1 }\n      pending = \"\"\n    }\n    { gsub(/\\033\\[[0-9;]*m/, \"\") }\n    /^\\.\\.\\.ignoring/ { pending = \"\"; next }\n    { commit() }\n    /^(fatal|failed): \\[/ && !/UNREACHABLE!/ {\n      pending = $0\n      sub(/^(fatal|failed): \\[/, \"\", pending)\n      sub(/\\].*/, \"\", pending)\n      sub(/ -> .*/, \"\", pending)\n      pending_real = (tolower($0) !~ transient)\n      next\n    }\n    /^PLAY RECAP/ { recap = 1; next }\n    recap && / : ok=/ {\n      for (i = 2; i <= NF; i++) {\n        split($i, kv, \"=\")\n        if (kv[1] == \"failed\" && kv[2] > 0) failed[$1] = 1\n        if (kv[1] == \"unreachable\" && kv[2] > 0) unreachable[$1] = 1\n      }\n    }\n    END {\n      commit()\n      for (h in failed) print ((h in real || !(h in cut)) ? \"real \" : \"cut \") h\n      for (h in unreachable) if (!(h in failed)) print \"unreachable \" h\n    }\n  '\\'' \"$1\" | sort\n}\n_isoloom_kind() {\n  echo \"$1\" | awk -v k=\"$2\" '\\''$1 == k { printf \"%s%s\", s, $2; s = \" \" }'\\''\n}\nrun_play() {\n  # The playbook is the last argument; Ansible names its retry file after it.\n  for _isoloom_book; do :; done\n  _isoloom_name=$(basename \"$_isoloom_book\")\n  _isoloom_retry=$${ANSIBLE_RETRY_FILES_SAVE_PATH:-/tmp/isoloom-retry}/$${_isoloom_name%.*}.retry\n  _isoloom_limit=\n  _isoloom_log=$(mktemp)\n  _isoloom_rcf=$(mktemp)\n  _isoloom_n=1\n  rm -f \"$_isoloom_retry\"\n  while :; do\n    { \"$@\" && echo 0 > \"$_isoloom_rcf\" || echo $? > \"$_isoloom_rcf\"; } 2>&1 | tee \"$_isoloom_log\"\n    _isoloom_rc=$(cat \"$_isoloom_rcf\")\n    [ \"$_isoloom_rc\" -ne 0 ] || break\n    _isoloom_hosts=$(play_hosts \"$_isoloom_log\")\n    _isoloom_real=$(_isoloom_kind \"$_isoloom_hosts\" real)\n    _isoloom_gone=$(_isoloom_kind \"$_isoloom_hosts\" unreachable)\n    _isoloom_cut=$(_isoloom_kind \"$_isoloom_hosts\" cut)\n    _isoloom_again=\"$_isoloom_gone$${_isoloom_gone:+$${_isoloom_cut:+ }}$_isoloom_cut\"\n    if [ -n \"$_isoloom_real\" ]; then\n      echo \"isoloom: $_isoloom_name: a task failed on $_isoloom_real: not retried\"\n      break\n    fi\n    if [ -z \"$_isoloom_again\" ]; then\n      echo \"isoloom: $_isoloom_name failed (exit $_isoloom_rc) with no unreachable host or dropped connection: not retried\"\n      break\n    fi\n    if [ \"$_isoloom_n\" -ge \"$_isoloom_attempts\" ]; then\n      echo \"isoloom: $_isoloom_name: still unreachable after $_isoloom_n runs: $_isoloom_again; giving up\"\n      break\n    fi\n    echo \"$_isoloom_again\" | tr '\\'' '\\'' '\\''\\n'\\'' > \"$_isoloom_retry\"\n    if [ -z \"$_isoloom_limit\" ]; then set -- \"$@\" --limit \"@$_isoloom_retry\"; _isoloom_limit=1; fi\n    _isoloom_n=$((_isoloom_n + 1))\n    if [ -n \"$_isoloom_gone\" ]; then\n      _isoloom_wait=$((4 * _isoloom_pause))\n      echo \"isoloom: $_isoloom_name: unreachable: $_isoloom_again; waiting $_isoloom_wait s, then running it again on them ($_isoloom_n/$_isoloom_attempts)\"\n    else\n      _isoloom_wait=$((2 * _isoloom_pause))\n      echo \"isoloom: $_isoloom_name: the play was cut by a dropped connection on $_isoloom_cut; waiting $_isoloom_wait s, then running it again on them ($_isoloom_n/$_isoloom_attempts)\"\n    fi\n    sleep \"$_isoloom_wait\"\n  done\n  rm -f \"$_isoloom_log\" \"$_isoloom_rcf\"\n  [ \"$_isoloom_rc\" -ne 0 ] || rm -f \"$_isoloom_retry\"\n  return \"$_isoloom_rc\"\n}'; } || { echo 'failed: the playbooks' > /var/lib/isoloom/ready; exit 1; }\necho 'running: health check' > /var/lib/isoloom/ready; { sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'; } || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }\nfi\necho ready > /var/lib/isoloom/ready\nrm -f /var/lib/isoloom/part\ncommand -v systemctl >/dev/null && systemctl disable isoloom-setup.service >/dev/null 2>&1\nexit 0\nISOLOOM_SETUP\nmv -f /var/lib/isoloom/setup.sh.new /var/lib/isoloom/setup.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-setup.service <<'ISOLOOM_UNIT'\n[Unit]\nDescription=Isoloom: the machine's set-up\nWants=network-online.target\nAfter=network-online.target cloud-final.service google-startup-scripts.service\n\n[Service]\nType=oneshot\nExecStart=/bin/sh /var/lib/isoloom/setup.sh\nStandardOutput=append:/var/log/isoloom-setup.log\nStandardError=append:/var/log/isoloom-setup.log\nTimeoutStartSec=0\n\n[Install]\nWantedBy=multi-user.target\nISOLOOM_UNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-setup.service >/dev/null 2>&1\nsystemctl start --no-block isoloom-setup.service\nelse\nnohup sh /var/lib/isoloom/setup.sh >> /var/log/isoloom-setup.log 2>&1 &\nfi\n")
  primary_network_interface {
    network_interface_id = aws_network_interface.isoloom_controller_lab.id
  }
  tags = { Name = "${local.name}-controller" }
}

resource "aws_eip" "isoloom_controller" {
  network_interface = aws_network_interface.isoloom_controller_lab.id
  depends_on        = [aws_internet_gateway.env]
}

output "machines" {
  value = { iis = aws_instance.iis.public_ip }
}

output "address_iis" {
  value = aws_instance.iis.public_ip
}

output "address_isoloom_controller" {
  value = aws_eip.isoloom_controller.public_ip
}

output "ssh_users" {
  value = { iis = "isoloom" }
}

output "ip" {
  value = aws_eip.isoloom_controller.public_ip
}

output "ready_file" {
  value = "/var/lib/isoloom/ready"
}

# The checks: each runner on the machine it stands for (ssh <user>@<host> '<command>'), or `isoloom test cloud-vm`.
output "checks" {
  value = [
    {
      position = "networks"
      machine  = "controller"
      host     = aws_eip.isoloom_controller.public_ip
      user     = "admin"
      command  = "cd /opt/isoloom && sh .isoloom/cloud-vm/checks/networks.sh"
    }
  ]
}

output "published" {
  value = { "iis/http" = "${aws_instance.iis.public_ip}:8087" }
}

# The project's files the machines don't get: version control and the tools' state, and what
# .isoloomignore at the project's root lists (gitignore-style: one pattern per line, `#` comments,
# `!` brings a path back, a trailing `/` matches folders only, a `/` at the start or in the middle
# anchors the pattern at the root; `*`, `?`, `[abc]`, `**`; the last pattern matching a path, or
# a folder it is in, decides). Read as regular expressions, as the Vagrantfiles do.
locals {
  project_ignore_lines = [for l in split("\n", replace(try(file("${local.root}/.isoloomignore"), ""), "\r", "")) : trimspace(l)]
  project_ignore_pats  = [for l in local.project_ignore_lines : { keep = startswith(l, "!"), pat = trimprefix(l, "!") } if l != "" && !startswith(l, "#")]
  project_ignore_globs = [for r in local.project_ignore_pats : merge(r, { glob = trimsuffix(trimsuffix(trimsuffix(r.pat, "/"), "/**"), "/") })]
  project_ignore = [for r in local.project_ignore_globs : {
    keep = r.keep
    re = format(r.glob == r.pat ? "^%s(/|$)" : "^%s/", replace(replace(replace(replace(replace(replace(replace(replace(
      length(split("/", r.glob)) > 1 ? trimprefix(r.glob, "/") : "**/${r.glob}",
    "/[.+^$(){}|\\\\]/", "\\$0"), "[!", "[^"), "**/", "\u0001"), "**", "\u0002"), "*", "[^/]*"), "?", "[^/]"), "\u0001", "(.*/)?"), "\u0002", ".*"))
  } if r.glob != ""]
  # Each file: whether it goes (the last matching pattern decides; none: it goes).
  project_keep    = { for f in fileset(local.root, "**") : f => reverse(concat([true], [for r in local.project_ignore : r.keep if length(regexall(r.re, f)) > 0]))[0] }
  project_ignored = [for f, keep in local.project_keep : f if !keep]
}

# What `tar` leaves out of the project's archive: .isoloomignore's files, from the archive's top
# folder, their wildcard characters escaped.
resource "local_file" "isoloom_project" {
  filename = "${path.module}/.isoloom-project-ignored.txt"
  content  = join("", [for f in local.project_ignored : "${replace("${basename(local.root)}/${f}", "/[\\\\*?\\[]/", "\\$0")}\n"])
}

## .isoloom/cloud-vm/aws/run.json
{
  "$schema": "https://www.isoloom.com/schema/run-manifest/v0.json",
  "manifest_version": 0,
  "generator": {
    "name": "isoloom",
    "version": "0.11.0"
  },
  "lab": {
    "name": "configured-windows",
    "instance": null,
    "message": null
  },
  "target": "cloud-vm",
  "cloud": "aws",
  "driver": "terraform",
  "hosts": [
    "linux",
    "macos",
    "windows"
  ],
  "tools": [
    {
      "name": "terraform",
      "probe": [
        "terraform",
        "version"
      ],
      "min_version": "1.11.0"
    },
    {
      "name": "ssh",
      "probe": [
        "ssh",
        "-V"
      ]
    }
  ],
  "identity": {
    "terraform": {
      "module": ".",
      "state": "runner"
    }
  },
  "params": [
    {
      "name": "region",
      "description": "The module's `region`.",
      "default": "eu-west-3",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "region"
        }
      ]
    },
    {
      "name": "allowed_cidr",
      "description": "Who may reach the machines (SSH and the published ports), e.g. your IP/32.",
      "required": true,
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "allowed_cidr"
        }
      ]
    },
    {
      "name": "AWS_PROFILE",
      "description": "The AWS CLI profile the provider signs in with (its credentials and settings), when no keys are given.",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "AWS_PROFILE",
          "steps": [
            "init",
            "apply",
            "destroy"
          ]
        }
      ]
    },
    {
      "name": "ISOLOOM_DERIVED",
      "description": "0: the checks derived from the spec (reachability, no internet) are skipped.",
      "default": "1",
      "values": [
        "0",
        "1"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_DERIVED",
          "steps": [
            "check-networks"
          ]
        }
      ]
    }
  ],
  "secrets": [
    {
      "name": "AWS_ACCESS_KEY_ID",
      "kind": "connection",
      "required": false,
      "sensitive": true,
      "source": {
        "store": "env",
        "reference": "AWS_ACCESS_KEY_ID"
      },
      "deliver": [
        {
          "via": "env",
          "var": "AWS_ACCESS_KEY_ID",
          "steps": [
            "init",
            "apply",
            "destroy"
          ]
        }
      ]
    },
    {
      "name": "AWS_SECRET_ACCESS_KEY",
      "kind": "connection",
      "required": false,
      "sensitive": true,
      "source": {
        "store": "env",
        "reference": "AWS_SECRET_ACCESS_KEY"
      },
      "deliver": [
        {
          "via": "env",
          "var": "AWS_SECRET_ACCESS_KEY",
          "steps": [
            "init",
            "apply",
            "destroy"
          ]
        }
      ]
    },
    {
      "name": "AWS_SESSION_TOKEN",
      "kind": "connection",
      "required": false,
      "sensitive": true,
      "source": {
        "store": "env",
        "reference": "AWS_SESSION_TOKEN"
      },
      "deliver": [
        {
          "via": "env",
          "var": "AWS_SESSION_TOKEN",
          "steps": [
            "init",
            "apply",
            "destroy"
          ]
        }
      ]
    }
  ],
  "networks": [
    {
      "name": "lab",
      "cidr": "10.67.0.0/24",
      "internet": true,
      "native": "lab"
    }
  ],
  "machines": [
    {
      "name": "iis",
      "role": "target",
      "os": "windows-server-2022",
      "windows": true,
      "arch": "amd64",
      "addresses": {
        "lab": "10.67.0.10"
      },
      "ports": [
        {
          "name": "http",
          "port": 80,
          "protocol": "tcp",
          "http": true,
          "publish": {
            "mode": "fixed",
            "preferred": 8087,
            "address": "${outputs.address_iis}"
          }
        }
      ]
    },
    {
      "name": "isoloom-controller",
      "role": "infra",
      "addresses": {
        "lab": "10.67.0.253"
      }
    }
  ],
  "lifecycle": {
    "up": [
      {
        "id": "clear-lock",
        "action": "terraform.clear_lock"
      },
      {
        "id": "init",
        "note": "Preparing Terraform and its providers…",
        "argv": [
          "terraform",
          "init",
          "-input=false",
          "-no-color",
          "-backend-config=path=${run.state_dir}/terraform.tfstate"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 900
      },
      {
        "id": "apply",
        "note": "Creating the lab's machines in the cloud…",
        "argv": [
          "terraform",
          "apply",
          "-auto-approve",
          "-input=false",
          "-no-color"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 3600
      },
      {
        "id": "archive",
        "note": "Archiving the project…",
        "action": "project.archive",
        "with": {
          "root": "../../.."
        }
      },
      {
        "id": "deliver-isoloom-controller",
        "note": "Copying the project into isoloom-controller…",
        "action": "ssh.run",
        "with": {
          "command": "sudo sh -c 'mkdir -p /opt/isoloom /var/lib/isoloom && tar -xzf - -C /opt/isoloom && touch /var/lib/isoloom/project-delivered'",
          "host": "${outputs.address_isoloom_controller}",
          "user": "admin",
          "wait_s": "900"
        },
        "stdin": "${run.state_dir}/project.tgz",
        "timeout_s": 1500
      }
    ],
    "down": [
      {
        "id": "clear-lock",
        "action": "terraform.clear_lock"
      },
      {
        "id": "init",
        "note": "Preparing Terraform and its providers…",
        "argv": [
          "terraform",
          "init",
          "-input=false",
          "-no-color",
          "-backend-config=path=${run.state_dir}/terraform.tfstate"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 900
      },
      {
        "id": "destroy",
        "note": "Removing the lab from the cloud…",
        "argv": [
          "terraform",
          "destroy",
          "-auto-approve",
          "-input=false",
          "-no-color"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 3600
      }
    ],
    "status": {
      "id": "state",
      "action": "terraform.read_state"
    }
  },
  "ready": [
    {
      "kind": "step_ok",
      "step": "apply",
      "means": "the machines exist and booted; each sets itself up from its user data once the project is in"
    },
    {
      "kind": "ready_file",
      "host": "${outputs.address_isoloom_controller}",
      "user": "admin",
      "path": "${outputs.ready_file}",
      "log": "/var/log/isoloom-setup.log",
      "grammar": "isoloom-ready/1",
      "timeout_s": 7200,
      "unreachable_timeout_s": 600,
      "interval_s": 10
    }
  ],
  "outputs": [
    {
      "name": "ip",
      "description": "Where to stand: the access machine's public address (the first Linux machine's, else the controller's).",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ip"
      }
    },
    {
      "name": "ready_file",
      "description": "Where each Linux machine's set-up says how far it got (isoloom-ready/1).",
      "role": "info",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ready_file"
      }
    },
    {
      "name": "address_iis",
      "description": "iis's public address: the runner's SSH and its published ports reach it there.",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "address_iis"
      }
    },
    {
      "name": "address_isoloom_controller",
      "description": "isoloom-controller's public address: the runner's SSH and its published ports reach it there.",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "address_isoloom_controller"
      }
    },
    {
      "name": "iis_http",
      "description": "iis's http (port 80).",
      "role": "entry",
      "sensitive": false,
      "format": "http://${outputs.address_iis}:${value}/",
      "from": {
        "kind": "published_port",
        "machine": "iis",
        "port": "http"
      }
    }
  ],
  "checks": {
    "protocol": "isoloom-check/1",
    "setup": [],
    "runners": [
      {
        "id": "networks",
        "from": "from isoloom-controller",
        "checks": [
          {
            "name": "checks/iis-answers.sh",
            "kind": "script",
            "wait_s": 0,
            "derived": false
          },
          {
            "name": "iis:80 from the networks",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          }
        ],
        "step": {
          "id": "check-networks",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} sh .isoloom/cloud-vm/checks/networks.sh",
            "host": "${outputs.address_isoloom_controller}",
            "user": "admin"
          },
          "timeout_s": 120
        }
      }
    ],
    "teardown": []
  },
  "recovery": {
    "retries": 0,
    "apply_retries": 1
  },
  "expiry": {
    "tf_var": "expires_at",
    "unit": "unix_seconds",
    "default_minutes": 240
  }
}

## .isoloom/cloud-vm/azure/main.tf
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  terraform -chdir=.isoloom/cloud-vm/azure init && terraform -chdir=.isoloom/cloud-vm/azure apply \
#           -var allowed_cidr=<your IP>/32 -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)"
# Stop:   terraform -chdir=.isoloom/cloud-vm/azure destroy (same variables)
# Then:   the machines wait for the project: run the lab through the Isothrum runner (run.json
#         beside this file), which delivers the project over SSH, waits for each set-up and runs the checks.

terraform {
  required_version = ">= 1.6"
  backend "local" {}
  required_providers {
    azurerm = { source = "hashicorp/azurerm", version = "~> 5.8.0" }
    tls     = { source = "hashicorp/tls", version = "~> 4.4.1" }
    random  = { source = "hashicorp/random", version = "~> 3.9.1" }
    local   = { source = "hashicorp/local", version = "~> 2.9.1" }
  }
}

variable "subscription_id" {
  type        = string
  default     = null
  description = "Default: ARM_SUBSCRIPTION_ID from the environment"
}

variable "region" {
  type    = string
  default = "swedencentral"
}

variable "allowed_cidr" {
  type        = string
  description = "Who may reach the machines (SSH and the published ports), e.g. your IP/32"
}

variable "ssh_public_key" {
  type        = string
  description = "The key the machines let in: the Isothrum runner's (it delivers the project and runs the checks over SSH)"
}

variable "expires_at" {
  type        = string
  default     = ""
  description = "When the environment should end, in Unix seconds (empty: no end): a tag on every resource, so a reaper finds what to destroy, and the time the machines shut themselves down"
}

provider "azurerm" {
  features {}
  subscription_id = var.subscription_id
}

resource "terraform_data" "id" {
  input = substr(replace(uuid(), "-", ""), 0, 8)
  lifecycle {
    ignore_changes = [input]
  }
}

locals {
  name = "isoloom-configured-windows-${terraform_data.id.output}"
  root = abspath("${path.module}/../../..")
  tags = {
    isoloom-environment = "configured-windows"
    managed-by          = "isoloom"
    isoloom-instance    = local.name
    isoloom-expires-at  = var.expires_at
  }
}

resource "azurerm_resource_group" "env" {
  name     = local.name
  location = var.region
  tags     = local.tags
}

# The environment's networks: one virtual network, a subnet per network with its exact range.
resource "azurerm_virtual_network" "env" {
  name                = local.name
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  address_space       = ["10.67.0.0/24"]
}

resource "azurerm_subnet" "lab" {
  name                            = "lab"
  resource_group_name             = azurerm_resource_group.env.name
  virtual_network_name            = azurerm_virtual_network.env.name
  address_prefixes                = ["10.67.0.0/24"]
  default_outbound_access_enabled = true
}

# The Windows machines' administrator password (user isoloom), for WinRM.
resource "random_password" "windows" {
  length      = 24
  special     = false
  min_upper   = 2
  min_lower   = 2
  min_numeric = 2
}

# The controller's own key: it runs the playbooks over SSH on every machine.
resource "tls_private_key" "controller" {
  algorithm = "ED25519"
}

# Machine `iis` (Windows): what may reach it.
resource "azurerm_network_security_group" "iis" {
  name                = "${local.name}-iis"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  security_rule {
    name                       = "net-lab"
    priority                   = 100
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "10.67.0.0/24"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "winrm"
    priority                   = 110
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_range     = "5985"
    source_address_prefix      = var.allowed_cidr
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "published-8087"
    priority                   = 120
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_range     = "8087"
    source_address_prefix      = var.allowed_cidr
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "deny-rest-of-vnet"
    priority                   = 4000
    direction                  = "Inbound"
    access                     = "Deny"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "VirtualNetwork"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "outbound"
    priority                   = 100
    direction                  = "Outbound"
    access                     = "Allow"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "*"
    destination_address_prefix = "*"
  }
}

resource "azurerm_public_ip" "iis" {
  name                = "${local.name}-iis"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  allocation_method   = "Static"
  sku                 = "Standard"
}

resource "azurerm_network_interface" "iis_lab" {
  name                = "${local.name}-iis-lab"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  ip_configuration {
    name                          = "primary"
    subnet_id                     = azurerm_subnet.lab.id
    private_ip_address_allocation = "Static"
    private_ip_address            = "10.67.0.10"
    public_ip_address_id          = azurerm_public_ip.iis.id
  }
}

resource "azurerm_network_interface_security_group_association" "iis_lab" {
  network_interface_id      = azurerm_network_interface.iis_lab.id
  network_security_group_id = azurerm_network_security_group.iis.id
}

resource "azurerm_windows_virtual_machine" "iis" {
  name                  = "${local.name}-iis"
  resource_group_name   = azurerm_resource_group.env.name
  location              = var.region
  tags                  = local.tags
  computer_name         = "iis"
  size                  = "Standard_B2ls_v2"
  admin_username        = "isoloom"
  admin_password        = random_password.windows.result
  network_interface_ids = [azurerm_network_interface.iis_lab.id]
  winrm_listener {
    protocol = "Http"
  }
  os_disk {
    caching              = "ReadWrite"
    storage_account_type = "StandardSSD_LRS"
    disk_size_gb         = 127
  }
  source_image_reference {
    publisher = "MicrosoftWindowsServer"
    offer     = "WindowsServer"
    sku       = "2022-datacenter-azure-edition"
    version   = "latest"
  }
}

resource "terraform_data" "iis" {
  triggers_replace = [azurerm_windows_virtual_machine.iis.id]
  connection {
    type     = "winrm"
    host     = azurerm_public_ip.iis.ip_address
    user     = "isoloom"
    password = random_password.windows.result
    https    = false
    use_ntlm = true
    timeout  = "30m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-iis.tgz\" --exclude=.git --exclude=.vagrant --exclude=.terraform --exclude=.isoloom-project* -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-iis.tgz"
    destination = "C:/Windows/Temp/isoloom-project.tgz"
  }
  provisioner "file" {
    content     = "$ErrorActionPreference = 'Stop'\nif ($env:COMPUTERNAME -ne 'IIS') { throw \"still named $env:COMPUTERNAME: the rename hasn't taken effect\" }\nnetsh interface portproxy add v4tov4 listenport=8087 listenaddress=0.0.0.0 connectport=80 connectaddress=127.0.0.1 | Out-Null\nNew-NetFirewallRule -DisplayName 'isoloom 80' -Direction Inbound -Protocol TCP -LocalPort 80 -Action Allow | Out-Null\nNew-NetFirewallRule -DisplayName 'isoloom 8087' -Direction Inbound -Protocol TCP -LocalPort 8087 -Action Allow | Out-Null\n$archive = 'C:\\Windows\\Temp\\isoloom-project.tgz'; $dest = 'C:\\isoloom'; $strip = 1\n# The project into a Windows machine: unpacks the tar.gz $archive into $dest (replacing an older\n# copy), leaving out the archive's first $strip folders. Plain .NET (GZipStream), so it runs on\n# every Windows Isoloom supports: PowerShell 2.0 and later, and no tar.exe before Windows Server\n# 2019. Symbolic links are left out (counted).\n& {\n  $ErrorActionPreference = 'Stop'\n  $sep = [IO.Path]::DirectorySeparatorChar\n  $new = \"$dest.new\"\n  if (Test-Path $new) { Remove-Item $new -Recurse -Force }\n  [void][IO.Directory]::CreateDirectory($new)\n  $file = New-Object IO.FileStream($archive, [IO.FileMode]::Open, [IO.FileAccess]::Read)\n  $in = New-Object IO.Compression.GZipStream($file, [IO.Compression.CompressionMode]::Decompress)\n  $utf8 = New-Object Text.UTF8Encoding($false)\n  $header = New-Object byte[] 512\n  $chunk = New-Object byte[] 65536\n  function Fill([byte[]]$b, [int]$n) {\n    $got = 0\n    while ($got -lt $n) {\n      $r = $in.Read($b, $got, $n - $got)\n      if ($r -le 0) { throw \"$archive ends early\" }\n      $got += $r\n    }\n  }\n  function Field([int]$at, [int]$len) {\n    $end = [Array]::IndexOf($header, [byte]0, $at, $len)\n    if ($end -lt 0) { $end = $at + $len }\n    $utf8.GetString($header, $at, $end - $at)\n  }\n  # Copies $size bytes to $out (or skips them, with no $out), then the padding after them.\n  function Body([long]$size, $out) {\n    $left = $size\n    while ($left -gt 0) {\n      $n = [int][Math]::Min([long]$chunk.Length, $left)\n      Fill $chunk $n\n      if ($out) { $out.Write($chunk, 0, $n) }\n      $left -= $n\n    }\n    $pad = [int]((512 - $size % 512) % 512)\n    if ($pad) { Fill $chunk $pad }\n  }\n  $pax = @{}\n  $links = 0\n  $files = 0\n  while ($true) {\n    Fill $header 512\n    if ($header[148] -eq 0) { break } # the end: zero blocks have no checksum\n    $type = [char]$header[156]\n    $sizeText = (Field 124 12).Trim()\n    $size = [long]0\n    if ($sizeText) { $size = [Convert]::ToInt64($sizeText, 8) }\n    if ($pax['size']) { $size = [long]$pax['size'] }\n    if ($type -eq 'x') {\n      # pax records (\"<length> key=value\\n\"): a long path, a large size, for the next entry.\n      $ms = New-Object IO.MemoryStream\n      Body $size $ms\n      $b = $ms.ToArray()\n      $i = 0\n      while ($i -lt $b.Length) {\n        $sp = [Array]::IndexOf($b, [byte]32, $i)\n        $len = [int]$utf8.GetString($b, $i, $sp - $i)\n        $eq = [Array]::IndexOf($b, [byte]61, $sp)\n        $pax[$utf8.GetString($b, $sp + 1, $eq - $sp - 1)] = $utf8.GetString($b, $eq + 1, $i + $len - $eq - 2)\n        $i += $len\n      }\n      continue\n    }\n    if ($type -eq 'L' -or $type -eq 'K') {\n      # GNU tar's long name (or link target) for the next entry.\n      $ms = New-Object IO.MemoryStream\n      Body $size $ms\n      if ($type -eq 'L') { $pax['path'] = $utf8.GetString($ms.ToArray()).TrimEnd([char]0) }\n      continue\n    }\n    $name = Field 0 100\n    $prefix = Field 345 155\n    if ($prefix) { $name = \"$prefix/$name\" }\n    if ($pax['path']) { $name = $pax['path'] }\n    $pax = @{}\n    $parts = @($name.Split('/') | Where-Object { $_ -ne '' -and $_ -ne '.' })\n    if ($parts.Count -le $strip) { Body $size $null; continue }\n    $path = Join-Path $new ([string]::Join([string]$sep, [string[]]($parts[$strip..($parts.Count - 1)])))\n    if ($type -eq '5' -or $type -eq '0' -or $type -eq [char]0) {\n      # A name Windows can't take (`:`, `*`, too long...) is left out, with a warning.\n      $out = $null\n      try {\n        if ($type -eq '5') {\n          [void][IO.Directory]::CreateDirectory($path)\n        } else {\n          [void][IO.Directory]::CreateDirectory([IO.Path]::GetDirectoryName($path))\n          $out = [IO.File]::Create($path)\n        }\n      } catch {\n        Write-Warning \"Not copied: $name ($($_.Exception.Message))\"\n        Body $size $null\n        continue\n      }\n      if ($out) {\n        try { Body $size $out } finally { $out.Close() }\n        $files++\n      } else {\n        Body $size $null\n      }\n    } else {\n      if ($type -eq '2') { $links++ }\n      Body $size $null\n    }\n  }\n  $in.Close()\n  if (Test-Path $dest) { Remove-Item $dest -Recurse -Force }\n  Move-Item $new $dest\n  Remove-Item $archive -Force\n  $note = ''\n  if ($links) { $note = \" ($links symbolic links left out)\" }\n  \"$files files in $dest$note\"\n}\n$h = \"$env:SystemRoot\\System32\\drivers\\etc\\hosts\"; foreach ($l in @('10.67.0.10 iis')) { if (-not (Select-String -Path $h -SimpleMatch $l -Quiet)) { Add-Content -Path $h -Value $l } }\n$ErrorActionPreference = 'Stop'\n[Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12\nfunction Write-IsoloomChange {\n    param([Parameter(Mandatory)][string] $What)\n    Write-Output \"isoloom: changed $What\"\n    if ($env:ISOLOOM_CHANGED) {\n        New-Item -ItemType Directory -Force -Path (Split-Path -Parent $env:ISOLOOM_CHANGED) | Out-Null\n        Set-Content -LiteralPath $env:ISOLOOM_CHANGED -Value 'changed'\n    }\n}\nfunction Test-IsoloomRestartDue {\n    return [bool]($env:ISOLOOM_CHANGED -and (Test-Path -LiteralPath $env:ISOLOOM_CHANGED))\n}\nfunction Get-IsoloomHash {\n    param([Parameter(Mandatory)][string] $Path)\n    return (Get-FileHash -LiteralPath $Path -Algorithm SHA256).Hash.ToLowerInvariant()\n}\nfunction Install-IsoloomFeature {\n    param([Parameter(Mandatory)][string[]] $Name)\n    $server = [bool](Get-Command -Name Get-WindowsFeature -ErrorAction SilentlyContinue)\n    foreach ($feature in $Name) {\n        if ($server) {\n            if ((Get-WindowsFeature -Name $feature).Installed) { continue }\n            $result = Install-WindowsFeature -Name $feature -IncludeManagementTools\n            if (-not $result.Success) { throw \"isoloom: installing the feature $feature failed\" }\n        } else {\n            if ((Get-WindowsOptionalFeature -Online -FeatureName $feature).State -eq 'Enabled') { continue }\n            Enable-WindowsOptionalFeature -Online -FeatureName $feature -All -NoRestart | Out-Null\n        }\n        Write-IsoloomChange -What \"feature $feature\"\n    }\n}\nfunction Copy-IsoloomFile {\n    param([Parameter(Mandatory)][string] $From, [Parameter(Mandatory)][string] $To)\n    if ((Test-Path -LiteralPath $To -PathType Leaf) -and ((Get-IsoloomHash -Path $From) -eq (Get-IsoloomHash -Path $To))) {\n        return\n    }\n    $parent = Split-Path -Parent $To\n    if ($parent) { New-Item -ItemType Directory -Force -Path $parent | Out-Null }\n    Copy-Item -LiteralPath $From -Destination $To -Force\n    Write-IsoloomChange -What $To\n}\nfunction Copy-IsoloomItem {\n    param([Parameter(Mandatory)][string] $From, [Parameter(Mandatory)][string] $To)\n    if (-not (Test-Path -LiteralPath $From -PathType Container)) {\n        Copy-IsoloomFile -From $From -To $To\n        return\n    }\n    $root = (Resolve-Path -LiteralPath $From).Path.TrimEnd('\\', '/')\n    if (-not (Test-Path -LiteralPath $To -PathType Container)) {\n        New-Item -ItemType Directory -Force -Path $To | Out-Null\n        Write-IsoloomChange -What $To\n    }\n    foreach ($entry in Get-ChildItem -LiteralPath $root -Recurse -Force) {\n        $target = Join-Path -Path $To -ChildPath $entry.FullName.Substring($root.Length).TrimStart('\\', '/')\n        if ($entry.PSIsContainer) {\n            if (Test-Path -LiteralPath $target -PathType Container) { continue }\n            New-Item -ItemType Directory -Force -Path $target | Out-Null\n            Write-IsoloomChange -What $target\n        } else {\n            Copy-IsoloomFile -From $entry.FullName -To $target\n        }\n    }\n}\nfunction Install-IsoloomTemplate {\n    param([Parameter(Mandatory)][string] $To, [Parameter(Mandatory)][AllowEmptyString()][string] $Base64)\n    $temporary = [IO.Path]::GetTempFileName()\n    try {\n        [IO.File]::WriteAllBytes($temporary, [Convert]::FromBase64String($Base64))\n        Copy-IsoloomFile -From $temporary -To $To\n    } finally {\n        Remove-Item -LiteralPath $temporary -Force -ErrorAction SilentlyContinue\n    }\n}\nfunction Install-IsoloomFile {\n    param(\n        [Parameter(Mandatory)][string] $Path,\n        [Parameter(Mandatory)][ValidateSet('directory', 'absent', 'download')][string] $State,\n        [string] $Url,\n        [string] $Sha256\n    )\n    switch ($State) {\n        'directory' {\n            if (Test-Path -LiteralPath $Path -PathType Container) { return }\n            New-Item -ItemType Directory -Force -Path $Path | Out-Null\n        }\n        'absent' {\n            if (-not (Test-Path -LiteralPath $Path)) { return }\n            Remove-Item -LiteralPath $Path -Recurse -Force\n        }\n        'download' {\n            if ((Test-Path -LiteralPath $Path -PathType Leaf) -and ((Get-IsoloomHash -Path $Path) -eq $Sha256)) { return }\n            $parent = Split-Path -Parent $Path\n            if ($parent) { New-Item -ItemType Directory -Force -Path $parent | Out-Null }\n            $temporary = \"$Path.isoloom-download\"\n            Invoke-WebRequest -UseBasicParsing -Uri $Url -OutFile $temporary\n            $got = Get-IsoloomHash -Path $temporary\n            if ($got -ne $Sha256) {\n                Remove-Item -LiteralPath $temporary -Force\n                throw \"isoloom: $Url has SHA-256 $got, not $${Sha256}: the file changed upstream, or the pin is wrong\"\n            }\n            Move-Item -LiteralPath $temporary -Destination $Path -Force\n        }\n    }\n    Write-IsoloomChange -What $Path\n}\nfunction ConvertTo-IsoloomSecure {\n    param([Parameter(Mandatory)][string] $Phrase)\n    $secure = New-Object -TypeName System.Security.SecureString\n    foreach ($character in $Phrase.ToCharArray()) { $secure.AppendChar($character) }\n    return $secure\n}\nfunction Test-IsoloomPhrase {\n    param([Parameter(Mandatory)][string] $Name, [Parameter(Mandatory)][string] $Phrase)\n    Add-Type -AssemblyName System.DirectoryServices.AccountManagement\n    $machine = New-Object -TypeName System.DirectoryServices.AccountManagement.PrincipalContext -ArgumentList 'Machine'\n    try { return $machine.ValidateCredentials($Name, $Phrase) } finally { $machine.Dispose() }\n}\nfunction Add-IsoloomMember {\n    param([Parameter(Mandatory)][string] $Group, [Parameter(Mandatory)][string] $Name)\n    $members = Get-LocalGroupMember -Group $Group | ForEach-Object { ($_.Name -split '\\\\')[-1] }\n    if ($members -contains $Name) { return }\n    Add-LocalGroupMember -Group $Group -Member $Name\n    Write-IsoloomChange -What \"$Name in $Group\"\n}\nfunction Add-IsoloomUser {\n    param([Parameter(Mandatory)][string] $Name, [string] $Phrase, [string[]] $Groups = @())\n    if (-not (Get-LocalUser -Name $Name -ErrorAction SilentlyContinue)) {\n        if ($Phrase) {\n            New-LocalUser -Name $Name -Password (ConvertTo-IsoloomSecure -Phrase $Phrase) -PasswordNeverExpires | Out-Null\n        } else {\n            New-LocalUser -Name $Name -NoPassword | Out-Null\n        }\n        Write-IsoloomChange -What \"user $Name\"\n    } elseif ($Phrase -and -not (Test-IsoloomPhrase -Name $Name -Phrase $Phrase)) {\n        Set-LocalUser -Name $Name -Password (ConvertTo-IsoloomSecure -Phrase $Phrase)\n        Write-IsoloomChange -What \"password of $Name\"\n    }\n    foreach ($group in $Groups) { Add-IsoloomMember -Group $group -Name $Name }\n}\nfunction Add-IsoloomGroup {\n    param([Parameter(Mandatory)][string] $Name)\n    if (Get-LocalGroup -Name $Name -ErrorAction SilentlyContinue) { return }\n    New-LocalGroup -Name $Name | Out-Null\n    Write-IsoloomChange -What \"group $Name\"\n}\nfunction Register-IsoloomTask {\n    param([Parameter(Mandatory)][string] $Name, [Parameter(Mandatory)][string[]] $Run, [string] $Directory)\n    $arguments = ($Run | Select-Object -Skip 1 | ForEach-Object { '\"' + ($_ -replace '\"', '\\\"') + '\"' }) -join ' '\n    $settings = @{ Execute = $Run[0] }\n    if ($arguments) { $settings.Argument = $arguments }\n    if ($Directory) { $settings.WorkingDirectory = $Directory }\n    $action = New-ScheduledTaskAction @settings\n    $task = Get-ScheduledTask -TaskName \"isoloom-$Name\" -ErrorAction SilentlyContinue\n    $same = $task -and $task.Actions[0].Execute -eq $action.Execute -and $task.Actions[0].Arguments -eq $action.Arguments -and\n        $task.Actions[0].WorkingDirectory -eq $action.WorkingDirectory\n    if ($same) { return }\n    $trigger = New-ScheduledTaskTrigger -AtStartup\n    Register-ScheduledTask -TaskName \"isoloom-$Name\" -Action $action -Trigger $trigger -User 'SYSTEM' -RunLevel Highest -Force | Out-Null\n    Write-IsoloomChange -What \"task isoloom-$Name\"\n}\nfunction Register-IsoloomTaskState {\n    param([Parameter(Mandatory)][string] $Name, [Parameter(Mandatory)][bool] $Enabled)\n    $task = Get-ScheduledTask -TaskName \"isoloom-$Name\"\n    if (-not $Enabled) {\n        if ($task.State -eq 'Running') { Stop-ScheduledTask -TaskName \"isoloom-$Name\"; Write-IsoloomChange -What \"isoloom-$Name stopped\" }\n        if ($task.State -ne 'Disabled') { Disable-ScheduledTask -TaskName \"isoloom-$Name\" | Out-Null; Write-IsoloomChange -What \"isoloom-$Name disabled\" }\n        return\n    }\n    if ($task.State -eq 'Disabled') { Enable-ScheduledTask -TaskName \"isoloom-$Name\" | Out-Null; Write-IsoloomChange -What \"isoloom-$Name enabled\" }\n    if ((Get-ScheduledTask -TaskName \"isoloom-$Name\").State -ne 'Running') {\n        Start-ScheduledTask -TaskName \"isoloom-$Name\"\n        Write-IsoloomChange -What \"isoloom-$Name started\"\n    } elseif (Test-IsoloomRestartDue) {\n        Stop-ScheduledTask -TaskName \"isoloom-$Name\"\n        Start-ScheduledTask -TaskName \"isoloom-$Name\"\n        Write-Output \"isoloom: restarted isoloom-$Name\"\n    }\n}\nfunction Register-IsoloomService {\n    param([Parameter(Mandatory)][string] $Name, [Parameter(Mandatory)][bool] $Enabled)\n    $service = Get-Service -Name $Name -ErrorAction SilentlyContinue\n    if (-not $service) { throw \"isoloom: no Windows service $${Name}: install what provides it in an earlier step\" }\n    if (-not $Enabled) {\n        if ($service.StartType -ne 'Disabled') { Set-Service -Name $Name -StartupType Disabled; Write-IsoloomChange -What \"$Name disabled\" }\n        if ($service.Status -ne 'Stopped') { Stop-Service -Name $Name -Force; Write-IsoloomChange -What \"$Name stopped\" }\n        return\n    }\n    if ($service.StartType -ne 'Automatic') { Set-Service -Name $Name -StartupType Automatic; Write-IsoloomChange -What \"$Name enabled\" }\n    if ($service.Status -ne 'Running') {\n        Start-Service -Name $Name\n        Write-IsoloomChange -What \"$Name started\"\n    } elseif (Test-IsoloomRestartDue) {\n        Restart-Service -Name $Name -Force\n        Write-Output \"isoloom: restarted $Name\"\n    }\n}\nfunction Invoke-IsoloomCommand {\n    param([Parameter(Mandatory)][string] $Run, [string] $Creates, [string] $Unless)\n    if ($Creates -and (Test-Path -LiteralPath $Creates)) { return }\n    if ($Unless -and (Test-IsoloomScript -Text $Unless)) { return }\n    if (-not (Test-IsoloomScript -Text $Run -Loud)) { throw \"isoloom: the command failed: $Run\" }\n    Write-IsoloomChange -What 'command'\n}\nfunction Test-IsoloomScript {\n    param([Parameter(Mandatory)][string] $Text, [switch] $Loud)\n    Set-Variable -Name LASTEXITCODE -Scope Global -Value 0\n    try {\n        if ($Loud) { & ([scriptblock]::Create($Text)) } else { & ([scriptblock]::Create($Text)) | Out-Null }\n    } catch {\n        if ($Loud) { Write-Error -Message $_ -ErrorAction Continue }\n        return $false\n    }\n    return (Get-Variable -Name LASTEXITCODE -Scope Global -ValueOnly) -eq 0\n}\nfunction Enable-IsoloomFirewallPort {\n    param([Parameter(Mandatory)][int] $Port, [Parameter(Mandatory)][ValidateSet('TCP', 'UDP')][string] $Protocol)\n    $name = \"isoloom-$Port-$Protocol\"\n    if (Get-NetFirewallRule -Name $name -ErrorAction SilentlyContinue) { return }\n    New-NetFirewallRule -Name $name -DisplayName \"Isoloom $Port/$Protocol\" -Direction Inbound -Action Allow -Protocol $Protocol -LocalPort $Port | Out-Null\n    Write-IsoloomChange -What \"firewall $Port/$Protocol\"\n}\n$env:ISOLOOM_CHANGED = 'C:\\Windows\\Temp\\isoloom-configure.changed'\nRemove-Item -LiteralPath $env:ISOLOOM_CHANGED -Force -ErrorAction SilentlyContinue\nSet-Location -LiteralPath 'C:\\isoloom'\nInstall-IsoloomFeature -Name 'Web-Server'\nAdd-IsoloomGroup -Name 'Site Editors'\nAdd-IsoloomUser -Name 'editor' -Phrase 'Lab-content-1' -Groups 'Site Editors'\nInstall-IsoloomFile -Path 'C:\\inetpub\\isoloom' -State directory\nCopy-IsoloomItem -From 'site/' -To 'C:\\inetpub\\wwwroot'\nInstall-IsoloomTemplate -To 'C:\\inetpub\\wwwroot\\about.txt' -Base64 'aWlzIGF0IDEwLjY3LjAuMTAsIGNvbmZpZ3VyZWQgYnkgaXNvbG9vbS4K'\nInvoke-IsoloomCommand -Run 'Set-Content -Path C:\\inetpub\\isoloom\\stamp.txt -Value configured' -Creates 'C:\\inetpub\\isoloom\\stamp.txt'\nEnable-IsoloomFirewallPort -Port 80 -Protocol TCP\nRegister-IsoloomService -Name 'W3SVC' -Enabled $true\nNew-Item -ItemType Directory -Force C:\\isoloom | Out-Null; Set-Content C:\\isoloom\\ready ready\n"
    destination = "C:/ProgramData/isoloom/setup.ps1"
  }
  provisioner "remote-exec" {
    inline = [
      var.expires_at != "" ? "powershell -NoProfile -Command \"Register-ScheduledTask -TaskName isoloom-expiry -Action (New-ScheduledTaskAction -Execute shutdown.exe -Argument '/s /t 0') -Trigger (New-ScheduledTaskTrigger -Once -At ([DateTimeOffset]::FromUnixTimeSeconds(${var.expires_at}).LocalDateTime)) -User SYSTEM -RunLevel Highest -Force | Out-Null\"" : "cmd /c ver",
      "powershell -NoProfile -ExecutionPolicy Bypass -File C:/ProgramData/isoloom/setup.ps1"
    ]
  }
}

# The controller (Ansible): every network may reach it, and SSH from allowed_cidr.
resource "azurerm_network_security_group" "isoloom_controller" {
  name                = "${local.name}-controller"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  security_rule {
    name                       = "net-lab"
    priority                   = 100
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "10.67.0.0/24"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "ssh"
    priority                   = 110
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_range     = "22"
    source_address_prefix      = var.allowed_cidr
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "deny-rest-of-vnet"
    priority                   = 4000
    direction                  = "Inbound"
    access                     = "Deny"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "VirtualNetwork"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "outbound"
    priority                   = 100
    direction                  = "Outbound"
    access                     = "Allow"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "*"
    destination_address_prefix = "*"
  }
}

resource "azurerm_public_ip" "isoloom_controller" {
  name                = "${local.name}-controller"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  allocation_method   = "Static"
  sku                 = "Standard"
}

resource "azurerm_network_interface" "isoloom_controller_lab" {
  name                = "${local.name}-controller-lab"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  ip_configuration {
    name                          = "primary"
    subnet_id                     = azurerm_subnet.lab.id
    private_ip_address_allocation = "Static"
    private_ip_address            = "10.67.0.253"
    public_ip_address_id          = azurerm_public_ip.isoloom_controller.id
  }
}

resource "azurerm_network_interface_security_group_association" "isoloom_controller_lab" {
  network_interface_id      = azurerm_network_interface.isoloom_controller_lab.id
  network_security_group_id = azurerm_network_security_group.isoloom_controller.id
}

resource "azurerm_linux_virtual_machine" "isoloom_controller" {
  name                  = "${local.name}-controller"
  resource_group_name   = azurerm_resource_group.env.name
  location              = var.region
  tags                  = local.tags
  size                  = "Standard_B2ts_v2"
  admin_username        = "isoloom"
  network_interface_ids = [azurerm_network_interface.isoloom_controller_lab.id]
  custom_data           = base64encode("#!/bin/sh\n# Isoloom: this machine sets itself up. Its progress is in /var/lib/isoloom/ready (isoloom-ready/1), its output in /var/log/isoloom-setup.log. The Isothrum runner delivers the project over SSH.\nmkdir -p /var/lib/isoloom\ncat > /var/lib/isoloom/setup.sh.new <<'ISOLOOM_SETUP'\n#!/bin/sh\numask 022\ncase \"$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\" in ready|failed:*) exit 0 ;; esac\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\npart=$(cat /var/lib/isoloom/part 2>/dev/null || echo 1)\nif [ \"$part\" = 1 ]; then\necho 'running: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; { i=0; until [ -f /var/lib/isoloom/project-delivered ]; do i=$((i+5)); if [ $i -gt 2400 ]; then echo 'the project never came: start the lab through the Isothrum runner (run.json), which delivers it over SSH' >&2; exit 1; fi; sleep 5; done; } || { echo 'failed: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; exit 1; }\necho 'running: the controller'\\''s key' > /var/lib/isoloom/ready; { mkdir -p /etc/isoloom && (umask 077 && echo ${base64encode(tls_private_key.controller.private_key_openssh)} | base64 -d > /etc/isoloom/id_ed25519) && chmod 0600 /etc/isoloom/id_ed25519; } || { echo 'failed: the controller'\\''s key' > /var/lib/isoloom/ready; exit 1; }\necho 'running: the inventory' > /var/lib/isoloom/ready; { mkdir -p /etc/isoloom && (umask 077 && echo ${base64encode("[linux]\n\n[windows]\niis ansible_host=10.67.0.10\n\n[linux:vars]\nansible_ssh_private_key_file=/etc/isoloom/id_ed25519\nansible_become=true\n\n[windows:vars]\nansible_user=isoloom\nansible_password=${random_password.windows.result}\nansible_connection=winrm\nansible_port=5985\nansible_winrm_scheme=http\nansible_winrm_transport=ntlm\nansible_winrm_server_cert_validation=ignore\nansible_winrm_operation_timeout_sec=400\nansible_winrm_read_timeout_sec=500\n")} | base64 -d > /etc/isoloom/inventory.ini) && chmod 0644 /etc/isoloom/inventory.ini; } || { echo 'failed: the inventory' > /var/lib/isoloom/ready; exit 1; }\necho 'running: hosts file' > /var/lib/isoloom/ready; { sh -c 'printf '\\''%s\\n'\\'' '\\''10.67.0.10 iis'\\'' >> /etc/hosts'; } || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }\necho 'running: packages' > /var/lib/isoloom/ready; { sh -c 'DEBIAN_FRONTEND=noninteractive apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq python3-venv curl netcat-openbsd openssh-client >/dev/null'; } || { echo 'failed: packages' > /var/lib/isoloom/ready; exit 1; }\necho 'running: installing Ansible' > /var/lib/isoloom/ready; { sh -c '[ -x /opt/ansible/bin/ansible-playbook ] || { python3 -m venv /opt/ansible && /opt/ansible/bin/pip install -q '\\''ansible-core>=2.15,<2.17'\\'' pywinrm; }'; } || { echo 'failed: installing Ansible' > /var/lib/isoloom/ready; exit 1; }\necho 'running: waiting for the Windows machines' > /var/lib/isoloom/ready; { sh -c 'i=0; until /opt/ansible/bin/ansible -i /etc/isoloom/inventory.ini iis -m raw -a '\\''if (-not (Test-Path C:\\isoloom\\ready)) { exit 1 }'\\'' >/dev/null 2>&1; do i=$((i+1)); [ $i -gt 360 ] && { echo '\\''iis not ready'\\''; exit 1; }; sleep 10; done'; } || { echo 'failed: waiting for the Windows machines' > /var/lib/isoloom/ready; exit 1; }\necho 'running: the playbooks' > /var/lib/isoloom/ready; { sh -c 'set -e\nmkdir -p /tmp/isoloom-facts\nexport PATH=\"/opt/ansible/bin:$PATH\" ANSIBLE_HOST_KEY_CHECKING=False ANSIBLE_GATHERING=smart ANSIBLE_FORKS=20 ANSIBLE_PIPELINING=True ANSIBLE_CACHE_PLUGIN=jsonfile ANSIBLE_CACHE_PLUGIN_CONNECTION=/tmp/isoloom-facts ANSIBLE_CACHE_PLUGIN_TIMEOUT=7200\nmkdir -p /tmp/isoloom-retry\nexport ANSIBLE_RETRY_FILES_ENABLED=True ANSIBLE_RETRY_FILES_SAVE_PATH=/tmp/isoloom-retry\n_isoloom_pause=$${ISOLOOM_RETRY_PAUSE:-15}\n_isoloom_attempts=4\n_isoloom_transient='\\''send_input failed|the pipe has been ended|winrmtransporterror|winrmoperationtimeouterror|read timeout|bad http response returned from server|(kerberos|ntlm|credssp).*500|remote end closed connection|connection reset by peer|connection refused|connection aborted|broken pipe|timed out|failed to connect to the host via ssh|shared connection to .* closed'\\''\nretry_download() {\n  _isoloom_n=1\n  until \"$@\"; do\n    [ \"$_isoloom_n\" -lt 5 ] || return 1\n    echo \"isoloom: download failed; trying again in $((_isoloom_n * _isoloom_pause)) s ($((_isoloom_n + 1))/5)\"\n    sleep $((_isoloom_n * _isoloom_pause))\n    _isoloom_n=$((_isoloom_n + 1))\n  done\n}\nplay_hosts() {\n  awk -v transient=\"$_isoloom_transient\" '\\''\n    function commit() {\n      if (pending != \"\") { if (pending_real) real[pending] = 1; else cut[pending] = 1 }\n      pending = \"\"\n    }\n    { gsub(/\\033\\[[0-9;]*m/, \"\") }\n    /^\\.\\.\\.ignoring/ { pending = \"\"; next }\n    { commit() }\n    /^(fatal|failed): \\[/ && !/UNREACHABLE!/ {\n      pending = $0\n      sub(/^(fatal|failed): \\[/, \"\", pending)\n      sub(/\\].*/, \"\", pending)\n      sub(/ -> .*/, \"\", pending)\n      pending_real = (tolower($0) !~ transient)\n      next\n    }\n    /^PLAY RECAP/ { recap = 1; next }\n    recap && / : ok=/ {\n      for (i = 2; i <= NF; i++) {\n        split($i, kv, \"=\")\n        if (kv[1] == \"failed\" && kv[2] > 0) failed[$1] = 1\n        if (kv[1] == \"unreachable\" && kv[2] > 0) unreachable[$1] = 1\n      }\n    }\n    END {\n      commit()\n      for (h in failed) print ((h in real || !(h in cut)) ? \"real \" : \"cut \") h\n      for (h in unreachable) if (!(h in failed)) print \"unreachable \" h\n    }\n  '\\'' \"$1\" | sort\n}\n_isoloom_kind() {\n  echo \"$1\" | awk -v k=\"$2\" '\\''$1 == k { printf \"%s%s\", s, $2; s = \" \" }'\\''\n}\nrun_play() {\n  # The playbook is the last argument; Ansible names its retry file after it.\n  for _isoloom_book; do :; done\n  _isoloom_name=$(basename \"$_isoloom_book\")\n  _isoloom_retry=$${ANSIBLE_RETRY_FILES_SAVE_PATH:-/tmp/isoloom-retry}/$${_isoloom_name%.*}.retry\n  _isoloom_limit=\n  _isoloom_log=$(mktemp)\n  _isoloom_rcf=$(mktemp)\n  _isoloom_n=1\n  rm -f \"$_isoloom_retry\"\n  while :; do\n    { \"$@\" && echo 0 > \"$_isoloom_rcf\" || echo $? > \"$_isoloom_rcf\"; } 2>&1 | tee \"$_isoloom_log\"\n    _isoloom_rc=$(cat \"$_isoloom_rcf\")\n    [ \"$_isoloom_rc\" -ne 0 ] || break\n    _isoloom_hosts=$(play_hosts \"$_isoloom_log\")\n    _isoloom_real=$(_isoloom_kind \"$_isoloom_hosts\" real)\n    _isoloom_gone=$(_isoloom_kind \"$_isoloom_hosts\" unreachable)\n    _isoloom_cut=$(_isoloom_kind \"$_isoloom_hosts\" cut)\n    _isoloom_again=\"$_isoloom_gone$${_isoloom_gone:+$${_isoloom_cut:+ }}$_isoloom_cut\"\n    if [ -n \"$_isoloom_real\" ]; then\n      echo \"isoloom: $_isoloom_name: a task failed on $_isoloom_real: not retried\"\n      break\n    fi\n    if [ -z \"$_isoloom_again\" ]; then\n      echo \"isoloom: $_isoloom_name failed (exit $_isoloom_rc) with no unreachable host or dropped connection: not retried\"\n      break\n    fi\n    if [ \"$_isoloom_n\" -ge \"$_isoloom_attempts\" ]; then\n      echo \"isoloom: $_isoloom_name: still unreachable after $_isoloom_n runs: $_isoloom_again; giving up\"\n      break\n    fi\n    echo \"$_isoloom_again\" | tr '\\'' '\\'' '\\''\\n'\\'' > \"$_isoloom_retry\"\n    if [ -z \"$_isoloom_limit\" ]; then set -- \"$@\" --limit \"@$_isoloom_retry\"; _isoloom_limit=1; fi\n    _isoloom_n=$((_isoloom_n + 1))\n    if [ -n \"$_isoloom_gone\" ]; then\n      _isoloom_wait=$((4 * _isoloom_pause))\n      echo \"isoloom: $_isoloom_name: unreachable: $_isoloom_again; waiting $_isoloom_wait s, then running it again on them ($_isoloom_n/$_isoloom_attempts)\"\n    else\n      _isoloom_wait=$((2 * _isoloom_pause))\n      echo \"isoloom: $_isoloom_name: the play was cut by a dropped connection on $_isoloom_cut; waiting $_isoloom_wait s, then running it again on them ($_isoloom_n/$_isoloom_attempts)\"\n    fi\n    sleep \"$_isoloom_wait\"\n  done\n  rm -f \"$_isoloom_log\" \"$_isoloom_rcf\"\n  [ \"$_isoloom_rc\" -ne 0 ] || rm -f \"$_isoloom_retry\"\n  return \"$_isoloom_rc\"\n}'; } || { echo 'failed: the playbooks' > /var/lib/isoloom/ready; exit 1; }\necho 'running: health check' > /var/lib/isoloom/ready; { sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'; } || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }\nfi\necho ready > /var/lib/isoloom/ready\nrm -f /var/lib/isoloom/part\ncommand -v systemctl >/dev/null && systemctl disable isoloom-setup.service >/dev/null 2>&1\nexit 0\nISOLOOM_SETUP\nmv -f /var/lib/isoloom/setup.sh.new /var/lib/isoloom/setup.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-setup.service <<'ISOLOOM_UNIT'\n[Unit]\nDescription=Isoloom: the machine's set-up\nWants=network-online.target\nAfter=network-online.target cloud-final.service google-startup-scripts.service\n\n[Service]\nType=oneshot\nExecStart=/bin/sh /var/lib/isoloom/setup.sh\nStandardOutput=append:/var/log/isoloom-setup.log\nStandardError=append:/var/log/isoloom-setup.log\nTimeoutStartSec=0\n\n[Install]\nWantedBy=multi-user.target\nISOLOOM_UNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-setup.service >/dev/null 2>&1\nsystemctl start --no-block isoloom-setup.service\nelse\nnohup sh /var/lib/isoloom/setup.sh >> /var/log/isoloom-setup.log 2>&1 &\nfi\n")
  admin_ssh_key {
    username   = "isoloom"
    public_key = var.ssh_public_key
  }
  os_disk {
    caching              = "ReadWrite"
    storage_account_type = "StandardSSD_LRS"
    disk_size_gb         = 30
  }
  source_image_reference {
    publisher = "Debian"
    offer     = "debian-12"
    sku       = "12-gen2"
    version   = "latest"
  }
}

output "machines" {
  value = { iis = azurerm_public_ip.iis.ip_address }
}

output "address_iis" {
  value = azurerm_public_ip.iis.ip_address
}

output "address_isoloom_controller" {
  value = azurerm_public_ip.isoloom_controller.ip_address
}

output "ssh_users" {
  value = { iis = "isoloom" }
}

output "ip" {
  value = azurerm_public_ip.isoloom_controller.ip_address
}

output "ready_file" {
  value = "/var/lib/isoloom/ready"
}

# The checks: each runner on the machine it stands for (ssh <user>@<host> '<command>'), or `isoloom test cloud-vm`.
output "checks" {
  value = [
    {
      position = "networks"
      machine  = "controller"
      host     = azurerm_public_ip.isoloom_controller.ip_address
      user     = "isoloom"
      command  = "cd /opt/isoloom && sh .isoloom/cloud-vm/checks/networks.sh"
    }
  ]
}

output "published" {
  value = { "iis/http" = "${azurerm_public_ip.iis.ip_address}:8087" }
}

# The project's files the machines don't get: version control and the tools' state, and what
# .isoloomignore at the project's root lists (gitignore-style: one pattern per line, `#` comments,
# `!` brings a path back, a trailing `/` matches folders only, a `/` at the start or in the middle
# anchors the pattern at the root; `*`, `?`, `[abc]`, `**`; the last pattern matching a path, or
# a folder it is in, decides). Read as regular expressions, as the Vagrantfiles do.
locals {
  project_ignore_lines = [for l in split("\n", replace(try(file("${local.root}/.isoloomignore"), ""), "\r", "")) : trimspace(l)]
  project_ignore_pats  = [for l in local.project_ignore_lines : { keep = startswith(l, "!"), pat = trimprefix(l, "!") } if l != "" && !startswith(l, "#")]
  project_ignore_globs = [for r in local.project_ignore_pats : merge(r, { glob = trimsuffix(trimsuffix(trimsuffix(r.pat, "/"), "/**"), "/") })]
  project_ignore = [for r in local.project_ignore_globs : {
    keep = r.keep
    re = format(r.glob == r.pat ? "^%s(/|$)" : "^%s/", replace(replace(replace(replace(replace(replace(replace(replace(
      length(split("/", r.glob)) > 1 ? trimprefix(r.glob, "/") : "**/${r.glob}",
    "/[.+^$(){}|\\\\]/", "\\$0"), "[!", "[^"), "**/", "\u0001"), "**", "\u0002"), "*", "[^/]*"), "?", "[^/]"), "\u0001", "(.*/)?"), "\u0002", ".*"))
  } if r.glob != ""]
  # Each file: whether it goes (the last matching pattern decides; none: it goes).
  project_keep    = { for f in fileset(local.root, "**") : f => reverse(concat([true], [for r in local.project_ignore : r.keep if length(regexall(r.re, f)) > 0]))[0] }
  project_ignored = [for f, keep in local.project_keep : f if !keep]
}

# What `tar` leaves out of the project's archive: .isoloomignore's files, from the archive's top
# folder, their wildcard characters escaped.
resource "local_file" "isoloom_project" {
  filename = "${path.module}/.isoloom-project-ignored.txt"
  content  = join("", [for f in local.project_ignored : "${replace("${basename(local.root)}/${f}", "/[\\\\*?\\[]/", "\\$0")}\n"])
}

## .isoloom/cloud-vm/azure/run.json
{
  "$schema": "https://www.isoloom.com/schema/run-manifest/v0.json",
  "manifest_version": 0,
  "generator": {
    "name": "isoloom",
    "version": "0.11.0"
  },
  "lab": {
    "name": "configured-windows",
    "instance": null,
    "message": null
  },
  "target": "cloud-vm",
  "cloud": "azure",
  "driver": "terraform",
  "hosts": [
    "linux",
    "macos",
    "windows"
  ],
  "tools": [
    {
      "name": "terraform",
      "probe": [
        "terraform",
        "version"
      ],
      "min_version": "1.11.0"
    },
    {
      "name": "ssh",
      "probe": [
        "ssh",
        "-V"
      ]
    }
  ],
  "identity": {
    "terraform": {
      "module": ".",
      "state": "runner"
    }
  },
  "params": [
    {
      "name": "subscription_id",
      "description": "Default: ARM_SUBSCRIPTION_ID from the environment.",
      "required": true,
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "subscription_id"
        }
      ]
    },
    {
      "name": "region",
      "description": "The module's `region`.",
      "default": "swedencentral",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "region"
        }
      ]
    },
    {
      "name": "allowed_cidr",
      "description": "Who may reach the machines (SSH and the published ports), e.g. your IP/32.",
      "required": true,
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "allowed_cidr"
        }
      ]
    },
    {
      "name": "ISOLOOM_DERIVED",
      "description": "0: the checks derived from the spec (reachability, no internet) are skipped.",
      "default": "1",
      "values": [
        "0",
        "1"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_DERIVED",
          "steps": [
            "check-networks"
          ]
        }
      ]
    }
  ],
  "secrets": [
    {
      "name": "ARM_CLIENT_ID",
      "kind": "connection",
      "required": false,
      "sensitive": true,
      "source": {
        "store": "env",
        "reference": "ARM_CLIENT_ID"
      },
      "deliver": [
        {
          "via": "env",
          "var": "ARM_CLIENT_ID",
          "steps": [
            "init",
            "apply",
            "destroy"
          ]
        }
      ]
    },
    {
      "name": "ARM_CLIENT_SECRET",
      "kind": "connection",
      "required": false,
      "sensitive": true,
      "source": {
        "store": "env",
        "reference": "ARM_CLIENT_SECRET"
      },
      "deliver": [
        {
          "via": "env",
          "var": "ARM_CLIENT_SECRET",
          "steps": [
            "init",
            "apply",
            "destroy"
          ]
        }
      ]
    },
    {
      "name": "ARM_TENANT_ID",
      "kind": "connection",
      "required": false,
      "sensitive": true,
      "source": {
        "store": "env",
        "reference": "ARM_TENANT_ID"
      },
      "deliver": [
        {
          "via": "env",
          "var": "ARM_TENANT_ID",
          "steps": [
            "init",
            "apply",
            "destroy"
          ]
        }
      ]
    }
  ],
  "networks": [
    {
      "name": "lab",
      "cidr": "10.67.0.0/24",
      "internet": true,
      "native": "lab"
    }
  ],
  "machines": [
    {
      "name": "iis",
      "role": "target",
      "os": "windows-server-2022",
      "windows": true,
      "arch": "amd64",
      "addresses": {
        "lab": "10.67.0.10"
      },
      "ports": [
        {
          "name": "http",
          "port": 80,
          "protocol": "tcp",
          "http": true,
          "publish": {
            "mode": "fixed",
            "preferred": 8087,
            "address": "${outputs.address_iis}"
          }
        }
      ]
    },
    {
      "name": "isoloom-controller",
      "role": "infra",
      "addresses": {
        "lab": "10.67.0.253"
      }
    }
  ],
  "lifecycle": {
    "up": [
      {
        "id": "clear-lock",
        "action": "terraform.clear_lock"
      },
      {
        "id": "init",
        "note": "Preparing Terraform and its providers…",
        "argv": [
          "terraform",
          "init",
          "-input=false",
          "-no-color",
          "-backend-config=path=${run.state_dir}/terraform.tfstate"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 900
      },
      {
        "id": "apply",
        "note": "Creating the lab's machines in the cloud…",
        "argv": [
          "terraform",
          "apply",
          "-auto-approve",
          "-input=false",
          "-no-color"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 3600
      },
      {
        "id": "archive",
        "note": "Archiving the project…",
        "action": "project.archive",
        "with": {
          "root": "../../.."
        }
      },
      {
        "id": "deliver-isoloom-controller",
        "note": "Copying the project into isoloom-controller…",
        "action": "ssh.run",
        "with": {
          "command": "sudo sh -c 'mkdir -p /opt/isoloom /var/lib/isoloom && tar -xzf - -C /opt/isoloom && touch /var/lib/isoloom/project-delivered'",
          "host": "${outputs.address_isoloom_controller}",
          "user": "isoloom",
          "wait_s": "900"
        },
        "stdin": "${run.state_dir}/project.tgz",
        "timeout_s": 1500
      }
    ],
    "down": [
      {
        "id": "clear-lock",
        "action": "terraform.clear_lock"
      },
      {
        "id": "init",
        "note": "Preparing Terraform and its providers…",
        "argv": [
          "terraform",
          "init",
          "-input=false",
          "-no-color",
          "-backend-config=path=${run.state_dir}/terraform.tfstate"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 900
      },
      {
        "id": "destroy",
        "note": "Removing the lab from the cloud…",
        "argv": [
          "terraform",
          "destroy",
          "-auto-approve",
          "-input=false",
          "-no-color"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 3600
      }
    ],
    "status": {
      "id": "state",
      "action": "terraform.read_state"
    }
  },
  "ready": [
    {
      "kind": "step_ok",
      "step": "apply",
      "means": "the machines exist and booted; each sets itself up from its user data once the project is in"
    },
    {
      "kind": "ready_file",
      "host": "${outputs.address_isoloom_controller}",
      "user": "isoloom",
      "path": "${outputs.ready_file}",
      "log": "/var/log/isoloom-setup.log",
      "grammar": "isoloom-ready/1",
      "timeout_s": 7200,
      "unreachable_timeout_s": 600,
      "interval_s": 10
    }
  ],
  "outputs": [
    {
      "name": "ip",
      "description": "Where to stand: the access machine's public address (the first Linux machine's, else the controller's).",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ip"
      }
    },
    {
      "name": "ready_file",
      "description": "Where each Linux machine's set-up says how far it got (isoloom-ready/1).",
      "role": "info",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ready_file"
      }
    },
    {
      "name": "address_iis",
      "description": "iis's public address: the runner's SSH and its published ports reach it there.",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "address_iis"
      }
    },
    {
      "name": "address_isoloom_controller",
      "description": "isoloom-controller's public address: the runner's SSH and its published ports reach it there.",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "address_isoloom_controller"
      }
    },
    {
      "name": "iis_http",
      "description": "iis's http (port 80).",
      "role": "entry",
      "sensitive": false,
      "format": "http://${outputs.address_iis}:${value}/",
      "from": {
        "kind": "published_port",
        "machine": "iis",
        "port": "http"
      }
    }
  ],
  "checks": {
    "protocol": "isoloom-check/1",
    "setup": [],
    "runners": [
      {
        "id": "networks",
        "from": "from isoloom-controller",
        "checks": [
          {
            "name": "checks/iis-answers.sh",
            "kind": "script",
            "wait_s": 0,
            "derived": false
          },
          {
            "name": "iis:80 from the networks",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          }
        ],
        "step": {
          "id": "check-networks",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} sh .isoloom/cloud-vm/checks/networks.sh",
            "host": "${outputs.address_isoloom_controller}",
            "user": "isoloom"
          },
          "timeout_s": 120
        }
      }
    ],
    "teardown": []
  },
  "recovery": {
    "retries": 0,
    "apply_retries": 1
  },
  "expiry": {
    "tf_var": "expires_at",
    "unit": "unix_seconds",
    "default_minutes": 240
  }
}

## .isoloom/cloud-vm/checks/networks.sh
#!/bin/sh
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# The environment's checks, from the environment's networks. `isoloom test` runs it and reads the PASS/FAIL lines.
passed=0; failed=0
pass() { passed=$((passed+1)); echo "isoloom-check: PASS $1"; }
fail() { failed=$((failed+1)); echo "isoloom-check: FAIL $1: $2"; }
# _http URL [follow] -> the status code, 000 when nothing answers (curl, else wget, else bash):
# the first answer's, or with `follow` the last one's after at most 5 redirects (bash: the first).
_http() {
  if command -v curl >/dev/null 2>&1; then
    if [ -n "$2" ]; then set -- "$1" -L --max-redirs 5; else set -- "$1"; fi
    c=$(curl -sk -o /dev/null -m 5 -w '%{http_code}' "$@" 2>/dev/null)
  elif command -v wget >/dev/null 2>&1; then
    # wget follows redirects whatever it's told (busybox's can't be told): -S prints each answer.
    if [ -n "$2" ]; then _n=6; else _n=1; fi
    c=$(wget -q -S -O /dev/null -T 5 --no-check-certificate "$1" 2>&1 | sed -n 's/^ *HTTP\/[0-9.]* \([0-9][0-9][0-9]\).*/\1/p' | head -n $_n | tail -n 1)
  else
    u=${1#*://}; hp=${u%%/*}; p=/${u#*/}; [ "$u" = "$hp" ] && p=/
    h=${hp%%:*}; port=${hp#*:}; [ "$hp" = "$h" ] && port=80
    # shellcheck disable=SC2016 # the inner bash expands $H, $P and $U, for its /dev/tcp
    c=$(H=$h P=$port U=$p timeout 5 bash -c 'exec 3<>/dev/tcp/$H/$P && printf "GET %s HTTP/1.0\r\nHost: %s\r\n\r\n" "$U" "$H" >&3 && read -r l <&3 && echo "$l"' 2>/dev/null | sed -n 's/^HTTP\/[0-9.]* \([0-9][0-9][0-9]\).*/\1/p')
  fi
  echo "${c:-000}"
}
_http_is() { [ "$(_http "$1" "$3")" = "$2" ]; }
# _req STATUS|any TEXT CURL-ARGS... -> 0 when the request gets that status (any answer for `any`)
# and its body contains TEXT (if any); $out says why not. Needs curl.
_req() {
  want=$1; text=$2; shift 2
  command -v curl >/dev/null 2>&1 || { out="curl is needed for this check"; return 1; }
  b=$(mktemp); c=$(curl -sk -m 10 -o "$b" -w '%{http_code}' "$@" 2>/dev/null); c=${c:-000}; r=0
  if [ "$want" = any ]; then [ "$c" != 000 ] || r=1; else [ "$c" = "$want" ] || r=1; fi
  if [ $r = 1 ]; then out="expected HTTP $want, got $c"
  elif [ -n "$text" ] && ! grep -qF -- "$text" "$b"; then r=1; out="HTTP $c, but the response doesn't contain the expected text"
  fi
  rm -f "$b"; return $r
}
_http_any() { [ "$(_http "$1" "$2")" != 000 ]; }
# _tcp HOST PORT -> 0 when it connects (nc, else bash).
_tcp() {
  if command -v nc >/dev/null 2>&1; then nc -z -w 5 "$1" "$2" >/dev/null 2>&1
  else
    # shellcheck disable=SC2016 # the inner bash expands $H and $P, for its /dev/tcp
    H=$1 P=$2 timeout 5 bash -c 'exec 3<>/dev/tcp/$H/$P' >/dev/null 2>&1
  fi
}
# _tcp_read HOST PORT LINE TEXT -> 0 when the bytes read within 5s of connecting (after writing
# LINE and a newline, if any) contain TEXT; $out says why not (nc, else bash). Stdin stays open
# while reading (some nc quit at its end), and nc is stopped after 5s whatever its flavor.
_tcp_read() {
  f=$(mktemp); i=0; r=1
  if command -v nc >/dev/null 2>&1; then
    { [ -z "$3" ] || printf '%s\n' "$3"; j=0; while [ ! -e "$f.end" ] && [ $j -lt 6 ]; do sleep 1; j=$((j+1)); done; } | nc "$1" "$2" >"$f" 2>/dev/null &
  else
    # shellcheck disable=SC2016 # the inner bash expands $H, $P and $L, for its /dev/tcp
    H=$1 P=$2 L=$3 timeout 6 bash -c 'exec 3<>/dev/tcp/$H/$P || exit 1; [ -z "$L" ] || printf "%s\n" "$L" >&3; cat <&3' >"$f" 2>/dev/null &
  fi
  p=$!
  while :; do
    if grep -qF -- "$4" "$f"; then r=0; break; fi
    if [ $i -ge 5 ] || ! kill -0 $p 2>/dev/null; then break; fi
    sleep 1; i=$((i+1))
  done
  [ $r = 0 ] || ! grep -qF -- "$4" "$f" || r=0
  touch "$f.end"; kill $p 2>/dev/null
  if [ $r = 1 ]; then
    if [ -s "$f" ]; then out="$1:$2 answered \"$(head -c 100 "$f" | tr -d '\000\r' | tr '\n\t' '  ')\", without the expected text"
    elif [ $i -lt 5 ]; then out="$1:$2 refused the connection or closed it without a word"
    else out="nothing read from $1:$2 within 5s"; fi
  fi
  rm -f "$f" "$f.end"; return $r
}
# _exec COMMAND TEXT -> 0 when the command succeeds and its output contains TEXT (if any).
_exec() { out=$(sh -c "$1" 2>&1) && { [ -z "$2" ] || printf '%s\n' "$out" | grep -qF -- "$2"; }; }
# _retry SECONDS COMMAND... -> keeps trying every 2s until it passes or the time is up.
_retry() { _end=$(( $(date +%s) + $1 )); shift; while ! "$@"; do [ "$(date +%s)" -lt "$_end" ] || return 1; sleep 2; done; }

echo '== checks/iis-answers.sh'
if _retry 0 sh -c 'cd /opt/isoloom && sh checks/iis-answers.sh'; then pass 'checks/iis-answers.sh'; else fail 'checks/iis-answers.sh' "checks/iis-answers.sh exited non-zero"; fi

if [ "${ISOLOOM_DERIVED:-1}" != 0 ]; then
if _retry 30 _http_any 'http://10.67.0.10:80/'; then pass 'iis:80 from the networks'; else fail 'iis:80 from the networks' "nothing answers at http://10.67.0.10:80/"; fi
fi

echo "isoloom-check: END $passed passed, $failed failed"
[ "$failed" -eq 0 ]

