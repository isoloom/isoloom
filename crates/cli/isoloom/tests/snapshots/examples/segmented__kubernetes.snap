## .isoloom/kubernetes/chart/templates/NOTES.txt
Checks: helm test {{ .Release.Name }} -n {{ .Release.Namespace }}

## .isoloom/kubernetes/chart/templates/environment.yaml
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: cache
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      isoloom.com/machine: cache
  template:
    metadata:
      labels:
        isoloom.com/machine: cache
        net.isoloom.com/back: member
    spec:
      hostname: cache
      initContainers:
      - name: isoloom-probe
        image: busybox:1.37.0-musl
        command:
        - /bin/cp
        - /bin/busybox
        - /probe/busybox
        volumeMounts:
        - name: isoloom-probe
          mountPath: /probe
      - name: seed-data
        image: '{{ index .Values.images "cache" }}'
        imagePullPolicy: IfNotPresent
        command:
        - /.isoloom-probe/busybox
        - sh
        - -c
        - 'd=/isoloom-seed; m="$d/.isoloom-seeding"; b=/.isoloom-probe/busybox; [ -d ''/data'' ] || exit 0; for f in "$d"/* "$d"/.[!.]* "$d"/..?*; do if [ -e "$f" ] || [ -L "$f" ]; then case "$f" in "$d/lost+found" | "$m") ;; *) [ -e "$m" ] || exit 0; $b rm -rf "$f" ;; esac; fi; done; : > "$m" && $b cp -a ''/data/.'' "$d/" && $b rm -f "$m"'
        securityContext:
          runAsUser: 0
          runAsGroup: 0
        volumeMounts:
        - name: vol-data
          mountPath: /isoloom-seed
        - name: isoloom-probe
          mountPath: /.isoloom-probe
          readOnly: true
      containers:
      - name: cache
        image: '{{ index .Values.images "cache" }}'
        imagePullPolicy: IfNotPresent
        ports:
        - containerPort: 6379
        readinessProbe:
          exec:
            command:
            - /.isoloom-probe/busybox
            - sh
            - -c
            - /.isoloom-probe/busybox nc -z -w 2 127.0.0.1 6379
          periodSeconds: 5
          failureThreshold: 60
        resources:
          limits:
            cpu: '1'
            memory: 1024Mi
        volumeMounts:
        - name: vol-data
          mountPath: /data
        - name: isoloom-probe
          mountPath: /.isoloom-probe
          readOnly: true
      nodeSelector:
        kubernetes.io/arch: amd64
      volumes:
      - name: vol-data
        persistentVolumeClaim:
          claimName: cache-data
      - name: isoloom-probe
        emptyDir: {}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: cache-data
spec:
  accessModes:
  - ReadWriteOnce
  resources:
    requests:
      storage: 1Gi
---
apiVersion: v1
kind: Service
metadata:
  name: cache
spec:
  selector:
    isoloom.com/machine: cache
  ports:
  - name: p6379
    port: 6379
    targetPort: 6379
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: offline-cache
spec:
  podSelector:
    matchLabels:
      isoloom.com/machine: cache
  policyTypes:
  - Egress
  egress:
  - to:
    - podSelector: {}
  - to:
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: kube-system
    ports:
    - port: 53
      protocol: UDP
    - port: 53
      protocol: TCP
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: web
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      isoloom.com/machine: web
  template:
    metadata:
      labels:
        isoloom.com/machine: web
        net.isoloom.com/front: member
    spec:
      hostname: web
      initContainers:
      - name: isoloom-probe
        image: busybox:1.37.0-musl
        command:
        - /bin/cp
        - /bin/busybox
        - /probe/busybox
        volumeMounts:
        - name: isoloom-probe
          mountPath: /probe
      - name: wait-cache
        image: alpine:3.20
        command:
        - sh
        - -c
        - until nc -z cache 6379; do sleep 2; done
      containers:
      - name: web
        image: '{{ index .Values.images "web" }}'
        imagePullPolicy: IfNotPresent
        ports:
        - containerPort: 80
        - containerPort: 4444
        readinessProbe:
          exec:
            command:
            - /.isoloom-probe/busybox
            - sh
            - -c
            - /.isoloom-probe/busybox nc -z -w 2 127.0.0.1 80
          periodSeconds: 5
          failureThreshold: 60
        volumeMounts:
        - name: isoloom-probe
          mountPath: /.isoloom-probe
          readOnly: true
      nodeSelector:
        kubernetes.io/arch: amd64
      volumes:
      - name: isoloom-probe
        emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: web
spec:
  selector:
    isoloom.com/machine: web
  ports:
  - name: p80
    port: 80
    targetPort: 80
  - name: p4444
    port: 4444
    targetPort: 4444
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: isoloom-default-deny
spec:
  podSelector: {}
  policyTypes:
  - Ingress
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: net-front
spec:
  podSelector:
    matchLabels:
      net.isoloom.com/front: member
  ingress:
  - from:
    - podSelector:
        matchLabels:
          net.isoloom.com/front: member
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: net-back
spec:
  podSelector:
    matchLabels:
      net.isoloom.com/back: member
  ingress:
  - from:
    - podSelector:
        matchLabels:
          net.isoloom.com/back: member
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: net-access
spec:
  podSelector:
    matchLabels:
      net.isoloom.com/access: member
  ingress:
  - from:
    - podSelector:
        matchLabels:
          net.isoloom.com/access: member
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: reach-0-access-front
spec:
  podSelector:
    matchLabels:
      net.isoloom.com/front: member
  ingress:
  - from:
    - podSelector:
        matchLabels:
          net.isoloom.com/access: member
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: reach-1-front-back
spec:
  podSelector:
    matchLabels:
      net.isoloom.com/back: member
  ingress:
  - from:
    - podSelector:
        matchLabels:
          net.isoloom.com/front: member
    ports:
    - port: 6379
      protocol: TCP
    - port: 6379
      protocol: UDP
---
apiVersion: networking.k8s.io/v1
