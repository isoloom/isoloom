_retry() { _end=$(( $(date +%s) + $1 )); shift; while ! "$@"; do [ "$(date +%s)" -lt "$_end" ] || return 1; sleep 2; done; }

if _retry 60 _http_is 'http://web/' 200; then pass 'the web page answers through the router'; else fail 'the web page answers through the router' "expected HTTP 200 from http://web/, got $(_http 'http://web/')"; fi

if _tcp 'cache' 6379; then fail 'the cache is sealed off from the user' "cache:6379 answered; it should be blocked"; else pass 'the cache is sealed off from the user'; fi

if [ "${ISOLOOM_DERIVED:-1}" != 0 ]; then
if _tcp 'cache' 6379; then fail 'cache:6379 blocked from user' "cache:6379 answered; it should be blocked"; else pass 'cache:6379 blocked from user'; fi
fi

if [ "${ISOLOOM_DERIVED:-1}" != 0 ]; then
if _retry 30 _http_any 'http://web:80/'; then pass 'web:80 from user'; else fail 'web:80 from user' "nothing answers at http://web:80/"; fi
fi

echo "isoloom-check: END $passed passed, $failed failed"
[ "$failed" -eq 0 ]

