  rm -f "$b"; return $r
}
_http_any() { [ "$(_http "$1" "$2")" != 000 ]; }
# _tcp HOST PORT -> 0 when it connects (nc, else bash).
_tcp() {
  if command -v nc >/dev/null 2>&1; then nc -z -w 5 "$1" "$2" >/dev/null 2>&1
  else H=$1 P=$2 timeout 5 bash -c 'exec 3<>/dev/tcp/$H/$P' >/dev/null 2>&1
  fi
}
# _tcp_read HOST PORT LINE TEXT -> 0 when the bytes read within 5s of connecting (after writing
# LINE and a newline, if any) contain TEXT; $out says why not (nc, else bash). Stdin stays open
# while reading (some nc quit at its end), and nc is stopped after 5s whatever its flavor.
_tcp_read() {
  f=$(mktemp); i=0; r=1
  if command -v nc >/dev/null 2>&1; then
    { [ -z "$3" ] || printf '%s\n' "$3"; j=0; while [ ! -e "$f.end" ] && [ $j -lt 6 ]; do sleep 1; j=$((j+1)); done; } | nc "$1" "$2" >"$f" 2>/dev/null &
  else
    H=$1 P=$2 L=$3 timeout 6 bash -c 'exec 3<>/dev/tcp/$H/$P || exit 1; [ -z "$L" ] || printf "%s\n" "$L" >&3; cat <&3' >"$f" 2>/dev/null &
  fi
  p=$!
  while :; do
    if grep -qF -- "$4" "$f"; then r=0; break; fi
    [ $i -lt 5 ] && kill -0 $p 2>/dev/null || break
    sleep 1; i=$((i+1))
  done
  [ $r = 0 ] || ! grep -qF -- "$4" "$f" || r=0
  touch "$f.end"; kill $p 2>/dev/null
  if [ $r = 1 ]; then
    if [ -s "$f" ]; then out="$1:$2 answered \"$(head -c 100 "$f" | tr -d '\000\r' | tr '\n\t' '  ')\", without the expected text"
    elif [ $i -lt 5 ]; then out="$1:$2 refused the connection or closed it without a word"
    else out="nothing read from $1:$2 within 5s"; fi
  fi
  rm -f "$f" "$f.end"; return $r
}
# _exec COMMAND TEXT -> 0 when the command succeeds and its output contains TEXT (if any).
_exec() { out=$(sh -c "$1" 2>&1) && { [ -z "$2" ] || printf '%s\n' "$out" | grep -qF -- "$2"; }; }
# _retry SECONDS COMMAND... -> keeps trying every 2s until it passes or the time is up.
_retry() { _end=$(( $(date +%s) + $1 )); shift; while ! "$@"; do [ "$(date +%s)" -lt "$_end" ] || return 1; sleep 2; done; }

if [ "${ISOLOOM_DERIVED:-1}" != 0 ]; then
if _retry 30 _tcp 'cache' 6379; then pass 'cache:6379 from web'; else fail 'cache:6379 from web' "nothing listens at cache:6379"; fi
fi

echo "isoloom-check: END $passed passed, $failed failed"
[ "$failed" -eq 0 ]

## .isoloom/kubernetes/environment.yaml
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  kubectl kustomize --load-restrictor LoadRestrictionsNone .isoloom/kubernetes | kubectl apply -f -
#         kubectl -n isoloom-segmented wait --for=condition=Available deployment --all --timeout=600s
# Stop:   kubectl delete namespace isoloom-segmented
# Images built from the project, before starting (a local cluster sharing Docker's images:
# OrbStack, Docker Desktop; elsewhere, push them to a registry the cluster pulls from):
#   docker build -t isoloom/segmented-web build/web

apiVersion: v1
kind: Namespace
metadata:
  name: isoloom-segmented
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: cache
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      isoloom.com/machine: cache
  template:
    metadata:
      labels:
        isoloom.com/machine: cache
        net.isoloom.com/back: member
    spec:
      hostname: cache
      initContainers:
      - name: isoloom-probe
        image: busybox:1.37.0-musl
        command:
        - /bin/cp
        - /bin/busybox
        - /probe/busybox
        volumeMounts:
        - name: isoloom-probe
          mountPath: /probe
      - name: seed-data
        image: redis:7-alpine
        imagePullPolicy: IfNotPresent
        command:
        - /.isoloom-probe/busybox
        - sh
        - -c
        - 'd=/isoloom-seed; m="$d/.isoloom-seeding"; b=/.isoloom-probe/busybox; [ -d ''/data'' ] || exit 0; for f in "$d"/* "$d"/.[!.]* "$d"/..?*; do if [ -e "$f" ] || [ -L "$f" ]; then case "$f" in "$d/lost+found" | "$m") ;; *) [ -e "$m" ] || exit 0; $b rm -rf "$f" ;; esac; fi; done; : > "$m" && $b cp -a ''/data/.'' "$d/" && $b rm -f "$m"'
        securityContext:
          runAsUser: 0
          runAsGroup: 0
        volumeMounts:
        - name: vol-data
          mountPath: /isoloom-seed
        - name: isoloom-probe
          mountPath: /.isoloom-probe
          readOnly: true
      containers:
      - name: cache
        image: redis:7-alpine
        imagePullPolicy: IfNotPresent
        ports:
        - containerPort: 6379
        readinessProbe:
          exec:
            command:
            - /.isoloom-probe/busybox
            - sh
            - -c
            - /.isoloom-probe/busybox nc -z -w 2 127.0.0.1 6379
          periodSeconds: 5
          failureThreshold: 60
        resources:
          limits:
            cpu: '1'
            memory: 1024Mi
        volumeMounts:
        - name: vol-data
          mountPath: /data
        - name: isoloom-probe
          mountPath: /.isoloom-probe
          readOnly: true
      nodeSelector:
        kubernetes.io/arch: amd64
      volumes:
      - name: vol-data
        persistentVolumeClaim:
          claimName: cache-data
      - name: isoloom-probe
        emptyDir: {}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: cache-data
spec:
  accessModes:
  - ReadWriteOnce
  resources:
    requests:
      storage: 1Gi
---
apiVersion: v1
kind: Service
metadata:
  name: cache
spec:
  selector:
    isoloom.com/machine: cache
  ports:
  - name: p6379
    port: 6379
    targetPort: 6379
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: offline-cache
spec:
  podSelector:
    matchLabels:
      isoloom.com/machine: cache
  policyTypes:
  - Egress
  egress:
  - to:
    - podSelector: {}
  - to:
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: kube-system
    ports:
    - port: 53
      protocol: UDP
    - port: 53
      protocol: TCP
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: web
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      isoloom.com/machine: web
  template:
    metadata:
      labels:
        isoloom.com/machine: web
        net.isoloom.com/front: member
    spec:
      hostname: web
      initContainers:
      - name: isoloom-probe
        image: busybox:1.37.0-musl
        command:
        - /bin/cp
        - /bin/busybox
        - /probe/busybox
        volumeMounts:
        - name: isoloom-probe
          mountPath: /probe
      - name: wait-cache
        image: alpine:3.20
        command:
        - sh
        - -c
        - until nc -z cache 6379; do sleep 2; done
      containers:
      - name: web
        image: isoloom/segmented-web
        imagePullPolicy: IfNotPresent
        ports:
        - containerPort: 80
        - containerPort: 4444
        readinessProbe:
          exec:
            command:
            - /.isoloom-probe/busybox
            - sh
            - -c
            - /.isoloom-probe/busybox nc -z -w 2 127.0.0.1 80
          periodSeconds: 5
          failureThreshold: 60
        volumeMounts:
        - name: isoloom-probe
          mountPath: /.isoloom-probe
          readOnly: true
      nodeSelector:
        kubernetes.io/arch: amd64
      volumes:
      - name: isoloom-probe
        emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: web
spec:
  selector:
    isoloom.com/machine: web
  ports:
  - name: p80
    port: 80
    targetPort: 80
  - name: p4444
    port: 4444
    targetPort: 4444
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: isoloom-default-deny
spec:
  podSelector: {}
  policyTypes:
  - Ingress
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: net-front
spec:
  podSelector:
    matchLabels:
      net.isoloom.com/front: member
  ingress:
  - from:
    - podSelector:
        matchLabels:
          net.isoloom.com/front: member
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: net-back
spec:
  podSelector:
    matchLabels:
      net.isoloom.com/back: member
  ingress:
  - from:
    - podSelector:
        matchLabels:
          net.isoloom.com/back: member
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: net-access
spec:
  podSelector:
    matchLabels:
      net.isoloom.com/access: member
  ingress:
  - from:
    - podSelector:
        matchLabels:
          net.isoloom.com/access: member
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: reach-0-access-front
spec:
  podSelector:
    matchLabels:
      net.isoloom.com/front: member
  ingress:
  - from:
    - podSelector:
        matchLabels:
          net.isoloom.com/access: member
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: reach-1-front-back
spec:
  podSelector:
    matchLabels:
      net.isoloom.com/back: member
  ingress:
  - from:
    - podSelector:
        matchLabels:
          net.isoloom.com/front: member
    ports:
    - port: 6379
      protocol: TCP
    - port: 6379
      protocol: UDP
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: offline-isoloom-check-cache
spec:
  podSelector:
    matchLabels:
      isoloom.com/check: isoloom-check-cache
  policyTypes:
  - Egress
  egress:
  - to:
    - podSelector: {}
  - to:
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: kube-system
    ports:
    - port: 53
      protocol: UDP
    - port: 53
      protocol: TCP

## .isoloom/kubernetes/kustomization.yaml
