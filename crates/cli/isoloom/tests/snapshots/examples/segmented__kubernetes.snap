  "title": "The segmented environment's values",
  "$comment": "Generated by Isoloom from isoloom.yml: regenerate it rather than editing it.",
  "type": "object",
  "properties": {
    "images": {
      "description": "Each machine's image, by machine.",
      "type": "object",
      "properties": {
        "cache": {
          "type": "string",
          "minLength": 1
        },
        "web": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
