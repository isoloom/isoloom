## .isoloom/docker-vm/Vagrantfile
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  cd .isoloom/docker-vm && vagrant up
# Checks: cd .isoloom/docker-vm && vagrant provision --provision-with checks
# Stop:   cd .isoloom/docker-vm && vagrant destroy -f

ROOT = File.expand_path("../..", __dir__)
# The project goes into a VM through Isoloom's own `project` step (the `isoloom_project`
# provisioner below): a tar.gz of the project as it is when the step runs, not when this file
# loads, so files added or removed since still count. Symbolic links go in as links, never
# followed (a link loop can't break the copy). Plain Ruby (Vagrant's own): no tool on the host.
require "zlib"
require "tempfile"

module IsoloomProject
  # Never copied, at any depth: version control and the tools' own state.
  SKIP = [".git", ".vagrant", ".terraform"].freeze

  # Writes the archive of `root` to `io`, gzipped. `generated`: whether Isoloom's outputs (the
  # top-level `.isoloom*` folders) go in; `extra`: files in them that go in anyway (paths from
  # `root`, with `/`). What `.isoloomignore` lists stays out.
  def self.write(root, io, generated: false, extra: [])
    gz = Zlib::GzipWriter.new(io)
    rules = ignore_rules(root)
    walk(root, nil, generated, extra, rules) { |rel, st| entry(gz, root, rel, st) }
    gz.write("\0" * 1024)
    gz.finish
  end

  # `.isoloomignore` at the project's root, gitignore-style: one pattern per line, `#` comments,
  # `!` brings a path back, a trailing `/` matches folders only, a `/` at the start or in the
  # middle anchors the pattern at the root (otherwise it matches at any depth), `*`, `?`,
  # `[abc]` and `**`. A pattern matching a folder matches everything in it, and the last pattern
  # matching a path (or a folder it is in) decides. As [regexp, keep] pairs; the Terraform
  # outputs translate the patterns the same way, so every target leaves out the same files.
  def self.ignore_rules(root)
    text = File.binread(File.join(root, ".isoloomignore")).force_encoding("UTF-8")
    text.split("\n").filter_map do |line|
      line = line.strip
      next if line.empty? || line.start_with?("#")
      keep = line.start_with?("!")
      pat = keep ? line[1..] : line
      glob = pat.delete_suffix("/").delete_suffix("/**").delete_suffix("/")
      next if glob.empty?
      anchored = glob.include?("/") ? glob.delete_prefix("/") : "**/#{glob}"
      re = anchored.gsub(/[.+^$(){}|\\]/) { "\\#{$&}" }.gsub("[!", "[^")
                   .gsub("**/", "\u0001").gsub("**", "\u0002").gsub("*", "[^/]*").gsub("?", "[^/]")
                   .gsub("\u0001", "(.*/)?").gsub("\u0002", ".*")
      [Regexp.new(glob == pat ? "^#{re}(/|$)" : "^#{re}/"), keep]
    end
  rescue Errno::ENOENT
    []
  end

  # Whether the rules leave a path out (a folder's path ends with `/`).
  def self.ignored?(rules, path)
    rules.reduce(false) { |out, (re, keep)| re.match?(path) ? !keep : out }
  end

  # Every entry under `dir` (relative to `root`), parents first, in name order.
  def self.walk(root, dir, generated, extra, rules, &block)
    names = begin
      Dir.children(dir ? File.join(root, dir) : root).sort
    rescue Errno::ENOENT, Errno::ENOTDIR
      return # removed while the archive was being written
    end
    names.each do |name|
      next if SKIP.include?(name)
      rel = dir ? "#{dir}/#{name}" : name
      if !generated && rel.start_with?(".isoloom")
        next unless extra.any? { |e| e == rel || e.start_with?("#{rel}/") }
      end
      st = begin
        File.lstat(File.join(root, rel))
      rescue Errno::ENOENT
        next
      end
      folder = st.directory?
      out = ignored?(rules, folder ? "#{rel}/" : rel)
      yield rel, st unless out
      # An ignored folder is skipped, unless a `!` pattern may bring back something in it.
      walk(root, rel, generated, extra, rules, &block) if folder && (!out || rules.any? { |_, keep| keep })
    end
  end

  def self.entry(out, root, rel, st)
    path = File.join(root, rel)
    if st.symlink?
      header(out, rel, "2", 0o777, 0, st.mtime, File.readlink(path))
    elsif st.directory?
      header(out, "#{rel}/", "5", st.mode & 0o7777, 0, st.mtime)
    elsif st.file?
      File.open(path, "rb") do |f|
        mode = st.mode & 0o7777
        # Windows has no executable bit: a script (#!) is made executable.
        mode |= 0o111 if Gem.win_platform? && f.read(2) == "#!"
        f.rewind
        header(out, rel, "0", mode, st.size, st.mtime)
        copied = IO.copy_stream(f, out, st.size)
        out.write("\0" * (st.size - copied)) if copied < st.size # shrank while being read
        out.write("\0" * ((512 - st.size % 512) % 512))
      end
    end
  rescue Errno::ENOENT
    nil # removed while the archive was being written
  end

  # A ustar header; a pax one before it for what ustar can't hold (long names, large sizes).
  def self.header(out, name, type, mode, size, mtime, link = "")
    name = name.b
    link = link.b
    pax = {}
    pax["path"] = name if name.bytesize > 100
    pax["linkpath"] = link if link.bytesize > 100
    pax["size"] = size.to_s if size >= 8**11
    unless pax.empty?
      body = pax.map { |k, v| record(k, v) }.join
      header(out, "PaxHeader/#{name.byteslice(0, 80)}", "x", 0o644, body.bytesize, mtime)
      out.write(body)
      out.write("\0" * ((512 - body.bytesize % 512) % 512))
    end
    h = [
      name.byteslice(0, 100), format("%07o", mode), format("%07o", 0), format("%07o", 0),
      format("%011o", size >= 8**11 ? 0 : size), format("%011o", [mtime.to_i, 0].max), " " * 8, type,
      link.byteslice(0, 100), "ustar", "00", "", "", "", "", "", "",
    ].pack("a100a8a8a8a12a12a8a1a100a6a2a32a32a8a8a155a12")
    h[148, 8] = format("%06o\0 ", h.sum(0))
    out.write(h)
  end

  # One pax record: "<length> key=value\n", the length counting itself.
  def self.record(key, value)
    rest = " #{key}=".b + value + "\n"
    len = rest.bytesize + 1
    len += 1 while (len.to_s.bytesize + rest.bytesize) > len
    len.to_s.b + rest
  end
end

if defined?(Vagrant) && Vagrant.respond_to?(:plugin)
  module IsoloomProject
    class Config < Vagrant.plugin("2", :config)
      attr_accessor :name, :generated, :extra

      def initialize
        super
        @name = UNSET_VALUE
        @generated = UNSET_VALUE
        @extra = UNSET_VALUE
      end

      def finalize!
        @name = nil if @name == UNSET_VALUE
        @generated = false if @generated == UNSET_VALUE
        @extra = [] if @extra == UNSET_VALUE
      end
    end

    # Builds the archive, uploads it, unpacks it in /opt/isoloom (C:\isoloom on Windows, over
    # WinRM or OpenSSH, with UNTAR_PS1), replacing an older copy.
    class Provisioner < Vagrant.plugin("2", :provisioner)
      def provision
        windows = %w[winrm winssh].include?(@machine.config.vm.communicator.to_s)
        Tempfile.create(["isoloom-project", ".tgz"]) do |f|
          f.binmode
          IsoloomProject.write(ROOT, f, generated: config.generated, extra: config.extra)
          f.close
          dest = windows ? "C:\\isoloom" : "/opt/isoloom"
          @machine.ui.info("The project, #{(File.size(f.path) / 1024.0).ceil} KB compressed, to #{dest}")
          comm = @machine.communicate
          if windows
            archive = "C:\\Windows\\Temp\\isoloom-project.tgz"
            comm.upload(f.path, archive)
            script = "$archive = '#{archive}'; $dest = '#{dest}'; $strip = 0\n#{UNTAR_PS1}"
            comm.execute(script, elevated: true) do |type, data|
              @machine.ui.info(data.chomp) if type == :stdout && !data.strip.empty?
            end
          else
            comm.upload(f.path, "/tmp/isoloom-project.tgz")
            comm.execute("rm -rf /tmp/isoloom-project && mkdir /tmp/isoloom-project && tar -xzf /tmp/isoloom-project.tgz -C /tmp/isoloom-project && rm -f /tmp/isoloom-project.tgz")
            comm.sudo("rm -rf /opt/isoloom && mv /tmp/isoloom-project /opt/isoloom")
          end
        end
      end
    end

    class Plugin < Vagrant.plugin("2")
      name "isoloom project"
      config(:isoloom_project, :provisioner) { Config }
      provisioner(:isoloom_project) { Provisioner }
    end
  end
end

# Unpacks the project on Windows (no tar.exe before Windows Server 2019).
IsoloomProject::UNTAR_PS1 = <<'PS1'
# The project into a Windows machine: unpacks the tar.gz $archive into $dest (replacing an older
# copy), leaving out the archive's first $strip folders. Plain .NET (GZipStream), so it runs on
# every Windows Isoloom supports: PowerShell 2.0 and later, and no tar.exe before Windows Server
# 2019. Symbolic links are left out (counted).
& {
  $ErrorActionPreference = 'Stop'
  $sep = [IO.Path]::DirectorySeparatorChar
  $new = "$dest.new"
  if (Test-Path $new) { Remove-Item $new -Recurse -Force }
  [void][IO.Directory]::CreateDirectory($new)
  $file = New-Object IO.FileStream($archive, [IO.FileMode]::Open, [IO.FileAccess]::Read)
  $in = New-Object IO.Compression.GZipStream($file, [IO.Compression.CompressionMode]::Decompress)
  $utf8 = New-Object Text.UTF8Encoding($false)
  $header = New-Object byte[] 512
  $chunk = New-Object byte[] 65536
  function Fill([byte[]]$b, [int]$n) {
    $got = 0
    while ($got -lt $n) {
      $r = $in.Read($b, $got, $n - $got)
      if ($r -le 0) { throw "$archive ends early" }
      $got += $r
    }
  }
  function Field([int]$at, [int]$len) {
    $end = [Array]::IndexOf($header, [byte]0, $at, $len)
    if ($end -lt 0) { $end = $at + $len }
    $utf8.GetString($header, $at, $end - $at)
  }
  # Copies $size bytes to $out (or skips them, with no $out), then the padding after them.
  function Body([long]$size, $out) {
    $left = $size
    while ($left -gt 0) {
      $n = [int][Math]::Min([long]$chunk.Length, $left)
      Fill $chunk $n
      if ($out) { $out.Write($chunk, 0, $n) }
      $left -= $n
    }
    $pad = [int]((512 - $size % 512) % 512)
    if ($pad) { Fill $chunk $pad }
  }
  $pax = @{}
  $links = 0
  $files = 0
  while ($true) {
    Fill $header 512
    if ($header[148] -eq 0) { break } # the end: zero blocks have no checksum
    $type = [char]$header[156]
    $sizeText = (Field 124 12).Trim()
    $size = [long]0
    if ($sizeText) { $size = [Convert]::ToInt64($sizeText, 8) }
    if ($pax['size']) { $size = [long]$pax['size'] }
    if ($type -eq 'x') {
      # pax records ("<length> key=value\n"): a long path, a large size, for the next entry.
      $ms = New-Object IO.MemoryStream
      Body $size $ms
      $b = $ms.ToArray()
      $i = 0
      while ($i -lt $b.Length) {
        $sp = [Array]::IndexOf($b, [byte]32, $i)
        $len = [int]$utf8.GetString($b, $i, $sp - $i)
        $eq = [Array]::IndexOf($b, [byte]61, $sp)
        $pax[$utf8.GetString($b, $sp + 1, $eq - $sp - 1)] = $utf8.GetString($b, $eq + 1, $i + $len - $eq - 2)
        $i += $len
      }
      continue
    }
    if ($type -eq 'L' -or $type -eq 'K') {
      # GNU tar's long name (or link target) for the next entry.
      $ms = New-Object IO.MemoryStream
      Body $size $ms
      if ($type -eq 'L') { $pax['path'] = $utf8.GetString($ms.ToArray()).TrimEnd([char]0) }
      continue
    }
    $name = Field 0 100
    $prefix = Field 345 155
    if ($prefix) { $name = "$prefix/$name" }
    if ($pax['path']) { $name = $pax['path'] }
    $pax = @{}
    $parts = @($name.Split('/') | Where-Object { $_ -ne '' -and $_ -ne '.' })
    if ($parts.Count -le $strip) { Body $size $null; continue }
    $path = Join-Path $new ([string]::Join([string]$sep, [string[]]($parts[$strip..($parts.Count - 1)])))
    if ($type -eq '5' -or $type -eq '0' -or $type -eq [char]0) {
      # A name Windows can't take (`:`, `*`, too long...) is left out, with a warning.
      $out = $null
      try {
        if ($type -eq '5') {
          [void][IO.Directory]::CreateDirectory($path)
        } else {
          [void][IO.Directory]::CreateDirectory([IO.Path]::GetDirectoryName($path))
          $out = [IO.File]::Create($path)
        }
      } catch {
        Write-Warning "Not copied: $name ($($_.Exception.Message))"
        Body $size $null
        continue
      }
      if ($out) {
        try { Body $size $out } finally { $out.Close() }
        $files++
      } else {
        Body $size $null
      }
    } else {
      if ($type -eq '2') { $links++ }
      Body $size $null
    }
  }
  $in.Close()
  if (Test-Path $dest) { Remove-Item $dest -Recurse -Force }
  Move-Item $new $dest
  Remove-Item $archive -Force
  $note = ''
  if ($links) { $note = " ($links symbolic links left out)" }
  "$files files in $dest$note"
}
PS1

Vagrant.configure("2") do |config|
  config.vm.box = "bento/debian-12"
  config.vm.hostname = "segmented"
  config.vm.synced_folder ".", "/vagrant", disabled: true
  config.vm.boot_timeout = 600
  config.ssh.proxy_command = ENV["ISOLOOM_SSH_PROXY_COMMAND"] if ENV["ISOLOOM_SSH_PROXY_COMMAND"]
  config.vm.provider "libvirt" do |v|
    v.default_prefix = "segmented_"
  end
  config.vm.provider "virtualbox" do |v|
    v.customize ["modifyvm", :id, "--graphicscontroller", "vboxvga"]
    v.name = "segmented · docker"
    v.cpus = 3
    v.memory = 3072
  end
  config.vm.provider "vmware_desktop" do |v|
    v.vmx["displayName"] = "segmented · docker"
    v.vmx["numvcpus"] = "3"
    v.vmx["memsize"] = "3072"
  end
  config.vm.provider "parallels" do |v|
    v.name = "segmented · docker"
    v.cpus = 3
    v.memory = 3072
  end
  config.vm.provider "utm" do |v|
    v.name = "segmented · docker"
    v.cpus = 3
    v.memory = 3072
  end
  config.vm.provider "qemu" do |v|
    v.smp = "cpus=3"
    v.memory = "3072M"
  end
  config.vm.provider "libvirt" do |v, o|
    o.vm.box = "generic/debian12"
    v.cpus = 3
    v.memory = 3072
  end
  config.vm.provider "vmware_esxi" do |v|
    v.esxi_hostname = ENV.fetch("ESXI_HOSTNAME", "")
    v.esxi_hostport = ENV.fetch("ESXI_HOSTPORT", "22").to_i
    v.esxi_username = ENV.fetch("ESXI_USERNAME", "root")
    v.esxi_password = "env:ESXI_PASSWORD"
    v.esxi_disk_store = ENV["ESXI_DATASTORE"] if ENV["ESXI_DATASTORE"]
    v.esxi_virtual_network = [ENV.fetch("ESXI_VIRTUAL_NETWORK", "VM Network").split(",").first.strip]
    v.guest_name = "segmented-docker"
    v.guest_numvcpus = 3
    v.guest_memsize = 3072
  end
  config.vm.provision "docker", type: "shell", inline: "command -v docker >/dev/null || if command -v apt-get >/dev/null; then (
  set -e
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -qq
  apt-get install -y -qq ca-certificates curl
  install -m 0755 -d /etc/apt/keyrings
  k=$(mktemp)
  # shellcheck disable=SC1091,SC2154 # /etc/os-release is on the guest, not here.
  _id=$(. /etc/os-release && printf %s \"$ID\")
  # shellcheck disable=SC1091,SC2154
  _cn=$(. /etc/os-release && printf %s \"$VERSION_CODENAME\")
  curl -fsSL \"https://download.docker.com/linux/$_id/gpg\" -o \"$k\"
  echo \"1500c1f56fa9e26b9b8f42452a553675796ade0807cdce11975eb98170b3a570  $k\" | sha256sum -c -
  install -m 0644 \"$k\" /etc/apt/keyrings/docker.asc
  rm -f \"$k\"
  echo \"deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/$_id $_cn stable\" > /etc/apt/sources.list.d/docker.list
  apt-get update -qq
  v=$(apt-cache madison docker-ce | awk '$3 ~ /(^|:)29[.]9[.]0/ { print $3; exit }')
  [ -n \"$v\" ] || { echo \"docker-ce 29.9.0 is not in Docker's apt repository\" >&2; exit 1; }
  apt-get install -y -qq --allow-downgrades \"docker-ce=$v\" \"docker-ce-cli=$v\" containerd.io docker-buildx-plugin \"docker-compose-plugin=5.6.0-*\"
)
else
  curl -fsSL https://get.docker.com | VERSION=29.9.0 sh
fi
cat > /etc/systemd/system/isoloom-published.service <<'UNIT'
[Unit]
Description=Isoloom: published ports reach containers of networks without a default route
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'iptables -t nat -C POSTROUTING -m conntrack --ctstate DNAT -o br-+ -j MASQUERADE 2>/dev/null || iptables -t nat -I POSTROUTING -m conntrack --ctstate DNAT -o br-+ -j MASQUERADE'

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now isoloom-published.service
"
  config.vm.provision "project", type: "isoloom_project", generated: true
  config.vm.provision "shell", name: "environment", inline: "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name segmented --file .isoloom/docker/compose.yml up --detach --build --pull missing --wait --wait-timeout 600 && mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready"
  config.vm.provision "shell", name: "checks", run: "never", inline: "cd /opt/isoloom && failed=0; set --; for w in $(docker compose -f .isoloom/docker/compose.yml --profile check config --services | grep -x -e isoloom-access -e isoloom-access-routes); do set -- \"$@\" \"$w\"; done; [ $# -eq 0 ] || docker compose -f .isoloom/docker/compose.yml --profile check up -d --wait --no-deps \"$@\"; for s in $(docker compose -f .isoloom/docker/compose.yml --profile check config --services | grep '^isoloom-check'); do docker compose -f .isoloom/docker/compose.yml --profile check run --rm --no-deps -e ISOLOOM_DERIVED \"$s\" || failed=1; done; exit \"$failed\"", env: { "ISOLOOM_DERIVED" => ENV.fetch("ISOLOOM_DERIVED", "1") }
end

## .isoloom/docker-vm/proxmox/main.tf
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  terraform -chdir=.isoloom/docker-vm/proxmox init && terraform -chdir=.isoloom/docker-vm/proxmox apply -var proxmox_endpoint=https://<server>:8006/ -var proxmox_api_token=<user@realm!name=secret> -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)"
# Stop:   terraform -chdir=.isoloom/docker-vm/proxmox destroy (same variables)
# Then:   setup.sh piped into `sudo sh -s` over SSH, the project in /opt/isoloom, and Compose (run.json)

terraform {
  required_version = ">= 1.6"
  backend "local" {}
  required_providers {
    proxmox = { source = "bpg/proxmox", version = "~> 0.115.0" }
  }
}

variable "proxmox_endpoint" {
  type        = string
  description = "https://<server>:8006/"
}

variable "proxmox_api_token" {
  type        = string
  default     = ""
  sensitive   = true
  description = "user@realm!name=secret; or use proxmox_username and proxmox_password"
}

variable "proxmox_username" {
  type    = string
  default = "root@pam"
}

variable "proxmox_password" {
  type      = string
  default   = ""
  sensitive = true
}

variable "proxmox_insecure" {
  type        = bool
  default     = true
  description = "Accept the server's self-signed certificate"
}

variable "proxmox_ssh_username" {
  type        = string
  default     = "root"
  description = "Uploading the cloud-init snippet goes over SSH to the node"
}

variable "proxmox_ssh_private_key_file" {
  type    = string
  default = ""
}

variable "proxmox_ssh_address" {
  type        = string
  default     = ""
  description = "The node's SSH address, when the API reports one this machine can't reach"
}

variable "node" {
  type        = string
  description = "The Proxmox node the VMs go on (`pvesh get /nodes` lists them)"
  validation {
    condition     = var.node != ""
    error_message = "Set `node` to the Proxmox node the lab's VMs go on (`pvesh get /nodes` lists them)."
  }
}

variable "datastore" {
  type        = string
  default     = "local-lvm"
  description = "Where the VM's disk goes"
}

variable "image_datastore" {
  type        = string
  default     = "local"
  description = "A datastore with 'iso' content, for the cloud image"
}

variable "snippets_datastore" {
  type        = string
  default     = "local"
  description = "A datastore with 'snippets' content, for cloud-init"
}

variable "uplink_bridge" {
  type        = string
  default     = "vmbr0"
  description = "The bridge the VM gets its address (DHCP) and the internet from"
}

variable "slot" {
  type        = number
  default     = 1
  description = "1 to 99, unique per environment on this server"
}

variable "ssh_public_key" {
  type        = string
  default     = ""
  description = "Installed for the user `isoloom`"
}

provider "proxmox" {
  endpoint  = var.proxmox_endpoint
  api_token = var.proxmox_api_token != "" ? var.proxmox_api_token : null
  username  = var.proxmox_api_token != "" ? null : var.proxmox_username
  password  = var.proxmox_api_token != "" ? null : var.proxmox_password
  insecure  = var.proxmox_insecure
  ssh {
    agent       = false
    username    = var.proxmox_ssh_username
    password    = var.proxmox_ssh_private_key_file != "" ? null : var.proxmox_password
    private_key = var.proxmox_ssh_private_key_file != "" ? file(var.proxmox_ssh_private_key_file) : null
    dynamic "node" {
      for_each = var.proxmox_ssh_address == "" ? [] : [1]
      content {
        name    = var.node
        address = var.proxmox_ssh_address
      }
    }
  }
}

# The VM's address on the uplink, from the guest agent (not the loopback).
locals {
  ip = try([for a in flatten(proxmox_virtual_environment_vm.env.ipv4_addresses) : a if a != "127.0.0.1"][0], "")
}

resource "proxmox_download_file" "debian" {
  node_name           = var.node
  datastore_id        = var.image_datastore
  content_type        = "iso"
  url                 = "https://cloud.debian.org/images/cloud/bookworm/20261015-2632/debian-12-genericcloud-amd64-20261015-2632.qcow2"
  file_name           = "iso${var.slot}-docker-debian-12.img"
  overwrite_unmanaged = true
  checksum            = "56c0bd55b6623f2739f377e983d2872e7b208d0cb9c3ba4e93d3f72929026da03637c598b3bd472b29998c31c8a4c17d8e6ae1c556852a8b83a66a09bf5c2b37"
  checksum_algorithm  = "sha512"
}

resource "proxmox_virtual_environment_file" "env" {
  node_name    = var.node
  datastore_id = var.snippets_datastore
  content_type = "snippets"
  source_raw {
    file_name = "iso${var.slot}-docker.yaml"
    data = format("#cloud-config\n%s", yamlencode({
      hostname = "segmented"
      users = [
        {
          name                = "isoloom"
          sudo                = "ALL=(ALL) NOPASSWD:ALL"
          shell               = "/bin/bash"
          ssh_authorized_keys = [var.ssh_public_key]
        }
      ]
      packages = ["qemu-guest-agent", "curl"]
      runcmd   = ["systemctl enable --now qemu-guest-agent"]
    }))
  }
}

resource "proxmox_virtual_environment_vm" "env" {
  name      = "iso${var.slot}-segmented"
  node_name = var.node
  tags      = ["isoloom", "segmented"]
  on_boot   = false
  agent {
    enabled = true
    timeout = "8m"
    wait_for_ip {
      ipv4 = true
    }
  }
  stop_on_destroy = true
  cpu {
    cores = 3
    type  = "host"
  }
  memory {
    dedicated = 3072
  }
  disk {
    datastore_id = var.datastore
    file_id      = proxmox_download_file.debian.id
    interface    = "virtio0"
    size         = 30
  }
  network_device {
    bridge = var.uplink_bridge
  }
  initialization {
    datastore_id      = var.datastore
    user_data_file_id = proxmox_virtual_environment_file.env.id
    ip_config {
      ipv4 {
        address = "dhcp"
      }
    }
  }
  operating_system {
    type = "l26"
  }
  serial_device {}
  lifecycle {
    postcondition {
      condition     = length([for a in flatten(self.ipv4_addresses) : a if a != "127.0.0.1"]) > 0
      error_message = "The Docker host got no IPv4 address on its uplink bridge `${var.uplink_bridge}` within 8m: the bridge has no DHCP, or no DNS or internet to install qemu-guest-agent, which reports the address. Give it an uplink bridge with DHCP and internet (`uplink_bridge`)."
    }
  }
}

output "ip" {
  value = local.ip
}

output "ssh_user" {
  value = "isoloom"
}

## .isoloom/docker-vm/proxmox/run.json
{
  "$schema": "https://www.isoloom.com/schema/run-manifest/v0.json",
  "manifest_version": 0,
  "generator": {
    "name": "isoloom",
    "version": "1.0.1"
  },
  "environment": {
    "name": "segmented",
    "instance": null,
    "message": null
  },
  "target": "docker-vm",
  "driver": "terraform",
  "hosts": [
    "linux",
    "macos",
    "windows"
  ],
  "tools": [
    {
      "name": "terraform",
      "probe": [
        "terraform",
        "version"
      ],
      "min_version": "1.6.0",
      "container": "hashicorp/terraform:1.9.8@sha256:18f9986038bbaf02cf49db9c09261c778161c51dcc7fb7e355ae8938459428cd",
      "container_hosts": [
        "macos"
      ]
    },
    {
      "name": "ssh",
      "probe": [
        "ssh",
        "-V"
      ]
    }
  ],
  "identity": {
    "terraform": {
      "module": ".",
      "state": "runner"
    }
  },
  "params": [
    {
      "name": "proxmox_endpoint",
      "description": "https://<server>:8006/.",
      "required": true,
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_endpoint"
        }
      ]
    },
    {
      "name": "proxmox_username",
      "description": "The module's `proxmox_username`.",
      "default": "root@pam",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_username"
        }
      ]
    },
    {
      "name": "proxmox_insecure",
      "description": "Accept the server's self-signed certificate.",
      "default": "true",
      "values": [
        "true",
        "false"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_insecure"
        }
      ]
    },
    {
      "name": "proxmox_ssh_username",
      "description": "Uploading the cloud-init snippet goes over SSH to the node.",
      "default": "root",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_ssh_username"
        }
      ]
    },
    {
      "name": "proxmox_ssh_address",
      "description": "The node's SSH address, when the API reports one this machine can't reach.",
      "default": "",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_ssh_address"
        }
      ]
    },
    {
      "name": "node",
      "description": "The Proxmox node the VMs go on (`pvesh get /nodes` lists them).",
      "required": true,
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "node"
        }
      ]
    },
    {
      "name": "datastore",
      "description": "Where the VM's disk goes.",
      "default": "local-lvm",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "datastore"
        }
      ]
    },
    {
      "name": "image_datastore",
      "description": "A datastore with 'iso' content, for the cloud image.",
      "default": "local",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "image_datastore"
        }
      ]
    },
    {
      "name": "snippets_datastore",
      "description": "A datastore with 'snippets' content, for cloud-init.",
      "default": "local",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "snippets_datastore"
        }
      ]
    },
    {
      "name": "uplink_bridge",
      "description": "The bridge the VM gets its address (DHCP) and the internet from.",
      "default": "vmbr0",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "uplink_bridge"
        }
      ]
    },
    {
      "name": "ISOLOOM_DERIVED",
      "description": "0: the checks derived from the spec (reachability, no internet) are skipped.",
      "default": "1",
      "values": [
        "0",
        "1"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_DERIVED",
          "steps": [
            "check-user",
            "check-cache",
            "check-web"
          ]
        }
      ]
    }
  ],
  "secrets": [
    {
      "name": "proxmox_api_token",
      "kind": "connection",
      "required": false,
      "sensitive": true,
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_api_token"
        }
      ]
    },
    {
      "name": "proxmox_password",
      "kind": "connection",
      "required": false,
      "sensitive": true,
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_password"
        }
      ]
    }
  ],
  "networks": [
    {
      "name": "front",
      "cidr": "10.61.10.0/24",
      "internet": true,
      "native": "segmented_front"
    },
    {
      "name": "back",
      "cidr": "10.61.20.0/24",
      "internet": false,
      "native": "segmented_back"
    },
    {
      "name": "access",
      "cidr": "10.61.99.0/24",
      "internet": true,
      "native": "segmented_access"
    }
  ],
  "machines": [
    {
      "name": "docker",
      "role": "infra",
      "resources": {
        "cpus": 3,
        "memory_mb": 3072
      },
      "addresses": {}
    },
    {
      "name": "isoloom-router",
      "role": "infra",
      "addresses": {
        "access": "10.61.99.254",
        "back": "10.61.20.254",
        "front": "10.61.10.254"
      },
      "native": {
        "service": "isoloom-router"
      }
    },
    {
      "name": "cache",
      "role": "target",
      "arch": "amd64",
      "resources": {
        "cpus": 1,
        "memory_mb": 1024
      },
      "addresses": {
        "back": "10.61.20.20"
      },
      "native": {
        "service": "cache"
      },
      "volumes": [
        {
          "name": "data",
          "path": "/data",
          "native": "segmented_cache-data"
        }
      ],
      "ports": [
        {
          "name": "redis",
          "port": 6379,
          "protocol": "tcp",
          "http": false
        }
      ]
    },
    {
      "name": "cache-routes",
      "role": "infra",
      "of": "cache",
      "addresses": {},
      "native": {
        "service": "cache-routes"
      }
    },
    {
      "name": "web",
      "role": "target",
      "arch": "amd64",
      "addresses": {
        "front": "10.61.10.10"
      },
      "native": {
        "service": "web"
      },
      "ports": [
        {
          "name": "web",
          "port": 80,
          "protocol": "tcp",
          "http": true
        },
        {
          "name": "shell",
          "port": 4444,
          "protocol": "tcp",
          "http": false
        }
      ]
    },
    {
      "name": "web-routes",
      "role": "infra",
      "of": "web",
      "addresses": {},
      "native": {
        "service": "web-routes"
      }
    },
    {
      "name": "user",
      "role": "access",
      "arch": "amd64",
      "addresses": {
        "access": "10.61.99.10"
      },
      "on_demand": true,
      "native": {
        "service": "user"
      }
    },
    {
      "name": "user-routes",
      "role": "infra",
      "of": "user",
      "addresses": {},
      "native": {
        "service": "user-routes"
      }
    },
    {
      "name": "isoloom-access",
      "role": "access",
      "addresses": {
        "access": "10.61.99.10"
      },
      "native": {
        "service": "isoloom-access"
      }
    },
    {
      "name": "isoloom-access-routes",
      "role": "infra",
      "of": "isoloom-access",
      "addresses": {},
      "native": {
        "service": "isoloom-access-routes"
      }
    },
    {
      "name": "isoloom-check",
      "role": "check",
      "of": "user",
      "addresses": {},
      "native": {
        "service": "isoloom-check"
      }
    },
    {
      "name": "isoloom-check-cache",
      "role": "check",
      "of": "cache",
      "addresses": {},
      "native": {
        "service": "isoloom-check-cache"
      }
    },
    {
      "name": "isoloom-check-web",
      "role": "check",
      "of": "web",
      "addresses": {},
      "native": {
        "service": "isoloom-check-web"
      }
    },
    {
      "name": "isoloom-probe-amd64",
      "role": "infra",
      "addresses": {},
      "native": {
        "service": "isoloom-probe-amd64"
      }
    }
  ],
  "lifecycle": {
    "up": [
      {
        "id": "clear-lock",
        "action": "terraform.clear_lock"
      },
      {
        "id": "init",
        "note": "Preparing Terraform and its providers…",
        "argv": [
          "terraform",
          "init",
          "-input=false",
          "-no-color",
          "-backend-config=path=${run.state_dir}/terraform.tfstate"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_proxmox_ssh_private_key_file": "${run.ssh_key}",
          "TF_VAR_slot": "${run.slot}",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 600
      },
      {
        "id": "apply",
        "note": "Creating the lab's VMs on the server…",
        "argv": [
          "terraform",
          "apply",
          "-auto-approve",
          "-input=false",
          "-no-color"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_proxmox_ssh_private_key_file": "${run.ssh_key}",
          "TF_VAR_slot": "${run.slot}",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 3600
      },
      {
        "id": "docker",
        "note": "Installing Docker in the VM…",
        "action": "ssh.run",
        "with": {
          "command": "sudo sh -s",
          "host": "${outputs.ip}",
          "user": "isoloom"
        },
        "stdin": "setup.sh",
        "timeout_s": 1800
      },
      {
        "id": "archive",
        "note": "Archiving the project…",
        "action": "project.archive",
        "with": {
          "root": "../../.."
        }
      },
      {
        "id": "project",
        "note": "Copying the project into the VM…",
        "action": "ssh.run",
        "with": {
          "command": "sudo rm -rf /opt/isoloom && sudo mkdir -p /opt/isoloom && sudo tar -xzf - -C /opt/isoloom",
          "host": "${outputs.ip}",
          "user": "isoloom"
        },
        "stdin": "${run.state_dir}/project.tgz",
        "timeout_s": 600
      },
      {
        "id": "start",
        "note": "Starting the lab's containers in the VM…",
        "action": "ssh.run",
        "with": {
          "command": "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name segmented --file .isoloom/docker/compose.yml up --detach --build --pull missing --wait --wait-timeout 600",
          "host": "${outputs.ip}",
          "user": "isoloom"
        },
        "timeout_s": 1800
      }
    ],
    "down": [
      {
        "id": "clear-lock",
        "action": "terraform.clear_lock"
      },
      {
        "id": "init",
        "note": "Preparing Terraform and its providers…",
        "argv": [
          "terraform",
          "init",
          "-input=false",
          "-no-color",
          "-backend-config=path=${run.state_dir}/terraform.tfstate"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_proxmox_ssh_private_key_file": "${run.ssh_key}",
          "TF_VAR_slot": "${run.slot}",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 600
      },
      {
        "id": "destroy",
        "note": "Removing the lab from the server…",
        "argv": [
          "terraform",
          "destroy",
          "-auto-approve",
          "-input=false",
          "-no-color",
          "-refresh=false"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_proxmox_ssh_private_key_file": "${run.ssh_key}",
          "TF_VAR_slot": "${run.slot}",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 1800
      }
    ],
    "status": {
      "id": "state",
      "action": "terraform.read_state"
    }
  },
  "ready": [
    {
      "kind": "step_ok",
      "step": "apply",
      "means": "the Docker host VM exists and booted"
    },
    {
      "kind": "step_ok",
      "step": "start",
      "means": "every long-running service is healthy (`--wait`: each port's probe, the route keepers, the machines' own healthchecks)"
    }
  ],
  "outputs": [
    {
      "name": "ip",
      "description": "The Docker host's address: SSH reaches it there, and the published ports answer there.",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ip"
      }
    },
    {
      "name": "ssh_user",
      "description": "The user the runner's key lets in on the Docker host.",
      "role": "info",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ssh_user"
      }
    }
  ],
  "checks": {
    "protocol": "isoloom-check/1",
    "setup": [
      {
        "id": "stand-ins",
        "note": "Starting the access machine's stand-in…",
        "action": "ssh.run",
        "with": {
          "command": "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name segmented --file .isoloom/docker/compose.yml --profile check up --detach --wait --no-deps isoloom-access isoloom-access-routes",
          "host": "${outputs.ip}",
          "user": "isoloom"
        },
        "timeout_s": 600
      }
    ],
    "runners": [
      {
        "id": "isoloom-check",
        "from": "from user",
        "checks": [
          {
            "name": "the web page answers through the router",
            "kind": "http",
            "wait_s": 60,
            "derived": false
          },
          {
            "name": "the cache is sealed off from the user",
            "kind": "tcp",
            "wait_s": 0,
            "derived": false
          },
          {
            "name": "cache:6379 blocked from user",
            "kind": "tcp",
            "wait_s": 0,
            "derived": true
          },
          {
            "name": "web:80 from user",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          }
        ],
        "step": {
          "id": "check-user",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name segmented --file .isoloom/docker/compose.yml --profile check run --rm --no-deps --env ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} isoloom-check",
            "host": "${outputs.ip}",
            "user": "isoloom"
          },
          "timeout_s": 210
        },
        "on_timeout": [
          {
            "id": "rm-check-user",
            "action": "ssh.run",
            "with": {
              "command": "sudo docker ps -aq --filter label=com.docker.compose.project=segmented --filter label=com.docker.compose.service=isoloom-check --filter label=com.docker.compose.oneoff=True | xargs -r sudo docker rm -f",
              "host": "${outputs.ip}",
              "user": "isoloom"
            },
            "timeout_s": 60
          }
        ]
      },
      {
        "id": "isoloom-check-cache",
        "from": "from cache",
        "checks": [
          {
            "name": "web:80 blocked from cache",
            "kind": "tcp",
            "wait_s": 0,
            "derived": true
          },
          {
            "name": "web:4444 blocked from cache",
            "kind": "tcp",
            "wait_s": 0,
            "derived": true
          },
          {
            "name": "no internet from cache",
            "kind": "http",
            "wait_s": 0,
            "derived": true
          }
        ],
        "step": {
          "id": "check-cache",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name segmented --file .isoloom/docker/compose.yml --profile check run --rm --no-deps --env ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} isoloom-check-cache",
            "host": "${outputs.ip}",
            "user": "isoloom"
          },
          "timeout_s": 105
        },
        "on_timeout": [
          {
            "id": "rm-check-cache",
            "action": "ssh.run",
            "with": {
              "command": "sudo docker ps -aq --filter label=com.docker.compose.project=segmented --filter label=com.docker.compose.service=isoloom-check-cache --filter label=com.docker.compose.oneoff=True | xargs -r sudo docker rm -f",
              "host": "${outputs.ip}",
              "user": "isoloom"
            },
            "timeout_s": 60
          }
        ]
      },
      {
        "id": "isoloom-check-web",
        "from": "from web",
        "checks": [
          {
            "name": "cache:6379 from web",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          }
        ],
        "step": {
          "id": "check-web",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name segmented --file .isoloom/docker/compose.yml --profile check run --rm --no-deps --env ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} isoloom-check-web",
            "host": "${outputs.ip}",
            "user": "isoloom"
          },
          "timeout_s": 105
        },
        "on_timeout": [
          {
            "id": "rm-check-web",
            "action": "ssh.run",
            "with": {
              "command": "sudo docker ps -aq --filter label=com.docker.compose.project=segmented --filter label=com.docker.compose.service=isoloom-check-web --filter label=com.docker.compose.oneoff=True | xargs -r sudo docker rm -f",
              "host": "${outputs.ip}",
              "user": "isoloom"
            },
            "timeout_s": 60
          }
        ]
      }
    ],
    "teardown": []
  },
  "guest": {
    "machine": "docker",
    "host": "${outputs.ip}",
    "status": {
      "id": "ps",
      "action": "ssh.run",
      "with": {
        "command": "if command -v docker >/dev/null; then sudo docker compose --project-name segmented ps --all --format json; fi",
        "host": "${outputs.ip}",
        "user": "isoloom"
      },
      "timeout_s": 60
    }
  }
}

## .isoloom/docker-vm/proxmox/setup.sh
#!/bin/sh
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# The Docker host's set-up, piped into `sudo sh -s` over SSH by its run manifest.
set -e
cloud-init status --wait >/dev/null 2>&1 || true
command -v docker >/dev/null || if command -v apt-get >/dev/null; then (
  set -e
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -qq
  apt-get install -y -qq ca-certificates curl
  install -m 0755 -d /etc/apt/keyrings
  k=$(mktemp)
  # shellcheck disable=SC1091,SC2154 # /etc/os-release is on the guest, not here.
  _id=$(. /etc/os-release && printf %s "$ID")
  # shellcheck disable=SC1091,SC2154
  _cn=$(. /etc/os-release && printf %s "$VERSION_CODENAME")
  curl -fsSL "https://download.docker.com/linux/$_id/gpg" -o "$k"
  echo "1500c1f56fa9e26b9b8f42452a553675796ade0807cdce11975eb98170b3a570  $k" | sha256sum -c -
  install -m 0644 "$k" /etc/apt/keyrings/docker.asc
  rm -f "$k"
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/$_id $_cn stable" > /etc/apt/sources.list.d/docker.list
  apt-get update -qq
  v=$(apt-cache madison docker-ce | awk '$3 ~ /(^|:)29[.]9[.]0/ { print $3; exit }')
  [ -n "$v" ] || { echo "docker-ce 29.9.0 is not in Docker's apt repository" >&2; exit 1; }
  apt-get install -y -qq --allow-downgrades "docker-ce=$v" "docker-ce-cli=$v" containerd.io docker-buildx-plugin "docker-compose-plugin=5.6.0-*"
)
else
  curl -fsSL https://get.docker.com | VERSION=29.9.0 sh
fi
cat > /etc/systemd/system/isoloom-published.service <<'UNIT'
[Unit]
Description=Isoloom: published ports reach containers of networks without a default route
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'iptables -t nat -C POSTROUTING -m conntrack --ctstate DNAT -o br-+ -j MASQUERADE 2>/dev/null || iptables -t nat -I POSTROUTING -m conntrack --ctstate DNAT -o br-+ -j MASQUERADE'

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now isoloom-published.service

## .isoloom/docker-vm/run.json
{
  "$schema": "https://www.isoloom.com/schema/run-manifest/v0.json",
  "manifest_version": 0,
  "generator": {
    "name": "isoloom",
    "version": "1.0.1"
  },
  "environment": {
    "name": "segmented",
    "instance": null,
    "message": null
  },
  "target": "docker-vm",
  "driver": "vagrant",
  "hosts": [
    "linux",
    "macos",
    "windows"
  ],
  "tools": [
    {
      "name": "vagrant",
      "probe": [
        "vagrant",
        "--version"
      ],
      "min_version": "2.4.0"
    },
    {
      "name": "virtualbox",
      "probe": [
        "VBoxManage",
        "--version"
      ],
      "providers": [
        "virtualbox"
      ]
    },
    {
      "name": "vmware",
      "probe": [
        "vmrun",
        "list"
      ],
      "providers": [
        "vmware_desktop"
      ]
    },
    {
      "name": "parallels",
      "probe": [
        "prlctl",
        "--version"
      ],
      "hosts": [
        "macos"
      ],
      "providers": [
        "parallels"
      ]
    },
    {
      "name": "libvirt",
      "probe": [
        "virsh",
        "--version"
      ],
      "hosts": [
        "linux"
      ],
      "providers": [
        "libvirt"
      ]
    },
    {
      "name": "qemu",
      "probe": [
        "qemu-img",
        "--version"
      ],
      "providers": [
        "qemu"
      ]
    }
  ],
  "identity": {
    "vagrant": {
      "providers": [
        {
          "id": "virtualbox",
          "hosts": [
            "linux",
            "macos",
            "windows"
          ],
          "elevation": "none",
          "refusal": null
        },
        {
          "id": "vmware_desktop",
          "hosts": [
            "linux",
            "macos",
            "windows"
          ],
          "plugin": "vagrant-vmware-desktop",
          "elevation": "none",
          "refusal": null
        },
        {
          "id": "parallels",
          "hosts": [
            "macos"
          ],
          "plugin": "vagrant-parallels",
          "elevation": "none",
          "refusal": null
        },
        {
          "id": "libvirt",
          "hosts": [
            "linux"
          ],
          "plugin": "vagrant-libvirt",
          "elevation": "none",
          "refusal": null
        },
        {
          "id": "qemu",
          "hosts": [
            "linux",
            "macos"
          ],
          "plugin": "vagrant-qemu",
          "elevation": "none",
          "refusal": null
        },
        {
          "id": "utm",
          "hosts": [
            "macos"
          ],
          "plugin": "vagrant_utm",
          "elevation": "none",
          "refusal": null
        },
        {
          "id": "vmware_esxi",
          "hosts": [
            "linux",
            "macos",
            "windows"
          ],
          "plugin": "vagrant-vmware-esxi",
          "elevation": "none",
          "remote": true,
          "refusal": null
        }
      ],
      "dotfile": "${run.state_dir}/vagrant"
    }
  },
  "params": [
    {
      "name": "ISOLOOM_SSH_PROXY_COMMAND",
      "description": "The command Vagrant's SSH to the VMs goes through when this host can't reach them directly (an ESXi host through the runner's relay on macOS).",
      "providers": [
        "vmware_esxi"
      ],
      "set_by": "runner",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_SSH_PROXY_COMMAND",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "ESXI_HOSTNAME",
      "description": "The ESXi host.",
      "required": true,
      "providers": [
        "vmware_esxi"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ESXI_HOSTNAME",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "ESXI_HOSTPORT",
      "description": "Its SSH port.",
      "default": "22",
      "providers": [
        "vmware_esxi"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ESXI_HOSTPORT",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "ESXI_USERNAME",
      "description": "The ESXi user.",
      "default": "root",
      "providers": [
        "vmware_esxi"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ESXI_USERNAME",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "ESXI_DATASTORE",
      "description": "The datastore the VMs' disks go on (default: ESXi's first).",
      "providers": [
        "vmware_esxi"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ESXI_DATASTORE",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "ESXI_VIRTUAL_NETWORK",
      "description": "Port groups, comma-separated: the management network, then one per lab network.",
      "default": "VM Network",
      "providers": [
        "vmware_esxi"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ESXI_VIRTUAL_NETWORK",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "ISOLOOM_DERIVED",
      "description": "0: the checks derived from the spec (reachability, no internet) are skipped.",
      "default": "1",
      "values": [
        "0",
        "1"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_DERIVED",
          "steps": [
            "check-user",
            "check-cache",
            "check-web"
          ]
        }
      ]
    }
  ],
  "secrets": [
    {
      "name": "ESXI_PASSWORD",
      "kind": "connection",
      "required": true,
      "sensitive": true,
      "providers": [
        "vmware_esxi"
      ],
      "deliver": [
        {
          "via": "env",
          "var": "ESXI_PASSWORD",
          "steps": [
            "*"
          ]
        }
      ]
    }
  ],
  "networks": [
    {
      "name": "front",
      "cidr": "10.61.10.0/24",
      "internet": true,
      "native": "segmented_front"
    },
    {
      "name": "back",
      "cidr": "10.61.20.0/24",
      "internet": false,
      "native": "segmented_back"
    },
    {
      "name": "access",
      "cidr": "10.61.99.0/24",
      "internet": true,
      "native": "segmented_access"
    }
  ],
  "machines": [
    {
      "name": "docker",
      "role": "infra",
      "resources": {
        "cpus": 3,
        "memory_mb": 3072
      },
      "addresses": {},
      "native": {
        "vagrant": "default",
        "vm_names": {
          "virtualbox": "segmented · docker",
          "vmware_desktop": "segmented · docker",
          "hyperv": "segmented-docker",
          "parallels": "segmented · docker",
          "libvirt": "segmented_default",
          "utm": "segmented · docker",
          "vmware_esxi": "segmented-docker"
        }
      }
    },
    {
      "name": "isoloom-router",
      "role": "infra",
      "addresses": {
        "access": "10.61.99.254",
        "back": "10.61.20.254",
        "front": "10.61.10.254"
      },
      "native": {
        "service": "isoloom-router"
      }
    },
    {
      "name": "cache",
      "role": "target",
      "arch": "amd64",
      "resources": {
        "cpus": 1,
        "memory_mb": 1024
      },
      "addresses": {
        "back": "10.61.20.20"
      },
