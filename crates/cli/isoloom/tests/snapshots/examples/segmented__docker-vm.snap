    {
      "name": "isoloom-probe-amd64",
      "role": "infra",
      "addresses": {},
      "native": {
        "service": "isoloom-probe-amd64"
      }
    }
  ],
  "lifecycle": {
    "up": [
      {
        "id": "reconcile",
        "note": "Clearing the state of a run on another provider, if any…",
        "action": "vagrant.reconcile_provider"
      },
      {
        "id": "discard-saved",
        "action": "vagrant.discard_aborted_saved",
        "failure": "tolerate",
        "providers": [
          "virtualbox"
        ]
      },
      {
        "id": "forwarded-ports",
        "action": "vagrant.check_forwarded_ports",
        "providers": [
          "virtualbox",
          "vmware_desktop",
          "parallels",
          "libvirt",
          "qemu",
          "utm"
        ]
      },
      {
        "id": "up",
        "note": "Building the lab's VM with Docker in it…",
        "argv": [
          "vagrant",
          "up",
          "--provider",
          "${run.provider}",
          "--provision-with",
          "docker,project"
        ],
        "timeout_s": 3600
      },
      {
        "id": "start",
        "note": "Starting the lab's containers in the VM…",
        "argv": [
          "vagrant",
          "ssh",
          "--no-tty",
          "--command",
          "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name segmented --file .isoloom/docker/compose.yml up --detach --build --pull missing --wait --wait-timeout 600",
          "default"
        ],
        "timeout_s": 1800
      }
    ],
    "down": [
      {
        "id": "destroy",
        "argv": [
          "vagrant",
          "destroy",
          "--force"
        ],
        "timeout_s": 1800,
        "when": "always"
      },
      {
        "id": "orphans",
        "action": "vagrant.remove_orphans",
        "when": "always",
        "failure": "tolerate",
        "providers": [
          "virtualbox",
          "parallels"
        ]
      },
      {
        "id": "reset",
        "action": "vagrant.reset_state"
      }
    ],
    "park": {
      "pause": [
        {
          "id": "suspend",
          "argv": [
            "vagrant",
            "suspend"
          ],
          "timeout_s": 1800
        }
      ]
    },
    "resume": [
      {
        "id": "discard-saved",
        "action": "vagrant.discard_aborted_saved",
        "failure": "tolerate",
        "providers": [
          "virtualbox"
        ]
      },
      {
        "id": "resume",
        "argv": [
          "vagrant",
          "up",
          "--no-provision",
          "--provider",
          "${run.provider}"
        ],
        "timeout_s": 3600,
        "failure": "tolerate"
      },
      {
        "id": "discard-cut-off",
        "action": "vagrant.discard_aborted_saved",
        "failure": "tolerate",
        "providers": [
          "virtualbox"
        ]
      },
      {
        "id": "boot",
        "argv": [
          "vagrant",
          "up",
          "--no-provision",
          "--provider",
          "${run.provider}"
        ],
        "timeout_s": 3600
      }
    ],
    "status": {
      "id": "status",
      "argv": [
        "vagrant",
        "status",
        "--machine-readable"
      ],
      "timeout_s": 25,
      "provider_timeout_s": {
        "vmware_esxi": 90
      }
    }
  },
  "ready": [
    {
      "kind": "step_ok",
      "step": "up",
      "means": "the VM booted with Docker and the project in it"
    },
    {
      "kind": "step_ok",
      "step": "start",
      "means": "every long-running service is healthy (`--wait`: each port's probe, the route keepers, the machines' own healthchecks)"
    }
  ],
  "outputs": [],
  "checks": {
    "protocol": "isoloom-check/1",
    "setup": [
      {
        "id": "stand-ins",
        "note": "Starting the access machine's stand-in…",
        "argv": [
          "vagrant",
          "ssh",
          "--no-tty",
          "--command",
          "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name segmented --file .isoloom/docker/compose.yml --profile check up --detach --wait --no-deps isoloom-access isoloom-access-routes",
          "default"
        ],
        "timeout_s": 600
      }
    ],
    "runners": [
      {
        "id": "isoloom-check",
        "from": "from user",
        "checks": [
          {
            "name": "the web page answers through the router",
            "kind": "http",
            "wait_s": 60,
            "derived": false
          },
          {
            "name": "the cache is sealed off from the user",
            "kind": "tcp",
            "wait_s": 0,
            "derived": false
          },
          {
            "name": "cache:6379 blocked from user",
            "kind": "tcp",
            "wait_s": 0,
            "derived": true
          },
          {
            "name": "web:80 from user",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          }
        ],
        "step": {
          "id": "check-user",
          "argv": [
            "vagrant",
            "ssh",
            "--no-tty",
            "--command",
            "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name segmented --file .isoloom/docker/compose.yml --profile check run --rm --no-deps --env ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} isoloom-check",
            "default"
          ],
          "timeout_s": 210
        },
        "on_timeout": [
          {
            "id": "rm-check-user",
            "argv": [
              "vagrant",
              "ssh",
              "--no-tty",
              "--command",
              "sudo docker ps -aq --filter label=com.docker.compose.project=segmented --filter label=com.docker.compose.service=isoloom-check --filter label=com.docker.compose.oneoff=True | xargs -r sudo docker rm -f",
              "default"
            ],
            "timeout_s": 60
          }
        ]
      },
      {
        "id": "isoloom-check-cache",
        "from": "from cache",
        "checks": [
          {
            "name": "web:80 blocked from cache",
            "kind": "tcp",
            "wait_s": 0,
            "derived": true
          },
          {
            "name": "web:4444 blocked from cache",
            "kind": "tcp",
            "wait_s": 0,
            "derived": true
          },
          {
            "name": "no internet from cache",
            "kind": "http",
            "wait_s": 0,
            "derived": true
          }
        ],
        "step": {
          "id": "check-cache",
          "argv": [
            "vagrant",
            "ssh",
            "--no-tty",
            "--command",
            "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name segmented --file .isoloom/docker/compose.yml --profile check run --rm --no-deps --env ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} isoloom-check-cache",
            "default"
          ],
          "timeout_s": 105
        },
        "on_timeout": [
          {
            "id": "rm-check-cache",
            "argv": [
              "vagrant",
              "ssh",
              "--no-tty",
              "--command",
              "sudo docker ps -aq --filter label=com.docker.compose.project=segmented --filter label=com.docker.compose.service=isoloom-check-cache --filter label=com.docker.compose.oneoff=True | xargs -r sudo docker rm -f",
              "default"
            ],
            "timeout_s": 60
          }
        ]
      },
      {
        "id": "isoloom-check-web",
        "from": "from web",
        "checks": [
          {
            "name": "cache:6379 from web",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          }
        ],
        "step": {
          "id": "check-web",
          "argv": [
            "vagrant",
            "ssh",
            "--no-tty",
            "--command",
            "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name segmented --file .isoloom/docker/compose.yml --profile check run --rm --no-deps --env ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} isoloom-check-web",
            "default"
          ],
          "timeout_s": 105
        },
        "on_timeout": [
          {
            "id": "rm-check-web",
            "argv": [
              "vagrant",
              "ssh",
              "--no-tty",
              "--command",
              "sudo docker ps -aq --filter label=com.docker.compose.project=segmented --filter label=com.docker.compose.service=isoloom-check-web --filter label=com.docker.compose.oneoff=True | xargs -r sudo docker rm -f",
              "default"
            ],
            "timeout_s": 60
          }
        ]
      }
    ],
    "teardown": []
  },
  "recovery": {
    "stale_markers": [
      "verr_already_exists",
      "could not rename",
      "is locked",
      "different provider",
      "single provider at a time"
    ],
    "steps": [
      {
        "id": "destroy",
        "note": "Clearing what an earlier run left, then starting again…",
        "argv": [
          "vagrant",
          "destroy",
          "--force"
        ],
        "timeout_s": 180,
        "when": "always",
        "failure": "tolerate"
      },
      {
        "id": "orphans",
        "action": "vagrant.remove_orphans",
        "when": "always",
        "failure": "tolerate",
        "providers": [
          "virtualbox",
          "parallels"
        ]
      },
      {
        "id": "reset",
        "action": "vagrant.reset_state",
        "when": "always"
      }
    ],
    "retries": 1
  },
  "guest": {
    "machine": "docker",
    "status": {
      "id": "ps",
      "argv": [
        "vagrant",
        "ssh",
        "--no-tty",
        "--command",
        "if command -v docker >/dev/null; then sudo docker compose --project-name segmented ps --all --format json; fi",
        "default"
      ],
      "timeout_s": 60
    }
  }
}

