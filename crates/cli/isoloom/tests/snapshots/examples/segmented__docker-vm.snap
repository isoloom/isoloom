        "service": "user"
      }
    },
    {
      "name": "user-routes",
      "role": "infra",
      "of": "user",
      "addresses": {},
      "native": {
        "service": "user-routes"
      }
    },
    {
      "name": "isoloom-access",
      "role": "access",
      "addresses": {
        "access": "10.61.99.10"
      },
      "native": {
        "service": "isoloom-access"
      }
    },
    {
      "name": "isoloom-access-routes",
      "role": "infra",
      "of": "isoloom-access",
      "addresses": {},
      "native": {
        "service": "isoloom-access-routes"
      }
    },
    {
      "name": "isoloom-check",
      "role": "check",
      "of": "user",
