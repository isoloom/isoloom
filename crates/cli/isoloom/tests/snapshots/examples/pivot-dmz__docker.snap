_retry() { _end=$(( $(date +%s) + $1 )); shift; while ! "$@"; do [ "$(date +%s)" -lt "$_end" ] || return 1; sleep 2; done; }

echo '== checks/dmz-reachable.sh'
if _retry 0 sh -c 'cd /isoloom/project && sh checks/dmz-reachable.sh'; then pass 'checks/dmz-reachable.sh'; else fail 'checks/dmz-reachable.sh' "checks/dmz-reachable.sh exited non-zero"; fi

echo '== checks/internal-not-reachable-from-access.sh'
if _retry 0 sh -c 'cd /isoloom/project && sh checks/internal-not-reachable-from-access.sh'; then pass 'checks/internal-not-reachable-from-access.sh'; else fail 'checks/internal-not-reachable-from-access.sh' "checks/internal-not-reachable-from-access.sh exited non-zero"; fi

if [ "${ISOLOOM_DERIVED:-1}" != 0 ]; then
if _retry 30 _tcp '10.30.10.10' 80; then pass 'gateway:80 on dmz from user'; else fail 'gateway:80 on dmz from user' "nothing listens at 10.30.10.10:80"; fi
fi

if [ "${ISOLOOM_DERIVED:-1}" != 0 ]; then
if _retry 30 _tcp '10.30.10.10' 22; then pass 'gateway:22 on dmz from user'; else fail 'gateway:22 on dmz from user' "nothing listens at 10.30.10.10:22"; fi
fi

if [ "${ISOLOOM_DERIVED:-1}" != 0 ]; then
if _tcp '10.30.20.20' 8080; then fail 'app:8080 blocked from user' "10.30.20.20:8080 answered; it should be blocked"; else pass 'app:8080 blocked from user'; fi
fi

if [ "${ISOLOOM_DERIVED:-1}" != 0 ]; then
if _tcp '10.30.20.30' 5432; then fail 'db:5432 blocked from user' "10.30.20.30:5432 answered; it should be blocked"; else pass 'db:5432 blocked from user'; fi
fi

echo "isoloom-check: END $passed passed, $failed failed"
[ "$failed" -eq 0 ]

## .isoloom/docker/compose.yml
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  docker compose -f .isoloom/docker/compose.yml up -d --wait
# Checks: isoloom test docker (or: docker compose -f .isoloom/docker/compose.yml --profile check run --rm isoloom-check, and isoloom-check-<machine>)
# Stop:   docker compose -f .isoloom/docker/compose.yml down -v

name: pivot-dmz
services:
  isoloom-router:
    image: alpine:3.20
    sysctls:
      net.ipv4.ip_forward: '1'
    entrypoint:
    - /bin/sh
    - -c
    - apk add --no-cache nftables >/dev/null && printf '%s' "$$RULES" | nft -f - && exec sleep infinity
    hostname: isoloom-router
    networks:
      dmz:
        ipv4_address: 10.30.10.254
      internal:
        ipv4_address: 10.30.20.254
      access:
        ipv4_address: 10.30.99.254
    cap_add:
    - NET_ADMIN
    environment:
      RULES: |
        table inet isoloom {
          chain forward {
            type filter hook forward priority 0; policy drop;
            ct state established,related accept
            ip saddr 10.30.99.0/24 ip daddr 10.30.10.0/24 accept
            ip saddr 10.30.10.0/24 ip daddr 10.30.20.0/24 meta l4proto { tcp, udp } th dport { 8080, 5432 } accept
            ip saddr 10.30.10.0/24 ip daddr 10.30.20.0/24 icmp type echo-request accept
          }
        }
    healthcheck:
      test:
      - CMD-SHELL
      - nft list table inet isoloom >/dev/null 2>&1
      interval: 3s
      timeout: 3s
      retries: 60
    labels:
      isoloom.managed: 'true'
      isoloom.environment: pivot-dmz
    restart: unless-stopped
  gateway:
    build:
      context: ../../build/gateway
      labels:
        isoloom.managed: 'true'
        isoloom.environment: pivot-dmz
    image: isoloom/pivot-dmz-gateway
    platform: linux/amd64
    hostname: gateway
    networks:
      dmz:
        ipv4_address: 10.30.10.10
      internal:
        ipv4_address: 10.30.20.10
    extra_hosts:
    - user:10.30.99.10
    volumes:
    - isoloom-probe-amd64:/.isoloom-probe:ro
    healthcheck:
      test:
      - CMD
      - /.isoloom-probe/busybox
      - sh
      - -c
      - /.isoloom-probe/busybox nc -z -w 2 127.0.0.1 80 && /.isoloom-probe/busybox nc -z -w 2 127.0.0.1 22
      interval: 5s
      timeout: 3s
      retries: 60
      start_period: 10s
    depends_on:
      isoloom-probe-amd64:
        condition: service_completed_successfully
    labels:
      isoloom.port.80: tcp:80
      isoloom.port.22: tcp:22
      isoloom.managed: 'true'
      isoloom.environment: pivot-dmz
    restart: unless-stopped
  gateway-routes:
    image: alpine:3.20
    entrypoint:
    - /bin/sh
    - -c
    - ip route replace 10.30.99.0/24 via 10.30.10.254 && while ip -o -4 addr show | grep -qv ' lo '; do sleep 2; done; exit 1
    network_mode: service:gateway
    cap_add:
    - NET_ADMIN
    healthcheck:
      test:
      - CMD-SHELL
      - ip route show 10.30.99.0/24 | grep -q via
      interval: 2s
      timeout: 2s
      retries: 30
    depends_on:
      gateway:
        condition: service_started
      isoloom-router:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: pivot-dmz
    restart: unless-stopped
  app:
    build:
      context: ../../build/app
      labels:
        isoloom.managed: 'true'
        isoloom.environment: pivot-dmz
    image: isoloom/pivot-dmz-app
    platform: linux/amd64
    hostname: app
    networks:
      internal:
        ipv4_address: 10.30.20.20
    extra_hosts:
    - user:10.30.99.10
    volumes:
    - isoloom-probe-amd64:/.isoloom-probe:ro
    healthcheck:
      test:
      - CMD
      - /.isoloom-probe/busybox
      - sh
      - -c
      - /.isoloom-probe/busybox nc -z -w 2 127.0.0.1 8080
      interval: 5s
      timeout: 3s
      retries: 60
      start_period: 10s
    depends_on:
      isoloom-probe-amd64:
        condition: service_completed_successfully
    labels:
      isoloom.port.8080: tcp:8080
      isoloom.managed: 'true'
      isoloom.environment: pivot-dmz
    restart: unless-stopped
  app-routes:
    image: alpine:3.20
    entrypoint:
    - /bin/sh
    - -c
    - ip route replace 10.30.10.0/24 via 10.30.20.254 && ip route replace 10.30.99.0/24 via 10.30.20.254 && (ip route del default 2>/dev/null || true) && while ip -o -4 addr show | grep -qv ' lo '; do sleep 2; done; exit 1
    network_mode: service:app
    cap_add:
    - NET_ADMIN
    healthcheck:
      test:
      - CMD-SHELL
      - ip route show 10.30.10.0/24 | grep -q via && ! ip route | grep -q '^default'
      interval: 2s
      timeout: 2s
      retries: 30
    depends_on:
      app:
        condition: service_started
      isoloom-router:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: pivot-dmz
    restart: unless-stopped
  db:
    image: postgres:16
    platform: linux/amd64
    hostname: db
    networks:
      internal:
        ipv4_address: 10.30.20.30
    extra_hosts:
    - user:10.30.99.10
    volumes:
    - isoloom-probe-amd64:/.isoloom-probe:ro
    healthcheck:
      test:
      - CMD
      - /.isoloom-probe/busybox
      - sh
      - -c
      - /.isoloom-probe/busybox nc -z -w 2 127.0.0.1 5432
      interval: 5s
      timeout: 3s
      retries: 60
      start_period: 10s
    depends_on:
      isoloom-probe-amd64:
        condition: service_completed_successfully
    labels:
      isoloom.port.5432: tcp:5432
      isoloom.managed: 'true'
      isoloom.environment: pivot-dmz
    restart: unless-stopped
  db-routes:
    image: alpine:3.20
    entrypoint:
    - /bin/sh
    - -c
    - ip route replace 10.30.10.0/24 via 10.30.20.254 && ip route replace 10.30.99.0/24 via 10.30.20.254 && (ip route del default 2>/dev/null || true) && while ip -o -4 addr show | grep -qv ' lo '; do sleep 2; done; exit 1
    network_mode: service:db
    cap_add:
    - NET_ADMIN
    healthcheck:
      test:
      - CMD-SHELL
      - ip route show 10.30.10.0/24 | grep -q via && ! ip route | grep -q '^default'
      interval: 2s
      timeout: 2s
      retries: 30
    depends_on:
      db:
        condition: service_started
      isoloom-router:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: pivot-dmz
    restart: unless-stopped
  isoloom-access:
    image: alpine:3.20
    profiles:
    - check
    entrypoint:
    - sleep
    - infinity
    hostname: user
    networks:
      access:
        ipv4_address: 10.30.99.10
    extra_hosts:
    - gateway:10.30.10.10
    - app:10.30.20.20
    - db:10.30.20.30
    labels:
      isoloom.managed: 'true'
      isoloom.environment: pivot-dmz
  isoloom-access-routes:
    image: alpine:3.20
    profiles:
    - check
    entrypoint:
    - /bin/sh
    - -c
    - ip route replace 10.30.10.0/24 via 10.30.99.254 && ip route replace 10.30.20.0/24 via 10.30.99.254 && while ip -o -4 addr show | grep -qv ' lo '; do sleep 2; done; exit 1
    network_mode: service:isoloom-access
    cap_add:
    - NET_ADMIN
    healthcheck:
      test:
      - CMD-SHELL
      - ip route show 10.30.10.0/24 | grep -q via
      interval: 2s
      timeout: 2s
      retries: 30
    depends_on:
      isoloom-access:
        condition: service_started
      isoloom-router:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: pivot-dmz
    restart: unless-stopped
  isoloom-check:
    image: curlimages/curl:8.11.1
    profiles:
    - check
    entrypoint:
    - /bin/sh
    - /isoloom/run.sh
    network_mode: service:isoloom-access
    volumes:
    - ./checks/user.sh:/isoloom/run.sh:ro
    - ../..:/isoloom/project:ro
    depends_on:
      gateway:
        condition: service_healthy
      gateway-routes:
        condition: service_healthy
      app:
        condition: service_healthy
      app-routes:
        condition: service_healthy
      db:
        condition: service_healthy
      db-routes:
        condition: service_healthy
      isoloom-access:
        condition: service_started
      isoloom-access-routes:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: pivot-dmz
  isoloom-check-gateway:
    image: curlimages/curl:8.11.1
    profiles:
    - check
    entrypoint:
    - /bin/sh
    - /isoloom/run.sh
    network_mode: service:gateway
    volumes:
    - ./checks/gateway.sh:/isoloom/run.sh:ro
    depends_on:
      gateway:
        condition: service_healthy
      gateway-routes:
        condition: service_healthy
      app:
        condition: service_healthy
      app-routes:
        condition: service_healthy
      db:
        condition: service_healthy
      db-routes:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: pivot-dmz
  isoloom-check-app:
    image: curlimages/curl:8.11.1
    profiles:
    - check
    entrypoint:
    - /bin/sh
    - /isoloom/run.sh
    network_mode: service:app
    volumes:
    - ./checks/app.sh:/isoloom/run.sh:ro
    depends_on:
      gateway:
        condition: service_healthy
      gateway-routes:
        condition: service_healthy
      app:
        condition: service_healthy
      app-routes:
        condition: service_healthy
      db:
        condition: service_healthy
      db-routes:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: pivot-dmz
  isoloom-check-db:
    image: curlimages/curl:8.11.1
    profiles:
    - check
    entrypoint:
    - /bin/sh
    - /isoloom/run.sh
    network_mode: service:db
    volumes:
    - ./checks/db.sh:/isoloom/run.sh:ro
    depends_on:
      gateway:
        condition: service_healthy
      gateway-routes:
        condition: service_healthy
      app:
        condition: service_healthy
      app-routes:
        condition: service_healthy
      db:
        condition: service_healthy
      db-routes:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: pivot-dmz
  isoloom-probe-amd64:
    image: busybox:1.37.0-musl
    platform: linux/amd64
    entrypoint:
    - /bin/cp
    - /bin/busybox
    - /probe/busybox
    network_mode: none
    volumes:
    - isoloom-probe-amd64:/probe
    labels:
      isoloom.managed: 'true'
      isoloom.environment: pivot-dmz
    restart: no
networks:
  dmz:
    ipam:
      config:
      - subnet: 10.30.10.0/24
        gateway: 10.30.10.1
    labels:
      isoloom.managed: 'true'
      isoloom.environment: pivot-dmz
  internal:
    ipam:
      config:
      - subnet: 10.30.20.0/24
        gateway: 10.30.20.1
    labels:
      isoloom.managed: 'true'
      isoloom.environment: pivot-dmz
  access:
    ipam:
      config:
      - subnet: 10.30.99.0/24
        gateway: 10.30.99.1
    labels:
      isoloom.managed: 'true'
      isoloom.environment: pivot-dmz
volumes:
  isoloom-probe-amd64:
    labels:
      isoloom.managed: 'true'
      isoloom.environment: pivot-dmz

## .isoloom/docker/run.json
{
  "$schema": "https://www.isoloom.com/schema/run-manifest/v0.json",
  "manifest_version": 0,
  "generator": {
    "name": "isoloom",
    "version": "0.10.1"
  },
  "lab": {
    "name": "pivot-dmz",
    "instance": null,
    "message": null
  },
  "target": "docker",
  "driver": "compose",
  "hosts": [
    "linux",
    "macos",
    "windows"
  ],
  "tools": [
    {
      "name": "docker",
      "probe": [
        "docker",
        "info",
        "--format",
        "{{.ServerVersion}}"
      ]
    },
    {
      "name": "docker-compose",
      "probe": [
        "docker",
        "compose",
        "version",
        "--short"
      ],
      "min_version": "2.17.0"
    }
  ],
  "identity": {
    "compose": {
      "project": "${run.name}",
      "files": [
        "compose.yml",
        "${run.state_dir}/ports.yml"
      ],
      "pinned_ports_file": "${run.state_dir}/ports.yml"
    }
  },
  "params": [
    {
      "name": "ISOLOOM_DERIVED",
      "description": "0: the checks derived from the spec (reachability, no internet) are skipped.",
      "default": "1",
      "values": [
        "0",
        "1"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_DERIVED",
          "steps": [
            "check-user",
            "check-gateway",
            "check-app",
            "check-db"
          ]
        }
      ]
    }
  ],
  "secrets": [],
  "networks": [
    {
      "name": "dmz",
      "cidr": "10.30.10.0/24",
      "internet": true,
      "native": "${run.name}_dmz"
    },
    {
      "name": "internal",
      "cidr": "10.30.20.0/24",
      "internet": false,
      "native": "${run.name}_internal"
    },
    {
      "name": "access",
      "cidr": "10.30.99.0/24",
      "internet": true,
      "native": "${run.name}_access"
    }
  ],
  "machines": [
    {
      "name": "isoloom-router",
      "role": "infra",
      "addresses": {
        "access": "10.30.99.254",
        "dmz": "10.30.10.254",
        "internal": "10.30.20.254"
      },
      "native": {
        "service": "isoloom-router"
      }
    },
    {
      "name": "gateway",
      "role": "target",
      "arch": "amd64",
      "addresses": {
        "dmz": "10.30.10.10",
        "internal": "10.30.20.10"
      },
      "native": {
        "service": "gateway"
      },
      "ports": [
        {
          "port": 80,
          "protocol": "tcp",
          "http": false
        },
        {
          "port": 22,
          "protocol": "tcp",
          "http": false
        }
      ]
    },
    {
      "name": "gateway-routes",
      "role": "infra",
      "of": "gateway",
      "addresses": {},
      "native": {
        "service": "gateway-routes"
      }
    },
    {
      "name": "app",
      "role": "target",
      "arch": "amd64",
      "addresses": {
        "internal": "10.30.20.20"
      },
      "native": {
        "service": "app"
      },
      "ports": [
        {
          "port": 8080,
          "protocol": "tcp",
          "http": false
        }
      ]
    },
    {
      "name": "app-routes",
      "role": "infra",
      "of": "app",
      "addresses": {},
      "native": {
        "service": "app-routes"
      }
    },
    {
      "name": "db",
      "role": "target",
      "arch": "amd64",
      "addresses": {
        "internal": "10.30.20.30"
      },
      "native": {
        "service": "db"
      },
      "ports": [
        {
          "port": 5432,
          "protocol": "tcp",
          "http": false
        }
      ]
    },
    {
      "name": "db-routes",
      "role": "infra",
      "of": "db",
      "addresses": {},
      "native": {
        "service": "db-routes"
      }
    },
    {
      "name": "isoloom-access",
      "role": "access",
      "addresses": {
        "access": "10.30.99.10"
      },
      "native": {
        "service": "isoloom-access"
      }
    },
    {
      "name": "isoloom-access-routes",
      "role": "infra",
      "of": "isoloom-access",
      "addresses": {},
      "native": {
        "service": "isoloom-access-routes"
      }
    },
    {
      "name": "isoloom-check",
      "role": "check",
      "of": "isoloom-access",
      "addresses": {},
      "native": {
        "service": "isoloom-check"
      }
    },
    {
      "name": "isoloom-check-gateway",
      "role": "check",
      "of": "gateway",
      "addresses": {},
      "native": {
        "service": "isoloom-check-gateway"
      }
    },
    {
      "name": "isoloom-check-app",
      "role": "check",
      "of": "app",
      "addresses": {},
      "native": {
        "service": "isoloom-check-app"
      }
    },
    {
      "name": "isoloom-check-db",
      "role": "check",
      "of": "db",
      "addresses": {},
      "native": {
        "service": "isoloom-check-db"
      }
    },
    {
      "name": "isoloom-probe-amd64",
      "role": "infra",
      "addresses": {},
      "native": {
        "service": "isoloom-probe-amd64"
      }
    }
  ],
  "lifecycle": {
    "up": [
      {
        "id": "pin-ports",
        "note": "Picking the lab's host ports…",
        "action": "compose.pin_ports"
      },
      {
        "id": "ports-free",
        "action": "compose.check_ports_free"
      },
      {
        "id": "stale-networks",
        "action": "compose.remove_stale_networks",
        "failure": "tolerate"
      },
      {
        "id": "up",
        "note": "Starting the lab's containers…",
        "argv": [
          "docker",
          "compose",
          "--project-name",
          "${run.name}",
          "--file",
          "compose.yml",
          "--file",
          "${run.state_dir}/ports.yml",
          "up",
          "--detach",
          "--build",
          "--pull",
          "missing",
          "--wait",
          "--wait-timeout",
          "600"
        ],
        "timeout_s": 1800
      }
    ],
    "down": [
      {
        "id": "down",
        "argv": [
          "docker",
          "compose",
          "--project-name",
          "${run.name}",
          "--file",
          "compose.yml",
          "--file",
          "${run.state_dir}/ports.yml",
          "--profile",
          "check",
          "down",
          "--volumes",
          "--remove-orphans"
        ],
        "timeout_s": 300,
        "when": "always"
      },
      {
        "id": "containers",
        "action": "compose.remove_containers",
        "when": "always",
        "failure": "tolerate"
      },
      {
        "id": "networks",
        "action": "compose.remove_networks",
        "when": "always",
        "failure": "tolerate"
      }
    ],
    "park": {
      "pause": [
        {
          "id": "stop",
          "argv": [
            "docker",
            "compose",
            "--project-name",
            "${run.name}",
            "--file",
            "compose.yml",
            "--file",
            "${run.state_dir}/ports.yml",
            "stop"
          ],
          "timeout_s": 300
        }
      ],
      "shutdown": [
        {
          "id": "stop",
          "argv": [
            "docker",
            "compose",
            "--project-name",
            "${run.name}",
            "--file",
            "compose.yml",
            "--file",
            "${run.state_dir}/ports.yml",
            "stop"
          ],
          "timeout_s": 300
        }
      ]
    },
    "resume": [
      {
        "id": "start",
        "argv": [
          "docker",
          "compose",
          "--project-name",
          "${run.name}",
          "--file",
          "compose.yml",
          "--file",
          "${run.state_dir}/ports.yml",
          "start"
        ],
        "timeout_s": 600
      }
    ],
    "status": {
      "id": "ps",
      "argv": [
        "docker",
        "compose",
        "--project-name",
        "${run.name}",
        "--file",
        "compose.yml",
        "--file",
        "${run.state_dir}/ports.yml",
        "ps",
        "--all",
        "--format",
        "json"
      ],
      "timeout_s": 25
    }
  },
  "ready": [
    {
      "kind": "step_ok",
      "step": "up",
      "means": "every long-running service is healthy (`--wait`: each port's probe, the route keepers, the machines' own healthchecks)"
    }
  ],
  "outputs": [],
  "checks": {
    "protocol": "isoloom-check/1",
    "setup": [
      {
        "id": "stand-ins",
        "note": "Starting the access machine's stand-in…",
        "argv": [
          "docker",
          "compose",
          "--project-name",
          "${run.name}",
          "--file",
          "compose.yml",
          "--file",
          "${run.state_dir}/ports.yml",
          "--profile",
          "check",
          "up",
          "--detach",
          "--wait",
          "--no-deps",
          "isoloom-access",
          "isoloom-access-routes"
        ],
        "timeout_s": 600
      }
    ],
    "runners": [
      {
        "id": "isoloom-check",
        "from": "from user",
        "checks": [
          {
            "name": "checks/dmz-reachable.sh",
            "kind": "script",
            "wait_s": 0,
            "derived": false
          },
          {
            "name": "checks/internal-not-reachable-from-access.sh",
            "kind": "script",
            "wait_s": 0,
            "derived": false
          },
          {
            "name": "gateway:80 on dmz from user",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "gateway:22 on dmz from user",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "app:8080 blocked from user",
            "kind": "tcp",
            "wait_s": 0,
            "derived": true
          },
          {
            "name": "db:5432 blocked from user",
            "kind": "tcp",
            "wait_s": 0,
            "derived": true
          }
        ],
        "step": {
          "id": "check-user",
          "argv": [
            "docker",
            "compose",
            "--project-name",
            "${run.name}",
            "--file",
            "compose.yml",
            "--file",
            "${run.state_dir}/ports.yml",
            "--profile",
            "check",
            "run",
            "--rm",
            "--no-deps",
            "--env",
            "ISOLOOM_DERIVED",
            "isoloom-check"
          ],
          "timeout_s": 210
        },
        "on_timeout": [
          {
            "id": "rm-check-user",
            "action": "compose.remove_containers",
            "with": {
              "one_off": "true",
              "service": "isoloom-check"
            },
            "failure": "tolerate"
          }
        ]
      },
      {
        "id": "isoloom-check-gateway",
        "from": "from gateway",
        "checks": [
          {
            "name": "app:8080 from gateway",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "db:5432 from gateway",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          }
        ],
        "step": {
          "id": "check-gateway",
          "argv": [
            "docker",
            "compose",
            "--project-name",
            "${run.name}",
            "--file",
            "compose.yml",
            "--file",
            "${run.state_dir}/ports.yml",
            "--profile",
            "check",
            "run",
            "--rm",
            "--no-deps",
            "--env",
            "ISOLOOM_DERIVED",
            "isoloom-check-gateway"
          ],
          "timeout_s": 150
        },
        "on_timeout": [
          {
            "id": "rm-check-gateway",
            "action": "compose.remove_containers",
            "with": {
              "one_off": "true",
              "service": "isoloom-check-gateway"
            },
            "failure": "tolerate"
          }
        ]
      },
      {
        "id": "isoloom-check-app",
        "from": "from app",
        "checks": [
          {
            "name": "gateway:80 on internal from app",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "gateway:22 on internal from app",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "db:5432 from app",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "no internet from app",
            "kind": "http",
            "wait_s": 0,
            "derived": true
          }
        ],
        "step": {
          "id": "check-app",
          "argv": [
            "docker",
            "compose",
            "--project-name",
            "${run.name}",
            "--file",
            "compose.yml",
            "--file",
            "${run.state_dir}/ports.yml",
            "--profile",
            "check",
            "run",
            "--rm",
            "--no-deps",
            "--env",
            "ISOLOOM_DERIVED",
            "isoloom-check-app"
          ],
          "timeout_s": 210
        },
        "on_timeout": [
          {
            "id": "rm-check-app",
            "action": "compose.remove_containers",
            "with": {
              "one_off": "true",
              "service": "isoloom-check-app"
            },
            "failure": "tolerate"
          }
        ]
      },
      {
        "id": "isoloom-check-db",
        "from": "from db",
        "checks": [
          {
            "name": "gateway:80 on internal from db",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "gateway:22 on internal from db",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "app:8080 from db",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "no internet from db",
            "kind": "http",
            "wait_s": 0,
            "derived": true
          }
        ],
        "step": {
          "id": "check-db",
          "argv": [
            "docker",
            "compose",
            "--project-name",
            "${run.name}",
            "--file",
            "compose.yml",
            "--file",
            "${run.state_dir}/ports.yml",
            "--profile",
            "check",
            "run",
            "--rm",
            "--no-deps",
            "--env",
            "ISOLOOM_DERIVED",
            "isoloom-check-db"
          ],
          "timeout_s": 210
        },
        "on_timeout": [
          {
            "id": "rm-check-db",
            "action": "compose.remove_containers",
            "with": {
              "one_off": "true",
              "service": "isoloom-check-db"
            },
            "failure": "tolerate"
          }
        ]
      }
    ],
    "teardown": []
  },
  "recovery": {
    "stale_markers": [
      "is already in use by container",
      "network with name",
      "has incorrect label"
    ],
    "steps": [
      {
        "id": "containers",
        "action": "compose.remove_containers",
        "when": "always",
        "failure": "tolerate"
      },
      {
        "id": "networks",
        "action": "compose.remove_networks",
        "when": "always",
        "failure": "tolerate"
      }
    ],
    "retries": 1
  }
}

