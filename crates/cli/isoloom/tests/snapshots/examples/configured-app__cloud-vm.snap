    description = "the internet"
    destination = "224.0.0.0/3"
    protocol    = "all"
  }
  egress_security_rules {
    description = "path MTU discovery"
    destination = "0.0.0.0/0"
    protocol    = "1"
    icmp_options {
      type = 3
      code = 4
    }
  }
}

resource "oci_core_subnet" "lab" {
  compartment_id    = var.compartment_id
  freeform_tags     = local.tags
  vcn_id            = oci_core_vcn.env.id
  cidr_block        = "10.66.0.0/24"
  display_name      = "${local.name}-lab"
  route_table_id    = oci_core_route_table.env.id
  security_list_ids = [oci_core_security_list.lab.id]
}

# The ports `web` publishes, from allowed_cidr: on its VNIC only.
resource "oci_core_network_security_group" "web" {
  compartment_id = var.compartment_id
  freeform_tags  = local.tags
  vcn_id         = oci_core_vcn.env.id
  display_name   = "${local.name}-web"
}

resource "oci_core_network_security_group_security_rule" "web_tcp_8086" {
  network_security_group_id = oci_core_network_security_group.web.id
  description               = "published"
  direction                 = "INGRESS"
  protocol                  = "6"
  source                    = var.allowed_cidr
  source_type               = "CIDR_BLOCK"
  tcp_options {
    destination_port_range {
      min = 8086
      max = 8086
    }
  }
}

# Machine `web`, at its fixed address 10.66.0.10.
resource "oci_core_instance" "web" {
  compartment_id      = var.compartment_id
  freeform_tags       = local.tags
  availability_domain = data.oci_identity_availability_domains.ads.availability_domains[0].name
  display_name        = "${local.name}-web"
  shape               = "VM.Standard.E4.Flex"
  shape_config {
    ocpus         = 1
    memory_in_gbs = 1
  }
  source_details {
    source_type             = "image"
    source_id               = data.oci_core_images.ubuntu_2404.images[0].id
    boot_volume_size_in_gbs = 50
  }
  create_vnic_details {
    subnet_id              = oci_core_subnet.lab.id
    private_ip             = "10.66.0.10"
    assign_public_ip       = true
    hostname_label         = "web"
    skip_source_dest_check = false
    nsg_ids                = [oci_core_network_security_group.web.id]
  }
  metadata = {
    ssh_authorized_keys = var.ssh_public_key
    user_data           = base64encode(var.auto_stop_minutes > 0 ? "#!/bin/sh\nshutdown -h +${var.auto_stop_minutes}\n" : "#!/bin/sh\n")
  }
}

resource "terraform_data" "web" {
  triggers_replace = [oci_core_instance.web.id]
  connection {
    type        = "ssh"
    host        = oci_core_instance.web.public_ip
    user        = "ubuntu"
    private_key = file(pathexpand(var.ssh_private_key_file))
    timeout     = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-web.tgz\" --exclude=.git --exclude=.vagrant --exclude=.terraform --exclude=.isoloom-project* -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-web.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "remote-exec" {
    inline = [
      "set -e",
      "cloud-init status --wait >/dev/null 2>&1 || true",
      "sudo sh -c 'mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz'",
      "sudo sh -c 'printf '\\''%s\\n'\\'' '\\''10.66.0.20 api'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'",
      "sudo sh -c '(\nset -eu\nisoloom_changed() {\n  echo \"isoloom: changed $*\"\n  if [ -n \"$${ISOLOOM_CHANGED:-}\" ]; then\n    mkdir -p \"$${ISOLOOM_CHANGED%/*}\" && : >\"$ISOLOOM_CHANGED\"\n  fi\n}\nisoloom_fail() {\n  echo \"isoloom: $*\" >&2\n  return 1\n}\nisoloom_pm() {\n  for _pm in apt-get dnf yum apk; do\n    if command -v \"$_pm\" >/dev/null 2>&1; then\n      echo \"$${_pm%-get}\"\n      return 0\n    fi\n  done\n  isoloom_fail \"no package manager Isoloom knows (apt-get, dnf, yum, apk)\"\n}\nisoloom_installed() {\n  _name=$${2%%=*}\n  _version=\n  case $2 in *=*) _version=$${2#*=} ;; esac\n  case $1 in\n    apt)\n      # shellcheck disable=SC2016 # dpkg-query'\\''s own fields, not the shell'\\''s.\n      _have=$(dpkg-query -W -f='\\''$${Status} $${Version}'\\'' \"$_name\" 2>/dev/null) || return 1\n      case $_have in \"install ok installed \"*) ;; *) return 1 ;; esac\n      [ -z \"$_version\" ] || [ \"$${_have#install ok installed }\" = \"$_version\" ]\n      ;;\n    dnf | yum)\n      if [ -z \"$_version\" ]; then\n        rpm -q --whatprovides \"$_name\" >/dev/null 2>&1\n      else\n        rpm -q \"$_name-$_version\" >/dev/null 2>&1\n      fi\n      ;;\n    apk)\n      if [ -z \"$_version\" ]; then\n        apk info -e \"$_name\" >/dev/null 2>&1\n      else\n        apk list --installed \"$_name\" 2>/dev/null | grep -q \"^$_name-$_version \"\n      fi\n      ;;\n    *) return 1 ;;\n  esac\n}\nisoloom_install() {\n  _pm=$1\n  shift\n  case $_pm in\n    apt)\n      apt-get update -qq &&\n        DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends \"$@\" >/dev/null &&\n        apt-get clean && rm -rf /var/lib/apt/lists/*\n      ;;\n    dnf | yum)\n      for _spec do\n        shift\n        case $_spec in\n          *=*) set -- \"$@\" \"$${_spec%%=*}-$${_spec#*=}\" ;;\n          *) set -- \"$@\" \"$_spec\" ;;\n        esac\n      done\n      \"$_pm\" install -y -q \"$@\" >/dev/null && \"$_pm\" clean all >/dev/null\n      ;;\n    apk) apk add --no-cache -q \"$@\" ;;\n    *) return 1 ;;\n  esac\n}\nisoloom_packages() {\n  _pm=$(isoloom_pm) || return 1\n  for _spec do\n    shift\n    isoloom_installed \"$_pm\" \"$_spec\" || set -- \"$@\" \"$_spec\"\n  done\n  [ \"$#\" -eq 0 ] && return 0\n  isoloom_install \"$_pm\" \"$@\" || isoloom_fail \"installing $* failed\" || return 1\n  isoloom_changed \"packages $*\"\n}\nisoloom_need() {\n  _cmd=$1\n  shift\n  command -v \"$_cmd\" >/dev/null 2>&1 && return 0\n  _pm=$(isoloom_pm) || return 1\n  isoloom_install \"$_pm\" \"$@\" || isoloom_fail \"installing $* (for $_cmd) failed\" || return 1\n  isoloom_changed \"packages $*\"\n}\nisoloom_sha256() {\n  sha256sum \"$1\" | cut -d '\\'' '\\'' -f 1\n}\nisoloom_fetch() {\n  if ! command -v curl >/dev/null 2>&1 && command -v wget >/dev/null 2>&1; then\n    wget -q -O \"$2\" \"$1\"\n    return\n  fi\n  isoloom_need curl curl ca-certificates || return 1\n  if [ ! -s /etc/ssl/certs/ca-certificates.crt ] && [ ! -s /etc/pki/tls/certs/ca-bundle.crt ]; then\n    _pm=$(isoloom_pm) || return 1\n    isoloom_install \"$_pm\" ca-certificates || isoloom_fail \"installing ca-certificates failed\" || return 1\n    isoloom_changed \"packages ca-certificates\"\n  fi\n  curl -fsSL --retry 3 -o \"$2\" \"$1\"\n}\nisoloom_put() {\n  if [ -f \"$2\" ] && [ ! -L \"$2\" ] && [ \"$(isoloom_sha256 \"$1\")\" = \"$(isoloom_sha256 \"$2\")\" ]; then\n    return 0\n  fi\n  mkdir -p \"$(dirname \"$2\")\" && rm -rf \"$2\" && cp \"$1\" \"$2\" || isoloom_fail \"writing $2 failed\" || return 1\n  isoloom_changed \"$2\"\n}\nisoloom_download() {\n  if [ -f \"$2\" ] && [ \"$(isoloom_sha256 \"$2\")\" = \"$3\" ]; then\n    return 0\n  fi\n  mkdir -p \"$(dirname \"$2\")\" || return 1\n  _tmp=\"$2.isoloom-download\"\n  isoloom_fetch \"$1\" \"$_tmp\" || {\n    rm -f \"$_tmp\"\n    isoloom_fail \"downloading $1 failed\"\n    return 1\n  }\n  _got=$(isoloom_sha256 \"$_tmp\")\n  if [ \"$_got\" != \"$3\" ]; then\n    rm -f \"$_tmp\"\n    isoloom_fail \"$1 has SHA-256 $_got, not $3: the file changed upstream, or the pin is wrong\"\n    return 1\n  fi\n  mv -f \"$_tmp\" \"$2\" && isoloom_changed \"$2\"\n}\nisoloom_attrs() {\n  _owner=$2\n  _group=$3\n  if [ -n \"$_owner\" ] && [ -z \"$_group\" ]; then\n    _group=$(id -gn \"$_owner\") || return 1\n  fi\n  if [ -n \"$_owner\" ] && [ \"$(stat -c %U \"$1\")\" != \"$_owner\" ]; then\n    chown -h \"$_owner\" \"$1\" || return 1\n    isoloom_changed \"owner of $1\"\n  fi\n  if [ -n \"$_group\" ] && [ \"$(stat -c %G \"$1\")\" != \"$_group\" ]; then\n    chgrp -h \"$_group\" \"$1\" || return 1\n    isoloom_changed \"group of $1\"\n  fi\n  if [ -n \"$4\" ]; then\n    _want=$${4#\"$${4%%[!0]*}\"}\n    if [ \"$(stat -c %a \"$1\")\" != \"$${_want:-0}\" ]; then\n      chmod \"$4\" \"$1\" || return 1\n      isoloom_changed \"mode of $1\"\n    fi\n  fi\n}\nisoloom_copy() {\n  case $1 in\n    */) ;;\n    *)\n      isoloom_put \"$1\" \"$2\" && isoloom_attrs \"$2\" \"$3\" \"$4\" \"$5\"\n      return\n      ;;\n  esac\n  [ -d \"$1\" ] || isoloom_fail \"$1 is no folder\" || return 1\n  if [ ! -d \"$2\" ]; then\n    mkdir -p \"$2\" || return 1\n    isoloom_changed \"$2\"\n  fi\n  (cd \"$1\" && find . -mindepth 1) | while IFS= read -r _entry; do\n    _from=\"$1/$${_entry#./}\"\n    _to=\"$${2%/}/$${_entry#./}\"\n    if [ -d \"$_from\" ] && [ ! -L \"$_from\" ]; then\n      if [ ! -d \"$_to\" ]; then\n        mkdir -p \"$_to\" || exit 1\n        isoloom_changed \"$_to\"\n      fi\n    else\n      isoloom_put \"$_from\" \"$_to\" || exit 1\n    fi\n    isoloom_attrs \"$_to\" \"$3\" \"$4\" \"$5\" || exit 1\n  done\n}\nisoloom_template() {\n  _tmp=$(mktemp) || return 1\n  printf '\\''%s'\\'' \"$5\" | base64 -d >\"$_tmp\" && isoloom_copy \"$_tmp\" \"$1\" \"$2\" \"$3\" \"$4\"\n  _status=$?\n  rm -f \"$_tmp\"\n  return \"$_status\"\n}\nisoloom_file() {\n  _path=$1 _file_owner=$2 _file_group=$3 _file_mode=$4 _state=$5\n  shift 5\n  case $_state in\n    directory)\n      if [ ! -d \"$_path\" ] || [ -L \"$_path\" ]; then\n        rm -rf \"$_path\" && mkdir -p \"$_path\" || return 1\n        isoloom_changed \"$_path\"\n      fi\n      ;;\n    absent)\n      if [ -e \"$_path\" ] || [ -L \"$_path\" ]; then\n        rm -rf \"$_path\" || return 1\n        isoloom_changed \"$_path removed\"\n      fi\n      return 0\n      ;;\n    link)\n      if [ ! -L \"$_path\" ] || [ \"$(readlink \"$_path\")\" != \"$1\" ]; then\n        mkdir -p \"$(dirname \"$_path\")\" && rm -rf \"$_path\" && ln -s \"$1\" \"$_path\" || return 1\n        isoloom_changed \"$_path\"\n      fi\n      ;;\n    download) isoloom_download \"$1\" \"$_path\" \"$2\" || return 1 ;;\n    *) isoloom_fail \"no file state $_state\" || return 1 ;;\n  esac\n  isoloom_attrs \"$_path\" \"$_file_owner\" \"$_file_group\" \"$_file_mode\"\n}\nisoloom_accounts() {\n  isoloom_need useradd shadow\n}\nisoloom_group() {\n  isoloom_accounts || return 1\n  _name=$1 _gid=$2 _system=$3\n  if _entry=$(getent group \"$_name\"); then\n    if [ -n \"$_gid\" ] && [ \"$(echo \"$_entry\" | cut -d : -f 3)\" != \"$_gid\" ]; then\n      groupmod -g \"$_gid\" \"$_name\" || return 1\n      isoloom_changed \"gid of $_name\"\n    fi\n    return 0\n  fi\n  set --\n  [ -z \"$_gid\" ] || set -- -g \"$_gid\"\n  [ \"$_system\" != yes ] || set -- \"$@\" -r\n  groupadd \"$@\" \"$_name\" || return 1\n  isoloom_changed \"group $_name\"\n}\nisoloom_passwd_field() {\n  getent passwd \"$1\" | cut -d : -f \"$2\"\n}\nisoloom_user() {\n  isoloom_accounts || return 1\n  _user=$1 _uid=$2 _group=$3 _groups=$4 _home=$5 _shell=$6 _system=$7 _hash=$8\n  if getent passwd \"$_user\" >/dev/null; then\n    isoloom_user_fields || return 1\n  else\n    set --\n    [ -z \"$_uid\" ] || set -- \"$@\" -u \"$_uid\"\n    [ -z \"$_group\" ] || set -- \"$@\" -g \"$_group\"\n    [ -z \"$_groups\" ] || set -- \"$@\" -G \"$_groups\"\n    [ -z \"$_home\" ] || set -- \"$@\" -d \"$_home\"\n    [ -z \"$_shell\" ] || set -- \"$@\" -s \"$_shell\"\n    if [ \"$_system\" = yes ]; then set -- \"$@\" -r; else set -- \"$@\" -m; fi\n    useradd \"$@\" \"$_user\" || return 1\n    isoloom_changed \"user $_user\"\n  fi\n  [ -n \"$_hash\" ] || return 0\n  [ \"$(awk -F : -v u=\"$_user\" '\\''$1 == u { print $2 }'\\'' /etc/shadow)\" = \"$_hash\" ] && return 0\n  printf '\\''%s:%s\\n'\\'' \"$_user\" \"$_hash\" | chpasswd -e || return 1\n  isoloom_changed \"password of $_user\"\n}\nisoloom_user_fields() {\n  if [ -n \"$_uid\" ] && [ \"$(id -u \"$_user\")\" != \"$_uid\" ]; then\n    usermod -u \"$_uid\" \"$_user\" || return 1\n    isoloom_changed \"uid of $_user\"\n  fi\n  if [ -n \"$_group\" ] && [ \"$(id -gn \"$_user\")\" != \"$_group\" ]; then\n    usermod -g \"$_group\" \"$_user\" || return 1\n    isoloom_changed \"group of $_user\"\n  fi\n  if [ -n \"$_home\" ] && [ \"$(isoloom_passwd_field \"$_user\" 6)\" != \"$_home\" ]; then\n    usermod -d \"$_home\" \"$_user\" || return 1\n    isoloom_changed \"home of $_user\"\n  fi\n  if [ -n \"$_shell\" ] && [ \"$(isoloom_passwd_field \"$_user\" 7)\" != \"$_shell\" ]; then\n    usermod -s \"$_shell\" \"$_user\" || return 1\n    isoloom_changed \"shell of $_user\"\n  fi\n  _rest=$_groups\n  while [ -n \"$_rest\" ]; do\n    _g=$${_rest%%,*}\n    case $_rest in *,*) _rest=$${_rest#*,} ;; *) _rest= ;; esac\n    id -nG \"$_user\" | tr '\\'' '\\'' '\\''\\n'\\'' | grep -qxF \"$_g\" && continue\n    usermod -a -G \"$_g\" \"$_user\" || return 1\n    isoloom_changed \"$_user in $_g\"\n  done\n}\nisoloom_restart_due() {\n  [ -n \"$${ISOLOOM_CHANGED:-}\" ] && [ -e \"$ISOLOOM_CHANGED\" ]\n}\nisoloom_service() {\n  if [ -d /run/systemd/system ]; then\n    isoloom_systemd \"$@\"\n  elif command -v rc-service >/dev/null 2>&1 && [ -d /run/openrc ]; then\n    isoloom_openrc \"$@\"\n  else\n    echo \"isoloom: no init system runs here: $1 is left to the container'\\''s runner\"\n  fi\n}\nisoloom_systemd() {\n  if [ \"$2\" = no ]; then\n    if systemctl is-enabled --quiet \"$1\" 2>/dev/null; then\n      systemctl disable --quiet \"$1\" || return 1\n      isoloom_changed \"$1 disabled\"\n    fi\n    if systemctl is-active --quiet \"$1\"; then\n      systemctl stop \"$1\" || return 1\n      isoloom_changed \"$1 stopped\"\n    fi\n    return 0\n  fi\n  if ! systemctl is-enabled --quiet \"$1\" 2>/dev/null; then\n    systemctl enable --quiet \"$1\" || return 1\n    isoloom_changed \"$1 enabled\"\n  fi\n  if ! systemctl is-active --quiet \"$1\"; then\n    systemctl start \"$1\" && isoloom_changed \"$1 started\"\n  elif isoloom_restart_due; then\n    systemctl restart \"$1\" && echo \"isoloom: restarted $1\"\n  fi\n}\nisoloom_openrc() {\n  _enabled=$(rc-update show default | awk -v u=\"$1\" '\\''$1 == u { print \"yes\" }'\\'')\n  if [ \"$2\" = no ]; then\n    if [ -n \"$_enabled\" ]; then\n      rc-update -q del \"$1\" default || return 1\n      isoloom_changed \"$1 disabled\"\n    fi\n    if rc-service -q \"$1\" status >/dev/null 2>&1; then\n      rc-service -q \"$1\" stop || return 1\n      isoloom_changed \"$1 stopped\"\n    fi\n    return 0\n  fi\n  if [ -z \"$_enabled\" ]; then\n    rc-update -q add \"$1\" default || return 1\n    isoloom_changed \"$1 enabled\"\n  fi\n  if ! rc-service -q \"$1\" status >/dev/null 2>&1; then\n    rc-service -q \"$1\" start && isoloom_changed \"$1 started\"\n  elif isoloom_restart_due; then\n    rc-service -q \"$1\" restart && echo \"isoloom: restarted $1\"\n  fi\n}\nisoloom_firewall() {\n  if command -v firewall-cmd >/dev/null 2>&1 && firewall-cmd --state >/dev/null 2>&1; then\n    for _port do\n      firewall-cmd -q --permanent --query-port=\"$_port\" && continue\n      firewall-cmd -q --permanent --add-port=\"$_port\" || return 1\n      firewall-cmd -q --add-port=\"$_port\" || return 1\n      isoloom_changed \"firewall $_port\"\n    done\n  elif command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q '\\''^Status: active'\\''; then\n    for _port do\n      ufw status | grep -Eq \"^$${_port}[[:space:]]+ALLOW\" && continue\n      ufw allow \"$_port\" >/dev/null || return 1\n      isoloom_changed \"firewall $_port\"\n    done\n  fi\n}\nisoloom_first() {\n  _n=$1\n  shift\n  _i=0\n  for _arg do\n    shift\n    if [ \"$_i\" -lt \"$_n\" ]; then set -- \"$@\" \"$_arg\"; fi\n    _i=$((_i + 1))\n  done\n  \"$@\"\n}\nisoloom_command() {\n  _guard=$1 _n=$2\n  shift 2\n  case $_guard in\n    creates) [ -e \"$1\" ] && return 0 ;;\n    unless) (isoloom_first \"$_n\" \"$@\") >/dev/null 2>&1 && return 0 ;;\n    *) isoloom_fail \"no guard $_guard\" || return 1 ;;\n  esac\n  shift \"$_n\"\n  \"$@\" || isoloom_fail \"the command $1 failed\" || return 1\n  isoloom_changed \"command $1\"\n}\nISOLOOM_CHANGED=/run/isoloom/configure.changed\nrm -f \"$ISOLOOM_CHANGED\"\ncd /opt/isoloom\nisoloom_packages '\\''nginx'\\''\nisoloom_group '\\''site'\\'' '\\''1600'\\'' '\\''no'\\''\n# shellcheck disable=SC2016\nisoloom_user '\\''editor'\\'' '\\''1600'\\'' '\\''site'\\'' '\\'''\\'' '\\'''\\'' '\\''/bin/sh'\\'' '\\''no'\\'' '\\''$6$akm4bzmJ7GlLE7UB$iaxzuoGRSRy0UV8V28D56kUKxpiLRxOC7GcBI.g0iz/23oN22qBZZlH1YNPS66l1mSQGgZjLHu0CtZiyATN2/.'\\''\nisoloom_file '\\''/srv/site'\\'' '\\''editor'\\'' '\\'''\\'' '\\''0755'\\'' '\\''directory'\\''\nisoloom_copy '\\''site/'\\'' '\\''/srv/site/'\\'' '\\''editor'\\'' '\\'''\\'' '\\'''\\''\nisoloom_template '\\''/etc/nginx/conf.d/site.conf'\\'' '\\'''\\'' '\\'''\\'' '\\''0644'\\'' '\\''IyBUaGUgc2l0ZSwgZmlsbGVkIGluIGJ5IElzb2xvb20gZm9yIHdlYiAoMTAuNjYuMC4xMCkuCnNlcnZlciB7CiAgICBsaXN0ZW4gODAgZGVmYXVsdF9zZXJ2ZXI7CiAgICByb290IC9zcnYvc2l0ZTsKICAgIGluZGV4IGluZGV4Lmh0bWw7CiAgICBsb2NhdGlvbiAvYXBpLyB7CiAgICAgICAgcHJveHlfcGFzcyBodHRwOi8vMTAuNjYuMC4yMDo4MDgwLzsKICAgIH0KfQo='\\''\nisoloom_file '\\''/etc/nginx/sites-enabled/default'\\'' '\\'''\\'' '\\'''\\'' '\\'''\\'' '\\''absent'\\''\nisoloom_command '\\''creates'\\'' '\\''1'\\'' '\\''/srv/site/stamp.txt'\\'' '\\''sh'\\'' '\\''-c'\\'' '\\''echo configured > /srv/site/stamp.txt'\\''\nisoloom_firewall '\\''80/tcp'\\''\nisoloom_service '\\''nginx'\\'' '\\''yes'\\''\n)'",
      "command -v nft >/dev/null || (sudo apt-get update -qq && sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq nftables)",
      "sudo nft add table ip isoloom-publish && sudo nft 'add chain ip isoloom-publish prerouting { type nat hook prerouting priority -100; }' && sudo nft add rule ip isoloom-publish prerouting tcp dport 8086 redirect to :80",
      "sudo sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'"
    ]
  }
}

# Machine `api`, at its fixed address 10.66.0.20.
resource "oci_core_instance" "api" {
  compartment_id      = var.compartment_id
  freeform_tags       = local.tags
  availability_domain = data.oci_identity_availability_domains.ads.availability_domains[0].name
  display_name        = "${local.name}-api"
  shape               = "VM.Standard.E4.Flex"
  shape_config {
    ocpus         = 1
    memory_in_gbs = 1
  }
  source_details {
    source_type             = "image"
    source_id               = data.oci_core_images.ubuntu_2404.images[0].id
    boot_volume_size_in_gbs = 50
  }
  create_vnic_details {
    subnet_id              = oci_core_subnet.lab.id
    private_ip             = "10.66.0.20"
    assign_public_ip       = true
    hostname_label         = "api"
    skip_source_dest_check = false
  }
  metadata = {
    ssh_authorized_keys = var.ssh_public_key
    user_data           = base64encode(var.auto_stop_minutes > 0 ? "#!/bin/sh\nshutdown -h +${var.auto_stop_minutes}\n" : "#!/bin/sh\n")
  }
}

resource "terraform_data" "api" {
  triggers_replace = [oci_core_instance.api.id]
  connection {
    type        = "ssh"
    host        = oci_core_instance.api.public_ip
    user        = "ubuntu"
    private_key = file(pathexpand(var.ssh_private_key_file))
    timeout     = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-api.tgz\" --exclude=.git --exclude=.vagrant --exclude=.terraform --exclude=.isoloom-project* -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-api.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "remote-exec" {
    inline = [
      "set -e",
      "cloud-init status --wait >/dev/null 2>&1 || true",
      "sudo sh -c 'mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz'",
      "sudo sh -c 'printf '\\''%s\\n'\\'' '\\''10.66.0.10 web'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'",
      "sudo sh -c '(\nset -eu\nisoloom_changed() {\n  echo \"isoloom: changed $*\"\n  if [ -n \"$${ISOLOOM_CHANGED:-}\" ]; then\n    mkdir -p \"$${ISOLOOM_CHANGED%/*}\" && : >\"$ISOLOOM_CHANGED\"\n  fi\n}\nisoloom_fail() {\n  echo \"isoloom: $*\" >&2\n  return 1\n}\nisoloom_pm() {\n  for _pm in apt-get dnf yum apk; do\n    if command -v \"$_pm\" >/dev/null 2>&1; then\n      echo \"$${_pm%-get}\"\n      return 0\n    fi\n  done\n  isoloom_fail \"no package manager Isoloom knows (apt-get, dnf, yum, apk)\"\n}\nisoloom_installed() {\n  _name=$${2%%=*}\n  _version=\n  case $2 in *=*) _version=$${2#*=} ;; esac\n  case $1 in\n    apt)\n      # shellcheck disable=SC2016 # dpkg-query'\\''s own fields, not the shell'\\''s.\n      _have=$(dpkg-query -W -f='\\''$${Status} $${Version}'\\'' \"$_name\" 2>/dev/null) || return 1\n      case $_have in \"install ok installed \"*) ;; *) return 1 ;; esac\n      [ -z \"$_version\" ] || [ \"$${_have#install ok installed }\" = \"$_version\" ]\n      ;;\n    dnf | yum)\n      if [ -z \"$_version\" ]; then\n        rpm -q --whatprovides \"$_name\" >/dev/null 2>&1\n      else\n        rpm -q \"$_name-$_version\" >/dev/null 2>&1\n      fi\n      ;;\n    apk)\n      if [ -z \"$_version\" ]; then\n        apk info -e \"$_name\" >/dev/null 2>&1\n      else\n        apk list --installed \"$_name\" 2>/dev/null | grep -q \"^$_name-$_version \"\n      fi\n      ;;\n    *) return 1 ;;\n  esac\n}\nisoloom_install() {\n  _pm=$1\n  shift\n  case $_pm in\n    apt)\n      apt-get update -qq &&\n        DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends \"$@\" >/dev/null &&\n        apt-get clean && rm -rf /var/lib/apt/lists/*\n      ;;\n    dnf | yum)\n      for _spec do\n        shift\n        case $_spec in\n          *=*) set -- \"$@\" \"$${_spec%%=*}-$${_spec#*=}\" ;;\n          *) set -- \"$@\" \"$_spec\" ;;\n        esac\n      done\n      \"$_pm\" install -y -q \"$@\" >/dev/null && \"$_pm\" clean all >/dev/null\n      ;;\n    apk) apk add --no-cache -q \"$@\" ;;\n    *) return 1 ;;\n  esac\n}\nisoloom_packages() {\n  _pm=$(isoloom_pm) || return 1\n  for _spec do\n    shift\n    isoloom_installed \"$_pm\" \"$_spec\" || set -- \"$@\" \"$_spec\"\n  done\n  [ \"$#\" -eq 0 ] && return 0\n  isoloom_install \"$_pm\" \"$@\" || isoloom_fail \"installing $* failed\" || return 1\n  isoloom_changed \"packages $*\"\n}\nisoloom_sha256() {\n  sha256sum \"$1\" | cut -d '\\'' '\\'' -f 1\n}\nisoloom_put() {\n  if [ -f \"$2\" ] && [ ! -L \"$2\" ] && [ \"$(isoloom_sha256 \"$1\")\" = \"$(isoloom_sha256 \"$2\")\" ]; then\n    return 0\n  fi\n  mkdir -p \"$(dirname \"$2\")\" && rm -rf \"$2\" && cp \"$1\" \"$2\" || isoloom_fail \"writing $2 failed\" || return 1\n  isoloom_changed \"$2\"\n}\nisoloom_text() {\n  _tmp=$(mktemp) || return 1\n  printf '\\''%s'\\'' \"$2\" >\"$_tmp\" && isoloom_put \"$_tmp\" \"$1\"\n  _status=$?\n  rm -f \"$_tmp\"\n  return \"$_status\"\n}\nisoloom_attrs() {\n  _owner=$2\n  _group=$3\n  if [ -n \"$_owner\" ] && [ -z \"$_group\" ]; then\n    _group=$(id -gn \"$_owner\") || return 1\n  fi\n  if [ -n \"$_owner\" ] && [ \"$(stat -c %U \"$1\")\" != \"$_owner\" ]; then\n    chown -h \"$_owner\" \"$1\" || return 1\n    isoloom_changed \"owner of $1\"\n  fi\n  if [ -n \"$_group\" ] && [ \"$(stat -c %G \"$1\")\" != \"$_group\" ]; then\n    chgrp -h \"$_group\" \"$1\" || return 1\n    isoloom_changed \"group of $1\"\n  fi\n  if [ -n \"$4\" ]; then\n    _want=$${4#\"$${4%%[!0]*}\"}\n    if [ \"$(stat -c %a \"$1\")\" != \"$${_want:-0}\" ]; then\n      chmod \"$4\" \"$1\" || return 1\n      isoloom_changed \"mode of $1\"\n    fi\n  fi\n}\nisoloom_copy() {\n  case $1 in\n    */) ;;\n    *)\n      isoloom_put \"$1\" \"$2\" && isoloom_attrs \"$2\" \"$3\" \"$4\" \"$5\"\n      return\n      ;;\n  esac\n  [ -d \"$1\" ] || isoloom_fail \"$1 is no folder\" || return 1\n  if [ ! -d \"$2\" ]; then\n    mkdir -p \"$2\" || return 1\n    isoloom_changed \"$2\"\n  fi\n  (cd \"$1\" && find . -mindepth 1) | while IFS= read -r _entry; do\n    _from=\"$1/$${_entry#./}\"\n    _to=\"$${2%/}/$${_entry#./}\"\n    if [ -d \"$_from\" ] && [ ! -L \"$_from\" ]; then\n      if [ ! -d \"$_to\" ]; then\n        mkdir -p \"$_to\" || exit 1\n        isoloom_changed \"$_to\"\n      fi\n    else\n      isoloom_put \"$_from\" \"$_to\" || exit 1\n    fi\n    isoloom_attrs \"$_to\" \"$3\" \"$4\" \"$5\" || exit 1\n  done\n}\nisoloom_restart_due() {\n  [ -n \"$${ISOLOOM_CHANGED:-}\" ] && [ -e \"$ISOLOOM_CHANGED\" ]\n}\nisoloom_unit() {\n  case $2 in\n    '\\''#!/sbin/openrc-run'\\''*)\n      isoloom_text \"/etc/init.d/$1\" \"$2\" && isoloom_attrs \"/etc/init.d/$1\" root root 0755\n      ;;\n    *)\n      _unit=/etc/systemd/system/$1.service\n      _old=\n      [ ! -f \"$_unit\" ] || _old=$(isoloom_sha256 \"$_unit\")\n      isoloom_text \"$_unit\" \"$2\" || return 1\n      if [ \"$_old\" != \"$(isoloom_sha256 \"$_unit\")\" ] && [ -d /run/systemd/system ]; then\n        systemctl daemon-reload\n      fi\n      ;;\n  esac\n}\nisoloom_service() {\n  if [ -d /run/systemd/system ]; then\n    isoloom_systemd \"$@\"\n  elif command -v rc-service >/dev/null 2>&1 && [ -d /run/openrc ]; then\n    isoloom_openrc \"$@\"\n  else\n    echo \"isoloom: no init system runs here: $1 is left to the container'\\''s runner\"\n  fi\n}\nisoloom_systemd() {\n  if [ \"$2\" = no ]; then\n    if systemctl is-enabled --quiet \"$1\" 2>/dev/null; then\n      systemctl disable --quiet \"$1\" || return 1\n      isoloom_changed \"$1 disabled\"\n    fi\n    if systemctl is-active --quiet \"$1\"; then\n      systemctl stop \"$1\" || return 1\n      isoloom_changed \"$1 stopped\"\n    fi\n    return 0\n  fi\n  if ! systemctl is-enabled --quiet \"$1\" 2>/dev/null; then\n    systemctl enable --quiet \"$1\" || return 1\n    isoloom_changed \"$1 enabled\"\n  fi\n  if ! systemctl is-active --quiet \"$1\"; then\n    systemctl start \"$1\" && isoloom_changed \"$1 started\"\n  elif isoloom_restart_due; then\n    systemctl restart \"$1\" && echo \"isoloom: restarted $1\"\n  fi\n}\nisoloom_openrc() {\n  _enabled=$(rc-update show default | awk -v u=\"$1\" '\\''$1 == u { print \"yes\" }'\\'')\n  if [ \"$2\" = no ]; then\n    if [ -n \"$_enabled\" ]; then\n      rc-update -q del \"$1\" default || return 1\n      isoloom_changed \"$1 disabled\"\n    fi\n    if rc-service -q \"$1\" status >/dev/null 2>&1; then\n      rc-service -q \"$1\" stop || return 1\n      isoloom_changed \"$1 stopped\"\n    fi\n    return 0\n  fi\n  if [ -z \"$_enabled\" ]; then\n    rc-update -q add \"$1\" default || return 1\n    isoloom_changed \"$1 enabled\"\n  fi\n  if ! rc-service -q \"$1\" status >/dev/null 2>&1; then\n    rc-service -q \"$1\" start && isoloom_changed \"$1 started\"\n  elif isoloom_restart_due; then\n    rc-service -q \"$1\" restart && echo \"isoloom: restarted $1\"\n  fi\n}\nISOLOOM_CHANGED=/run/isoloom/configure.changed\nrm -f \"$ISOLOOM_CHANGED\"\ncd /opt/isoloom\nisoloom_packages '\\''python3'\\''\nisoloom_copy '\\''api/'\\'' '\\''/srv/api/'\\'' '\\'''\\'' '\\'''\\'' '\\'''\\''\nisoloom_unit '\\''api-status'\\'' '\\''[Unit]\nDescription=api-status, defined by Isoloom\nWants=network-online.target\nAfter=network-online.target\n\n[Service]\nExecStart=\"python3\" \"-m\" \"http.server\" \"8080\" \"--directory\" \"/srv/api\"\nUser=nobody\nRestart=on-failure\n\n[Install]\nWantedBy=multi-user.target\n'\\''\nisoloom_service '\\''api-status'\\'' '\\''yes'\\''\nisoloom_unit '\\''api-health'\\'' '\\''[Unit]\nDescription=api-health, defined by Isoloom\nWants=network-online.target\nAfter=network-online.target\n\n[Service]\nExecStart=\"python3\" \"-m\" \"http.server\" \"8081\" \"--directory\" \"/srv/api\"\nWorkingDirectory=/srv/api\nRestart=on-failure\n\n[Install]\nWantedBy=multi-user.target\n'\\''\nisoloom_service '\\''api-health'\\'' '\\''yes'\\''\n)'",
      "sudo sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'"
    ]
  }
}

output "machines" {
  value = { web = oci_core_instance.web.public_ip, api = oci_core_instance.api.public_ip }
}

output "ssh_users" {
  value = { web = "ubuntu", api = "ubuntu" }
}

output "ip" {
  value = oci_core_instance.web.public_ip
}

output "ready_file" {
  value = "/var/lib/isoloom/ready"
}

# The checks: each runner on the machine it stands for (ssh <user>@<host> '<command>'), or `isoloom test cloud-vm`.
output "checks" {
  value = [
    {
      position = "web"
      machine  = "web"
      host     = oci_core_instance.web.public_ip
      user     = "ubuntu"
      command  = "cd /opt/isoloom && sh .isoloom/cloud-vm/checks/web.sh"
    },
    {
      position = "api"
      machine  = "api"
      host     = oci_core_instance.api.public_ip
      user     = "ubuntu"
      command  = "cd /opt/isoloom && sh .isoloom/cloud-vm/checks/api.sh"
    }
  ]
}

output "published" {
  value = { "web/http" = "${oci_core_instance.web.public_ip}:8086" }
}

# The project's files the machines don't get: version control and the tools' state, and what
# .isoloomignore at the project's root lists (gitignore-style: one pattern per line, `#` comments,
# `!` brings a path back, a trailing `/` matches folders only, a `/` at the start or in the middle
# anchors the pattern at the root; `*`, `?`, `[abc]`, `**`; the last pattern matching a path, or
# a folder it is in, decides). Read as regular expressions, as the Vagrantfiles do.
locals {
  project_ignore_lines = [for l in split("\n", replace(try(file("${local.root}/.isoloomignore"), ""), "\r", "")) : trimspace(l)]
  project_ignore_pats  = [for l in local.project_ignore_lines : { keep = startswith(l, "!"), pat = trimprefix(l, "!") } if l != "" && !startswith(l, "#")]
  project_ignore_globs = [for r in local.project_ignore_pats : merge(r, { glob = trimsuffix(trimsuffix(trimsuffix(r.pat, "/"), "/**"), "/") })]
  project_ignore = [for r in local.project_ignore_globs : {
    keep = r.keep
    re = format(r.glob == r.pat ? "^%s(/|$)" : "^%s/", replace(replace(replace(replace(replace(replace(replace(replace(
      length(split("/", r.glob)) > 1 ? trimprefix(r.glob, "/") : "**/${r.glob}",
    "/[.+^$(){}|\\\\]/", "\\$0"), "[!", "[^"), "**/", "\u0001"), "**", "\u0002"), "*", "[^/]*"), "?", "[^/]"), "\u0001", "(.*/)?"), "\u0002", ".*"))
  } if r.glob != ""]
  # Each file: whether it goes (the last matching pattern decides; none: it goes).
  project_keep    = { for f in fileset(local.root, "**") : f => reverse(concat([true], [for r in local.project_ignore : r.keep if length(regexall(r.re, f)) > 0]))[0] }
  project_ignored = [for f, keep in local.project_keep : f if !keep]
}

# What `tar` leaves out of the project's archive: .isoloomignore's files, from the archive's top
# folder, their wildcard characters escaped.
resource "local_file" "isoloom_project" {
  filename = "${path.module}/.isoloom-project-ignored.txt"
  content  = join("", [for f in local.project_ignored : "${replace("${basename(local.root)}/${f}", "/[\\\\*?\\[]/", "\\$0")}\n"])
}

## .isoloom/configure/lib/configure.sh: identical in the `docker` snapshot

## .isoloom/resolved.json: identical in the `docker` snapshot
