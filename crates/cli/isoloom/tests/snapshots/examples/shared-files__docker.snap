name: shared-files
services:
  writer:
    image: debian:12@sha256:2c037a04925515fdd6ea85ea14a682d0e79931f5e9f5d07b6dbfc6ba12f9e858
    init: true
    entrypoint:
    - sleep
    - infinity
    hostname: writer
    networks:
      app:
        ipv4_address: 10.84.0.10
    volumes:
    - shared:/srv/shared
    - writer-data:/srv/data
    labels:
      isoloom.managed: 'true'
      isoloom.environment: shared-files
    restart: unless-stopped
  isoloom-init-writer-1:
    image: debian:12@sha256:2c037a04925515fdd6ea85ea14a682d0e79931f5e9f5d07b6dbfc6ba12f9e858
    user: root
    entrypoint:
    - /bin/sh
    - /isoloom/init/write.sh
    network_mode: service:writer
    volumes:
    - ../../steps/write.sh:/isoloom/init/write.sh:ro,z
    - ../..:/opt/isoloom:ro,z
    - shared:/srv/shared
    - writer-data:/srv/data
    depends_on:
      writer:
        condition: service_started
    labels:
      isoloom.managed: 'true'
      isoloom.environment: shared-files
    restart: no
  reader:
    image: debian:12@sha256:2c037a04925515fdd6ea85ea14a682d0e79931f5e9f5d07b6dbfc6ba12f9e858
    init: true
    entrypoint:
    - sleep
    - infinity
    hostname: reader
    networks:
      app:
        ipv4_address: 10.84.0.11
    volumes:
    - shared:/data/shared
    labels:
      isoloom.managed: 'true'
      isoloom.environment: shared-files
    restart: unless-stopped
  isoloom-init-reader-1:
    image: debian:12@sha256:2c037a04925515fdd6ea85ea14a682d0e79931f5e9f5d07b6dbfc6ba12f9e858
    user: root
    entrypoint:
    - /bin/sh
    - /isoloom/init/look.sh
    network_mode: service:reader
    volumes:
    - ../../steps/look.sh:/isoloom/init/look.sh:ro,z
    - ../..:/opt/isoloom:ro,z
    - shared:/data/shared
    depends_on:
      reader:
        condition: service_started
    labels:
      isoloom.managed: 'true'
      isoloom.environment: shared-files
    restart: no
  isoloom-check-writer:
    image: curlimages/curl:8.22.0@sha256:58adaa4e8dca9c988bae2aba4ab3434a0bb2da16bbe3f92dec39ec7785166777
    profiles:
    - check
    entrypoint:
    - /bin/sh
    - /isoloom/run.sh
    network_mode: service:writer
    volumes:
    - ./checks/writer.sh:/isoloom/run.sh:ro,z
    depends_on:
      isoloom-init-writer-1:
        condition: service_completed_successfully
      isoloom-init-reader-1:
        condition: service_completed_successfully
      writer:
        condition: service_started
    labels:
      isoloom.managed: 'true'
      isoloom.environment: shared-files
  isoloom-check-reader:
    image: curlimages/curl:8.22.0@sha256:58adaa4e8dca9c988bae2aba4ab3434a0bb2da16bbe3f92dec39ec7785166777
    profiles:
    - check
    entrypoint:
    - /bin/sh
    - /isoloom/run.sh
    network_mode: service:reader
    volumes:
    - ./checks/reader.sh:/isoloom/run.sh:ro,z
    depends_on:
      isoloom-init-writer-1:
        condition: service_completed_successfully
      isoloom-init-reader-1:
        condition: service_completed_successfully
      reader:
        condition: service_started
    labels:
      isoloom.managed: 'true'
      isoloom.environment: shared-files
  isoloom-jobs-done:
    image: busybox:1.37.0-musl@sha256:f6a95d611e0a8780fabdb2aec43e31275b2720dfefa3e41b16835bfc42454478
    init: true
    entrypoint:
    - sleep
    - '2147483647'
    network_mode: none
    depends_on:
      isoloom-init-writer-1:
        condition: service_completed_successfully
      isoloom-init-reader-1:
        condition: service_completed_successfully
    labels:
      isoloom.managed: 'true'
      isoloom.environment: shared-files
    restart: unless-stopped
networks:
  app:
    ipam:
      config:
      - subnet: 10.84.0.0/24
        gateway: 10.84.0.1
    labels:
      isoloom.managed: 'true'
      isoloom.environment: shared-files
volumes:
  shared:
    labels:
      isoloom.managed: 'true'
      isoloom.environment: shared-files
  writer-data:
    labels:
      isoloom.managed: 'true'
      isoloom.environment: shared-files

