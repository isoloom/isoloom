## .isoloom/cloud-vm/gcp/main.tf
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  terraform -chdir=.isoloom/cloud-vm/gcp init && terraform -chdir=.isoloom/cloud-vm/gcp apply \
#           -var billing_account=<id> -var allowed_cidr=<your IP>/32 -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)"
# Stop:   terraform -chdir=.isoloom/cloud-vm/gcp destroy (same variables)
# Then:   the machines wait for the project: run the lab through the Isothrum runner (run.json
#         beside this file), which delivers the project over SSH, waits for each set-up and runs the checks.

terraform {
  required_version = ">= 1.6"
  backend "local" {}
  required_providers {
    google = { source = "hashicorp/google", version = "~> 8.5.0" }
  }
}

variable "project" {
  type        = string
  default     = ""
  description = "An existing project; or leave empty and give billing_account for a project of its own"
}

variable "billing_account" {
  type        = string
  default     = ""
  description = "With no project: create one for this environment, billed here, deleted with it"
}

variable "org_id" {
  type    = string
  default = ""
}

variable "region" {
  type    = string
  default = "europe-west9"
}

variable "inputs" {
  type        = map(string)
  default     = {}
  sensitive   = true
  description = "Values given at launch"
}

variable "allowed_cidr" {
  type        = string
  description = "Who may reach the machines (SSH and the published ports), e.g. your IP/32"
}

variable "ssh_public_key" {
  type        = string
  description = "The key the machines let in: the Isothrum runner's (it delivers the project and runs the checks over SSH)"
}

variable "expires_at" {
  type        = string
  default     = ""
  description = "When the environment should end, in Unix seconds (empty: no end): a tag on every resource, so a reaper finds what to destroy, and the time the machines shut themselves down"
}

provider "google" {
  region = var.region
}

# A project of its own when none is given: everything goes when the environment is destroyed.
resource "google_project" "env" {
  count               = var.project == "" ? 1 : 0
  name                = "isoloom-supplier-portal-api"
  project_id          = "isoloom-${terraform_data.id.output}"
  billing_account     = var.billing_account
  org_id              = var.org_id == "" ? null : var.org_id
  deletion_policy     = "DELETE"
  auto_create_network = false
}

resource "google_project_service" "compute" {
  count              = var.project == "" ? 1 : 0
  project            = google_project.env[0].project_id
  service            = "compute.googleapis.com"
  disable_on_destroy = false
}

resource "terraform_data" "id" {
  input = substr(replace(uuid(), "-", ""), 0, 8)
  lifecycle {
    ignore_changes = [input]
  }
}

locals {
  name    = "isoloom-supplier-portal-api-${terraform_data.id.output}"
  project = var.project != "" ? var.project : google_project_service.compute[0].project
  zone    = "${var.region}-a"
}

# The environment's networks: a VPC network each, holding a subnetwork with its exact range.
resource "google_compute_network" "lab" {
  project                 = local.project
  name                    = "${local.name}-lab"
  auto_create_subnetworks = false
  mtu                     = 1500
}

resource "google_compute_subnetwork" "lab" {
  project       = local.project
  name          = "${local.name}-lab"
  network       = google_compute_network.lab.id
  ip_cidr_range = "10.20.0.0/24"
  region        = var.region
}

# Machine `database`: what may reach it.
resource "google_compute_firewall" "database_net_lab" {
  project       = local.project
  name          = "${local.name}-database-net-lab"
  network       = google_compute_network.lab.id
  direction     = "INGRESS"
  source_ranges = ["10.20.0.0/24"]
  target_tags   = ["${local.name}-database"]
  allow {
    protocol = "all"
  }
}

resource "google_compute_firewall" "database_ssh" {
  project       = local.project
  name          = "${local.name}-database-ssh"
  network       = google_compute_network.lab.id
  direction     = "INGRESS"
  source_ranges = [var.allowed_cidr]
  target_tags   = ["${local.name}-database"]
  allow {
    protocol = "tcp"
    ports    = ["22"]
  }
}

resource "google_compute_instance" "database" {
  project      = local.project
  name         = "${local.name}-database"
  machine_type = "e2-small"
  zone         = local.zone
  tags         = ["${local.name}-database"]
  boot_disk {
    initialize_params {
      image = "debian-cloud/debian-12"
      size  = 20
    }
  }
  network_interface {
    subnetwork = google_compute_subnetwork.lab.id
    network_ip = "10.20.0.32"
    access_config {}
  }
  metadata                = { ssh-keys = "admin:${var.ssh_public_key}" }
  metadata_startup_script = "#!/bin/sh\n# Isoloom: this machine sets itself up. Its progress is in /var/lib/isoloom/ready (isoloom-ready/1), its output in /var/log/isoloom-setup.log. The Isothrum runner delivers the project over SSH.\nmkdir -p /var/lib/isoloom\ncat > /var/lib/isoloom/setup.sh.new <<'ISOLOOM_SETUP'\n#!/bin/sh\numask 022\ncase \"$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\" in ready|failed:*) exit 0 ;; esac\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\npart=$(cat /var/lib/isoloom/part 2>/dev/null || echo 1)\nif [ \"$part\" = 1 ]; then\necho 'running: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; { i=0; until [ -f /var/lib/isoloom/project-delivered ]; do i=$((i+5)); if [ $i -gt 2400 ]; then echo 'the project never came: start the lab through the Isothrum runner (run.json), which delivers it over SSH' >&2; exit 1; fi; sleep 5; done; } || { echo 'failed: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; exit 1; }\necho 'running: inputs' > /var/lib/isoloom/ready; { mkdir -p /var/lib/isoloom && (umask 077 && echo ${base64encode(join("\n", ["API_URL='${replace(lookup(var.inputs, "API_URL", ""), "'", "'\\''")}'"]))} | base64 -d > /var/lib/isoloom/inputs.env); } || { echo 'failed: inputs' > /var/lib/isoloom/ready; exit 1; }\necho 'running: inputs in place' > /var/lib/isoloom/ready; { install -m 600 /var/lib/isoloom/inputs.env /tmp/isoloom-inputs.env; } || { echo 'failed: inputs in place' > /var/lib/isoloom/ready; exit 1; }\necho 'running: hosts file' > /var/lib/isoloom/ready; { sh -c 'printf '\\''%s\\n'\\'' '\\''10.20.0.32 database'\\'' '\\''10.20.0.31 web'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'; } || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }\necho 'running: system settings' > /var/lib/isoloom/ready; { sh -c 'set -e\nmkdir -p /etc/systemd/system.conf.d\ngrep -v -E '\\''^(MYSQL_ALLOW_EMPTY_PASSWORD|MYSQL_TCP_PORT)='\\'' /etc/environment > /etc/environment.isoloom 2>/dev/null || true\nprintf %s '\\''MYSQL_ALLOW_EMPTY_PASSWORD=1\nMYSQL_TCP_PORT=3207\n'\\'' >> /etc/environment.isoloom && mv /etc/environment.isoloom /etc/environment\nprintf '\\''[Manager]\\nDefaultEnvironment=%s\\n'\\'' '\\''\"MYSQL_ALLOW_EMPTY_PASSWORD=1\" \"MYSQL_TCP_PORT=3207\"'\\'' > /etc/systemd/system.conf.d/90-isoloom-environment.conf\nsystemctl daemon-reexec 2>/dev/null || true'; } || { echo 'failed: system settings' > /var/lib/isoloom/ready; exit 1; }\necho 'running: waiting for its secrets' > /var/lib/isoloom/ready; { sh -c 'set -e\nn=0; until [ -f /var/lib/isoloom/secrets/.delivered ]; do [ \"$n\" -gt 0 ] || echo '\\''database: waiting for its secrets, which the runner (isothrum up) delivers'\\''; n=$((n+1)); if [ \"$n\" -gt 360 ]; then echo '\\''database: its secrets never came; start the environment with the runner (isothrum up), which reads them from their stores and delivers them'\\'' >&2; exit 1; fi; sleep 5; done\nmkdir -p /etc/isoloom\ncat > /etc/isoloom/apply-secrets.sh <<'\\''APPLY-SECRETS'\\''\n#!/bin/sh\n# The machine'\\''s secrets, put in place\ninstall -D -o 0 -g 0 -m 0400 /var/lib/isoloom/secrets/input-launch-token '\\''/run/lab/launch-token'\\''\nexit 0\nAPPLY-SECRETS\nchmod +x /etc/isoloom/apply-secrets.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-apply-secrets.service <<'\\''UNIT'\\''\n[Unit]\nDescription=The machine'\\''s secrets, put in place\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=-/etc/isoloom/apply-secrets.sh\n\n[Install]\nWantedBy=multi-user.target\nUNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-apply-secrets.service\nsystemctl restart isoloom-apply-secrets.service\nelse\nmkdir -p /etc/local.d && ln -sf /etc/isoloom/apply-secrets.sh /etc/local.d/isoloom-apply-secrets.start\nrc-update add local default >/dev/null 2>&1 || true\n/etc/isoloom/apply-secrets.sh || true\nfi'; } || { echo 'failed: waiting for its secrets' > /var/lib/isoloom/ready; exit 1; }\necho 'running: provision/database.sh' > /var/lib/isoloom/ready; { sh -c 'cd /opt/isoloom && sh -c '\\''set -a; . /tmp/isoloom-inputs.env; set +a; sh provision/database.sh'\\'''; } || { echo 'failed: provision/database.sh' > /var/lib/isoloom/ready; exit 1; }\necho 'running: setup scripts' > /var/lib/isoloom/ready; { sh -c '[ -f /var/lib/isoloom/setup.done ] || (\nset -e\nset -a\n# shellcheck source=/dev/null # the inputs file, written on the machine when it starts\n. /tmp/isoloom-inputs.env\nset +a\nexport MYSQL_ALLOW_EMPTY_PASSWORD='\\''1'\\''\nexport MYSQL_TCP_PORT='\\''3207'\\''\nmkdir -p '\\''/opt/isoloom'\\'' && cd '\\''/opt/isoloom'\\''\nsh '\\''/opt/isoloom/build/database/seed.sh'\\''\nmkdir -p /var/lib/isoloom && touch /var/lib/isoloom/setup.done\n)'; } || { echo 'failed: setup scripts' > /var/lib/isoloom/ready; exit 1; }\necho 'running: health check' > /var/lib/isoloom/ready; { sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'; } || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }\nfi\necho ready > /var/lib/isoloom/ready\nrm -f /var/lib/isoloom/part\ncommand -v systemctl >/dev/null && systemctl disable isoloom-setup.service >/dev/null 2>&1\nexit 0\nISOLOOM_SETUP\nmv -f /var/lib/isoloom/setup.sh.new /var/lib/isoloom/setup.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-setup.service <<'ISOLOOM_UNIT'\n[Unit]\nDescription=Isoloom: the machine's set-up\nWants=network-online.target\nAfter=network-online.target cloud-final.service google-startup-scripts.service\n\n[Service]\nType=oneshot\nExecStart=/bin/sh /var/lib/isoloom/setup.sh\nStandardOutput=append:/var/log/isoloom-setup.log\nStandardError=append:/var/log/isoloom-setup.log\nTimeoutStartSec=0\n\n[Install]\nWantedBy=multi-user.target\nISOLOOM_UNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-setup.service >/dev/null 2>&1\nsystemctl start --no-block isoloom-setup.service\nelse\nnohup sh /var/lib/isoloom/setup.sh >> /var/log/isoloom-setup.log 2>&1 &\nfi\n"
  labels = {
    isoloom-environment = "supplier-portal-api"
    managed-by          = "isoloom"
    isoloom-instance    = local.name
    isoloom-expires-at  = var.expires_at
  }
}

# Machine `web`: what may reach it.
resource "google_compute_firewall" "web_net_lab" {
  project       = local.project
  name          = "${local.name}-web-net-lab"
  network       = google_compute_network.lab.id
  direction     = "INGRESS"
  source_ranges = ["10.20.0.0/24"]
  target_tags   = ["${local.name}-web"]
  allow {
    protocol = "all"
  }
}

resource "google_compute_firewall" "web_ssh" {
  project       = local.project
  name          = "${local.name}-web-ssh"
  network       = google_compute_network.lab.id
  direction     = "INGRESS"
  source_ranges = [var.allowed_cidr]
  target_tags   = ["${local.name}-web"]
  allow {
    protocol = "tcp"
    ports    = ["22"]
  }
}

resource "google_compute_firewall" "web_published" {
  project       = local.project
  name          = "${local.name}-web-published"
  network       = google_compute_network.lab.id
  direction     = "INGRESS"
  source_ranges = [var.allowed_cidr]
  target_tags   = ["${local.name}-web"]
  allow {
    protocol = "tcp"
    ports    = ["3206"]
  }
}

resource "google_compute_instance" "web" {
  project      = local.project
  name         = "${local.name}-web"
  machine_type = "e2-small"
  zone         = local.zone
  tags         = ["${local.name}-web"]
  boot_disk {
    initialize_params {
      image = "debian-cloud/debian-12"
      size  = 20
    }
  }
  network_interface {
    subnetwork = google_compute_subnetwork.lab.id
    network_ip = "10.20.0.31"
    access_config {}
  }
  metadata                = { ssh-keys = "admin:${var.ssh_public_key}" }
  metadata_startup_script = "#!/bin/sh\n# Isoloom: this machine sets itself up. Its progress is in /var/lib/isoloom/ready (isoloom-ready/1), its output in /var/log/isoloom-setup.log. The Isothrum runner delivers the project over SSH.\nmkdir -p /var/lib/isoloom\ncat > /var/lib/isoloom/setup.sh.new <<'ISOLOOM_SETUP'\n#!/bin/sh\numask 022\ncase \"$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\" in ready|failed:*) exit 0 ;; esac\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\npart=$(cat /var/lib/isoloom/part 2>/dev/null || echo 1)\nif [ \"$part\" = 1 ]; then\necho 'running: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; { i=0; until [ -f /var/lib/isoloom/project-delivered ]; do i=$((i+5)); if [ $i -gt 2400 ]; then echo 'the project never came: start the lab through the Isothrum runner (run.json), which delivers it over SSH' >&2; exit 1; fi; sleep 5; done; } || { echo 'failed: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; exit 1; }\necho 'running: hosts file' > /var/lib/isoloom/ready; { sh -c 'printf '\\''%s\\n'\\'' '\\''10.20.0.32 database'\\'' '\\''10.20.0.31 web'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'; } || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }\necho 'running: waiting for database' > /var/lib/isoloom/ready; { sh -c 'i=0; until (bash -c '\\''</dev/tcp/database/3207'\\'' 2>/dev/null || nc -z -w 2 database 3207 2>/dev/null); do i=$((i+2)); if [ $i -ge 900 ]; then echo \"database didn'\\''t answer within 900s\" >&2; exit 1; fi; sleep 2; done; echo \"database answers\"'; } || { echo 'failed: waiting for database' > /var/lib/isoloom/ready; exit 1; }\necho 'running: provision/web.sh' > /var/lib/isoloom/ready; { sh -c 'cd /opt/isoloom && sh -c '\\''sh provision/web.sh'\\'''; } || { echo 'failed: provision/web.sh' > /var/lib/isoloom/ready; exit 1; }\necho 'running: health check' > /var/lib/isoloom/ready; { sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'; } || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }\nfi\necho ready > /var/lib/isoloom/ready\nrm -f /var/lib/isoloom/part\ncommand -v systemctl >/dev/null && systemctl disable isoloom-setup.service >/dev/null 2>&1\nexit 0\nISOLOOM_SETUP\nmv -f /var/lib/isoloom/setup.sh.new /var/lib/isoloom/setup.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-setup.service <<'ISOLOOM_UNIT'\n[Unit]\nDescription=Isoloom: the machine's set-up\nWants=network-online.target\nAfter=network-online.target cloud-final.service google-startup-scripts.service\n\n[Service]\nType=oneshot\nExecStart=/bin/sh /var/lib/isoloom/setup.sh\nStandardOutput=append:/var/log/isoloom-setup.log\nStandardError=append:/var/log/isoloom-setup.log\nTimeoutStartSec=0\n\n[Install]\nWantedBy=multi-user.target\nISOLOOM_UNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-setup.service >/dev/null 2>&1\nsystemctl start --no-block isoloom-setup.service\nelse\nnohup sh /var/lib/isoloom/setup.sh >> /var/log/isoloom-setup.log 2>&1 &\nfi\n"
  labels = {
    isoloom-environment = "supplier-portal-api"
    managed-by          = "isoloom"
    isoloom-instance    = local.name
    isoloom-expires-at  = var.expires_at
  }
}

output "machines" {
  value = {
    database = google_compute_instance.database.network_interface[0].access_config[0].nat_ip
    web      = google_compute_instance.web.network_interface[0].access_config[0].nat_ip
  }
}

output "address_database" {
  value = google_compute_instance.database.network_interface[0].access_config[0].nat_ip
}

output "address_web" {
  value = google_compute_instance.web.network_interface[0].access_config[0].nat_ip
}

output "ssh_users" {
  value = { database = "admin", web = "admin" }
}

output "ip" {
  value = google_compute_instance.database.network_interface[0].access_config[0].nat_ip
}

output "ready_file" {
  value = "/var/lib/isoloom/ready"
}

# The checks: each runner on the machine it stands for (ssh <user>@<host> '<command>'), or `isothrum check .`.
output "checks" {
  value = [
    {
      position = "database"
      machine  = "database"
      host     = google_compute_instance.database.network_interface[0].access_config[0].nat_ip
      user     = "admin"
      command  = "cd /opt/isoloom && sh .isoloom/cloud-vm/checks/database.sh"
    },
    {
      position = "web"
      machine  = "web"
      host     = google_compute_instance.web.network_interface[0].access_config[0].nat_ip
      user     = "admin"
      command  = "cd /opt/isoloom && sh .isoloom/cloud-vm/checks/web.sh"
    }
  ]
}

output "published" {
  value = {
    "web/portal" = "${google_compute_instance.web.network_interface[0].access_config[0].nat_ip}:3206"
  }
}

## .isoloom/cloud-vm/gcp/run.json
{
  "$schema": "https://www.isoloom.com/schema/run-manifest/v0.json",
  "manifest_version": 0,
  "generator": {
    "name": "isoloom",
    "version": "1.0.2"
  },
  "environment": {
    "name": "supplier-portal-api",
    "instance": null,
    "message": null
  },
  "target": "cloud-vm",
  "cloud": "gcp",
  "driver": "terraform",
  "hosts": [
    "linux",
    "macos",
    "windows"
  ],
  "tools": [
    {
      "name": "terraform",
      "probe": [
        "terraform",
        "version"
      ],
      "min_version": "1.11.0"
    },
    {
      "name": "ssh",
      "probe": [
        "ssh",
        "-V"
      ]
    }
  ],
  "identity": {
    "terraform": {
      "module": ".",
      "state": "runner"
    }
  },
  "params": [
    {
      "name": "project",
      "description": "An existing project; or leave empty and give billing_account for a project of its own.",
      "default": "",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "project"
        }
      ]
    },
    {
      "name": "billing_account",
      "description": "With no project: create one for this environment, billed here, deleted with it.",
      "default": "",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "billing_account"
        }
      ]
    },
    {
      "name": "org_id",
      "description": "The module's `org_id`.",
      "default": "",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "org_id"
        }
      ]
    },
    {
      "name": "region",
      "description": "The module's `region`.",
      "default": "europe-west9",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "region"
        }
      ]
    },
    {
      "name": "allowed_cidr",
      "description": "Who may reach the machines (SSH and the published ports), e.g. your IP/32.",
      "required": true,
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "allowed_cidr"
        }
      ]
    },
    {
      "name": "ISOLOOM_DERIVED",
      "description": "0: the checks derived from the spec (reachability, no internet) are skipped.",
      "default": "1",
      "values": [
        "0",
        "1"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_DERIVED",
          "steps": [
            "check-networks",
            "check-database",
            "check-web"
          ]
        }
      ]
    }
  ],
  "secrets": [
    {
      "name": "GOOGLE_OAUTH_ACCESS_TOKEN",
      "kind": "connection",
      "required": false,
      "sensitive": true,
      "source": {
        "store": "env",
        "reference": "GOOGLE_OAUTH_ACCESS_TOKEN"
      },
      "deliver": [
        {
          "via": "env",
          "var": "GOOGLE_OAUTH_ACCESS_TOKEN",
          "steps": [
            "init",
            "apply",
            "destroy"
          ]
        }
      ]
    },
    {
      "name": "GOOGLE_CREDENTIALS",
      "kind": "connection",
      "required": false,
      "sensitive": true,
      "source": {
        "store": "env",
        "reference": "GOOGLE_CREDENTIALS"
      },
      "deliver": [
        {
          "via": "env",
          "var": "GOOGLE_CREDENTIALS",
          "steps": [
            "init",
            "apply",
            "destroy"
          ]
        }
      ]
    },
    {
      "name": "API_URL",
      "kind": "input",
      "required": false,
      "sensitive": false,
      "machines": [
        "database"
      ],
      "default": "",
      "deliver": [
        {
          "via": "tf_var",
          "var": "inputs",
          "shape": "map_entry"
        }
      ]
    },
    {
      "name": "input-launch-token",
      "kind": "secret",
      "required": false,
      "sensitive": true,
      "machines": [
        "database"
      ],
      "default": "",
      "deliver": [
        {
          "via": "guest",
          "machine": "database",
          "transport": "ssh"
        }
      ]
    }
  ],
  "networks": [
    {
      "name": "lab",
      "cidr": "10.20.0.0/24",
      "internet": true,
      "native": "lab"
    }
  ],
  "machines": [
    {
      "name": "database",
      "role": "target",
      "os": "debian-12",
      "arch": "amd64",
      "addresses": {
        "lab": "10.20.0.32"
      },
      "ports": [
        {
          "name": "mysql",
          "port": 3207,
          "protocol": "tcp",
          "http": false
        }
      ]
    },
    {
      "name": "web",
      "role": "target",
      "os": "debian-12",
      "arch": "amd64",
      "addresses": {
        "lab": "10.20.0.31"
      },
      "ports": [
        {
          "name": "portal",
          "port": 3206,
          "protocol": "tcp",
          "http": true,
          "publish": {
            "mode": "fixed",
            "preferred": 3206,
            "address": "${outputs.address_web}"
          }
        }
      ]
    }
  ],
  "lifecycle": {
    "up": [
      {
        "id": "clear-lock",
        "action": "terraform.clear_lock"
      },
      {
        "id": "init",
        "note": "Preparing Terraform and its providers…",
        "argv": [
          "terraform",
          "init",
          "-input=false",
          "-no-color",
          "-backend-config=path=${run.state_dir}/terraform.tfstate"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 900
      },
      {
        "id": "apply",
        "note": "Creating the lab's machines in the cloud…",
        "argv": [
          "terraform",
          "apply",
          "-auto-approve",
          "-input=false",
          "-no-color"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 3600
      },
      {
        "id": "archive",
        "note": "Archiving the project…",
        "action": "project.archive",
        "with": {
          "root": "../../.."
        }
      },
      {
        "id": "deliver-database",
        "note": "Copying the project into database…",
        "action": "ssh.run",
        "with": {
          "command": "sudo sh -c 'mkdir -p /opt/isoloom /var/lib/isoloom && tar -xzf - -C /opt/isoloom && touch /var/lib/isoloom/project-delivered'",
          "host": "${outputs.address_database}",
          "user": "admin",
          "wait_s": "900"
        },
        "stdin": "${run.state_dir}/project.tgz",
        "timeout_s": 1500
      },
      {
        "id": "deliver-web",
        "note": "Copying the project into web…",
        "action": "ssh.run",
        "with": {
          "command": "sudo sh -c 'mkdir -p /opt/isoloom /var/lib/isoloom && tar -xzf - -C /opt/isoloom && touch /var/lib/isoloom/project-delivered'",
          "host": "${outputs.address_web}",
          "user": "admin",
          "wait_s": "900"
        },
        "stdin": "${run.state_dir}/project.tgz",
        "timeout_s": 1500
      }
    ],
    "down": [
      {
        "id": "clear-lock",
        "action": "terraform.clear_lock"
      },
      {
        "id": "init",
        "note": "Preparing Terraform and its providers…",
        "argv": [
          "terraform",
          "init",
          "-input=false",
          "-no-color",
          "-backend-config=path=${run.state_dir}/terraform.tfstate"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 900
      },
      {
        "id": "destroy",
        "note": "Removing the lab from the cloud…",
        "argv": [
          "terraform",
          "destroy",
          "-auto-approve",
          "-input=false",
          "-no-color"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 3600
      }
    ],
    "status": {
      "id": "state",
      "action": "terraform.read_state"
    }
  },
  "ready": [
    {
      "kind": "step_ok",
      "step": "apply",
      "means": "the machines exist and booted; each sets itself up from its user data once the project is in"
    },
    {
      "kind": "ready_file",
      "host": "${outputs.address_database}",
      "user": "admin",
      "path": "${outputs.ready_file}",
      "log": "/var/log/isoloom-setup.log",
      "grammar": "isoloom-ready/1",
      "timeout_s": 2400,
      "unreachable_timeout_s": 600,
      "interval_s": 10
    },
    {
      "kind": "ready_file",
      "host": "${outputs.address_web}",
      "user": "admin",
      "path": "${outputs.ready_file}",
      "log": "/var/log/isoloom-setup.log",
      "grammar": "isoloom-ready/1",
      "timeout_s": 2400,
      "unreachable_timeout_s": 600,
      "interval_s": 10
    }
  ],
  "outputs": [
    {
      "name": "ip",
      "description": "Where to stand: the access machine's public address (the first Linux machine's, else the controller's).",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ip"
      }
    },
    {
      "name": "ready_file",
      "description": "Where each Linux machine's set-up says how far it got (isoloom-ready/1).",
      "role": "info",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ready_file"
      }
    },
    {
      "name": "address_database",
      "description": "database's public address: the runner's SSH and its published ports reach it there.",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "address_database"
      }
    },
    {
      "name": "address_web",
      "description": "web's public address: the runner's SSH and its published ports reach it there.",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "address_web"
      }
    },
    {
      "name": "web_portal",
      "description": "web's portal (port 3206).",
      "role": "entry",
      "sensitive": false,
      "format": "http://${outputs.address_web}:${value}/",
      "from": {
        "kind": "published_port",
        "machine": "web",
        "port": "portal"
      }
    }
  ],
  "checks": {
    "protocol": "isoloom-check/1",
    "setup": [],
    "runners": [
      {
        "id": "networks",
        "from": "from database",
        "checks": [
          {
            "name": "build/check/check.sh",
            "kind": "script",
            "wait_s": 0,
            "derived": false
          }
        ],
        "step": {
          "id": "check-networks",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} sh .isoloom/cloud-vm/checks/networks.sh",
            "host": "${outputs.address_database}",
            "user": "admin"
          },
          "timeout_s": 75
        }
      },
      {
        "id": "database",
        "from": "from database",
        "checks": [
          {
            "name": "web:3206 from database",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          }
        ],
        "step": {
          "id": "check-database",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} sh .isoloom/cloud-vm/checks/database.sh",
            "host": "${outputs.address_database}",
            "user": "admin"
          },
          "timeout_s": 105
        }
      },
      {
        "id": "web",
        "from": "from web",
        "checks": [
          {
            "name": "database:3207 from web",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          }
        ],
        "step": {
          "id": "check-web",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} sh .isoloom/cloud-vm/checks/web.sh",
            "host": "${outputs.address_web}",
            "user": "admin"
          },
          "timeout_s": 105
        }
      }
    ],
    "teardown": []
  },
  "recovery": {
    "retries": 0,
    "apply_retries": 1
  },
  "expiry": {
    "tf_var": "expires_at",
    "unit": "unix_seconds",
    "default_minutes": 240
  }
}

## .isoloom/cloud-vm/linode/main.tf
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Auth:   export LINODE_TOKEN=<token> (the provider reads it).
# Start:  terraform -chdir=.isoloom/cloud-vm/linode init && terraform -chdir=.isoloom/cloud-vm/linode apply \
#           -var allowed_cidr=<your IP>/32 -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)"
# Stop:   terraform -chdir=.isoloom/cloud-vm/linode destroy (same variables)
# Then:   the machines wait for the project: run the lab through the Isothrum runner (run.json
#         beside this file), which delivers the project over SSH, waits for each set-up and runs the checks.

terraform {
  required_version = ">= 1.6"
  backend "local" {}
  required_providers {
    linode = { source = "linode/linode", version = "~> 4.7.0" }
    random = { source = "hashicorp/random", version = "~> 3.9.1" }
  }
}

variable "region" {
  type    = string
  default = "fr-par"
}

variable "inputs" {
  type        = map(string)
  default     = {}
  sensitive   = true
  description = "Values given at launch"
}

variable "allowed_cidr" {
  type        = string
  description = "Who may reach the machines (SSH and the published ports), e.g. your IP/32"
}

variable "ssh_public_key" {
  type        = string
  description = "The key the machines let in: the Isothrum runner's (it delivers the project and runs the checks over SSH)"
}

variable "expires_at" {
  type        = string
  default     = ""
  description = "When the environment should end, in Unix seconds (empty: no end): a tag on every resource, so a reaper finds what to destroy, and the time the machines shut themselves down"
}

provider "linode" {}

resource "terraform_data" "id" {
  input = substr(replace(uuid(), "-", ""), 0, 8)
  lifecycle {
    ignore_changes = [input]
  }
}

locals {
  name = "isoloom-supplier-portal-api-${terraform_data.id.output}"
}

# The environment's networks: a VPC with a subnet per network at its exact range, so every
# machine keeps its address.
resource "linode_vpc" "env" {
  label  = local.name
  region = var.region
}

resource "linode_vpc_subnet" "lab" {
  vpc_id = linode_vpc.env.id
  label  = "lab"
  ipv4   = "10.20.0.0/24"
}

# Machine `database` on `lab`: what may reach it, and where it may not go.
resource "linode_firewall" "database" {
  label           = "${local.name}-database"
  inbound_policy  = "DROP"
  outbound_policy = "ACCEPT"
  inbound {
    label    = "ssh"
    action   = "ACCEPT"
    protocol = "TCP"
    ports    = "22"
    ipv4     = [var.allowed_cidr]
  }
  inbound {
    label    = "vpc-tcp"
    action   = "ACCEPT"
    protocol = "TCP"
    ports    = "1-65535"
    ipv4     = ["10.20.0.0/24"]
  }
  inbound {
    label    = "vpc-udp"
    action   = "ACCEPT"
    protocol = "UDP"
    ports    = "1-65535"
    ipv4     = ["10.20.0.0/24"]
  }
  inbound {
    label    = "vpc-icmp"
    action   = "ACCEPT"
    protocol = "ICMP"
    ipv4     = ["10.20.0.0/24"]
  }
  linodes = [linode_instance.database.id]
}

# Machine `web` on `lab`: what may reach it, and where it may not go.
resource "linode_firewall" "web" {
  label           = "${local.name}-web"
  inbound_policy  = "DROP"
  outbound_policy = "ACCEPT"
  inbound {
    label    = "ssh"
    action   = "ACCEPT"
    protocol = "TCP"
    ports    = "22"
    ipv4     = [var.allowed_cidr]
  }
  inbound {
    label    = "published"
    action   = "ACCEPT"
    protocol = "TCP"
    ports    = "3206"
    ipv4     = [var.allowed_cidr]
  }
  inbound {
    label    = "vpc-tcp"
    action   = "ACCEPT"
    protocol = "TCP"
    ports    = "1-65535"
    ipv4     = ["10.20.0.0/24"]
  }
  inbound {
    label    = "vpc-udp"
    action   = "ACCEPT"
    protocol = "UDP"
    ports    = "1-65535"
    ipv4     = ["10.20.0.0/24"]
  }
  inbound {
    label    = "vpc-icmp"
    action   = "ACCEPT"
    protocol = "ICMP"
    ipv4     = ["10.20.0.0/24"]
  }
  linodes = [linode_instance.web.id]
}

resource "random_password" "database" {
  length      = 24
  special     = false
  min_upper   = 2
  min_lower   = 2
  min_numeric = 2
}

resource "linode_instance" "database" {
  label           = "${local.name}-database"
  region          = var.region
  type            = "g6-nanode-1"
  image           = "linode/debian12"
  authorized_keys = [trimspace(var.ssh_public_key)]
  root_pass       = random_password.database.result
  booted          = true
  tags            = concat(["isoloom", "supplier-portal-api", local.name], var.expires_at == "" ? [] : ["isoloom-expires-${var.expires_at}"])
  metadata {
    user_data = base64encode("#!/bin/sh\n# Isoloom: this machine sets itself up. Its progress is in /var/lib/isoloom/ready (isoloom-ready/1), its output in /var/log/isoloom-setup.log. The Isothrum runner delivers the project over SSH.\nmkdir -p /var/lib/isoloom\ncat > /var/lib/isoloom/setup.sh.new <<'ISOLOOM_SETUP'\n#!/bin/sh\numask 022\ncase \"$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\" in ready|failed:*) exit 0 ;; esac\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\npart=$(cat /var/lib/isoloom/part 2>/dev/null || echo 1)\nif [ \"$part\" = 1 ]; then\necho 'running: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; { i=0; until [ -f /var/lib/isoloom/project-delivered ]; do i=$((i+5)); if [ $i -gt 2400 ]; then echo 'the project never came: start the lab through the Isothrum runner (run.json), which delivers it over SSH' >&2; exit 1; fi; sleep 5; done; } || { echo 'failed: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; exit 1; }\necho 'running: inputs' > /var/lib/isoloom/ready; { mkdir -p /var/lib/isoloom && (umask 077 && echo ${base64encode(join("\n", ["API_URL='${replace(lookup(var.inputs, "API_URL", ""), "'", "'\\''")}'"]))} | base64 -d > /var/lib/isoloom/inputs.env); } || { echo 'failed: inputs' > /var/lib/isoloom/ready; exit 1; }\necho 'running: inputs in place' > /var/lib/isoloom/ready; { install -m 600 /var/lib/isoloom/inputs.env /tmp/isoloom-inputs.env; } || { echo 'failed: inputs in place' > /var/lib/isoloom/ready; exit 1; }\necho 'running: the machine'\\''s interfaces' > /var/lib/isoloom/ready; { command -v sudo >/dev/null || (apt-get update -qq && apt-get install -y -qq sudo); } || { echo 'failed: the machine'\\''s interfaces' > /var/lib/isoloom/ready; exit 1; }\necho 'running: hosts file' > /var/lib/isoloom/ready; { sh -c 'printf '\\''%s\\n'\\'' '\\''10.20.0.32 database'\\'' '\\''10.20.0.31 web'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'; } || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }\necho 'running: system settings' > /var/lib/isoloom/ready; { sh -c 'set -e\nmkdir -p /etc/systemd/system.conf.d\ngrep -v -E '\\''^(MYSQL_ALLOW_EMPTY_PASSWORD|MYSQL_TCP_PORT)='\\'' /etc/environment > /etc/environment.isoloom 2>/dev/null || true\nprintf %s '\\''MYSQL_ALLOW_EMPTY_PASSWORD=1\nMYSQL_TCP_PORT=3207\n'\\'' >> /etc/environment.isoloom && mv /etc/environment.isoloom /etc/environment\nprintf '\\''[Manager]\\nDefaultEnvironment=%s\\n'\\'' '\\''\"MYSQL_ALLOW_EMPTY_PASSWORD=1\" \"MYSQL_TCP_PORT=3207\"'\\'' > /etc/systemd/system.conf.d/90-isoloom-environment.conf\nsystemctl daemon-reexec 2>/dev/null || true'; } || { echo 'failed: system settings' > /var/lib/isoloom/ready; exit 1; }\necho 'running: waiting for its secrets' > /var/lib/isoloom/ready; { sh -c 'set -e\nn=0; until [ -f /var/lib/isoloom/secrets/.delivered ]; do [ \"$n\" -gt 0 ] || echo '\\''database: waiting for its secrets, which the runner (isothrum up) delivers'\\''; n=$((n+1)); if [ \"$n\" -gt 360 ]; then echo '\\''database: its secrets never came; start the environment with the runner (isothrum up), which reads them from their stores and delivers them'\\'' >&2; exit 1; fi; sleep 5; done\nmkdir -p /etc/isoloom\ncat > /etc/isoloom/apply-secrets.sh <<'\\''APPLY-SECRETS'\\''\n#!/bin/sh\n# The machine'\\''s secrets, put in place\ninstall -D -o 0 -g 0 -m 0400 /var/lib/isoloom/secrets/input-launch-token '\\''/run/lab/launch-token'\\''\nexit 0\nAPPLY-SECRETS\nchmod +x /etc/isoloom/apply-secrets.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-apply-secrets.service <<'\\''UNIT'\\''\n[Unit]\nDescription=The machine'\\''s secrets, put in place\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=-/etc/isoloom/apply-secrets.sh\n\n[Install]\nWantedBy=multi-user.target\nUNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-apply-secrets.service\nsystemctl restart isoloom-apply-secrets.service\nelse\nmkdir -p /etc/local.d && ln -sf /etc/isoloom/apply-secrets.sh /etc/local.d/isoloom-apply-secrets.start\nrc-update add local default >/dev/null 2>&1 || true\n/etc/isoloom/apply-secrets.sh || true\nfi'; } || { echo 'failed: waiting for its secrets' > /var/lib/isoloom/ready; exit 1; }\necho 'running: provision/database.sh' > /var/lib/isoloom/ready; { sh -c 'cd /opt/isoloom && sh -c '\\''set -a; . /tmp/isoloom-inputs.env; set +a; sh provision/database.sh'\\'''; } || { echo 'failed: provision/database.sh' > /var/lib/isoloom/ready; exit 1; }\necho 'running: setup scripts' > /var/lib/isoloom/ready; { sh -c '[ -f /var/lib/isoloom/setup.done ] || (\nset -e\nset -a\n# shellcheck source=/dev/null # the inputs file, written on the machine when it starts\n. /tmp/isoloom-inputs.env\nset +a\nexport MYSQL_ALLOW_EMPTY_PASSWORD='\\''1'\\''\nexport MYSQL_TCP_PORT='\\''3207'\\''\nmkdir -p '\\''/opt/isoloom'\\'' && cd '\\''/opt/isoloom'\\''\nsh '\\''/opt/isoloom/build/database/seed.sh'\\''\nmkdir -p /var/lib/isoloom && touch /var/lib/isoloom/setup.done\n)'; } || { echo 'failed: setup scripts' > /var/lib/isoloom/ready; exit 1; }\necho 'running: health check' > /var/lib/isoloom/ready; { sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'; } || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }\nfi\necho ready > /var/lib/isoloom/ready\nrm -f /var/lib/isoloom/part\ncommand -v systemctl >/dev/null && systemctl disable isoloom-setup.service >/dev/null 2>&1\nexit 0\nISOLOOM_SETUP\nmv -f /var/lib/isoloom/setup.sh.new /var/lib/isoloom/setup.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-setup.service <<'ISOLOOM_UNIT'\n[Unit]\nDescription=Isoloom: the machine's set-up\nWants=network-online.target\nAfter=network-online.target cloud-final.service google-startup-scripts.service\n\n[Service]\nType=oneshot\nExecStart=/bin/sh /var/lib/isoloom/setup.sh\nStandardOutput=append:/var/log/isoloom-setup.log\nStandardError=append:/var/log/isoloom-setup.log\nTimeoutStartSec=0\n\n[Install]\nWantedBy=multi-user.target\nISOLOOM_UNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-setup.service >/dev/null 2>&1\nsystemctl start --no-block isoloom-setup.service\nelse\nnohup sh /var/lib/isoloom/setup.sh >> /var/log/isoloom-setup.log 2>&1 &\nfi\n")
  }
  interface {
    purpose = "public"
  }
  interface {
    purpose   = "vpc"
    subnet_id = linode_vpc_subnet.lab.id
    ipv4 {
      vpc = "10.20.0.32"
    }
  }
}

resource "random_password" "web" {
  length      = 24
  special     = false
  min_upper   = 2
  min_lower   = 2
  min_numeric = 2
}

resource "linode_instance" "web" {
  label           = "${local.name}-web"
  region          = var.region
  type            = "g6-nanode-1"
  image           = "linode/debian12"
  authorized_keys = [trimspace(var.ssh_public_key)]
  root_pass       = random_password.web.result
  booted          = true
  tags            = concat(["isoloom", "supplier-portal-api", local.name], var.expires_at == "" ? [] : ["isoloom-expires-${var.expires_at}"])
  metadata {
    user_data = base64encode("#!/bin/sh\n# Isoloom: this machine sets itself up. Its progress is in /var/lib/isoloom/ready (isoloom-ready/1), its output in /var/log/isoloom-setup.log. The Isothrum runner delivers the project over SSH.\nmkdir -p /var/lib/isoloom\ncat > /var/lib/isoloom/setup.sh.new <<'ISOLOOM_SETUP'\n#!/bin/sh\numask 022\ncase \"$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\" in ready|failed:*) exit 0 ;; esac\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\npart=$(cat /var/lib/isoloom/part 2>/dev/null || echo 1)\nif [ \"$part\" = 1 ]; then\necho 'running: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; { i=0; until [ -f /var/lib/isoloom/project-delivered ]; do i=$((i+5)); if [ $i -gt 2400 ]; then echo 'the project never came: start the lab through the Isothrum runner (run.json), which delivers it over SSH' >&2; exit 1; fi; sleep 5; done; } || { echo 'failed: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; exit 1; }\necho 'running: the machine'\\''s interfaces' > /var/lib/isoloom/ready; { command -v sudo >/dev/null || (apt-get update -qq && apt-get install -y -qq sudo); } || { echo 'failed: the machine'\\''s interfaces' > /var/lib/isoloom/ready; exit 1; }\necho 'running: hosts file' > /var/lib/isoloom/ready; { sh -c 'printf '\\''%s\\n'\\'' '\\''10.20.0.32 database'\\'' '\\''10.20.0.31 web'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'; } || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }\necho 'running: waiting for database' > /var/lib/isoloom/ready; { sh -c 'i=0; until (bash -c '\\''</dev/tcp/database/3207'\\'' 2>/dev/null || nc -z -w 2 database 3207 2>/dev/null); do i=$((i+2)); if [ $i -ge 900 ]; then echo \"database didn'\\''t answer within 900s\" >&2; exit 1; fi; sleep 2; done; echo \"database answers\"'; } || { echo 'failed: waiting for database' > /var/lib/isoloom/ready; exit 1; }\necho 'running: provision/web.sh' > /var/lib/isoloom/ready; { sh -c 'cd /opt/isoloom && sh -c '\\''sh provision/web.sh'\\'''; } || { echo 'failed: provision/web.sh' > /var/lib/isoloom/ready; exit 1; }\necho 'running: health check' > /var/lib/isoloom/ready; { sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'; } || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }\nfi\necho ready > /var/lib/isoloom/ready\nrm -f /var/lib/isoloom/part\ncommand -v systemctl >/dev/null && systemctl disable isoloom-setup.service >/dev/null 2>&1\nexit 0\nISOLOOM_SETUP\nmv -f /var/lib/isoloom/setup.sh.new /var/lib/isoloom/setup.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-setup.service <<'ISOLOOM_UNIT'\n[Unit]\nDescription=Isoloom: the machine's set-up\nWants=network-online.target\nAfter=network-online.target cloud-final.service google-startup-scripts.service\n\n[Service]\nType=oneshot\nExecStart=/bin/sh /var/lib/isoloom/setup.sh\nStandardOutput=append:/var/log/isoloom-setup.log\nStandardError=append:/var/log/isoloom-setup.log\nTimeoutStartSec=0\n\n[Install]\nWantedBy=multi-user.target\nISOLOOM_UNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-setup.service >/dev/null 2>&1\nsystemctl start --no-block isoloom-setup.service\nelse\nnohup sh /var/lib/isoloom/setup.sh >> /var/log/isoloom-setup.log 2>&1 &\nfi\n")
  }
  interface {
    purpose = "public"
  }
  interface {
    purpose   = "vpc"
    subnet_id = linode_vpc_subnet.lab.id
    ipv4 {
      vpc = "10.20.0.31"
    }
  }
}

output "machines" {
  value = { database = one(linode_instance.database.ipv4), web = one(linode_instance.web.ipv4) }
}

output "address_database" {
  value = one(linode_instance.database.ipv4)
}

output "address_web" {
  value = one(linode_instance.web.ipv4)
}

output "ssh_users" {
  value = { database = "root", web = "root" }
}

output "ip" {
  value = one(linode_instance.database.ipv4)
}

output "ready_file" {
  value = "/var/lib/isoloom/ready"
}

# The checks: each runner on the machine it stands for (ssh <user>@<host> '<command>'), or `isothrum check .`.
output "checks" {
  value = [
    {
      position = "database"
      machine  = "database"
      host     = one(linode_instance.database.ipv4)
      user     = "root"
      command  = "cd /opt/isoloom && sh .isoloom/cloud-vm/checks/database.sh"
    },
    {
      position = "web"
      machine  = "web"
      host     = one(linode_instance.web.ipv4)
      user     = "root"
      command  = "cd /opt/isoloom && sh .isoloom/cloud-vm/checks/web.sh"
    }
  ]
}

output "published" {
  value = { "web/portal" = "${one(linode_instance.web.ipv4)}:3206" }
}

## .isoloom/cloud-vm/linode/run.json
{
  "$schema": "https://www.isoloom.com/schema/run-manifest/v0.json",
  "manifest_version": 0,
  "generator": {
    "name": "isoloom",
    "version": "1.0.2"
  },
  "environment": {
    "name": "supplier-portal-api",
    "instance": null,
    "message": null
  },
  "target": "cloud-vm",
  "cloud": "linode",
  "driver": "terraform",
  "hosts": [
    "linux",
    "macos",
    "windows"
  ],
  "tools": [
    {
      "name": "terraform",
      "probe": [
        "terraform",
        "version"
      ],
      "min_version": "1.11.0"
    },
    {
      "name": "ssh",
      "probe": [
        "ssh",
        "-V"
      ]
    }
  ],
  "identity": {
    "terraform": {
      "module": ".",
      "state": "runner"
    }
  },
  "params": [
    {
      "name": "region",
      "description": "The module's `region`.",
      "default": "fr-par",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "region"
        }
      ]
    },
    {
      "name": "allowed_cidr",
      "description": "Who may reach the machines (SSH and the published ports), e.g. your IP/32.",
      "required": true,
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "allowed_cidr"
        }
      ]
    },
    {
      "name": "ISOLOOM_DERIVED",
      "description": "0: the checks derived from the spec (reachability, no internet) are skipped.",
      "default": "1",
      "values": [
        "0",
        "1"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_DERIVED",
          "steps": [
            "check-networks",
            "check-database",
            "check-web"
          ]
        }
      ]
    }
  ],
  "secrets": [
    {
      "name": "LINODE_TOKEN",
      "kind": "connection",
      "required": true,
      "sensitive": true,
      "source": {
        "store": "env",
        "reference": "LINODE_TOKEN"
      },
      "deliver": [
        {
          "via": "env",
          "var": "LINODE_TOKEN",
          "steps": [
            "init",
            "apply",
            "destroy"
          ]
        }
      ]
    },
    {
      "name": "API_URL",
      "kind": "input",
      "required": false,
      "sensitive": false,
      "machines": [
        "database"
      ],
      "default": "",
      "deliver": [
        {
          "via": "tf_var",
          "var": "inputs",
          "shape": "map_entry"
        }
      ]
    },
    {
      "name": "input-launch-token",
      "kind": "secret",
      "required": false,
      "sensitive": true,
      "machines": [
        "database"
      ],
      "default": "",
      "deliver": [
        {
          "via": "guest",
          "machine": "database",
          "transport": "ssh"
        }
      ]
    }
  ],
  "networks": [
    {
      "name": "lab",
      "cidr": "10.20.0.0/24",
      "internet": true,
      "native": "lab"
    }
  ],
  "machines": [
    {
      "name": "database",
      "role": "target",
      "os": "debian-12",
      "arch": "amd64",
      "addresses": {
        "lab": "10.20.0.32"
      },
      "ports": [
        {
          "name": "mysql",
          "port": 3207,
          "protocol": "tcp",
          "http": false
        }
      ]
    },
    {
      "name": "web",
      "role": "target",
      "os": "debian-12",
      "arch": "amd64",
      "addresses": {
        "lab": "10.20.0.31"
      },
      "ports": [
        {
          "name": "portal",
          "port": 3206,
          "protocol": "tcp",
          "http": true,
          "publish": {
            "mode": "fixed",
            "preferred": 3206,
            "address": "${outputs.address_web}"
          }
        }
      ]
    }
  ],
  "lifecycle": {
    "up": [
      {
        "id": "clear-lock",
        "action": "terraform.clear_lock"
      },
      {
        "id": "init",
        "note": "Preparing Terraform and its providers…",
        "argv": [
          "terraform",
          "init",
          "-input=false",
          "-no-color",
          "-backend-config=path=${run.state_dir}/terraform.tfstate"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 900
      },
      {
        "id": "apply",
        "note": "Creating the lab's machines in the cloud…",
        "argv": [
          "terraform",
          "apply",
          "-auto-approve",
          "-input=false",
          "-no-color"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 3600
      },
      {
        "id": "archive",
        "note": "Archiving the project…",
        "action": "project.archive",
        "with": {
          "root": "../../.."
        }
      },
      {
        "id": "deliver-database",
        "note": "Copying the project into database…",
        "action": "ssh.run",
        "with": {
          "command": "sh -c 'mkdir -p /opt/isoloom /var/lib/isoloom && tar -xzf - -C /opt/isoloom && touch /var/lib/isoloom/project-delivered'",
          "host": "${outputs.address_database}",
          "user": "root",
          "wait_s": "900"
        },
        "stdin": "${run.state_dir}/project.tgz",
        "timeout_s": 1500
      },
      {
        "id": "deliver-web",
        "note": "Copying the project into web…",
        "action": "ssh.run",
        "with": {
          "command": "sh -c 'mkdir -p /opt/isoloom /var/lib/isoloom && tar -xzf - -C /opt/isoloom && touch /var/lib/isoloom/project-delivered'",
          "host": "${outputs.address_web}",
          "user": "root",
          "wait_s": "900"
        },
        "stdin": "${run.state_dir}/project.tgz",
        "timeout_s": 1500
      }
    ],
    "down": [
      {
        "id": "clear-lock",
        "action": "terraform.clear_lock"
      },
      {
        "id": "init",
        "note": "Preparing Terraform and its providers…",
        "argv": [
          "terraform",
          "init",
          "-input=false",
          "-no-color",
          "-backend-config=path=${run.state_dir}/terraform.tfstate"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 900
      },
      {
        "id": "destroy",
        "note": "Removing the lab from the cloud…",
        "argv": [
          "terraform",
          "destroy",
          "-auto-approve",
          "-input=false",
          "-no-color"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 3600
      }
    ],
    "status": {
      "id": "state",
      "action": "terraform.read_state"
    }
  },
  "ready": [
    {
      "kind": "step_ok",
      "step": "apply",
      "means": "the machines exist and booted; each sets itself up from its user data once the project is in"
    },
    {
      "kind": "ready_file",
      "host": "${outputs.address_database}",
      "user": "root",
      "path": "${outputs.ready_file}",
      "log": "/var/log/isoloom-setup.log",
      "grammar": "isoloom-ready/1",
      "timeout_s": 2400,
      "unreachable_timeout_s": 600,
      "interval_s": 10
    },
    {
      "kind": "ready_file",
      "host": "${outputs.address_web}",
      "user": "root",
      "path": "${outputs.ready_file}",
      "log": "/var/log/isoloom-setup.log",
      "grammar": "isoloom-ready/1",
      "timeout_s": 2400,
      "unreachable_timeout_s": 600,
      "interval_s": 10
    }
  ],
  "outputs": [
    {
      "name": "ip",
      "description": "Where to stand: the access machine's public address (the first Linux machine's, else the controller's).",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ip"
      }
    },
    {
      "name": "ready_file",
      "description": "Where each Linux machine's set-up says how far it got (isoloom-ready/1).",
      "role": "info",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ready_file"
      }
    },
    {
      "name": "address_database",
      "description": "database's public address: the runner's SSH and its published ports reach it there.",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "address_database"
      }
    },
    {
      "name": "address_web",
      "description": "web's public address: the runner's SSH and its published ports reach it there.",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "address_web"
      }
    },
    {
      "name": "web_portal",
      "description": "web's portal (port 3206).",
      "role": "entry",
      "sensitive": false,
      "format": "http://${outputs.address_web}:${value}/",
      "from": {
        "kind": "published_port",
        "machine": "web",
        "port": "portal"
      }
    }
  ],
  "checks": {
    "protocol": "isoloom-check/1",
    "setup": [],
    "runners": [
      {
        "id": "networks",
        "from": "from database",
        "checks": [
          {
            "name": "build/check/check.sh",
            "kind": "script",
            "wait_s": 0,
            "derived": false
          }
        ],
        "step": {
          "id": "check-networks",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} sh .isoloom/cloud-vm/checks/networks.sh",
            "host": "${outputs.address_database}",
            "user": "root"
          },
          "timeout_s": 75
        }
      },
      {
        "id": "database",
        "from": "from database",
        "checks": [
          {
            "name": "web:3206 from database",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          }
        ],
        "step": {
          "id": "check-database",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} sh .isoloom/cloud-vm/checks/database.sh",
            "host": "${outputs.address_database}",
            "user": "root"
          },
          "timeout_s": 105
        }
      },
      {
        "id": "web",
        "from": "from web",
        "checks": [
          {
            "name": "database:3207 from web",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          }
        ],
        "step": {
          "id": "check-web",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} sh .isoloom/cloud-vm/checks/web.sh",
            "host": "${outputs.address_web}",
            "user": "root"
          },
          "timeout_s": 105
        }
      }
    ],
    "teardown": []
  },
  "recovery": {
    "retries": 0,
    "apply_retries": 1
  },
  "expiry": {
    "tf_var": "expires_at",
    "unit": "unix_seconds",
    "default_minutes": 240
  }
}

## .isoloom/cloud-vm/oci/main.tf
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  terraform -chdir=.isoloom/cloud-vm/oci init && terraform -chdir=.isoloom/cloud-vm/oci apply \
#           -var compartment_id=<compartment ocid> -var allowed_cidr=<your IP>/32 \
#           -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)"
# Stop:   terraform -chdir=.isoloom/cloud-vm/oci destroy (same variables)
# Auth:   the oci provider reads ~/.oci/config; region defaults, override with -var region=<id>.
# Then:   the machines wait for the project: run the lab through the Isothrum runner (run.json
#         beside this file), which delivers the project over SSH, waits for each set-up and runs the checks.

terraform {
  required_version = ">= 1.6"
  backend "local" {}
  required_providers {
    oci = { source = "oracle/oci", version = "~> 9.8.0" }
  }
}

variable "compartment_id" {
  type        = string
  description = "The compartment the environment goes in"
}

variable "region" {
  type        = string
  default     = "eu-paris-1"
  description = "The OCI region to launch in"
}

variable "config_file_profile" {
  type        = string
  default     = "DEFAULT"
  description = "The profile of the OCI CLI's configuration (~/.oci/config) the provider signs in with"
}

variable "inputs" {
  type        = map(string)
  default     = {}
  sensitive   = true
  description = "Values given at launch"
}

variable "allowed_cidr" {
  type        = string
  description = "Who may reach the machines (SSH and the published ports), e.g. your IP/32"
}

variable "ssh_public_key" {
  type        = string
  description = "The key the machines let in: the Isothrum runner's (it delivers the project and runs the checks over SSH)"
}

variable "expires_at" {
  type        = string
  default     = ""
  description = "When the environment should end, in Unix seconds (empty: no end): a tag on every resource, so a reaper finds what to destroy, and the time the machines shut themselves down"
}

provider "oci" {
  region              = var.region
  config_file_profile = var.config_file_profile
}

resource "terraform_data" "id" {
  input = substr(replace(uuid(), "-", ""), 0, 8)
  lifecycle {
    ignore_changes = [input]
  }
}

locals {
  name = "isoloom-supplier-portal-api-${terraform_data.id.output}"
  tags = merge({ isoloom-environment = "supplier-portal-api", managed-by = "isoloom", isoloom-instance = local.name }, var.expires_at == "" ? {} : { isoloom-expires-at = var.expires_at })
}

# The compartment's availability domains; the instances land in the first.
data "oci_identity_availability_domains" "ads" {
  compartment_id = var.compartment_id
}

# Ubuntu 24.04: Oracle Cloud has no Debian image of its own.
data "oci_core_images" "ubuntu_2404" {
  compartment_id           = var.compartment_id
  operating_system         = "Canonical Ubuntu"
  operating_system_version = "24.04"
  shape                    = "VM.Standard.E4.Flex"
  sort_by                  = "TIMECREATED"
  sort_order               = "DESC"
}

# The environment's networks: a VCN holding each one's block, routed to the internet.
resource "oci_core_vcn" "env" {
  compartment_id = var.compartment_id
  freeform_tags  = local.tags
  display_name   = local.name
  cidr_block     = "10.20.0.0/24"
}

resource "oci_core_internet_gateway" "env" {
  compartment_id = var.compartment_id
  freeform_tags  = local.tags
  vcn_id         = oci_core_vcn.env.id
  display_name   = local.name
}

resource "oci_core_route_table" "env" {
  compartment_id = var.compartment_id
  freeform_tags  = local.tags
  vcn_id         = oci_core_vcn.env.id
  display_name   = local.name
  route_rules {
    destination       = "0.0.0.0/0"
    network_entity_id = oci_core_internet_gateway.env.id
  }
}

# Network `lab`: what may reach its machines, and where they may go.
resource "oci_core_security_list" "lab" {
  compartment_id = var.compartment_id
  freeform_tags  = local.tags
  vcn_id         = oci_core_vcn.env.id
  display_name   = "${local.name}-lab"
  ingress_security_rules {
    description = "its own network"
    source      = "10.20.0.0/24"
    protocol    = "all"
  }
  ingress_security_rules {
    description = "SSH from allowed_cidr"
    source      = var.allowed_cidr
    protocol    = "6"
    tcp_options {
      min = 22
      max = 22
    }
  }
  ingress_security_rules {
    description = "path MTU discovery"
    source      = "0.0.0.0/0"
    protocol    = "1"
    icmp_options {
      type = 3
      code = 4
    }
  }
  egress_security_rules {
    description = "its own network"
    destination = "10.20.0.0/24"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "0.0.0.0/5"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "8.0.0.0/7"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "11.0.0.0/8"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "12.0.0.0/6"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "16.0.0.0/4"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "32.0.0.0/3"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "64.0.0.0/2"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "128.0.0.0/3"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "160.0.0.0/5"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "168.0.0.0/6"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "172.0.0.0/12"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "172.32.0.0/11"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "172.64.0.0/10"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "172.128.0.0/9"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "173.0.0.0/8"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "174.0.0.0/7"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "176.0.0.0/4"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "192.0.0.0/9"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "192.128.0.0/11"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "192.160.0.0/13"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "192.169.0.0/16"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "192.170.0.0/15"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "192.172.0.0/14"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "192.176.0.0/12"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "192.192.0.0/10"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "193.0.0.0/8"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "194.0.0.0/7"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "196.0.0.0/6"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "200.0.0.0/5"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "208.0.0.0/4"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "224.0.0.0/3"
    protocol    = "all"
  }
  egress_security_rules {
    description = "path MTU discovery"
    destination = "0.0.0.0/0"
    protocol    = "1"
    icmp_options {
      type = 3
      code = 4
    }
  }
}

resource "oci_core_subnet" "lab" {
  compartment_id    = var.compartment_id
  freeform_tags     = local.tags
  vcn_id            = oci_core_vcn.env.id
  cidr_block        = "10.20.0.0/24"
  display_name      = "${local.name}-lab"
  route_table_id    = oci_core_route_table.env.id
  security_list_ids = [oci_core_security_list.lab.id]
}

# Machine `database`, at its fixed address 10.20.0.32.
resource "oci_core_instance" "database" {
  compartment_id      = var.compartment_id
  freeform_tags       = local.tags
  availability_domain = data.oci_identity_availability_domains.ads.availability_domains[0].name
  display_name        = "${local.name}-database"
  shape               = "VM.Standard.E4.Flex"
  shape_config {
    ocpus         = 1
    memory_in_gbs = 1
  }
  source_details {
    source_type             = "image"
    source_id               = data.oci_core_images.ubuntu_2404.images[0].id
    boot_volume_size_in_gbs = 50
  }
  create_vnic_details {
    subnet_id              = oci_core_subnet.lab.id
    private_ip             = "10.20.0.32"
    assign_public_ip       = true
    hostname_label         = "database"
    skip_source_dest_check = false
  }
  metadata = {
    ssh_authorized_keys = var.ssh_public_key
    user_data           = base64encode("#!/bin/sh\n# Isoloom: this machine sets itself up. Its progress is in /var/lib/isoloom/ready (isoloom-ready/1), its output in /var/log/isoloom-setup.log. The Isothrum runner delivers the project over SSH.\nmkdir -p /var/lib/isoloom\ncat > /var/lib/isoloom/setup.sh.new <<'ISOLOOM_SETUP'\n#!/bin/sh\numask 022\ncase \"$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\" in ready|failed:*) exit 0 ;; esac\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\npart=$(cat /var/lib/isoloom/part 2>/dev/null || echo 1)\nif [ \"$part\" = 1 ]; then\necho 'running: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; { i=0; until [ -f /var/lib/isoloom/project-delivered ]; do i=$((i+5)); if [ $i -gt 2400 ]; then echo 'the project never came: start the lab through the Isothrum runner (run.json), which delivers it over SSH' >&2; exit 1; fi; sleep 5; done; } || { echo 'failed: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; exit 1; }\necho 'running: inputs' > /var/lib/isoloom/ready; { mkdir -p /var/lib/isoloom && (umask 077 && echo ${base64encode(join("\n", ["API_URL='${replace(lookup(var.inputs, "API_URL", ""), "'", "'\\''")}'"]))} | base64 -d > /var/lib/isoloom/inputs.env); } || { echo 'failed: inputs' > /var/lib/isoloom/ready; exit 1; }\necho 'running: inputs in place' > /var/lib/isoloom/ready; { install -m 600 /var/lib/isoloom/inputs.env /tmp/isoloom-inputs.env; } || { echo 'failed: inputs in place' > /var/lib/isoloom/ready; exit 1; }\necho 'running: hosts file' > /var/lib/isoloom/ready; { sh -c 'printf '\\''%s\\n'\\'' '\\''10.20.0.32 database'\\'' '\\''10.20.0.31 web'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'; } || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }\necho 'running: system settings' > /var/lib/isoloom/ready; { sh -c 'set -e\nmkdir -p /etc/systemd/system.conf.d\ngrep -v -E '\\''^(MYSQL_ALLOW_EMPTY_PASSWORD|MYSQL_TCP_PORT)='\\'' /etc/environment > /etc/environment.isoloom 2>/dev/null || true\nprintf %s '\\''MYSQL_ALLOW_EMPTY_PASSWORD=1\nMYSQL_TCP_PORT=3207\n'\\'' >> /etc/environment.isoloom && mv /etc/environment.isoloom /etc/environment\nprintf '\\''[Manager]\\nDefaultEnvironment=%s\\n'\\'' '\\''\"MYSQL_ALLOW_EMPTY_PASSWORD=1\" \"MYSQL_TCP_PORT=3207\"'\\'' > /etc/systemd/system.conf.d/90-isoloom-environment.conf\nsystemctl daemon-reexec 2>/dev/null || true'; } || { echo 'failed: system settings' > /var/lib/isoloom/ready; exit 1; }\necho 'running: waiting for its secrets' > /var/lib/isoloom/ready; { sh -c 'set -e\nn=0; until [ -f /var/lib/isoloom/secrets/.delivered ]; do [ \"$n\" -gt 0 ] || echo '\\''database: waiting for its secrets, which the runner (isothrum up) delivers'\\''; n=$((n+1)); if [ \"$n\" -gt 360 ]; then echo '\\''database: its secrets never came; start the environment with the runner (isothrum up), which reads them from their stores and delivers them'\\'' >&2; exit 1; fi; sleep 5; done\nmkdir -p /etc/isoloom\ncat > /etc/isoloom/apply-secrets.sh <<'\\''APPLY-SECRETS'\\''\n#!/bin/sh\n# The machine'\\''s secrets, put in place\ninstall -D -o 0 -g 0 -m 0400 /var/lib/isoloom/secrets/input-launch-token '\\''/run/lab/launch-token'\\''\nexit 0\nAPPLY-SECRETS\nchmod +x /etc/isoloom/apply-secrets.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-apply-secrets.service <<'\\''UNIT'\\''\n[Unit]\nDescription=The machine'\\''s secrets, put in place\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=-/etc/isoloom/apply-secrets.sh\n\n[Install]\nWantedBy=multi-user.target\nUNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-apply-secrets.service\nsystemctl restart isoloom-apply-secrets.service\nelse\nmkdir -p /etc/local.d && ln -sf /etc/isoloom/apply-secrets.sh /etc/local.d/isoloom-apply-secrets.start\nrc-update add local default >/dev/null 2>&1 || true\n/etc/isoloom/apply-secrets.sh || true\nfi'; } || { echo 'failed: waiting for its secrets' > /var/lib/isoloom/ready; exit 1; }\necho 'running: provision/database.sh' > /var/lib/isoloom/ready; { sh -c 'cd /opt/isoloom && sh -c '\\''set -a; . /tmp/isoloom-inputs.env; set +a; sh provision/database.sh'\\'''; } || { echo 'failed: provision/database.sh' > /var/lib/isoloom/ready; exit 1; }\necho 'running: setup scripts' > /var/lib/isoloom/ready; { sh -c '[ -f /var/lib/isoloom/setup.done ] || (\nset -e\nset -a\n# shellcheck source=/dev/null # the inputs file, written on the machine when it starts\n. /tmp/isoloom-inputs.env\nset +a\nexport MYSQL_ALLOW_EMPTY_PASSWORD='\\''1'\\''\nexport MYSQL_TCP_PORT='\\''3207'\\''\nmkdir -p '\\''/opt/isoloom'\\'' && cd '\\''/opt/isoloom'\\''\nsh '\\''/opt/isoloom/build/database/seed.sh'\\''\nmkdir -p /var/lib/isoloom && touch /var/lib/isoloom/setup.done\n)'; } || { echo 'failed: setup scripts' > /var/lib/isoloom/ready; exit 1; }\necho 'running: health check' > /var/lib/isoloom/ready; { sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'; } || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }\nfi\necho ready > /var/lib/isoloom/ready\nrm -f /var/lib/isoloom/part\ncommand -v systemctl >/dev/null && systemctl disable isoloom-setup.service >/dev/null 2>&1\nexit 0\nISOLOOM_SETUP\nmv -f /var/lib/isoloom/setup.sh.new /var/lib/isoloom/setup.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-setup.service <<'ISOLOOM_UNIT'\n[Unit]\nDescription=Isoloom: the machine's set-up\nWants=network-online.target\nAfter=network-online.target cloud-final.service google-startup-scripts.service\n\n[Service]\nType=oneshot\nExecStart=/bin/sh /var/lib/isoloom/setup.sh\nStandardOutput=append:/var/log/isoloom-setup.log\nStandardError=append:/var/log/isoloom-setup.log\nTimeoutStartSec=0\n\n[Install]\nWantedBy=multi-user.target\nISOLOOM_UNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-setup.service >/dev/null 2>&1\nsystemctl start --no-block isoloom-setup.service\nelse\nnohup sh /var/lib/isoloom/setup.sh >> /var/log/isoloom-setup.log 2>&1 &\nfi\n")
  }
}

# The ports `web` publishes, from allowed_cidr: on its VNIC only.
resource "oci_core_network_security_group" "web" {
  compartment_id = var.compartment_id
  freeform_tags  = local.tags
  vcn_id         = oci_core_vcn.env.id
  display_name   = "${local.name}-web"
}

resource "oci_core_network_security_group_security_rule" "web_tcp_3206" {
  network_security_group_id = oci_core_network_security_group.web.id
  description               = "published"
  direction                 = "INGRESS"
  protocol                  = "6"
  source                    = var.allowed_cidr
  source_type               = "CIDR_BLOCK"
  tcp_options {
    destination_port_range {
      min = 3206
      max = 3206
    }
  }
}

# Machine `web`, at its fixed address 10.20.0.31.
resource "oci_core_instance" "web" {
  compartment_id      = var.compartment_id
  freeform_tags       = local.tags
  availability_domain = data.oci_identity_availability_domains.ads.availability_domains[0].name
  display_name        = "${local.name}-web"
  shape               = "VM.Standard.E4.Flex"
  shape_config {
    ocpus         = 1
    memory_in_gbs = 1
  }
  source_details {
    source_type             = "image"
    source_id               = data.oci_core_images.ubuntu_2404.images[0].id
    boot_volume_size_in_gbs = 50
  }
  create_vnic_details {
    subnet_id              = oci_core_subnet.lab.id
    private_ip             = "10.20.0.31"
    assign_public_ip       = true
    hostname_label         = "web"
    skip_source_dest_check = false
    nsg_ids                = [oci_core_network_security_group.web.id]
  }
  metadata = {
    ssh_authorized_keys = var.ssh_public_key
    user_data           = base64encode("#!/bin/sh\n# Isoloom: this machine sets itself up. Its progress is in /var/lib/isoloom/ready (isoloom-ready/1), its output in /var/log/isoloom-setup.log. The Isothrum runner delivers the project over SSH.\nmkdir -p /var/lib/isoloom\ncat > /var/lib/isoloom/setup.sh.new <<'ISOLOOM_SETUP'\n#!/bin/sh\numask 022\ncase \"$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\" in ready|failed:*) exit 0 ;; esac\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\npart=$(cat /var/lib/isoloom/part 2>/dev/null || echo 1)\nif [ \"$part\" = 1 ]; then\necho 'running: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; { i=0; until [ -f /var/lib/isoloom/project-delivered ]; do i=$((i+5)); if [ $i -gt 2400 ]; then echo 'the project never came: start the lab through the Isothrum runner (run.json), which delivers it over SSH' >&2; exit 1; fi; sleep 5; done; } || { echo 'failed: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; exit 1; }\necho 'running: hosts file' > /var/lib/isoloom/ready; { sh -c 'printf '\\''%s\\n'\\'' '\\''10.20.0.32 database'\\'' '\\''10.20.0.31 web'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'; } || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }\necho 'running: waiting for database' > /var/lib/isoloom/ready; { sh -c 'i=0; until (bash -c '\\''</dev/tcp/database/3207'\\'' 2>/dev/null || nc -z -w 2 database 3207 2>/dev/null); do i=$((i+2)); if [ $i -ge 900 ]; then echo \"database didn'\\''t answer within 900s\" >&2; exit 1; fi; sleep 2; done; echo \"database answers\"'; } || { echo 'failed: waiting for database' > /var/lib/isoloom/ready; exit 1; }\necho 'running: provision/web.sh' > /var/lib/isoloom/ready; { sh -c 'cd /opt/isoloom && sh -c '\\''sh provision/web.sh'\\'''; } || { echo 'failed: provision/web.sh' > /var/lib/isoloom/ready; exit 1; }\necho 'running: health check' > /var/lib/isoloom/ready; { sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'; } || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }\nfi\necho ready > /var/lib/isoloom/ready\nrm -f /var/lib/isoloom/part\ncommand -v systemctl >/dev/null && systemctl disable isoloom-setup.service >/dev/null 2>&1\nexit 0\nISOLOOM_SETUP\nmv -f /var/lib/isoloom/setup.sh.new /var/lib/isoloom/setup.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-setup.service <<'ISOLOOM_UNIT'\n[Unit]\nDescription=Isoloom: the machine's set-up\nWants=network-online.target\nAfter=network-online.target cloud-final.service google-startup-scripts.service\n\n[Service]\nType=oneshot\nExecStart=/bin/sh /var/lib/isoloom/setup.sh\nStandardOutput=append:/var/log/isoloom-setup.log\nStandardError=append:/var/log/isoloom-setup.log\nTimeoutStartSec=0\n\n[Install]\nWantedBy=multi-user.target\nISOLOOM_UNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-setup.service >/dev/null 2>&1\nsystemctl start --no-block isoloom-setup.service\nelse\nnohup sh /var/lib/isoloom/setup.sh >> /var/log/isoloom-setup.log 2>&1 &\nfi\n")
  }
}

output "machines" {
  value = { database = oci_core_instance.database.public_ip, web = oci_core_instance.web.public_ip }
}

output "address_database" {
  value = oci_core_instance.database.public_ip
}

output "address_web" {
  value = oci_core_instance.web.public_ip
}

output "ssh_users" {
  value = { database = "ubuntu", web = "ubuntu" }
}

output "ip" {
  value = oci_core_instance.database.public_ip
}

output "ready_file" {
  value = "/var/lib/isoloom/ready"
}

# The checks: each runner on the machine it stands for (ssh <user>@<host> '<command>'), or `isothrum check .`.
output "checks" {
  value = [
    {
      position = "database"
      machine  = "database"
      host     = oci_core_instance.database.public_ip
      user     = "ubuntu"
      command  = "cd /opt/isoloom && sh .isoloom/cloud-vm/checks/database.sh"
    },
    {
      position = "web"
      machine  = "web"
      host     = oci_core_instance.web.public_ip
      user     = "ubuntu"
      command  = "cd /opt/isoloom && sh .isoloom/cloud-vm/checks/web.sh"
    }
  ]
}

output "published" {
  value = { "web/portal" = "${oci_core_instance.web.public_ip}:3206" }
}

## .isoloom/cloud-vm/oci/run.json
{
  "$schema": "https://www.isoloom.com/schema/run-manifest/v0.json",
  "manifest_version": 0,
  "generator": {
    "name": "isoloom",
    "version": "1.0.2"
  },
  "environment": {
    "name": "supplier-portal-api",
    "instance": null,
    "message": null
  },
  "target": "cloud-vm",
  "cloud": "oci",
  "driver": "terraform",
  "hosts": [
    "linux",
    "macos",
    "windows"
  ],
  "tools": [
    {
      "name": "terraform",
      "probe": [
        "terraform",
        "version"
      ],
      "min_version": "1.11.0"
    },
    {
      "name": "ssh",
      "probe": [
        "ssh",
        "-V"
      ]
    }
  ],
  "identity": {
    "terraform": {
      "module": ".",
      "state": "runner"
    }
  },
  "params": [
    {
      "name": "compartment_id",
      "description": "The compartment the environment goes in.",
      "required": true,
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "compartment_id"
        }
      ]
    },
    {
      "name": "region",
      "description": "The OCI region to launch in.",
      "default": "eu-paris-1",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "region"
        }
      ]
    },
    {
      "name": "config_file_profile",
      "description": "The profile of the OCI CLI's configuration (~/.oci/config) the provider signs in with.",
      "default": "DEFAULT",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "config_file_profile"
        }
      ]
    },
    {
      "name": "allowed_cidr",
      "description": "Who may reach the machines (SSH and the published ports), e.g. your IP/32.",
      "required": true,
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "allowed_cidr"
        }
      ]
    },
    {
      "name": "ISOLOOM_DERIVED",
      "description": "0: the checks derived from the spec (reachability, no internet) are skipped.",
      "default": "1",
      "values": [
        "0",
        "1"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_DERIVED",
          "steps": [
            "check-networks",
            "check-database",
            "check-web"
          ]
        }
      ]
    }
  ],
  "secrets": [
    {
      "name": "API_URL",
      "kind": "input",
      "required": false,
      "sensitive": false,
      "machines": [
        "database"
      ],
      "default": "",
      "deliver": [
        {
          "via": "tf_var",
          "var": "inputs",
          "shape": "map_entry"
        }
      ]
    },
    {
      "name": "input-launch-token",
      "kind": "secret",
      "required": false,
      "sensitive": true,
      "machines": [
        "database"
      ],
      "default": "",
      "deliver": [
        {
          "via": "guest",
          "machine": "database",
          "transport": "ssh"
        }
      ]
    }
  ],
  "networks": [
    {
      "name": "lab",
      "cidr": "10.20.0.0/24",
      "internet": true,
      "native": "lab"
    }
  ],
  "machines": [
    {
      "name": "database",
      "role": "target",
      "os": "debian-12",
      "arch": "amd64",
      "addresses": {
        "lab": "10.20.0.32"
      },
      "ports": [
        {
          "name": "mysql",
          "port": 3207,
          "protocol": "tcp",
          "http": false
        }
      ]
    },
    {
      "name": "web",
      "role": "target",
      "os": "debian-12",
      "arch": "amd64",
      "addresses": {
        "lab": "10.20.0.31"
      },
      "ports": [
        {
          "name": "portal",
          "port": 3206,
          "protocol": "tcp",
          "http": true,
          "publish": {
            "mode": "fixed",
            "preferred": 3206,
            "address": "${outputs.address_web}"
          }
        }
      ]
    }
  ],
  "lifecycle": {
    "up": [
      {
        "id": "clear-lock",
        "action": "terraform.clear_lock"
      },
      {
        "id": "init",
        "note": "Preparing Terraform and its providers…",
        "argv": [
          "terraform",
          "init",
          "-input=false",
          "-no-color",
          "-backend-config=path=${run.state_dir}/terraform.tfstate"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 900
      },
      {
        "id": "apply",
        "note": "Creating the lab's machines in the cloud…",
        "argv": [
          "terraform",
          "apply",
          "-auto-approve",
          "-input=false",
          "-no-color"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 3600
      },
      {
        "id": "archive",
        "note": "Archiving the project…",
        "action": "project.archive",
        "with": {
          "root": "../../.."
        }
      },
      {
        "id": "deliver-database",
        "note": "Copying the project into database…",
        "action": "ssh.run",
        "with": {
          "command": "sudo sh -c 'mkdir -p /opt/isoloom /var/lib/isoloom && tar -xzf - -C /opt/isoloom && touch /var/lib/isoloom/project-delivered'",
          "host": "${outputs.address_database}",
          "user": "ubuntu",
          "wait_s": "900"
        },
        "stdin": "${run.state_dir}/project.tgz",
        "timeout_s": 1500
      },
      {
        "id": "deliver-web",
        "note": "Copying the project into web…",
        "action": "ssh.run",
        "with": {
          "command": "sudo sh -c 'mkdir -p /opt/isoloom /var/lib/isoloom && tar -xzf - -C /opt/isoloom && touch /var/lib/isoloom/project-delivered'",
          "host": "${outputs.address_web}",
          "user": "ubuntu",
          "wait_s": "900"
        },
        "stdin": "${run.state_dir}/project.tgz",
        "timeout_s": 1500
      }
    ],
    "down": [
      {
        "id": "clear-lock",
        "action": "terraform.clear_lock"
      },
      {
        "id": "init",
        "note": "Preparing Terraform and its providers…",
        "argv": [
          "terraform",
          "init",
          "-input=false",
          "-no-color",
          "-backend-config=path=${run.state_dir}/terraform.tfstate"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 900
      },
      {
        "id": "destroy",
        "note": "Removing the lab from the cloud…",
        "argv": [
          "terraform",
          "destroy",
          "-auto-approve",
          "-input=false",
          "-no-color"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 3600
      }
    ],
    "status": {
      "id": "state",
      "action": "terraform.read_state"
    }
  },
  "ready": [
    {
      "kind": "step_ok",
      "step": "apply",
      "means": "the machines exist and booted; each sets itself up from its user data once the project is in"
    },
    {
      "kind": "ready_file",
      "host": "${outputs.address_database}",
      "user": "ubuntu",
      "path": "${outputs.ready_file}",
      "log": "/var/log/isoloom-setup.log",
      "grammar": "isoloom-ready/1",
      "timeout_s": 2400,
      "unreachable_timeout_s": 600,
      "interval_s": 10
    },
    {
      "kind": "ready_file",
      "host": "${outputs.address_web}",
      "user": "ubuntu",
      "path": "${outputs.ready_file}",
      "log": "/var/log/isoloom-setup.log",
      "grammar": "isoloom-ready/1",
      "timeout_s": 2400,
      "unreachable_timeout_s": 600,
      "interval_s": 10
    }
  ],
  "outputs": [
    {
      "name": "ip",
      "description": "Where to stand: the access machine's public address (the first Linux machine's, else the controller's).",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ip"
      }
    },
    {
      "name": "ready_file",
      "description": "Where each Linux machine's set-up says how far it got (isoloom-ready/1).",
      "role": "info",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ready_file"
      }
    },
    {
      "name": "address_database",
      "description": "database's public address: the runner's SSH and its published ports reach it there.",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "address_database"
      }
    },
    {
      "name": "address_web",
      "description": "web's public address: the runner's SSH and its published ports reach it there.",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "address_web"
      }
    },
    {
      "name": "web_portal",
      "description": "web's portal (port 3206).",
      "role": "entry",
      "sensitive": false,
      "format": "http://${outputs.address_web}:${value}/",
      "from": {
        "kind": "published_port",
        "machine": "web",
        "port": "portal"
      }
    }
  ],
  "checks": {
    "protocol": "isoloom-check/1",
    "setup": [],
    "runners": [
      {
        "id": "networks",
        "from": "from database",
        "checks": [
          {
            "name": "build/check/check.sh",
            "kind": "script",
            "wait_s": 0,
            "derived": false
          }
        ],
        "step": {
          "id": "check-networks",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} sh .isoloom/cloud-vm/checks/networks.sh",
            "host": "${outputs.address_database}",
            "user": "ubuntu"
          },
          "timeout_s": 75
        }
      },
      {
        "id": "database",
        "from": "from database",
        "checks": [
          {
            "name": "web:3206 from database",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          }
        ],
        "step": {
          "id": "check-database",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} sh .isoloom/cloud-vm/checks/database.sh",
            "host": "${outputs.address_database}",
            "user": "ubuntu"
          },
          "timeout_s": 105
        }
      },
      {
        "id": "web",
        "from": "from web",
        "checks": [
          {
            "name": "database:3207 from web",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          }
        ],
        "step": {
          "id": "check-web",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} sh .isoloom/cloud-vm/checks/web.sh",
            "host": "${outputs.address_web}",
            "user": "ubuntu"
          },
          "timeout_s": 105
        }
      }
    ],
    "teardown": []
  },
  "recovery": {
    "retries": 0,
    "apply_retries": 1
  },
  "expiry": {
    "tf_var": "expires_at",
    "unit": "unix_seconds",
    "default_minutes": 240
  }
}

