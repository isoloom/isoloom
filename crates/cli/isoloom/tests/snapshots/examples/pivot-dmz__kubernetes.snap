spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      isoloom.com/machine: user
  template:
    metadata:
      labels:
        isoloom.com/machine: user
        net.isoloom.com/access: member
    spec:
      hostname: user
      containers:
      - name: user
        image: kalilinux/kali-rolling@sha256:02f5d6c019e549b0f55da58e835cad5355ef1030c6b2645265a324e37dfc4acc
        imagePullPolicy: IfNotPresent
        command:
        - sleep
        - infinity
      nodeSelector:
        kubernetes.io/arch: amd64
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: isoloom-default-deny
spec:
  podSelector: {}
  policyTypes:
  - Ingress
---
apiVersion: networking.k8s.io/v1
