## .isoloom/kubernetes/kustomization.yaml
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# The project's scripts the pods run (init jobs, checks), from the chart's copies (`isoloom generate` writes them).
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
namespace: isoloom-pivot-dmz
resources:
- environment.yaml
generatorOptions:
  disableNameSuffixHash: true
configMapGenerator:
- name: isoloom-scripts
  files:
  - checks__dmz-reachable.sh=chart/files/project/checks/dmz-reachable.sh
  - checks__internal-not-reachable-from-access.sh=chart/files/project/checks/internal-not-reachable-from-access.sh

