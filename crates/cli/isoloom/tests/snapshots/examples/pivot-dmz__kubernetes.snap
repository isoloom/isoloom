## .isoloom/kubernetes/checks/job.yaml
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# The environment's checks, one Job per position. Run after the environment (or `isothrum check .`):
#   kubectl -n isoloom-pivot-dmz delete job isoloom-check isoloom-check-gateway isoloom-check-app isoloom-check-db --ignore-not-found
#   kubectl apply -k .isoloom/kubernetes/checks
#   kubectl -n isoloom-pivot-dmz wait --for=condition=complete job --all --timeout=300s; kubectl -n isoloom-pivot-dmz logs -l isoloom.com/check
apiVersion: batch/v1
kind: Job
metadata:
  name: isoloom-check
spec:
  backoffLimit: 0
  template:
    metadata:
      labels:
        net.isoloom.com/access: member
        isoloom.com/check: isoloom-check
    spec:
      restartPolicy: Never
      containers:
      - name: check
        image: curlimages/curl:8.11.1
        command:
        - /bin/sh
        - /isoloom/run/user.sh
        volumeMounts:
        - name: runner
          mountPath: /isoloom/run
        - name: scripts
          mountPath: /isoloom/scripts
      volumes:
      - name: runner
        configMap:
          name: isoloom-check-runners
          defaultMode: 493
      - name: scripts
        configMap:
          name: isoloom-scripts
          defaultMode: 493
---
apiVersion: batch/v1
kind: Job
metadata:
  name: isoloom-check-gateway
spec:
  backoffLimit: 0
  template:
    metadata:
      labels:
        net.isoloom.com/dmz: member
        net.isoloom.com/internal: member
        isoloom.com/check: isoloom-check-gateway
    spec:
      restartPolicy: Never
      containers:
      - name: check
        image: curlimages/curl:8.11.1
        command:
        - /bin/sh
        - /isoloom/run/gateway.sh
        volumeMounts:
        - name: runner
          mountPath: /isoloom/run
      volumes:
      - name: runner
        configMap:
          name: isoloom-check-runners
          defaultMode: 493
---
apiVersion: batch/v1
kind: Job
metadata:
  name: isoloom-check-app
spec:
  backoffLimit: 0
  template:
    metadata:
      labels:
        net.isoloom.com/internal: member
        isoloom.com/check: isoloom-check-app
    spec:
      restartPolicy: Never
      containers:
      - name: check
        image: curlimages/curl:8.11.1
        command:
        - /bin/sh
        - /isoloom/run/app.sh
        volumeMounts:
        - name: runner
          mountPath: /isoloom/run
      volumes:
      - name: runner
        configMap:
          name: isoloom-check-runners
          defaultMode: 493
---
apiVersion: batch/v1
kind: Job
metadata:
  name: isoloom-check-db
spec:
  backoffLimit: 0
  template:
    metadata:
      labels:
        net.isoloom.com/internal: member
        isoloom.com/check: isoloom-check-db
    spec:
      restartPolicy: Never
      containers:
      - name: check
        image: curlimages/curl:8.11.1
        command:
        - /bin/sh
        - /isoloom/run/db.sh
        volumeMounts:
        - name: runner
          mountPath: /isoloom/run
      volumes:
      - name: runner
        configMap:
          name: isoloom-check-runners
          defaultMode: 493

## .isoloom/kubernetes/checks/kustomization.yaml
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
namespace: isoloom-pivot-dmz
resources:
- job.yaml
generatorOptions:
  disableNameSuffixHash: true
configMapGenerator:
- name: isoloom-check-runners
  files:
  - user.sh
  - gateway.sh
  - app.sh
  - db.sh

