          "protocol": "http",
          "publish": 3206,
          "published": 3206,
          "url": "http://127.0.0.1:3206/",
          "fixed": true
        }
      },
      "depends_on": [
        "database"
      ],
      "inputs": [],
      "volumes": {},
      "resources": {
        "cpus": 1,
        "memory_mb": 1024,
        "disk_gb": 20
      },
      "gateway_of": [],
      "routes": [],
      "default_gateway": null,
      "offline": false,
      "os_family": "debian",
      "os_version": "12"
    }
  },
  "start_order": [
    "database",
    "web"
  ],
  "clones": {},
  "tools": {},
  "groups": {},
  "router": null,
  "controller": {
    "role": "infra",
    "keep_running": false,
    "addresses": {
      "lab": "10.20.0.253"
    }
  },
  "published": [
    {
      "machine": "web",
      "name": "portal",
      "port": 3206,
      "protocol": "http",
      "host_port": 3206
    }
  ],
  "targets": {
    "possible": [
      "docker",
      "hosted",
      "docker-vm",
      "cloud-docker",
      "kubernetes",
      "vagrant",
      "proxmox",
      "esxi",
      "cloud-vm"
    ],
    "generated": [
      "docker",
      "hosted",
      "docker-vm",
      "cloud-docker",
      "kubernetes",
      "vagrant",
      "proxmox",
      "esxi",
      "cloud-vm"
    ],
    "refused": {},
    "not_possible": {
      "hybrid": "only when some machines are containers and others are VMs",
      "external": "overrides.external.machines.database: the external target reaches machines that exist already, and `database` names no host",
      "cloud-services": "left out by `targets:`"
    },
    "clouds": {
      "cloud-vm": {
        "generated": [
          "aws",
          "azure",
          "gcp",
          "linode",
          "oci"
        ],
        "refused": {
          "digitalocean": "DigitalOcean cloud-vm takes one machine on one network: a droplet joins one VPC, at a private address DigitalOcean picks, so other machines couldn't reach it at its spec address"
        }
      }
    }
  },
  "checks": {
    "default_position": "networks",
    "positions": [
      {
        "position": "networks",
        "machine": null,
        "runner": "isoloom-check",
        "checks": [
          {
            "name": "build/check/check.sh",
            "derived": false,
            "kind": "script",
            "target": "build/check/check.sh",
            "expect": "",
            "wait": 0
          }
        ]
      },
      {
        "position": "database",
        "machine": "database",
        "runner": "isoloom-check-database",
        "checks": [
          {
            "name": "web:3206 from database",
            "derived": true,
            "kind": "http",
            "target": "http://10.20.0.31:3206/",
            "expect": "any",
            "wait": 30
          }
        ]
      },
      {
        "position": "web",
        "machine": "web",
        "runner": "isoloom-check-web",
        "checks": [
          {
            "name": "database:3207 from web",
            "derived": true,
            "kind": "tcp",
            "target": "10.20.0.32:3207",
            "expect": "open",
            "wait": 30
          }
        ]
      }
    ]
  }
}
