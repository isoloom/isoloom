    "resume": [
      {
        "id": "discard-saved",
        "action": "vagrant.discard_aborted_saved",
        "failure": "tolerate",
        "providers": [
          "virtualbox"
        ]
      },
      {
        "id": "resume",
        "argv": [
          "vagrant",
          "up",
          "--no-provision",
          "--provider",
          "${run.provider}",
          "fw",
          "web",
          "cache",
          "user"
        ],
        "timeout_s": 3600,
        "failure": "tolerate"
      },
      {
        "id": "discard-cut-off",
        "action": "vagrant.discard_aborted_saved",
        "failure": "tolerate",
        "providers": [
          "virtualbox"
        ]
      },
      {
        "id": "boot",
        "argv": [
          "vagrant",
          "up",
          "--no-provision",
          "--provider",
          "${run.provider}",
          "fw",
          "web",
          "cache",
          "user"
        ],
        "timeout_s": 3600
      }
    ],
    "provision": {
      "all": [
        {
          "id": "provision",
          "argv": [
            "vagrant",
            "provision",
            "fw",
            "web",
            "cache",
            "user"
          ],
          "timeout_s": 7200
        }
      ],
      "machine": [
        {
          "id": "provision-machine",
          "argv": [
            "vagrant",
            "provision",
            "${machine}"
          ],
          "timeout_s": 7200
        }
      ]
    },
    "status": {
      "id": "status",
      "argv": [
        "vagrant",
        "status",
        "--machine-readable"
      ],
      "timeout_s": 25,
      "provider_timeout_s": {
        "vmware_esxi": 180
      }
    }
  },
  "ready": [
    {
      "kind": "step_ok",
      "step": "up",
      "means": "every VM booted and ran its provisioners, the controller's playbooks included"
    },
    {
      "kind": "machines_running",
      "machines": [
        "fw",
        "web",
        "cache",
        "user"
      ]
    }
  ],
  "outputs": [],
  "checks": {
    "protocol": "isoloom-check/1",
    "setup": [],
    "runners": [
      {
        "id": "fw",
        "from": "from fw",
        "checks": [
          {
            "name": "web:80 from fw",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "cache:6379 from fw",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          }
        ],
        "step": {
          "id": "check-fw",
          "argv": [
            "vagrant",
            "provision",
            "fw",
            "--provision-with",
            "checks"
          ],
          "timeout_s": 150
        }
      },
      {
        "id": "web",
        "from": "from web",
        "checks": [
          {
            "name": "fw:8080 on dmz from web",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "cache:6379 from web",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          }
        ],
        "step": {
          "id": "check-web",
          "argv": [
            "vagrant",
            "provision",
            "web",
            "--provision-with",
            "checks"
          ],
          "timeout_s": 150
        }
      },
      {
        "id": "cache",
        "from": "from cache",
        "checks": [
          {
            "name": "fw:8080 on lan from cache",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "web:80 blocked from cache",
            "kind": "tcp",
            "wait_s": 0,
            "derived": true
          },
          {
            "name": "no internet from cache",
            "kind": "http",
            "wait_s": 0,
            "derived": true
          }
        ],
        "step": {
          "id": "check-cache",
          "argv": [
            "vagrant",
            "provision",
            "cache",
            "--provision-with",
            "checks"
          ],
          "timeout_s": 135
        }
      },
      {
        "id": "user",
        "from": "from user",
        "checks": [
          {
            "name": "the web page answers through the firewall",
            "kind": "script",
            "wait_s": 0,
            "derived": false
          },
          {
            "name": "the web server answers by its other name",
            "kind": "http",
            "wait_s": 30,
            "derived": false
          },
          {
            "name": "fw:8080 on outside from user",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "web:80 from user",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "cache:6379 blocked from user",
            "kind": "tcp",
            "wait_s": 0,
            "derived": true
          }
        ],
        "step": {
          "id": "check-user",
          "argv": [
            "vagrant",
            "provision",
            "user",
            "--provision-with",
            "checks"
          ],
          "timeout_s": 225
        }
      }
    ],
    "teardown": []
  },
  "recovery": {
    "stale_markers": [
      "verr_already_exists",
      "could not rename",
      "is locked",
      "different provider",
      "single provider at a time"
    ],
    "steps": [
      {
        "id": "destroy",
        "note": "Clearing what an earlier run left, then starting again…",
        "argv": [
          "vagrant",
          "destroy",
          "--force"
        ],
        "timeout_s": 180,
        "when": "always",
        "failure": "tolerate"
      },
      {
        "id": "orphans",
        "action": "vagrant.remove_orphans",
        "when": "always",
        "failure": "tolerate",
        "providers": [
          "virtualbox",
          "parallels"
        ]
      },
      {
        "id": "reset",
        "action": "vagrant.reset_state",
        "when": "always"
      }
    ],
    "retries": 1
  }
}
