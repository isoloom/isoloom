  config.vm.define "user", autostart: false do |m|
    m.vm.box = ENV.fetch("ISOLOOM_ACCESS_BOX", "bento/debian-12")
    m.vm.hostname = "user"
    m.vm.network "private_network", ip: "10.70.0.10", netmask: "255.255.255.0", virtualbox__intnet: "isoloom-edge-firewall-outside", libvirt__network_name: "isoloom-edge-firewall-outside", libvirt__dhcp_enabled: false
    m.vm.provider "virtualbox" do |v|
      v.name = "edge-firewall · user"
      v.linked_clone = true
      v.cpus = 1
      v.memory = 1024
    end
    m.vm.provider "vmware_desktop" do |v|
      v.vmx["displayName"] = "edge-firewall · user"
      v.vmx["numvcpus"] = "1"
      v.vmx["memsize"] = "1024"
    end
    m.vm.provider "parallels" do |v|
      v.name = "edge-firewall · user"
      v.linked_clone = true
      v.cpus = 1
      v.memory = 1024
    end
    m.vm.provider "utm" do |v|
      v.name = "edge-firewall · user"
      v.cpus = 1
      v.memory = 1024
    end
    m.vm.provider "qemu" do |v, o|
      o.vm.box = "cloud-image/debian-12"
      o.vm.box_version = ">= 0"
      o.vm.box_architecture = "amd64"
      v.arch = "x86_64"
      v.smp = "cpus=1"
      v.memory = "1024M"
      v.ssh_auto_correct = true
      v.advanced_network = true
      v.net_mode = :socket
      v.socket_opts = "connect=127.0.0.1:35675"
      if "x86_64" != HOST_ARCH
        v.smp = "cpus=1"
        o.vm.boot_timeout = 3600
      end
    end
    m.vm.provider "vmware_esxi" do |v|
      v.esxi_hostname = ENV.fetch("ESXI_HOSTNAME", "")
      v.esxi_hostport = ENV.fetch("ESXI_HOSTPORT", "22").to_i
      v.esxi_username = ENV.fetch("ESXI_USERNAME", "root")
      v.esxi_password = "env:ESXI_PASSWORD"
      v.esxi_disk_store = ENV["ESXI_DATASTORE"] if ENV["ESXI_DATASTORE"]
      v.esxi_virtual_network = esxi_networks(["outside"])
      v.guest_name = "edge-firewall-user"
      v.guest_numvcpus = 1
      v.guest_memsize = 1024
    end
    m.vm.provider "libvirt" do |v, o|
      o.vm.box = "generic/debian12"
      o.vm.box_architecture = "amd64"
      v.cpus = 1
      v.memory = 1024
      v.machine_arch = "x86_64"
    end
    m.vm.provider "hyperv" do |v, o|
      o.vm.box = "generic/debian12"
      o.vm.box_version = "4.3.12"
      v.vmname = "edge-firewall-user"
      v.cpus = 1
      v.memory = 1024
      v.linked_clone = true
      o.vm.network "private_network", bridge: HYPERV_SWITCH
    end
    m.trigger.before :"VagrantPlugins::HyperV::Action::Configure", type: :action do |t|
      t.ruby { |_, _| IsoloomHyperV.switches(["isoloom-edge-firewall-outside"]) }
    end
    m.trigger.before :"VagrantPlugins::HyperV::Action::StartInstance", type: :action do |t|
      t.ruby { |_, machine| IsoloomHyperV.attach(machine, [["isoloom-edge-firewall-outside", "0215C62A8821"]]) }
    end
    m.trigger.after :"VagrantPlugins::HyperV::Action::WaitForIPAddress", type: :action do |t|
      t.ruby do |_, machine|
        IsoloomHyperV.address(machine, <<~'SH')
          set -e
          mkdir -p /etc/isoloom
          cat > /etc/isoloom/lab-net.sh <<'NET'
          #!/bin/sh
          # This machine's addresses on the isoloom networks (Hyper-V sets none), by adapter MAC.
          lab() {
            for d in /sys/class/net/*; do
              [ "$(cat "$d/address" 2>/dev/null)" = "$1" ] || continue
              IF=${d##*/}
              if command -v nmcli >/dev/null; then nmcli device set "$IF" managed no 2>/dev/null || true; fi
              ip link set "$IF" up
              ip -4 addr show dev "$IF" | grep -q " $2 " || ip addr add "$2" dev "$IF"
              return 0
            done
            echo "isoloom: no network adapter with MAC $1" >&2
            return 1
          }
          rc=0
          lab 02:15:c6:2a:88:21 10.70.0.10/24 || rc=1
          exit $rc
          NET
          chmod +x /etc/isoloom/lab-net.sh
          # NetworkManager would try DHCP there.
          if [ -d /etc/NetworkManager/conf.d ]; then
            printf '[keyfile]\nunmanaged-devices=mac:02:15:c6:2a:88:21\n' > /etc/NetworkManager/conf.d/90-isoloom-lab.conf
          fi
          if [ -d /run/systemd/system ]; then
            cat > /etc/systemd/system/isoloom-lab-net.service <<'UNIT'
          [Unit]
          Description=Addresses on the isoloom networks
          After=network-pre.target NetworkManager.service systemd-networkd.service
          Before=network-online.target isoloom-routes.service

          [Service]
          Type=oneshot
          RemainAfterExit=yes
          ExecStart=/etc/isoloom/lab-net.sh

          [Install]
          WantedBy=multi-user.target
          UNIT
            systemctl daemon-reload
            systemctl enable -q isoloom-lab-net.service
          elif command -v rc-update >/dev/null; then
            printf '#!/bin/sh\nexec /etc/isoloom/lab-net.sh\n' > /etc/local.d/isoloom-lab-net.start
            chmod +x /etc/local.d/isoloom-lab-net.start
            rc-update add local default >/dev/null
          fi
          /etc/isoloom/lab-net.sh
        SH
      end
    end
    m.trigger.after :"VagrantPlugins::HyperV::Action::DeleteVM", type: :action do |t|
      t.ruby { |_, _| IsoloomHyperV.prune(["isoloom-edge-firewall-outside"]) }
    end
    m.vm.provision "isoloom_project", name: "project"
    m.vm.provision "shell", name: "hosts", inline: "printf '%s\\n' '10.70.0.5 fw' '10.70.10.10 web www.edge.test' '10.70.20.20 cache' '10.70.0.10 user' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '%s\\n' \"$l\" >> /etc/hosts; done"
    m.vm.provision "shell", name: "routes", inline: <<~'SH'
      mkdir -p /etc/isoloom
      cat > /etc/isoloom/routes.sh <<'ROUTES'
      #!/bin/sh
      # Routes to the other isoloom networks
      ip route replace 10.70.10.0/24 via 10.70.0.5
      ip route replace 10.70.20.0/24 via 10.70.0.5
      exit 0
      ROUTES
      chmod +x /etc/isoloom/routes.sh
      for d in /etc/network/if-up.d /etc/networkd-dispatcher/routable.d; do
        if [ -d "$d" ]; then ln -sf /etc/isoloom/routes.sh "$d/zz-isoloom-routes"; fi
      done
      if command -v systemctl >/dev/null; then
      cat > /etc/systemd/system/isoloom-routes.service <<'UNIT'
      [Unit]
      Description=Routes to the other isoloom networks
      After=network-online.target isoloom-trunks.service
      Wants=network-online.target

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      ExecStart=-/etc/isoloom/routes.sh

      [Install]
      WantedBy=multi-user.target
      UNIT
      systemctl daemon-reload
      systemctl enable isoloom-routes.service
      systemctl restart isoloom-routes.service
      else
      mkdir -p /etc/local.d && ln -sf /etc/isoloom/routes.sh /etc/local.d/isoloom-routes.start
      rc-update add local default >/dev/null 2>&1 || true
      /etc/isoloom/routes.sh || true
      fi
    SH
    m.vm.provision "shell", name: "ready", inline: "mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready"
    m.vm.provision "shell", name: "checks", run: "never", inline: ["checks/web-through-firewall.sh"].map { |p| "mkdir -p /opt/isoloom/#{File.dirname(p)} && cat > /opt/isoloom/#{p} <<'ISOLOOM_EOF'\n#{File.read(File.join(ROOT, p))}\nISOLOOM_EOF\n" }.join + File.read(File.join(__dir__, "checks/user.sh")), env: { "ISOLOOM_DERIVED" => ENV.fetch("ISOLOOM_DERIVED", "1") }
  end
end

## .isoloom/vagrant/checks/cache.sh
#!/bin/sh
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# The environment's checks, from cache. `isothrum check` runs it and reads the PASS/FAIL lines.
passed=0; failed=0
pass() { passed=$((passed+1)); echo "isoloom-check: PASS $1"; }
fail() { failed=$((failed+1)); echo "isoloom-check: FAIL $1: $2"; }
# _http URL [follow] -> the status code, 000 when nothing answers (curl, else wget, else bash):
# the first answer's, or with `follow` the last one's after at most 5 redirects (bash: the first).
_http() {
  if command -v curl >/dev/null 2>&1; then
    if [ -n "$2" ]; then set -- "$1" -L --max-redirs 5; else set -- "$1"; fi
    c=$(curl -sk -o /dev/null -m 5 -w '%{http_code}' "$@" 2>/dev/null)
  elif command -v wget >/dev/null 2>&1; then
    # wget follows redirects whatever it's told (busybox's can't be told): -S prints each answer.
    if [ -n "$2" ]; then _n=6; else _n=1; fi
    c=$(wget -q -S -O /dev/null -T 5 --no-check-certificate "$1" 2>&1 | sed -n 's/^ *HTTP\/[0-9.]* \([0-9][0-9][0-9]\).*/\1/p' | head -n $_n | tail -n 1)
  else
    u=${1#*://}; hp=${u%%/*}; p=/${u#*/}; [ "$u" = "$hp" ] && p=/
    h=${hp%%:*}; port=${hp#*:}; [ "$hp" = "$h" ] && port=80
    # shellcheck disable=SC2016 # the inner bash expands $H, $P and $U, for its /dev/tcp
    c=$(H=$h P=$port U=$p timeout 5 bash -c 'exec 3<>/dev/tcp/$H/$P && printf "GET %s HTTP/1.0\r\nHost: %s\r\n\r\n" "$U" "$H" >&3 && read -r l <&3 && echo "$l"' 2>/dev/null | sed -n 's/^HTTP\/[0-9.]* \([0-9][0-9][0-9]\).*/\1/p')
  fi
  echo "${c:-000}"
}
_http_is() { [ "$(_http "$1" "$3")" = "$2" ]; }
# _req STATUS|any TEXT CURL-ARGS... -> 0 when the request gets that status (any answer for `any`)
# and its body contains TEXT (if any); $out says why not. Needs curl.
_req() {
  want=$1; text=$2; shift 2
  command -v curl >/dev/null 2>&1 || { out="curl is needed for this check"; return 1; }
  b=$(mktemp); c=$(curl -sk -m 10 -o "$b" -w '%{http_code}' "$@" 2>/dev/null); c=${c:-000}; r=0
  if [ "$want" = any ]; then [ "$c" != 000 ] || r=1; else [ "$c" = "$want" ] || r=1; fi
  if [ $r = 1 ]; then out="expected HTTP $want, got $c"
  elif [ -n "$text" ] && ! grep -qF -- "$text" "$b"; then r=1; out="HTTP $c, but the response doesn't contain the expected text"
  fi
  rm -f "$b"; return $r
}
_http_any() { [ "$(_http "$1" "$2")" != 000 ]; }
# _tcp HOST PORT -> 0 when it connects (nc, else bash).
_tcp() {
  if command -v nc >/dev/null 2>&1; then nc -z -w 5 "$1" "$2" >/dev/null 2>&1
  else
    # shellcheck disable=SC2016 # the inner bash expands $H and $P, for its /dev/tcp
    H=$1 P=$2 timeout 5 bash -c 'exec 3<>/dev/tcp/$H/$P' >/dev/null 2>&1
  fi
}
# _tcp_read HOST PORT LINE TEXT -> 0 when the bytes read within 5s of connecting (after writing
# LINE and a newline, if any) contain TEXT; $out says why not (nc, else bash). Stdin stays open
# while reading (some nc quit at its end), and nc is stopped after 5s whatever its flavor.
_tcp_read() {
  f=$(mktemp); i=0; r=1
  if command -v nc >/dev/null 2>&1; then
    { [ -z "$3" ] || printf '%s\n' "$3"; j=0; while [ ! -e "$f.end" ] && [ $j -lt 6 ]; do sleep 1; j=$((j+1)); done; } | nc "$1" "$2" >"$f" 2>/dev/null &
  else
    # shellcheck disable=SC2016 # the inner bash expands $H, $P and $L, for its /dev/tcp
    H=$1 P=$2 L=$3 timeout 6 bash -c 'exec 3<>/dev/tcp/$H/$P || exit 1; [ -z "$L" ] || printf "%s\n" "$L" >&3; cat <&3' >"$f" 2>/dev/null &
  fi
  p=$!
  while :; do
    if grep -qF -- "$4" "$f"; then r=0; break; fi
    if [ $i -ge 5 ] || ! kill -0 $p 2>/dev/null; then break; fi
    sleep 1; i=$((i+1))
  done
  [ $r = 0 ] || ! grep -qF -- "$4" "$f" || r=0
  touch "$f.end"; kill $p 2>/dev/null
  if [ $r = 1 ]; then
    if [ -s "$f" ]; then out="$1:$2 answered \"$(head -c 100 "$f" | tr -d '\000\r' | tr '\n\t' '  ')\", without the expected text"
    elif [ $i -lt 5 ]; then out="$1:$2 refused the connection or closed it without a word"
    else out="nothing read from $1:$2 within 5s"; fi
  fi
  rm -f "$f" "$f.end"; return $r
}
# _exec COMMAND TEXT -> 0 when the command succeeds and its output contains TEXT (if any).
_exec() { out=$(sh -c "$1" 2>&1) && { [ -z "$2" ] || printf '%s\n' "$out" | grep -qF -- "$2"; }; }
# _retry SECONDS COMMAND... -> keeps trying every 2s until it passes or the time is up.
_retry() { _end=$(( $(date +%s) + $1 )); shift; while ! "$@"; do [ "$(date +%s)" -lt "$_end" ] || return 1; sleep 2; done; }

if [ "${ISOLOOM_DERIVED:-1}" != 0 ]; then
if _retry 30 _http_any 'http://10.70.20.1:8080/'; then pass 'fw:8080 on lan from cache'; else fail 'fw:8080 on lan from cache' "nothing answers at http://10.70.20.1:8080/"; fi
fi

if [ "${ISOLOOM_DERIVED:-1}" != 0 ]; then
if _tcp '10.70.10.10' 80; then fail 'web:80 blocked from cache' "10.70.10.10:80 answered; it should be blocked"; else pass 'web:80 blocked from cache'; fi
fi

if [ "${ISOLOOM_DERIVED:-1}" != 0 ]; then
c=$(_http 'http://1.1.1.1/'); if [ "$c" = 000 ]; then pass 'no internet from cache'; else fail 'no internet from cache' "http://1.1.1.1/ answered (HTTP $c); it should be blocked"; fi
fi

echo "isoloom-check: END $passed passed, $failed failed"
[ "$failed" -eq 0 ]

