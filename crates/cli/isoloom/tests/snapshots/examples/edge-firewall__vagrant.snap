# _tcp HOST PORT -> 0 when it connects (nc, else bash).
_tcp() {
  if command -v nc >/dev/null 2>&1; then nc -z -w 5 "$1" "$2" >/dev/null 2>&1
  else
    # shellcheck disable=SC2016 # the inner bash expands $H and $P, for its /dev/tcp
    H=$1 P=$2 timeout 5 bash -c 'exec 3<>/dev/tcp/$H/$P' >/dev/null 2>&1
  fi
}
# _tcp_read HOST PORT LINE TEXT -> 0 when the bytes read within 5s of connecting (after writing
# LINE and a newline, if any) contain TEXT; $out says why not (nc, else bash). Stdin stays open
# while reading (some nc quit at its end), and nc is stopped after 5s whatever its flavor.
_tcp_read() {
  f=$(mktemp); i=0; r=1
  if command -v nc >/dev/null 2>&1; then
    { [ -z "$3" ] || printf '%s\n' "$3"; j=0; while [ ! -e "$f.end" ] && [ $j -lt 6 ]; do sleep 1; j=$((j+1)); done; } | nc "$1" "$2" >"$f" 2>/dev/null &
  else
    # shellcheck disable=SC2016 # the inner bash expands $H, $P and $L, for its /dev/tcp
    H=$1 P=$2 L=$3 timeout 6 bash -c 'exec 3<>/dev/tcp/$H/$P || exit 1; [ -z "$L" ] || printf "%s\n" "$L" >&3; cat <&3' >"$f" 2>/dev/null &
  fi
  p=$!
  while :; do
    if grep -qF -- "$4" "$f"; then r=0; break; fi
    if [ $i -ge 5 ] || ! kill -0 $p 2>/dev/null; then break; fi
    sleep 1; i=$((i+1))
  done
  [ $r = 0 ] || ! grep -qF -- "$4" "$f" || r=0
  touch "$f.end"; kill $p 2>/dev/null
  if [ $r = 1 ]; then
    if [ -s "$f" ]; then out="$1:$2 answered \"$(head -c 100 "$f" | tr -d '\000\r' | tr '\n\t' '  ')\", without the expected text"
    elif [ $i -lt 5 ]; then out="$1:$2 refused the connection or closed it without a word"
    else out="nothing read from $1:$2 within 5s"; fi
  fi
  rm -f "$f" "$f.end"; return $r
}
# _exec COMMAND TEXT -> 0 when the command succeeds and its output contains TEXT (if any).
_exec() { out=$(sh -c "$1" 2>&1) && { [ -z "$2" ] || printf '%s\n' "$out" | grep -qF -- "$2"; }; }
# _retry SECONDS COMMAND... -> keeps trying every 2s until it passes or the time is up.
_retry() { _end=$(( $(date +%s) + $1 )); shift; while ! "$@"; do [ "$(date +%s)" -lt "$_end" ] || return 1; sleep 2; done; }

echo '== checks/web-through-firewall.sh'
if _retry 0 sh -c 'cd /opt/isoloom && sh checks/web-through-firewall.sh'; then pass 'the web page answers through the firewall'; else fail 'the web page answers through the firewall' "checks/web-through-firewall.sh exited non-zero"; fi

if _retry 30 _http_is 'http://www.edge.test/' 200; then pass 'the web server answers by its other name'; else fail 'the web server answers by its other name' "expected HTTP 200 from http://www.edge.test/, got $(_http 'http://www.edge.test/')"; fi

if [ "${ISOLOOM_DERIVED:-1}" != 0 ]; then
if _retry 30 _http_any 'http://10.70.0.5:8080/'; then pass 'fw:8080 on outside from user'; else fail 'fw:8080 on outside from user' "nothing answers at http://10.70.0.5:8080/"; fi
fi

if [ "${ISOLOOM_DERIVED:-1}" != 0 ]; then
if _retry 30 _http_any 'http://10.70.10.10:80/'; then pass 'web:80 from user'; else fail 'web:80 from user' "nothing answers at http://10.70.10.10:80/"; fi
fi

if [ "${ISOLOOM_DERIVED:-1}" != 0 ]; then
if _tcp '10.70.20.20' 6379; then fail 'cache:6379 blocked from user' "10.70.20.20:6379 answered; it should be blocked"; else pass 'cache:6379 blocked from user'; fi
fi

echo "isoloom-check: END $passed passed, $failed failed"
[ "$failed" -eq 0 ]

## .isoloom/vagrant/checks/web.sh
#!/bin/sh
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# The environment's checks, from web. `isothrum check` runs it and reads the PASS/FAIL lines.
passed=0; failed=0
pass() { passed=$((passed+1)); echo "isoloom-check: PASS $1"; }
fail() { failed=$((failed+1)); echo "isoloom-check: FAIL $1: $2"; }
# _http URL [follow] -> the status code, 000 when nothing answers (curl, else wget, else bash):
# the first answer's, or with `follow` the last one's after at most 5 redirects (bash: the first).
_http() {
  if command -v curl >/dev/null 2>&1; then
    if [ -n "$2" ]; then set -- "$1" -L --max-redirs 5; else set -- "$1"; fi
    c=$(curl -sk -o /dev/null -m 5 -w '%{http_code}' "$@" 2>/dev/null)
  elif command -v wget >/dev/null 2>&1; then
    # wget follows redirects whatever it's told (busybox's can't be told): -S prints each answer.
    if [ -n "$2" ]; then _n=6; else _n=1; fi
    c=$(wget -q -S -O /dev/null -T 5 --no-check-certificate "$1" 2>&1 | sed -n 's/^ *HTTP\/[0-9.]* \([0-9][0-9][0-9]\).*/\1/p' | head -n $_n | tail -n 1)
  else
    u=${1#*://}; hp=${u%%/*}; p=/${u#*/}; [ "$u" = "$hp" ] && p=/
    h=${hp%%:*}; port=${hp#*:}; [ "$hp" = "$h" ] && port=80
    # shellcheck disable=SC2016 # the inner bash expands $H, $P and $U, for its /dev/tcp
    c=$(H=$h P=$port U=$p timeout 5 bash -c 'exec 3<>/dev/tcp/$H/$P && printf "GET %s HTTP/1.0\r\nHost: %s\r\n\r\n" "$U" "$H" >&3 && read -r l <&3 && echo "$l"' 2>/dev/null | sed -n 's/^HTTP\/[0-9.]* \([0-9][0-9][0-9]\).*/\1/p')
  fi
  echo "${c:-000}"
}
_http_is() { [ "$(_http "$1" "$3")" = "$2" ]; }
# _req STATUS|any TEXT CURL-ARGS... -> 0 when the request gets that status (any answer for `any`)
# and its body contains TEXT (if any); $out says why not. Needs curl.
_req() {
  want=$1; text=$2; shift 2
  command -v curl >/dev/null 2>&1 || { out="curl is needed for this check"; return 1; }
  b=$(mktemp); c=$(curl -sk -m 10 -o "$b" -w '%{http_code}' "$@" 2>/dev/null); c=${c:-000}; r=0
  if [ "$want" = any ]; then [ "$c" != 000 ] || r=1; else [ "$c" = "$want" ] || r=1; fi
  if [ $r = 1 ]; then out="expected HTTP $want, got $c"
  elif [ -n "$text" ] && ! grep -qF -- "$text" "$b"; then r=1; out="HTTP $c, but the response doesn't contain the expected text"
  fi
  rm -f "$b"; return $r
}
_http_any() { [ "$(_http "$1" "$2")" != 000 ]; }
# _tcp HOST PORT -> 0 when it connects (nc, else bash).
_tcp() {
  if command -v nc >/dev/null 2>&1; then nc -z -w 5 "$1" "$2" >/dev/null 2>&1
  else
    # shellcheck disable=SC2016 # the inner bash expands $H and $P, for its /dev/tcp
    H=$1 P=$2 timeout 5 bash -c 'exec 3<>/dev/tcp/$H/$P' >/dev/null 2>&1
  fi
}
# _tcp_read HOST PORT LINE TEXT -> 0 when the bytes read within 5s of connecting (after writing
# LINE and a newline, if any) contain TEXT; $out says why not (nc, else bash). Stdin stays open
# while reading (some nc quit at its end), and nc is stopped after 5s whatever its flavor.
_tcp_read() {
  f=$(mktemp); i=0; r=1
  if command -v nc >/dev/null 2>&1; then
    { [ -z "$3" ] || printf '%s\n' "$3"; j=0; while [ ! -e "$f.end" ] && [ $j -lt 6 ]; do sleep 1; j=$((j+1)); done; } | nc "$1" "$2" >"$f" 2>/dev/null &
  else
    # shellcheck disable=SC2016 # the inner bash expands $H, $P and $L, for its /dev/tcp
    H=$1 P=$2 L=$3 timeout 6 bash -c 'exec 3<>/dev/tcp/$H/$P || exit 1; [ -z "$L" ] || printf "%s\n" "$L" >&3; cat <&3' >"$f" 2>/dev/null &
  fi
  p=$!
  while :; do
    if grep -qF -- "$4" "$f"; then r=0; break; fi
    if [ $i -ge 5 ] || ! kill -0 $p 2>/dev/null; then break; fi
    sleep 1; i=$((i+1))
  done
  [ $r = 0 ] || ! grep -qF -- "$4" "$f" || r=0
  touch "$f.end"; kill $p 2>/dev/null
  if [ $r = 1 ]; then
    if [ -s "$f" ]; then out="$1:$2 answered \"$(head -c 100 "$f" | tr -d '\000\r' | tr '\n\t' '  ')\", without the expected text"
    elif [ $i -lt 5 ]; then out="$1:$2 refused the connection or closed it without a word"
    else out="nothing read from $1:$2 within 5s"; fi
  fi
  rm -f "$f" "$f.end"; return $r
}
# _exec COMMAND TEXT -> 0 when the command succeeds and its output contains TEXT (if any).
_exec() { out=$(sh -c "$1" 2>&1) && { [ -z "$2" ] || printf '%s\n' "$out" | grep -qF -- "$2"; }; }
# _retry SECONDS COMMAND... -> keeps trying every 2s until it passes or the time is up.
_retry() { _end=$(( $(date +%s) + $1 )); shift; while ! "$@"; do [ "$(date +%s)" -lt "$_end" ] || return 1; sleep 2; done; }

if [ "${ISOLOOM_DERIVED:-1}" != 0 ]; then
if _retry 30 _http_any 'http://10.70.10.1:8080/'; then pass 'fw:8080 on dmz from web'; else fail 'fw:8080 on dmz from web' "nothing answers at http://10.70.10.1:8080/"; fi
fi

if [ "${ISOLOOM_DERIVED:-1}" != 0 ]; then
if _retry 30 _tcp '10.70.20.20' 6379; then pass 'cache:6379 from web'; else fail 'cache:6379 from web' "nothing listens at 10.70.20.20:6379"; fi
fi

echo "isoloom-check: END $passed passed, $failed failed"
[ "$failed" -eq 0 ]

## .isoloom/vagrant/run.json
{
  "$schema": "https://www.isoloom.com/schema/run-manifest/v0.json",
  "manifest_version": 0,
  "generator": {
    "name": "isoloom",
    "version": "1.0.1"
  },
  "environment": {
    "name": "edge-firewall",
    "instance": null,
    "message": null
  },
  "target": "vagrant",
  "driver": "vagrant",
  "hosts": [
    "linux",
    "macos",
    "windows"
  ],
  "tools": [
    {
      "name": "vagrant",
      "probe": [
        "vagrant",
        "--version"
      ],
      "min_version": "2.4.0"
    },
    {
      "name": "virtualbox",
      "probe": [
        "VBoxManage",
        "--version"
      ],
      "providers": [
        "virtualbox"
      ]
    },
    {
      "name": "vmware",
      "probe": [
        "vmrun",
        "list"
      ],
      "providers": [
        "vmware_desktop"
      ]
    },
    {
      "name": "parallels",
      "probe": [
        "prlctl",
        "--version"
      ],
      "hosts": [
        "macos"
      ],
      "providers": [
        "parallels"
      ]
    },
    {
      "name": "libvirt",
      "probe": [
        "virsh",
        "--version"
      ],
      "hosts": [
        "linux"
      ],
      "providers": [
        "libvirt"
      ]
    },
    {
      "name": "qemu",
      "probe": [
        "qemu-img",
        "--version"
      ],
      "providers": [
        "qemu"
      ]
    }
  ],
  "identity": {
    "vagrant": {
      "providers": [
        {
          "id": "virtualbox",
          "hosts": [
            "linux",
            "macos",
            "windows"
          ],
          "elevation": "none",
          "refusal": null
        },
        {
          "id": "vmware_desktop",
          "hosts": [
            "linux",
            "macos",
            "windows"
          ],
          "plugin": "vagrant-vmware-desktop",
          "elevation": "none",
          "refusal": null
        },
        {
          "id": "hyperv",
          "hosts": [
            "windows"
          ],
          "elevation": "hyperv",
          "refusal": null
        },
        {
          "id": "parallels",
          "hosts": [
            "macos"
          ],
          "plugin": "vagrant-parallels",
          "elevation": "none",
          "refusal": null
        },
        {
          "id": "libvirt",
          "hosts": [
            "linux"
          ],
          "plugin": "vagrant-libvirt",
          "elevation": "none",
          "refusal": null
        },
        {
          "id": "qemu",
          "hosts": [
            "linux",
            "macos"
          ],
          "plugin": "vagrant-qemu",
          "elevation": "none",
          "refusal": "`fw` is on 3 networks, and QEMU gives a VM one"
        },
        {
          "id": "utm",
          "hosts": [
            "macos"
          ],
          "plugin": "vagrant_utm",
          "elevation": "none",
          "refusal": "`fw` is on a network, and vagrant_utm gives a VM no private network (it only forwards ports)"
        },
        {
          "id": "vmware_esxi",
          "hosts": [
            "linux",
            "macos",
            "windows"
          ],
          "plugin": "vagrant-vmware-esxi",
          "elevation": "none",
          "remote": true,
          "refusal": null
        }
      ],
      "dotfile": "${run.state_dir}/vagrant"
    }
  },
  "params": [
    {
      "name": "ISOLOOM_HYPERV_SWITCH",
      "description": "The Hyper-V virtual switch each VM's first adapter (Vagrant's connection, and the internet) goes on.",
      "default": "Default Switch",
      "hosts": [
        "windows"
      ],
      "providers": [
        "hyperv"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_HYPERV_SWITCH",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "ISOLOOM_SSH_PROXY_COMMAND",
      "description": "The command Vagrant's SSH to the VMs goes through when this host can't reach them directly (an ESXi host through the runner's relay on macOS).",
      "providers": [
        "vmware_esxi"
      ],
      "set_by": "runner",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_SSH_PROXY_COMMAND",
          "steps": [
            "*"
          ]
        }
      ]
    },
