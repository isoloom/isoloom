## .isoloom/docker/compose.yml
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  docker compose -f .isoloom/docker/compose.yml up -d --build --wait
# Access: docker compose -f .isoloom/docker/compose.yml --profile access up -d client
# Checks: docker compose -f .isoloom/docker/compose.yml --profile check run --rm isoloom-check
#         docker compose -f .isoloom/docker/compose.yml --profile check run --rm isoloom-check-dns
#         Each prints a PASS or FAIL line per check, and fails when one does (`run -e ISOLOOM_DERIVED=0` leaves the derived checks out).
#         Then docker compose -f .isoloom/docker/compose.yml --profile check rm -sf isoloom-access isoloom-routes-isoloom-access: the access machine's stand-in, which a run starts.
# Stop:   docker compose -f .isoloom/docker/compose.yml --profile check down -v

name: udp-dns
services:
  isoloom-router:
    image: alpine:3.24@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf
    sysctls:
      net.ipv4.ip_forward: '1'
    init: true
    entrypoint:
    - /bin/sh
    - -c
    - apk add --no-cache nftables >/dev/null && printf '%s' "$$RULES" | nft -f - && exec sleep infinity
    hostname: isoloom-router
    networks:
      servers:
        ipv4_address: 10.66.10.254
      users:
        ipv4_address: 10.66.20.254
    cap_add:
    - NET_ADMIN
    environment:
      RULES: |
        table inet isoloom {
          chain forward {
            type filter hook forward priority 0; policy drop;
            ct state established,related accept
            ip saddr 10.66.20.0/24 ip daddr 10.66.10.0/24 meta l4proto { tcp, udp } th dport { 53 } accept
            ip saddr 10.66.20.0/24 ip daddr 10.66.10.0/24 icmp type echo-request accept
          }
        }
    healthcheck:
      test:
      - CMD-SHELL
      - nft list table inet isoloom >/dev/null 2>&1
      interval: 3s
      timeout: 3s
      retries: 60
    labels:
      isoloom.managed: 'true'
      isoloom.environment: udp-dns
    restart: unless-stopped
  dns:
    build:
      context: ../../build/dns
      labels:
        isoloom.managed: 'true'
        isoloom.environment: udp-dns
    image: localhost/isoloom/udp-dns-dns
    hostname: dns
    networks:
      servers:
        ipv4_address: 10.66.10.53
    extra_hosts:
    - client:10.66.20.10
    ports:
    - ${ISOLOOM_PUBLISH_ADDRESS:-127.0.0.1}:${ISOLOOM_PUBLISH_FIXED:+10053}:53/udp
    volumes:
    - isoloom-probe:/.isoloom-probe:ro
    healthcheck:
      test:
      - CMD
      - /.isoloom-probe/busybox
      - sh
      - -c
      - /.isoloom-probe/busybox nc -z -w 2 127.0.0.1 53
      interval: 5s
      timeout: 3s
      retries: 60
      start_period: 10s
    depends_on:
      isoloom-probe:
        condition: service_completed_successfully
    labels:
      isoloom.port.dns-udp: udp:53
      isoloom.port.dns: tcp:53
      isoloom.managed: 'true'
      isoloom.environment: udp-dns
    restart: unless-stopped
  isoloom-routes-dns:
    image: alpine:3.24@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf
    init: true
    entrypoint:
    - /bin/sh
    - -c
    - ip route replace 10.66.20.0/24 via 10.66.10.254 && (ip route del default 2>/dev/null || true) && while ip -o -4 addr show | grep -qv ' lo '; do sleep 2; done; exit 1
    network_mode: service:dns
    cap_add:
    - NET_ADMIN
    healthcheck:
      test:
      - CMD-SHELL
      - ip route show 10.66.20.0/24 | grep -q via && ! ip route | grep -q '^default'
      interval: 2s
      timeout: 2s
      retries: 30
    depends_on:
      dns:
        condition: service_started
      isoloom-router:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: udp-dns
    restart: unless-stopped
  client:
    build:
      context: ../..
      dockerfile: .isoloom/docker/build/client/Dockerfile
      labels:
        isoloom.managed: 'true'
        isoloom.environment: udp-dns
    image: localhost/isoloom/udp-dns-client
    profiles:
    - access
    init: true
    entrypoint:
    - sleep
    - infinity
    hostname: client
    networks:
      users:
        ipv4_address: 10.66.20.10
    extra_hosts:
    - dns:10.66.10.53
    depends_on:
      dns:
        condition: service_healthy
      isoloom-routes-dns:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: udp-dns
    restart: unless-stopped
  isoloom-routes-client:
    image: alpine:3.24@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf
    profiles:
    - access
    init: true
    entrypoint:
    - /bin/sh
    - -c
    - ip route replace 10.66.10.0/24 via 10.66.20.254 && (ip route del default 2>/dev/null || true) && while ip -o -4 addr show | grep -qv ' lo '; do sleep 2; done; exit 1
    network_mode: service:client
    cap_add:
    - NET_ADMIN
    healthcheck:
      test:
      - CMD-SHELL
      - ip route show 10.66.10.0/24 | grep -q via && ! ip route | grep -q '^default'
      interval: 2s
      timeout: 2s
      retries: 30
    depends_on:
      client:
        condition: service_started
      isoloom-router:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: udp-dns
    restart: unless-stopped
  isoloom-access:
    image: alpine:3.24@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf
    profiles:
    - check
    init: true
    entrypoint:
    - sleep
    - infinity
    hostname: client
    networks:
      users:
        ipv4_address: 10.66.20.10
    extra_hosts:
    - dns:10.66.10.53
    labels:
      isoloom.managed: 'true'
      isoloom.environment: udp-dns
  isoloom-routes-isoloom-access:
    image: alpine:3.24@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf
    profiles:
    - check
    init: true
    entrypoint:
    - /bin/sh
    - -c
    - ip route replace 10.66.10.0/24 via 10.66.20.254 && (ip route del default 2>/dev/null || true) && while ip -o -4 addr show | grep -qv ' lo '; do sleep 2; done; exit 1
    network_mode: service:isoloom-access
    cap_add:
    - NET_ADMIN
    healthcheck:
      test:
      - CMD-SHELL
      - ip route show 10.66.10.0/24 | grep -q via && ! ip route | grep -q '^default'
      interval: 2s
      timeout: 2s
      retries: 30
    depends_on:
      isoloom-access:
        condition: service_started
      isoloom-router:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: udp-dns
    restart: unless-stopped
  isoloom-check:
    image: curlimages/curl:8.22.0@sha256:58adaa4e8dca9c988bae2aba4ab3434a0bb2da16bbe3f92dec39ec7785166777
    profiles:
    - check
    entrypoint:
    - /bin/sh
    - /isoloom/run.sh
    network_mode: service:isoloom-access
    volumes:
    - ./checks/client.sh:/isoloom/run.sh:ro,z
    - ../..:/isoloom/project:ro,z
    depends_on:
      dns:
        condition: service_healthy
      isoloom-routes-dns:
        condition: service_healthy
      isoloom-access:
        condition: service_started
      isoloom-routes-isoloom-access:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: udp-dns
  isoloom-check-dns:
    image: curlimages/curl:8.22.0@sha256:58adaa4e8dca9c988bae2aba4ab3434a0bb2da16bbe3f92dec39ec7785166777
    profiles:
    - check
    entrypoint:
    - /bin/sh
    - /isoloom/run.sh
    network_mode: service:dns
    volumes:
    - ./checks/dns.sh:/isoloom/run.sh:ro,z
    depends_on:
      dns:
        condition: service_healthy
      isoloom-routes-dns:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: udp-dns
  isoloom-probe:
    image: busybox:1.37.0-musl@sha256:f6a95d611e0a8780fabdb2aec43e31275b2720dfefa3e41b16835bfc42454478
    entrypoint:
    - /bin/cp
    - /bin/busybox
    - /probe/busybox
    network_mode: none
    volumes:
    - isoloom-probe:/probe
    labels:
      isoloom.managed: 'true'
      isoloom.environment: udp-dns
    restart: no
networks:
  servers:
    ipam:
      config:
      - subnet: 10.66.10.0/24
        gateway: 10.66.10.1
    labels:
      isoloom.managed: 'true'
      isoloom.environment: udp-dns
  users:
    ipam:
      config:
      - subnet: 10.66.20.0/24
        gateway: 10.66.20.1
    labels:
      isoloom.managed: 'true'
      isoloom.environment: udp-dns
volumes:
  isoloom-probe:
    labels:
      isoloom.managed: 'true'
      isoloom.environment: udp-dns

## .isoloom/resolved.json
{
