# Machine `admin`.
resource "proxmox_virtual_environment_file" "admin" {
  node_name    = var.node
  datastore_id = var.snippets_datastore
  content_type = "snippets"
  source_raw {
    file_name = "iso${var.slot}-admin.yaml"
    data = format("#cloud-config\n%s", yamlencode({
      hostname = "admin"
      users    = local.users
      packages = ["nftables", "curl", "netcat-openbsd"]
      runcmd = [
        "mkdir -p /var/lib/isoloom",
        "echo 'running: hosts file' > /var/lib/isoloom/ready; sh -c 'printf '\\''%s\\n'\\'' '\\''10.70.99.10 intranet'\\'' '\\''10.70.10.10 staff'\\'' '\\''10.70.20.10 guest'\\'' '\\''10.70.10.50 admin'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done' || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }",
        "echo 'running: VLAN interfaces' > /var/lib/isoloom/ready; sh -c 'ip link show office >/dev/null 2>&1 || { ip link add office type veth peer name office-s && ip link set office up && ip link set office-s up && IF=$(ip -o -4 addr show | awk '\\''$4 ~ /^10\\.70\\.10\\.50\\//{print $2}'\\'' | head -n 1) && MAC=$(cat \"/sys/class/net/$IF/address\") && ip addr flush dev \"$IF\" && ip link set \"$IF\" address 02:1f:0a:46:0a:32 && ip link add br10 type bridge && ip link set \"$IF\" master br10 && ip link set br10 up && ip link add link office-s name office-s.10 type vlan id 10 && ip link set office-s.10 master br10 && ip link set office-s.10 up && ip link add link office name office.10 address \"$MAC\" type vlan id 10 && ip addr add 10.70.10.50/24 dev office.10 && ip link set office.10 up && IF=$(ip -o -4 addr show | awk '\\''$4 ~ /^10\\.70\\.20\\.50\\//{print $2}'\\'' | head -n 1) && MAC=$(cat \"/sys/class/net/$IF/address\") && ip addr flush dev \"$IF\" && ip link set \"$IF\" address 02:1f:0a:46:14:32 && ip link add br20 type bridge && ip link set \"$IF\" master br20 && ip link set br20 up && ip link add link office-s name office-s.20 type vlan id 20 && ip link set office-s.20 master br20 && ip link set office-s.20 up && ip link add link office name office.20 address \"$MAC\" type vlan id 20 && ip addr add 10.70.20.50/24 dev office.20 && ip link set office.20 up; }' || { echo 'failed: VLAN interfaces' > /var/lib/isoloom/ready; exit 1; }",
        "echo 'running: routes' > /var/lib/isoloom/ready; sh -c 'ip route replace 10.70.99.0/24 via 10.70.10.254' || { echo 'failed: routes' > /var/lib/isoloom/ready; exit 1; }",
        "echo 'running: health check' > /var/lib/isoloom/ready; sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready' || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }"
      ]
    }))
  }
}

resource "proxmox_virtual_environment_vm" "admin" {
  name      = "iso${var.slot}-admin"
  node_name = var.node
  tags      = ["isoloom", "vlan-office"]
  pool_id   = proxmox_virtual_environment_pool.env.pool_id
  on_boot   = false
  cpu {
    cores = 1
    type  = "host"
  }
  memory {
    dedicated = 1024
  }
  disk {
    datastore_id = var.datastore
    file_id      = proxmox_download_file.debian_12.id
    interface    = "virtio0"
    size         = 20
  }
  network_device {
    bridge   = proxmox_sdn_vnet.office.id
    vlan_id  = 10
    firewall = true
  }
  network_device {
    bridge   = proxmox_sdn_vnet.office.id
    vlan_id  = 20
    firewall = true
  }
  initialization {
    datastore_id      = var.datastore
    user_data_file_id = proxmox_virtual_environment_file.admin.id
    dns {
      servers = ["1.1.1.1"]
    }
    ip_config {
      ipv4 {
        address = "10.70.10.50/24"
        gateway = "10.70.10.254"
      }
    }
    ip_config {
      ipv4 {
        address = "10.70.20.50/24"
      }
    }
  }
  operating_system {
    type = "l26"
  }
  serial_device {}
  depends_on = [proxmox_virtual_environment_vm.isoloom_router]
}

# Machine `admin`'s firewall: what reaches it, outside the guest.
resource "proxmox_virtual_environment_firewall_options" "admin" {
  node_name     = var.node
  vm_id         = proxmox_virtual_environment_vm.admin.vm_id
  enabled       = true
  input_policy  = "DROP"
  output_policy = "ACCEPT"
}

resource "proxmox_virtual_environment_firewall_rules" "admin" {
  node_name = var.node
  vm_id     = proxmox_virtual_environment_vm.admin.vm_id
  rule {
    type    = "in"
    action  = "ACCEPT"
    comment = "network office-vlan10"
    source  = "+${proxmox_virtual_environment_firewall_ipset.office_vlan10.name}"
  }
  rule {
    type    = "in"
    action  = "ACCEPT"
    comment = "network office-vlan20"
    source  = "+${proxmox_virtual_environment_firewall_ipset.office_vlan20.name}"
  }
}

locals {
  router_address = try([for a in flatten(proxmox_virtual_environment_vm.isoloom_router.ipv4_addresses) : a if a != "127.0.0.1" && !contains(["10.70.10.254", "10.70.20.254", "10.70.99.254"], a)][0], "")
}

# The router's uplink address: the lab's way in.
output "ip" {
  value = local.router_address
}

# Each Linux machine's set-up progress (`isoloom-ready/1`: `running: <step>`, `failed: <step>`, `ready`).
output "ready_file" {
  value = "/var/lib/isoloom/ready"
}

# The machines, through the router: ssh -J isoloom@<ip> isoloom@<machine>.
output "machines" {
  value = { intranet = "10.70.99.10", staff = "10.70.10.10", guest = "10.70.20.10", admin = "10.70.10.50" }
}

output "ssh_user" {
  value = "isoloom"
}

# The checks: each runner piped to its machine (ssh -J isoloom@<ip> isoloom@<host> sh -s < <script>).
output "checks" {
  value = [
    {
      position = "staff"
      machine  = "staff"
      host     = "10.70.10.10"
      user     = "isoloom"
      script   = ".isoloom/proxmox/checks/staff.sh"
    },
    {
      position = "intranet"
      machine  = "intranet"
      host     = "10.70.99.10"
      user     = "isoloom"
      script   = ".isoloom/proxmox/checks/intranet.sh"
    },
    {
      position = "guest"
      machine  = "guest"
      host     = "10.70.20.10"
      user     = "isoloom"
      script   = ".isoloom/proxmox/checks/guest.sh"
    },
    {
      position = "admin"
      machine  = "admin"
      host     = "10.70.10.50"
      user     = "isoloom"
      script   = ".isoloom/proxmox/checks/admin.sh"
    }
  ]
}

# The project's files the machines don't get: version control and the tools' state, and what
# .isoloomignore at the project's root lists (gitignore-style: one pattern per line, `#` comments,
# `!` brings a path back, a trailing `/` matches folders only, a `/` at the start or in the middle
# anchors the pattern at the root; `*`, `?`, `[abc]`, `**`; the last pattern matching a path, or
# a folder it is in, decides). Read as regular expressions, as the Vagrantfiles do.
locals {
  project_ignore_lines = [for l in split("\n", replace(try(file("${local.root}/.isoloomignore"), ""), "\r", "")) : trimspace(l)]
  project_ignore_pats  = [for l in local.project_ignore_lines : { keep = startswith(l, "!"), pat = trimprefix(l, "!") } if l != "" && !startswith(l, "#")]
  project_ignore_globs = [for r in local.project_ignore_pats : merge(r, { glob = trimsuffix(trimsuffix(trimsuffix(r.pat, "/"), "/**"), "/") })]
  project_ignore = [for r in local.project_ignore_globs : {
    keep = r.keep
    re = format(r.glob == r.pat ? "^%s(/|$)" : "^%s/", replace(replace(replace(replace(replace(replace(replace(replace(
      length(split("/", r.glob)) > 1 ? trimprefix(r.glob, "/") : "**/${r.glob}",
    "/[.+^$(){}|\\\\]/", "\\$0"), "[!", "[^"), "**/", "\u0001"), "**", "\u0002"), "*", "[^/]*"), "?", "[^/]"), "\u0001", "(.*/)?"), "\u0002", ".*"))
  } if r.glob != ""]
  # Each file: whether it goes (the last matching pattern decides; none: it goes).
  project_keep  = { for f in fileset(local.root, "**") : f => reverse(concat([true], [for r in local.project_ignore : r.keep if length(regexall(r.re, f)) > 0]))[0] }
  project_paths = [for f, keep in local.project_keep : f if keep && length(regexall("^\\.isoloom|(^|/)\\.(git|vagrant|terraform)/", f)) == 0]
}

## .isoloom/proxmox/run.json
{
  "$schema": "https://www.isoloom.com/schema/run-manifest/v0.json",
  "manifest_version": 0,
  "generator": {
    "name": "isoloom",
    "version": "0.11.1"
  },
  "environment": {
    "name": "vlan-office",
    "instance": null,
    "message": null
  },
  "target": "proxmox",
  "driver": "terraform",
  "hosts": [
    "linux",
    "macos",
    "windows"
  ],
  "tools": [
    {
      "name": "terraform",
      "probe": [
        "terraform",
        "version"
      ],
      "min_version": "1.6.0",
      "container": "hashicorp/terraform:1.9.8@sha256:18f9986038bbaf02cf49db9c09261c778161c51dcc7fb7e355ae8938459428cd",
      "container_hosts": [
        "macos"
      ]
    },
    {
      "name": "ssh",
      "probe": [
        "ssh",
        "-V"
      ]
    }
  ],
  "identity": {
    "terraform": {
      "module": ".",
      "state": "runner"
    }
  },
  "params": [
    {
      "name": "proxmox_endpoint",
      "description": "https://<server>:8006/.",
      "required": true,
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_endpoint"
        }
      ]
    },
    {
      "name": "proxmox_username",
      "description": "The module's `proxmox_username`.",
      "default": "root@pam",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_username"
        }
      ]
    },
    {
      "name": "proxmox_insecure",
      "description": "Accept the server's self-signed certificate.",
      "default": "true",
      "values": [
        "true",
        "false"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_insecure"
        }
      ]
    },
    {
      "name": "proxmox_ssh_username",
      "description": "Uploading cloud-init snippets goes over SSH to the node.",
      "default": "root",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_ssh_username"
        }
      ]
    },
    {
      "name": "proxmox_ssh_address",
      "description": "The node's SSH address, when the API reports one this machine can't reach.",
      "default": "",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_ssh_address"
        }
      ]
    },
    {
      "name": "node",
      "description": "The Proxmox node the VMs go on (`pvesh get /nodes` lists them).",
      "required": true,
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "node"
        }
      ]
    },
    {
      "name": "datastore",
      "description": "Where VM disks go.",
      "default": "local-lvm",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "datastore"
        }
      ]
    },
    {
      "name": "image_datastore",
      "description": "A datastore with 'iso' content, for cloud images.",
      "default": "local",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "image_datastore"
        }
      ]
    },
    {
      "name": "snippets_datastore",
      "description": "A datastore with 'snippets' content, for cloud-init.",
      "default": "local",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "snippets_datastore"
        }
      ]
    },
    {
      "name": "uplink_bridge",
      "description": "The bridge the router reaches the internet through.",
      "default": "vmbr0",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "uplink_bridge"
        }
      ]
    },
    {
      "name": "ISOLOOM_DERIVED",
      "description": "0: the checks derived from the spec (reachability, no internet) are skipped.",
      "default": "1",
      "values": [
        "0",
        "1"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_DERIVED",
          "steps": [
            "check-staff",
            "check-intranet",
            "check-guest",
            "check-admin"
          ]
        }
      ]
    },
    {
      "name": "isoloom_sealed",
      "description": "true once the machines are set up: the internet is closed to the `internet: false` networks, at the router.",
      "default": "false",
      "values": [
        "true",
        "false"
      ],
      "set_by": "runner",
      "deliver": [
        {
          "via": "tf_var",
          "var": "isoloom_sealed"
        }
      ]
    }
  ],
  "secrets": [
    {
      "name": "proxmox_api_token",
      "kind": "connection",
      "required": false,
      "sensitive": true,
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_api_token"
        }
      ]
    },
    {
      "name": "proxmox_password",
      "kind": "connection",
      "required": false,
      "sensitive": true,
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_password"
        }
      ]
    }
  ],
  "networks": [
    {
      "name": "office-vlan10",
      "cidr": "10.70.10.0/24",
      "internet": false,
      "native": "i${run.slot}l0"
    },
    {
      "name": "office-vlan20",
      "cidr": "10.70.20.0/24",
      "internet": true,
      "native": "i${run.slot}l0"
    },
    {
      "name": "servers",
      "cidr": "10.70.99.0/24",
      "internet": false,
      "native": "i${run.slot}n2"
    }
  ],
  "machines": [
    {
      "name": "intranet",
      "role": "target",
      "os": "debian-12",
      "arch": "amd64",
      "addresses": {
        "servers": "10.70.99.10"
      },
      "ports": [
        {
          "name": "web",
          "port": 80,
          "protocol": "tcp",
          "http": true
        }
      ]
    },
    {
      "name": "staff",
      "role": "target",
      "os": "debian-12",
      "arch": "amd64",
      "addresses": {
        "office-vlan10": "10.70.10.10"
      }
    },
    {
      "name": "guest",
      "role": "target",
      "os": "debian-12",
      "arch": "amd64",
      "addresses": {
        "office-vlan20": "10.70.20.10"
      }
    },
    {
      "name": "admin",
      "role": "target",
      "os": "debian-12",
      "arch": "amd64",
      "addresses": {
        "office-vlan10": "10.70.10.50",
        "office-vlan20": "10.70.20.50"
      }
    },
    {
      "name": "isoloom-router",
      "role": "infra",
      "addresses": {
        "office-vlan10": "10.70.10.254",
        "office-vlan20": "10.70.20.254",
        "servers": "10.70.99.254"
      }
    }
  ],
  "lifecycle": {
    "up": [
      {
        "id": "clear-lock",
        "action": "terraform.clear_lock"
      },
      {
        "id": "init",
        "note": "Preparing Terraform and its providers…",
        "argv": [
          "terraform",
          "init",
          "-input=false",
          "-no-color",
          "-backend-config=path=${run.state_dir}/terraform.tfstate"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_proxmox_ssh_private_key_file": "${run.ssh_key}",
          "TF_VAR_slot": "${run.slot}",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 600
      },
      {
        "id": "apply",
        "note": "Creating the lab's VMs on the server…",
        "argv": [
          "terraform",
          "apply",
          "-auto-approve",
          "-input=false",
          "-no-color"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_proxmox_ssh_private_key_file": "${run.ssh_key}",
          "TF_VAR_slot": "${run.slot}",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 3600
      }
    ],
    "down": [
      {
        "id": "clear-lock",
        "action": "terraform.clear_lock"
      },
      {
        "id": "init",
        "note": "Preparing Terraform and its providers…",
        "argv": [
          "terraform",
          "init",
          "-input=false",
          "-no-color",
          "-backend-config=path=${run.state_dir}/terraform.tfstate"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_proxmox_ssh_private_key_file": "${run.ssh_key}",
          "TF_VAR_slot": "${run.slot}",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 600
      },
      {
        "id": "destroy",
        "note": "Removing the lab from the server…",
        "argv": [
          "terraform",
          "destroy",
          "-auto-approve",
          "-input=false",
          "-no-color",
          "-refresh=false"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_proxmox_ssh_private_key_file": "${run.ssh_key}",
          "TF_VAR_slot": "${run.slot}",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 1800
      }
    ],
    "seal": {
      "param": "isoloom_sealed",
      "steps": [
        {
          "id": "seal",
          "note": "Closing the internet to the networks without it…",
          "argv": [
            "terraform",
            "apply",
            "-auto-approve",
            "-input=false",
            "-no-color"
          ],
          "env": {
            "TF_DATA_DIR": "${run.state_dir}/.terraform",
            "TF_INPUT": "0",
            "TF_IN_AUTOMATION": "1",
            "TF_VAR_proxmox_ssh_private_key_file": "${run.ssh_key}",
            "TF_VAR_slot": "${run.slot}",
            "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
          },
          "timeout_s": 3600
        },
        {
          "id": "seal-reload",
          "action": "ssh.run",
          "with": {
            "command": "sudo sh -c 'nft -f /etc/nftables.sealed.nft && cp /etc/nftables.sealed.nft /etc/nftables.conf'",
            "host": "${outputs.ip}",
            "user": "isoloom"
          },
          "timeout_s": 600
        }
      ]
    },
    "status": {
      "id": "state",
      "action": "terraform.read_state"
    }
  },
  "ready": [
    {
      "kind": "step_ok",
      "step": "apply",
      "means": "the VMs exist and booted; each sets itself up from its cloud-init"
    },
    {
      "kind": "ready_file",
      "host": "10.70.99.10",
      "user": "isoloom",
      "path": "${outputs.ready_file}",
      "log": "/var/log/cloud-init-output.log",
      "grammar": "isoloom-ready/1",
      "via": "isoloom@${outputs.ip}",
      "timeout_s": 2400,
      "unreachable_timeout_s": 600,
      "interval_s": 10
    },
    {
      "kind": "ready_file",
      "host": "10.70.10.10",
      "user": "isoloom",
      "path": "${outputs.ready_file}",
      "log": "/var/log/cloud-init-output.log",
      "grammar": "isoloom-ready/1",
      "via": "isoloom@${outputs.ip}",
      "timeout_s": 2400,
      "unreachable_timeout_s": 600,
      "interval_s": 10
    },
    {
      "kind": "ready_file",
      "host": "10.70.20.10",
      "user": "isoloom",
      "path": "${outputs.ready_file}",
      "log": "/var/log/cloud-init-output.log",
      "grammar": "isoloom-ready/1",
      "via": "isoloom@${outputs.ip}",
      "timeout_s": 2400,
      "unreachable_timeout_s": 600,
      "interval_s": 10
    },
    {
      "kind": "ready_file",
      "host": "10.70.10.50",
      "user": "isoloom",
      "path": "${outputs.ready_file}",
      "log": "/var/log/cloud-init-output.log",
      "grammar": "isoloom-ready/1",
      "via": "isoloom@${outputs.ip}",
      "timeout_s": 2400,
      "unreachable_timeout_s": 600,
      "interval_s": 10
    }
  ],
  "outputs": [
    {
      "name": "ip",
      "description": "The router's uplink address: the published ports answer there, and SSH reaches the machines through it.",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ip"
      }
    },
    {
      "name": "ssh_user",
      "description": "The user every Linux VM and the router let in with the runner's key.",
      "role": "info",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ssh_user"
      }
    },
    {
      "name": "ready_file",
      "description": "Where each Linux machine's set-up says how far it got (isoloom-ready/1).",
      "role": "info",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ready_file"
      }
    }
  ],
  "checks": {
    "protocol": "isoloom-check/1",
    "setup": [],
    "runners": [
      {
        "id": "staff",
        "from": "from staff",
        "checks": [
          {
            "name": "staff reach the intranet",
            "kind": "http",
            "wait_s": 60,
            "derived": false
          },
          {
            "name": "intranet:80 from staff",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "no internet from staff",
            "kind": "http",
            "wait_s": 0,
            "derived": true
          }
        ],
        "step": {
          "id": "check-staff",
          "action": "ssh.run",
          "with": {
            "command": "ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} sh -s",
            "host": "10.70.10.10",
            "user": "isoloom",
            "via": "isoloom@${outputs.ip}"
          },
          "stdin": "checks/staff.sh",
          "timeout_s": 195
        }
      },
      {
        "id": "intranet",
        "from": "from intranet",
        "checks": [
          {
            "name": "no internet from intranet",
            "kind": "http",
            "wait_s": 0,
            "derived": true
          }
        ],
        "step": {
          "id": "check-intranet",
          "action": "ssh.run",
          "with": {
            "command": "ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} sh -s",
            "host": "10.70.99.10",
            "user": "isoloom",
            "via": "isoloom@${outputs.ip}"
          },
          "stdin": "checks/intranet.sh",
          "timeout_s": 75
        }
      },
      {
        "id": "guest",
        "from": "from guest",
        "checks": [
          {
            "name": "guests don't",
            "kind": "tcp",
            "wait_s": 0,
            "derived": false
          },
          {
            "name": "intranet:80 blocked from guest",
            "kind": "tcp",
            "wait_s": 0,
            "derived": true
          }
        ],
        "step": {
          "id": "check-guest",
          "action": "ssh.run",
          "with": {
            "command": "ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} sh -s",
            "host": "10.70.20.10",
            "user": "isoloom",
            "via": "isoloom@${outputs.ip}"
          },
          "stdin": "checks/guest.sh",
          "timeout_s": 90
        }
      },
      {
        "id": "admin",
        "from": "from admin",
        "checks": [
          {
            "name": "the admin box reaches the intranet over its trunk",
            "kind": "http",
            "wait_s": 60,
            "derived": false
          },
          {
            "name": "intranet:80 from admin",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          }
        ],
        "step": {
          "id": "check-admin",
          "action": "ssh.run",
          "with": {
            "command": "ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} sh -s",
            "host": "10.70.10.50",
            "user": "isoloom",
            "via": "isoloom@${outputs.ip}"
          },
          "stdin": "checks/admin.sh",
          "timeout_s": 180
        }
      }
    ],
    "teardown": []
  }
}

