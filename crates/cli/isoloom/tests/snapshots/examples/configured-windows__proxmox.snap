## .isoloom/proxmox/checks/networks.sh
#!/bin/sh
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# The environment's checks, from the environment's networks. `isoloom test` runs it and reads the PASS/FAIL lines.
passed=0; failed=0
pass() { passed=$((passed+1)); echo "isoloom-check: PASS $1"; }
fail() { failed=$((failed+1)); echo "isoloom-check: FAIL $1: $2"; }
# _http URL [follow] -> the status code, 000 when nothing answers (curl, else wget, else bash):
# the first answer's, or with `follow` the last one's after at most 5 redirects (bash: the first).
_http() {
  if command -v curl >/dev/null 2>&1; then
    if [ -n "$2" ]; then set -- "$1" -L --max-redirs 5; else set -- "$1"; fi
    c=$(curl -sk -o /dev/null -m 5 -w '%{http_code}' "$@" 2>/dev/null)
  elif command -v wget >/dev/null 2>&1; then
    # wget follows redirects whatever it's told (busybox's can't be told): -S prints each answer.
    if [ -n "$2" ]; then _n=6; else _n=1; fi
    c=$(wget -q -S -O /dev/null -T 5 --no-check-certificate "$1" 2>&1 | sed -n 's/^ *HTTP\/[0-9.]* \([0-9][0-9][0-9]\).*/\1/p' | head -n $_n | tail -n 1)
  else
    u=${1#*://}; hp=${u%%/*}; p=/${u#*/}; [ "$u" = "$hp" ] && p=/
    h=${hp%%:*}; port=${hp#*:}; [ "$hp" = "$h" ] && port=80
    # shellcheck disable=SC2016 # the inner bash expands $H, $P and $U, for its /dev/tcp
    c=$(H=$h P=$port U=$p timeout 5 bash -c 'exec 3<>/dev/tcp/$H/$P && printf "GET %s HTTP/1.0\r\nHost: %s\r\n\r\n" "$U" "$H" >&3 && read -r l <&3 && echo "$l"' 2>/dev/null | sed -n 's/^HTTP\/[0-9.]* \([0-9][0-9][0-9]\).*/\1/p')
  fi
  echo "${c:-000}"
}
_http_is() { [ "$(_http "$1" "$3")" = "$2" ]; }
# _req STATUS|any TEXT CURL-ARGS... -> 0 when the request gets that status (any answer for `any`)
# and its body contains TEXT (if any); $out says why not. Needs curl.
_req() {
  want=$1; text=$2; shift 2
  command -v curl >/dev/null 2>&1 || { out="curl is needed for this check"; return 1; }
  b=$(mktemp); c=$(curl -sk -m 10 -o "$b" -w '%{http_code}' "$@" 2>/dev/null); c=${c:-000}; r=0
  if [ "$want" = any ]; then [ "$c" != 000 ] || r=1; else [ "$c" = "$want" ] || r=1; fi
  if [ $r = 1 ]; then out="expected HTTP $want, got $c"
  elif [ -n "$text" ] && ! grep -qF -- "$text" "$b"; then r=1; out="HTTP $c, but the response doesn't contain the expected text"
  fi
  rm -f "$b"; return $r
}
_http_any() { [ "$(_http "$1" "$2")" != 000 ]; }
# _tcp HOST PORT -> 0 when it connects (nc, else bash).
_tcp() {
  if command -v nc >/dev/null 2>&1; then nc -z -w 5 "$1" "$2" >/dev/null 2>&1
  else
    # shellcheck disable=SC2016 # the inner bash expands $H and $P, for its /dev/tcp
    H=$1 P=$2 timeout 5 bash -c 'exec 3<>/dev/tcp/$H/$P' >/dev/null 2>&1
  fi
}
# _tcp_read HOST PORT LINE TEXT -> 0 when the bytes read within 5s of connecting (after writing
# LINE and a newline, if any) contain TEXT; $out says why not (nc, else bash). Stdin stays open
# while reading (some nc quit at its end), and nc is stopped after 5s whatever its flavor.
_tcp_read() {
  f=$(mktemp); i=0; r=1
  if command -v nc >/dev/null 2>&1; then
    { [ -z "$3" ] || printf '%s\n' "$3"; j=0; while [ ! -e "$f.end" ] && [ $j -lt 6 ]; do sleep 1; j=$((j+1)); done; } | nc "$1" "$2" >"$f" 2>/dev/null &
  else
    # shellcheck disable=SC2016 # the inner bash expands $H, $P and $L, for its /dev/tcp
    H=$1 P=$2 L=$3 timeout 6 bash -c 'exec 3<>/dev/tcp/$H/$P || exit 1; [ -z "$L" ] || printf "%s\n" "$L" >&3; cat <&3' >"$f" 2>/dev/null &
  fi
  p=$!
  while :; do
    if grep -qF -- "$4" "$f"; then r=0; break; fi
    if [ $i -ge 5 ] || ! kill -0 $p 2>/dev/null; then break; fi
    sleep 1; i=$((i+1))
  done
  [ $r = 0 ] || ! grep -qF -- "$4" "$f" || r=0
  touch "$f.end"; kill $p 2>/dev/null
  if [ $r = 1 ]; then
    if [ -s "$f" ]; then out="$1:$2 answered \"$(head -c 100 "$f" | tr -d '\000\r' | tr '\n\t' '  ')\", without the expected text"
    elif [ $i -lt 5 ]; then out="$1:$2 refused the connection or closed it without a word"
    else out="nothing read from $1:$2 within 5s"; fi
  fi
  rm -f "$f" "$f.end"; return $r
}
# _exec COMMAND TEXT -> 0 when the command succeeds and its output contains TEXT (if any).
_exec() { out=$(sh -c "$1" 2>&1) && { [ -z "$2" ] || printf '%s\n' "$out" | grep -qF -- "$2"; }; }
# _retry SECONDS COMMAND... -> keeps trying every 2s until it passes or the time is up.
_retry() { _end=$(( $(date +%s) + $1 )); shift; while ! "$@"; do [ "$(date +%s)" -lt "$_end" ] || return 1; sleep 2; done; }

echo '== checks/iis-answers.sh'
if _retry 0 sh -c 'cd /opt/isoloom && sh checks/iis-answers.sh'; then pass 'checks/iis-answers.sh'; else fail 'checks/iis-answers.sh' "checks/iis-answers.sh exited non-zero"; fi

if [ "${ISOLOOM_DERIVED:-1}" != 0 ]; then
if _retry 30 _http_any 'http://10.67.0.10:80/'; then pass 'iis:80 from the networks'; else fail 'iis:80 from the networks' "nothing answers at http://10.67.0.10:80/"; fi
fi

echo "isoloom-check: END $passed passed, $failed failed"
[ "$failed" -eq 0 ]

## .isoloom/proxmox/main.tf
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  terraform -chdir=.isoloom/proxmox init && terraform -chdir=.isoloom/proxmox apply -var proxmox_endpoint=https://<server>:8006/ -var proxmox_api_token=<user@realm!name=secret>
# Stop:   terraform -chdir=.isoloom/proxmox destroy (same variables)

terraform {
  required_version = ">= 1.6"
  backend "local" {}
  required_providers {
    proxmox = { source = "bpg/proxmox", version = "~> 0.115.0" }
    tls     = { source = "hashicorp/tls", version = "~> 4.4.1" }
    random  = { source = "hashicorp/random", version = "~> 3.9.1" }
  }
}

variable "proxmox_endpoint" {
  type        = string
  description = "https://<server>:8006/"
}

variable "proxmox_api_token" {
  type        = string
  default     = ""
  sensitive   = true
  description = "user@realm!name=secret; or use proxmox_username and proxmox_password"
}

variable "proxmox_username" {
  type    = string
  default = "root@pam"
}

variable "proxmox_password" {
  type      = string
  default   = ""
  sensitive = true
}

variable "proxmox_insecure" {
  type        = bool
  default     = true
  description = "Accept the server's self-signed certificate"
}

variable "proxmox_ssh_username" {
  type        = string
  default     = "root"
  description = "Uploading cloud-init snippets goes over SSH to the node"
}

variable "proxmox_ssh_private_key_file" {
  type    = string
  default = ""
}

variable "proxmox_ssh_address" {
  type        = string
  default     = ""
  description = "The node's SSH address, when the API reports one this machine can't reach"
}

variable "node" {
  type        = string
  description = "The Proxmox node the VMs go on (`pvesh get /nodes` lists them)"
  validation {
    condition     = var.node != ""
    error_message = "Set `node` to the Proxmox node the lab's VMs go on (`pvesh get /nodes` lists them)."
  }
}

variable "datastore" {
  type        = string
  default     = "local-lvm"
  description = "Where VM disks go"
}

variable "image_datastore" {
  type        = string
  default     = "local"
  description = "A datastore with 'iso' content, for cloud images"
}

variable "snippets_datastore" {
  type        = string
  default     = "local"
  description = "A datastore with 'snippets' content, for cloud-init"
}

variable "uplink_bridge" {
  type        = string
  default     = "vmbr0"
  description = "The bridge the router reaches the internet through"
}

variable "slot" {
  type        = number
  default     = 1
  description = "1 to 99, unique per environment on this server (SDN ids are short)"
}

variable "ssh_public_key" {
  type        = string
  default     = ""
  description = "Installed for the user `isoloom` on every VM"
}

variable "template_windows_server_2022" {
  type        = number
  description = "The VM id of a `windows-server-2022` template: cloudbase-init and the VirtIO drivers installed, UEFI on Q35, its disk on virtio0, sysprepped"
}

provider "proxmox" {
  endpoint  = var.proxmox_endpoint
  api_token = var.proxmox_api_token != "" ? var.proxmox_api_token : null
  username  = var.proxmox_api_token != "" ? null : var.proxmox_username
  password  = var.proxmox_api_token != "" ? null : var.proxmox_password
  insecure  = var.proxmox_insecure
  ssh {
    agent       = false
    username    = var.proxmox_ssh_username
    password    = var.proxmox_ssh_private_key_file != "" ? null : var.proxmox_password
    private_key = var.proxmox_ssh_private_key_file != "" ? file(var.proxmox_ssh_private_key_file) : null
    dynamic "node" {
      for_each = var.proxmox_ssh_address == "" ? [] : [1]
      content {
        name    = var.node
        address = var.proxmox_ssh_address
      }
    }
  }
}

# The project, written to /opt/isoloom in each machine that has steps; the `isoloom` user on every VM.
locals {
  zone          = "iso${var.slot}"
  root          = abspath("${path.module}/../..")
  project_files = [for f in local.project_paths : { path = "/opt/isoloom/${f}", encoding = "b64", content = filebase64("${local.root}/${f}") }]
  users = [
    {
      name                = "isoloom"
      sudo                = "ALL=(ALL) NOPASSWD:ALL"
      shell               = "/bin/bash"
      ssh_authorized_keys = compact([var.ssh_public_key, trimspace(tls_private_key.controller.public_key_openssh)])
    }
  ]
}

# The environment's VMs and containers, together in a pool of their own.
resource "proxmox_virtual_environment_pool" "env" {
  pool_id = local.zone
  comment = "Isoloom: configured-windows"
}

# Applies the SDN deletions on destroy, once the zone and its VNets are gone: every SDN object depends on it, so it goes last.
resource "proxmox_sdn_applier" "finalizer" {}

# The environment's networks: an SDN simple zone, a VNet per network.
resource "proxmox_sdn_zone_simple" "env" {
  id         = local.zone
  nodes      = [var.node]
  depends_on = [proxmox_sdn_applier.finalizer]
}

# The controller's own key: it runs the playbooks over SSH on every machine.
resource "tls_private_key" "controller" {
  algorithm = "ED25519"
}

# The Windows machines' administrator password (user isoloom), for WinRM.
resource "random_password" "windows" {
  length      = 24
  special     = false
  min_upper   = 2
  min_lower   = 2
  min_numeric = 2
}

# Network `lab`: 10.67.0.0/24
resource "proxmox_sdn_vnet" "lab" {
  id   = "i${var.slot}n0"
  zone = proxmox_sdn_zone_simple.env.id
}

# Applies the SDN objects once created, and again whenever one of them is replaced.
resource "proxmox_sdn_applier" "env" {
  lifecycle {
    replace_triggered_by = [proxmox_sdn_zone_simple.env, proxmox_sdn_vnet.lab]
  }
  depends_on = [proxmox_sdn_vnet.lab]
}

# The `debian-12` cloud image, per environment: a shared file would go with whichever environment is destroyed first.
resource "proxmox_download_file" "debian_12" {
  node_name           = var.node
  datastore_id        = var.image_datastore
  content_type        = "iso"
  url                 = "https://cloud.debian.org/images/cloud/bookworm/latest/debian-12-genericcloud-amd64.qcow2"
  file_name           = "iso${var.slot}-debian-12.img"
  overwrite_unmanaged = true
}

# Network `lab`, for the machines' firewall rules.
resource "proxmox_virtual_environment_firewall_ipset" "lab" {
  name    = "iso${var.slot}n0"
  comment = "configured-windows: network lab"
  cidr {
    name = "10.67.0.0/24"
  }
}

# The router: forwards between networks with the reach rules, and to the internet.
resource "proxmox_virtual_environment_file" "router" {
  node_name    = var.node
  datastore_id = var.snippets_datastore
  content_type = "snippets"
  source_raw {
    file_name = "iso${var.slot}-router.yaml"
    data = format("#cloud-config\n%s", yamlencode({
      hostname = "isoloom-router"
      users    = local.users
      packages = ["nftables", "qemu-guest-agent"]
      write_files = [
        {
          path    = "/etc/systemd/network/10-wan.network"
          content = join("\n", ["[Match]", "MACAddress=${format("02:15:%02x:00:00:00", var.slot)}", "", "[Network]", "DHCP=yes"])
        },
        {
          path    = "/etc/nftables.conf"
          content = "flush ruleset\ntable inet isoloom {\n  chain forward {\n    type filter hook forward priority 0; policy drop;\n    ct state established,related accept\n    ip daddr 10.67.0.10 tcp dport 80 ct status dnat accept\n    ip saddr { 10.67.0.0/24 } ip daddr != { 10.67.0.0/24 } accept\n  }\n  chain prerouting {\n    type nat hook prerouting priority -100;\n    ip saddr != { 10.67.0.0/24 } tcp dport 8087 dnat ip to 10.67.0.10:80\n  }\n  chain postrouting {\n    type nat hook postrouting priority 100;\n    ip saddr { 10.67.0.0/24 } ip daddr != { 10.67.0.0/24 } masquerade\n  }\n}\n"
        },
        { path = "/etc/sysctl.d/90-isoloom.conf", content = "net.ipv4.ip_forward=1\n" },
        {
          path = "/etc/systemd/network/20-lab.network"
          content = join("\n", [
            "[Match]",
            "MACAddress=${format("02:15:%02x:01:%02x:00", var.slot, 0)}",
            "",
            "[Network]",
            "Address=10.67.0.254/24",
            "ConfigureWithoutCarrier=yes"
          ])
        }
      ]
      runcmd = [
        "sysctl -p /etc/sysctl.d/90-isoloom.conf",
        "systemctl enable systemd-networkd",
        "systemctl restart systemd-networkd",
        "systemctl enable --now nftables",
        "nft -f /etc/nftables.conf",
        "systemctl enable --now qemu-guest-agent"
      ]
    }))
  }
}

# The guest agent reports its uplink address (DHCP), for the published ports.
resource "proxmox_virtual_environment_vm" "isoloom_router" {
  name      = "iso${var.slot}-router"
  node_name = var.node
  tags      = ["isoloom", "configured-windows"]
  pool_id   = proxmox_virtual_environment_pool.env.pool_id
  on_boot   = false
  agent {
    enabled = true
    timeout = "8m"
    wait_for_ip {
      ipv4 = true
    }
  }
  stop_on_destroy = true
  lifecycle {
    postcondition {
      condition     = length([for a in flatten(self.ipv4_addresses) : a if a != "127.0.0.1" && !contains(["10.67.0.254"], a)]) > 0
      error_message = "VM `router` got no IPv4 address on its uplink bridge `${var.uplink_bridge}` within 8m: the bridge has no DHCP, or no DNS or internet to install qemu-guest-agent, which reports the address. Give it an uplink bridge with DHCP and internet (`uplink_bridge`)."
    }
  }
  cpu {
    cores = 1
    type  = "host"
  }
  memory {
    dedicated = 512
  }
  disk {
    datastore_id = var.datastore
    file_id      = proxmox_download_file.debian_12.id
    interface    = "virtio0"
    size         = 8
  }
  network_device {
    bridge      = var.uplink_bridge
    mac_address = upper(format("02:15:%02x:00:00:00", var.slot))
  }
  network_device {
    bridge      = proxmox_sdn_vnet.lab.id
    mac_address = upper(format("02:15:%02x:01:%02x:00", var.slot, 0))
  }
  initialization {
    datastore_id      = var.datastore
    user_data_file_id = proxmox_virtual_environment_file.router.id
    ip_config {
      ipv4 {
        address = "dhcp"
      }
    }
  }
  operating_system {
    type = "l26"
  }
  serial_device {}
  depends_on = [proxmox_sdn_applier.env]
}

# Machine `iis`: its set-up, run by cloudbase-init.
resource "proxmox_virtual_environment_file" "iis" {
  node_name    = var.node
  datastore_id = var.snippets_datastore
  content_type = "snippets"
  source_raw {
    file_name = "iso${var.slot}-iis.ps1"
    data      = "#ps1_sysnative\n# Isoloom: machine `iis`, set up by cloudbase-init at its first boot.\n$ErrorActionPreference = 'Stop'\nif (Test-Path 'C:\\ProgramData\\isoloom\\done') { exit 0 }\nNew-Item -ItemType Directory -Force C:\\ProgramData\\isoloom | Out-Null\n# The administrator the controller's playbooks run as, over WinRM.\n$password = ConvertTo-SecureString '${random_password.windows.result}' -AsPlainText -Force\nif (Get-LocalUser -Name isoloom -ErrorAction SilentlyContinue) { Set-LocalUser -Name isoloom -Password $password -PasswordNeverExpires $true } else { New-LocalUser -Name isoloom -Password $password -PasswordNeverExpires | Out-Null }\nif (-not (Get-LocalGroupMember -SID S-1-5-32-544 | Where-Object { $_.Name -like '*\\isoloom' })) { Add-LocalGroupMember -SID S-1-5-32-544 -Member isoloom }\n# Its name takes a restart: cloudbase-init runs this script again after it (exit code 1003).\nif ($env:COMPUTERNAME -ne 'IIS') { Rename-Computer -NewName 'iis' -Force; exit 1003 }\n# The project, at C:\\isoloom.\nfunction Write-IsoloomFile($path, $b64) { $f = Join-Path 'C:\\isoloom' $path; New-Item -ItemType Directory -Force (Split-Path $f) | Out-Null; [IO.File]::WriteAllBytes($f, [Convert]::FromBase64String($b64)) }\n${join("\n", [for f in local.project_paths : "Write-IsoloomFile '${replace(f, "'", "''")}' '${filebase64("${local.root}/${f}")}'"])}\nNew-NetFirewallRule -DisplayName 'isoloom 80' -Direction Inbound -Protocol TCP -LocalPort 80 -Action Allow | Out-Null\nNew-NetFirewallRule -DisplayName 'isoloom 8087' -Direction Inbound -Protocol TCP -LocalPort 8087 -Action Allow | Out-Null\n$h = \"$env:SystemRoot\\System32\\drivers\\etc\\hosts\"; foreach ($l in @('10.67.0.10 iis')) { if (-not (Select-String -Path $h -SimpleMatch $l -Quiet)) { Add-Content -Path $h -Value $l } }\n$ErrorActionPreference = 'Stop'\n[Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12\nfunction Write-IsoloomChange {\n    param([Parameter(Mandatory)][string] $What)\n    Write-Output \"isoloom: changed $What\"\n    if ($env:ISOLOOM_CHANGED) {\n        New-Item -ItemType Directory -Force -Path (Split-Path -Parent $env:ISOLOOM_CHANGED) | Out-Null\n        Set-Content -LiteralPath $env:ISOLOOM_CHANGED -Value 'changed'\n    }\n}\nfunction Test-IsoloomRestartDue {\n    return [bool]($env:ISOLOOM_CHANGED -and (Test-Path -LiteralPath $env:ISOLOOM_CHANGED))\n}\nfunction Get-IsoloomHash {\n    param([Parameter(Mandatory)][string] $Path)\n    return (Get-FileHash -LiteralPath $Path -Algorithm SHA256).Hash.ToLowerInvariant()\n}\nfunction Install-IsoloomFeature {\n    param([Parameter(Mandatory)][string[]] $Name)\n    $server = [bool](Get-Command -Name Get-WindowsFeature -ErrorAction SilentlyContinue)\n    foreach ($feature in $Name) {\n        if ($server) {\n            if ((Get-WindowsFeature -Name $feature).Installed) { continue }\n            $result = Install-WindowsFeature -Name $feature -IncludeManagementTools\n            if (-not $result.Success) { throw \"isoloom: installing the feature $feature failed\" }\n        } else {\n            if ((Get-WindowsOptionalFeature -Online -FeatureName $feature).State -eq 'Enabled') { continue }\n            Enable-WindowsOptionalFeature -Online -FeatureName $feature -All -NoRestart | Out-Null\n        }\n        Write-IsoloomChange -What \"feature $feature\"\n    }\n}\nfunction Copy-IsoloomFile {\n    param([Parameter(Mandatory)][string] $From, [Parameter(Mandatory)][string] $To)\n    if ((Test-Path -LiteralPath $To -PathType Leaf) -and ((Get-IsoloomHash -Path $From) -eq (Get-IsoloomHash -Path $To))) {\n        return\n    }\n    $parent = Split-Path -Parent $To\n    if ($parent) { New-Item -ItemType Directory -Force -Path $parent | Out-Null }\n    Copy-Item -LiteralPath $From -Destination $To -Force\n    Write-IsoloomChange -What $To\n}\nfunction Copy-IsoloomItem {\n    param([Parameter(Mandatory)][string] $From, [Parameter(Mandatory)][string] $To)\n    if (-not (Test-Path -LiteralPath $From -PathType Container)) {\n        Copy-IsoloomFile -From $From -To $To\n        return\n    }\n    $root = (Resolve-Path -LiteralPath $From).Path.TrimEnd('\\', '/')\n    if (-not (Test-Path -LiteralPath $To -PathType Container)) {\n        New-Item -ItemType Directory -Force -Path $To | Out-Null\n        Write-IsoloomChange -What $To\n    }\n    foreach ($entry in Get-ChildItem -LiteralPath $root -Recurse -Force) {\n        $target = Join-Path -Path $To -ChildPath $entry.FullName.Substring($root.Length).TrimStart('\\', '/')\n        if ($entry.PSIsContainer) {\n            if (Test-Path -LiteralPath $target -PathType Container) { continue }\n            New-Item -ItemType Directory -Force -Path $target | Out-Null\n            Write-IsoloomChange -What $target\n        } else {\n            Copy-IsoloomFile -From $entry.FullName -To $target\n        }\n    }\n}\nfunction Install-IsoloomTemplate {\n    param([Parameter(Mandatory)][string] $To, [Parameter(Mandatory)][AllowEmptyString()][string] $Base64)\n    $temporary = [IO.Path]::GetTempFileName()\n    try {\n        [IO.File]::WriteAllBytes($temporary, [Convert]::FromBase64String($Base64))\n        Copy-IsoloomFile -From $temporary -To $To\n    } finally {\n        Remove-Item -LiteralPath $temporary -Force -ErrorAction SilentlyContinue\n    }\n}\nfunction Install-IsoloomFile {\n    param(\n        [Parameter(Mandatory)][string] $Path,\n        [Parameter(Mandatory)][ValidateSet('directory', 'absent', 'download')][string] $State,\n        [string] $Url,\n        [string] $Sha256\n    )\n    switch ($State) {\n        'directory' {\n            if (Test-Path -LiteralPath $Path -PathType Container) { return }\n            New-Item -ItemType Directory -Force -Path $Path | Out-Null\n        }\n        'absent' {\n            if (-not (Test-Path -LiteralPath $Path)) { return }\n            Remove-Item -LiteralPath $Path -Recurse -Force\n        }\n        'download' {\n            if ((Test-Path -LiteralPath $Path -PathType Leaf) -and ((Get-IsoloomHash -Path $Path) -eq $Sha256)) { return }\n            $parent = Split-Path -Parent $Path\n            if ($parent) { New-Item -ItemType Directory -Force -Path $parent | Out-Null }\n            $temporary = \"$Path.isoloom-download\"\n            Invoke-WebRequest -UseBasicParsing -Uri $Url -OutFile $temporary\n            $got = Get-IsoloomHash -Path $temporary\n            if ($got -ne $Sha256) {\n                Remove-Item -LiteralPath $temporary -Force\n                throw \"isoloom: $Url has SHA-256 $got, not $${Sha256}: the file changed upstream, or the pin is wrong\"\n            }\n            Move-Item -LiteralPath $temporary -Destination $Path -Force\n        }\n    }\n    Write-IsoloomChange -What $Path\n}\nfunction ConvertTo-IsoloomSecure {\n    param([Parameter(Mandatory)][string] $Phrase)\n    $secure = New-Object -TypeName System.Security.SecureString\n    foreach ($character in $Phrase.ToCharArray()) { $secure.AppendChar($character) }\n    return $secure\n}\nfunction Test-IsoloomPhrase {\n    param([Parameter(Mandatory)][string] $Name, [Parameter(Mandatory)][string] $Phrase)\n    Add-Type -AssemblyName System.DirectoryServices.AccountManagement\n    $machine = New-Object -TypeName System.DirectoryServices.AccountManagement.PrincipalContext -ArgumentList 'Machine'\n    try { return $machine.ValidateCredentials($Name, $Phrase) } finally { $machine.Dispose() }\n}\nfunction Add-IsoloomMember {\n    param([Parameter(Mandatory)][string] $Group, [Parameter(Mandatory)][string] $Name)\n    $members = Get-LocalGroupMember -Group $Group | ForEach-Object { ($_.Name -split '\\\\')[-1] }\n    if ($members -contains $Name) { return }\n    Add-LocalGroupMember -Group $Group -Member $Name\n    Write-IsoloomChange -What \"$Name in $Group\"\n}\nfunction Add-IsoloomUser {\n    param([Parameter(Mandatory)][string] $Name, [string] $Phrase, [string[]] $Groups = @())\n    if (-not (Get-LocalUser -Name $Name -ErrorAction SilentlyContinue)) {\n        if ($Phrase) {\n            New-LocalUser -Name $Name -Password (ConvertTo-IsoloomSecure -Phrase $Phrase) -PasswordNeverExpires | Out-Null\n        } else {\n            New-LocalUser -Name $Name -NoPassword | Out-Null\n        }\n        Write-IsoloomChange -What \"user $Name\"\n    } elseif ($Phrase -and -not (Test-IsoloomPhrase -Name $Name -Phrase $Phrase)) {\n        Set-LocalUser -Name $Name -Password (ConvertTo-IsoloomSecure -Phrase $Phrase)\n        Write-IsoloomChange -What \"password of $Name\"\n    }\n    foreach ($group in $Groups) { Add-IsoloomMember -Group $group -Name $Name }\n}\nfunction Add-IsoloomGroup {\n    param([Parameter(Mandatory)][string] $Name)\n    if (Get-LocalGroup -Name $Name -ErrorAction SilentlyContinue) { return }\n    New-LocalGroup -Name $Name | Out-Null\n    Write-IsoloomChange -What \"group $Name\"\n}\nfunction Register-IsoloomTask {\n    param([Parameter(Mandatory)][string] $Name, [Parameter(Mandatory)][string[]] $Run, [string] $Directory)\n    $arguments = ($Run | Select-Object -Skip 1 | ForEach-Object { '\"' + ($_ -replace '\"', '\\\"') + '\"' }) -join ' '\n    $settings = @{ Execute = $Run[0] }\n    if ($arguments) { $settings.Argument = $arguments }\n    if ($Directory) { $settings.WorkingDirectory = $Directory }\n    $action = New-ScheduledTaskAction @settings\n    $task = Get-ScheduledTask -TaskName \"isoloom-$Name\" -ErrorAction SilentlyContinue\n    $same = $task -and $task.Actions[0].Execute -eq $action.Execute -and $task.Actions[0].Arguments -eq $action.Arguments -and\n        $task.Actions[0].WorkingDirectory -eq $action.WorkingDirectory\n    if ($same) { return }\n    $trigger = New-ScheduledTaskTrigger -AtStartup\n    Register-ScheduledTask -TaskName \"isoloom-$Name\" -Action $action -Trigger $trigger -User 'SYSTEM' -RunLevel Highest -Force | Out-Null\n    Write-IsoloomChange -What \"task isoloom-$Name\"\n}\nfunction Register-IsoloomTaskState {\n    param([Parameter(Mandatory)][string] $Name, [Parameter(Mandatory)][bool] $Enabled)\n    $task = Get-ScheduledTask -TaskName \"isoloom-$Name\"\n    if (-not $Enabled) {\n        if ($task.State -eq 'Running') { Stop-ScheduledTask -TaskName \"isoloom-$Name\"; Write-IsoloomChange -What \"isoloom-$Name stopped\" }\n        if ($task.State -ne 'Disabled') { Disable-ScheduledTask -TaskName \"isoloom-$Name\" | Out-Null; Write-IsoloomChange -What \"isoloom-$Name disabled\" }\n        return\n    }\n    if ($task.State -eq 'Disabled') { Enable-ScheduledTask -TaskName \"isoloom-$Name\" | Out-Null; Write-IsoloomChange -What \"isoloom-$Name enabled\" }\n    if ((Get-ScheduledTask -TaskName \"isoloom-$Name\").State -ne 'Running') {\n        Start-ScheduledTask -TaskName \"isoloom-$Name\"\n        Write-IsoloomChange -What \"isoloom-$Name started\"\n    } elseif (Test-IsoloomRestartDue) {\n        Stop-ScheduledTask -TaskName \"isoloom-$Name\"\n        Start-ScheduledTask -TaskName \"isoloom-$Name\"\n        Write-Output \"isoloom: restarted isoloom-$Name\"\n    }\n}\nfunction Register-IsoloomService {\n    param([Parameter(Mandatory)][string] $Name, [Parameter(Mandatory)][bool] $Enabled)\n    $service = Get-Service -Name $Name -ErrorAction SilentlyContinue\n    if (-not $service) { throw \"isoloom: no Windows service $${Name}: install what provides it in an earlier step\" }\n    if (-not $Enabled) {\n        if ($service.StartType -ne 'Disabled') { Set-Service -Name $Name -StartupType Disabled; Write-IsoloomChange -What \"$Name disabled\" }\n        if ($service.Status -ne 'Stopped') { Stop-Service -Name $Name -Force; Write-IsoloomChange -What \"$Name stopped\" }\n        return\n    }\n    if ($service.StartType -ne 'Automatic') { Set-Service -Name $Name -StartupType Automatic; Write-IsoloomChange -What \"$Name enabled\" }\n    if ($service.Status -ne 'Running') {\n        Start-Service -Name $Name\n        Write-IsoloomChange -What \"$Name started\"\n    } elseif (Test-IsoloomRestartDue) {\n        Restart-Service -Name $Name -Force\n        Write-Output \"isoloom: restarted $Name\"\n    }\n}\nfunction Invoke-IsoloomCommand {\n    param([Parameter(Mandatory)][string] $Run, [string] $Creates, [string] $Unless)\n    if ($Creates -and (Test-Path -LiteralPath $Creates)) { return }\n    if ($Unless -and (Test-IsoloomScript -Text $Unless)) { return }\n    if (-not (Test-IsoloomScript -Text $Run -Loud)) { throw \"isoloom: the command failed: $Run\" }\n    Write-IsoloomChange -What 'command'\n}\nfunction Test-IsoloomScript {\n    param([Parameter(Mandatory)][string] $Text, [switch] $Loud)\n    Set-Variable -Name LASTEXITCODE -Scope Global -Value 0\n    try {\n        if ($Loud) { & ([scriptblock]::Create($Text)) } else { & ([scriptblock]::Create($Text)) | Out-Null }\n    } catch {\n        if ($Loud) { Write-Error -Message $_ -ErrorAction Continue }\n        return $false\n    }\n    return (Get-Variable -Name LASTEXITCODE -Scope Global -ValueOnly) -eq 0\n}\nfunction Enable-IsoloomFirewallPort {\n    param([Parameter(Mandatory)][int] $Port, [Parameter(Mandatory)][ValidateSet('TCP', 'UDP')][string] $Protocol)\n    $name = \"isoloom-$Port-$Protocol\"\n    if (Get-NetFirewallRule -Name $name -ErrorAction SilentlyContinue) { return }\n    New-NetFirewallRule -Name $name -DisplayName \"Isoloom $Port/$Protocol\" -Direction Inbound -Action Allow -Protocol $Protocol -LocalPort $Port | Out-Null\n    Write-IsoloomChange -What \"firewall $Port/$Protocol\"\n}\n$env:ISOLOOM_CHANGED = 'C:\\Windows\\Temp\\isoloom-configure.changed'\nRemove-Item -LiteralPath $env:ISOLOOM_CHANGED -Force -ErrorAction SilentlyContinue\nSet-Location -LiteralPath 'C:\\isoloom'\nInstall-IsoloomFeature -Name 'Web-Server'\nAdd-IsoloomGroup -Name 'Site Editors'\nAdd-IsoloomUser -Name 'editor' -Phrase 'Lab-content-1' -Groups 'Site Editors'\nInstall-IsoloomFile -Path 'C:\\inetpub\\isoloom' -State directory\nCopy-IsoloomItem -From 'site/' -To 'C:\\inetpub\\wwwroot'\nInstall-IsoloomTemplate -To 'C:\\inetpub\\wwwroot\\about.txt' -Base64 'aWlzIGF0IDEwLjY3LjAuMTAsIGNvbmZpZ3VyZWQgYnkgaXNvbG9vbS4K'\nInvoke-IsoloomCommand -Run 'Set-Content -Path C:\\inetpub\\isoloom\\stamp.txt -Value configured' -Creates 'C:\\inetpub\\isoloom\\stamp.txt'\nEnable-IsoloomFirewallPort -Port 80 -Protocol TCP\nRegister-IsoloomService -Name 'W3SVC' -Enabled $true\nNew-Item -ItemType Directory -Force C:\\isoloom | Out-Null; Set-Content C:\\isoloom\\ready ready\n# WinRM for the controller, last: a machine that answers is set up.\nNew-ItemProperty -Path HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System -Name LocalAccountTokenFilterPolicy -Value 1 -PropertyType DWord -Force | Out-Null\nGet-NetConnectionProfile | Set-NetConnectionProfile -NetworkCategory Private -ErrorAction SilentlyContinue\nEnable-PSRemoting -Force -SkipNetworkProfileCheck | Out-Null\nSet-Item WSMan:\\localhost\\Service\\Auth\\Basic $true\nSet-Item WSMan:\\localhost\\Service\\AllowUnencrypted $true\nif (-not (Get-NetFirewallRule -DisplayName 'isoloom winrm' -ErrorAction SilentlyContinue)) { New-NetFirewallRule -DisplayName 'isoloom winrm' -Direction Inbound -Protocol TCP -LocalPort 5985 -Action Allow | Out-Null }\nNew-Item -ItemType File -Force 'C:\\ProgramData\\isoloom\\done' | Out-Null\n"
  }
}

resource "proxmox_virtual_environment_vm" "iis" {
  name      = "iso${var.slot}-iis"
  node_name = var.node
  tags      = ["isoloom", "configured-windows"]
  pool_id   = proxmox_virtual_environment_pool.env.pool_id
  on_boot   = false
  bios      = "ovmf"
  machine   = "q35"
  cpu {
    cores = 2
    type  = "host"
  }
  memory {
    dedicated = 3072
  }
  clone {
    vm_id = var.template_windows_server_2022
    full  = true
  }
  efi_disk {
    datastore_id = var.datastore
    type         = "4m"
  }
  network_device {
    bridge   = proxmox_sdn_vnet.lab.id
    firewall = true
  }
  initialization {
    datastore_id      = var.datastore
    type              = "configdrive2"
    user_data_file_id = proxmox_virtual_environment_file.iis.id
    dns {
      servers = ["1.1.1.1"]
    }
    ip_config {
      ipv4 {
        address = "10.67.0.10/24"
        gateway = "10.67.0.254"
      }
    }
  }
  operating_system {
    type = "win11"
  }
  depends_on = [proxmox_virtual_environment_vm.isoloom_router]
}

# Machine `iis`'s firewall: what reaches it, outside the guest.
resource "proxmox_virtual_environment_firewall_options" "iis" {
  node_name     = var.node
  vm_id         = proxmox_virtual_environment_vm.iis.vm_id
  enabled       = true
  input_policy  = "DROP"
  output_policy = "ACCEPT"
}

resource "proxmox_virtual_environment_firewall_rules" "iis" {
  node_name = var.node
  vm_id     = proxmox_virtual_environment_vm.iis.vm_id
  rule {
    type    = "in"
    action  = "ACCEPT"
    comment = "network lab"
    source  = "+${proxmox_virtual_environment_firewall_ipset.lab.name}"
  }
  rule {
    type    = "in"
    action  = "ACCEPT"
    comment = "published"
    proto   = "tcp"
    dport   = "80"
  }
}

# The controller: runs the environment's playbooks once every machine is up.
resource "proxmox_virtual_environment_file" "controller" {
  node_name    = var.node
  datastore_id = var.snippets_datastore
  content_type = "snippets"
  source_raw {
    file_name = "iso${var.slot}-controller.yaml"
    data = format("#cloud-config\n%s", yamlencode({
      hostname = "isoloom-controller"
      users    = local.users
      packages = ["python3-venv", "curl", "netcat-openbsd", "openssh-client"]
      write_files = concat(local.project_files, [
        {
          path        = "/etc/isoloom/id_ed25519"
          permissions = "0600"
          content     = tls_private_key.controller.private_key_openssh
        },
        {
          path        = "/etc/isoloom/inventory.ini"
          permissions = "0644"
          content     = "[linux]\n\n[windows]\niis ansible_host=10.67.0.10\n\n[linux:vars]\nansible_ssh_private_key_file=/etc/isoloom/id_ed25519\nansible_become=true\n\n[windows:vars]\nansible_user=isoloom\nansible_password=${random_password.windows.result}\nansible_connection=winrm\nansible_port=5985\nansible_winrm_scheme=http\nansible_winrm_transport=basic\nansible_winrm_server_cert_validation=ignore\nansible_winrm_operation_timeout_sec=400\nansible_winrm_read_timeout_sec=500\n"
        }
      ])
      runcmd = [
        "mkdir -p /var/lib/isoloom",
        "echo 'running: hosts file' > /var/lib/isoloom/ready; sh -c 'printf '\\''%s\\n'\\'' '\\''10.67.0.10 iis'\\'' >> /etc/hosts' || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }",
        "echo 'running: installing Ansible' > /var/lib/isoloom/ready; sh -c '[ -x /opt/ansible/bin/ansible-playbook ] || { python3 -m venv /opt/ansible && /opt/ansible/bin/pip install -q '\\''ansible-core>=2.15,<2.17'\\'' pywinrm; }' || { echo 'failed: installing Ansible' > /var/lib/isoloom/ready; exit 1; }",
        "echo 'running: waiting for the Windows machines' > /var/lib/isoloom/ready; sh -c 'i=0; until /opt/ansible/bin/ansible -i /etc/isoloom/inventory.ini iis -m raw -a '\\''if (-not (Test-Path C:\\isoloom\\ready)) { exit 1 }'\\'' >/dev/null 2>&1; do i=$((i+1)); [ $i -gt 360 ] && { echo '\\''iis not ready'\\''; exit 1; }; sleep 10; done' || { echo 'failed: waiting for the Windows machines' > /var/lib/isoloom/ready; exit 1; }",
        "echo 'running: the playbooks' > /var/lib/isoloom/ready; sh -c 'set -e\nmkdir -p /tmp/isoloom-facts\nexport PATH=\"/opt/ansible/bin:$PATH\" ANSIBLE_HOST_KEY_CHECKING=False ANSIBLE_GATHERING=smart ANSIBLE_FORKS=20 ANSIBLE_PIPELINING=True ANSIBLE_CACHE_PLUGIN=jsonfile ANSIBLE_CACHE_PLUGIN_CONNECTION=/tmp/isoloom-facts ANSIBLE_CACHE_PLUGIN_TIMEOUT=7200\nmkdir -p /tmp/isoloom-retry\nexport ANSIBLE_RETRY_FILES_ENABLED=True ANSIBLE_RETRY_FILES_SAVE_PATH=/tmp/isoloom-retry\n_isoloom_pause=$${ISOLOOM_RETRY_PAUSE:-15}\n_isoloom_attempts=4\n_isoloom_transient='\\''send_input failed|the pipe has been ended|winrmtransporterror|winrmoperationtimeouterror|read timeout|bad http response returned from server|(kerberos|ntlm|credssp).*500|remote end closed connection|connection reset by peer|connection refused|connection aborted|broken pipe|timed out|failed to connect to the host via ssh|shared connection to .* closed'\\''\nretry_download() {\n  _isoloom_n=1\n  until \"$@\"; do\n    [ \"$_isoloom_n\" -lt 5 ] || return 1\n    echo \"isoloom: download failed; trying again in $((_isoloom_n * _isoloom_pause)) s ($((_isoloom_n + 1))/5)\"\n    sleep $((_isoloom_n * _isoloom_pause))\n    _isoloom_n=$((_isoloom_n + 1))\n  done\n}\nplay_hosts() {\n  awk -v transient=\"$_isoloom_transient\" '\\''\n    function commit() {\n      if (pending != \"\") { if (pending_real) real[pending] = 1; else cut[pending] = 1 }\n      pending = \"\"\n    }\n    { gsub(/\\033\\[[0-9;]*m/, \"\") }\n    /^\\.\\.\\.ignoring/ { pending = \"\"; next }\n    { commit() }\n    /^(fatal|failed): \\[/ && !/UNREACHABLE!/ {\n      pending = $0\n      sub(/^(fatal|failed): \\[/, \"\", pending)\n      sub(/\\].*/, \"\", pending)\n      sub(/ -> .*/, \"\", pending)\n      pending_real = (tolower($0) !~ transient)\n      next\n    }\n    /^PLAY RECAP/ { recap = 1; next }\n    recap && / : ok=/ {\n      for (i = 2; i <= NF; i++) {\n        split($i, kv, \"=\")\n        if (kv[1] == \"failed\" && kv[2] > 0) failed[$1] = 1\n        if (kv[1] == \"unreachable\" && kv[2] > 0) unreachable[$1] = 1\n      }\n    }\n    END {\n      commit()\n      for (h in failed) print ((h in real || !(h in cut)) ? \"real \" : \"cut \") h\n      for (h in unreachable) if (!(h in failed)) print \"unreachable \" h\n    }\n  '\\'' \"$1\" | sort\n}\n_isoloom_kind() {\n  echo \"$1\" | awk -v k=\"$2\" '\\''$1 == k { printf \"%s%s\", s, $2; s = \" \" }'\\''\n}\nrun_play() {\n  # The playbook is the last argument; Ansible names its retry file after it.\n  for _isoloom_book; do :; done\n  _isoloom_name=$(basename \"$_isoloom_book\")\n  _isoloom_retry=$${ANSIBLE_RETRY_FILES_SAVE_PATH:-/tmp/isoloom-retry}/$${_isoloom_name%.*}.retry\n  _isoloom_limit=\n  _isoloom_log=$(mktemp)\n  _isoloom_rcf=$(mktemp)\n  _isoloom_n=1\n  rm -f \"$_isoloom_retry\"\n  while :; do\n    { \"$@\" && echo 0 > \"$_isoloom_rcf\" || echo $? > \"$_isoloom_rcf\"; } 2>&1 | tee \"$_isoloom_log\"\n    _isoloom_rc=$(cat \"$_isoloom_rcf\")\n    [ \"$_isoloom_rc\" -ne 0 ] || break\n    _isoloom_hosts=$(play_hosts \"$_isoloom_log\")\n    _isoloom_real=$(_isoloom_kind \"$_isoloom_hosts\" real)\n    _isoloom_gone=$(_isoloom_kind \"$_isoloom_hosts\" unreachable)\n    _isoloom_cut=$(_isoloom_kind \"$_isoloom_hosts\" cut)\n    _isoloom_again=\"$_isoloom_gone$${_isoloom_gone:+$${_isoloom_cut:+ }}$_isoloom_cut\"\n    if [ -n \"$_isoloom_real\" ]; then\n      echo \"isoloom: $_isoloom_name: a task failed on $_isoloom_real: not retried\"\n      break\n    fi\n    if [ -z \"$_isoloom_again\" ]; then\n      echo \"isoloom: $_isoloom_name failed (exit $_isoloom_rc) with no unreachable host or dropped connection: not retried\"\n      break\n    fi\n    if [ \"$_isoloom_n\" -ge \"$_isoloom_attempts\" ]; then\n      echo \"isoloom: $_isoloom_name: still unreachable after $_isoloom_n runs: $_isoloom_again; giving up\"\n      break\n    fi\n    echo \"$_isoloom_again\" | tr '\\'' '\\'' '\\''\\n'\\'' > \"$_isoloom_retry\"\n    if [ -z \"$_isoloom_limit\" ]; then set -- \"$@\" --limit \"@$_isoloom_retry\"; _isoloom_limit=1; fi\n    _isoloom_n=$((_isoloom_n + 1))\n    if [ -n \"$_isoloom_gone\" ]; then\n      _isoloom_wait=$((4 * _isoloom_pause))\n      echo \"isoloom: $_isoloom_name: unreachable: $_isoloom_again; waiting $_isoloom_wait s, then running it again on them ($_isoloom_n/$_isoloom_attempts)\"\n    else\n      _isoloom_wait=$((2 * _isoloom_pause))\n      echo \"isoloom: $_isoloom_name: the play was cut by a dropped connection on $_isoloom_cut; waiting $_isoloom_wait s, then running it again on them ($_isoloom_n/$_isoloom_attempts)\"\n    fi\n    sleep \"$_isoloom_wait\"\n  done\n  rm -f \"$_isoloom_log\" \"$_isoloom_rcf\"\n  [ \"$_isoloom_rc\" -ne 0 ] || rm -f \"$_isoloom_retry\"\n  return \"$_isoloom_rc\"\n}' || { echo 'failed: the playbooks' > /var/lib/isoloom/ready; exit 1; }",
        "echo 'running: health check' > /var/lib/isoloom/ready; sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready' || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }"
      ]
    }))
  }
}

resource "proxmox_virtual_environment_vm" "isoloom_controller" {
  name      = "iso${var.slot}-controller"
  node_name = var.node
  tags      = ["isoloom", "configured-windows"]
  pool_id   = proxmox_virtual_environment_pool.env.pool_id
  on_boot   = false
  cpu {
    cores = 1
    type  = "host"
  }
  memory {
    dedicated = 512
  }
  disk {
    datastore_id = var.datastore
    file_id      = proxmox_download_file.debian_12.id
    interface    = "virtio0"
    size         = 8
  }
  network_device {
    bridge = var.uplink_bridge
  }
  network_device {
    bridge = proxmox_sdn_vnet.lab.id
  }
  initialization {
    datastore_id      = var.datastore
    user_data_file_id = proxmox_virtual_environment_file.controller.id
    dns {
      servers = ["1.1.1.1"]
    }
    ip_config {
      ipv4 {
        address = "dhcp"
      }
    }
    ip_config {
      ipv4 {
        address = "10.67.0.253/24"
      }
    }
  }
  operating_system {
    type = "l26"
  }
  serial_device {}
  depends_on = [proxmox_virtual_environment_vm.isoloom_router, proxmox_virtual_environment_vm.iis]
}

locals {
  router_address = try([for a in flatten(proxmox_virtual_environment_vm.isoloom_router.ipv4_addresses) : a if a != "127.0.0.1" && !contains(["10.67.0.254"], a)][0], "")
}

# The router's uplink address: the lab's way in.
output "ip" {
  value = local.router_address
}

# Each Linux machine's set-up progress (`isoloom-ready/1`: `running: <step>`, `failed: <step>`, `ready`).
output "ready_file" {
  value = "/var/lib/isoloom/ready"
}

# Published services, from the router's uplink address.
output "published" {
  value = { "iis/http" = "${local.router_address}:8087" }
}

# The machines, through the router: ssh -J isoloom@<ip> isoloom@<machine>.
output "machines" {
  value = { iis = "10.67.0.10" }
}

output "ssh_user" {
  value = "isoloom"
}

# The checks: each runner piped to its machine (ssh -J isoloom@<ip> isoloom@<host> sh -s < <script>).
output "checks" {
  value = [
    {
      position = "networks"
      machine  = "controller"
      host     = "10.67.0.253"
      user     = "isoloom"
      script   = ".isoloom/proxmox/checks/networks.sh"
    }
  ]
}

# The project's files the machines don't get: version control and the tools' state, and what
# .isoloomignore at the project's root lists (gitignore-style: one pattern per line, `#` comments,
# `!` brings a path back, a trailing `/` matches folders only, a `/` at the start or in the middle
# anchors the pattern at the root; `*`, `?`, `[abc]`, `**`; the last pattern matching a path, or
# a folder it is in, decides). Read as regular expressions, as the Vagrantfiles do.
locals {
  project_ignore_lines = [for l in split("\n", replace(try(file("${local.root}/.isoloomignore"), ""), "\r", "")) : trimspace(l)]
  project_ignore_pats  = [for l in local.project_ignore_lines : { keep = startswith(l, "!"), pat = trimprefix(l, "!") } if l != "" && !startswith(l, "#")]
  project_ignore_globs = [for r in local.project_ignore_pats : merge(r, { glob = trimsuffix(trimsuffix(trimsuffix(r.pat, "/"), "/**"), "/") })]
  project_ignore = [for r in local.project_ignore_globs : {
    keep = r.keep
    re = format(r.glob == r.pat ? "^%s(/|$)" : "^%s/", replace(replace(replace(replace(replace(replace(replace(replace(
      length(split("/", r.glob)) > 1 ? trimprefix(r.glob, "/") : "**/${r.glob}",
    "/[.+^$(){}|\\\\]/", "\\$0"), "[!", "[^"), "**/", "\u0001"), "**", "\u0002"), "*", "[^/]*"), "?", "[^/]"), "\u0001", "(.*/)?"), "\u0002", ".*"))
  } if r.glob != ""]
  # Each file: whether it goes (the last matching pattern decides; none: it goes).
  project_keep  = { for f in fileset(local.root, "**") : f => reverse(concat([true], [for r in local.project_ignore : r.keep if length(regexall(r.re, f)) > 0]))[0] }
  project_paths = [for f, keep in local.project_keep : f if keep && length(regexall("^\\.isoloom|(^|/)\\.(git|vagrant|terraform)/", f)) == 0]
}

## .isoloom/proxmox/run.json
{
  "$schema": "https://www.isoloom.com/schema/run-manifest/v0.json",
  "manifest_version": 0,
  "generator": {
    "name": "isoloom",
    "version": "0.11.0"
  },
  "lab": {
    "name": "configured-windows",
    "instance": null,
    "message": null
  },
  "target": "proxmox",
  "driver": "terraform",
  "hosts": [
    "linux",
    "macos",
    "windows"
  ],
  "tools": [
    {
      "name": "terraform",
      "probe": [
        "terraform",
        "version"
      ],
      "min_version": "1.6.0",
      "container": "hashicorp/terraform:1.9.8@sha256:18f9986038bbaf02cf49db9c09261c778161c51dcc7fb7e355ae8938459428cd",
      "container_hosts": [
        "macos"
      ]
    },
    {
      "name": "ssh",
      "probe": [
        "ssh",
        "-V"
      ]
    }
  ],
  "identity": {
    "terraform": {
      "module": ".",
      "state": "runner"
    }
  },
  "params": [
    {
      "name": "proxmox_endpoint",
      "description": "https://<server>:8006/.",
      "required": true,
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_endpoint"
        }
      ]
    },
    {
      "name": "proxmox_username",
      "description": "The module's `proxmox_username`.",
      "default": "root@pam",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_username"
        }
      ]
    },
    {
      "name": "proxmox_insecure",
      "description": "Accept the server's self-signed certificate.",
      "default": "true",
      "values": [
        "true",
        "false"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_insecure"
        }
      ]
    },
    {
      "name": "proxmox_ssh_username",
      "description": "Uploading cloud-init snippets goes over SSH to the node.",
      "default": "root",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_ssh_username"
        }
      ]
    },
    {
      "name": "proxmox_ssh_address",
      "description": "The node's SSH address, when the API reports one this machine can't reach.",
      "default": "",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_ssh_address"
        }
      ]
    },
    {
      "name": "node",
      "description": "The Proxmox node the VMs go on (`pvesh get /nodes` lists them).",
      "required": true,
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "node"
        }
      ]
    },
    {
      "name": "datastore",
      "description": "Where VM disks go.",
      "default": "local-lvm",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "datastore"
        }
      ]
    },
    {
      "name": "image_datastore",
      "description": "A datastore with 'iso' content, for cloud images.",
      "default": "local",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "image_datastore"
        }
      ]
    },
    {
      "name": "snippets_datastore",
      "description": "A datastore with 'snippets' content, for cloud-init.",
      "default": "local",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "snippets_datastore"
        }
      ]
    },
    {
      "name": "uplink_bridge",
      "description": "The bridge the router reaches the internet through.",
      "default": "vmbr0",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "uplink_bridge"
        }
      ]
    },
    {
      "name": "template_windows_server_2022",
      "description": "The VM id of a `windows-server-2022` template: cloudbase-init and the VirtIO drivers installed, UEFI on Q35, its disk on virtio0, sysprepped.",
      "required": true,
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "template_windows_server_2022"
        }
      ]
    },
    {
      "name": "ISOLOOM_DERIVED",
      "description": "0: the checks derived from the spec (reachability, no internet) are skipped.",
      "default": "1",
      "values": [
        "0",
        "1"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_DERIVED",
          "steps": [
            "check-networks"
          ]
        }
      ]
    }
  ],
  "secrets": [
    {
      "name": "proxmox_api_token",
      "kind": "connection",
      "required": false,
      "sensitive": true,
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_api_token"
        }
      ]
    },
    {
      "name": "proxmox_password",
      "kind": "connection",
      "required": false,
      "sensitive": true,
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_password"
        }
      ]
    }
  ],
  "networks": [
    {
      "name": "lab",
      "cidr": "10.67.0.0/24",
      "internet": true,
      "native": "i${run.slot}n0"
    }
  ],
  "machines": [
    {
      "name": "iis",
      "role": "target",
      "os": "windows-server-2022",
      "windows": true,
      "arch": "amd64",
      "addresses": {
        "lab": "10.67.0.10"
      },
      "ports": [
        {
          "name": "http",
          "port": 80,
          "protocol": "tcp",
          "http": true,
          "publish": {
            "mode": "fixed",
            "preferred": 8087,
            "address": "${outputs.ip}"
          }
        }
      ]
    },
    {
      "name": "isoloom-router",
      "role": "infra",
      "addresses": {
        "lab": "10.67.0.254"
      }
    },
    {
      "name": "isoloom-controller",
      "role": "infra",
      "addresses": {
        "lab": "10.67.0.253"
      }
    }
  ],
  "lifecycle": {
    "up": [
      {
        "id": "clear-lock",
        "action": "terraform.clear_lock"
      },
      {
        "id": "init",
        "note": "Preparing Terraform and its providers…",
        "argv": [
          "terraform",
          "init",
          "-input=false",
          "-no-color",
          "-backend-config=path=${run.state_dir}/terraform.tfstate"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_proxmox_ssh_private_key_file": "${run.ssh_key}",
          "TF_VAR_slot": "${run.slot}",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 600
      },
      {
        "id": "apply",
        "note": "Creating the lab's VMs on the server…",
        "argv": [
          "terraform",
          "apply",
          "-auto-approve",
          "-input=false",
          "-no-color"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_proxmox_ssh_private_key_file": "${run.ssh_key}",
          "TF_VAR_slot": "${run.slot}",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 3600
      }
    ],
    "down": [
      {
        "id": "clear-lock",
        "action": "terraform.clear_lock"
      },
      {
        "id": "init",
        "note": "Preparing Terraform and its providers…",
        "argv": [
          "terraform",
          "init",
          "-input=false",
          "-no-color",
          "-backend-config=path=${run.state_dir}/terraform.tfstate"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_proxmox_ssh_private_key_file": "${run.ssh_key}",
          "TF_VAR_slot": "${run.slot}",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 600
      },
      {
        "id": "destroy",
        "note": "Removing the lab from the server…",
        "argv": [
          "terraform",
          "destroy",
          "-auto-approve",
          "-input=false",
          "-no-color",
          "-refresh=false"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_proxmox_ssh_private_key_file": "${run.ssh_key}",
          "TF_VAR_slot": "${run.slot}",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 1800
      }
    ],
    "status": {
      "id": "state",
      "action": "terraform.read_state"
    }
  },
  "ready": [
    {
      "kind": "step_ok",
      "step": "apply",
      "means": "the VMs exist and booted; each sets itself up from its cloud-init"
    },
    {
      "kind": "ready_file",
      "host": "10.67.0.253",
      "user": "isoloom",
      "path": "${outputs.ready_file}",
      "log": "/var/log/cloud-init-output.log",
      "grammar": "isoloom-ready/1",
      "via": "isoloom@${outputs.ip}",
      "timeout_s": 7200,
      "unreachable_timeout_s": 600,
      "interval_s": 10
    }
  ],
  "outputs": [
    {
      "name": "ip",
      "description": "The router's uplink address: the published ports answer there, and SSH reaches the machines through it.",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ip"
      }
    },
    {
      "name": "ssh_user",
      "description": "The user every Linux VM and the router let in with the runner's key.",
      "role": "info",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ssh_user"
      }
    },
    {
      "name": "ready_file",
      "description": "Where each Linux machine's set-up says how far it got (isoloom-ready/1).",
      "role": "info",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ready_file"
      }
    },
    {
      "name": "iis_http",
      "description": "iis's http (port 80).",
      "role": "entry",
      "sensitive": false,
      "format": "http://${outputs.ip}:${value}/",
      "from": {
        "kind": "published_port",
        "machine": "iis",
        "port": "http"
      }
    }
  ],
  "checks": {
    "protocol": "isoloom-check/1",
    "setup": [],
    "runners": [
      {
        "id": "networks",
        "from": "from controller",
        "checks": [
          {
            "name": "checks/iis-answers.sh",
            "kind": "script",
            "wait_s": 0,
            "derived": false
          },
          {
            "name": "iis:80 from the networks",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          }
        ],
        "step": {
          "id": "check-networks",
          "action": "ssh.run",
          "with": {
            "command": "ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} sh -s",
            "host": "10.67.0.253",
            "user": "isoloom",
            "via": "isoloom@${outputs.ip}"
          },
          "stdin": "checks/networks.sh",
          "timeout_s": 120
        }
      }
    ],
    "teardown": []
  }
}

## .isoloom/resolved.json: identical in the `vagrant` snapshot
