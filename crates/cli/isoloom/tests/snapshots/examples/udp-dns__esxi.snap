# _retry SECONDS COMMAND... -> keeps trying every 2s until it passes or the time is up.
_retry() { _end=$(( $(date +%s) + $1 )); shift; while ! "$@"; do [ "$(date +%s)" -lt "$_end" ] || return 1; sleep 2; done; }

if [ "${ISOLOOM_DERIVED:-1}" != 0 ]; then
c=$(_http 'http://1.1.1.1/'); if [ "$c" = 000 ]; then pass 'no internet from dns'; else fail 'no internet from dns' "http://1.1.1.1/ answered (HTTP $c); it should be blocked"; fi
fi

echo "isoloom-check: END $passed passed, $failed failed"
[ "$failed" -eq 0 ]

## .isoloom/esxi/main.tf
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Needs:  ovftool on this machine, SSH enabled on the ESXi host
# Auth:   export TF_VAR_esxi_password=<password> (from the environment: never on a command line)
# Start:  terraform -chdir=.isoloom/esxi init && terraform -chdir=.isoloom/esxi apply -var esxi_hostname=<host> \
#           -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)" -var ssh_private_key_file=~/.ssh/id_ed25519
# Stop:   terraform -chdir=.isoloom/esxi destroy (same variables)

terraform {
  required_version = ">= 1.6.0"
  backend "local" {}
  required_providers {
    esxi  = { source = "josenk/esxi", version = "~> 1.10.3" }
    tls   = { source = "hashicorp/tls", version = "~> 4.4.1" }
    local = { source = "hashicorp/local", version = "~> 2.9.1" }
  }
}

variable "esxi_hostname" {
  type        = string
  description = "The ESXi host's name or address"
}

variable "esxi_hostport" {
  type        = string
  default     = "22"
  description = "Its SSH port: the provider works over SSH"
}

variable "esxi_hostssl" {
  type    = string
  default = "443"
}

variable "esxi_username" {
  type    = string
  default = "root"
}

variable "esxi_password" {
  type      = string
  sensitive = true
}

variable "disk_store" {
  type        = string
  default     = "datastore1"
  description = "Where the VMs' disks go"
}

variable "uplink_port_group" {
  type        = string
  default     = "VM Network"
  description = "The port group the router reaches the internet through (DHCP)"
}

variable "slot" {
  type        = number
  default     = 1
  description = "1 to 63, unique per environment on this host: it names the vSwitches and the VMs, and makes the MACs"
  validation {
    condition     = var.slot >= 1 && var.slot <= 63
    error_message = "slot is 1 to 63."
  }
}

variable "images" {
  type = map(string)
  default = {
    "ubuntu-24.04" = "https://cloud-images.ubuntu.com/noble/20260926/noble-server-cloudimg-amd64.ova"
  }
  description = "An OVA per OS, a path or a URL: Ubuntu's cloud OVAs by default (the provider checks no hash: their SHA-256, as Ubuntu publishes them, ubuntu-24.04 513a22ebe3982b9387b038f8a2a6dad1af980d4623dca03511312e55ba620b1a); for another OS, an OVA with cloud-init and open-vm-tools"
  validation {
    condition     = alltrue([for os in ["debian-12", "ubuntu-24.04"] : contains(keys(var.images), os)])
    error_message = "images needs an OVA for each of: debian-12, ubuntu-24.04."
  }
}

variable "ssh_public_key" {
  type        = string
  description = "The SSH public key the machines let in: whoever holds its private key signs in, as Terraform does to set them up (`ssh_private_key_file`), and the checks by hand"
}

variable "ssh_private_key_file" {
  type        = string
  description = "The private key of ssh_public_key: Terraform sets the machines up over SSH, through the router"
}

provider "esxi" {
  esxi_hostname = var.esxi_hostname
  esxi_hostport = var.esxi_hostport
  esxi_hostssl  = var.esxi_hostssl
  esxi_username = var.esxi_username
  esxi_password = var.esxi_password
}

# The project's root, and the `isoloom` user on every VM.
locals {
  root = abspath("${path.module}/../..")
  users = [
    {
      name                = "isoloom"
      sudo                = "ALL=(ALL) NOPASSWD:ALL"
      shell               = "/bin/bash"
      ssh_authorized_keys = [var.ssh_public_key]
    }
  ]
}

# Network `servers`: 10.66.10.0/24, on its own vSwitch with no uplink.
resource "esxi_vswitch" "servers" {
  name = "iso${var.slot}-servers"
}

resource "esxi_portgroup" "servers" {
  name    = "iso${var.slot}-servers"
  vswitch = esxi_vswitch.servers.name
  vlan    = 4095
}

# Network `users`: 10.66.20.0/24, on its own vSwitch with no uplink.
resource "esxi_vswitch" "users" {
  name = "iso${var.slot}-users"
}

resource "esxi_portgroup" "users" {
  name    = "iso${var.slot}-users"
  vswitch = esxi_vswitch.users.name
  vlan    = 4095
}

# The router: forwards between networks with the reach rules, and to the internet. The run's seal closes the internet to the internet: false networks once the machines are set up. VMware Tools reports its uplink address.
resource "esxi_guest" "isoloom_router" {
  guest_name            = "iso${var.slot}-isoloom-router"
  notes                 = "isoloom: udp-dns"
  disk_store            = var.disk_store
  ovf_source            = var.images["ubuntu-24.04"]
  numvcpus              = "1"
  memsize               = "512"
  boot_disk_size        = "10"
  power                 = "on"
  guest_startup_timeout = 600
  network_interfaces {
    virtual_network = var.uplink_port_group
    mac_address     = format("00:50:56:%02x:%02x:%02x", var.slot, 0, 0)
    nic_type        = "vmxnet3"
  }
  network_interfaces {
    virtual_network = esxi_portgroup.servers.name
    mac_address     = format("00:50:56:%02x:%02x:%02x", var.slot, 0, 1)
    nic_type        = "vmxnet3"
  }
  network_interfaces {
    virtual_network = esxi_portgroup.users.name
    mac_address     = format("00:50:56:%02x:%02x:%02x", var.slot, 0, 2)
    nic_type        = "vmxnet3"
  }
  guestinfo = {
    metadata = base64encode(yamlencode({
      instance-id    = "iso${var.slot}-isoloom-router"
      local-hostname = "isoloom-router"
      network = {
        version = 2
        ethernets = {
          nic0 = { match = { macaddress = format("00:50:56:%02x:%02x:%02x", var.slot, 0, 0) }, dhcp4 = true }
          nic1 = {
            match     = { macaddress = format("00:50:56:%02x:%02x:%02x", var.slot, 0, 1) }
            addresses = ["10.66.10.254/24"]
          }
          nic2 = {
            match     = { macaddress = format("00:50:56:%02x:%02x:%02x", var.slot, 0, 2) }
            addresses = ["10.66.20.254/24"]
          }
        }
      }
    }))
    "metadata.encoding" = "base64"
    userdata = base64encode(format("#cloud-config\n%s", yamlencode({
      hostname = "isoloom-router"
      users    = local.users
      packages = ["nftables"]
      write_files = [
        {
          path    = "/etc/nftables.conf"
          content = "flush ruleset\ntable inet isoloom {\n  chain forward {\n    type filter hook forward priority 0; policy drop;\n    ct state established,related accept\n    ip saddr 10.66.20.0/24 ip daddr 10.66.10.0/24 meta l4proto { tcp, udp } th dport { 53 } accept\n    ip saddr 10.66.20.0/24 ip daddr 10.66.10.0/24 icmp type echo-request accept\n    ip daddr 10.66.10.53 udp dport 53 ct status dnat accept\n    ip saddr { 10.66.10.0/24, 10.66.20.0/24 } ip daddr != { 10.66.10.0/24, 10.66.20.0/24 } accept\n  }\n  chain prerouting {\n    type nat hook prerouting priority -100;\n    ip saddr != { 10.66.10.0/24, 10.66.20.0/24 } udp dport 10053 dnat ip to 10.66.10.53:53\n  }\n  chain postrouting {\n    type nat hook postrouting priority 100;\n    ip saddr { 10.66.10.0/24, 10.66.20.0/24 } ip daddr != { 10.66.10.0/24, 10.66.20.0/24 } masquerade\n  }\n}\n"
        },
        { path = "/etc/sysctl.d/90-isoloom.conf", content = "net.ipv4.ip_forward=1\n" },
        {
          path    = "/etc/nftables.sealed.nft"
          content = "flush ruleset\ntable inet isoloom {\n  chain forward {\n    type filter hook forward priority 0; policy drop;\n    ct state established,related accept\n    ip saddr 10.66.20.0/24 ip daddr 10.66.10.0/24 meta l4proto { tcp, udp } th dport { 53 } accept\n    ip saddr 10.66.20.0/24 ip daddr 10.66.10.0/24 icmp type echo-request accept\n    ip daddr 10.66.10.53 udp dport 53 ct status dnat accept\n    ip daddr { 10.66.10.0/24, 10.66.20.0/24 } drop\n  }\n  chain prerouting {\n    type nat hook prerouting priority -100;\n    ip saddr != { 10.66.10.0/24, 10.66.20.0/24 } udp dport 10053 dnat ip to 10.66.10.53:53\n  }\n  chain postrouting {\n    type nat hook postrouting priority 100;\n  }\n}\n"
        }
      ]
      runcmd = [
        "sysctl -p /etc/sysctl.d/90-isoloom.conf",
        "systemctl enable --now nftables",
        "nft -f /etc/nftables.conf"
      ]
    })))
    "userdata.encoding" = "base64"
  }
  lifecycle {
    postcondition {
      condition     = self.ip_address != "" && !contains(["10.66.10.254", "10.66.20.254"], self.ip_address)
      error_message = "The router got no address on its uplink port group `${var.uplink_port_group}`: it has no DHCP (VMware Tools then reports one of the environment's addresses). Give it an uplink with DHCP and internet (`uplink_port_group`; on a nested ESXi, promiscuous mode on)."
    }
  }
  depends_on = [esxi_portgroup.servers, esxi_portgroup.users]
}

# Machine `dns`.
resource "esxi_guest" "dns" {
  guest_name     = "iso${var.slot}-dns"
  notes          = "isoloom: udp-dns"
  disk_store     = var.disk_store
  ovf_source     = var.images["debian-12"]
  numvcpus       = "1"
  memsize        = "1024"
  boot_disk_size = "20"
  power          = "on"
  network_interfaces {
    virtual_network = esxi_portgroup.servers.name
    mac_address     = format("00:50:56:%02x:%02x:%02x", var.slot, 2, 0)
    nic_type        = "vmxnet3"
  }
  guestinfo = {
    metadata = base64encode(yamlencode({
      instance-id    = "iso${var.slot}-dns"
      local-hostname = "dns"
      network = {
        version = 2
        ethernets = {
          nic0 = {
            match       = { macaddress = format("00:50:56:%02x:%02x:%02x", var.slot, 2, 0) }
            addresses   = ["10.66.10.53/24"]
            routes      = [{ to = "0.0.0.0/0", via = "10.66.10.254" }]
            nameservers = { addresses = ["1.1.1.1"] }
          }
        }
      }
    }))
    "metadata.encoding" = "base64"
    userdata            = base64encode(format("#cloud-config\n%s", yamlencode({ hostname = "dns", users = local.users })))
    "userdata.encoding" = "base64"
  }
  depends_on = [esxi_guest.isoloom_router]
}

# Its set-up: its steps from the plan, over SSH through the router.
resource "terraform_data" "dns" {
  triggers_replace = [esxi_guest.dns.id]
  connection {
    type                = "ssh"
    host                = "10.66.10.53"
    user                = "isoloom"
    private_key         = file(pathexpand(var.ssh_private_key_file))
    bastion_host        = local.router_address
    bastion_user        = "isoloom"
    bastion_private_key = file(pathexpand(var.ssh_private_key_file))
    timeout             = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-dns.tgz\" --exclude=\"${basename(local.root)}/.isoloom*\" --exclude=\".git\" --exclude=\".terraform\" --exclude=\"*.tfstate\" --exclude=\"*.tfstate.*\" --exclude=\".terraform.tfstate.lock.info\" --exclude=\"crash.log\" --exclude=\"crash.*.log\" --exclude=\".vagrant\" -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-dns.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "remote-exec" {
    inline = [
      "set -e",
      "cloud-init status --wait >/dev/null 2>&1 || true",
      "sudo sh -c 'mkdir -p /var/lib/isoloom'",
      "sudo sh -c 'echo '\\''running: the project'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'rm -rf /opt/isoloom && mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz' || { sudo sh -c 'echo '\\''failed: the project'\\'' > /var/lib/isoloom/ready'; exit 1; }",
      "sudo sh -c 'echo '\\''running: hosts file'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'printf '\\''%s\\n'\\'' '\\''10.66.10.53 dns'\\'' '\\''10.66.20.10 client'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done' || { sudo sh -c 'echo '\\''failed: hosts file'\\'' > /var/lib/isoloom/ready'; exit 1; }",
      "sudo sh -c 'echo '\\''running: routes'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'ip route replace 10.66.20.0/24 via 10.66.10.254' || { sudo sh -c 'echo '\\''failed: routes'\\'' > /var/lib/isoloom/ready'; exit 1; }",
      "sudo sh -c 'echo '\\''running: provision/dns.sh'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'cd /opt/isoloom && sh -c '\\''sh '\\''\\'\\'''\\''provision/dns.sh'\\''\\'\\'''\\'''\\''' || { sudo sh -c 'echo '\\''failed: provision/dns.sh'\\'' > /var/lib/isoloom/ready'; exit 1; }",
      "sudo sh -c 'echo '\\''running: closing the internet'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'pkg() { if command -v apt-get >/dev/null; then apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \"$@\"; elif command -v dnf >/dev/null; then dnf install -y -q \"$@\"; else yum install -y -q \"$@\"; fi; }\ncommand -v nft >/dev/null || if command -v apk >/dev/null; then apk add -q --no-cache nftables; else pkg nftables; fi\nprintf '\\''%s\\n'\\'' '\\''table inet isoloom-egress'\\'' '\\''delete table inet isoloom-egress'\\'' '\\''table inet isoloom-egress {'\\'' '\\''  chain output {'\\'' '\\''    type filter hook output priority 0; policy accept;'\\'' '\\''    oifname \"lo\" accept'\\'' '\\''    ip daddr != { 10.66.10.0/24, 10.66.20.0/24 } ct state new drop'\\'' '\\''  }'\\'' '\\''}'\\'' > /etc/isoloom-egress.nft\nmkdir -p /etc/isoloom\ncat > /etc/isoloom/egress.sh <<'\\''EGRESS'\\''\n#!/bin/sh\n# No new connection leaves the isoloom networks\nnft -f /etc/isoloom-egress.nft\nexit 0\nEGRESS\nchmod +x /etc/isoloom/egress.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-egress.service <<'\\''UNIT'\\''\n[Unit]\nDescription=No new connection leaves the isoloom networks\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=-/etc/isoloom/egress.sh\n\n[Install]\nWantedBy=multi-user.target\nUNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-egress.service\nsystemctl restart isoloom-egress.service\nelse\nmkdir -p /etc/local.d && ln -sf /etc/isoloom/egress.sh /etc/local.d/isoloom-egress.start\nrc-update add local default >/dev/null 2>&1 || true\n/etc/isoloom/egress.sh || true\nfi' || { sudo sh -c 'echo '\\''failed: closing the internet'\\'' > /var/lib/isoloom/ready'; exit 1; }",
      "sudo sh -c 'echo '\\''running: health check'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready' || { sudo sh -c 'echo '\\''failed: health check'\\'' > /var/lib/isoloom/ready'; exit 1; }"
    ]
  }
}

# Machine `client`.
resource "esxi_guest" "client" {
  guest_name     = "iso${var.slot}-client"
  notes          = "isoloom: udp-dns"
  disk_store     = var.disk_store
  ovf_source     = var.images["debian-12"]
  numvcpus       = "1"
  memsize        = "1024"
  boot_disk_size = "20"
  power          = "on"
  network_interfaces {
    virtual_network = esxi_portgroup.users.name
    mac_address     = format("00:50:56:%02x:%02x:%02x", var.slot, 3, 0)
    nic_type        = "vmxnet3"
  }
  guestinfo = {
    metadata = base64encode(yamlencode({
      instance-id    = "iso${var.slot}-client"
      local-hostname = "client"
      network = {
        version = 2
        ethernets = {
          nic0 = {
            match       = { macaddress = format("00:50:56:%02x:%02x:%02x", var.slot, 3, 0) }
            addresses   = ["10.66.20.10/24"]
            routes      = [{ to = "0.0.0.0/0", via = "10.66.20.254" }]
            nameservers = { addresses = ["1.1.1.1"] }
          }
        }
      }
    }))
    "metadata.encoding" = "base64"
    userdata            = base64encode(format("#cloud-config\n%s", yamlencode({ hostname = "client", users = local.users })))
    "userdata.encoding" = "base64"
  }
  depends_on = [esxi_guest.isoloom_router]
}

# Its set-up: its steps from the plan, over SSH through the router.
resource "terraform_data" "client" {
  triggers_replace = [esxi_guest.client.id]
  connection {
    type                = "ssh"
    host                = "10.66.20.10"
    user                = "isoloom"
    private_key         = file(pathexpand(var.ssh_private_key_file))
    bastion_host        = local.router_address
    bastion_user        = "isoloom"
    bastion_private_key = file(pathexpand(var.ssh_private_key_file))
    timeout             = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-client.tgz\" --exclude=\"${basename(local.root)}/.isoloom*\" --exclude=\".git\" --exclude=\".terraform\" --exclude=\"*.tfstate\" --exclude=\"*.tfstate.*\" --exclude=\".terraform.tfstate.lock.info\" --exclude=\"crash.log\" --exclude=\"crash.*.log\" --exclude=\".vagrant\" -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-client.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "remote-exec" {
    inline = [
      "set -e",
      "cloud-init status --wait >/dev/null 2>&1 || true",
      "sudo sh -c 'mkdir -p /var/lib/isoloom'",
      "sudo sh -c 'echo '\\''running: the project'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'rm -rf /opt/isoloom && mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz' || { sudo sh -c 'echo '\\''failed: the project'\\'' > /var/lib/isoloom/ready'; exit 1; }",
      "sudo sh -c 'echo '\\''running: hosts file'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'printf '\\''%s\\n'\\'' '\\''10.66.10.53 dns'\\'' '\\''10.66.20.10 client'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done' || { sudo sh -c 'echo '\\''failed: hosts file'\\'' > /var/lib/isoloom/ready'; exit 1; }",
      "sudo sh -c 'echo '\\''running: routes'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'ip route replace 10.66.10.0/24 via 10.66.20.254' || { sudo sh -c 'echo '\\''failed: routes'\\'' > /var/lib/isoloom/ready'; exit 1; }",
      "sudo sh -c 'echo '\\''running: waiting for dns'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'i=0; until (bash -c '\\''</dev/tcp/dns/53'\\'' 2>/dev/null || nc -z -w 2 dns 53 2>/dev/null); do i=$((i+2)); if [ $i -ge 900 ]; then echo \"dns didn'\\''t answer within 900s\" >&2; exit 1; fi; sleep 2; done; echo \"dns answers\"' || { sudo sh -c 'echo '\\''failed: waiting for dns'\\'' > /var/lib/isoloom/ready'; exit 1; }",
      "sudo sh -c 'echo '\\''running: provision/client.sh'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'cd /opt/isoloom && sh -c '\\''sh '\\''\\'\\'''\\''provision/client.sh'\\''\\'\\'''\\'''\\''' || { sudo sh -c 'echo '\\''failed: provision/client.sh'\\'' > /var/lib/isoloom/ready'; exit 1; }",
      "sudo sh -c 'echo '\\''running: closing the internet'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'pkg() { if command -v apt-get >/dev/null; then apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \"$@\"; elif command -v dnf >/dev/null; then dnf install -y -q \"$@\"; else yum install -y -q \"$@\"; fi; }\ncommand -v nft >/dev/null || if command -v apk >/dev/null; then apk add -q --no-cache nftables; else pkg nftables; fi\nprintf '\\''%s\\n'\\'' '\\''table inet isoloom-egress'\\'' '\\''delete table inet isoloom-egress'\\'' '\\''table inet isoloom-egress {'\\'' '\\''  chain output {'\\'' '\\''    type filter hook output priority 0; policy accept;'\\'' '\\''    oifname \"lo\" accept'\\'' '\\''    ip daddr != { 10.66.10.0/24, 10.66.20.0/24 } ct state new drop'\\'' '\\''  }'\\'' '\\''}'\\'' > /etc/isoloom-egress.nft\nmkdir -p /etc/isoloom\ncat > /etc/isoloom/egress.sh <<'\\''EGRESS'\\''\n#!/bin/sh\n# No new connection leaves the isoloom networks\nnft -f /etc/isoloom-egress.nft\nexit 0\nEGRESS\nchmod +x /etc/isoloom/egress.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-egress.service <<'\\''UNIT'\\''\n[Unit]\nDescription=No new connection leaves the isoloom networks\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=-/etc/isoloom/egress.sh\n\n[Install]\nWantedBy=multi-user.target\nUNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-egress.service\nsystemctl restart isoloom-egress.service\nelse\nmkdir -p /etc/local.d && ln -sf /etc/isoloom/egress.sh /etc/local.d/isoloom-egress.start\nrc-update add local default >/dev/null 2>&1 || true\n/etc/isoloom/egress.sh || true\nfi' || { sudo sh -c 'echo '\\''failed: closing the internet'\\'' > /var/lib/isoloom/ready'; exit 1; }",
      "sudo sh -c 'echo '\\''running: health check'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready' || { sudo sh -c 'echo '\\''failed: health check'\\'' > /var/lib/isoloom/ready'; exit 1; }"
    ]
  }
  depends_on = [terraform_data.dns]
}

locals {
  router_address = esxi_guest.isoloom_router.ip_address
}

# The router's uplink address: the environment's way in.
output "ip" {
  value = local.router_address
}

# Each Linux machine's set-up progress (`isoloom-ready/1`: `running: <step>`, `failed: <step>`, `ready`).
output "ready_file" {
  value = "/var/lib/isoloom/ready"
}

# Published services, from the router's uplink address.
output "published" {
  value = { "dns/dns-udp" = "${local.router_address}:10053" }
}

# The machines, through the router: ssh -J isoloom@<ip> isoloom@<machine>.
output "machines" {
  value = { dns = "10.66.10.53", client = "10.66.20.10" }
}

output "ssh_user" {
  value = "isoloom"
}

# The checks: each runner piped to its machine (ssh -J isoloom@<ip> isoloom@<host> sh -s < <script>).
output "checks" {
  value = [
    {
      position = "client"
      machine  = "client"
      host     = "10.66.20.10"
      user     = "isoloom"
      script   = ".isoloom/esxi/checks/client.sh"
    },
    {
      position = "dns"
      machine  = "dns"
      host     = "10.66.10.53"
      user     = "isoloom"
      script   = ".isoloom/esxi/checks/dns.sh"
    }
  ]
}

# The project's files the machines don't get: what .isoloomignore at the project's root lists
# (gitignore-style: one pattern per line, `#` comments, `!` brings a path back, a trailing `/`
# matches folders only, a `/` at the start or in the middle anchors the pattern at the root; `*`,
# `?`, `[abc]`, `**`; the last pattern matching a path, or a folder it is in, decides), then
# Isoloom's outputs, version control and the tools' state. Read as regular expressions, as the
# Vagrantfiles do.
locals {
  project_ignore_lines = [for l in split("\n", "${replace(try(file("${local.root}/.isoloomignore"), ""), "\r", "")}\n/.isoloom*\n.git/\n.terraform/\n*.tfstate\n*.tfstate.*\n.terraform.tfstate.lock.info\ncrash.log\ncrash.*.log\n.vagrant/\n") : trimspace(l)]
  project_ignore_pats  = [for l in local.project_ignore_lines : { keep = startswith(l, "!"), pat = trimprefix(l, "!") } if l != "" && !startswith(l, "#")]
  project_ignore_globs = [for r in local.project_ignore_pats : merge(r, { glob = trimsuffix(trimsuffix(trimsuffix(r.pat, "/"), "/**"), "/") })]
  project_ignore = [for r in local.project_ignore_globs : {
    keep = r.keep
    re = format(r.glob == r.pat ? "^%s(/|$)" : "^%s/", replace(replace(replace(replace(replace(replace(replace(replace(
      length(split("/", r.glob)) > 1 ? trimprefix(r.glob, "/") : "**/${r.glob}",
    "/[.+^$(){}|\\\\]/", "\\$0"), "[!", "[^"), "**/", "\u0001"), "**", "\u0002"), "*", "[^/]*"), "?", "[^/]"), "\u0001", "(.*/)?"), "\u0002", ".*"))
  } if r.glob != ""]
  # Each file: whether it goes (the last matching pattern decides; none: it goes).
  project_keep    = { for f in fileset(local.root, "**") : f => reverse(concat([true], [for r in local.project_ignore : r.keep if length(regexall(r.re, f)) > 0]))[0] }
  project_ignored = [for f, keep in local.project_keep : f if !keep]
}

# What `tar` leaves out of the project's archive: .isoloomignore's files, from the archive's top
# folder, their wildcard characters escaped.
resource "local_file" "isoloom_project" {
  filename = "${path.module}/.isoloom-project-ignored.txt"
  content  = join("", [for f in local.project_ignored : "${replace("${basename(local.root)}/${f}", "/[\\\\*?\\[]/", "\\$0")}\n"])
}

## .isoloom/esxi/run.json
{
  "$schema": "https://raw.githubusercontent.com/isoloom/isoloom/main/schemas/run-manifest-v1.schema.json",
  "manifest_version": 1,
  "generator": {
    "name": "isoloom",
    "version": "2.1.1"
  },
  "environment": {
    "name": "udp-dns",
    "instance": null,
    "message": "The DNS server answers at 10.66.10.53:53 (UDP and TCP), and on\n127.0.0.1:${published.dns.dns-udp}/udp from this machine:\ndig @127.0.0.1 -p ${published.dns.dns-udp} www.lab.test\n"
  },
  "target": "esxi",
  "driver": "terraform",
  "hosts": [
    "linux",
    "macos",
    "windows"
  ],
  "tools": [
    {
      "name": "terraform",
      "probe": [
        "terraform",
        "version"
      ],
      "min_version": "1.6.0"
    },
    {
      "name": "ovftool",
      "probe": [
        "ovftool",
        "--version"
      ]
    },
    {
      "name": "ssh",
      "probe": [
        "ssh",
        "-V"
      ]
    }
  ],
  "identity": {
    "terraform": {
      "module": ".",
      "state": "runner"
    }
  },
  "params": [
    {
      "name": "esxi_hostname",
      "description": "The ESXi host's name or address.",
      "required": true,
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "esxi_hostname"
        }
      ]
    },
    {
      "name": "esxi_hostport",
      "description": "Its SSH port: the provider works over SSH.",
      "default": "22",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "esxi_hostport"
        }
      ]
    },
    {
      "name": "esxi_hostssl",
      "description": "The module's `esxi_hostssl`.",
      "default": "443",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "esxi_hostssl"
        }
      ]
    },
    {
      "name": "esxi_username",
      "description": "The module's `esxi_username`.",
      "default": "root",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "esxi_username"
        }
      ]
    },
    {
      "name": "disk_store",
      "description": "Where the VMs' disks go.",
      "default": "datastore1",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "disk_store"
        }
      ]
    },
    {
      "name": "uplink_port_group",
      "description": "The port group the router reaches the internet through (DHCP).",
      "default": "VM Network",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "uplink_port_group"
        }
      ]
    },
    {
      "name": "images",
      "description": "An OVA per OS, a path or a URL: Ubuntu's cloud OVAs by default (the provider checks no hash: their SHA-256, as Ubuntu publishes them, ubuntu-24.04 513a22ebe3982b9387b038f8a2a6dad1af980d4623dca03511312e55ba620b1a); for another OS, an OVA with cloud-init and open-vm-tools.",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "images"
        }
      ]
    },
    {
      "name": "ISOLOOM_DERIVED",
      "description": "0: the checks derived from the spec (reachability, no internet) are skipped.",
      "default": "1",
      "values": [
        "0",
        "1"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_DERIVED",
          "steps": [
            "check-client",
            "check-dns"
          ]
        }
      ]
    },
    {
      "name": "isoloom_sealed",
      "description": "true once the machines are set up: the internet is closed to the `internet: false` networks, at the router.",
      "default": "false",
      "values": [
        "true",
        "false"
      ],
      "set_by": "runner",
      "deliver": [
        {
          "via": "tf_var",
          "var": "isoloom_sealed"
        }
      ]
    }
  ],
  "secrets": [
    {
      "name": "esxi_password",
      "kind": "connection",
      "required": false,
      "sensitive": true,
      "deliver": [
        {
          "via": "tf_var",
          "var": "esxi_password"
        }
      ]
    }
  ],
  "networks": [
    {
      "name": "servers",
      "cidr": "10.66.10.0/24",
      "internet": false,
      "native": "iso${run.slot}-servers"
    },
    {
      "name": "users",
      "cidr": "10.66.20.0/24",
      "internet": false,
      "native": "iso${run.slot}-users"
    }
  ],
  "machines": [
    {
      "name": "dns",
      "role": "member",
      "os": "debian-12",
      "arch": "amd64",
      "resources": {
        "cpus": 1,
        "memory_mb": 1024
      },
      "addresses": {
        "servers": "10.66.10.53"
      },
      "ports": [
        {
          "name": "dns-udp",
          "port": 53,
          "protocol": "udp",
          "http": false,
          "publish": {
            "mode": "fixed",
            "preferred": 10053,
            "address": "${outputs.ip}"
          }
        },
        {
          "name": "dns",
          "port": 53,
          "protocol": "tcp",
          "http": false
        }
      ],
      "consoles": [
        {
          "protocol": "none",
          "note": "an ESXi VM's console goes through ESXi's own API (a WebMKS ticket), which Isoloom doesn't use"
        }
      ]
    },
    {
      "name": "client",
      "role": "access",
      "os": "debian-12",
      "arch": "amd64",
      "resources": {
        "cpus": 1,
        "memory_mb": 1024
      },
      "addresses": {
        "users": "10.66.20.10"
      },
      "consoles": [
        {
          "protocol": "none",
          "note": "an ESXi VM's console goes through ESXi's own API (a WebMKS ticket), which Isoloom doesn't use"
        }
      ]
    },
    {
      "name": "isoloom-router",
      "role": "infra",
      "addresses": {
        "servers": "10.66.10.254",
        "users": "10.66.20.254"
      }
    }
  ],
  "lifecycle": {
    "up": [
      {
        "id": "clear-lock",
        "action": "terraform.clear_lock"
      },
      {
        "id": "init",
        "note": "Preparing Terraform and its providers…",
        "argv": [
          "terraform",
          "init",
          "-input=false",
          "-no-color",
          "-backend-config=path=${run.state_dir}/terraform.tfstate"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_slot": "${run.slot}",
          "TF_VAR_ssh_private_key_file": "${run.ssh_key}",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 900
      },
      {
        "id": "apply",
        "note": "Creating the environment's VMs on the server…",
        "argv": [
          "terraform",
          "apply",
          "-auto-approve",
          "-input=false",
          "-no-color"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_slot": "${run.slot}",
          "TF_VAR_ssh_private_key_file": "${run.ssh_key}",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 3600
      }
    ],
    "down": [
      {
        "id": "clear-lock",
        "action": "terraform.clear_lock"
      },
      {
        "id": "init",
        "note": "Preparing Terraform and its providers…",
        "argv": [
          "terraform",
          "init",
          "-input=false",
          "-no-color",
          "-backend-config=path=${run.state_dir}/terraform.tfstate"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_slot": "${run.slot}",
          "TF_VAR_ssh_private_key_file": "${run.ssh_key}",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 900
      },
      {
        "id": "destroy",
        "note": "Removing the environment from the server…",
        "argv": [
          "terraform",
          "destroy",
          "-auto-approve",
          "-input=false",
          "-no-color",
          "-refresh=false"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_slot": "${run.slot}",
          "TF_VAR_ssh_private_key_file": "${run.ssh_key}",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 1800
      }
    ],
    "seal": {
      "param": "isoloom_sealed",
      "steps": [
        {
          "id": "seal-reload",
          "action": "ssh.run",
          "with": {
            "command": "sudo sh -c 'nft -f /etc/nftables.sealed.nft && cp /etc/nftables.sealed.nft /etc/nftables.conf'",
            "host": "${outputs.ip}",
            "user": "isoloom"
          },
          "timeout_s": 600
        }
      ]
    },
    "status": {
      "id": "state",
      "action": "terraform.read_state"
    }
  },
  "ready": [
    {
      "kind": "step_ok",
      "step": "apply",
      "means": "the VMs exist, and Terraform set each Linux one up over SSH through the router"
    },
    {
      "kind": "ready_file",
      "host": "10.66.10.53",
      "user": "isoloom",
      "path": "${outputs.ready_file}",
      "grammar": "isoloom-ready/1",
      "via": "isoloom@${outputs.ip}",
      "timeout_s": 2400,
      "unreachable_timeout_s": 600,
      "interval_s": 10
    },
    {
      "kind": "ready_file",
      "host": "10.66.20.10",
      "user": "isoloom",
      "path": "${outputs.ready_file}",
      "grammar": "isoloom-ready/1",
      "via": "isoloom@${outputs.ip}",
      "timeout_s": 2400,
      "unreachable_timeout_s": 600,
      "interval_s": 10
    }
  ],
  "outputs": [
    {
      "name": "ip",
      "description": "The router's uplink address: the published ports answer there, and SSH reaches the machines through it.",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ip"
      }
    },
    {
      "name": "ssh_user",
      "description": "The user every Linux VM and the router let in with the runner's key.",
      "role": "info",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ssh_user"
      }
    },
    {
      "name": "ready_file",
      "description": "Where each Linux machine's set-up says how far it got (isoloom-ready/1).",
      "role": "info",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ready_file"
      }
    },
    {
      "name": "dns__dns_udp",
      "description": "dns's dns-udp (port 53/udp).",
      "role": "info",
      "sensitive": false,
      "format": "${outputs.ip}:${value}",
      "from": {
        "kind": "published_port",
        "machine": "dns",
        "port": "dns-udp"
      }
    }
  ],
  "checks": {
    "protocol": "isoloom-check/1",
    "setup": [],
    "runners": [
      {
        "id": "client",
        "from": "from client",
        "checks": [
          {
            "name": "checks/resolve.sh",
            "kind": "script",
            "wait_s": 0,
            "derived": false
          },
          {
            "name": "dns:53 from client",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "no internet from client",
            "kind": "http",
            "wait_s": 0,
            "derived": true
          }
        ],
        "step": {
          "id": "check-client",
          "action": "ssh.run",
          "with": {
            "command": "ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} sh -s",
            "host": "10.66.20.10",
            "user": "isoloom",
            "via": "isoloom@${outputs.ip}"
          },
          "stdin": "checks/client.sh",
          "timeout_s": 135
        }
      },
      {
        "id": "dns",
        "from": "from dns",
        "checks": [
          {
            "name": "no internet from dns",
            "kind": "http",
            "wait_s": 0,
            "derived": true
          }
        ],
        "step": {
          "id": "check-dns",
          "action": "ssh.run",
          "with": {
            "command": "ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} sh -s",
            "host": "10.66.10.53",
            "user": "isoloom",
            "via": "isoloom@${outputs.ip}"
          },
          "stdin": "checks/dns.sh",
          "timeout_s": 75
        }
      }
    ],
    "teardown": []
  }
}

