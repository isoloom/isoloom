    end
    m.trigger.before :"VagrantPlugins::HyperV::Action::Configure", type: :action do |t|
      t.ruby { |_, _| IsoloomHyperV.switches(["isoloom-slow-link-branch", "isoloom-slow-link-far"]) }
    end
    m.trigger.before :"VagrantPlugins::HyperV::Action::StartInstance", type: :action do |t|
