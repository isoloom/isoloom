      v.linked_clone = true
      v.cpus = 1
      v.memory = 512
    end
    m.vm.provider "vmware_desktop" do |v|
      v.vmx["displayName"] = "slow-link - isoloom-tool-shell"
      v.vmx["numvcpus"] = "1"
