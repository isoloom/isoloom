          }
        ]
      }
    }
  ],
  "lifecycle": {
    "up": [
      {
        "id": "reconcile",
        "note": "Clearing the state of a run on another provider, if any…",
        "action": "vagrant.reconcile_provider"
      },
      {
        "id": "discard-saved",
        "action": "vagrant.discard_aborted_saved",
        "failure": "tolerate",
        "providers": [
          "virtualbox"
        ]
      },
      {
        "id": "up",
        "note": "Building the environment's VMs (Windows machines take a while)…",
        "argv": [
          "vagrant",
          "up",
          "--provider",
          "${run.provider}"
        ],
        "timeout_s": 21600
      }
    ],
    "down": [
      {
        "id": "destroy",
        "argv": [
          "vagrant",
          "destroy",
          "--force"
        ],
        "timeout_s": 1800,
        "when": "always"
      },
      {
        "id": "orphans",
        "action": "vagrant.remove_orphans",
        "when": "always",
        "failure": "tolerate",
        "providers": [
          "virtualbox",
          "parallels"
        ]
      },
      {
        "id": "reset",
        "action": "vagrant.reset_state"
      }
    ],
    "park": {
      "pause": [
        {
          "id": "suspend",
          "argv": [
            "vagrant",
            "suspend",
            "isoloom-router",
            "web",
            "user",
            "isoloom-tool-shell"
          ],
          "timeout_s": 1800
        }
      ],
      "shutdown": [
        {
          "id": "halt",
          "argv": [
            "vagrant",
            "halt"
          ],
          "timeout_s": 1800
        }
      ]
    },
    "resume": [
      {
        "id": "discard-saved",
        "action": "vagrant.discard_aborted_saved",
        "failure": "tolerate",
        "providers": [
          "virtualbox"
        ]
      },
      {
        "id": "resume",
        "argv": [
          "vagrant",
          "up",
          "--no-provision",
          "--provider",
          "${run.provider}",
          "isoloom-router",
          "web",
          "user",
          "isoloom-tool-shell"
        ],
        "timeout_s": 3600,
        "failure": "tolerate"
      },
      {
        "id": "discard-cut-off",
        "action": "vagrant.discard_aborted_saved",
        "failure": "tolerate",
        "providers": [
          "virtualbox"
        ]
      },
      {
        "id": "boot",
        "argv": [
          "vagrant",
          "up",
          "--no-provision",
          "--provider",
          "${run.provider}",
          "isoloom-router",
          "web",
          "user",
          "isoloom-tool-shell"
        ],
        "timeout_s": 3600
      }
    ],
    "provision": {
      "all": [
        {
          "id": "provision",
          "argv": [
            "vagrant",
            "provision",
            "isoloom-router",
            "web",
            "user",
            "isoloom-tool-shell"
          ],
          "timeout_s": 7200
        }
      ],
      "machine": [
        {
          "id": "provision-machine",
          "argv": [
            "vagrant",
            "provision",
            "${machine}"
          ],
          "timeout_s": 7200
        }
      ]
    },
    "status": {
      "id": "status",
      "argv": [
        "vagrant",
        "status",
        "--machine-readable"
      ],
      "timeout_s": 25,
      "provider_timeout_s": {
        "vmware_esxi": 180
      }
    }
  },
  "ready": [
    {
      "kind": "step_ok",
      "step": "up",
      "means": "every VM booted and ran its provisioners, the controller's playbooks included"
    },
    {
      "kind": "machines_running",
      "machines": [
        "web",
        "user"
      ]
    }
  ],
  "outputs": [],
  "checks": {
    "protocol": "isoloom-check/1",
    "setup": [],
    "runners": [
      {
        "id": "user",
        "from": "from user",
        "checks": [
          {
            "name": "the far site answers, slowly",
            "kind": "script",
            "wait_s": 0,
            "derived": false
          },
          {
            "name": "web:80 from user",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          }
        ],
        "step": {
          "id": "check-user",
          "argv": [
            "vagrant",
            "provision",
            "user",
            "--provision-with",
            "checks"
          ],
          "timeout_s": 120
        }
      }
    ],
    "teardown": []
  },
  "recovery": {
    "stale_markers": [
      "verr_already_exists",
      "could not rename",
      "is locked",
      "different provider",
      "single provider at a time"
    ],
    "steps": [
      {
        "id": "destroy",
        "note": "Clearing what an earlier run left, then starting again…",
        "argv": [
          "vagrant",
          "destroy",
          "--force"
        ],
        "timeout_s": 180,
        "when": "always",
        "failure": "tolerate"
      },
      {
        "id": "orphans",
        "action": "vagrant.remove_orphans",
        "when": "always",
        "failure": "tolerate",
        "providers": [
          "virtualbox",
          "parallels"
        ]
      },
      {
        "id": "reset",
        "action": "vagrant.reset_state",
        "when": "always"
      }
    ],
    "retries": 1
  }
}
