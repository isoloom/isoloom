## .isoloom/vagrant/checks/user.sh
#!/bin/sh
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# The environment's checks, from user: each prints a PASS or FAIL line.
passed=0; failed=0
pass() { passed=$((passed+1)); echo "isoloom-check: PASS $1"; }
fail() { failed=$((failed+1)); echo "isoloom-check: FAIL $1: $2"; }
# _http URL [follow] -> the status code, 000 when nothing answers (curl, else wget, else bash):
# the first answer's, or with `follow` the last one's after at most 5 redirects (bash: the first).
_http() {
  if command -v curl >/dev/null 2>&1; then
    if [ -n "$2" ]; then set -- "$1" -L --max-redirs 5; else set -- "$1"; fi
    c=$(curl -sk -o /dev/null -m 5 -w '%{http_code}' "$@" 2>/dev/null)
  elif command -v wget >/dev/null 2>&1; then
    # wget follows redirects whatever it's told (busybox's can't be told): -S prints each answer.
    if [ -n "$2" ]; then _n=6; else _n=1; fi
    c=$(wget -q -S -O /dev/null -T 5 --no-check-certificate "$1" 2>&1 | sed -n 's/^ *HTTP\/[0-9.]* \([0-9][0-9][0-9]\).*/\1/p' | head -n $_n | tail -n 1)
  else
    u=${1#*://}; hp=${u%%/*}; p=/${u#*/}; [ "$u" = "$hp" ] && p=/
    h=${hp%%:*}; port=${hp#*:}; [ "$hp" = "$h" ] && port=80
    # shellcheck disable=SC2016 # the inner bash expands $H, $P and $U, for its /dev/tcp
    c=$(H=$h P=$port U=$p timeout 5 bash -c 'exec 3<>/dev/tcp/$H/$P && printf "GET %s HTTP/1.0\r\nHost: %s\r\n\r\n" "$U" "$H" >&3 && read -r l <&3 && echo "$l"' 2>/dev/null | sed -n 's/^HTTP\/[0-9.]* \([0-9][0-9][0-9]\).*/\1/p')
  fi
  echo "${c:-000}"
}
_http_is() { [ "$(_http "$1" "$3")" = "$2" ]; }
# _req STATUS|any TEXT CURL-ARGS... -> 0 when the request gets that status (any answer for `any`)
# and its body contains TEXT (if any); $out says why not. Needs curl.
_req() {
  want=$1; text=$2; shift 2
  command -v curl >/dev/null 2>&1 || { out="curl is needed for this check"; return 1; }
  b=$(mktemp); c=$(curl -sk -m 10 -o "$b" -w '%{http_code}' "$@" 2>/dev/null); c=${c:-000}; r=0
  if [ "$want" = any ]; then [ "$c" != 000 ] || r=1; else [ "$c" = "$want" ] || r=1; fi
  if [ $r = 1 ]; then out="expected HTTP $want, got $c"
  elif [ -n "$text" ] && ! grep -qF -- "$text" "$b"; then r=1; out="HTTP $c, but the response doesn't contain the expected text"
  fi
  rm -f "$b"; return $r
}
_http_any() { [ "$(_http "$1" "$2")" != 000 ]; }
# _tcp HOST PORT -> 0 when it connects (nc, else bash).
_tcp() {
  if command -v nc >/dev/null 2>&1; then nc -z -w 5 "$1" "$2" >/dev/null 2>&1
  else
    # shellcheck disable=SC2016 # the inner bash expands $H and $P, for its /dev/tcp
    H=$1 P=$2 timeout 5 bash -c 'exec 3<>/dev/tcp/$H/$P' >/dev/null 2>&1
  fi
}
# _tcp_read HOST PORT LINE TEXT -> 0 when the bytes read within 5s of connecting (after writing
# LINE and a newline, if any) contain TEXT; $out says why not (nc, else bash). Stdin stays open
# while reading (some nc quit at its end), and nc is stopped after 5s whatever its flavor.
_tcp_read() {
  f=$(mktemp); i=0; r=1
  if command -v nc >/dev/null 2>&1; then
    { [ -z "$3" ] || printf '%s\n' "$3"; j=0; while [ ! -e "$f.end" ] && [ $j -lt 6 ]; do sleep 1; j=$((j+1)); done; } | nc "$1" "$2" >"$f" 2>/dev/null &
  else
    # shellcheck disable=SC2016 # the inner bash expands $H, $P and $L, for its /dev/tcp
    H=$1 P=$2 L=$3 timeout 6 bash -c 'exec 3<>/dev/tcp/$H/$P || exit 1; [ -z "$L" ] || printf "%s\n" "$L" >&3; cat <&3' >"$f" 2>/dev/null &
  fi
  p=$!
  while :; do
    if grep -qF -- "$4" "$f"; then r=0; break; fi
    if [ $i -ge 5 ] || ! kill -0 $p 2>/dev/null; then break; fi
    sleep 1; i=$((i+1))
  done
  [ $r = 0 ] || ! grep -qF -- "$4" "$f" || r=0
  touch "$f.end"; kill $p 2>/dev/null
  if [ $r = 1 ]; then
    if [ -s "$f" ]; then out="$1:$2 answered \"$(head -c 100 "$f" | tr -d '\000\r' | tr '\n\t' '  ')\", without the expected text"
    elif [ $i -lt 5 ]; then out="$1:$2 refused the connection or closed it without a word"
    else out="nothing read from $1:$2 within 5s"; fi
  fi
  rm -f "$f" "$f.end"; return $r
}
# _exec COMMAND TEXT -> 0 when the command succeeds and its output contains TEXT (if any).
_exec() { out=$(sh -c "$1" 2>&1) && { [ -z "$2" ] || printf '%s\n' "$out" | grep -qF -- "$2"; }; }
# _retry SECONDS COMMAND... -> keeps trying every 2s until it passes or the time is up.
_retry() { _end=$(( $(date +%s) + $1 )); shift; while ! "$@"; do [ "$(date +%s)" -lt "$_end" ] || return 1; sleep 2; done; }

echo '== checks/slow-but-there.sh'
if _retry 0 sh -c 'cd /opt/isoloom && sh '\''checks/slow-but-there.sh'\'''; then pass 'the far site answers, slowly'; else fail 'the far site answers, slowly' "checks/slow-but-there.sh exited non-zero"; fi

if [ "${ISOLOOM_DERIVED:-1}" != 0 ]; then
if _retry 30 _http_any 'http://10.75.2.10:80/'; then pass 'web:80 from user'; else fail 'web:80 from user' "nothing answers at http://10.75.2.10:80/"; fi
fi

echo "isoloom-check: END $passed passed, $failed failed"
[ "$failed" -eq 0 ]

## .isoloom/vagrant/run.json
{
  "$schema": "https://raw.githubusercontent.com/isoloom/isoloom/main/schemas/run-manifest-v1.schema.json",
  "manifest_version": 1,
  "generator": {
    "name": "isoloom",
    "version": "1.0.9"
  },
  "environment": {
    "name": "slow-link",
    "instance": null,
    "message": null
  },
  "target": "vagrant",
  "driver": "vagrant",
  "hosts": [
    "linux",
    "macos",
    "windows"
  ],
  "tools": [
    {
      "name": "vagrant",
      "probe": [
        "vagrant",
        "--version"
      ],
      "min_version": "2.4.0"
    },
    {
      "name": "virtualbox",
      "probe": [
        "VBoxManage",
        "--version"
      ],
      "providers": [
        "virtualbox"
      ]
    },
    {
      "name": "vmware",
      "probe": [
        "vmrun",
        "list"
      ],
      "providers": [
        "vmware_desktop"
      ]
    },
    {
      "name": "parallels",
      "probe": [
        "prlctl",
        "--version"
      ],
      "hosts": [
        "macos"
      ],
      "providers": [
        "parallels"
      ]
    },
    {
      "name": "libvirt",
      "probe": [
        "virsh",
        "--version"
      ],
      "hosts": [
        "linux"
      ],
      "providers": [
        "libvirt"
      ]
    },
    {
      "name": "qemu",
      "probe": [
        "qemu-img",
        "--version"
      ],
      "providers": [
        "qemu"
      ]
    }
  ],
  "identity": {
    "vagrant": {
      "providers": [
        {
          "id": "virtualbox",
          "hosts": [
            "linux",
            "macos",
            "windows"
          ],
          "elevation": "none",
          "refusal": null
        },
        {
          "id": "vmware_desktop",
          "hosts": [
            "linux",
            "macos",
            "windows"
          ],
          "plugin": "vagrant-vmware-desktop",
          "elevation": "none",
          "refusal": null
        },
        {
          "id": "hyperv",
          "hosts": [
            "windows"
          ],
          "elevation": "hyperv",
          "refusal": null
        },
        {
          "id": "parallels",
          "hosts": [
            "macos"
          ],
          "plugin": "vagrant-parallels",
          "elevation": "none",
          "refusal": null
        },
        {
          "id": "libvirt",
          "hosts": [
            "linux"
          ],
          "plugin": "vagrant-libvirt",
          "elevation": "none",
          "refusal": null
        },
        {
          "id": "qemu",
          "hosts": [
            "linux",
            "macos"
          ],
          "plugin": "vagrant-qemu",
          "elevation": "none",
          "refusal": "`isoloom-router` is on 2 networks, and QEMU gives a VM one"
        },
        {
          "id": "vmware_esxi",
          "hosts": [
            "linux",
            "macos",
            "windows"
          ],
          "plugin": "vagrant-vmware-esxi",
          "elevation": "none",
          "remote": true,
          "refusal": null
        }
      ],
      "dotfile": "${run.state_dir}/vagrant"
    }
  },
  "params": [
    {
      "name": "ISOLOOM_HYPERV_SWITCH",
      "description": "The Hyper-V virtual switch each VM's first adapter (Vagrant's connection, and the internet) goes on.",
      "default": "Default Switch",
      "hosts": [
        "windows"
      ],
      "providers": [
        "hyperv"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_HYPERV_SWITCH",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "ISOLOOM_SSH_PROXY_COMMAND",
      "description": "The command Vagrant's SSH to the VMs goes through (an SSH `ProxyCommand`), when this computer can't reach them directly; unset, it connects straight to them.",
      "providers": [
        "vmware_esxi"
      ],
      "set_by": "runner",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_SSH_PROXY_COMMAND",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "ESXI_HOSTNAME",
      "description": "The ESXi host.",
      "required": true,
      "providers": [
        "vmware_esxi"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ESXI_HOSTNAME",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "ESXI_HOSTPORT",
      "description": "Its SSH port.",
      "default": "22",
      "providers": [
        "vmware_esxi"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ESXI_HOSTPORT",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "ESXI_USERNAME",
      "description": "The ESXi user.",
      "default": "root",
      "providers": [
        "vmware_esxi"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ESXI_USERNAME",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "ESXI_DATASTORE",
      "description": "The datastore the VMs' disks go on (default: ESXi's first).",
      "providers": [
        "vmware_esxi"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ESXI_DATASTORE",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "ESXI_VIRTUAL_NETWORK",
      "description": "Port groups, comma-separated: the management network, then one per environment network.",
      "default": "VM Network",
      "providers": [
        "vmware_esxi"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ESXI_VIRTUAL_NETWORK",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "VAGRANT_HOST_ARCHITECTURE",
      "description": "The architecture Vagrant picks each box's build for: the ESXi host's (x86-64), not this computer's.",
      "default": "amd64",
      "values": [
        "amd64"
      ],
      "providers": [
        "vmware_esxi"
      ],
      "set_by": "runner",
      "deliver": [
        {
          "via": "env",
          "var": "VAGRANT_HOST_ARCHITECTURE",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "ISOLOOM_DERIVED",
      "description": "0: the checks derived from the spec (reachability, no internet) are skipped.",
      "default": "1",
      "values": [
        "0",
        "1"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_DERIVED",
          "steps": [
            "check-user"
          ]
        }
      ]
    }
  ],
  "secrets": [
    {
      "name": "ESXI_PASSWORD",
      "kind": "connection",
      "required": true,
      "sensitive": true,
      "providers": [
        "vmware_esxi"
      ],
      "deliver": [
        {
          "via": "env",
          "var": "ESXI_PASSWORD",
          "steps": [
            "*"
          ]
        }
      ]
    }
  ],
  "networks": [
    {
      "name": "branch",
      "cidr": "10.75.1.0/24",
      "internet": true,
      "native": "isoloom-slow-link-branch"
    },
    {
      "name": "far",
      "cidr": "10.75.2.0/24",
      "internet": true,
      "native": "isoloom-slow-link-far"
    }
  ],
  "machines": [
    {
      "name": "isoloom-router",
      "role": "infra",
      "resources": {
        "cpus": 1,
        "memory_mb": 512
      },
      "addresses": {
        "branch": "10.75.1.254",
        "far": "10.75.2.254"
      },
      "native": {
        "vagrant": "isoloom-router",
        "vm_names": {
          "virtualbox": "slow-link - isoloom-router",
          "vmware_desktop": "slow-link - isoloom-router",
          "hyperv": "slow-link-isoloom-router",
          "parallels": "slow-link - isoloom-router",
          "libvirt": "slow-link_isoloom-router",
          "utm": "slow-link - isoloom-router",
          "vmware_esxi": "slow-link-isoloom-router"
        },
        "boot_digest": "sha256:0248c3dbef0285a2c4d7a6ab455a3ff1fe4776dd8ef41ddc2c911fdd6fb2d0ff",
        "boxes": [
          {
            "provider": "virtualbox",
            "box": "bento/debian-12"
          },
          {
            "provider": "vmware_desktop",
            "box": "bento/debian-12"
          },
          {
            "provider": "hyperv",
            "box": "generic/debian12",
            "version": "4.3.12"
          },
          {
            "provider": "parallels",
            "box": "bento/debian-12"
          },
          {
            "provider": "libvirt",
            "box": "generic/debian12"
          },
          {
            "provider": "qemu",
            "box": "cloud-image/debian-12"
          },
          {
            "provider": "vmware_esxi",
            "box": "bento/debian-12",
            "architecture": "amd64"
          }
        ]
      }
    },
    {
      "name": "web",
      "role": "member",
      "os": "debian-12",
      "arch": "amd64",
      "resources": {
        "cpus": 1,
        "memory_mb": 1024
      },
      "addresses": {
        "far": "10.75.2.10"
      },
      "native": {
        "vagrant": "web",
        "vm_names": {
          "virtualbox": "slow-link - web",
          "vmware_desktop": "slow-link - web",
          "hyperv": "slow-link-web",
          "parallels": "slow-link - web",
          "libvirt": "slow-link_web",
          "utm": "slow-link - web",
          "vmware_esxi": "slow-link-web"
        },
        "boot_digest": "sha256:79e7adf1c0e6445cab117015e57fb3b6cf26e0cb416ad1a30ff2681c8b7a6110",
        "boxes": [
          {
            "provider": "virtualbox",
            "box": "bento/debian-12"
          },
          {
            "provider": "vmware_desktop",
            "box": "bento/debian-12"
          },
          {
            "provider": "hyperv",
            "box": "generic/debian12",
            "version": "4.3.12"
          },
          {
            "provider": "parallels",
            "box": "bento/debian-12"
          },
          {
            "provider": "libvirt",
            "box": "generic/debian12",
            "architecture": "amd64"
          },
          {
            "provider": "qemu",
            "box": "cloud-image/debian-12",
            "architecture": "amd64"
          },
          {
            "provider": "vmware_esxi",
            "box": "bento/debian-12",
            "architecture": "amd64"
          }
        ]
      },
      "ports": [
        {
          "name": "web",
          "port": 80,
          "protocol": "tcp",
          "http": true
        }
      ],
      "consoles": [
        {
          "providers": [
            "virtualbox"
          ],
          "protocol": "rdp",
          "source": {
            "from": "vrde"
          },
          "note": "on only when the Oracle VM VirtualBox Extension Pack is installed as the VM boots (VirtualBox has no remote display server without it)"
        },
        {
          "providers": [
            "vmware_desktop"
          ],
          "protocol": "vnc",
          "source": {
            "from": "runner"
          }
        },
        {
          "providers": [
            "hyperv"
          ],
          "protocol": "none",
          "note": "Hyper-V has no VNC or remote display server of its own; a Windows machine's own Remote Desktop is the way, when the spec opens its port"
        },
        {
          "providers": [
            "parallels"
          ],
          "protocol": "none",
          "note": "Isoloom sets up no graphical console on Parallels Desktop (its VNC server stays off)"
        },
        {
          "providers": [
            "libvirt"
          ],
          "protocol": "vnc",
          "source": {
            "from": "libvirt"
          }
        },
        {
          "providers": [
            "qemu"
          ],
          "protocol": "vnc",
          "source": {
            "from": "qemu_monitor"
          }
        },
        {
          "providers": [
            "vmware_esxi"
          ],
          "protocol": "none",
          "note": "an ESXi VM's console goes through ESXi's own API (a WebMKS ticket), which Isoloom doesn't use"
        }
      ]
    },
    {
      "name": "user",
      "role": "access",
      "os": "debian-12",
      "arch": "amd64",
      "resources": {
        "cpus": 1,
        "memory_mb": 1024
      },
      "addresses": {
        "branch": "10.75.1.10"
      },
      "on_demand": true,
      "native": {
        "vagrant": "user",
        "vm_names": {
          "virtualbox": "slow-link - user",
          "vmware_desktop": "slow-link - user",
          "hyperv": "slow-link-user",
          "parallels": "slow-link - user",
          "libvirt": "slow-link_user",
          "utm": "slow-link - user",
          "vmware_esxi": "slow-link-user"
        },
        "boot_digest": "sha256:d21c2ca2b626986a4f6436a366146893b7a7b933a4d62847ed5a5d9fecc7f978",
        "boxes": [
          {
            "provider": "virtualbox",
            "box": "bento/debian-12"
          },
          {
            "provider": "vmware_desktop",
            "box": "bento/debian-12"
          },
          {
            "provider": "hyperv",
            "box": "generic/debian12",
            "version": "4.3.12"
          },
          {
            "provider": "parallels",
            "box": "bento/debian-12"
          },
          {
            "provider": "libvirt",
            "box": "generic/debian12",
            "architecture": "amd64"
          },
          {
            "provider": "qemu",
            "box": "cloud-image/debian-12",
            "architecture": "amd64"
          },
          {
            "provider": "vmware_esxi",
            "box": "bento/debian-12",
            "architecture": "amd64"
          }
        ]
      },
      "consoles": [
        {
          "providers": [
            "virtualbox"
          ],
          "protocol": "rdp",
          "source": {
            "from": "vrde"
          },
          "note": "on only when the Oracle VM VirtualBox Extension Pack is installed as the VM boots (VirtualBox has no remote display server without it)"
        },
        {
          "providers": [
            "vmware_desktop"
          ],
          "protocol": "vnc",
          "source": {
            "from": "runner"
          }
        },
        {
          "providers": [
            "hyperv"
          ],
          "protocol": "none",
          "note": "Hyper-V has no VNC or remote display server of its own; a Windows machine's own Remote Desktop is the way, when the spec opens its port"
        },
        {
          "providers": [
            "parallels"
          ],
          "protocol": "none",
          "note": "Isoloom sets up no graphical console on Parallels Desktop (its VNC server stays off)"
        },
        {
          "providers": [
            "libvirt"
          ],
          "protocol": "vnc",
          "source": {
            "from": "libvirt"
          }
        },
        {
          "providers": [
            "qemu"
          ],
          "protocol": "vnc",
          "source": {
            "from": "qemu_monitor"
          }
        },
        {
          "providers": [
            "vmware_esxi"
          ],
          "protocol": "none",
          "note": "an ESXi VM's console goes through ESXi's own API (a WebMKS ticket), which Isoloom doesn't use"
        }
      ]
    },
    {
      "name": "isoloom-tool-shell",
      "role": "tool",
      "resources": {
        "cpus": 1,
        "memory_mb": 512
      },
      "addresses": {
        "branch": "10.75.1.252",
        "far": "10.75.2.252"
      },
      "native": {
        "vagrant": "isoloom-tool-shell",
        "vm_names": {
          "virtualbox": "slow-link - isoloom-tool-shell",
          "vmware_desktop": "slow-link - isoloom-tool-shell",
          "hyperv": "slow-link-isoloom-tool-shell",
          "parallels": "slow-link - isoloom-tool-shell",
          "libvirt": "slow-link_isoloom-tool-shell",
          "utm": "slow-link - isoloom-tool-shell",
          "vmware_esxi": "slow-link-isoloom-tool-shell"
        },
        "boot_digest": "sha256:291df059f62345b8d40b0f9de4d8f5676dece99d3de5eecb1cc64a9e1675e312",
        "boxes": [
          {
            "provider": "virtualbox",
            "box": "bento/debian-12"
          },
          {
            "provider": "vmware_desktop",
            "box": "bento/debian-12"
          },
          {
            "provider": "hyperv",
            "box": "generic/debian12",
            "version": "4.3.12"
          },
          {
            "provider": "parallels",
            "box": "bento/debian-12"
          },
