      v.smp = "cpus=1"
      v.memory = "1024M"
      v.ssh_auto_correct = true
      # Port 32740 of network `branch`'s hub (see IsoloomQemu).
      v.advanced_network = true
      v.net_mode = :socket
      v.socket_opts = "connect=127.0.0.1:32740"
      if "x86_64" != HOST_ARCH
        v.smp = "cpus=1"
        o.vm.boot_timeout = 3600
      end
