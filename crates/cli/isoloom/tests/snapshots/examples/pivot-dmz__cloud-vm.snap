if _retry 30 _tcp '10.30.20.20' 8080; then pass 'app:8080 from db'; else fail 'app:8080 from db' "nothing listens at 10.30.20.20:8080"; fi
fi

if [ "${ISOLOOM_DERIVED:-1}" != 0 ]; then
c=$(_http 'http://1.1.1.1/'); if [ "$c" = 000 ]; then pass 'no internet from db'; else fail 'no internet from db' "http://1.1.1.1/ answered (HTTP $c); it should be blocked"; fi
