    {
      "name": "isoloom-probe",
      "role": "infra",
      "addresses": {},
      "native": {
        "service": "isoloom-probe"
      }
    }
  ],
  "lifecycle": {
    "up": [
      {
        "id": "reconcile",
        "note": "Clearing the state of a run on another provider, if any…",
        "action": "vagrant.reconcile_provider"
      },
      {
        "id": "discard-saved",
        "action": "vagrant.discard_aborted_saved",
        "failure": "tolerate",
        "providers": [
          "virtualbox"
        ]
      },
      {
        "id": "forwarded-ports",
        "action": "vagrant.check_forwarded_ports",
        "providers": [
          "virtualbox",
          "vmware_desktop",
          "parallels",
          "libvirt",
          "qemu",
          "utm"
        ]
      },
      {
        "id": "up",
        "note": "Building the environment's VM with Docker in it…",
        "argv": [
          "vagrant",
          "up",
          "--provider",
          "${run.provider}",
          "--provision-with",
          "nat-route,project,docker"
        ],
        "timeout_s": 3600
      },
      {
        "id": "pull-start",
        "note": "Pulling the environment's images in the VM…",
        "argv": [
          "vagrant",
          "ssh",
          "--no-tty",
          "--command",
          "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name slow-link --file .isoloom/docker/compose.yml pull --policy missing --ignore-buildable --include-deps",
          "default"
        ],
        "timeout_s": 900,
        "download": true
      },
      {
        "id": "start",
        "note": "Starting the environment's containers in the VM…",
        "argv": [
          "vagrant",
          "ssh",
          "--no-tty",
          "--command",
          "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name slow-link --file .isoloom/docker/compose.yml up --detach --build --pull missing --remove-orphans --wait --wait-timeout 600",
          "default"
        ],
        "timeout_s": 1800
      }
    ],
    "down": [
      {
        "id": "destroy",
        "argv": [
          "vagrant",
          "destroy",
          "--force"
        ],
        "timeout_s": 1800,
        "when": "always"
      },
      {
        "id": "orphans",
        "action": "vagrant.remove_orphans",
        "when": "always",
        "failure": "tolerate",
        "providers": [
          "virtualbox",
          "parallels"
        ]
      },
      {
        "id": "reset",
        "action": "vagrant.reset_state"
      }
    ],
    "park": {
      "pause": [
        {
          "id": "suspend",
          "argv": [
            "vagrant",
            "suspend"
          ],
          "timeout_s": 1800
        }
      ]
    },
    "resume": [
      {
        "id": "discard-saved",
        "action": "vagrant.discard_aborted_saved",
        "failure": "tolerate",
        "providers": [
          "virtualbox"
        ]
      },
      {
        "id": "resume",
        "argv": [
          "vagrant",
          "up",
          "--no-provision",
          "--provider",
          "${run.provider}"
        ],
        "timeout_s": 3600,
        "failure": "tolerate"
      },
      {
        "id": "discard-cut-off",
        "action": "vagrant.discard_aborted_saved",
        "failure": "tolerate",
        "providers": [
          "virtualbox"
        ]
      },
      {
        "id": "boot",
        "argv": [
          "vagrant",
          "up",
          "--no-provision",
          "--provider",
          "${run.provider}"
        ],
        "timeout_s": 3600
      }
    ],
    "status": {
      "id": "status",
      "argv": [
        "vagrant",
        "status",
        "--machine-readable"
      ],
      "timeout_s": 25,
      "provider_timeout_s": {
        "vmware_esxi": 90
      }
    }
  },
  "ready": [
    {
      "kind": "step_ok",
      "step": "up",
      "means": "the VM booted with Docker and the project in it"
    },
    {
      "kind": "step_ok",
      "step": "start",
      "means": "every long-running service is healthy (`--wait`: each port's probe, the route keepers, the machines' own healthchecks)"
    }
  ],
  "outputs": [],
  "checks": {
    "protocol": "isoloom-check/1",
    "setup": [
      {
        "id": "stand-ins",
        "note": "Starting the access machine's stand-in…",
        "argv": [
          "vagrant",
          "ssh",
          "--no-tty",
          "--command",
          "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name slow-link --file .isoloom/docker/compose.yml --profile check up --detach --wait --no-deps isoloom-access isoloom-routes-isoloom-access",
          "default"
        ],
        "timeout_s": 600
      }
    ],
    "runners": [
      {
        "id": "isoloom-check",
        "from": "from user",
        "checks": [
          {
            "name": "the far site answers, slowly",
            "kind": "script",
            "wait_s": 0,
            "derived": false
          },
          {
            "name": "web:80 from user",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          }
        ],
        "step": {
          "id": "check-user",
          "argv": [
            "vagrant",
            "ssh",
            "--no-tty",
            "--command",
            "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name slow-link --file .isoloom/docker/compose.yml --profile check run --rm --no-deps --env ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} isoloom-check",
            "default"
          ],
          "timeout_s": 120
        },
        "on_timeout": [
          {
            "id": "rm-check-user",
            "argv": [
              "vagrant",
              "ssh",
              "--no-tty",
              "--command",
              "sudo docker ps -aq --filter label=com.docker.compose.project=slow-link --filter label=com.docker.compose.service=isoloom-check --filter label=com.docker.compose.oneoff=True | xargs -r sudo docker rm -f",
              "default"
            ],
            "timeout_s": 60
          }
        ]
      }
    ],
    "teardown": [
      {
        "id": "stand-ins-down",
        "argv": [
          "vagrant",
          "ssh",
          "--no-tty",
          "--command",
          "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name slow-link --file .isoloom/docker/compose.yml --profile check rm --stop --force isoloom-access isoloom-routes-isoloom-access",
          "default"
        ],
        "timeout_s": 120,
        "failure": "tolerate"
      }
    ]
  },
  "recovery": {
    "stale_markers": [
      "verr_already_exists",
      "could not rename",
      "is locked",
      "different provider",
      "single provider at a time"
    ],
    "steps": [
      {
        "id": "destroy",
        "note": "Clearing what an earlier run left, then starting again…",
        "argv": [
          "vagrant",
          "destroy",
          "--force"
        ],
        "timeout_s": 180
      },
      {
        "id": "orphans",
        "action": "vagrant.remove_orphans",
        "when": "always",
        "failure": "tolerate",
        "providers": [
          "virtualbox",
          "parallels"
        ]
      },
      {
        "id": "reset",
        "action": "vagrant.reset_state"
      }
    ],
    "retries": 1
  },
  "guest": {
    "machine": "isoloom-docker-host",
    "status": {
      "id": "ps",
      "argv": [
        "vagrant",
        "ssh",
        "--no-tty",
        "--command",
        "if command -v docker >/dev/null; then sudo docker compose --project-name slow-link ps --all --format json; fi",
        "default"
      ],
      "timeout_s": 60
    }
  }
}

