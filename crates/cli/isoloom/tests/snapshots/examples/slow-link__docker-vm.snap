## .isoloom/docker-vm/Vagrantfile
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  cd .isoloom/docker-vm && vagrant up
# Checks: cd .isoloom/docker-vm && vagrant provision --provision-with checks
# Stop:   cd .isoloom/docker-vm && vagrant destroy -f

ROOT = File.expand_path("../..", __dir__)
# The project goes into a VM through Isoloom's own `project` step (the `isoloom_project`
# provisioner below): a tar.gz of the project as it is when the step runs, not when this file
# loads, so files added or removed since still count. Symbolic links go in as links, never
# followed (a link loop can't break the copy). Plain Ruby (Vagrant's own): no tool on the host.
require "zlib"
require "tempfile"

module IsoloomProject
  # Writes the archive of `root` to `io`, gzipped, leaving out what `.isoloomignore` lists, then
  # what `rules` (lines of its syntax, read after the file's) list: Isoloom's outputs but those
  # the machine reads, version control and the tools' state (`COPY_RULES`, the generator's).
  def self.write(root, io, rules: COPY_RULES)
    gz = Zlib::GzipWriter.new(io)
    rules = ignore_rules(root, rules)
    walk(root, nil, rules) { |rel, st| entry(gz, root, rel, st) }
    gz.write("\0" * 1024)
    gz.finish
  end

  # `.isoloomignore` at the project's root, gitignore-style: one pattern per line, `#` comments,
  # `!` brings a path back, a trailing `/` matches folders only, a `/` at the start or in the
  # middle anchors the pattern at the root (otherwise it matches at any depth), `*`, `?`,
  # `[abc]` and `**`. A pattern matching a folder matches everything in it, and the last pattern
  # matching a path (or a folder it is in) decides. As [regexp, keep] pairs, `copy` read after
  # the file; the Terraform outputs translate the patterns the same way, so every target leaves
  # out the same files.
  def self.ignore_rules(root, copy)
    text = begin
      File.binread(File.join(root, ".isoloomignore")).force_encoding("UTF-8")
    rescue Errno::ENOENT
      ""
    end
    "#{text}\n#{copy}".split("\n").filter_map do |line|
      line = line.strip
      next if line.empty? || line.start_with?("#")
      keep = line.start_with?("!")
      pat = keep ? line[1..] : line
      glob = pat.delete_suffix("/").delete_suffix("/**").delete_suffix("/")
      next if glob.empty?
      anchored = glob.include?("/") ? glob.delete_prefix("/") : "**/#{glob}"
      re = anchored.gsub(/[.+^$(){}|\\]/) { "\\#{$&}" }.gsub("[!", "[^")
                   .gsub("**/", "\u0001").gsub("**", "\u0002").gsub("*", "[^/]*").gsub("?", "[^/]")
                   .gsub("\u0001", "(.*/)?").gsub("\u0002", ".*")
      [Regexp.new(glob == pat ? "^#{re}(/|$)" : "^#{re}/"), keep]
    end
  end

  # Whether the rules leave a path out (a folder's path ends with `/`).
  def self.ignored?(rules, path)
    rules.reduce(false) { |out, (re, keep)| re.match?(path) ? !keep : out }
  end

  # Every entry under `dir` (relative to `root`), parents first, in name order.
  def self.walk(root, dir, rules, &block)
    names = begin
      Dir.children(dir ? File.join(root, dir) : root).sort
    rescue Errno::ENOENT, Errno::ENOTDIR
      return # removed while the archive was being written
    end
    names.each do |name|
      rel = dir ? "#{dir}/#{name}" : name
      st = begin
        File.lstat(File.join(root, rel))
      rescue Errno::ENOENT
        next
      end
      folder = st.directory?
      out = ignored?(rules, folder ? "#{rel}/" : rel)
      yield rel, st unless out
      # An ignored folder is skipped, unless a `!` pattern may bring back something in it.
      walk(root, rel, rules, &block) if folder && (!out || rules.any? { |_, keep| keep })
    end
  end

  def self.entry(out, root, rel, st)
    path = File.join(root, rel)
    if st.symlink?
      header(out, rel, "2", 0o777, 0, st.mtime, File.readlink(path))
    elsif st.directory?
      header(out, "#{rel}/", "5", st.mode & 0o7777, 0, st.mtime)
    elsif st.file?
      File.open(path, "rb") do |f|
        mode = st.mode & 0o7777
        # Windows has no executable bit: a script (#!) is made executable.
        mode |= 0o111 if Gem.win_platform? && f.read(2) == "#!"
        f.rewind
        header(out, rel, "0", mode, st.size, st.mtime)
        copied = IO.copy_stream(f, out, st.size)
        out.write("\0" * (st.size - copied)) if copied < st.size # shrank while being read
        out.write("\0" * ((512 - st.size % 512) % 512))
      end
    end
  rescue Errno::ENOENT
    nil # removed while the archive was being written
  end

  # A ustar header; a pax one before it for what ustar can't hold (long names, large sizes).
  def self.header(out, name, type, mode, size, mtime, link = "")
    name = name.b
    link = link.b
    pax = {}
    pax["path"] = name if name.bytesize > 100
    pax["linkpath"] = link if link.bytesize > 100
    pax["size"] = size.to_s if size >= 8**11
    unless pax.empty?
      body = pax.map { |k, v| record(k, v) }.join
      header(out, "PaxHeader/#{name.byteslice(0, 80)}", "x", 0o644, body.bytesize, mtime)
      out.write(body)
      out.write("\0" * ((512 - body.bytesize % 512) % 512))
    end
    h = [
      name.byteslice(0, 100), format("%07o", mode), format("%07o", 0), format("%07o", 0),
      format("%011o", size >= 8**11 ? 0 : size), format("%011o", [mtime.to_i, 0].max), " " * 8, type,
      link.byteslice(0, 100), "ustar", "00", "", "", "", "", "", "",
    ].pack("a100a8a8a8a12a12a8a1a100a6a2a32a32a8a8a155a12")
    h[148, 8] = format("%06o\0 ", h.sum(0))
    out.write(h)
  end

  # One pax record: "<length> key=value\n", the length counting itself.
  def self.record(key, value)
    rest = " #{key}=".b + value + "\n"
    len = rest.bytesize + 1
    len += 1 while (len.to_s.bytesize + rest.bytesize) > len
    len.to_s.b + rest
  end
end

if defined?(Vagrant) && Vagrant.respond_to?(:plugin)
  module IsoloomProject
    class Config < Vagrant.plugin("2", :config)
      attr_accessor :name, :rules

      def initialize
        super
        @name = UNSET_VALUE
        @rules = UNSET_VALUE
      end

      def finalize!
        @name = nil if @name == UNSET_VALUE
        @rules = COPY_RULES if @rules == UNSET_VALUE
      end
    end

    # Builds the archive, uploads it to LINUX_ARCHIVE (WINDOWS_ARCHIVE on Windows, over WinRM or
    # OpenSSH) and unpacks it as root with LINUX_UNPACK (WINDOWS_UNPACK), replacing an older copy.
    # The archives' paths and the unpacking are the generator's, set after this file.
    class Provisioner < Vagrant.plugin("2", :provisioner)
      def provision
        windows = %w[winrm winssh].include?(@machine.config.vm.communicator.to_s)
        Tempfile.create(["isoloom-project", ".tgz"]) do |f|
          f.binmode
          IsoloomProject.write(ROOT, f, rules: config.rules)
          f.close
          @machine.ui.info("The project, #{(File.size(f.path) / 1024.0).ceil} KB compressed, into the VM")
          comm = @machine.communicate
          if windows
            comm.upload(f.path, WINDOWS_ARCHIVE)
            comm.execute(WINDOWS_UNPACK, elevated: true) do |type, data|
              @machine.ui.info(data.chomp) if type == :stdout && !data.strip.empty?
            end
          else
            comm.upload(f.path, LINUX_ARCHIVE)
            comm.sudo(LINUX_UNPACK)
          end
        end
      end
    end

    class Plugin < Vagrant.plugin("2")
      name "isoloom project"
      config(:isoloom_project, :provisioner) { Config }
      provisioner(:isoloom_project) { Provisioner }
    end
  end
end

# What a copy of the project leaves out beyond .isoloomignore.
IsoloomProject::COPY_RULES = "/.isoloom*
.git/
.terraform/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
crash.log
crash.*.log
.vagrant/
"
# Where the project's archive is uploaded, and how it is unpacked, as root (on Windows,
# with no tar.exe before Windows Server 2019).
IsoloomProject::LINUX_ARCHIVE = "/tmp/isoloom-project.tgz"
IsoloomProject::LINUX_UNPACK = "rm -rf /opt/isoloom && mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom && rm -f /tmp/isoloom-project.tgz"
IsoloomProject::WINDOWS_ARCHIVE = "C:\\Windows\\Temp\\isoloom-project.tgz"
IsoloomProject::WINDOWS_UNPACK = <<'PS1'
$archive = 'C:\Windows\Temp\isoloom-project.tgz'; $dest = 'C:\isoloom'; $strip = 0
# The project into a Windows machine: unpacks the tar.gz $archive into $dest (replacing an older
# copy), leaving out the archive's first $strip folders. Plain .NET (GZipStream), so it runs on
# every Windows Isoloom supports: PowerShell 2.0 and later, and no tar.exe before Windows Server
# 2019. Symbolic links are left out (counted).
& {
  $ErrorActionPreference = 'Stop'
  $sep = [IO.Path]::DirectorySeparatorChar
  $new = "$dest.new"
  if (Test-Path $new) { Remove-Item $new -Recurse -Force }
  [void][IO.Directory]::CreateDirectory($new)
  $file = New-Object IO.FileStream($archive, [IO.FileMode]::Open, [IO.FileAccess]::Read)
  $in = New-Object IO.Compression.GZipStream($file, [IO.Compression.CompressionMode]::Decompress)
  $utf8 = New-Object Text.UTF8Encoding($false)
  $header = New-Object byte[] 512
  $chunk = New-Object byte[] 65536
  function Fill([byte[]]$b, [int]$n) {
    $got = 0
    while ($got -lt $n) {
      $r = $in.Read($b, $got, $n - $got)
      if ($r -le 0) { throw "$archive ends early" }
      $got += $r
    }
  }
  function Field([int]$at, [int]$len) {
    $end = [Array]::IndexOf($header, [byte]0, $at, $len)
    if ($end -lt 0) { $end = $at + $len }
    $utf8.GetString($header, $at, $end - $at)
  }
  # Copies $size bytes to $out (or skips them, with no $out), then the padding after them.
  function Body([long]$size, $out) {
    $left = $size
    while ($left -gt 0) {
      $n = [int][Math]::Min([long]$chunk.Length, $left)
      Fill $chunk $n
      if ($out) { $out.Write($chunk, 0, $n) }
      $left -= $n
    }
    $pad = [int]((512 - $size % 512) % 512)
    if ($pad) { Fill $chunk $pad }
  }
  $pax = @{}
  $links = 0
  $files = 0
  while ($true) {
    Fill $header 512
    if ($header[148] -eq 0) { break } # the end: zero blocks have no checksum
    $type = [char]$header[156]
    $sizeText = (Field 124 12).Trim()
    $size = [long]0
    if ($sizeText) { $size = [Convert]::ToInt64($sizeText, 8) }
    if ($pax['size']) { $size = [long]$pax['size'] }
    if ($type -eq 'x') {
      # pax records ("<length> key=value\n"): a long path, a large size, for the next entry.
      $ms = New-Object IO.MemoryStream
      Body $size $ms
      $b = $ms.ToArray()
      $i = 0
      while ($i -lt $b.Length) {
        $sp = [Array]::IndexOf($b, [byte]32, $i)
        $len = [int]$utf8.GetString($b, $i, $sp - $i)
        $eq = [Array]::IndexOf($b, [byte]61, $sp)
        $pax[$utf8.GetString($b, $sp + 1, $eq - $sp - 1)] = $utf8.GetString($b, $eq + 1, $i + $len - $eq - 2)
        $i += $len
      }
      continue
    }
    if ($type -eq 'L' -or $type -eq 'K') {
      # GNU tar's long name (or link target) for the next entry.
      $ms = New-Object IO.MemoryStream
      Body $size $ms
      if ($type -eq 'L') { $pax['path'] = $utf8.GetString($ms.ToArray()).TrimEnd([char]0) }
      continue
    }
    $name = Field 0 100
    $prefix = Field 345 155
    if ($prefix) { $name = "$prefix/$name" }
    if ($pax['path']) { $name = $pax['path'] }
    $pax = @{}
    $parts = @($name.Split('/') | Where-Object { $_ -ne '' -and $_ -ne '.' })
    if ($parts.Count -le $strip) { Body $size $null; continue }
    $path = Join-Path $new ([string]::Join([string]$sep, [string[]]($parts[$strip..($parts.Count - 1)])))
    if ($type -eq '5' -or $type -eq '0' -or $type -eq [char]0) {
      # A name Windows can't take (`:`, `*`, too long...) is left out, with a warning.
      $out = $null
      try {
        if ($type -eq '5') {
          [void][IO.Directory]::CreateDirectory($path)
        } else {
          [void][IO.Directory]::CreateDirectory([IO.Path]::GetDirectoryName($path))
          $out = [IO.File]::Create($path)
        }
      } catch {
        Write-Warning "Not copied: $name ($($_.Exception.Message))"
        Body $size $null
        continue
      }
      if ($out) {
        try { Body $size $out } finally { $out.Close() }
        $files++
      } else {
        Body $size $null
      }
    } else {
      if ($type -eq '2') { $links++ }
      Body $size $null
    }
  }
  $in.Close()
  # A machine's command runs from the project folder: stopped first, Windows refuses to remove a
  # folder a process works in (its step starts it again).
  Get-ScheduledTask -TaskName 'isoloom-*' -ErrorAction SilentlyContinue | Stop-ScheduledTask -ErrorAction SilentlyContinue
  if (Test-Path $dest) { Remove-Item $dest -Recurse -Force }
  Move-Item $new $dest
  Remove-Item $archive -Force
  $note = ''
  if ($links) { $note = " ($links symbolic links left out)" }
  "$files files in $dest$note"
}
PS1
# Vagrant's own check of a host port before forwarding it (`Vagrant::Util::IsPortOpen`) asks
# `Socket.tcp` with a timeout, and on macOS 27 that hands back a socket for a refused connection
# (Ruby bug #22223: the retried `connect_nonblock` answers EISCONN while the socket's SO_ERROR
# still holds ECONNREFUSED). Every host port then reads as in use, and a VM's fixed forwarded
# port fails as a collision before the VM boots (the SSH one Vagrant moves, to a port that read
# as free by luck). On a Mac the check reads the socket's error itself, as Vagrant's should.
if RUBY_PLATFORM.include?("darwin") && defined?(Vagrant)
  require "vagrant/util/is_port_open"

  module Vagrant::Util::IsPortOpen
    def is_port_open?(host, port)
      addr = Addrinfo.tcp(host, port)
      sock = Socket.new(addr.afamily, addr.socktype, addr.protocol)
      begin
        if sock.connect_nonblock(addr, exception: false) == :wait_writable
          return false unless sock.wait_writable(0.1)
        end
        sock.getsockopt(Socket::SOL_SOCKET, Socket::SO_ERROR).int.zero?
      rescue SystemCallError
        false
      ensure
        sock.close
      end
    end
  end
end
# QEMU (vagrant-qemu): what the provider block can't say on its own.
# - Every network gets a hub: one QEMU process with no machine, a port per VM on one emulated
#   hub, each VM connecting to its own (no root; multicast doesn't send on a Mac). The ports are
#   picked when Vagrant reads this file (`ports`), for this copy of the project: free on this
#   host, and the ones a running hub of this copy listens on while it runs. A hub starts before a
#   VM on its network does, unless one runs, with `SPARE` ports more for VMs that join the network
#   while it runs; it is never restarted under the VMs connected to it, and stops once the
#   network's last VM is destroyed: destroying one VM leaves it to the others.
# - A VM's disk is an overlay of its box's, and a size below the box's disk would cut its file
#   system off: `disk_resize` is set only when the machine's size is above the box's (every
#   installed version of it, read with qemu-img). Until the box is downloaded the size is unknown
#   and nothing is set; Vagrant reads this file again once it has the box, before it makes the
#   disk.
module IsoloomQemu
  # Beside Vagrant's own state for this Vagrantfile.
  def self.hubs_dir
    File.join(__dir__, ".vagrant", "isoloom-qemu-hubs")
  end

  def self.fail!(message)
    raise Class.new(Vagrant::Errors::VagrantError) { define_method(:error_message) { "QEMU: #{message}" } }
  end

  def self.pid_file(net)
    File.join(hubs_dir, "#{net}.pid")
  end

  # The hub's record: the ports it listens on, by VM, and its spare ones (`record`).
  def self.ports_file(net)
    File.join(hubs_dir, "#{net}.ports.json")
  end

  # The hub's process id, while it runs: a process whose command names the hub's pid file, so
  # an id the system has given another process since is never taken for (or stopped as) a hub.
  def self.running(net)
    pid = Integer(File.read(pid_file(net)).strip)
    command = IO.popen(["ps", "-ww", "-o", "command=", "-p", pid.to_s], err: File::NULL, &:read)
    pid if command.include?(pid_file(net))
  rescue ArgumentError, SystemCallError
    nil
  end

  # The hub ports: 20000-39999.
  FIRST_PORT = 20_000
  PORTS = 20_000
  # The ports a hub listens on beyond its VMs', for VMs that join its network while it runs (an
  # attack box added to a running environment): QEMU's socket netdev doesn't reconnect, so a hub
  # restarted for one more port would leave the VMs connected to it off the network for good.
  SPARE = 4

  # Each network's hub ports, by VM (`vms`: each network's VMs, in the order they start), as
  # QEMU_HUBS holds them. A network whose hub runs keeps the ports it listens on, a VM that joins
  # it taking a spare one (`kept`). Every other VM gets a port free on this host, looked for from a
  # point of this folder's, not of the environment's name: two copies of one environment start far
  # apart, and a port something else holds is passed over. One folder starts from the same point,
  # so a copy gets the same ports from one run to the next while they stay free.
  def self.ports(vms)
    hubs = vms.map { |net, names| [net, kept(net, names)] }.to_h
    taken = hubs.values.compact.flat_map(&:values)
    at = start
    hubs.each_key do |net|
      next if hubs[net]
      hubs[net] = vms[net].map do |vm|
        at = free_from(at, taken)
        taken << at
        [vm, at]
      end.to_h
    end
    hubs
  end

  # The network's running hub's ports for its VMs `names`: each VM's own, and a spare one, in
  # order, for a VM that joins the network while the hub runs. None when no hub runs, or when its
  # spare ports don't go round the VMs that join.
  def self.kept(net, names)
    rec = record(net)
    return nil unless rec
    spare = rec[:spare].dup
    ports = {}
    names.each do |vm|
      port = rec[:vms][vm] || spare.shift
      return nil unless port
      ports[vm] = port
    end
    ports
  end

  # The running hub's record: its ports by VM (`vms`) and those no VM has taken yet (`spare`).
  # None while no hub runs, or for a record Isoloom doesn't read; one an earlier Isoloom wrote
  # (the ports by VM alone) has no spare port.
  def self.record(net)
    return nil unless running(net)
    require "json"
    rec = JSON.parse(File.read(ports_file(net)))
    return nil unless rec.is_a?(Hash)
    vms, spare = rec["vms"].is_a?(Hash) ? [rec["vms"], rec["spare"]] : [rec, []]
    return nil unless vms.values.all?(Integer) && spare.is_a?(Array) && spare.all?(Integer)
    { vms: vms, spare: spare }
  rescue SystemCallError, JSON::ParserError
    nil
  end

  def self.write_record(net, vms, spare)
    require "json"
    File.write(ports_file(net), JSON.generate("vms" => vms, "spare" => spare))
  end

  # This folder's first port to look from: FNV-1a of its path, in the range.
  def self.start
    hash = File.expand_path(__dir__).bytes.reduce(0x811c9dc5) { |h, b| ((h ^ b) * 0x01000193) & 0xffffffff }
    FIRST_PORT + hash % PORTS
  end

  # The first port from `at` on, wrapping in the range, that is free here and not in `taken`.
  def self.free_from(at, taken)
    PORTS.times do |i|
      port = FIRST_PORT + (at - FIRST_PORT + i) % PORTS
      return port if !taken.include?(port) && free?(port)
    end
    fail!("no port of #{FIRST_PORT}-#{FIRST_PORT + PORTS - 1} is free for a network's hub")
  end

  # Whether a hub could listen on 127.0.0.1:`port` here.
  def self.free?(port)
    require "socket"
    TCPServer.new("127.0.0.1", port).close
    true
  rescue SystemCallError
    false
  end

  # Starts the network's hub on `ports` (by VM), with `SPARE` ports more, unless one runs: QEMU
  # returns once its ports listen. A running hub is kept: a VM that joins its network takes one of
  # its spare ports (`kept`), recorded here. One with no spare port left for it is refused rather
  # than restarted under the VMs connected to it. A hub without a record Isoloom reads (an older
  # Isoloom started it) is replaced: the VM about to start connects to its new port.
  def self.hub(net, ports)
    rec = record(net)
    if rec
      joined = ports.reject { |vm, port| rec[:vms][vm] == port }
      unless joined.values.all? { |port| rec[:spare].include?(port) }
        fail!("the hub of network `#{net}` runs for #{rec[:vms].keys.join(', ')}, with no spare port left " \
              "for #{joined.keys.join(', ')}: started again it would leave them off the network. " \
              "Destroy the environment, then bring it up again")
      end
      write_record(net, rec[:vms].merge(joined), rec[:spare] - joined.values) unless joined.empty?
      return
    end
    stop(net)
    require "fileutils"
    FileUtils.mkdir_p(hubs_dir)
    taken = ports.values.dup
    at = taken.max || start
    spare = Array.new(SPARE) do
      at = free_from(at, taken)
      taken << at
      at
    end
    args = ["qemu-system-#{HOST_ARCH}", "-machine", "none", "-display", "none", "-nodefaults",
            "-daemonize", "-pidfile", pid_file(net)]
    (ports.values + spare).each_with_index do |port, i|
      args += ["-netdev", "socket,id=s#{i},listen=127.0.0.1:#{port}", "-netdev", "hubport,id=h#{i},hubid=0,netdev=s#{i}"]
    end
    log = File.join(hubs_dir, "#{net}.log")
    ok = system(*args, out: log, err: log)
    fail!("the hub of network `#{net}` didn't start (#{args.first}): see #{log}") unless ok
    write_record(net, ports, spare)
  end

  # Stops the network's hub once none of its VMs (`vms`, by define name, and those its record
  # holds) is left besides the one just destroyed. A VM is left while Vagrant keeps its id: a
  # halted one still holds its port, and the hub starts again for it anyway if stopped.
  def self.release(net, vms, env, gone)
    rec = record(net)
    left = (vms + (rec ? rec[:vms].keys : [])).uniq.reject { |vm| vm == gone.to_s }
    return if left.any? { |vm| env.local_data_path.join("machines", vm, "qemu", "id").file? }
    stop(net)
  end

  # Stops the network's hub, if it runs, and forgets it. The hub can be gone, pid file and all, by
  # the time this signals it or deletes its files: QEMU removes its pid file as it exits, and
  # Vagrant destroys QEMU's VMs in parallel, so two destroys can stop one hub at once. Neither is
  # an error.
  def self.stop(net)
    pid = running(net)
    begin
      Process.kill("TERM", pid) if pid
    rescue Errno::ESRCH
      nil
    end
    require "fileutils"
    FileUtils.rm_f([pid_file(net), ports_file(net)])
  end

  # `disk_resize` for a VM of `box` sized `gb` GB: the size when it is above the box's disk,
  # else nothing (the box's disk is kept, never cut).
  def self.disk(box, gb)
    require "json"
    dir = File.join(Vagrant.user_data_path.to_s, "boxes", box.gsub("/", "-VAGRANTSLASH-"))
    images = Dir.glob(File.join(dir, "**", "libvirt", "**", "*.{img,qcow2}"))
    return nil if images.empty?
    sizes = images.map do |img|
      out = IO.popen(["qemu-img", "info", "--output=json", img], err: File::NULL, &:read)
      JSON.parse(out)["virtual-size"]
    rescue StandardError
      nil
    end
    # A box whose size can't be read keeps its own disk: a guess could cut it.
    return nil if sizes.include?(nil)
    gb * 1024**3 > sizes.max ? "#{gb}G" : nil
  end

  # The guest account and group vagrant-qemu maps to this computer's user in a VirtioFS share
  # (`virtiofs_guest_uid` and `_gid`, its default, set so).
  GUEST_ID = 1000
  # The ids a squash covers end below u32::MAX, -1 to chown ("no change"), which no one owns.
  ID_END = 4_294_967_295

  # virtiofsd's arguments for a host folder (`host_folders`) every account of the VM writes, as
  # on the other providers: vagrant-qemu maps only its guest user and group to this computer's
  # (`--translate-uid map:1000:<uid>:1`), and an unprivileged virtiofsd refuses any other id
  # (EPERM: the attack box's player, root in docker-vm's VM), whatever the folder's permissions
  # say. Every other guest uid and gid is squashed to this computer's user and group, in two
  # ranges either side of the mapped one, so no two rules overlap. Only where the virtiofsd
  # vagrant-qemu starts translates ids (1.13 or later, `--translate-uid` in its `--help`, as
  # vagrant-qemu checks before its own map): an older one would refuse the arguments.
  def self.virtiofs_squash
    return [] unless virtiofsd_translates?
    [["--translate-uid", Process.uid], ["--translate-gid", Process.gid]].flat_map do |flag, host|
      [flag, "squash-guest:0:#{host}:#{GUEST_ID}", flag, "squash-guest:#{GUEST_ID + 1}:#{host}:#{ID_END - GUEST_ID - 1}"]
    end
  end

  # Whether the virtiofsd vagrant-qemu would start translates ids: the one it finds (on the PATH,
  # then /usr/libexec and /usr/lib/qemu), its `--help` naming `--translate-uid`.
  def self.virtiofsd_translates?
    return @translates unless @translates.nil?
    dirs = ENV.fetch("PATH", "").split(File::PATH_SEPARATOR)
    found = (dirs.map { |d| File.join(d, "virtiofsd") } + %w[/usr/libexec/virtiofsd /usr/lib/qemu/virtiofsd])
            .find { |f| File.file?(f) && File.executable?(f) }
    @translates = !found.nil? && IO.popen([found, "--help"], err: %i[child out], &:read).include?("--translate-uid")
  rescue SystemCallError
    @translates = false
  end
end
# On UTM, a Linux VM's default route through UTM's shared network, not the plugin's slower emulated one (the `nat-route` provisioners).
ISOLOOM_NAT_ROUTE = <<~'SH'
set -eu
gw=10.0.2.2
dev_of() { awk '{for (i = 1; i < NF; i++) if ($i == "dev") { print $(i + 1); exit }}'; }
via_of() { awk '{for (i = 1; i < NF; i++) if ($i == "via") { print $(i + 1); exit }}'; }
nat=$(ip -4 route show default via "$gw" | dev_of)
# No default route through the emulated network, or no shared one to prefer: nothing to do.
[ -n "$nat" ] || exit 0
up=$(ip -4 route show default | grep -v "via $gw dev $nat " | dev_of)
[ -n "$up" ] || exit 0
# The shared network leads only when it reaches the internet; otherwise the emulated one does.
metric=200
for probe in 1.1.1.1 8.8.8.8 9.9.9.9; do
  if ping -c 1 -W 2 -I "$up" "$probe" >/dev/null 2>&1; then metric=50; break; fi
done
[ "$metric" = 50 ] || echo "nat-route: the shared network ($up) reaches no public resolver; the emulated network keeps the traffic"
# Waits (up to 30 s) for the shared card's default route after its configuration was applied.
route_back() {
  i=0
  until ip -4 route show default dev "$up" | grep -q .; do
    i=$((i + 1))
    [ "$i" -lt 30 ] || return 1
    sleep 1
  done
}
netd=${ISOLOOM_NETWORKD_DIR:-/etc/systemd/network}
if command -v nmcli >/dev/null 2>&1 && nmcli -t -f RUNNING general 2>/dev/null | grep -q running; then
  con=$(nmcli -g GENERAL.CONNECTION device show "$up")
  if [ -n "$con" ] && [ "$(nmcli -g ipv4.route-metric connection show "$con")" != "$metric" ]; then
    nmcli connection modify "$con" ipv4.route-metric "$metric"
    nmcli device reapply "$up"
  fi
elif command -v networkctl >/dev/null 2>&1 && file=$(networkctl status "$up" 2>/dev/null | sed -n 's/^ *Network File: //p') && [ -n "$file" ] && [ "$file" != n/a ]; then
  own="$netd/05-isoloom-uplink.network"
  want=$(printf '[Match]\nName=%s\n\n[Network]\nDHCP=yes\n\n[DHCPv4]\nRouteMetric=%s\n' "$up" "$metric")
  if [ "$file" != "$own" ] || [ "$(cat "$own")" != "$want" ]; then
    mkdir -p "$netd"
    printf '%s\n' "$want" > "$own"
    networkctl reload
    networkctl reconfigure "$up"
  fi
elif [ -f /etc/network/interfaces ]; then
  for f in /etc/network/interfaces /etc/network/interfaces.d/*; do
    [ -f "$f" ] && grep -q "^iface $up inet dhcp" "$f" || continue
    sed -i "/^iface $up inet dhcp/,/^[^ \t]/{/^[ \t]*metric /d}" "$f"
    sed -i "/^iface $up inet dhcp/a\\    metric $metric" "$f"
  done
fi
if ! route_back; then
  echo "nat-route: the shared card has no default route any more; the emulated network carries the traffic"
  exit 0
fi
# The route as it is now, whatever the configuration does at its next renewal.
upgw=$(ip -4 route show default dev "$up" | via_of)
ip -4 route show default dev "$up" | grep -q " metric $metric " ||
  ip -4 route replace default via "$upgw" dev "$up" metric "$metric"
for m in $(ip -4 route show default dev "$up" | awk '{m = 0; for (i = 1; i < NF; i++) if ($i == "metric") m = $(i + 1); print m}'); do
  [ "$m" = "$metric" ] || ip -4 route del default via "$upgw" dev "$up" metric "$m"
done
SH
require "json"
# The host ports the runner chose for this run; each forward defaults to its own number.
ISOLOOM_HOSTPORTS = (JSON.parse(ENV.fetch("ISOLOOM_HOSTPORTS", "{}")) rescue {})

Vagrant.configure("2") do |config|
  config.vm.box = "bento/debian-12"
  config.vm.hostname = "slow-link"
  config.vm.synced_folder ".", "/vagrant", disabled: true
  config.vm.boot_timeout = 600
  config.ssh.proxy_command = ENV["ISOLOOM_SSH_PROXY_COMMAND"] if ENV["ISOLOOM_SSH_PROXY_COMMAND"]
  config.vm.provider "libvirt" do |v|
    v.default_prefix = "slow-link_"
  end
  config.vm.provider "virtualbox" do |v|
    v.customize ["modifyvm", :id, "--graphicscontroller", "vboxvga"] unless RbConfig::CONFIG["host_cpu"] =~ /arm|aarch64/
    v.name = "slow-link - isoloom-docker-host"
    v.cpus = 2
    v.memory = 2048
  end
  config.vm.provider "vmware_desktop" do |v|
    v.vmx["displayName"] = "slow-link - isoloom-docker-host"
    v.vmx["numvcpus"] = "2"
    v.vmx["memsize"] = "2048"
  end
  config.vm.provider "parallels" do |v|
    v.name = "slow-link - isoloom-docker-host"
    v.cpus = 2
    v.memory = 2048
  end
  config.vm.provider "utm" do |v, o|
    o.vm.box = "utm/bookworm"
    o.vm.box_version = ">= 0"
    v.name = "slow-link - isoloom-docker-host"
    v.cpus = 2
    v.memory = 2048
    o.vm.provision "nat-route", type: "shell", run: "always", preserve_order: true, inline: ISOLOOM_NAT_ROUTE
  end
  config.vm.provider "qemu" do |v, o|
    o.vm.box = "cloud-image/debian-12"
    o.vm.box_version = ">= 0"
    v.smp = "cpus=2"
    v.memory = "2048M"
    v.disk_resize = IsoloomQemu.disk("cloud-image/debian-12", 40)
    v.ssh_port = ISOLOOM_HOSTPORTS.fetch("isoloom-docker-host/ssh", 50022)
    v.ssh_auto_correct = true
  end
  config.vm.provider "libvirt" do |v, o|
    o.vm.box = "generic/debian12"
    o.vm.box_version = ">= 0"
    o.vm.box_architecture = :auto
    v.cpus = 2
    v.memory = 2048
    v.memorybacking :access, mode: "shared"
    v.memorybacking :source, type: "memfd"
  end
  config.vm.provider "vmware_esxi" do |v|
    v.esxi_hostname = ENV.fetch("ESXI_HOSTNAME", "")
    v.esxi_hostport = ENV.fetch("ESXI_HOSTPORT", "22").to_i
    v.esxi_username = ENV.fetch("ESXI_USERNAME", "root")
    v.esxi_password = "env:ESXI_PASSWORD"
    v.esxi_disk_store = ENV["ESXI_DATASTORE"] if ENV["ESXI_DATASTORE"]
    v.esxi_virtual_network = [ENV.fetch("ESXI_VIRTUAL_NETWORK", "VM Network").split(",").first.strip]
    v.guest_name = "slow-link-isoloom-docker-host"
    v.guest_numvcpus = 2
    v.guest_memsize = 2048
  end
  config.vm.provision "nat-route", type: "shell", run: "always", inline: ":"
  config.vm.provision "project", type: "isoloom_project", rules: "/.isoloom*
!/.isoloom/docker
!/.isoloom/configure
.git/
.terraform/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
crash.log
crash.*.log
.vagrant/
"
  config.vm.provision "docker", type: "shell", inline: "command -v docker >/dev/null || if command -v apt-get >/dev/null; then (
  set -e
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -qq
  apt-get install -y -qq ca-certificates curl
  install -m 0755 -d /etc/apt/keyrings
  k=$(mktemp)
  # shellcheck disable=SC1091,SC2154 # /etc/os-release is on the guest, not here.
  _id=$(. /etc/os-release && printf %s \"$ID\")
  # shellcheck disable=SC1091,SC2154
  _cn=$(. /etc/os-release && printf %s \"$VERSION_CODENAME\")
  curl -fsSL \"https://download.docker.com/linux/$_id/gpg\" -o \"$k\"
  echo \"1500c1f56fa9e26b9b8f42452a553675796ade0807cdce11975eb98170b3a570  $k\" | sha256sum -c -
  install -m 0644 \"$k\" /etc/apt/keyrings/docker.asc
  rm -f \"$k\"
  echo \"deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/$_id $_cn stable\" > /etc/apt/sources.list.d/docker.list
  apt-get update -qq
  v=$(apt-cache madison docker-ce | awk '$3 ~ /(^|:)29[.]9[.]0/ { print $3; exit }')
  [ -n \"$v\" ] || { echo \"docker-ce 29.9.0 is not in Docker's apt repository\" >&2; exit 1; }
  apt-get install -y -qq --allow-downgrades \"docker-ce=$v\" \"docker-ce-cli=$v\" containerd.io docker-buildx-plugin \"docker-compose-plugin=5.6.0-*\"
  # A container pinned to x86 (its spec's hardware.arch, or an image published for x86 only): on
  # another CPU (an Apple Silicon Mac's VM, an Arm cloud VM) the engine runs it through QEMU's
  # user-mode emulation, which Debian registers with binfmt for every container (Docker Desktop
  # does the same on its own).
  [ \"$(dpkg --print-architecture)\" = amd64 ] || apt-get install -y -qq qemu-user-static binfmt-support
)
else
  curl -fsSL https://get.docker.com | VERSION=29.9.0 sh
fi
cat > /etc/systemd/system/isoloom-published.service <<'UNIT'
[Unit]
Description=Isoloom: published ports reach containers of networks without a default route
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'iptables -t nat -C POSTROUTING -m conntrack --ctstate DNAT -o br-+ -j MASQUERADE 2>/dev/null || iptables -t nat -I POSTROUTING -m conntrack --ctstate DNAT -o br-+ -j MASQUERADE'

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now isoloom-published.service
"
  config.vm.provision "shell", name: "environment", inline: "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name slow-link --file .isoloom/docker/compose.yml pull --policy missing --ignore-buildable --include-deps || exit 1
cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name slow-link --file .isoloom/docker/compose.yml up --detach --build --pull missing --remove-orphans --wait --wait-timeout 600 || exit 1
mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready"
  config.vm.provision "shell", name: "checks", run: "never", inline: "failed=0
if (
cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name slow-link --file .isoloom/docker/compose.yml --profile check up --detach --wait --no-deps isoloom-access isoloom-routes-isoloom-access || exit 1
); then
  cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name slow-link --file .isoloom/docker/compose.yml --profile check run --rm --no-deps --env ISOLOOM_DERIVED=\"$ISOLOOM_DERIVED\" isoloom-check || failed=1
else
  failed=1
fi
cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name slow-link --file .isoloom/docker/compose.yml --profile check rm --stop --force isoloom-access isoloom-routes-isoloom-access || echo 'stand-ins-down: failed, tolerated' >&2
exit \"$failed\"", env: { "ISOLOOM_DERIVED" => ENV.fetch("ISOLOOM_DERIVED", "1") }
end

## .isoloom/docker-vm/proxmox/main.tf
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  terraform -chdir=.isoloom/docker-vm/proxmox init && terraform -chdir=.isoloom/docker-vm/proxmox apply -var proxmox_endpoint=https://<server>:8006/ -var proxmox_api_token=<user@realm!name=secret> -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)"
# Stop:   terraform -chdir=.isoloom/docker-vm/proxmox destroy (same variables)
# Then:   the project in /opt/isoloom, setup.sh piped into `sudo sh -s` over SSH, and Compose (run.json)

terraform {
  required_version = ">= 1.6.0"
  backend "local" {}
  required_providers {
    proxmox = { source = "bpg/proxmox", version = "~> 0.116.1" }
  }
}

variable "proxmox_endpoint" {
  type        = string
  description = "https://<server>:8006/"
}

variable "proxmox_api_token" {
  type        = string
  default     = ""
  sensitive   = true
  description = "user@realm!name=secret; or use proxmox_username and proxmox_password"
}

variable "proxmox_username" {
  type    = string
  default = "root@pam"
}

variable "proxmox_password" {
  type      = string
  default   = ""
  sensitive = true
}

variable "proxmox_insecure" {
  type        = bool
  default     = false
  description = "Accept the server's self-signed certificate (TLS isn't verified)"
}

variable "proxmox_ssh_username" {
  type        = string
  default     = "root"
  description = "Uploading cloud-init snippets goes over SSH to the node"
}

variable "proxmox_ssh_private_key_file" {
  type    = string
  default = ""
}

variable "proxmox_ssh_address" {
  type        = string
  default     = ""
  description = "The node's SSH address, when the API reports one this machine can't reach"
}

variable "node" {
  type        = string
  description = "The Proxmox node the VMs go on (`pvesh get /nodes` lists them)"
  validation {
    condition     = var.node != ""
    error_message = "Set `node` to the Proxmox node the environment's VMs go on (`pvesh get /nodes` lists them)."
  }
}

variable "datastore" {
  type        = string
  default     = "local-lvm"
  description = "Where VM disks go"
}

variable "image_datastore" {
  type        = string
  default     = "local"
  description = "A datastore with 'iso' content, for cloud images"
}

variable "snippets_datastore" {
  type        = string
  default     = "local"
  description = "A datastore with 'snippets' content, for cloud-init"
}

variable "uplink_bridge" {
  type        = string
  default     = "vmbr0"
  description = "The bridge the VM gets its address (DHCP) and the internet from"
}

variable "slot" {
  type        = number
  default     = 1
  description = "1 to 99, unique per environment on this server"
  validation {
    condition     = var.slot >= 1 && var.slot <= 99
    error_message = "slot is 1 to 99."
  }
}

variable "ssh_public_key" {
  type        = string
  default     = ""
  description = "The SSH public key the machines let in: whoever holds its private key signs in, as the runner (run.json) does to deliver the project and run the checks"
}

provider "proxmox" {
  endpoint  = var.proxmox_endpoint
  api_token = var.proxmox_api_token != "" ? var.proxmox_api_token : null
  username  = var.proxmox_api_token != "" ? null : var.proxmox_username
  password  = var.proxmox_api_token != "" ? null : var.proxmox_password
  insecure  = var.proxmox_insecure
  ssh {
    agent       = false
    username    = var.proxmox_ssh_username
    password    = var.proxmox_ssh_private_key_file != "" ? null : var.proxmox_password
    private_key = var.proxmox_ssh_private_key_file != "" ? file(var.proxmox_ssh_private_key_file) : null
    dynamic "node" {
      for_each = var.proxmox_ssh_address == "" ? [] : [1]
      content {
        name    = var.node
        address = var.proxmox_ssh_address
      }
    }
  }
}

# The VM's address on the uplink, from the guest agent (not the loopback).
locals {
  ip = try([for a in try(flatten(proxmox_virtual_environment_vm.env.ipv4_addresses), []) : a if a != "127.0.0.1"][0], "")
}

resource "proxmox_download_file" "debian" {
  node_name           = var.node
  datastore_id        = var.image_datastore
  content_type        = "iso"
  url                 = "https://cloud.debian.org/images/cloud/bookworm/20261015-2632/debian-12-genericcloud-amd64-20261015-2632.qcow2"
  file_name           = "iso${var.slot}-docker-debian-12.img"
  overwrite_unmanaged = true
  checksum            = "56c0bd55b6623f2739f377e983d2872e7b208d0cb9c3ba4e93d3f72929026da03637c598b3bd472b29998c31c8a4c17d8e6ae1c556852a8b83a66a09bf5c2b37"
  checksum_algorithm  = "sha512"
}

resource "proxmox_virtual_environment_file" "env" {
  node_name    = var.node
  datastore_id = var.snippets_datastore
  content_type = "snippets"
  source_raw {
    file_name = "iso${var.slot}-docker.yaml"
    data = format("#cloud-config\n%s", yamlencode({
      hostname = "slow-link"
      users = [
        {
          name                = "isoloom"
          sudo                = "ALL=(ALL) NOPASSWD:ALL"
          shell               = "/bin/bash"
          ssh_authorized_keys = [var.ssh_public_key]
        }
      ]
      packages = ["qemu-guest-agent", "curl"]
      runcmd   = ["systemctl enable --now qemu-guest-agent"]
    }))
  }
}

resource "proxmox_virtual_environment_vm" "env" {
  name      = "iso${var.slot}-slow-link"
  node_name = var.node
  tags      = ["isoloom", "slow-link"]
  on_boot   = false
  agent {
    enabled = true
    timeout = "8m"
    wait_for_ip {
      ipv4 = true
    }
  }
  stop_on_destroy = true
  cpu {
    cores = 2
    type  = "host"
  }
  memory {
    dedicated = 2048
  }
  disk {
    datastore_id = var.datastore
    file_id      = proxmox_download_file.debian.id
    interface    = "virtio0"
    size         = 40
  }
  network_device {
    bridge = var.uplink_bridge
  }
  initialization {
    datastore_id      = var.datastore
    user_data_file_id = proxmox_virtual_environment_file.env.id
    ip_config {
      ipv4 {
        address = "dhcp"
      }
    }
  }
  operating_system {
    type = "l26"
  }
  serial_device {}
  lifecycle {
    postcondition {
      condition     = length([for a in try(flatten(self.ipv4_addresses), []) : a if a != "127.0.0.1"]) > 0
      error_message = "The Docker host got no IPv4 address on its uplink bridge `${var.uplink_bridge}` within 8m: the bridge has no DHCP, or no DNS or internet to install qemu-guest-agent, which reports the address (an IPv6 address alone isn't enough: the uplink needs IPv4 from DHCP). Give it an uplink bridge with DHCP and internet (`uplink_bridge`)."
    }
  }
}

output "ip" {
  value = local.ip
}

output "ssh_user" {
  value = "isoloom"
}

## .isoloom/docker-vm/proxmox/run.json
{
  "$schema": "https://raw.githubusercontent.com/isoloom/isoloom/main/schemas/run-manifest-v1.schema.json",
  "manifest_version": 1,
  "generator": {
    "name": "isoloom",
    "version": "[version]"
  },
  "environment": {
    "name": "slow-link",
    "instance": null,
    "message": null
  },
  "target": "docker-vm",
  "driver": "terraform",
  "hosts": [
    "linux",
    "macos",
    "windows"
  ],
  "tools": [
    {
      "name": "terraform",
      "probe": [
        "terraform",
        "version"
      ],
      "min_version": "1.6.0",
      "container": "hashicorp/terraform:1.16.7@sha256:c9c77f5b9820832cbc7b88d16df406ac6e75fee5a9077e5437db0c54e5ff33e3",
      "container_hosts": [
        "macos"
      ]
    },
    {
      "name": "ssh",
      "probe": [
        "ssh",
        "-V"
      ]
    }
  ],
  "identity": {
    "terraform": {
      "module": ".",
      "state": "runner",
      "gone": [
        {
          "resource": "proxmox_virtual_environment_firewall_ipset",
          "error": "no such IPSet '{id}'"
        },
        {
          "resource": "proxmox_virtual_environment_vm",
          "error": "Configuration file 'nodes/{node_name}/qemu-server/{id}.conf' does not exist"
        },
        {
          "resource": "proxmox_virtual_environment_container",
          "error": "Configuration file 'nodes/{node_name}/lxc/{id}.conf' does not exist"
        }
      ]
    }
  },
  "params": [
    {
      "name": "proxmox_endpoint",
      "description": "https://<server>:8006/.",
      "required": true,
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_endpoint"
        }
      ]
    },
    {
      "name": "proxmox_username",
      "description": "The module's `proxmox_username`.",
      "default": "root@pam",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_username"
        }
      ]
    },
    {
      "name": "proxmox_insecure",
      "description": "Accept the server's self-signed certificate (TLS isn't verified).",
      "default": "false",
      "values": [
        "true",
        "false"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_insecure"
        }
      ]
    },
    {
      "name": "proxmox_ssh_username",
      "description": "Uploading cloud-init snippets goes over SSH to the node.",
      "default": "root",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_ssh_username"
        }
      ]
    },
    {
      "name": "proxmox_ssh_address",
      "description": "The node's SSH address, when the API reports one this machine can't reach.",
      "default": "",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_ssh_address"
        }
      ]
    },
    {
      "name": "node",
      "description": "The Proxmox node the VMs go on (`pvesh get /nodes` lists them).",
      "required": true,
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "node"
        }
      ]
    },
    {
      "name": "datastore",
      "description": "Where VM disks go.",
      "default": "local-lvm",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "datastore"
        }
      ]
    },
    {
      "name": "image_datastore",
      "description": "A datastore with 'iso' content, for cloud images.",
      "default": "local",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "image_datastore"
        }
      ]
    },
    {
      "name": "snippets_datastore",
      "description": "A datastore with 'snippets' content, for cloud-init.",
      "default": "local",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "snippets_datastore"
        }
      ]
    },
    {
      "name": "uplink_bridge",
      "description": "The bridge the VM gets its address (DHCP) and the internet from.",
      "default": "vmbr0",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "uplink_bridge"
        }
      ]
    },
    {
      "name": "ISOLOOM_DERIVED",
      "description": "0: the checks derived from the spec (reachability, no internet) are skipped.",
      "default": "1",
      "values": [
        "0",
        "1"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_DERIVED",
          "steps": [
            "check-user"
          ]
        }
      ]
    }
  ],
  "secrets": [
    {
      "name": "proxmox_api_token",
      "kind": "connection",
      "required": false,
      "sensitive": true,
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_api_token"
        }
      ]
    },
    {
      "name": "proxmox_password",
      "kind": "connection",
      "required": false,
      "sensitive": true,
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_password"
        }
      ]
    }
  ],
  "networks": [
    {
      "name": "branch",
      "cidr": "10.75.1.0/24",
      "internet": true,
      "native": "slow-link_branch"
    },
    {
      "name": "far",
      "cidr": "10.75.2.0/24",
      "internet": true,
      "native": "slow-link_far"
    }
  ],
  "machines": [
    {
      "name": "isoloom-docker-host",
      "role": "infra",
      "resources": {
        "cpus": 2,
        "memory_mb": 2048
      },
      "addresses": {}
    },
    {
      "name": "isoloom-router",
      "role": "infra",
      "addresses": {
        "branch": "10.75.1.254",
        "far": "10.75.2.254"
      },
      "native": {
        "service": "isoloom-router"
      }
    },
    {
      "name": "web",
      "role": "member",
      "resources": {
        "cpus": 1,
        "memory_mb": 512
      },
      "addresses": {
        "far": "10.75.2.10"
      },
      "native": {
        "service": "web"
      },
      "ports": [
        {
          "name": "web",
          "port": 80,
          "protocol": "tcp",
          "http": true
        }
      ]
    },
    {
      "name": "isoloom-routes-web",
      "role": "infra",
      "of": "web",
      "addresses": {},
      "native": {
        "service": "isoloom-routes-web"
      }
    },
    {
      "name": "user",
      "role": "access",
      "resources": {
        "cpus": 1,
        "memory_mb": 512
      },
      "addresses": {
        "branch": "10.75.1.10"
      },
      "on_demand": true,
      "native": {
        "service": "user"
      }
    },
    {
      "name": "isoloom-routes-user",
      "role": "infra",
      "of": "user",
      "addresses": {},
      "native": {
        "service": "isoloom-routes-user"
      }
    },
    {
      "name": "isoloom-access",
      "role": "access",
      "addresses": {
        "branch": "10.75.1.10"
      },
      "native": {
        "service": "isoloom-access"
      }
    },
    {
      "name": "isoloom-routes-isoloom-access",
      "role": "infra",
      "of": "isoloom-access",
      "addresses": {},
      "native": {
        "service": "isoloom-routes-isoloom-access"
      }
    },
    {
      "name": "isoloom-check",
      "role": "check",
      "of": "user",
      "addresses": {},
      "native": {
        "service": "isoloom-check"
      }
    },
    {
      "name": "isoloom-tool-shell",
      "role": "tool",
      "addresses": {},
      "native": {
        "service": "isoloom-tool-shell"
      }
    },
    {
      "name": "isoloom-probe",
      "role": "infra",
      "addresses": {},
      "native": {
        "service": "isoloom-probe"
      }
    }
  ],
  "lifecycle": {
    "up": [
      {
        "id": "clear-lock",
        "action": "terraform.clear_lock"
      },
      {
        "id": "init",
        "note": "Preparing Terraform and its providers…",
        "argv": [
          "terraform",
          "init",
          "-input=false",
          "-no-color",
          "-backend-config=path=${run.state_dir}/terraform.tfstate"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_proxmox_ssh_private_key_file": "${run.ssh_key}",
          "TF_VAR_slot": "${run.slot}",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 900
      },
      {
        "id": "apply",
        "note": "Creating the environment's VMs on the server…",
        "argv": [
          "terraform",
          "apply",
          "-auto-approve",
          "-input=false",
          "-no-color"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_proxmox_ssh_private_key_file": "${run.ssh_key}",
          "TF_VAR_slot": "${run.slot}",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 3600
      },
      {
        "id": "archive",
        "note": "Archiving the project…",
        "action": "project.archive",
        "with": {
          "outputs": ".isoloom/docker .isoloom/configure",
          "root": "../../.."
        }
      },
      {
        "id": "project",
        "note": "Copying the project into the VM…",
        "action": "ssh.run",
        "with": {
          "command": "sudo sh -c 'rm -rf /opt/isoloom && mkdir -p /opt/isoloom && tar -xzf - -C /opt/isoloom'",
          "host": "${outputs.ip}",
          "user": "isoloom"
        },
        "stdin": "${run.state_dir}/project.tgz",
        "timeout_s": 600
      },
      {
        "id": "docker",
        "note": "Installing Docker in the VM…",
        "action": "ssh.run",
        "with": {
          "command": "sudo sh -s",
          "host": "${outputs.ip}",
          "user": "isoloom"
        },
        "stdin": "setup.sh",
        "timeout_s": 1800
      },
      {
        "id": "pull-start",
        "note": "Pulling the environment's images in the VM…",
        "action": "ssh.run",
        "with": {
          "command": "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name slow-link --file .isoloom/docker/compose.yml pull --policy missing --ignore-buildable --include-deps",
          "host": "${outputs.ip}",
          "user": "isoloom"
        },
        "timeout_s": 900,
        "download": true
      },
      {
        "id": "start",
        "note": "Starting the environment's containers in the VM…",
        "action": "ssh.run",
        "with": {
          "command": "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name slow-link --file .isoloom/docker/compose.yml up --detach --build --pull missing --remove-orphans --wait --wait-timeout 600",
          "host": "${outputs.ip}",
          "user": "isoloom"
        },
        "timeout_s": 1800
      }
    ],
    "down": [
      {
        "id": "clear-lock",
        "action": "terraform.clear_lock"
      },
      {
        "id": "init",
        "note": "Preparing Terraform and its providers…",
        "argv": [
          "terraform",
          "init",
          "-input=false",
          "-no-color",
          "-backend-config=path=${run.state_dir}/terraform.tfstate"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_proxmox_ssh_private_key_file": "${run.ssh_key}",
          "TF_VAR_slot": "${run.slot}",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 900
      },
      {
        "id": "destroy",
        "note": "Removing the environment from the server…",
        "argv": [
          "terraform",
          "destroy",
          "-auto-approve",
          "-input=false",
          "-no-color",
          "-refresh=false"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_proxmox_ssh_private_key_file": "${run.ssh_key}",
          "TF_VAR_slot": "${run.slot}",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 1800
      }
    ],
    "status": {
      "id": "state",
      "action": "terraform.read_state"
    }
  },
  "ready": [
    {
      "kind": "step_ok",
      "step": "apply",
      "means": "the Docker host VM exists and booted"
    },
    {
      "kind": "step_ok",
      "step": "start",
      "means": "every long-running service is healthy (`--wait`: each port's probe, the route keepers, the machines' own healthchecks)"
    }
  ],
  "outputs": [
    {
      "name": "ip",
      "description": "The Docker host's address: SSH reaches it there, and its containers' published ports answer there.",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ip"
      }
    },
    {
      "name": "ssh_user",
      "description": "The user the runner's key lets in on the Docker host.",
      "role": "info",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ssh_user"
      }
    }
  ],
  "checks": {
    "protocol": "isoloom-check/1",
    "setup": [
      {
        "id": "stand-ins",
        "note": "Starting the access machine's stand-in…",
        "action": "ssh.run",
        "with": {
          "command": "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name slow-link --file .isoloom/docker/compose.yml --profile check up --detach --wait --no-deps isoloom-access isoloom-routes-isoloom-access",
          "host": "${outputs.ip}",
          "user": "isoloom"
        },
        "timeout_s": 600
      }
    ],
    "runners": [
      {
        "id": "isoloom-check",
        "from": "from user",
        "checks": [
          {
            "name": "the far site answers, slowly",
            "kind": "script",
            "wait_s": 0,
            "derived": false
          },
          {
            "name": "web:80 from user",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          }
        ],
        "step": {
          "id": "check-user",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name slow-link --file .isoloom/docker/compose.yml --profile check run --rm --no-deps --env ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} isoloom-check",
            "host": "${outputs.ip}",
            "user": "isoloom"
          },
          "timeout_s": 120
        },
        "on_timeout": [
          {
            "id": "rm-check-user",
            "action": "ssh.run",
            "with": {
              "command": "sudo docker ps -aq --filter label=com.docker.compose.project=slow-link --filter label=com.docker.compose.service=isoloom-check --filter label=com.docker.compose.oneoff=True | xargs -r sudo docker rm -f",
              "host": "${outputs.ip}",
              "user": "isoloom"
            },
            "timeout_s": 60
          }
        ]
      }
    ],
    "teardown": [
      {
        "id": "stand-ins-down",
        "action": "ssh.run",
        "with": {
          "command": "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name slow-link --file .isoloom/docker/compose.yml --profile check rm --stop --force isoloom-access isoloom-routes-isoloom-access",
          "host": "${outputs.ip}",
          "user": "isoloom"
        },
        "timeout_s": 120,
        "failure": "tolerate"
      }
    ]
  },
  "guest": {
    "machine": "isoloom-docker-host",
    "host": "${outputs.ip}",
    "status": {
      "id": "ps",
      "action": "ssh.run",
      "with": {
        "command": "if command -v docker >/dev/null; then sudo docker compose --project-name slow-link ps --all --format json; fi",
        "host": "${outputs.ip}",
        "user": "isoloom"
      },
      "timeout_s": 60
    }
  }
}

## .isoloom/docker-vm/proxmox/setup.sh
#!/bin/sh
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# The Docker host's set-up, piped into `sh -s` as root over SSH by its run manifest.
set -e
cloud-init status --wait >/dev/null 2>&1 || true
command -v docker >/dev/null || if command -v apt-get >/dev/null; then (
  set -e
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -qq
  apt-get install -y -qq ca-certificates curl
  install -m 0755 -d /etc/apt/keyrings
  k=$(mktemp)
  # shellcheck disable=SC1091,SC2154 # /etc/os-release is on the guest, not here.
  _id=$(. /etc/os-release && printf %s "$ID")
  # shellcheck disable=SC1091,SC2154
  _cn=$(. /etc/os-release && printf %s "$VERSION_CODENAME")
  curl -fsSL "https://download.docker.com/linux/$_id/gpg" -o "$k"
  echo "1500c1f56fa9e26b9b8f42452a553675796ade0807cdce11975eb98170b3a570  $k" | sha256sum -c -
  install -m 0644 "$k" /etc/apt/keyrings/docker.asc
  rm -f "$k"
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/$_id $_cn stable" > /etc/apt/sources.list.d/docker.list
  apt-get update -qq
  v=$(apt-cache madison docker-ce | awk '$3 ~ /(^|:)29[.]9[.]0/ { print $3; exit }')
  [ -n "$v" ] || { echo "docker-ce 29.9.0 is not in Docker's apt repository" >&2; exit 1; }
  apt-get install -y -qq --allow-downgrades "docker-ce=$v" "docker-ce-cli=$v" containerd.io docker-buildx-plugin "docker-compose-plugin=5.6.0-*"
  # A container pinned to x86 (its spec's hardware.arch, or an image published for x86 only): on
  # another CPU (an Apple Silicon Mac's VM, an Arm cloud VM) the engine runs it through QEMU's
  # user-mode emulation, which Debian registers with binfmt for every container (Docker Desktop
  # does the same on its own).
  [ "$(dpkg --print-architecture)" = amd64 ] || apt-get install -y -qq qemu-user-static binfmt-support
)
else
  curl -fsSL https://get.docker.com | VERSION=29.9.0 sh
fi
cat > /etc/systemd/system/isoloom-published.service <<'UNIT'
[Unit]
Description=Isoloom: published ports reach containers of networks without a default route
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'iptables -t nat -C POSTROUTING -m conntrack --ctstate DNAT -o br-+ -j MASQUERADE 2>/dev/null || iptables -t nat -I POSTROUTING -m conntrack --ctstate DNAT -o br-+ -j MASQUERADE'

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now isoloom-published.service

## .isoloom/docker-vm/run.json
{
  "$schema": "https://raw.githubusercontent.com/isoloom/isoloom/main/schemas/run-manifest-v1.schema.json",
  "manifest_version": 1,
  "generator": {
    "name": "isoloom",
    "version": "[version]"
  },
  "environment": {
    "name": "slow-link",
    "instance": null,
    "message": null
  },
  "target": "docker-vm",
  "driver": "vagrant",
  "hosts": [
    "linux",
    "macos",
    "windows"
  ],
  "tools": [
    {
      "name": "vagrant",
      "probe": [
        "vagrant",
        "--version"
      ],
      "min_version": "2.4.0"
    },
    {
      "name": "virtualbox",
      "probe": [
        "VBoxManage",
        "--version"
      ],
      "providers": [
        "virtualbox"
      ]
    },
    {
      "name": "vmware",
      "probe": [
        "vmrun",
        "list"
      ],
      "providers": [
        "vmware_desktop"
      ]
    },
    {
      "name": "parallels",
      "probe": [
        "prlctl",
        "--version"
      ],
      "hosts": [
        "macos"
      ],
      "providers": [
        "parallels"
      ]
    },
    {
      "name": "libvirt",
      "probe": [
        "virsh",
        "--version"
      ],
      "hosts": [
        "linux"
      ],
      "providers": [
        "libvirt"
      ]
    },
    {
      "name": "qemu",
      "probe": [
        "qemu-img",
        "--version"
      ],
      "providers": [
        "qemu"
      ]
    }
  ],
  "identity": {
    "vagrant": {
      "providers": [
        {
          "id": "virtualbox",
          "hosts": [
            "linux",
            "macos",
            "windows"
          ],
          "elevation": "none",
          "refusal": null
        },
        {
          "id": "vmware_desktop",
          "hosts": [
            "linux",
            "macos",
            "windows"
          ],
          "plugin": "vagrant-vmware-desktop",
          "elevation": "none",
          "refusal": null
        },
        {
          "id": "parallels",
          "hosts": [
            "macos"
          ],
          "plugin": "vagrant-parallels",
          "elevation": "none",
          "refusal": null
        },
        {
          "id": "libvirt",
          "hosts": [
            "linux"
          ],
          "plugin": "vagrant-libvirt",
          "elevation": "none",
          "refusal": null
        },
        {
          "id": "qemu",
          "hosts": [
            "linux",
            "macos"
          ],
          "plugin": "vagrant-qemu",
          "elevation": "none",
          "refusal": null
        },
        {
          "id": "utm",
          "hosts": [
            "macos"
          ],
          "plugin": "vagrant_utm",
          "elevation": "none",
          "refusal": null
        },
        {
          "id": "vmware_esxi",
          "hosts": [
            "linux",
            "macos",
            "windows"
          ],
          "plugin": "vagrant-vmware-esxi",
          "elevation": "none",
          "remote": true,
          "refusal": null
        }
      ],
      "dotfile": "${run.state_dir}/vagrant"
    }
  },
  "params": [
    {
      "name": "ISOLOOM_SSH_PROXY_COMMAND",
      "description": "The command Vagrant's SSH to the VMs goes through (an SSH `ProxyCommand`), when this computer can't reach them directly; unset, it connects straight to them.",
      "providers": [
        "vmware_esxi"
      ],
      "set_by": "runner",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_SSH_PROXY_COMMAND",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "ESXI_HOSTNAME",
      "description": "The ESXi host.",
      "required": true,
      "providers": [
        "vmware_esxi"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ESXI_HOSTNAME",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "ESXI_HOSTPORT",
      "description": "Its SSH port.",
      "default": "22",
      "providers": [
        "vmware_esxi"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ESXI_HOSTPORT",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "ESXI_USERNAME",
      "description": "The ESXi user.",
      "default": "root",
      "providers": [
        "vmware_esxi"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ESXI_USERNAME",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "ESXI_DATASTORE",
      "description": "The datastore the VMs' disks go on (default: ESXi's first).",
      "providers": [
        "vmware_esxi"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ESXI_DATASTORE",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "ESXI_VIRTUAL_NETWORK",
      "description": "Port groups, comma-separated: the management network, then one per environment network.",
      "default": "VM Network",
      "providers": [
        "vmware_esxi"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ESXI_VIRTUAL_NETWORK",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "VAGRANT_HOST_ARCHITECTURE",
      "description": "The architecture Vagrant picks each box's build for: the ESXi host's (x86-64), not this computer's.",
      "default": "amd64",
      "values": [
        "amd64"
      ],
      "providers": [
        "vmware_esxi"
      ],
      "set_by": "runner",
      "deliver": [
        {
          "via": "env",
          "var": "VAGRANT_HOST_ARCHITECTURE",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "ISOLOOM_DERIVED",
      "description": "0: the checks derived from the spec (reachability, no internet) are skipped.",
      "default": "1",
      "values": [
        "0",
        "1"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_DERIVED",
          "steps": [
            "check-user"
          ]
        }
      ]
    }
  ],
  "secrets": [
    {
      "name": "ESXI_PASSWORD",
      "kind": "connection",
      "required": true,
      "sensitive": true,
      "providers": [
        "vmware_esxi"
      ],
      "deliver": [
        {
          "via": "env",
          "var": "ESXI_PASSWORD",
          "steps": [
            "*"
          ]
        }
      ]
    }
  ],
  "networks": [
    {
      "name": "branch",
      "cidr": "10.75.1.0/24",
      "internet": true,
      "native": "slow-link_branch"
    },
    {
      "name": "far",
      "cidr": "10.75.2.0/24",
      "internet": true,
      "native": "slow-link_far"
    }
  ],
  "machines": [
    {
      "name": "isoloom-docker-host",
      "role": "infra",
      "resources": {
        "cpus": 2,
        "memory_mb": 2048
      },
      "addresses": {},
      "native": {
        "vagrant": "default",
        "vm_names": {
          "virtualbox": "slow-link - isoloom-docker-host",
          "vmware_desktop": "slow-link - isoloom-docker-host",
          "parallels": "slow-link - isoloom-docker-host",
          "libvirt": "slow-link_default",
          "utm": "slow-link - isoloom-docker-host",
          "vmware_esxi": "slow-link-isoloom-docker-host"
        },
        "boot_digest": "sha256:94b43b1c399f3ab82e651f5ac6043b465dd046ddf8c5c8eccf8511bf94d7758c",
        "boxes": [
          {
            "provider": "virtualbox",
            "box": "bento/debian-12"
          },
          {
            "provider": "vmware_desktop",
            "box": "bento/debian-12"
          },
          {
            "provider": "parallels",
            "box": "bento/debian-12"
          },
          {
            "provider": "libvirt",
            "box": "generic/debian12"
          },
          {
            "provider": "qemu",
            "box": "cloud-image/debian-12"
          },
          {
            "provider": "utm",
            "box": "utm/bookworm"
          },
          {
            "provider": "vmware_esxi",
            "box": "bento/debian-12",
            "architecture": "amd64"
          }
        ]
      }
    },
    {
      "name": "isoloom-router",
      "role": "infra",
      "addresses": {
        "branch": "10.75.1.254",
        "far": "10.75.2.254"
      },
      "native": {
        "service": "isoloom-router"
      }
    },
    {
      "name": "web",
      "role": "member",
      "resources": {
        "cpus": 1,
        "memory_mb": 512
      },
      "addresses": {
        "far": "10.75.2.10"
      },
      "native": {
        "service": "web"
      },
      "ports": [
        {
          "name": "web",
          "port": 80,
          "protocol": "tcp",
          "http": true
        }
      ]
    },
    {
      "name": "isoloom-routes-web",
      "role": "infra",
      "of": "web",
      "addresses": {},
      "native": {
        "service": "isoloom-routes-web"
      }
    },
    {
      "name": "user",
      "role": "access",
      "resources": {
        "cpus": 1,
        "memory_mb": 512
      },
      "addresses": {
        "branch": "10.75.1.10"
      },
      "on_demand": true,
      "native": {
        "service": "user"
      }
    },
    {
      "name": "isoloom-routes-user",
      "role": "infra",
      "of": "user",
      "addresses": {},
      "native": {
        "service": "isoloom-routes-user"
      }
    },
    {
      "name": "isoloom-access",
      "role": "access",
      "addresses": {
        "branch": "10.75.1.10"
      },
