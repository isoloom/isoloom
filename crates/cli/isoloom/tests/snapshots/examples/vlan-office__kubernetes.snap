_retry() { _end=$(( $(date +%s) + $1 )); shift; while ! "$@"; do [ "$(date +%s)" -lt "$_end" ] || return 1; sleep 2; done; }

if _retry 60 _http_is 'http://intranet/' 200; then pass 'staff reach the intranet'; else fail 'staff reach the intranet' "expected HTTP 200 from http://intranet/, got $(_http 'http://intranet/')"; fi

if [ "${ISOLOOM_DERIVED:-1}" != 0 ]; then
if _retry 30 _http_any 'http://intranet:80/'; then pass 'intranet:80 from staff'; else fail 'intranet:80 from staff' "nothing answers at http://intranet:80/"; fi
fi

if [ "${ISOLOOM_DERIVED:-1}" != 0 ]; then
c=$(_http 'http://1.1.1.1/'); if [ "$c" = 000 ]; then pass 'no internet from staff'; else fail 'no internet from staff' "http://1.1.1.1/ answered (HTTP $c); it should be blocked"; fi
fi

echo "isoloom-check: END $passed passed, $failed failed"
[ "$failed" -eq 0 ]

## .isoloom/kubernetes/environment.yaml
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  kubectl apply -k .isoloom/kubernetes
#         kubectl -n isoloom-vlan-office wait --for=condition=Available deployment --all --timeout=600s
# Stop:   kubectl delete namespace isoloom-vlan-office

apiVersion: v1
kind: Namespace
metadata:
  name: isoloom-vlan-office
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: intranet
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      isoloom.com/machine: intranet
  template:
    metadata:
      labels:
        isoloom.com/machine: intranet
        net.isoloom.com/servers: member
    spec:
      hostname: intranet
      initContainers:
      - name: isoloom-probe
        image: busybox:1.37.0-musl
        command:
        - /bin/cp
        - /bin/busybox
        - /probe/busybox
        volumeMounts:
        - name: isoloom-probe
          mountPath: /probe
      containers:
      - name: intranet
        image: nginx:1.27-alpine
        imagePullPolicy: IfNotPresent
        ports:
        - containerPort: 80
        readinessProbe:
          exec:
            command:
            - /.isoloom-probe/busybox
            - sh
            - -c
            - /.isoloom-probe/busybox nc -z -w 2 127.0.0.1 80
          periodSeconds: 5
          failureThreshold: 60
        volumeMounts:
        - name: isoloom-probe
          mountPath: /.isoloom-probe
          readOnly: true
      nodeSelector:
        kubernetes.io/arch: amd64
      volumes:
      - name: isoloom-probe
        emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: intranet
spec:
  selector:
    isoloom.com/machine: intranet
  ports:
  - name: p80
    port: 80
    targetPort: 80
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: offline-intranet
spec:
  podSelector:
    matchLabels:
      isoloom.com/machine: intranet
  policyTypes:
  - Egress
  egress:
  - to:
    - podSelector: {}
  - to:
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: kube-system
    ports:
    - port: 53
      protocol: UDP
    - port: 53
      protocol: TCP
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: staff
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      isoloom.com/machine: staff
  template:
    metadata:
      labels:
        isoloom.com/machine: staff
        net.isoloom.com/office-vlan10: member
    spec:
      hostname: staff
      containers:
      - name: staff
        image: debian:12@sha256:2c037a04925515fdd6ea85ea14a682d0e79931f5e9f5d07b6dbfc6ba12f9e858
        imagePullPolicy: IfNotPresent
        command:
        - sleep
        - infinity
      nodeSelector:
        kubernetes.io/arch: amd64
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: offline-staff
spec:
  podSelector:
    matchLabels:
      isoloom.com/machine: staff
  policyTypes:
  - Egress
  egress:
  - to:
    - podSelector: {}
  - to:
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: kube-system
    ports:
    - port: 53
      protocol: UDP
    - port: 53
      protocol: TCP
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: guest
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      isoloom.com/machine: guest
  template:
    metadata:
      labels:
        isoloom.com/machine: guest
        net.isoloom.com/office-vlan20: member
    spec:
      hostname: guest
      containers:
      - name: guest
        image: debian:12@sha256:2c037a04925515fdd6ea85ea14a682d0e79931f5e9f5d07b6dbfc6ba12f9e858
        imagePullPolicy: IfNotPresent
        command:
        - sleep
        - infinity
      nodeSelector:
        kubernetes.io/arch: amd64
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: admin
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      isoloom.com/machine: admin
  template:
    metadata:
      labels:
        isoloom.com/machine: admin
        net.isoloom.com/office-vlan10: member
        net.isoloom.com/office-vlan20: member
    spec:
      hostname: admin
      containers:
      - name: admin
        image: debian:12@sha256:2c037a04925515fdd6ea85ea14a682d0e79931f5e9f5d07b6dbfc6ba12f9e858
        imagePullPolicy: IfNotPresent
        command:
        - sleep
        - infinity
      nodeSelector:
        kubernetes.io/arch: amd64
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: isoloom-default-deny
spec:
  podSelector: {}
  policyTypes:
  - Ingress
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: net-office-vlan10
spec:
  podSelector:
    matchLabels:
      net.isoloom.com/office-vlan10: member
  ingress:
  - from:
    - podSelector:
        matchLabels:
          net.isoloom.com/office-vlan10: member
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: net-office-vlan20
spec:
  podSelector:
    matchLabels:
      net.isoloom.com/office-vlan20: member
