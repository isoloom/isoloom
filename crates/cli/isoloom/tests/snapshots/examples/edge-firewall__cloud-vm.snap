---
source: crates/cli/isoloom/tests/example_snapshots.rs
---
# isoloom targets
✓ cloud-vm
    ✗ digitalocean (DigitalOcean cloud-vm takes one machine on one network: a droplet joins one VPC, at a private address DigitalOcean picks, so other machines couldn't reach it at its spec address)
    ✗ linode (machine `fw` is on several networks: a Linode instance has one VPC interface)

# isoloom generate --target cloud-vm (exit 0)
✓ .isoloom/cloud-vm/aws/main.tf
✓ .isoloom/cloud-vm/azure/main.tf
✓ .isoloom/cloud-vm/gcp/main.tf
✓ .isoloom/cloud-vm/oci/main.tf
✓ .isoloom/cloud-vm/checks/user.sh
✓ .isoloom/cloud-vm/checks/fw.sh
✓ .isoloom/cloud-vm/checks/web.sh
✓ .isoloom/cloud-vm/checks/cache.sh
✓ .isoloom/cloud-vm/aws/run.json
✓ .isoloom/cloud-vm/azure/run.json
✓ .isoloom/cloud-vm/gcp/run.json
✓ .isoloom/cloud-vm/oci/run.json
✓ .isoloom/resolved.json

## .isoloom/cloud-vm/aws/main.tf
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  terraform -chdir=.isoloom/cloud-vm/aws init && terraform -chdir=.isoloom/cloud-vm/aws apply \
#           -var allowed_cidr=<your IP>/32 -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)"
# Stop:   terraform -chdir=.isoloom/cloud-vm/aws destroy (same variables)
# Then:   the machines wait for the project: run the lab through the Isothrum runner (run.json
#         beside this file), which delivers the project over SSH, waits for each set-up and runs the checks.

terraform {
  required_version = ">= 1.6"
  backend "local" {}
  required_providers {
    aws = { source = "hashicorp/aws", version = "~> 6.67.0" }
  }
}

variable "region" {
  type    = string
  default = "eu-west-3"
}

variable "isoloom_sealed" {
  type        = bool
  default     = false
  description = "Close the internet to the machines of every `internet: false` network, at the network: the runner sets it once the machines are set up"
}

variable "allowed_cidr" {
  type        = string
  description = "Who may reach the machines (SSH and the published ports), e.g. your IP/32"
}

variable "ssh_public_key" {
  type        = string
  description = "The key the machines let in: the Isothrum runner's (it delivers the project and runs the checks over SSH)"
}

variable "expires_at" {
  type        = string
  default     = ""
  description = "When the environment should end, in Unix seconds (empty: no end): a tag on every resource, so a reaper finds what to destroy, and the time the machines shut themselves down"
}

provider "aws" {
  region = var.region
  default_tags {
    tags = {
      isoloom-environment = "edge-firewall"
      managed-by          = "isoloom"
      isoloom-instance    = local.name
      isoloom-expires-at  = var.expires_at
    }
  }
}

resource "terraform_data" "id" {
  input = substr(replace(uuid(), "-", ""), 0, 8)
  lifecycle {
    ignore_changes = [input]
  }
}

locals {
  name = "isoloom-edge-firewall-${terraform_data.id.output}"
}

data "aws_availability_zones" "available" {
  state = "available"
}

# The environment's networks: one VPC, a subnet per network with its exact range.
resource "aws_vpc" "env" {
  cidr_block = "10.70.0.0/19"
  tags       = { Name = local.name }
}

resource "aws_internet_gateway" "env" {
  vpc_id = aws_vpc.env.id
}

# A route table per network: the networks a machine routes go through its interface.
resource "aws_route_table" "outside" {
  vpc_id = aws_vpc.env.id
  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.env.id
  }
  route {
    cidr_block           = "10.70.10.0/24"
    network_interface_id = aws_network_interface.fw_outside.id
  }
  route {
    cidr_block           = "10.70.20.0/24"
    network_interface_id = aws_network_interface.fw_outside.id
  }
}

resource "aws_route_table" "dmz" {
  vpc_id = aws_vpc.env.id
  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.env.id
  }
  route {
    cidr_block           = "10.70.0.0/24"
    network_interface_id = aws_network_interface.fw_dmz.id
  }
  route {
    cidr_block           = "10.70.20.0/24"
    network_interface_id = aws_network_interface.fw_dmz.id
  }
}

resource "aws_route_table" "lan" {
  vpc_id = aws_vpc.env.id
  route {
    cidr_block = var.isoloom_sealed ? var.allowed_cidr : "0.0.0.0/0"
    gateway_id = aws_internet_gateway.env.id
  }
  route {
    cidr_block           = "10.70.0.0/24"
    network_interface_id = aws_network_interface.fw_lan.id
  }
  route {
    cidr_block           = "10.70.10.0/24"
    network_interface_id = aws_network_interface.fw_lan.id
  }
}

resource "aws_subnet" "outside" {
  vpc_id            = aws_vpc.env.id
  cidr_block        = "10.70.0.0/24"
  availability_zone = data.aws_availability_zones.available.names[0]
  tags              = { Name = "${local.name}-outside" }
}

resource "aws_route_table_association" "outside" {
  subnet_id      = aws_subnet.outside.id
  route_table_id = aws_route_table.outside.id
}

resource "aws_subnet" "dmz" {
  vpc_id            = aws_vpc.env.id
  cidr_block        = "10.70.10.0/24"
  availability_zone = data.aws_availability_zones.available.names[0]
  tags              = { Name = "${local.name}-dmz" }
}

resource "aws_route_table_association" "dmz" {
  subnet_id      = aws_subnet.dmz.id
  route_table_id = aws_route_table.dmz.id
}

resource "aws_subnet" "lan" {
  vpc_id            = aws_vpc.env.id
  cidr_block        = "10.70.20.0/24"
  availability_zone = data.aws_availability_zones.available.names[0]
  tags              = { Name = "${local.name}-lan" }
}

resource "aws_route_table_association" "lan" {
  subnet_id      = aws_subnet.lan.id
  route_table_id = aws_route_table.lan.id
}

resource "aws_key_pair" "env" {
  key_name   = local.name
  public_key = var.ssh_public_key
}

data "aws_ami" "debian_12" {
  most_recent = true
  owners      = ["136693071363"]
  filter {
    name   = "name"
    values = ["debian-12-amd64-*"]
  }
  filter {
    name   = "architecture"
    values = ["x86_64"]
  }
}

# Machine `fw`: what may reach it.
resource "aws_security_group" "fw" {
  name   = "${local.name}-fw"
  vpc_id = aws_vpc.env.id
  ingress {
    description = "its network (outside)"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["10.70.0.0/24"]
  }
  ingress {
    description = "its network (dmz)"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["10.70.10.0/24"]
  }
  ingress {
    description = "its network (lan)"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["10.70.20.0/24"]
  }
  ingress {
    description = "SSH from allowed_cidr"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [var.allowed_cidr]
  }
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_network_interface" "fw_outside" {
  subnet_id         = aws_subnet.outside.id
  private_ips       = ["10.70.0.5"]
  security_groups   = [aws_security_group.fw.id]
  source_dest_check = false
  tags              = { Name = "${local.name}-fw-outside" }
}

resource "aws_network_interface" "fw_dmz" {
  subnet_id         = aws_subnet.dmz.id
  private_ips       = ["10.70.10.254"]
  security_groups   = [aws_security_group.fw.id]
  source_dest_check = false
  tags              = { Name = "${local.name}-fw-dmz" }
}

resource "aws_network_interface" "fw_lan" {
  subnet_id         = aws_subnet.lan.id
  private_ips       = ["10.70.20.254"]
  security_groups   = [aws_security_group.fw.id]
  source_dest_check = false
  tags              = { Name = "${local.name}-fw-lan" }
}

resource "aws_instance" "fw" {
  ami              = data.aws_ami.debian_12.id
  instance_type    = "t3.micro"
  user_data_base64 = base64gzip("#!/bin/sh\n# Isoloom: this machine sets itself up. Its progress is in /var/lib/isoloom/ready (isoloom-ready/1), its output in /var/log/isoloom-setup.log. The Isothrum runner delivers the project over SSH.\nmkdir -p /var/lib/isoloom\ncat > /var/lib/isoloom/setup.sh.new <<'ISOLOOM_SETUP'\n#!/bin/sh\numask 022\ncase \"$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\" in ready|failed:*) exit 0 ;; esac\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\npart=$(cat /var/lib/isoloom/part 2>/dev/null || echo 1)\nif [ \"$part\" = 1 ]; then\necho 'running: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; { i=0; until [ -f /var/lib/isoloom/project-delivered ]; do i=$((i+5)); if [ $i -gt 2400 ]; then echo 'the project never came: start the lab through the Isothrum runner (run.json), which delivers it over SSH' >&2; exit 1; fi; sleep 5; done; } || { echo 'failed: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; exit 1; }\necho 'running: the machine'\\''s interfaces' > /var/lib/isoloom/ready; { IF=$(ip -o link | grep -i \"${lower(aws_network_interface.fw_dmz.mac_address)}\" | awk -F': ' '{print $2}'); sudo ip link set \"$IF\" up && (ip -4 addr show \"$IF\" | grep -q 10.70.10.254/ || sudo ip addr add 10.70.10.254/24 dev \"$IF\"); } || { echo 'failed: the machine'\\''s interfaces' > /var/lib/isoloom/ready; exit 1; }\necho 'running: the machine'\\''s interfaces' > /var/lib/isoloom/ready; { IF=$(ip -o link | grep -i \"${lower(aws_network_interface.fw_lan.mac_address)}\" | awk -F': ' '{print $2}'); sudo ip link set \"$IF\" up && (ip -4 addr show \"$IF\" | grep -q 10.70.20.254/ || sudo ip addr add 10.70.20.254/24 dev \"$IF\"); } || { echo 'failed: the machine'\\''s interfaces' > /var/lib/isoloom/ready; exit 1; }\necho 'running: the machine'\\''s interfaces' > /var/lib/isoloom/ready; { echo 'net.ipv4.ip_forward=1' | sudo tee /etc/sysctl.d/90-isoloom-forwarding.conf >/dev/null && sudo sysctl -q -p /etc/sysctl.d/90-isoloom-forwarding.conf; } || { echo 'failed: the machine'\\''s interfaces' > /var/lib/isoloom/ready; exit 1; }\necho 'running: hosts file' > /var/lib/isoloom/ready; { sh -c 'printf '\\''%s\\n'\\'' '\\''10.70.0.5 fw'\\'' '\\''10.70.10.10 web www.edge.test'\\'' '\\''10.70.20.20 cache'\\'' '\\''10.70.0.10 user'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'; } || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }\necho 'running: provision/fw.sh' > /var/lib/isoloom/ready; { sh -c 'cd /opt/isoloom && sh -c '\\''sh provision/fw.sh'\\'''; } || { echo 'failed: provision/fw.sh' > /var/lib/isoloom/ready; exit 1; }\necho 'running: health check' > /var/lib/isoloom/ready; { sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'; } || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }\nfi\necho ready > /var/lib/isoloom/ready\nrm -f /var/lib/isoloom/part\ncommand -v systemctl >/dev/null && systemctl disable isoloom-setup.service >/dev/null 2>&1\nexit 0\nISOLOOM_SETUP\nmv -f /var/lib/isoloom/setup.sh.new /var/lib/isoloom/setup.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-setup.service <<'ISOLOOM_UNIT'\n[Unit]\nDescription=Isoloom: the machine's set-up\nWants=network-online.target\nAfter=network-online.target cloud-final.service google-startup-scripts.service\n\n[Service]\nType=oneshot\nExecStart=/bin/sh /var/lib/isoloom/setup.sh\nStandardOutput=append:/var/log/isoloom-setup.log\nStandardError=append:/var/log/isoloom-setup.log\nTimeoutStartSec=0\n\n[Install]\nWantedBy=multi-user.target\nISOLOOM_UNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-setup.service >/dev/null 2>&1\nsystemctl start --no-block isoloom-setup.service\nelse\nnohup sh /var/lib/isoloom/setup.sh >> /var/log/isoloom-setup.log 2>&1 &\nfi\n")
  key_name         = aws_key_pair.env.key_name
  primary_network_interface {
    network_interface_id = aws_network_interface.fw_outside.id
  }
  root_block_device {
    volume_size = 20
  }
  tags = { Name = "${local.name}-fw" }
}

resource "aws_network_interface_attachment" "fw_dmz" {
  instance_id          = aws_instance.fw.id
  network_interface_id = aws_network_interface.fw_dmz.id
  device_index         = 1
}

resource "aws_network_interface_attachment" "fw_lan" {
  instance_id          = aws_instance.fw.id
  network_interface_id = aws_network_interface.fw_lan.id
  device_index         = 2
}

resource "aws_eip" "fw" {
  network_interface = aws_network_interface.fw_outside.id
  depends_on        = [aws_internet_gateway.env]
}

# Machine `web`: what may reach it.
resource "aws_security_group" "web" {
  name   = "${local.name}-web"
  vpc_id = aws_vpc.env.id
  ingress {
    description = "its network (dmz)"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["10.70.10.0/24"]
  }
  ingress {
    description = "SSH from allowed_cidr"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [var.allowed_cidr]
  }
  ingress {
    description = "reach from outside"
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["10.70.0.0/24"]
  }
  ingress {
    description = "reach from outside"
    from_port   = 80
    to_port     = 80
    protocol    = "udp"
    cidr_blocks = ["10.70.0.0/24"]
  }
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_instance" "web" {
  ami                         = data.aws_ami.debian_12.id
  instance_type               = "t3.micro"
  user_data_base64            = base64gzip("#!/bin/sh\n# Isoloom: this machine sets itself up. Its progress is in /var/lib/isoloom/ready (isoloom-ready/1), its output in /var/log/isoloom-setup.log. The Isothrum runner delivers the project over SSH.\nmkdir -p /var/lib/isoloom\ncat > /var/lib/isoloom/setup.sh.new <<'ISOLOOM_SETUP'\n#!/bin/sh\numask 022\ncase \"$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\" in ready|failed:*) exit 0 ;; esac\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\npart=$(cat /var/lib/isoloom/part 2>/dev/null || echo 1)\nif [ \"$part\" = 1 ]; then\necho 'running: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; { i=0; until [ -f /var/lib/isoloom/project-delivered ]; do i=$((i+5)); if [ $i -gt 2400 ]; then echo 'the project never came: start the lab through the Isothrum runner (run.json), which delivers it over SSH' >&2; exit 1; fi; sleep 5; done; } || { echo 'failed: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; exit 1; }\necho 'running: hosts file' > /var/lib/isoloom/ready; { sh -c 'printf '\\''%s\\n'\\'' '\\''10.70.10.254 fw'\\'' '\\''10.70.10.10 web www.edge.test'\\'' '\\''10.70.20.20 cache'\\'' '\\''10.70.0.10 user'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'; } || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }\necho 'running: provision/web.sh' > /var/lib/isoloom/ready; { sh -c 'cd /opt/isoloom && sh -c '\\''sh provision/web.sh'\\'''; } || { echo 'failed: provision/web.sh' > /var/lib/isoloom/ready; exit 1; }\necho 'running: health check' > /var/lib/isoloom/ready; { sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'; } || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }\nfi\necho ready > /var/lib/isoloom/ready\nrm -f /var/lib/isoloom/part\ncommand -v systemctl >/dev/null && systemctl disable isoloom-setup.service >/dev/null 2>&1\nexit 0\nISOLOOM_SETUP\nmv -f /var/lib/isoloom/setup.sh.new /var/lib/isoloom/setup.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-setup.service <<'ISOLOOM_UNIT'\n[Unit]\nDescription=Isoloom: the machine's set-up\nWants=network-online.target\nAfter=network-online.target cloud-final.service google-startup-scripts.service\n\n[Service]\nType=oneshot\nExecStart=/bin/sh /var/lib/isoloom/setup.sh\nStandardOutput=append:/var/log/isoloom-setup.log\nStandardError=append:/var/log/isoloom-setup.log\nTimeoutStartSec=0\n\n[Install]\nWantedBy=multi-user.target\nISOLOOM_UNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-setup.service >/dev/null 2>&1\nsystemctl start --no-block isoloom-setup.service\nelse\nnohup sh /var/lib/isoloom/setup.sh >> /var/log/isoloom-setup.log 2>&1 &\nfi\n")
  subnet_id                   = aws_subnet.dmz.id
  private_ip                  = "10.70.10.10"
  associate_public_ip_address = true
  key_name                    = aws_key_pair.env.key_name
  vpc_security_group_ids      = [aws_security_group.web.id]
  root_block_device {
    volume_size = 20
  }
  tags = { Name = "${local.name}-web" }
}

# Machine `cache`: what may reach it.
resource "aws_security_group" "cache" {
  name   = "${local.name}-cache"
  vpc_id = aws_vpc.env.id
  ingress {
    description = "its network (lan)"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["10.70.20.0/24"]
  }
  ingress {
    description = "SSH from allowed_cidr"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [var.allowed_cidr]
  }
  ingress {
    description = "reach from dmz"
    from_port   = 6379
    to_port     = 6379
    protocol    = "tcp"
    cidr_blocks = ["10.70.10.0/24"]
  }
  ingress {
    description = "reach from dmz"
    from_port   = 6379
    to_port     = 6379
    protocol    = "udp"
    cidr_blocks = ["10.70.10.0/24"]
  }
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = var.isoloom_sealed ? ["10.70.0.0/24", "10.70.10.0/24", "10.70.20.0/24"] : ["0.0.0.0/0"]
  }
}

resource "aws_instance" "cache" {
  ami                         = data.aws_ami.debian_12.id
  instance_type               = "t3.micro"
  user_data_base64            = base64gzip("#!/bin/sh\n# Isoloom: this machine sets itself up. Its progress is in /var/lib/isoloom/ready (isoloom-ready/1), its output in /var/log/isoloom-setup.log. The Isothrum runner delivers the project over SSH.\nmkdir -p /var/lib/isoloom\ncat > /var/lib/isoloom/setup.sh.new <<'ISOLOOM_SETUP'\n#!/bin/sh\numask 022\ncase \"$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\" in ready|failed:*) exit 0 ;; esac\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\npart=$(cat /var/lib/isoloom/part 2>/dev/null || echo 1)\nif [ \"$part\" = 1 ]; then\necho 'running: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; { i=0; until [ -f /var/lib/isoloom/project-delivered ]; do i=$((i+5)); if [ $i -gt 2400 ]; then echo 'the project never came: start the lab through the Isothrum runner (run.json), which delivers it over SSH' >&2; exit 1; fi; sleep 5; done; } || { echo 'failed: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; exit 1; }\necho 'running: hosts file' > /var/lib/isoloom/ready; { sh -c 'printf '\\''%s\\n'\\'' '\\''10.70.20.254 fw'\\'' '\\''10.70.10.10 web www.edge.test'\\'' '\\''10.70.20.20 cache'\\'' '\\''10.70.0.10 user'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'; } || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }\necho 'running: provision/cache.sh' > /var/lib/isoloom/ready; { sh -c 'cd /opt/isoloom && sh -c '\\''sh provision/cache.sh'\\'''; } || { echo 'failed: provision/cache.sh' > /var/lib/isoloom/ready; exit 1; }\necho 'running: health check' > /var/lib/isoloom/ready; { sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'; } || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }\nfi\necho ready > /var/lib/isoloom/ready\nrm -f /var/lib/isoloom/part\ncommand -v systemctl >/dev/null && systemctl disable isoloom-setup.service >/dev/null 2>&1\nexit 0\nISOLOOM_SETUP\nmv -f /var/lib/isoloom/setup.sh.new /var/lib/isoloom/setup.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-setup.service <<'ISOLOOM_UNIT'\n[Unit]\nDescription=Isoloom: the machine's set-up\nWants=network-online.target\nAfter=network-online.target cloud-final.service google-startup-scripts.service\n\n[Service]\nType=oneshot\nExecStart=/bin/sh /var/lib/isoloom/setup.sh\nStandardOutput=append:/var/log/isoloom-setup.log\nStandardError=append:/var/log/isoloom-setup.log\nTimeoutStartSec=0\n\n[Install]\nWantedBy=multi-user.target\nISOLOOM_UNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-setup.service >/dev/null 2>&1\nsystemctl start --no-block isoloom-setup.service\nelse\nnohup sh /var/lib/isoloom/setup.sh >> /var/log/isoloom-setup.log 2>&1 &\nfi\n")
  subnet_id                   = aws_subnet.lan.id
  private_ip                  = "10.70.20.20"
  associate_public_ip_address = true
  key_name                    = aws_key_pair.env.key_name
  vpc_security_group_ids      = [aws_security_group.cache.id]
  root_block_device {
    volume_size = 20
  }
  tags = { Name = "${local.name}-cache" }
}

# Machine `user`: what may reach it.
resource "aws_security_group" "user" {
  name   = "${local.name}-user"
  vpc_id = aws_vpc.env.id
  ingress {
    description = "its network (outside)"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["10.70.0.0/24"]
  }
  ingress {
    description = "SSH from allowed_cidr"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [var.allowed_cidr]
  }
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_instance" "user" {
  ami                         = data.aws_ami.debian_12.id
  instance_type               = "t3.micro"
  user_data_base64            = base64gzip("#!/bin/sh\n# Isoloom: this machine sets itself up. Its progress is in /var/lib/isoloom/ready (isoloom-ready/1), its output in /var/log/isoloom-setup.log. The Isothrum runner delivers the project over SSH.\nmkdir -p /var/lib/isoloom\ncat > /var/lib/isoloom/setup.sh.new <<'ISOLOOM_SETUP'\n#!/bin/sh\numask 022\ncase \"$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\" in ready|failed:*) exit 0 ;; esac\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\npart=$(cat /var/lib/isoloom/part 2>/dev/null || echo 1)\nif [ \"$part\" = 1 ]; then\necho 'running: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; { i=0; until [ -f /var/lib/isoloom/project-delivered ]; do i=$((i+5)); if [ $i -gt 2400 ]; then echo 'the project never came: start the lab through the Isothrum runner (run.json), which delivers it over SSH' >&2; exit 1; fi; sleep 5; done; } || { echo 'failed: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; exit 1; }\necho 'running: hosts file' > /var/lib/isoloom/ready; { sh -c 'printf '\\''%s\\n'\\'' '\\''10.70.0.5 fw'\\'' '\\''10.70.10.10 web www.edge.test'\\'' '\\''10.70.20.20 cache'\\'' '\\''10.70.0.10 user'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'; } || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }\necho 'running: health check' > /var/lib/isoloom/ready; { sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'; } || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }\nfi\necho ready > /var/lib/isoloom/ready\nrm -f /var/lib/isoloom/part\ncommand -v systemctl >/dev/null && systemctl disable isoloom-setup.service >/dev/null 2>&1\nexit 0\nISOLOOM_SETUP\nmv -f /var/lib/isoloom/setup.sh.new /var/lib/isoloom/setup.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-setup.service <<'ISOLOOM_UNIT'\n[Unit]\nDescription=Isoloom: the machine's set-up\nWants=network-online.target\nAfter=network-online.target cloud-final.service google-startup-scripts.service\n\n[Service]\nType=oneshot\nExecStart=/bin/sh /var/lib/isoloom/setup.sh\nStandardOutput=append:/var/log/isoloom-setup.log\nStandardError=append:/var/log/isoloom-setup.log\nTimeoutStartSec=0\n\n[Install]\nWantedBy=multi-user.target\nISOLOOM_UNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-setup.service >/dev/null 2>&1\nsystemctl start --no-block isoloom-setup.service\nelse\nnohup sh /var/lib/isoloom/setup.sh >> /var/log/isoloom-setup.log 2>&1 &\nfi\n")
  subnet_id                   = aws_subnet.outside.id
  private_ip                  = "10.70.0.10"
  associate_public_ip_address = true
  key_name                    = aws_key_pair.env.key_name
  vpc_security_group_ids      = [aws_security_group.user.id]
  root_block_device {
    volume_size = 20
  }
  tags = { Name = "${local.name}-user" }
}

output "machines" {
  value = {
    fw    = aws_eip.fw.public_ip
    web   = aws_instance.web.public_ip
    cache = aws_instance.cache.public_ip
    user  = aws_instance.user.public_ip
  }
}

output "address_fw" {
  value = aws_eip.fw.public_ip
}

output "address_web" {
  value = aws_instance.web.public_ip
}

output "address_cache" {
  value = aws_instance.cache.public_ip
}

output "address_user" {
  value = aws_instance.user.public_ip
}

output "ssh_users" {
  value = { fw = "admin", web = "admin", cache = "admin", user = "admin" }
}

output "ip" {
  value = aws_instance.user.public_ip
}

output "ready_file" {
  value = "/var/lib/isoloom/ready"
}

# The checks: each runner on the machine it stands for (ssh <user>@<host> '<command>'), or `isoloom test cloud-vm`.
output "checks" {
  value = [
    {
      position = "user"
      machine  = "user"
      host     = aws_instance.user.public_ip
      user     = "admin"
      command  = "cd /opt/isoloom && sh .isoloom/cloud-vm/checks/user.sh"
    },
    {
      position = "fw"
      machine  = "fw"
      host     = aws_eip.fw.public_ip
      user     = "admin"
      command  = "cd /opt/isoloom && sh .isoloom/cloud-vm/checks/fw.sh"
    },
    {
      position = "web"
      machine  = "web"
      host     = aws_instance.web.public_ip
      user     = "admin"
      command  = "cd /opt/isoloom && sh .isoloom/cloud-vm/checks/web.sh"
    },
    {
      position = "cache"
      machine  = "cache"
      host     = aws_instance.cache.public_ip
      user     = "admin"
      command  = "cd /opt/isoloom && sh .isoloom/cloud-vm/checks/cache.sh"
    }
  ]
}

## .isoloom/cloud-vm/aws/run.json
{
  "$schema": "https://www.isoloom.com/schema/run-manifest/v0.json",
  "manifest_version": 0,
  "generator": {
    "name": "isoloom",
    "version": "0.11.0"
  },
  "lab": {
    "name": "edge-firewall",
    "instance": null,
    "message": null
  },
  "target": "cloud-vm",
  "cloud": "aws",
  "driver": "terraform",
  "hosts": [
    "linux",
    "macos",
    "windows"
  ],
  "tools": [
    {
      "name": "terraform",
      "probe": [
        "terraform",
        "version"
      ],
      "min_version": "1.11.0"
    },
    {
      "name": "ssh",
      "probe": [
        "ssh",
        "-V"
      ]
    }
  ],
  "identity": {
    "terraform": {
      "module": ".",
      "state": "runner"
    }
  },
  "params": [
    {
      "name": "region",
      "description": "The module's `region`.",
      "default": "eu-west-3",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "region"
        }
      ]
    },
    {
      "name": "allowed_cidr",
      "description": "Who may reach the machines (SSH and the published ports), e.g. your IP/32.",
      "required": true,
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "allowed_cidr"
        }
      ]
    },
    {
      "name": "AWS_PROFILE",
      "description": "The AWS CLI profile the provider signs in with (its credentials and settings), when no keys are given.",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "AWS_PROFILE",
          "steps": [
            "init",
            "apply",
            "destroy",
            "seal"
          ]
        }
      ]
    },
    {
      "name": "isoloom_sealed",
      "description": "true once the machines are set up: the internet is closed to the `internet: false` networks, at the network.",
      "default": "false",
      "values": [
        "true",
        "false"
      ],
      "set_by": "runner",
      "deliver": [
        {
          "via": "tf_var",
          "var": "isoloom_sealed"
        }
      ]
    },
    {
      "name": "ISOLOOM_DERIVED",
      "description": "0: the checks derived from the spec (reachability, no internet) are skipped.",
      "default": "1",
      "values": [
        "0",
        "1"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_DERIVED",
          "steps": [
            "check-user",
            "check-fw",
            "check-web",
            "check-cache"
          ]
        }
      ]
    }
  ],
  "secrets": [
    {
      "name": "AWS_ACCESS_KEY_ID",
      "kind": "connection",
      "required": false,
      "sensitive": true,
      "source": {
        "store": "env",
        "reference": "AWS_ACCESS_KEY_ID"
      },
      "deliver": [
        {
          "via": "env",
          "var": "AWS_ACCESS_KEY_ID",
          "steps": [
            "init",
            "apply",
            "destroy",
            "seal"
          ]
        }
      ]
    },
    {
      "name": "AWS_SECRET_ACCESS_KEY",
      "kind": "connection",
      "required": false,
      "sensitive": true,
      "source": {
        "store": "env",
        "reference": "AWS_SECRET_ACCESS_KEY"
      },
      "deliver": [
        {
          "via": "env",
          "var": "AWS_SECRET_ACCESS_KEY",
          "steps": [
            "init",
            "apply",
            "destroy",
            "seal"
          ]
        }
      ]
    },
    {
      "name": "AWS_SESSION_TOKEN",
      "kind": "connection",
      "required": false,
      "sensitive": true,
      "source": {
        "store": "env",
        "reference": "AWS_SESSION_TOKEN"
      },
      "deliver": [
        {
          "via": "env",
          "var": "AWS_SESSION_TOKEN",
          "steps": [
            "init",
            "apply",
            "destroy",
            "seal"
          ]
        }
      ]
    }
  ],
  "networks": [
    {
      "name": "outside",
      "cidr": "10.70.0.0/24",
      "internet": true,
      "native": "outside"
    },
    {
      "name": "dmz",
      "cidr": "10.70.10.0/24",
      "internet": true,
      "native": "dmz"
    },
    {
      "name": "lan",
      "cidr": "10.70.20.0/24",
      "internet": false,
      "native": "lan"
    }
  ],
  "machines": [
    {
      "name": "fw",
      "role": "target",
      "os": "debian-12",
      "arch": "amd64",
      "addresses": {
        "dmz": "10.70.10.1",
        "lan": "10.70.20.1",
        "outside": "10.70.0.5"
      },
      "ports": [
        {
          "name": "status",
          "port": 8080,
          "protocol": "tcp",
          "http": true
        }
      ]
    },
    {
      "name": "web",
      "role": "target",
      "os": "debian-12",
      "arch": "amd64",
      "addresses": {
        "dmz": "10.70.10.10"
      },
      "ports": [
        {
          "name": "web",
          "port": 80,
          "protocol": "tcp",
          "http": true
        }
      ]
    },
    {
      "name": "cache",
      "role": "target",
      "os": "debian-12",
      "arch": "amd64",
      "addresses": {
        "lan": "10.70.20.20"
      },
      "ports": [
        {
          "name": "redis",
          "port": 6379,
          "protocol": "tcp",
          "http": false
        }
      ]
    },
    {
      "name": "user",
      "role": "target",
      "os": "debian-12",
      "arch": "amd64",
      "addresses": {
        "outside": "10.70.0.10"
      }
    }
  ],
  "lifecycle": {
    "up": [
      {
        "id": "clear-lock",
        "action": "terraform.clear_lock"
      },
      {
        "id": "init",
        "note": "Preparing Terraform and its providers…",
        "argv": [
          "terraform",
          "init",
          "-input=false",
          "-no-color",
          "-backend-config=path=${run.state_dir}/terraform.tfstate"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 900
      },
      {
        "id": "apply",
        "note": "Creating the lab's machines in the cloud…",
        "argv": [
          "terraform",
          "apply",
          "-auto-approve",
          "-input=false",
          "-no-color"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 3600
      },
      {
        "id": "archive",
        "note": "Archiving the project…",
        "action": "project.archive",
        "with": {
          "root": "../../.."
        }
      },
      {
        "id": "deliver-fw",
        "note": "Copying the project into fw…",
        "action": "ssh.run",
        "with": {
          "command": "sudo sh -c 'mkdir -p /opt/isoloom /var/lib/isoloom && tar -xzf - -C /opt/isoloom && touch /var/lib/isoloom/project-delivered'",
          "host": "${outputs.address_fw}",
          "user": "admin",
          "wait_s": "900"
        },
        "stdin": "${run.state_dir}/project.tgz",
        "timeout_s": 1500
      },
      {
        "id": "deliver-web",
        "note": "Copying the project into web…",
        "action": "ssh.run",
        "with": {
          "command": "sudo sh -c 'mkdir -p /opt/isoloom /var/lib/isoloom && tar -xzf - -C /opt/isoloom && touch /var/lib/isoloom/project-delivered'",
          "host": "${outputs.address_web}",
          "user": "admin",
          "wait_s": "900"
        },
        "stdin": "${run.state_dir}/project.tgz",
        "timeout_s": 1500
      },
      {
        "id": "deliver-cache",
        "note": "Copying the project into cache…",
        "action": "ssh.run",
        "with": {
          "command": "sudo sh -c 'mkdir -p /opt/isoloom /var/lib/isoloom && tar -xzf - -C /opt/isoloom && touch /var/lib/isoloom/project-delivered'",
          "host": "${outputs.address_cache}",
          "user": "admin",
          "wait_s": "900"
        },
        "stdin": "${run.state_dir}/project.tgz",
        "timeout_s": 1500
      },
      {
        "id": "deliver-user",
        "note": "Copying the project into user…",
        "action": "ssh.run",
        "with": {
          "command": "sudo sh -c 'mkdir -p /opt/isoloom /var/lib/isoloom && tar -xzf - -C /opt/isoloom && touch /var/lib/isoloom/project-delivered'",
          "host": "${outputs.address_user}",
          "user": "admin",
          "wait_s": "900"
        },
        "stdin": "${run.state_dir}/project.tgz",
        "timeout_s": 1500
      }
    ],
    "down": [
      {
        "id": "clear-lock",
        "action": "terraform.clear_lock"
      },
      {
        "id": "init",
        "note": "Preparing Terraform and its providers…",
        "argv": [
          "terraform",
          "init",
          "-input=false",
          "-no-color",
          "-backend-config=path=${run.state_dir}/terraform.tfstate"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 900
      },
      {
        "id": "destroy",
        "note": "Removing the lab from the cloud…",
        "argv": [
          "terraform",
          "destroy",
          "-auto-approve",
          "-input=false",
          "-no-color"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 3600
      }
    ],
    "seal": {
      "param": "isoloom_sealed",
      "steps": [
        {
          "id": "seal",
          "note": "Closing the internet to the networks without it…",
          "argv": [
            "terraform",
            "apply",
            "-auto-approve",
            "-input=false",
            "-no-color"
          ],
          "env": {
            "TF_DATA_DIR": "${run.state_dir}/.terraform",
            "TF_INPUT": "0",
            "TF_IN_AUTOMATION": "1",
            "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
          },
          "timeout_s": 3600
        }
      ]
    },
    "status": {
      "id": "state",
      "action": "terraform.read_state"
    }
  },
  "ready": [
    {
      "kind": "step_ok",
      "step": "apply",
      "means": "the machines exist and booted; each sets itself up from its user data once the project is in"
    },
    {
      "kind": "ready_file",
      "host": "${outputs.address_fw}",
      "user": "admin",
      "path": "${outputs.ready_file}",
      "log": "/var/log/isoloom-setup.log",
      "grammar": "isoloom-ready/1",
      "timeout_s": 2400,
      "unreachable_timeout_s": 600,
      "interval_s": 10
    },
    {
      "kind": "ready_file",
      "host": "${outputs.address_web}",
      "user": "admin",
      "path": "${outputs.ready_file}",
      "log": "/var/log/isoloom-setup.log",
      "grammar": "isoloom-ready/1",
      "timeout_s": 2400,
      "unreachable_timeout_s": 600,
      "interval_s": 10
    },
    {
      "kind": "ready_file",
      "host": "${outputs.address_cache}",
      "user": "admin",
      "path": "${outputs.ready_file}",
      "log": "/var/log/isoloom-setup.log",
      "grammar": "isoloom-ready/1",
      "timeout_s": 2400,
      "unreachable_timeout_s": 600,
      "interval_s": 10
    },
    {
      "kind": "ready_file",
      "host": "${outputs.address_user}",
      "user": "admin",
      "path": "${outputs.ready_file}",
      "log": "/var/log/isoloom-setup.log",
      "grammar": "isoloom-ready/1",
      "timeout_s": 2400,
      "unreachable_timeout_s": 600,
      "interval_s": 10
    }
  ],
  "outputs": [
    {
      "name": "ip",
      "description": "Where to stand: the access machine's public address (the first Linux machine's, else the controller's).",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ip"
      }
    },
    {
      "name": "ready_file",
      "description": "Where each Linux machine's set-up says how far it got (isoloom-ready/1).",
      "role": "info",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ready_file"
      }
    },
    {
      "name": "address_fw",
      "description": "fw's public address: the runner's SSH and its published ports reach it there.",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "address_fw"
      }
    },
    {
      "name": "address_web",
      "description": "web's public address: the runner's SSH and its published ports reach it there.",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "address_web"
      }
    },
    {
      "name": "address_cache",
      "description": "cache's public address: the runner's SSH and its published ports reach it there.",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "address_cache"
      }
    },
    {
      "name": "address_user",
      "description": "user's public address: the runner's SSH and its published ports reach it there.",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "address_user"
      }
    }
  ],
  "checks": {
    "protocol": "isoloom-check/1",
    "setup": [],
    "runners": [
      {
        "id": "user",
        "from": "from user",
        "checks": [
          {
            "name": "the web page answers through the firewall",
            "kind": "script",
            "wait_s": 0,
            "derived": false
          },
          {
            "name": "the web server answers by its other name",
            "kind": "http",
            "wait_s": 30,
            "derived": false
          },
          {
            "name": "fw:8080 on outside from user",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "web:80 from user",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "cache:6379 blocked from user",
            "kind": "tcp",
            "wait_s": 0,
            "derived": true
          }
        ],
        "step": {
          "id": "check-user",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} sh .isoloom/cloud-vm/checks/user.sh",
            "host": "${outputs.address_user}",
            "user": "admin"
          },
          "timeout_s": 225
        }
      },
      {
        "id": "fw",
        "from": "from fw",
        "checks": [
          {
            "name": "web:80 from fw",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "cache:6379 from fw",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          }
        ],
        "step": {
          "id": "check-fw",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} sh .isoloom/cloud-vm/checks/fw.sh",
            "host": "${outputs.address_fw}",
            "user": "admin"
          },
          "timeout_s": 150
        }
      },
      {
        "id": "web",
        "from": "from web",
        "checks": [
          {
            "name": "fw:8080 on dmz from web",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "cache:6379 from web",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          }
        ],
        "step": {
          "id": "check-web",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} sh .isoloom/cloud-vm/checks/web.sh",
            "host": "${outputs.address_web}",
            "user": "admin"
          },
          "timeout_s": 150
        }
      },
      {
        "id": "cache",
        "from": "from cache",
        "checks": [
          {
            "name": "fw:8080 on lan from cache",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "web:80 blocked from cache",
            "kind": "tcp",
            "wait_s": 0,
            "derived": true
          },
          {
            "name": "no internet from cache",
            "kind": "http",
            "wait_s": 0,
            "derived": true
          }
        ],
        "step": {
          "id": "check-cache",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} sh .isoloom/cloud-vm/checks/cache.sh",
            "host": "${outputs.address_cache}",
            "user": "admin"
          },
          "timeout_s": 135
        }
      }
    ],
    "teardown": []
  },
  "recovery": {
    "retries": 0,
    "apply_retries": 1
  },
  "expiry": {
    "tf_var": "expires_at",
    "unit": "unix_seconds",
    "default_minutes": 240
  }
}

## .isoloom/cloud-vm/azure/main.tf
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  terraform -chdir=.isoloom/cloud-vm/azure init && terraform -chdir=.isoloom/cloud-vm/azure apply \
#           -var allowed_cidr=<your IP>/32 -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)"
# Stop:   terraform -chdir=.isoloom/cloud-vm/azure destroy (same variables)
# Then:   the machines wait for the project: run the lab through the Isothrum runner (run.json
#         beside this file), which delivers the project over SSH, waits for each set-up and runs the checks.

terraform {
  required_version = ">= 1.6"
  backend "local" {}
  required_providers {
    azurerm = { source = "hashicorp/azurerm", version = "~> 5.8.0" }
  }
}

variable "subscription_id" {
  type        = string
  default     = null
  description = "Default: ARM_SUBSCRIPTION_ID from the environment"
}

variable "region" {
  type    = string
  default = "swedencentral"
}

variable "isoloom_sealed" {
  type        = bool
  default     = false
  description = "Close the internet to the machines of every `internet: false` network, at the network: the runner sets it once the machines are set up"
}

variable "allowed_cidr" {
  type        = string
  description = "Who may reach the machines (SSH and the published ports), e.g. your IP/32"
}

variable "ssh_public_key" {
  type        = string
  description = "The key the machines let in: the Isothrum runner's (it delivers the project and runs the checks over SSH)"
}

variable "expires_at" {
  type        = string
  default     = ""
  description = "When the environment should end, in Unix seconds (empty: no end): a tag on every resource, so a reaper finds what to destroy, and the time the machines shut themselves down"
}

provider "azurerm" {
  features {}
  subscription_id = var.subscription_id
}

resource "terraform_data" "id" {
  input = substr(replace(uuid(), "-", ""), 0, 8)
  lifecycle {
    ignore_changes = [input]
  }
}

locals {
  name = "isoloom-edge-firewall-${terraform_data.id.output}"
  tags = {
    isoloom-environment = "edge-firewall"
    managed-by          = "isoloom"
    isoloom-instance    = local.name
    isoloom-expires-at  = var.expires_at
  }
}

resource "azurerm_resource_group" "env" {
  name     = local.name
  location = var.region
  tags     = local.tags
}

# The environment's networks: one virtual network, a subnet per network with its exact range.
resource "azurerm_virtual_network" "env" {
  name                = local.name
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  address_space       = ["10.70.0.0/24", "10.70.10.0/24", "10.70.20.0/24"]
}

resource "azurerm_subnet" "outside" {
  name                            = "outside"
  resource_group_name             = azurerm_resource_group.env.name
  virtual_network_name            = azurerm_virtual_network.env.name
  address_prefixes                = ["10.70.0.0/24"]
  default_outbound_access_enabled = true
}

resource "azurerm_subnet" "dmz" {
  name                            = "dmz"
  resource_group_name             = azurerm_resource_group.env.name
  virtual_network_name            = azurerm_virtual_network.env.name
  address_prefixes                = ["10.70.10.0/24"]
  default_outbound_access_enabled = true
}

resource "azurerm_subnet" "lan" {
  name                            = "lan"
  resource_group_name             = azurerm_resource_group.env.name
  virtual_network_name            = azurerm_virtual_network.env.name
  address_prefixes                = ["10.70.20.0/24"]
  default_outbound_access_enabled = false
}

# A route table per network: the networks a machine routes go through its address.
resource "azurerm_route_table" "outside" {
  name                = "${local.name}-outside"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
}

resource "azurerm_route" "outside_dmz" {
  name                   = "to-dmz"
  resource_group_name    = azurerm_resource_group.env.name
  route_table_name       = azurerm_route_table.outside.name
  address_prefix         = "10.70.10.0/24"
  next_hop_type          = "VirtualAppliance"
  next_hop_in_ip_address = "10.70.0.5"
}

resource "azurerm_route" "outside_lan" {
  name                   = "to-lan"
  resource_group_name    = azurerm_resource_group.env.name
  route_table_name       = azurerm_route_table.outside.name
  address_prefix         = "10.70.20.0/24"
  next_hop_type          = "VirtualAppliance"
  next_hop_in_ip_address = "10.70.0.5"
}

resource "azurerm_subnet_route_table_association" "outside" {
  subnet_id      = azurerm_subnet.outside.id
  route_table_id = azurerm_route_table.outside.id
}

resource "azurerm_route_table" "dmz" {
  name                = "${local.name}-dmz"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
}

resource "azurerm_route" "dmz_outside" {
  name                   = "to-outside"
  resource_group_name    = azurerm_resource_group.env.name
  route_table_name       = azurerm_route_table.dmz.name
  address_prefix         = "10.70.0.0/24"
  next_hop_type          = "VirtualAppliance"
  next_hop_in_ip_address = "10.70.10.254"
}

resource "azurerm_route" "dmz_lan" {
  name                   = "to-lan"
  resource_group_name    = azurerm_resource_group.env.name
  route_table_name       = azurerm_route_table.dmz.name
  address_prefix         = "10.70.20.0/24"
  next_hop_type          = "VirtualAppliance"
  next_hop_in_ip_address = "10.70.10.254"
}

resource "azurerm_subnet_route_table_association" "dmz" {
  subnet_id      = azurerm_subnet.dmz.id
  route_table_id = azurerm_route_table.dmz.id
}

resource "azurerm_route_table" "lan" {
  name                = "${local.name}-lan"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
}

resource "azurerm_route" "lan_outside" {
  name                   = "to-outside"
  resource_group_name    = azurerm_resource_group.env.name
  route_table_name       = azurerm_route_table.lan.name
  address_prefix         = "10.70.0.0/24"
  next_hop_type          = "VirtualAppliance"
  next_hop_in_ip_address = "10.70.20.254"
}

resource "azurerm_route" "lan_dmz" {
  name                   = "to-dmz"
  resource_group_name    = azurerm_resource_group.env.name
  route_table_name       = azurerm_route_table.lan.name
  address_prefix         = "10.70.10.0/24"
  next_hop_type          = "VirtualAppliance"
  next_hop_in_ip_address = "10.70.20.254"
}

resource "azurerm_subnet_route_table_association" "lan" {
  subnet_id      = azurerm_subnet.lan.id
  route_table_id = azurerm_route_table.lan.id
}

# Machine `fw`: what may reach it.
resource "azurerm_network_security_group" "fw" {
  name                = "${local.name}-fw"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  security_rule {
    name                       = "net-outside"
    priority                   = 100
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "10.70.0.0/24"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "net-dmz"
    priority                   = 110
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "10.70.10.0/24"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "net-lan"
    priority                   = 120
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "10.70.20.0/24"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "ssh"
    priority                   = 130
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_range     = "22"
    source_address_prefix      = var.allowed_cidr
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "deny-rest-of-vnet"
    priority                   = 4000
    direction                  = "Inbound"
    access                     = "Deny"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "VirtualNetwork"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "outbound"
    priority                   = 100
    direction                  = "Outbound"
    access                     = "Allow"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "*"
    destination_address_prefix = "*"
  }
}

resource "azurerm_public_ip" "fw" {
  name                = "${local.name}-fw"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  allocation_method   = "Static"
  sku                 = "Standard"
}

resource "azurerm_network_interface" "fw_outside" {
  name                  = "${local.name}-fw-outside"
  resource_group_name   = azurerm_resource_group.env.name
  location              = var.region
  tags                  = local.tags
  ip_forwarding_enabled = true
  ip_configuration {
    name                          = "primary"
    subnet_id                     = azurerm_subnet.outside.id
    private_ip_address_allocation = "Static"
    private_ip_address            = "10.70.0.5"
    public_ip_address_id          = azurerm_public_ip.fw.id
  }
}

resource "azurerm_network_interface_security_group_association" "fw_outside" {
  network_interface_id      = azurerm_network_interface.fw_outside.id
  network_security_group_id = azurerm_network_security_group.fw.id
}

resource "azurerm_network_interface" "fw_dmz" {
  name                  = "${local.name}-fw-dmz"
  resource_group_name   = azurerm_resource_group.env.name
  location              = var.region
  tags                  = local.tags
  ip_forwarding_enabled = true
  ip_configuration {
    name                          = "primary"
    subnet_id                     = azurerm_subnet.dmz.id
    private_ip_address_allocation = "Static"
    private_ip_address            = "10.70.10.254"
  }
}

resource "azurerm_network_interface_security_group_association" "fw_dmz" {
  network_interface_id      = azurerm_network_interface.fw_dmz.id
  network_security_group_id = azurerm_network_security_group.fw.id
}

resource "azurerm_network_interface" "fw_lan" {
  name                  = "${local.name}-fw-lan"
  resource_group_name   = azurerm_resource_group.env.name
  location              = var.region
  tags                  = local.tags
  ip_forwarding_enabled = true
  ip_configuration {
    name                          = "primary"
    subnet_id                     = azurerm_subnet.lan.id
    private_ip_address_allocation = "Static"
    private_ip_address            = "10.70.20.254"
  }
}

resource "azurerm_network_interface_security_group_association" "fw_lan" {
  network_interface_id      = azurerm_network_interface.fw_lan.id
  network_security_group_id = azurerm_network_security_group.fw.id
}

resource "azurerm_linux_virtual_machine" "fw" {
  name                = "${local.name}-fw"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  size                = "Standard_D8as_v5"
  admin_username      = "isoloom"
  network_interface_ids = [
    azurerm_network_interface.fw_outside.id,
    azurerm_network_interface.fw_dmz.id,
    azurerm_network_interface.fw_lan.id
  ]
  custom_data = base64encode("#!/bin/sh\n# Isoloom: this machine sets itself up. Its progress is in /var/lib/isoloom/ready (isoloom-ready/1), its output in /var/log/isoloom-setup.log. The Isothrum runner delivers the project over SSH.\nmkdir -p /var/lib/isoloom\ncat > /var/lib/isoloom/setup.sh.new <<'ISOLOOM_SETUP'\n#!/bin/sh\numask 022\ncase \"$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\" in ready|failed:*) exit 0 ;; esac\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\npart=$(cat /var/lib/isoloom/part 2>/dev/null || echo 1)\nif [ \"$part\" = 1 ]; then\necho 'running: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; { i=0; until [ -f /var/lib/isoloom/project-delivered ]; do i=$((i+5)); if [ $i -gt 2400 ]; then echo 'the project never came: start the lab through the Isothrum runner (run.json), which delivers it over SSH' >&2; exit 1; fi; sleep 5; done; } || { echo 'failed: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; exit 1; }\necho 'running: the machine'\\''s interfaces' > /var/lib/isoloom/ready; { IF=$(ip -o link | grep -i \"${lower(replace(azurerm_network_interface.fw_dmz.mac_address, "-", ":"))}\" | awk -F': ' '{print $2}'); sudo ip link set \"$IF\" up && (ip -4 addr show \"$IF\" | grep -q 10.70.10.254/ || sudo ip addr add 10.70.10.254/24 dev \"$IF\"); } || { echo 'failed: the machine'\\''s interfaces' > /var/lib/isoloom/ready; exit 1; }\necho 'running: the machine'\\''s interfaces' > /var/lib/isoloom/ready; { IF=$(ip -o link | grep -i \"${lower(replace(azurerm_network_interface.fw_lan.mac_address, "-", ":"))}\" | awk -F': ' '{print $2}'); sudo ip link set \"$IF\" up && (ip -4 addr show \"$IF\" | grep -q 10.70.20.254/ || sudo ip addr add 10.70.20.254/24 dev \"$IF\"); } || { echo 'failed: the machine'\\''s interfaces' > /var/lib/isoloom/ready; exit 1; }\necho 'running: the machine'\\''s interfaces' > /var/lib/isoloom/ready; { echo 'net.ipv4.ip_forward=1' | sudo tee /etc/sysctl.d/90-isoloom-forwarding.conf >/dev/null && sudo sysctl -q -p /etc/sysctl.d/90-isoloom-forwarding.conf; } || { echo 'failed: the machine'\\''s interfaces' > /var/lib/isoloom/ready; exit 1; }\necho 'running: hosts file' > /var/lib/isoloom/ready; { sh -c 'printf '\\''%s\\n'\\'' '\\''10.70.0.5 fw'\\'' '\\''10.70.10.10 web www.edge.test'\\'' '\\''10.70.20.20 cache'\\'' '\\''10.70.0.10 user'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'; } || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }\necho 'running: provision/fw.sh' > /var/lib/isoloom/ready; { sh -c 'cd /opt/isoloom && sh -c '\\''sh provision/fw.sh'\\'''; } || { echo 'failed: provision/fw.sh' > /var/lib/isoloom/ready; exit 1; }\necho 'running: health check' > /var/lib/isoloom/ready; { sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'; } || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }\nfi\necho ready > /var/lib/isoloom/ready\nrm -f /var/lib/isoloom/part\ncommand -v systemctl >/dev/null && systemctl disable isoloom-setup.service >/dev/null 2>&1\nexit 0\nISOLOOM_SETUP\nmv -f /var/lib/isoloom/setup.sh.new /var/lib/isoloom/setup.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-setup.service <<'ISOLOOM_UNIT'\n[Unit]\nDescription=Isoloom: the machine's set-up\nWants=network-online.target\nAfter=network-online.target cloud-final.service google-startup-scripts.service\n\n[Service]\nType=oneshot\nExecStart=/bin/sh /var/lib/isoloom/setup.sh\nStandardOutput=append:/var/log/isoloom-setup.log\nStandardError=append:/var/log/isoloom-setup.log\nTimeoutStartSec=0\n\n[Install]\nWantedBy=multi-user.target\nISOLOOM_UNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-setup.service >/dev/null 2>&1\nsystemctl start --no-block isoloom-setup.service\nelse\nnohup sh /var/lib/isoloom/setup.sh >> /var/log/isoloom-setup.log 2>&1 &\nfi\n")
  admin_ssh_key {
    username   = "isoloom"
    public_key = var.ssh_public_key
  }
  os_disk {
    caching              = "ReadWrite"
    storage_account_type = "StandardSSD_LRS"
    disk_size_gb         = 30
  }
  source_image_reference {
    publisher = "Debian"
    offer     = "debian-12"
    sku       = "12-gen2"
    version   = "latest"
  }
}

# Machine `web`: what may reach it.
resource "azurerm_network_security_group" "web" {
  name                = "${local.name}-web"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  security_rule {
    name                       = "net-dmz"
    priority                   = 100
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "10.70.10.0/24"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "ssh"
    priority                   = 110
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_range     = "22"
    source_address_prefix      = var.allowed_cidr
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "reach-0-outside-80-tcp"
    priority                   = 120
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_range     = "80"
    source_address_prefix      = "10.70.0.0/24"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "reach-0-outside-80-udp"
    priority                   = 130
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Udp"
    source_port_range          = "*"
    destination_port_range     = "80"
    source_address_prefix      = "10.70.0.0/24"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "deny-rest-of-vnet"
    priority                   = 4000
    direction                  = "Inbound"
    access                     = "Deny"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "VirtualNetwork"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "outbound"
    priority                   = 100
    direction                  = "Outbound"
    access                     = "Allow"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "*"
    destination_address_prefix = "*"
  }
}

resource "azurerm_public_ip" "web" {
  name                = "${local.name}-web"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  allocation_method   = "Static"
  sku                 = "Standard"
}

resource "azurerm_network_interface" "web_dmz" {
  name                = "${local.name}-web-dmz"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  ip_configuration {
    name                          = "primary"
    subnet_id                     = azurerm_subnet.dmz.id
    private_ip_address_allocation = "Static"
    private_ip_address            = "10.70.10.10"
    public_ip_address_id          = azurerm_public_ip.web.id
  }
}

resource "azurerm_network_interface_security_group_association" "web_dmz" {
  network_interface_id      = azurerm_network_interface.web_dmz.id
  network_security_group_id = azurerm_network_security_group.web.id
}

resource "azurerm_linux_virtual_machine" "web" {
  name                  = "${local.name}-web"
  resource_group_name   = azurerm_resource_group.env.name
  location              = var.region
  tags                  = local.tags
  size                  = "Standard_B2ts_v2"
  admin_username        = "isoloom"
  network_interface_ids = [azurerm_network_interface.web_dmz.id]
  custom_data           = base64encode("#!/bin/sh\n# Isoloom: this machine sets itself up. Its progress is in /var/lib/isoloom/ready (isoloom-ready/1), its output in /var/log/isoloom-setup.log. The Isothrum runner delivers the project over SSH.\nmkdir -p /var/lib/isoloom\ncat > /var/lib/isoloom/setup.sh.new <<'ISOLOOM_SETUP'\n#!/bin/sh\numask 022\ncase \"$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\" in ready|failed:*) exit 0 ;; esac\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\npart=$(cat /var/lib/isoloom/part 2>/dev/null || echo 1)\nif [ \"$part\" = 1 ]; then\necho 'running: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; { i=0; until [ -f /var/lib/isoloom/project-delivered ]; do i=$((i+5)); if [ $i -gt 2400 ]; then echo 'the project never came: start the lab through the Isothrum runner (run.json), which delivers it over SSH' >&2; exit 1; fi; sleep 5; done; } || { echo 'failed: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; exit 1; }\necho 'running: hosts file' > /var/lib/isoloom/ready; { sh -c 'printf '\\''%s\\n'\\'' '\\''10.70.10.254 fw'\\'' '\\''10.70.10.10 web www.edge.test'\\'' '\\''10.70.20.20 cache'\\'' '\\''10.70.0.10 user'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'; } || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }\necho 'running: provision/web.sh' > /var/lib/isoloom/ready; { sh -c 'cd /opt/isoloom && sh -c '\\''sh provision/web.sh'\\'''; } || { echo 'failed: provision/web.sh' > /var/lib/isoloom/ready; exit 1; }\necho 'running: health check' > /var/lib/isoloom/ready; { sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'; } || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }\nfi\necho ready > /var/lib/isoloom/ready\nrm -f /var/lib/isoloom/part\ncommand -v systemctl >/dev/null && systemctl disable isoloom-setup.service >/dev/null 2>&1\nexit 0\nISOLOOM_SETUP\nmv -f /var/lib/isoloom/setup.sh.new /var/lib/isoloom/setup.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-setup.service <<'ISOLOOM_UNIT'\n[Unit]\nDescription=Isoloom: the machine's set-up\nWants=network-online.target\nAfter=network-online.target cloud-final.service google-startup-scripts.service\n\n[Service]\nType=oneshot\nExecStart=/bin/sh /var/lib/isoloom/setup.sh\nStandardOutput=append:/var/log/isoloom-setup.log\nStandardError=append:/var/log/isoloom-setup.log\nTimeoutStartSec=0\n\n[Install]\nWantedBy=multi-user.target\nISOLOOM_UNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-setup.service >/dev/null 2>&1\nsystemctl start --no-block isoloom-setup.service\nelse\nnohup sh /var/lib/isoloom/setup.sh >> /var/log/isoloom-setup.log 2>&1 &\nfi\n")
  admin_ssh_key {
    username   = "isoloom"
    public_key = var.ssh_public_key
  }
  os_disk {
    caching              = "ReadWrite"
    storage_account_type = "StandardSSD_LRS"
    disk_size_gb         = 30
  }
  source_image_reference {
    publisher = "Debian"
    offer     = "debian-12"
    sku       = "12-gen2"
    version   = "latest"
  }
}

# Machine `cache`: what may reach it.
resource "azurerm_network_security_group" "cache" {
  name                = "${local.name}-cache"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  security_rule {
    name                       = "net-lan"
    priority                   = 100
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "10.70.20.0/24"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "ssh"
    priority                   = 110
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_range     = "22"
    source_address_prefix      = var.allowed_cidr
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "reach-0-dmz-6379-tcp"
    priority                   = 120
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_range     = "6379"
    source_address_prefix      = "10.70.10.0/24"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "reach-0-dmz-6379-udp"
    priority                   = 130
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Udp"
    source_port_range          = "*"
    destination_port_range     = "6379"
    source_address_prefix      = "10.70.10.0/24"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "deny-rest-of-vnet"
    priority                   = 4000
    direction                  = "Inbound"
    access                     = "Deny"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "VirtualNetwork"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "outbound"
    priority                   = 100
    direction                  = "Outbound"
    access                     = var.isoloom_sealed ? "Deny" : "Allow"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "*"
    destination_address_prefix = var.isoloom_sealed ? "Internet" : "*"
  }
}

