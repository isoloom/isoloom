resource "oci_core_subnet" "lan" {
  compartment_id    = var.compartment_id
  vcn_id            = oci_core_vcn.env.id
  cidr_block        = "10.70.20.0/24"
  display_name      = "${local.name}-lan"
  route_table_id    = oci_core_route_table.env.id
  security_list_ids = [oci_core_security_list.lan.id]
  lifecycle {
    ignore_changes = [route_table_id]
  }
}

# Machine `fw`, at its fixed address 10.70.0.5.
resource "oci_core_instance" "fw" {
  compartment_id      = var.compartment_id
  availability_domain = data.oci_identity_availability_domains.ads.availability_domains[0].name
  display_name        = "${local.name}-fw"
  shape               = "VM.Standard.E4.Flex"
  shape_config {
    ocpus         = 1
    memory_in_gbs = 1
  }
  source_details {
    source_type             = "image"
    source_id               = data.oci_core_images.ubuntu_2404.images[0].id
    boot_volume_size_in_gbs = 50
  }
  create_vnic_details {
    subnet_id              = oci_core_subnet.outside.id
    private_ip             = "10.70.0.5"
    assign_public_ip       = true
    hostname_label         = "fw"
    skip_source_dest_check = true
  }
  metadata = {
    ssh_authorized_keys = var.ssh_public_key
    user_data           = base64encode(var.auto_stop_minutes > 0 ? "#!/bin/sh\nshutdown -h +${var.auto_stop_minutes}\n" : "#!/bin/sh\n")
  }
}

resource "oci_core_vnic_attachment" "fw_dmz" {
  instance_id  = oci_core_instance.fw.id
  display_name = "${local.name}-fw-dmz"
  create_vnic_details {
    subnet_id              = oci_core_subnet.dmz.id
    private_ip             = "10.70.10.254"
    assign_public_ip       = false
    skip_source_dest_check = true
  }
}

data "oci_core_vnic" "fw_dmz" {
  vnic_id = oci_core_vnic_attachment.fw_dmz.vnic_id
}

resource "oci_core_vnic_attachment" "fw_lan" {
  instance_id  = oci_core_instance.fw.id
  display_name = "${local.name}-fw-lan"
  create_vnic_details {
    subnet_id              = oci_core_subnet.lan.id
    private_ip             = "10.70.20.254"
    assign_public_ip       = false
    skip_source_dest_check = true
  }
}

data "oci_core_vnic" "fw_lan" {
  vnic_id = oci_core_vnic_attachment.fw_lan.vnic_id
}

resource "terraform_data" "fw" {
  triggers_replace = [oci_core_instance.fw.id]
  connection {
    type        = "ssh"
    host        = oci_core_instance.fw.public_ip
    user        = "ubuntu"
    private_key = file(pathexpand(var.ssh_private_key_file))
    timeout     = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-fw.tgz\" --exclude=.git --exclude=.vagrant --exclude=.terraform --exclude=.isoloom-project* -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-fw.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "remote-exec" {
    inline = [
      "set -e",
      "cloud-init status --wait >/dev/null 2>&1 || true",
      "IF=$(ip -o link | grep -i \"${lower(data.oci_core_vnic.fw_dmz.mac_address)}\" | awk -F': ' '{print $2}'); sudo ip link set \"$IF\" up && (ip -4 addr show \"$IF\" | grep -q 10.70.10.254/ || sudo ip addr add 10.70.10.254/24 dev \"$IF\")",
      "IF=$(ip -o link | grep -i \"${lower(data.oci_core_vnic.fw_lan.mac_address)}\" | awk -F': ' '{print $2}'); sudo ip link set \"$IF\" up && (ip -4 addr show \"$IF\" | grep -q 10.70.20.254/ || sudo ip addr add 10.70.20.254/24 dev \"$IF\")",
      "echo 'net.ipv4.ip_forward=1' | sudo tee /etc/sysctl.d/90-isoloom-forwarding.conf >/dev/null && sudo sysctl -q -p /etc/sysctl.d/90-isoloom-forwarding.conf",
      "sudo sh -c 'mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz'",
      "sudo sh -c 'for l in '\\''10.70.10.10 web www.edge.test'\\'' '\\''10.70.20.20 cache'\\'' '\\''10.70.0.10 user'\\''; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'",
      "sudo sh -c 'cd /opt/isoloom && sh -c '\\''sh provision/fw.sh'\\'''",
      "sudo sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'"
    ]
  }
}

# Machine `web`, at its fixed address 10.70.10.10.
resource "oci_core_instance" "web" {
  compartment_id      = var.compartment_id
  availability_domain = data.oci_identity_availability_domains.ads.availability_domains[0].name
  display_name        = "${local.name}-web"
  shape               = "VM.Standard.E4.Flex"
  shape_config {
    ocpus         = 1
    memory_in_gbs = 1
  }
  source_details {
    source_type             = "image"
    source_id               = data.oci_core_images.ubuntu_2404.images[0].id
    boot_volume_size_in_gbs = 50
  }
  create_vnic_details {
    subnet_id              = oci_core_subnet.dmz.id
    private_ip             = "10.70.10.10"
    assign_public_ip       = true
    hostname_label         = "web"
    skip_source_dest_check = false
  }
  metadata = {
    ssh_authorized_keys = var.ssh_public_key
    user_data           = base64encode(var.auto_stop_minutes > 0 ? "#!/bin/sh\nshutdown -h +${var.auto_stop_minutes}\n" : "#!/bin/sh\n")
  }
}

resource "terraform_data" "web" {
  triggers_replace = [oci_core_instance.web.id]
  connection {
    type        = "ssh"
    host        = oci_core_instance.web.public_ip
    user        = "ubuntu"
    private_key = file(pathexpand(var.ssh_private_key_file))
    timeout     = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-web.tgz\" --exclude=.git --exclude=.vagrant --exclude=.terraform --exclude=.isoloom-project* -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-web.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "remote-exec" {
    inline = [
      "set -e",
      "cloud-init status --wait >/dev/null 2>&1 || true",
      "sudo sh -c 'mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz'",
      "sudo sh -c 'for l in '\\''10.70.10.254 fw'\\'' '\\''10.70.20.20 cache'\\'' '\\''10.70.0.10 user'\\''; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'",
      "sudo sh -c 'cd /opt/isoloom && sh -c '\\''sh provision/web.sh'\\'''",
      "sudo sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'"
    ]
  }
}

