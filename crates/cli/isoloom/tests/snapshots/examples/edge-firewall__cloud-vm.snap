---
source: crates/isoloom/tests/example_snapshots.rs
---
# isoloom targets
✓ cloud-vm
    ✗ digitalocean (DigitalOcean cloud-vm takes one machine on one network: a droplet joins one VPC, at a private address DigitalOcean picks, so other machines couldn't reach it at its spec address)
    ✗ linode (machine `fw` is on several networks: a Linode instance has one VPC interface)

# isoloom generate --target cloud-vm (exit 0)
✓ .isoloom/cloud-vm/aws/main.tf
✓ .isoloom/cloud-vm/azure/main.tf
✓ .isoloom/cloud-vm/gcp/main.tf
✓ .isoloom/cloud-vm/oci/main.tf
✓ .isoloom/cloud-vm/checks/user.sh
✓ .isoloom/cloud-vm/checks/fw.sh
✓ .isoloom/cloud-vm/checks/web.sh
✓ .isoloom/cloud-vm/checks/cache.sh
✓ .isoloom/resolved.json

## .isoloom/cloud-vm/aws/main.tf
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  terraform -chdir=.isoloom/cloud-vm/aws init && terraform -chdir=.isoloom/cloud-vm/aws apply \
#           -var allowed_cidr=<your IP>/32 -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)" -var ssh_private_key_file=~/.ssh/id_ed25519
# Stop:   terraform -chdir=.isoloom/cloud-vm/aws destroy (same variables)

terraform {
  required_version = ">= 1.6"
  backend "local" {}
  required_providers {
    aws   = { source = "hashicorp/aws", version = "~> 6.67.0" }
    local = { source = "hashicorp/local", version = "~> 2.9.1" }
  }
}

variable "region" {
  type    = string
  default = "eu-west-3"
}

variable "allowed_cidr" {
  type        = string
  description = "Who may reach the machines (SSH and the published ports), e.g. your IP/32"
}

variable "ssh_public_key" {
  type = string
}

variable "ssh_private_key_file" {
  type        = string
  description = "The private key of ssh_public_key: Terraform sets the machines up over SSH"
}

variable "auto_stop_minutes" {
  type        = number
  default     = 0
  description = "Shut the machines down after this many minutes (0: never)"
}

variable "expires_at" {
  type        = string
  default     = ""
  description = "When the environment should end, in Unix seconds (empty: no end), as a tag on every resource so a reaper can find what to destroy"
}

provider "aws" {
  region = var.region
  default_tags {
    tags = {
      isoloom-environment = "edge-firewall"
      managed-by          = "isoloom"
      isoloom-instance    = local.name
      isoloom-expires-at  = var.expires_at
    }
  }
}

resource "terraform_data" "id" {
  input = substr(replace(uuid(), "-", ""), 0, 8)
  lifecycle {
    ignore_changes = [input]
  }
}

locals {
  name = "isoloom-edge-firewall-${terraform_data.id.output}"
  root = abspath("${path.module}/../../..")
}

data "aws_availability_zones" "available" {
  state = "available"
}

# The environment's networks: one VPC, a subnet per network with its exact range.
resource "aws_vpc" "env" {
  cidr_block = "10.70.0.0/19"
  tags       = { Name = local.name }
}

resource "aws_internet_gateway" "env" {
  vpc_id = aws_vpc.env.id
}

# A route table per network: the networks a machine routes go through its interface.
resource "aws_route_table" "outside" {
  vpc_id = aws_vpc.env.id
  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.env.id
  }
  route {
    cidr_block           = "10.70.10.0/24"
    network_interface_id = aws_network_interface.fw_outside.id
  }
  route {
    cidr_block           = "10.70.20.0/24"
    network_interface_id = aws_network_interface.fw_outside.id
  }
}

resource "aws_route_table" "dmz" {
  vpc_id = aws_vpc.env.id
  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.env.id
  }
  route {
    cidr_block           = "10.70.0.0/24"
    network_interface_id = aws_network_interface.fw_dmz.id
  }
  route {
    cidr_block           = "10.70.20.0/24"
    network_interface_id = aws_network_interface.fw_dmz.id
  }
}

resource "aws_route_table" "lan" {
  vpc_id = aws_vpc.env.id
  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.env.id
  }
  route {
    cidr_block           = "10.70.0.0/24"
    network_interface_id = aws_network_interface.fw_lan.id
  }
  route {
    cidr_block           = "10.70.10.0/24"
    network_interface_id = aws_network_interface.fw_lan.id
  }
}

resource "aws_subnet" "outside" {
  vpc_id            = aws_vpc.env.id
  cidr_block        = "10.70.0.0/24"
  availability_zone = data.aws_availability_zones.available.names[0]
  tags              = { Name = "${local.name}-outside" }
}

resource "aws_route_table_association" "outside" {
  subnet_id      = aws_subnet.outside.id
  route_table_id = aws_route_table.outside.id
}

resource "aws_subnet" "dmz" {
  vpc_id            = aws_vpc.env.id
  cidr_block        = "10.70.10.0/24"
  availability_zone = data.aws_availability_zones.available.names[0]
  tags              = { Name = "${local.name}-dmz" }
}

resource "aws_route_table_association" "dmz" {
  subnet_id      = aws_subnet.dmz.id
  route_table_id = aws_route_table.dmz.id
}

resource "aws_subnet" "lan" {
  vpc_id            = aws_vpc.env.id
  cidr_block        = "10.70.20.0/24"
  availability_zone = data.aws_availability_zones.available.names[0]
  tags              = { Name = "${local.name}-lan" }
}

resource "aws_route_table_association" "lan" {
  subnet_id      = aws_subnet.lan.id
  route_table_id = aws_route_table.lan.id
}

resource "aws_key_pair" "env" {
  key_name   = local.name
  public_key = var.ssh_public_key
}

data "aws_ami" "debian_12" {
  most_recent = true
  owners      = ["136693071363"]
  filter {
    name   = "name"
    values = ["debian-12-amd64-*"]
  }
  filter {
    name   = "architecture"
    values = ["x86_64"]
  }
}

# Machine `fw`: what may reach it.
resource "aws_security_group" "fw" {
  name   = "${local.name}-fw"
  vpc_id = aws_vpc.env.id
  ingress {
    description = "its network (outside)"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["10.70.0.0/24"]
  }
  ingress {
    description = "its network (dmz)"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["10.70.10.0/24"]
  }
  ingress {
    description = "its network (lan)"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["10.70.20.0/24"]
  }
  ingress {
    description = "SSH from allowed_cidr"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [var.allowed_cidr]
  }
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_network_interface" "fw_outside" {
  subnet_id         = aws_subnet.outside.id
  private_ips       = ["10.70.0.5"]
  security_groups   = [aws_security_group.fw.id]
  source_dest_check = false
  tags              = { Name = "${local.name}-fw-outside" }
}

resource "aws_network_interface" "fw_dmz" {
  subnet_id         = aws_subnet.dmz.id
  private_ips       = ["10.70.10.254"]
  security_groups   = [aws_security_group.fw.id]
  source_dest_check = false
  tags              = { Name = "${local.name}-fw-dmz" }
}

resource "aws_network_interface" "fw_lan" {
  subnet_id         = aws_subnet.lan.id
  private_ips       = ["10.70.20.254"]
  security_groups   = [aws_security_group.fw.id]
  source_dest_check = false
  tags              = { Name = "${local.name}-fw-lan" }
}

resource "aws_instance" "fw" {
  ami           = data.aws_ami.debian_12.id
  instance_type = "t3.micro"
  key_name      = aws_key_pair.env.key_name
  user_data     = var.auto_stop_minutes > 0 ? "#!/bin/sh\nshutdown -h +${var.auto_stop_minutes}\n" : null
  primary_network_interface {
    network_interface_id = aws_network_interface.fw_outside.id
  }
  root_block_device {
    volume_size = 20
  }
  tags = { Name = "${local.name}-fw" }
}

resource "aws_network_interface_attachment" "fw_dmz" {
  instance_id          = aws_instance.fw.id
  network_interface_id = aws_network_interface.fw_dmz.id
  device_index         = 1
}

resource "aws_network_interface_attachment" "fw_lan" {
  instance_id          = aws_instance.fw.id
  network_interface_id = aws_network_interface.fw_lan.id
  device_index         = 2
}

resource "aws_eip" "fw" {
  network_interface = aws_network_interface.fw_outside.id
  depends_on        = [aws_internet_gateway.env]
}

resource "terraform_data" "fw" {
  triggers_replace = [aws_instance.fw.id]
  connection {
    type        = "ssh"
    host        = aws_eip.fw.public_ip
    user        = "admin"
    private_key = file(pathexpand(var.ssh_private_key_file))
    timeout     = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-fw.tgz\" --exclude=.git --exclude=.vagrant --exclude=.terraform --exclude=.isoloom-project* -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-fw.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "remote-exec" {
    inline = [
      "set -e",
      "cloud-init status --wait >/dev/null 2>&1 || true",
      "IF=$(ip -o link | grep -i \"${lower(aws_network_interface.fw_dmz.mac_address)}\" | awk -F': ' '{print $2}'); sudo ip link set \"$IF\" up && (ip -4 addr show \"$IF\" | grep -q 10.70.10.254/ || sudo ip addr add 10.70.10.254/24 dev \"$IF\")",
      "IF=$(ip -o link | grep -i \"${lower(aws_network_interface.fw_lan.mac_address)}\" | awk -F': ' '{print $2}'); sudo ip link set \"$IF\" up && (ip -4 addr show \"$IF\" | grep -q 10.70.20.254/ || sudo ip addr add 10.70.20.254/24 dev \"$IF\")",
      "echo 'net.ipv4.ip_forward=1' | sudo tee /etc/sysctl.d/90-isoloom-forwarding.conf >/dev/null && sudo sysctl -q -p /etc/sysctl.d/90-isoloom-forwarding.conf",
      "sudo sh -c 'mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz'",
      "sudo sh -c 'for l in '\\''10.70.10.10 web www.edge.test'\\'' '\\''10.70.20.20 cache'\\'' '\\''10.70.0.10 user'\\''; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'",
      "sudo sh -c 'cd /opt/isoloom && sh -c '\\''sh provision/fw.sh'\\'''",
      "sudo sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'"
    ]
  }
}

# Machine `web`: what may reach it.
resource "aws_security_group" "web" {
  name   = "${local.name}-web"
  vpc_id = aws_vpc.env.id
  ingress {
    description = "its network (dmz)"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["10.70.10.0/24"]
  }
  ingress {
    description = "SSH from allowed_cidr"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [var.allowed_cidr]
  }
  ingress {
    description = "reach from outside"
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["10.70.0.0/24"]
  }
  ingress {
    description = "reach from outside"
    from_port   = 80
    to_port     = 80
    protocol    = "udp"
    cidr_blocks = ["10.70.0.0/24"]
  }
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_instance" "web" {
  ami                         = data.aws_ami.debian_12.id
  instance_type               = "t3.micro"
  subnet_id                   = aws_subnet.dmz.id
  private_ip                  = "10.70.10.10"
  associate_public_ip_address = true
  key_name                    = aws_key_pair.env.key_name
  vpc_security_group_ids      = [aws_security_group.web.id]
  user_data                   = var.auto_stop_minutes > 0 ? "#!/bin/sh\nshutdown -h +${var.auto_stop_minutes}\n" : null
  root_block_device {
    volume_size = 20
  }
  tags = { Name = "${local.name}-web" }
}

resource "terraform_data" "web" {
  triggers_replace = [aws_instance.web.id]
  connection {
    type        = "ssh"
    host        = aws_instance.web.public_ip
    user        = "admin"
    private_key = file(pathexpand(var.ssh_private_key_file))
    timeout     = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-web.tgz\" --exclude=.git --exclude=.vagrant --exclude=.terraform --exclude=.isoloom-project* -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-web.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "remote-exec" {
    inline = [
      "set -e",
      "cloud-init status --wait >/dev/null 2>&1 || true",
      "sudo sh -c 'mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz'",
      "sudo sh -c 'for l in '\\''10.70.10.254 fw'\\'' '\\''10.70.20.20 cache'\\'' '\\''10.70.0.10 user'\\''; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'",
      "sudo sh -c 'cd /opt/isoloom && sh -c '\\''sh provision/web.sh'\\'''",
      "sudo sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'"
    ]
  }
}

# Machine `cache`: what may reach it.
resource "aws_security_group" "cache" {
  name   = "${local.name}-cache"
  vpc_id = aws_vpc.env.id
  ingress {
    description = "its network (lan)"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["10.70.20.0/24"]
  }
  ingress {
    description = "SSH from allowed_cidr"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [var.allowed_cidr]
  }
  ingress {
    description = "reach from dmz"
    from_port   = 6379
    to_port     = 6379
    protocol    = "tcp"
    cidr_blocks = ["10.70.10.0/24"]
  }
  ingress {
    description = "reach from dmz"
    from_port   = 6379
    to_port     = 6379
    protocol    = "udp"
    cidr_blocks = ["10.70.10.0/24"]
  }
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_instance" "cache" {
  ami                         = data.aws_ami.debian_12.id
  instance_type               = "t3.micro"
  subnet_id                   = aws_subnet.lan.id
  private_ip                  = "10.70.20.20"
  associate_public_ip_address = true
  key_name                    = aws_key_pair.env.key_name
  vpc_security_group_ids      = [aws_security_group.cache.id]
  user_data                   = var.auto_stop_minutes > 0 ? "#!/bin/sh\nshutdown -h +${var.auto_stop_minutes}\n" : null
  root_block_device {
    volume_size = 20
  }
  tags = { Name = "${local.name}-cache" }
}

resource "terraform_data" "cache" {
  triggers_replace = [aws_instance.cache.id]
  connection {
    type        = "ssh"
    host        = aws_instance.cache.public_ip
    user        = "admin"
    private_key = file(pathexpand(var.ssh_private_key_file))
    timeout     = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-cache.tgz\" --exclude=.git --exclude=.vagrant --exclude=.terraform --exclude=.isoloom-project* -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-cache.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "remote-exec" {
    inline = [
      "set -e",
      "cloud-init status --wait >/dev/null 2>&1 || true",
      "sudo sh -c 'mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz'",
      "sudo sh -c 'for l in '\\''10.70.20.254 fw'\\'' '\\''10.70.10.10 web www.edge.test'\\'' '\\''10.70.0.10 user'\\''; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'",
      "sudo sh -c 'cd /opt/isoloom && sh -c '\\''sh provision/cache.sh'\\'''",
      "sudo sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'"
    ]
  }
}

# Machine `user`: what may reach it.
resource "aws_security_group" "user" {
  name   = "${local.name}-user"
  vpc_id = aws_vpc.env.id
  ingress {
    description = "its network (outside)"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["10.70.0.0/24"]
  }
  ingress {
    description = "SSH from allowed_cidr"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [var.allowed_cidr]
  }
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_instance" "user" {
  ami                         = data.aws_ami.debian_12.id
  instance_type               = "t3.micro"
  subnet_id                   = aws_subnet.outside.id
  private_ip                  = "10.70.0.10"
  associate_public_ip_address = true
  key_name                    = aws_key_pair.env.key_name
  vpc_security_group_ids      = [aws_security_group.user.id]
  user_data                   = var.auto_stop_minutes > 0 ? "#!/bin/sh\nshutdown -h +${var.auto_stop_minutes}\n" : null
  root_block_device {
    volume_size = 20
  }
  tags = { Name = "${local.name}-user" }
}

resource "terraform_data" "user" {
  triggers_replace = [aws_instance.user.id]
  connection {
    type        = "ssh"
    host        = aws_instance.user.public_ip
    user        = "admin"
    private_key = file(pathexpand(var.ssh_private_key_file))
    timeout     = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-user.tgz\" --exclude=.git --exclude=.vagrant --exclude=.terraform --exclude=.isoloom-project* -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-user.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "remote-exec" {
    inline = [
      "set -e",
      "cloud-init status --wait >/dev/null 2>&1 || true",
      "sudo sh -c 'mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz'",
      "sudo sh -c 'for l in '\\''10.70.0.5 fw'\\'' '\\''10.70.10.10 web www.edge.test'\\'' '\\''10.70.20.20 cache'\\''; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'",
      "sudo sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'"
    ]
  }
}

output "machines" {
  value = {
    fw    = aws_eip.fw.public_ip
    web   = aws_instance.web.public_ip
    cache = aws_instance.cache.public_ip
    user  = aws_instance.user.public_ip
  }
}

output "ssh_users" {
  value = { fw = "admin", web = "admin", cache = "admin", user = "admin" }
}

output "ip" {
  value = aws_instance.user.public_ip
}

output "ready_file" {
  value = "/var/lib/isoloom/ready"
}

# The checks: each runner on the machine it stands for (ssh <user>@<host> '<command>'), or `isoloom test cloud-vm`.
output "checks" {
  value = [
    {
      position = "user"
      machine  = "user"
      host     = aws_instance.user.public_ip
      user     = "admin"
      command  = "cd /opt/isoloom && sh .isoloom/cloud-vm/checks/user.sh"
    },
    {
      position = "fw"
      machine  = "fw"
      host     = aws_eip.fw.public_ip
      user     = "admin"
      command  = "cd /opt/isoloom && sh .isoloom/cloud-vm/checks/fw.sh"
    },
    {
      position = "web"
      machine  = "web"
      host     = aws_instance.web.public_ip
      user     = "admin"
      command  = "cd /opt/isoloom && sh .isoloom/cloud-vm/checks/web.sh"
    },
    {
      position = "cache"
      machine  = "cache"
      host     = aws_instance.cache.public_ip
      user     = "admin"
      command  = "cd /opt/isoloom && sh .isoloom/cloud-vm/checks/cache.sh"
    }
  ]
}

# The project's files the machines don't get: version control and the tools' state, and what
# .isoloomignore at the project's root lists (gitignore-style: one pattern per line, `#` comments,
# `!` brings a path back, a trailing `/` matches folders only, a `/` at the start or in the middle
# anchors the pattern at the root; `*`, `?`, `[abc]`, `**`; the last pattern matching a path, or
# a folder it is in, decides). Read as regular expressions, as the Vagrantfiles do.
locals {
  project_ignore_lines = [for l in split("\n", replace(try(file("${local.root}/.isoloomignore"), ""), "\r", "")) : trimspace(l)]
  project_ignore_pats  = [for l in local.project_ignore_lines : { keep = startswith(l, "!"), pat = trimprefix(l, "!") } if l != "" && !startswith(l, "#")]
  project_ignore_globs = [for r in local.project_ignore_pats : merge(r, { glob = trimsuffix(trimsuffix(trimsuffix(r.pat, "/"), "/**"), "/") })]
  project_ignore = [for r in local.project_ignore_globs : {
    keep = r.keep
    re = format(r.glob == r.pat ? "^%s(/|$)" : "^%s/", replace(replace(replace(replace(replace(replace(replace(replace(
      length(split("/", r.glob)) > 1 ? trimprefix(r.glob, "/") : "**/${r.glob}",
    "/[.+^$(){}|\\\\]/", "\\$0"), "[!", "[^"), "**/", "\u0001"), "**", "\u0002"), "*", "[^/]*"), "?", "[^/]"), "\u0001", "(.*/)?"), "\u0002", ".*"))
  } if r.glob != ""]
  # Each file: whether it goes (the last matching pattern decides; none: it goes).
  project_keep    = { for f in fileset(local.root, "**") : f => reverse(concat([true], [for r in local.project_ignore : r.keep if length(regexall(r.re, f)) > 0]))[0] }
  project_paths   = [for f, keep in local.project_keep : f if keep && length(regexall("^\\.isoloom|(^|/)\\.(git|vagrant|terraform)/", f)) == 0]
  project_ignored = [for f, keep in local.project_keep : f if !keep]
}

# What `tar` leaves out of the project's archive: .isoloomignore's files, from the archive's top
# folder, their wildcard characters escaped.
resource "local_file" "isoloom_project" {
  filename = "${path.module}/.isoloom-project-ignored.txt"
  content  = join("", [for f in local.project_ignored : "${replace("${basename(local.root)}/${f}", "/[\\\\*?\\[]/", "\\$0")}\n"])
}

## .isoloom/cloud-vm/azure/main.tf
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  terraform -chdir=.isoloom/cloud-vm/azure init && terraform -chdir=.isoloom/cloud-vm/azure apply \
#           -var allowed_cidr=<your IP>/32 -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)" -var ssh_private_key_file=~/.ssh/id_ed25519
# Stop:   terraform -chdir=.isoloom/cloud-vm/azure destroy (same variables)

terraform {
  required_version = ">= 1.6"
  backend "local" {}
  required_providers {
    azurerm = { source = "hashicorp/azurerm", version = "~> 5.8.0" }
    local   = { source = "hashicorp/local", version = "~> 2.9.1" }
  }
}

variable "subscription_id" {
  type        = string
  default     = null
  description = "Default: ARM_SUBSCRIPTION_ID from the environment"
}

variable "region" {
  type    = string
  default = "swedencentral"
}

variable "allowed_cidr" {
  type        = string
  description = "Who may reach the machines (SSH and the published ports), e.g. your IP/32"
}

variable "ssh_public_key" {
  type = string
}

variable "ssh_private_key_file" {
  type        = string
  description = "The private key of ssh_public_key: Terraform sets the machines up over SSH"
}

variable "auto_stop_minutes" {
  type        = number
  default     = 0
  description = "Shut the machines down after this many minutes (0: never)"
}

variable "expires_at" {
  type        = string
  default     = ""
  description = "When the environment should end, in Unix seconds (empty: no end), as a tag on every resource so a reaper can find what to destroy"
}

provider "azurerm" {
  features {}
  subscription_id = var.subscription_id
}

resource "terraform_data" "id" {
  input = substr(replace(uuid(), "-", ""), 0, 8)
  lifecycle {
    ignore_changes = [input]
  }
}

locals {
  name = "isoloom-edge-firewall-${terraform_data.id.output}"
  root = abspath("${path.module}/../../..")
  tags = {
    isoloom-environment = "edge-firewall"
    managed-by          = "isoloom"
    isoloom-instance    = local.name
    isoloom-expires-at  = var.expires_at
  }
}

resource "azurerm_resource_group" "env" {
  name     = local.name
  location = var.region
  tags     = local.tags
}

# The environment's networks: one virtual network, a subnet per network with its exact range.
resource "azurerm_virtual_network" "env" {
  name                = local.name
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  address_space       = ["10.70.0.0/24", "10.70.10.0/24", "10.70.20.0/24"]
}

resource "azurerm_subnet" "outside" {
  name                            = "outside"
  resource_group_name             = azurerm_resource_group.env.name
  virtual_network_name            = azurerm_virtual_network.env.name
  address_prefixes                = ["10.70.0.0/24"]
  default_outbound_access_enabled = true
}

resource "azurerm_subnet" "dmz" {
  name                            = "dmz"
  resource_group_name             = azurerm_resource_group.env.name
  virtual_network_name            = azurerm_virtual_network.env.name
  address_prefixes                = ["10.70.10.0/24"]
  default_outbound_access_enabled = true
}

resource "azurerm_subnet" "lan" {
  name                            = "lan"
  resource_group_name             = azurerm_resource_group.env.name
  virtual_network_name            = azurerm_virtual_network.env.name
  address_prefixes                = ["10.70.20.0/24"]
  default_outbound_access_enabled = false
}

# A route table per network: the networks a machine routes go through its address.
resource "azurerm_route_table" "outside" {
  name                = "${local.name}-outside"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
}

resource "azurerm_route" "outside_dmz" {
  name                   = "to-dmz"
  resource_group_name    = azurerm_resource_group.env.name
  route_table_name       = azurerm_route_table.outside.name
  address_prefix         = "10.70.10.0/24"
  next_hop_type          = "VirtualAppliance"
  next_hop_in_ip_address = "10.70.0.5"
}

resource "azurerm_route" "outside_lan" {
  name                   = "to-lan"
  resource_group_name    = azurerm_resource_group.env.name
  route_table_name       = azurerm_route_table.outside.name
  address_prefix         = "10.70.20.0/24"
  next_hop_type          = "VirtualAppliance"
  next_hop_in_ip_address = "10.70.0.5"
}

resource "azurerm_subnet_route_table_association" "outside" {
  subnet_id      = azurerm_subnet.outside.id
  route_table_id = azurerm_route_table.outside.id
}

resource "azurerm_route_table" "dmz" {
  name                = "${local.name}-dmz"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
}

resource "azurerm_route" "dmz_outside" {
  name                   = "to-outside"
  resource_group_name    = azurerm_resource_group.env.name
  route_table_name       = azurerm_route_table.dmz.name
  address_prefix         = "10.70.0.0/24"
  next_hop_type          = "VirtualAppliance"
  next_hop_in_ip_address = "10.70.10.254"
}

resource "azurerm_route" "dmz_lan" {
  name                   = "to-lan"
  resource_group_name    = azurerm_resource_group.env.name
  route_table_name       = azurerm_route_table.dmz.name
  address_prefix         = "10.70.20.0/24"
  next_hop_type          = "VirtualAppliance"
  next_hop_in_ip_address = "10.70.10.254"
}

resource "azurerm_subnet_route_table_association" "dmz" {
  subnet_id      = azurerm_subnet.dmz.id
  route_table_id = azurerm_route_table.dmz.id
}

resource "azurerm_route_table" "lan" {
  name                = "${local.name}-lan"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
}

resource "azurerm_route" "lan_outside" {
  name                   = "to-outside"
  resource_group_name    = azurerm_resource_group.env.name
  route_table_name       = azurerm_route_table.lan.name
  address_prefix         = "10.70.0.0/24"
  next_hop_type          = "VirtualAppliance"
  next_hop_in_ip_address = "10.70.20.254"
}

resource "azurerm_route" "lan_dmz" {
  name                   = "to-dmz"
  resource_group_name    = azurerm_resource_group.env.name
  route_table_name       = azurerm_route_table.lan.name
  address_prefix         = "10.70.10.0/24"
  next_hop_type          = "VirtualAppliance"
  next_hop_in_ip_address = "10.70.20.254"
}

resource "azurerm_subnet_route_table_association" "lan" {
  subnet_id      = azurerm_subnet.lan.id
  route_table_id = azurerm_route_table.lan.id
}

# Machine `fw`: what may reach it.
resource "azurerm_network_security_group" "fw" {
  name                = "${local.name}-fw"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  security_rule {
    name                       = "net-outside"
    priority                   = 100
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "10.70.0.0/24"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "net-dmz"
    priority                   = 110
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "10.70.10.0/24"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "net-lan"
    priority                   = 120
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "10.70.20.0/24"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "ssh"
    priority                   = 130
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_range     = "22"
    source_address_prefix      = var.allowed_cidr
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "outbound"
    priority                   = 100
    direction                  = "Outbound"
    access                     = "Allow"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "*"
    destination_address_prefix = "*"
  }
}

resource "azurerm_public_ip" "fw" {
  name                = "${local.name}-fw"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  allocation_method   = "Static"
  sku                 = "Standard"
}

resource "azurerm_network_interface" "fw_outside" {
  name                  = "${local.name}-fw-outside"
  resource_group_name   = azurerm_resource_group.env.name
  location              = var.region
  tags                  = local.tags
  ip_forwarding_enabled = true
  ip_configuration {
    name                          = "primary"
    subnet_id                     = azurerm_subnet.outside.id
    private_ip_address_allocation = "Static"
    private_ip_address            = "10.70.0.5"
    public_ip_address_id          = azurerm_public_ip.fw.id
  }
}

resource "azurerm_network_interface_security_group_association" "fw_outside" {
  network_interface_id      = azurerm_network_interface.fw_outside.id
  network_security_group_id = azurerm_network_security_group.fw.id
}

resource "azurerm_network_interface" "fw_dmz" {
  name                  = "${local.name}-fw-dmz"
  resource_group_name   = azurerm_resource_group.env.name
  location              = var.region
  tags                  = local.tags
  ip_forwarding_enabled = true
  ip_configuration {
    name                          = "primary"
    subnet_id                     = azurerm_subnet.dmz.id
    private_ip_address_allocation = "Static"
    private_ip_address            = "10.70.10.254"
  }
}

resource "azurerm_network_interface_security_group_association" "fw_dmz" {
  network_interface_id      = azurerm_network_interface.fw_dmz.id
  network_security_group_id = azurerm_network_security_group.fw.id
}

resource "azurerm_network_interface" "fw_lan" {
  name                  = "${local.name}-fw-lan"
  resource_group_name   = azurerm_resource_group.env.name
  location              = var.region
  tags                  = local.tags
  ip_forwarding_enabled = true
  ip_configuration {
    name                          = "primary"
    subnet_id                     = azurerm_subnet.lan.id
    private_ip_address_allocation = "Static"
    private_ip_address            = "10.70.20.254"
  }
}

resource "azurerm_network_interface_security_group_association" "fw_lan" {
  network_interface_id      = azurerm_network_interface.fw_lan.id
  network_security_group_id = azurerm_network_security_group.fw.id
}

resource "azurerm_linux_virtual_machine" "fw" {
  name                = "${local.name}-fw"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  size                = "Standard_B1s"
  admin_username      = "isoloom"
  network_interface_ids = [
    azurerm_network_interface.fw_outside.id,
    azurerm_network_interface.fw_dmz.id,
    azurerm_network_interface.fw_lan.id
  ]
  custom_data = var.auto_stop_minutes > 0 ? base64encode("#!/bin/sh\nshutdown -h +${var.auto_stop_minutes}\n") : null
  admin_ssh_key {
    username   = "isoloom"
    public_key = var.ssh_public_key
  }
  os_disk {
    caching              = "ReadWrite"
    storage_account_type = "StandardSSD_LRS"
    disk_size_gb         = 30
  }
  source_image_reference {
    publisher = "Debian"
    offer     = "debian-12"
    sku       = "12-gen2"
    version   = "latest"
  }
}

resource "terraform_data" "fw" {
  triggers_replace = [azurerm_linux_virtual_machine.fw.id]
  connection {
    type        = "ssh"
    host        = azurerm_public_ip.fw.ip_address
    user        = "isoloom"
    private_key = file(pathexpand(var.ssh_private_key_file))
    timeout     = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-fw.tgz\" --exclude=.git --exclude=.vagrant --exclude=.terraform --exclude=.isoloom-project* -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-fw.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "remote-exec" {
    inline = [
      "set -e",
      "cloud-init status --wait >/dev/null 2>&1 || true",
      "IF=$(ip -o link | grep -i \"${lower(replace(azurerm_network_interface.fw_dmz.mac_address, "-", ":"))}\" | awk -F': ' '{print $2}'); sudo ip link set \"$IF\" up && (ip -4 addr show \"$IF\" | grep -q 10.70.10.254/ || sudo ip addr add 10.70.10.254/24 dev \"$IF\")",
      "IF=$(ip -o link | grep -i \"${lower(replace(azurerm_network_interface.fw_lan.mac_address, "-", ":"))}\" | awk -F': ' '{print $2}'); sudo ip link set \"$IF\" up && (ip -4 addr show \"$IF\" | grep -q 10.70.20.254/ || sudo ip addr add 10.70.20.254/24 dev \"$IF\")",
      "echo 'net.ipv4.ip_forward=1' | sudo tee /etc/sysctl.d/90-isoloom-forwarding.conf >/dev/null && sudo sysctl -q -p /etc/sysctl.d/90-isoloom-forwarding.conf",
      "sudo sh -c 'mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz'",
      "sudo sh -c 'for l in '\\''10.70.10.10 web www.edge.test'\\'' '\\''10.70.20.20 cache'\\'' '\\''10.70.0.10 user'\\''; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'",
      "sudo sh -c 'cd /opt/isoloom && sh -c '\\''sh provision/fw.sh'\\'''",
      "sudo sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'"
    ]
  }
}

# Machine `web`: what may reach it.
resource "azurerm_network_security_group" "web" {
  name                = "${local.name}-web"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  security_rule {
    name                       = "net-dmz"
    priority                   = 100
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "10.70.10.0/24"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "ssh"
    priority                   = 110
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_range     = "22"
    source_address_prefix      = var.allowed_cidr
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "reach-0-outside-80-tcp"
    priority                   = 120
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_range     = "80"
    source_address_prefix      = "10.70.0.0/24"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "reach-0-outside-80-udp"
    priority                   = 130
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Udp"
    source_port_range          = "*"
    destination_port_range     = "80"
    source_address_prefix      = "10.70.0.0/24"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "outbound"
    priority                   = 100
    direction                  = "Outbound"
    access                     = "Allow"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "*"
    destination_address_prefix = "*"
  }
}

resource "azurerm_public_ip" "web" {
  name                = "${local.name}-web"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  allocation_method   = "Static"
  sku                 = "Standard"
}

resource "azurerm_network_interface" "web_dmz" {
  name                = "${local.name}-web-dmz"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  ip_configuration {
    name                          = "primary"
    subnet_id                     = azurerm_subnet.dmz.id
    private_ip_address_allocation = "Static"
    private_ip_address            = "10.70.10.10"
    public_ip_address_id          = azurerm_public_ip.web.id
  }
}

resource "azurerm_network_interface_security_group_association" "web_dmz" {
  network_interface_id      = azurerm_network_interface.web_dmz.id
  network_security_group_id = azurerm_network_security_group.web.id
}

resource "azurerm_linux_virtual_machine" "web" {
  name                  = "${local.name}-web"
  resource_group_name   = azurerm_resource_group.env.name
  location              = var.region
  tags                  = local.tags
  size                  = "Standard_B1s"
  admin_username        = "isoloom"
  network_interface_ids = [azurerm_network_interface.web_dmz.id]
  custom_data           = var.auto_stop_minutes > 0 ? base64encode("#!/bin/sh\nshutdown -h +${var.auto_stop_minutes}\n") : null
  admin_ssh_key {
    username   = "isoloom"
    public_key = var.ssh_public_key
  }
  os_disk {
    caching              = "ReadWrite"
    storage_account_type = "StandardSSD_LRS"
    disk_size_gb         = 30
  }
  source_image_reference {
    publisher = "Debian"
    offer     = "debian-12"
    sku       = "12-gen2"
    version   = "latest"
  }
}

resource "terraform_data" "web" {
  triggers_replace = [azurerm_linux_virtual_machine.web.id]
  connection {
    type        = "ssh"
    host        = azurerm_public_ip.web.ip_address
    user        = "isoloom"
    private_key = file(pathexpand(var.ssh_private_key_file))
    timeout     = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-web.tgz\" --exclude=.git --exclude=.vagrant --exclude=.terraform --exclude=.isoloom-project* -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-web.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "remote-exec" {
    inline = [
      "set -e",
      "cloud-init status --wait >/dev/null 2>&1 || true",
      "sudo sh -c 'mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz'",
      "sudo sh -c 'for l in '\\''10.70.10.254 fw'\\'' '\\''10.70.20.20 cache'\\'' '\\''10.70.0.10 user'\\''; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'",
      "sudo sh -c 'cd /opt/isoloom && sh -c '\\''sh provision/web.sh'\\'''",
      "sudo sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'"
    ]
  }
}

# Machine `cache`: what may reach it.
resource "azurerm_network_security_group" "cache" {
  name                = "${local.name}-cache"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  security_rule {
    name                       = "net-lan"
    priority                   = 100
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "10.70.20.0/24"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "ssh"
    priority                   = 110
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_range     = "22"
    source_address_prefix      = var.allowed_cidr
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "reach-0-dmz-6379-tcp"
    priority                   = 120
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_range     = "6379"
    source_address_prefix      = "10.70.10.0/24"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "reach-0-dmz-6379-udp"
    priority                   = 130
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Udp"
    source_port_range          = "*"
    destination_port_range     = "6379"
    source_address_prefix      = "10.70.10.0/24"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "outbound"
    priority                   = 100
    direction                  = "Outbound"
    access                     = "Allow"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "*"
    destination_address_prefix = "*"
  }
}

resource "azurerm_public_ip" "cache" {
  name                = "${local.name}-cache"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  allocation_method   = "Static"
  sku                 = "Standard"
}

resource "azurerm_network_interface" "cache_lan" {
  name                = "${local.name}-cache-lan"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  ip_configuration {
    name                          = "primary"
    subnet_id                     = azurerm_subnet.lan.id
    private_ip_address_allocation = "Static"
    private_ip_address            = "10.70.20.20"
    public_ip_address_id          = azurerm_public_ip.cache.id
  }
}

resource "azurerm_network_interface_security_group_association" "cache_lan" {
  network_interface_id      = azurerm_network_interface.cache_lan.id
  network_security_group_id = azurerm_network_security_group.cache.id
}

resource "azurerm_linux_virtual_machine" "cache" {
  name                  = "${local.name}-cache"
  resource_group_name   = azurerm_resource_group.env.name
  location              = var.region
  tags                  = local.tags
  size                  = "Standard_B1s"
  admin_username        = "isoloom"
  network_interface_ids = [azurerm_network_interface.cache_lan.id]
  custom_data           = var.auto_stop_minutes > 0 ? base64encode("#!/bin/sh\nshutdown -h +${var.auto_stop_minutes}\n") : null
  admin_ssh_key {
    username   = "isoloom"
    public_key = var.ssh_public_key
  }
  os_disk {
    caching              = "ReadWrite"
    storage_account_type = "StandardSSD_LRS"
    disk_size_gb         = 30
  }
  source_image_reference {
    publisher = "Debian"
    offer     = "debian-12"
    sku       = "12-gen2"
    version   = "latest"
  }
}

resource "terraform_data" "cache" {
  triggers_replace = [azurerm_linux_virtual_machine.cache.id]
  connection {
    type        = "ssh"
    host        = azurerm_public_ip.cache.ip_address
    user        = "isoloom"
    private_key = file(pathexpand(var.ssh_private_key_file))
    timeout     = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-cache.tgz\" --exclude=.git --exclude=.vagrant --exclude=.terraform --exclude=.isoloom-project* -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-cache.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "remote-exec" {
    inline = [
      "set -e",
      "cloud-init status --wait >/dev/null 2>&1 || true",
      "sudo sh -c 'mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz'",
      "sudo sh -c 'for l in '\\''10.70.20.254 fw'\\'' '\\''10.70.10.10 web www.edge.test'\\'' '\\''10.70.0.10 user'\\''; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'",
      "sudo sh -c 'cd /opt/isoloom && sh -c '\\''sh provision/cache.sh'\\'''",
      "sudo sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'"
    ]
  }
}

# Machine `user`: what may reach it.
resource "azurerm_network_security_group" "user" {
  name                = "${local.name}-user"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  security_rule {
    name                       = "net-outside"
    priority                   = 100
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "10.70.0.0/24"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "ssh"
    priority                   = 110
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_range     = "22"
    source_address_prefix      = var.allowed_cidr
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "outbound"
    priority                   = 100
    direction                  = "Outbound"
    access                     = "Allow"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "*"
    destination_address_prefix = "*"
  }
}

