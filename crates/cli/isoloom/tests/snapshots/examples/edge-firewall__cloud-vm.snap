data "oci_core_private_ips" "fw_outside" {
  ip_address = "10.70.0.5"
  subnet_id  = oci_core_subnet.outside.id
  depends_on = [oci_core_instance.fw]
}

resource "oci_core_route_table" "outside" {
  compartment_id = var.compartment_id
  freeform_tags  = local.tags
  vcn_id         = oci_core_vcn.env.id
  display_name   = "${local.name}-outside"
  route_rules {
    destination       = "0.0.0.0/0"
    network_entity_id = oci_core_internet_gateway.env.id
  }
  route_rules {
    destination       = "10.70.10.0/24"
    network_entity_id = data.oci_core_private_ips.fw_outside.private_ips[0].id
  }
  route_rules {
    destination       = "10.70.20.0/24"
    network_entity_id = data.oci_core_private_ips.fw_outside.private_ips[0].id
  }
}

resource "oci_core_route_table_attachment" "outside" {
  subnet_id      = oci_core_subnet.outside.id
  route_table_id = oci_core_route_table.outside.id
}

data "oci_core_private_ips" "fw_dmz" {
  ip_address = "10.70.10.254"
  subnet_id  = oci_core_subnet.dmz.id
  depends_on = [oci_core_instance.fw, oci_core_vnic_attachment.fw_dmz]
}

resource "oci_core_route_table" "dmz" {
  compartment_id = var.compartment_id
  freeform_tags  = local.tags
  vcn_id         = oci_core_vcn.env.id
  display_name   = "${local.name}-dmz"
  route_rules {
    destination       = "0.0.0.0/0"
    network_entity_id = oci_core_internet_gateway.env.id
  }
  route_rules {
    destination       = "10.70.0.0/24"
    network_entity_id = data.oci_core_private_ips.fw_dmz.private_ips[0].id
  }
  route_rules {
    destination       = "10.70.20.0/24"
    network_entity_id = data.oci_core_private_ips.fw_dmz.private_ips[0].id
  }
}

resource "oci_core_route_table_attachment" "dmz" {
  subnet_id      = oci_core_subnet.dmz.id
  route_table_id = oci_core_route_table.dmz.id
}

data "oci_core_private_ips" "fw_lan" {
  ip_address = "10.70.20.254"
  subnet_id  = oci_core_subnet.lan.id
  depends_on = [oci_core_instance.fw, oci_core_vnic_attachment.fw_lan]
}

resource "oci_core_route_table" "lan" {
  compartment_id = var.compartment_id
  freeform_tags  = local.tags
  vcn_id         = oci_core_vcn.env.id
  display_name   = "${local.name}-lan"
  route_rules {
    destination       = "0.0.0.0/0"
    network_entity_id = oci_core_internet_gateway.env.id
  }
  route_rules {
    destination       = "10.70.0.0/24"
    network_entity_id = data.oci_core_private_ips.fw_lan.private_ips[0].id
  }
  route_rules {
    destination       = "10.70.10.0/24"
    network_entity_id = data.oci_core_private_ips.fw_lan.private_ips[0].id
  }
}

resource "oci_core_route_table_attachment" "lan" {
  subnet_id      = oci_core_subnet.lan.id
  route_table_id = oci_core_route_table.lan.id
}

output "machines" {
  value = {
    fw    = oci_core_instance.fw.public_ip
    web   = oci_core_instance.web.public_ip
    cache = oci_core_instance.cache.public_ip
    user  = oci_core_instance.user.public_ip
  }
}

output "address_fw" {
  value = oci_core_instance.fw.public_ip
}

output "address_web" {
  value = oci_core_instance.web.public_ip
}

output "address_cache" {
  value = oci_core_instance.cache.public_ip
}

output "address_user" {
  value = oci_core_instance.user.public_ip
}

output "ssh_users" {
  value = { fw = "ubuntu", web = "ubuntu", cache = "ubuntu", user = "ubuntu" }
}

output "ip" {
  value = oci_core_instance.user.public_ip
}

output "ready_file" {
  value = "/var/lib/isoloom/ready"
}

# The checks: each runner on the machine it stands for (ssh <user>@<host> '<command>'), or `isoloom test cloud-vm`.
output "checks" {
  value = [
    {
      position = "user"
      machine  = "user"
      host     = oci_core_instance.user.public_ip
      user     = "ubuntu"
      command  = "cd /opt/isoloom && sh .isoloom/cloud-vm/checks/user.sh"
    },
    {
      position = "fw"
      machine  = "fw"
      host     = oci_core_instance.fw.public_ip
      user     = "ubuntu"
      command  = "cd /opt/isoloom && sh .isoloom/cloud-vm/checks/fw.sh"
    },
    {
      position = "web"
      machine  = "web"
      host     = oci_core_instance.web.public_ip
      user     = "ubuntu"
      command  = "cd /opt/isoloom && sh .isoloom/cloud-vm/checks/web.sh"
    },
    {
      position = "cache"
      machine  = "cache"
      host     = oci_core_instance.cache.public_ip
      user     = "ubuntu"
      command  = "cd /opt/isoloom && sh .isoloom/cloud-vm/checks/cache.sh"
    }
  ]
}

## .isoloom/cloud-vm/oci/run.json
{
  "$schema": "https://www.isoloom.com/schema/run-manifest/v0.json",
  "manifest_version": 0,
  "generator": {
    "name": "isoloom",
    "version": "0.11.0"
  },
  "lab": {
    "name": "edge-firewall",
    "instance": null,
    "message": null
  },
  "target": "cloud-vm",
  "cloud": "oci",
  "driver": "terraform",
  "hosts": [
    "linux",
    "macos",
    "windows"
  ],
  "tools": [
    {
      "name": "terraform",
      "probe": [
        "terraform",
        "version"
      ],
      "min_version": "1.11.0"
    },
    {
      "name": "ssh",
      "probe": [
        "ssh",
        "-V"
      ]
    }
  ],
  "identity": {
    "terraform": {
      "module": ".",
      "state": "runner"
    }
  },
  "params": [
    {
      "name": "compartment_id",
      "description": "The compartment the environment goes in.",
      "required": true,
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "compartment_id"
        }
      ]
    },
    {
      "name": "region",
      "description": "The OCI region to launch in.",
      "default": "eu-paris-1",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "region"
        }
      ]
    },
    {
      "name": "config_file_profile",
      "description": "The profile of the OCI CLI's configuration (~/.oci/config) the provider signs in with.",
      "default": "DEFAULT",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "config_file_profile"
        }
      ]
    },
    {
      "name": "allowed_cidr",
      "description": "Who may reach the machines (SSH and the published ports), e.g. your IP/32.",
      "required": true,
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "allowed_cidr"
        }
      ]
    },
    {
      "name": "isoloom_sealed",
      "description": "true once the machines are set up: the internet is closed to the `internet: false` networks, at the network.",
      "default": "false",
      "values": [
        "true",
        "false"
      ],
      "set_by": "runner",
      "deliver": [
        {
          "via": "tf_var",
          "var": "isoloom_sealed"
        }
      ]
    },
    {
      "name": "ISOLOOM_DERIVED",
      "description": "0: the checks derived from the spec (reachability, no internet) are skipped.",
      "default": "1",
      "values": [
        "0",
        "1"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_DERIVED",
          "steps": [
            "check-user",
            "check-fw",
            "check-web",
            "check-cache"
          ]
        }
      ]
    }
  ],
  "secrets": [],
  "networks": [
    {
      "name": "outside",
      "cidr": "10.70.0.0/24",
      "internet": true,
      "native": "outside"
    },
    {
      "name": "dmz",
      "cidr": "10.70.10.0/24",
      "internet": true,
      "native": "dmz"
    },
    {
      "name": "lan",
      "cidr": "10.70.20.0/24",
      "internet": false,
      "native": "lan"
    }
  ],
  "machines": [
    {
      "name": "fw",
      "role": "target",
      "os": "debian-12",
      "arch": "amd64",
      "addresses": {
        "dmz": "10.70.10.1",
        "lan": "10.70.20.1",
        "outside": "10.70.0.5"
      },
      "ports": [
        {
          "name": "status",
          "port": 8080,
          "protocol": "tcp",
          "http": true
        }
      ]
    },
    {
      "name": "web",
      "role": "target",
      "os": "debian-12",
      "arch": "amd64",
      "addresses": {
        "dmz": "10.70.10.10"
      },
      "ports": [
        {
          "name": "web",
          "port": 80,
          "protocol": "tcp",
          "http": true
        }
      ]
    },
    {
      "name": "cache",
      "role": "target",
      "os": "debian-12",
      "arch": "amd64",
      "addresses": {
        "lan": "10.70.20.20"
      },
      "ports": [
        {
          "name": "redis",
          "port": 6379,
          "protocol": "tcp",
          "http": false
        }
      ]
    },
    {
      "name": "user",
      "role": "target",
      "os": "debian-12",
      "arch": "amd64",
      "addresses": {
        "outside": "10.70.0.10"
      }
    }
  ],
  "lifecycle": {
    "up": [
      {
        "id": "clear-lock",
        "action": "terraform.clear_lock"
      },
      {
        "id": "init",
        "note": "Preparing Terraform and its providers…",
        "argv": [
          "terraform",
          "init",
          "-input=false",
          "-no-color",
          "-backend-config=path=${run.state_dir}/terraform.tfstate"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 900
      },
      {
        "id": "apply",
        "note": "Creating the lab's machines in the cloud…",
        "argv": [
          "terraform",
          "apply",
          "-auto-approve",
          "-input=false",
          "-no-color"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 3600
      },
      {
        "id": "archive",
        "note": "Archiving the project…",
        "action": "project.archive",
        "with": {
          "root": "../../.."
        }
      },
      {
        "id": "deliver-fw",
        "note": "Copying the project into fw…",
        "action": "ssh.run",
        "with": {
          "command": "sudo sh -c 'mkdir -p /opt/isoloom /var/lib/isoloom && tar -xzf - -C /opt/isoloom && touch /var/lib/isoloom/project-delivered'",
          "host": "${outputs.address_fw}",
          "user": "ubuntu",
          "wait_s": "900"
        },
        "stdin": "${run.state_dir}/project.tgz",
        "timeout_s": 1500
      },
      {
        "id": "deliver-web",
        "note": "Copying the project into web…",
        "action": "ssh.run",
        "with": {
          "command": "sudo sh -c 'mkdir -p /opt/isoloom /var/lib/isoloom && tar -xzf - -C /opt/isoloom && touch /var/lib/isoloom/project-delivered'",
          "host": "${outputs.address_web}",
          "user": "ubuntu",
          "wait_s": "900"
        },
        "stdin": "${run.state_dir}/project.tgz",
        "timeout_s": 1500
      },
      {
        "id": "deliver-cache",
        "note": "Copying the project into cache…",
        "action": "ssh.run",
        "with": {
          "command": "sudo sh -c 'mkdir -p /opt/isoloom /var/lib/isoloom && tar -xzf - -C /opt/isoloom && touch /var/lib/isoloom/project-delivered'",
          "host": "${outputs.address_cache}",
          "user": "ubuntu",
          "wait_s": "900"
        },
        "stdin": "${run.state_dir}/project.tgz",
        "timeout_s": 1500
      },
      {
        "id": "deliver-user",
        "note": "Copying the project into user…",
        "action": "ssh.run",
        "with": {
          "command": "sudo sh -c 'mkdir -p /opt/isoloom /var/lib/isoloom && tar -xzf - -C /opt/isoloom && touch /var/lib/isoloom/project-delivered'",
          "host": "${outputs.address_user}",
          "user": "ubuntu",
          "wait_s": "900"
        },
        "stdin": "${run.state_dir}/project.tgz",
        "timeout_s": 1500
      }
    ],
    "down": [
      {
        "id": "clear-lock",
        "action": "terraform.clear_lock"
      },
      {
        "id": "init",
        "note": "Preparing Terraform and its providers…",
        "argv": [
          "terraform",
          "init",
          "-input=false",
          "-no-color",
          "-backend-config=path=${run.state_dir}/terraform.tfstate"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 900
      },
      {
        "id": "destroy",
        "note": "Removing the lab from the cloud…",
        "argv": [
          "terraform",
          "destroy",
          "-auto-approve",
          "-input=false",
          "-no-color"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 3600
      }
    ],
    "seal": {
      "param": "isoloom_sealed",
      "steps": [
        {
          "id": "seal",
          "note": "Closing the internet to the networks without it…",
          "argv": [
            "terraform",
            "apply",
            "-auto-approve",
            "-input=false",
            "-no-color"
          ],
          "env": {
            "TF_DATA_DIR": "${run.state_dir}/.terraform",
            "TF_INPUT": "0",
            "TF_IN_AUTOMATION": "1",
            "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
          },
          "timeout_s": 3600
        }
      ]
    },
    "status": {
      "id": "state",
      "action": "terraform.read_state"
    }
  },
  "ready": [
    {
      "kind": "step_ok",
      "step": "apply",
      "means": "the machines exist and booted; each sets itself up from its user data once the project is in"
    },
    {
      "kind": "ready_file",
      "host": "${outputs.address_fw}",
      "user": "ubuntu",
      "path": "${outputs.ready_file}",
      "log": "/var/log/isoloom-setup.log",
      "grammar": "isoloom-ready/1",
      "timeout_s": 2400,
      "unreachable_timeout_s": 600,
      "interval_s": 10
    },
    {
      "kind": "ready_file",
      "host": "${outputs.address_web}",
      "user": "ubuntu",
      "path": "${outputs.ready_file}",
      "log": "/var/log/isoloom-setup.log",
      "grammar": "isoloom-ready/1",
      "timeout_s": 2400,
      "unreachable_timeout_s": 600,
      "interval_s": 10
    },
    {
      "kind": "ready_file",
      "host": "${outputs.address_cache}",
      "user": "ubuntu",
      "path": "${outputs.ready_file}",
      "log": "/var/log/isoloom-setup.log",
      "grammar": "isoloom-ready/1",
      "timeout_s": 2400,
      "unreachable_timeout_s": 600,
      "interval_s": 10
    },
    {
      "kind": "ready_file",
      "host": "${outputs.address_user}",
      "user": "ubuntu",
      "path": "${outputs.ready_file}",
      "log": "/var/log/isoloom-setup.log",
      "grammar": "isoloom-ready/1",
      "timeout_s": 2400,
      "unreachable_timeout_s": 600,
      "interval_s": 10
    }
  ],
  "outputs": [
    {
      "name": "ip",
      "description": "Where to stand: the access machine's public address (the first Linux machine's, else the controller's).",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ip"
      }
    },
    {
      "name": "ready_file",
      "description": "Where each Linux machine's set-up says how far it got (isoloom-ready/1).",
      "role": "info",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ready_file"
      }
    },
    {
      "name": "address_fw",
      "description": "fw's public address: the runner's SSH and its published ports reach it there.",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "address_fw"
      }
    },
    {
      "name": "address_web",
      "description": "web's public address: the runner's SSH and its published ports reach it there.",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "address_web"
      }
    },
    {
      "name": "address_cache",
      "description": "cache's public address: the runner's SSH and its published ports reach it there.",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "address_cache"
      }
    },
    {
      "name": "address_user",
      "description": "user's public address: the runner's SSH and its published ports reach it there.",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "address_user"
      }
    }
  ],
  "checks": {
    "protocol": "isoloom-check/1",
    "setup": [],
    "runners": [
      {
        "id": "user",
        "from": "from user",
        "checks": [
          {
            "name": "the web page answers through the firewall",
            "kind": "script",
            "wait_s": 0,
            "derived": false
          },
          {
            "name": "the web server answers by its other name",
            "kind": "http",
            "wait_s": 30,
            "derived": false
          },
          {
            "name": "fw:8080 on outside from user",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "web:80 from user",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "cache:6379 blocked from user",
            "kind": "tcp",
            "wait_s": 0,
            "derived": true
          }
        ],
        "step": {
          "id": "check-user",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} sh .isoloom/cloud-vm/checks/user.sh",
            "host": "${outputs.address_user}",
            "user": "ubuntu"
          },
          "timeout_s": 225
        }
      },
      {
        "id": "fw",
        "from": "from fw",
        "checks": [
          {
            "name": "web:80 from fw",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "cache:6379 from fw",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          }
        ],
        "step": {
          "id": "check-fw",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} sh .isoloom/cloud-vm/checks/fw.sh",
            "host": "${outputs.address_fw}",
            "user": "ubuntu"
          },
          "timeout_s": 150
        }
      },
      {
        "id": "web",
        "from": "from web",
        "checks": [
          {
            "name": "fw:8080 on dmz from web",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "cache:6379 from web",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          }
        ],
        "step": {
          "id": "check-web",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} sh .isoloom/cloud-vm/checks/web.sh",
            "host": "${outputs.address_web}",
            "user": "ubuntu"
          },
          "timeout_s": 150
        }
      },
      {
        "id": "cache",
        "from": "from cache",
        "checks": [
          {
            "name": "fw:8080 on lan from cache",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "web:80 blocked from cache",
            "kind": "tcp",
            "wait_s": 0,
            "derived": true
          },
          {
            "name": "no internet from cache",
            "kind": "http",
            "wait_s": 0,
            "derived": true
          }
        ],
        "step": {
          "id": "check-cache",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} sh .isoloom/cloud-vm/checks/cache.sh",
            "host": "${outputs.address_cache}",
            "user": "ubuntu"
          },
          "timeout_s": 135
        }
      }
    ],
    "teardown": []
  },
  "recovery": {
    "retries": 0,
    "apply_retries": 1
  },
  "expiry": {
    "tf_var": "expires_at",
    "unit": "unix_seconds",
    "default_minutes": 240
  }
}

## .isoloom/resolved.json: identical in the `docker` snapshot
