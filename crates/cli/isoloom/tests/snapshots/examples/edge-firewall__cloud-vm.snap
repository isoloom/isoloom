  size                  = "Standard_B2ts_v2"
  admin_username        = "isoloom"
  network_interface_ids = [azurerm_network_interface.user_outside.id]
  custom_data           = base64encode("#!/bin/sh\n# Isoloom: this machine sets itself up. Its progress is in /var/lib/isoloom/ready (isoloom-ready/1), its output in /var/log/isoloom-setup.log. The Isothrum runner delivers the project over SSH.\nmkdir -p /var/lib/isoloom\ncat > /var/lib/isoloom/setup.sh.new <<'ISOLOOM_SETUP'\n#!/bin/sh\numask 022\ncase \"$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\" in ready|failed:*) exit 0 ;; esac\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\npart=$(cat /var/lib/isoloom/part 2>/dev/null || echo 1)\nif [ \"$part\" = 1 ]; then\necho 'running: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; { i=0; until [ -f /var/lib/isoloom/project-delivered ]; do i=$((i+5)); if [ $i -gt 2400 ]; then echo 'the project never came: start the lab through the Isothrum runner (run.json), which delivers it over SSH' >&2; exit 1; fi; sleep 5; done; } || { echo 'failed: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; exit 1; }\necho 'running: hosts file' > /var/lib/isoloom/ready; { sh -c 'printf '\\''%s\\n'\\'' '\\''10.70.0.5 fw'\\'' '\\''10.70.10.10 web www.edge.test'\\'' '\\''10.70.20.20 cache'\\'' '\\''10.70.0.10 user'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'; } || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }\necho 'running: health check' > /var/lib/isoloom/ready; { sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'; } || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }\nfi\necho ready > /var/lib/isoloom/ready\nrm -f /var/lib/isoloom/part\ncommand -v systemctl >/dev/null && systemctl disable isoloom-setup.service >/dev/null 2>&1\nexit 0\nISOLOOM_SETUP\nmv -f /var/lib/isoloom/setup.sh.new /var/lib/isoloom/setup.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-setup.service <<'ISOLOOM_UNIT'\n[Unit]\nDescription=Isoloom: the machine's set-up\nWants=network-online.target\nAfter=network-online.target cloud-final.service google-startup-scripts.service\n\n[Service]\nType=oneshot\nExecStart=/bin/sh /var/lib/isoloom/setup.sh\nStandardOutput=append:/var/log/isoloom-setup.log\nStandardError=append:/var/log/isoloom-setup.log\nTimeoutStartSec=0\n\n[Install]\nWantedBy=multi-user.target\nISOLOOM_UNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-setup.service >/dev/null 2>&1\nsystemctl start --no-block isoloom-setup.service\nelse\nnohup sh /var/lib/isoloom/setup.sh >> /var/log/isoloom-setup.log 2>&1 &\nfi\n")
  admin_ssh_key {
    username   = "isoloom"
    public_key = var.ssh_public_key
  }
  os_disk {
    caching              = "ReadWrite"
    storage_account_type = "StandardSSD_LRS"
    disk_size_gb         = 30
  }
  source_image_reference {
    publisher = "Debian"
    offer     = "debian-12"
    sku       = "12-gen2"
    version   = "latest"
  }
}

output "machines" {
  value = {
    fw    = azurerm_public_ip.fw.ip_address
    web   = azurerm_public_ip.web.ip_address
    cache = azurerm_public_ip.cache.ip_address
    user  = azurerm_public_ip.user.ip_address
  }
}

output "address_fw" {
  value = azurerm_public_ip.fw.ip_address
}

output "address_web" {
  value = azurerm_public_ip.web.ip_address
}

output "address_cache" {
  value = azurerm_public_ip.cache.ip_address
}

output "address_user" {
  value = azurerm_public_ip.user.ip_address
}

output "ssh_users" {
  value = { fw = "isoloom", web = "isoloom", cache = "isoloom", user = "isoloom" }
}

output "ip" {
  value = azurerm_public_ip.user.ip_address
}

output "ready_file" {
  value = "/var/lib/isoloom/ready"
}

# The checks: each runner on the machine it stands for (ssh <user>@<host> '<command>'), or `isoloom test cloud-vm`.
output "checks" {
  value = [
    {
      position = "user"
      machine  = "user"
      host     = azurerm_public_ip.user.ip_address
      user     = "isoloom"
      command  = "cd /opt/isoloom && sh .isoloom/cloud-vm/checks/user.sh"
    },
    {
      position = "fw"
      machine  = "fw"
      host     = azurerm_public_ip.fw.ip_address
      user     = "isoloom"
      command  = "cd /opt/isoloom && sh .isoloom/cloud-vm/checks/fw.sh"
    },
    {
      position = "web"
      machine  = "web"
      host     = azurerm_public_ip.web.ip_address
      user     = "isoloom"
      command  = "cd /opt/isoloom && sh .isoloom/cloud-vm/checks/web.sh"
    },
    {
      position = "cache"
      machine  = "cache"
      host     = azurerm_public_ip.cache.ip_address
      user     = "isoloom"
      command  = "cd /opt/isoloom && sh .isoloom/cloud-vm/checks/cache.sh"
    }
  ]
}

## .isoloom/cloud-vm/azure/run.json
{
  "$schema": "https://www.isoloom.com/schema/run-manifest/v0.json",
  "manifest_version": 0,
  "generator": {
    "name": "isoloom",
    "version": "0.11.0"
  },
  "lab": {
    "name": "edge-firewall",
    "instance": null,
    "message": null
  },
  "target": "cloud-vm",
  "cloud": "azure",
  "driver": "terraform",
  "hosts": [
    "linux",
    "macos",
    "windows"
  ],
  "tools": [
    {
      "name": "terraform",
      "probe": [
        "terraform",
        "version"
      ],
      "min_version": "1.11.0"
    },
    {
      "name": "ssh",
      "probe": [
        "ssh",
        "-V"
      ]
    }
  ],
  "identity": {
    "terraform": {
      "module": ".",
      "state": "runner"
    }
  },
  "params": [
    {
      "name": "subscription_id",
      "description": "Default: ARM_SUBSCRIPTION_ID from the environment.",
      "required": true,
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "subscription_id"
        }
      ]
    },
    {
      "name": "region",
      "description": "The module's `region`.",
      "default": "swedencentral",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "region"
        }
      ]
    },
    {
      "name": "allowed_cidr",
      "description": "Who may reach the machines (SSH and the published ports), e.g. your IP/32.",
      "required": true,
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "allowed_cidr"
        }
      ]
    },
    {
      "name": "isoloom_sealed",
      "description": "true once the machines are set up: the internet is closed to the `internet: false` networks, at the network.",
      "default": "false",
      "values": [
        "true",
        "false"
      ],
      "set_by": "runner",
      "deliver": [
        {
          "via": "tf_var",
          "var": "isoloom_sealed"
        }
      ]
    },
    {
      "name": "ISOLOOM_DERIVED",
      "description": "0: the checks derived from the spec (reachability, no internet) are skipped.",
      "default": "1",
      "values": [
        "0",
        "1"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_DERIVED",
