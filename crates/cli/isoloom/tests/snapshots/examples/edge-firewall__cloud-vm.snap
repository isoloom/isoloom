## .isoloom/cloud-vm/gcp/main.tf
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  terraform -chdir=.isoloom/cloud-vm/gcp init && terraform -chdir=.isoloom/cloud-vm/gcp apply \
#           -var billing_account=<id> -var allowed_cidr=<your IP>/32 -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)"
# Stop:   terraform -chdir=.isoloom/cloud-vm/gcp destroy (same variables)
# Then:   the machines wait for the project: run the lab through the Isothrum runner (run.json
#         beside this file), which delivers the project over SSH, waits for each set-up and runs the checks.

terraform {
  required_version = ">= 1.6"
  backend "local" {}
  required_providers {
    google = { source = "hashicorp/google", version = "~> 8.5.0" }
  }
}

variable "project" {
  type        = string
  default     = ""
  description = "An existing project; or leave empty and give billing_account for a project of its own"
}

variable "billing_account" {
  type        = string
  default     = ""
  description = "With no project: create one for this environment, billed here, deleted with it"
}

variable "org_id" {
  type    = string
  default = ""
}

variable "region" {
  type    = string
  default = "europe-west9"
}

variable "isoloom_sealed" {
  type        = bool
  default     = false
  description = "Close the internet to the machines of every `internet: false` network, at the network: the runner sets it once the machines are set up"
}

variable "allowed_cidr" {
  type        = string
  description = "Who may reach the machines (SSH and the published ports), e.g. your IP/32"
}

variable "ssh_public_key" {
  type        = string
  description = "The key the machines let in: the Isothrum runner's (it delivers the project and runs the checks over SSH)"
}

variable "expires_at" {
  type        = string
  default     = ""
  description = "When the environment should end, in Unix seconds (empty: no end): a tag on every resource, so a reaper finds what to destroy, and the time the machines shut themselves down"
}

provider "google" {
  region = var.region
}

# A project of its own when none is given: everything goes when the environment is destroyed.
resource "google_project" "env" {
  count               = var.project == "" ? 1 : 0
  name                = "isoloom-edge-firewall"
  project_id          = "isoloom-${terraform_data.id.output}"
  billing_account     = var.billing_account
  org_id              = var.org_id == "" ? null : var.org_id
  deletion_policy     = "DELETE"
  auto_create_network = false
}

resource "google_project_service" "compute" {
  count              = var.project == "" ? 1 : 0
  project            = google_project.env[0].project_id
  service            = "compute.googleapis.com"
  disable_on_destroy = false
}

resource "terraform_data" "id" {
  input = substr(replace(uuid(), "-", ""), 0, 8)
  lifecycle {
    ignore_changes = [input]
  }
}

locals {
  name    = "isoloom-edge-firewall-${terraform_data.id.output}"
  project = var.project != "" ? var.project : google_project_service.compute[0].project
  zone    = "${var.region}-a"
}

# The environment's networks: a VPC network each, holding a subnetwork with its exact range.
resource "google_compute_network" "outside" {
  project                 = local.project
  name                    = "${local.name}-outside"
  auto_create_subnetworks = false
  mtu                     = 1500
}

resource "google_compute_subnetwork" "outside" {
  project       = local.project
  name          = "${local.name}-outside"
  network       = google_compute_network.outside.id
  ip_cidr_range = "10.70.0.0/24"
  region        = var.region
}

resource "google_compute_network" "dmz" {
  project                 = local.project
  name                    = "${local.name}-dmz"
  auto_create_subnetworks = false
  mtu                     = 1500
}

resource "google_compute_subnetwork" "dmz" {
  project       = local.project
  name          = "${local.name}-dmz"
  network       = google_compute_network.dmz.id
  ip_cidr_range = "10.70.10.0/24"
  region        = var.region
}

resource "google_compute_network" "lan" {
  project                 = local.project
  name                    = "${local.name}-lan"
  auto_create_subnetworks = false
  mtu                     = 1500
}

resource "google_compute_subnetwork" "lan" {
  project       = local.project
  name          = "${local.name}-lan"
  network       = google_compute_network.lan.id
  ip_cidr_range = "10.70.20.0/24"
  region        = var.region
}

# The networks a machine routes: each VPC sends them to the gateway's address in it.
resource "google_compute_route" "outside_dmz" {
  project     = local.project
  name        = "${local.name}-outside-to-dmz"
  network     = google_compute_network.outside.id
  dest_range  = "10.70.10.0/24"
  next_hop_ip = "10.70.0.5"
  depends_on  = [google_compute_instance.fw]
}

resource "google_compute_route" "outside_lan" {
  project     = local.project
  name        = "${local.name}-outside-to-lan"
  network     = google_compute_network.outside.id
  dest_range  = "10.70.20.0/24"
  next_hop_ip = "10.70.0.5"
  depends_on  = [google_compute_instance.fw]
}

resource "google_compute_route" "dmz_outside" {
  project     = local.project
  name        = "${local.name}-dmz-to-outside"
  network     = google_compute_network.dmz.id
  dest_range  = "10.70.0.0/24"
  next_hop_ip = "10.70.10.252"
  depends_on  = [google_compute_instance.fw]
}

resource "google_compute_route" "dmz_lan" {
  project     = local.project
  name        = "${local.name}-dmz-to-lan"
  network     = google_compute_network.dmz.id
  dest_range  = "10.70.20.0/24"
  next_hop_ip = "10.70.10.252"
  depends_on  = [google_compute_instance.fw]
}

resource "google_compute_route" "lan_outside" {
  project     = local.project
  name        = "${local.name}-lan-to-outside"
  network     = google_compute_network.lan.id
  dest_range  = "10.70.0.0/24"
  next_hop_ip = "10.70.20.252"
  depends_on  = [google_compute_instance.fw]
}

resource "google_compute_route" "lan_dmz" {
  project     = local.project
  name        = "${local.name}-lan-to-dmz"
  network     = google_compute_network.lan.id
  dest_range  = "10.70.10.0/24"
  next_hop_ip = "10.70.20.252"
  depends_on  = [google_compute_instance.fw]
}

# Machine `fw`: what may reach it.
resource "google_compute_firewall" "fw_net_outside" {
  project       = local.project
  name          = "${local.name}-fw-net-outside"
  network       = google_compute_network.outside.id
  direction     = "INGRESS"
  source_ranges = ["10.70.0.0/24"]
  target_tags   = ["${local.name}-fw"]
  allow {
    protocol = "all"
  }
}

resource "google_compute_firewall" "fw_net_dmz" {
  project       = local.project
  name          = "${local.name}-fw-net-dmz"
  network       = google_compute_network.dmz.id
  direction     = "INGRESS"
  source_ranges = ["10.70.10.0/24"]
  target_tags   = ["${local.name}-fw"]
  allow {
    protocol = "all"
  }
}

resource "google_compute_firewall" "fw_net_lan" {
  project       = local.project
  name          = "${local.name}-fw-net-lan"
  network       = google_compute_network.lan.id
  direction     = "INGRESS"
  source_ranges = ["10.70.20.0/24"]
  target_tags   = ["${local.name}-fw"]
  allow {
    protocol = "all"
  }
}

resource "google_compute_firewall" "fw_ssh" {
  project       = local.project
  name          = "${local.name}-fw-ssh"
  network       = google_compute_network.outside.id
  direction     = "INGRESS"
  source_ranges = [var.allowed_cidr]
  target_tags   = ["${local.name}-fw"]
  allow {
    protocol = "tcp"
    ports    = ["22"]
  }
}

resource "google_compute_instance" "fw" {
  project      = local.project
  name         = "${local.name}-fw"
  machine_type = "e2-standard-4"
  zone         = local.zone
  tags         = ["${local.name}-fw"]
  boot_disk {
    initialize_params {
      image = "debian-cloud/debian-12"
      size  = 20
    }
  }
  network_interface {
    subnetwork = google_compute_subnetwork.outside.id
    network_ip = "10.70.0.5"
    access_config {}
  }
  network_interface {
    subnetwork = google_compute_subnetwork.dmz.id
    network_ip = "10.70.10.252"
  }
  network_interface {
    subnetwork = google_compute_subnetwork.lan.id
    network_ip = "10.70.20.252"
  }
  metadata                = { ssh-keys = "admin:${var.ssh_public_key}" }
  metadata_startup_script = "#!/bin/sh\n# Isoloom: this machine sets itself up. Its progress is in /var/lib/isoloom/ready (isoloom-ready/1), its output in /var/log/isoloom-setup.log. The Isothrum runner delivers the project over SSH.\nmkdir -p /var/lib/isoloom\ncat > /var/lib/isoloom/setup.sh.new <<'ISOLOOM_SETUP'\n#!/bin/sh\numask 022\ncase \"$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\" in ready|failed:*) exit 0 ;; esac\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\npart=$(cat /var/lib/isoloom/part 2>/dev/null || echo 1)\nif [ \"$part\" = 1 ]; then\necho 'running: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; { i=0; until [ -f /var/lib/isoloom/project-delivered ]; do i=$((i+5)); if [ $i -gt 2400 ]; then echo 'the project never came: start the lab through the Isothrum runner (run.json), which delivers it over SSH' >&2; exit 1; fi; sleep 5; done; } || { echo 'failed: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; exit 1; }\necho 'running: the machine'\\''s interfaces' > /var/lib/isoloom/ready; { IF=$(ip -o link | grep -i \"${"42:01:0a:46:0a:fc"}\" | awk -F': ' '{print $2}'); sudo ip link set \"$IF\" up && (ip -4 addr show \"$IF\" | grep -q 10.70.10.252/ || sudo ip addr add 10.70.10.252/24 dev \"$IF\"); } || { echo 'failed: the machine'\\''s interfaces' > /var/lib/isoloom/ready; exit 1; }\necho 'running: the machine'\\''s interfaces' > /var/lib/isoloom/ready; { IF=$(ip -o link | grep -i \"${"42:01:0a:46:14:fc"}\" | awk -F': ' '{print $2}'); sudo ip link set \"$IF\" up && (ip -4 addr show \"$IF\" | grep -q 10.70.20.252/ || sudo ip addr add 10.70.20.252/24 dev \"$IF\"); } || { echo 'failed: the machine'\\''s interfaces' > /var/lib/isoloom/ready; exit 1; }\necho 'running: the machine'\\''s interfaces' > /var/lib/isoloom/ready; { echo 'net.ipv4.ip_forward=1' | sudo tee /etc/sysctl.d/90-isoloom-forwarding.conf >/dev/null && sudo sysctl -q -p /etc/sysctl.d/90-isoloom-forwarding.conf; } || { echo 'failed: the machine'\\''s interfaces' > /var/lib/isoloom/ready; exit 1; }\necho 'running: hosts file' > /var/lib/isoloom/ready; { sh -c 'printf '\\''%s\\n'\\'' '\\''10.70.0.5 fw'\\'' '\\''10.70.10.10 web www.edge.test'\\'' '\\''10.70.20.20 cache'\\'' '\\''10.70.0.10 user'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'; } || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }\necho 'running: provision/fw.sh' > /var/lib/isoloom/ready; { sh -c 'cd /opt/isoloom && sh -c '\\''sh provision/fw.sh'\\'''; } || { echo 'failed: provision/fw.sh' > /var/lib/isoloom/ready; exit 1; }\necho 'running: health check' > /var/lib/isoloom/ready; { sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'; } || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }\nfi\necho ready > /var/lib/isoloom/ready\nrm -f /var/lib/isoloom/part\ncommand -v systemctl >/dev/null && systemctl disable isoloom-setup.service >/dev/null 2>&1\nexit 0\nISOLOOM_SETUP\nmv -f /var/lib/isoloom/setup.sh.new /var/lib/isoloom/setup.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-setup.service <<'ISOLOOM_UNIT'\n[Unit]\nDescription=Isoloom: the machine's set-up\nWants=network-online.target\nAfter=network-online.target cloud-final.service google-startup-scripts.service\n\n[Service]\nType=oneshot\nExecStart=/bin/sh /var/lib/isoloom/setup.sh\nStandardOutput=append:/var/log/isoloom-setup.log\nStandardError=append:/var/log/isoloom-setup.log\nTimeoutStartSec=0\n\n[Install]\nWantedBy=multi-user.target\nISOLOOM_UNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-setup.service >/dev/null 2>&1\nsystemctl start --no-block isoloom-setup.service\nelse\nnohup sh /var/lib/isoloom/setup.sh >> /var/log/isoloom-setup.log 2>&1 &\nfi\n"
  labels = {
    isoloom-environment = "edge-firewall"
    managed-by          = "isoloom"
    isoloom-instance    = local.name
    isoloom-expires-at  = var.expires_at
  }
  can_ip_forward = true
}

