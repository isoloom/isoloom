resource "google_compute_firewall" "cache_lab_lan" {
  count              = var.isoloom_sealed ? 1 : 0
  project            = local.project
  name               = "${local.name}-cache-lab-lan"
  network            = google_compute_network.lan.id
  direction          = "EGRESS"
  priority           = 900
  destination_ranges = ["10.70.0.0/24", "10.70.10.0/24", "10.70.20.0/24"]
  target_tags        = ["${local.name}-cache"]
  allow {
    protocol = "all"
  }
}

resource "google_compute_firewall" "cache_sealed_lan" {
  count              = var.isoloom_sealed ? 1 : 0
  project            = local.project
  name               = "${local.name}-cache-sealed-lan"
  network            = google_compute_network.lan.id
  direction          = "EGRESS"
  priority           = 1000
  destination_ranges = ["0.0.0.0/0"]
  target_tags        = ["${local.name}-cache"]
  deny {
    protocol = "all"
  }
}

