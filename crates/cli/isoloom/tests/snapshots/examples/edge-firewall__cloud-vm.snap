resource "oci_core_subnet" "outside" {
  compartment_id    = var.compartment_id
  freeform_tags     = local.tags
  vcn_id            = oci_core_vcn.env.id
  cidr_block        = "10.70.0.0/24"
  display_name      = "${local.name}-outside"
  route_table_id    = oci_core_route_table.env.id
  security_list_ids = [oci_core_security_list.outside.id]
  lifecycle {
    ignore_changes = [route_table_id]
  }
}

# Network `dmz`: what may reach its machines, and where they may go.
resource "oci_core_security_list" "dmz" {
  compartment_id = var.compartment_id
  freeform_tags  = local.tags
  vcn_id         = oci_core_vcn.env.id
  display_name   = "${local.name}-dmz"
  ingress_security_rules {
    description = "its own network"
    source      = "10.70.10.0/24"
    protocol    = "all"
  }
  ingress_security_rules {
    description = "reach from outside"
    source      = "10.70.0.0/24"
    protocol    = "6"
    tcp_options {
      min = 80
      max = 80
    }
  }
  ingress_security_rules {
    description = "reach from outside"
    source      = "10.70.0.0/24"
    protocol    = "17"
    udp_options {
      min = 80
      max = 80
    }
  }
  ingress_security_rules {
    description = "SSH from allowed_cidr"
    source      = var.allowed_cidr
    protocol    = "6"
    tcp_options {
      min = 22
      max = 22
    }
  }
  ingress_security_rules {
    description = "path MTU discovery"
    source      = "0.0.0.0/0"
    protocol    = "1"
    icmp_options {
      type = 3
      code = 4
    }
  }
