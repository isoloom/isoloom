## .isoloom/cloud-vm/gcp/main.tf
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  terraform -chdir=.isoloom/cloud-vm/gcp init && terraform -chdir=.isoloom/cloud-vm/gcp apply \
#           -var billing_account=<id> -var allowed_cidr=<your IP>/32 -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)" -var ssh_private_key_file=~/.ssh/id_ed25519
# Stop:   terraform -chdir=.isoloom/cloud-vm/gcp destroy (same variables)

terraform {
  required_version = ">= 1.6"
  backend "local" {}
  required_providers {
    google = { source = "hashicorp/google", version = "~> 8.5.0" }
    local  = { source = "hashicorp/local", version = "~> 2.9.1" }
  }
}

variable "project" {
  type        = string
  default     = ""
  description = "An existing project; or leave empty and give billing_account for a project of its own"
}

variable "billing_account" {
  type        = string
  default     = ""
  description = "With no project: create one for this environment, billed here, deleted with it"
}

variable "org_id" {
  type    = string
  default = ""
}

variable "region" {
  type    = string
  default = "europe-west9"
}

variable "allowed_cidr" {
  type        = string
  description = "Who may reach the machines (SSH and the published ports), e.g. your IP/32"
}

variable "ssh_public_key" {
  type = string
}

variable "ssh_private_key_file" {
  type        = string
  description = "The private key of ssh_public_key: Terraform sets the machines up over SSH"
}

variable "auto_stop_minutes" {
  type        = number
  default     = 0
  description = "Shut the machines down after this many minutes (0: never)"
}

variable "expires_at" {
  type        = string
  default     = ""
  description = "When the environment should end, in Unix seconds (empty: no end), as a tag on every resource so a reaper can find what to destroy"
}

provider "google" {
  region = var.region
}

# A project of its own when none is given: everything goes when the environment is destroyed.
resource "google_project" "env" {
  count               = var.project == "" ? 1 : 0
  name                = "isoloom-edge-firewall"
  project_id          = "isoloom-${terraform_data.id.output}"
  billing_account     = var.billing_account
  org_id              = var.org_id == "" ? null : var.org_id
  deletion_policy     = "DELETE"
  auto_create_network = false
}

resource "google_project_service" "compute" {
  count              = var.project == "" ? 1 : 0
  project            = google_project.env[0].project_id
  service            = "compute.googleapis.com"
  disable_on_destroy = false
}

resource "terraform_data" "id" {
  input = substr(replace(uuid(), "-", ""), 0, 8)
  lifecycle {
    ignore_changes = [input]
  }
}

locals {
  name    = "isoloom-edge-firewall-${terraform_data.id.output}"
  root    = abspath("${path.module}/../../..")
  project = var.project != "" ? var.project : google_project_service.compute[0].project
  zone    = "${var.region}-a"
}

# The environment's networks: a VPC network each, holding a subnetwork with its exact range.
resource "google_compute_network" "outside" {
  project                 = local.project
  name                    = "${local.name}-outside"
  auto_create_subnetworks = false
  mtu                     = 1500
}

resource "google_compute_subnetwork" "outside" {
  project       = local.project
  name          = "${local.name}-outside"
  network       = google_compute_network.outside.id
  ip_cidr_range = "10.70.0.0/24"
  region        = var.region
}

resource "google_compute_network" "dmz" {
  project                 = local.project
  name                    = "${local.name}-dmz"
  auto_create_subnetworks = false
  mtu                     = 1500
}

resource "google_compute_subnetwork" "dmz" {
  project       = local.project
  name          = "${local.name}-dmz"
  network       = google_compute_network.dmz.id
  ip_cidr_range = "10.70.10.0/24"
  region        = var.region
}

resource "google_compute_network" "lan" {
  project                 = local.project
  name                    = "${local.name}-lan"
  auto_create_subnetworks = false
  mtu                     = 1500
}

resource "google_compute_subnetwork" "lan" {
  project       = local.project
  name          = "${local.name}-lan"
  network       = google_compute_network.lan.id
  ip_cidr_range = "10.70.20.0/24"
  region        = var.region
}

# The networks a machine routes: each VPC sends them to the gateway's address in it.
resource "google_compute_route" "outside_dmz" {
  project     = local.project
  name        = "${local.name}-outside-to-dmz"
  network     = google_compute_network.outside.id
  dest_range  = "10.70.10.0/24"
  next_hop_ip = "10.70.0.5"
  depends_on  = [google_compute_instance.fw]
}

resource "google_compute_route" "outside_lan" {
  project     = local.project
  name        = "${local.name}-outside-to-lan"
  network     = google_compute_network.outside.id
  dest_range  = "10.70.20.0/24"
  next_hop_ip = "10.70.0.5"
  depends_on  = [google_compute_instance.fw]
}

resource "google_compute_route" "dmz_outside" {
  project     = local.project
  name        = "${local.name}-dmz-to-outside"
  network     = google_compute_network.dmz.id
  dest_range  = "10.70.0.0/24"
  next_hop_ip = "10.70.10.252"
  depends_on  = [google_compute_instance.fw]
}

resource "google_compute_route" "dmz_lan" {
  project     = local.project
  name        = "${local.name}-dmz-to-lan"
  network     = google_compute_network.dmz.id
  dest_range  = "10.70.20.0/24"
  next_hop_ip = "10.70.10.252"
  depends_on  = [google_compute_instance.fw]
}

resource "google_compute_route" "lan_outside" {
  project     = local.project
  name        = "${local.name}-lan-to-outside"
  network     = google_compute_network.lan.id
  dest_range  = "10.70.0.0/24"
  next_hop_ip = "10.70.20.252"
  depends_on  = [google_compute_instance.fw]
}

resource "google_compute_route" "lan_dmz" {
  project     = local.project
  name        = "${local.name}-lan-to-dmz"
  network     = google_compute_network.lan.id
  dest_range  = "10.70.10.0/24"
  next_hop_ip = "10.70.20.252"
  depends_on  = [google_compute_instance.fw]
}

# Machine `fw`: what may reach it.
resource "google_compute_firewall" "fw_net_outside" {
  project       = local.project
  name          = "${local.name}-fw-net-outside"
  network       = google_compute_network.outside.id
  direction     = "INGRESS"
  source_ranges = ["10.70.0.0/24"]
  target_tags   = ["${local.name}-fw"]
  allow {
    protocol = "all"
  }
}

resource "google_compute_firewall" "fw_net_dmz" {
  project       = local.project
  name          = "${local.name}-fw-net-dmz"
  network       = google_compute_network.dmz.id
  direction     = "INGRESS"
  source_ranges = ["10.70.10.0/24"]
  target_tags   = ["${local.name}-fw"]
  allow {
    protocol = "all"
  }
}

resource "google_compute_firewall" "fw_net_lan" {
  project       = local.project
  name          = "${local.name}-fw-net-lan"
  network       = google_compute_network.lan.id
  direction     = "INGRESS"
  source_ranges = ["10.70.20.0/24"]
  target_tags   = ["${local.name}-fw"]
  allow {
    protocol = "all"
  }
}

resource "google_compute_firewall" "fw_ssh" {
  project       = local.project
  name          = "${local.name}-fw-ssh"
  network       = google_compute_network.outside.id
  direction     = "INGRESS"
  source_ranges = [var.allowed_cidr]
  target_tags   = ["${local.name}-fw"]
  allow {
    protocol = "tcp"
    ports    = ["22"]
  }
}

resource "google_compute_instance" "fw" {
  project      = local.project
  name         = "${local.name}-fw"
  machine_type = "e2-standard-4"
  zone         = local.zone
  tags         = ["${local.name}-fw"]
  boot_disk {
    initialize_params {
      image = "debian-cloud/debian-12"
      size  = 20
    }
  }
  network_interface {
    subnetwork = google_compute_subnetwork.outside.id
    network_ip = "10.70.0.5"
    access_config {}
  }
  network_interface {
    subnetwork = google_compute_subnetwork.dmz.id
    network_ip = "10.70.10.252"
  }
  network_interface {
    subnetwork = google_compute_subnetwork.lan.id
    network_ip = "10.70.20.252"
  }
  metadata                = { ssh-keys = "admin:${var.ssh_public_key}" }
  metadata_startup_script = var.auto_stop_minutes > 0 ? "#!/bin/sh\nshutdown -h +${var.auto_stop_minutes}\n" : null
  labels = {
    isoloom-environment = "edge-firewall"
    managed-by          = "isoloom"
    isoloom-instance    = local.name
    isoloom-expires-at  = var.expires_at
  }
  can_ip_forward = true
}

resource "terraform_data" "fw" {
  triggers_replace = [google_compute_instance.fw.id]
  connection {
    type        = "ssh"
    host        = google_compute_instance.fw.network_interface[0].access_config[0].nat_ip
    user        = "admin"
    private_key = file(pathexpand(var.ssh_private_key_file))
    timeout     = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-fw.tgz\" --exclude=.git --exclude=.vagrant --exclude=.terraform --exclude=.isoloom-project* -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-fw.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "remote-exec" {
    inline = [
      "set -e",
      "cloud-init status --wait >/dev/null 2>&1 || true",
      "IF=$(ip -o link | grep -i \"${"42:01:0a:46:0a:fc"}\" | awk -F': ' '{print $2}'); sudo ip link set \"$IF\" up && (ip -4 addr show \"$IF\" | grep -q 10.70.10.252/ || sudo ip addr add 10.70.10.252/24 dev \"$IF\")",
      "IF=$(ip -o link | grep -i \"${"42:01:0a:46:14:fc"}\" | awk -F': ' '{print $2}'); sudo ip link set \"$IF\" up && (ip -4 addr show \"$IF\" | grep -q 10.70.20.252/ || sudo ip addr add 10.70.20.252/24 dev \"$IF\")",
      "echo 'net.ipv4.ip_forward=1' | sudo tee /etc/sysctl.d/90-isoloom-forwarding.conf >/dev/null && sudo sysctl -q -p /etc/sysctl.d/90-isoloom-forwarding.conf",
      "sudo sh -c 'mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz'",
      "sudo sh -c 'for l in '\\''10.70.10.10 web www.edge.test'\\'' '\\''10.70.20.20 cache'\\'' '\\''10.70.0.10 user'\\''; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'",
      "sudo sh -c 'cd /opt/isoloom && sh -c '\\''sh provision/fw.sh'\\'''",
      "sudo sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'"
    ]
  }
}

# Machine `web`: what may reach it.
resource "google_compute_firewall" "web_net_dmz" {
  project       = local.project
  name          = "${local.name}-web-net-dmz"
  network       = google_compute_network.dmz.id
  direction     = "INGRESS"
  source_ranges = ["10.70.10.0/24"]
  target_tags   = ["${local.name}-web"]
  allow {
    protocol = "all"
  }
}

resource "google_compute_firewall" "web_ssh" {
  project       = local.project
  name          = "${local.name}-web-ssh"
  network       = google_compute_network.dmz.id
  direction     = "INGRESS"
  source_ranges = [var.allowed_cidr]
  target_tags   = ["${local.name}-web"]
  allow {
    protocol = "tcp"
    ports    = ["22"]
  }
}

resource "google_compute_firewall" "web_reach_outside" {
  project       = local.project
  name          = "${local.name}-web-reach-outside"
  network       = google_compute_network.dmz.id
  direction     = "INGRESS"
  source_ranges = ["10.70.0.0/24"]
  target_tags   = ["${local.name}-web"]
  allow {
    protocol = "tcp"
    ports    = ["80"]
  }
  allow {
    protocol = "udp"
    ports    = ["80"]
  }
}

resource "google_compute_instance" "web" {
  project      = local.project
  name         = "${local.name}-web"
  machine_type = "e2-small"
  zone         = local.zone
  tags         = ["${local.name}-web"]
  boot_disk {
    initialize_params {
      image = "debian-cloud/debian-12"
      size  = 20
    }
  }
  network_interface {
    subnetwork = google_compute_subnetwork.dmz.id
    network_ip = "10.70.10.10"
    access_config {}
  }
  metadata                = { ssh-keys = "admin:${var.ssh_public_key}" }
  metadata_startup_script = var.auto_stop_minutes > 0 ? "#!/bin/sh\nshutdown -h +${var.auto_stop_minutes}\n" : null
  labels = {
    isoloom-environment = "edge-firewall"
    managed-by          = "isoloom"
    isoloom-instance    = local.name
    isoloom-expires-at  = var.expires_at
  }
}

resource "terraform_data" "web" {
  triggers_replace = [google_compute_instance.web.id]
  connection {
    type        = "ssh"
    host        = google_compute_instance.web.network_interface[0].access_config[0].nat_ip
    user        = "admin"
    private_key = file(pathexpand(var.ssh_private_key_file))
    timeout     = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-web.tgz\" --exclude=.git --exclude=.vagrant --exclude=.terraform --exclude=.isoloom-project* -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-web.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "remote-exec" {
    inline = [
      "set -e",
      "cloud-init status --wait >/dev/null 2>&1 || true",
      "sudo sh -c 'mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz'",
      "sudo sh -c 'for l in '\\''10.70.10.252 fw'\\'' '\\''10.70.20.20 cache'\\'' '\\''10.70.0.10 user'\\''; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'",
      "sudo sh -c 'cd /opt/isoloom && sh -c '\\''sh provision/web.sh'\\'''",
      "sudo sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'"
    ]
  }
}

