resource "oci_core_subnet" "dmz" {
  compartment_id    = var.compartment_id
  freeform_tags     = local.tags
  vcn_id            = oci_core_vcn.env.id
  cidr_block        = "10.70.10.0/24"
  display_name      = "${local.name}-dmz"
  route_table_id    = oci_core_route_table.env.id
  security_list_ids = [oci_core_security_list.dmz.id]
  lifecycle {
    ignore_changes = [route_table_id]
  }
}

# Network `lan`: what may reach its machines, and where they may go.
resource "oci_core_security_list" "lan" {
  compartment_id = var.compartment_id
  freeform_tags  = local.tags
  vcn_id         = oci_core_vcn.env.id
  display_name   = "${local.name}-lan"
  ingress_security_rules {
    description = "its own network"
    source      = "10.70.20.0/24"
    protocol    = "all"
  }
  ingress_security_rules {
    description = "reach from dmz"
    source      = "10.70.10.0/24"
    protocol    = "6"
    tcp_options {
      min = 6379
      max = 6379
    }
  }
  ingress_security_rules {
    description = "reach from dmz"
    source      = "10.70.10.0/24"
    protocol    = "17"
    udp_options {
      min = 6379
      max = 6379
    }
  }
  ingress_security_rules {
    description = "SSH from allowed_cidr"
    source      = var.allowed_cidr
    protocol    = "6"
    tcp_options {
      min = 22
      max = 22
    }
  }
  ingress_security_rules {
    description = "path MTU discovery"
    source      = "0.0.0.0/0"
    protocol    = "1"
    icmp_options {
      type = 3
      code = 4
    }
  }
  egress_security_rules {
    description = "its own network"
    destination = "10.70.20.0/24"
    protocol    = "all"
  }
  dynamic "egress_security_rules" {
    for_each = var.isoloom_sealed ? [] : ["0.0.0.0/5", "8.0.0.0/7", "11.0.0.0/8", "12.0.0.0/6", "16.0.0.0/4", "32.0.0.0/3", "64.0.0.0/2", "128.0.0.0/3", "160.0.0.0/5", "168.0.0.0/6", "172.0.0.0/12", "172.32.0.0/11", "172.64.0.0/10", "172.128.0.0/9", "173.0.0.0/8", "174.0.0.0/7", "176.0.0.0/4", "192.0.0.0/9", "192.128.0.0/11", "192.160.0.0/13", "192.169.0.0/16", "192.170.0.0/15", "192.172.0.0/14", "192.176.0.0/12", "192.192.0.0/10", "193.0.0.0/8", "194.0.0.0/7", "196.0.0.0/6", "200.0.0.0/5", "208.0.0.0/4", "224.0.0.0/3"]
    content {
      description = "the internet, until the run is sealed"
      destination = egress_security_rules.value
      protocol    = "all"
    }
  }
  egress_security_rules {
    description = "path MTU discovery"
    destination = "0.0.0.0/0"
    protocol    = "1"
    icmp_options {
      type = 3
      code = 4
    }
  }
}

resource "oci_core_subnet" "lan" {
  compartment_id    = var.compartment_id
  freeform_tags     = local.tags
  vcn_id            = oci_core_vcn.env.id
  cidr_block        = "10.70.20.0/24"
  display_name      = "${local.name}-lan"
  route_table_id    = oci_core_route_table.env.id
  security_list_ids = [oci_core_security_list.lan.id]
  lifecycle {
    ignore_changes = [route_table_id]
  }
}

# Machine `fw`, at its fixed address 10.70.0.5.
resource "oci_core_instance" "fw" {
  compartment_id      = var.compartment_id
  freeform_tags       = local.tags
  availability_domain = data.oci_identity_availability_domains.ads.availability_domains[0].name
  display_name        = "${local.name}-fw"
  shape               = "VM.Standard.E4.Flex"
  shape_config {
    ocpus         = 1
    memory_in_gbs = 1
  }
  source_details {
    source_type             = "image"
    source_id               = data.oci_core_images.ubuntu_2404.images[0].id
    boot_volume_size_in_gbs = 50
  }
  create_vnic_details {
    subnet_id              = oci_core_subnet.outside.id
    private_ip             = "10.70.0.5"
    assign_public_ip       = true
    hostname_label         = "fw"
    skip_source_dest_check = true
  }
  metadata = {
    ssh_authorized_keys = var.ssh_public_key
    user_data           = base64encode("#!/bin/sh\n# Isoloom: this machine sets itself up. Its progress is in /var/lib/isoloom/ready (isoloom-ready/1), its output in /var/log/isoloom-setup.log. The Isothrum runner delivers the project over SSH.\nmkdir -p /var/lib/isoloom\ncat > /var/lib/isoloom/setup.sh.new <<'ISOLOOM_SETUP'\n#!/bin/sh\numask 022\ncase \"$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\" in ready|failed:*) exit 0 ;; esac\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\npart=$(cat /var/lib/isoloom/part 2>/dev/null || echo 1)\nif [ \"$part\" = 1 ]; then\necho 'running: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; { i=0; until [ -f /var/lib/isoloom/project-delivered ]; do i=$((i+5)); if [ $i -gt 2400 ]; then echo 'the project never came: start the lab through the Isothrum runner (run.json), which delivers it over SSH' >&2; exit 1; fi; sleep 5; done; } || { echo 'failed: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; exit 1; }\necho 'running: the machine'\\''s interfaces' > /var/lib/isoloom/ready; { IF=$(ip -o link | grep -i \"$(i=0; until v=$(curl -sf -H 'Authorization: Bearer Oracle' http://169.254.169.254/opc/v2/vnics/ | python3 -c 'import json, sys; print(next((str(v.get(\"macAddr\", \"\").lower()) for v in json.load(sys.stdin) if v.get(\"privateIp\") == \"10.70.10.254\"), \"\"))' 2>/dev/null) && [ -n \"$v\" ]; do i=$((i+5)); [ $i -lt 900 ] || break; sleep 5; done; echo \"$v\")\" | awk -F': ' '{print $2}'); sudo ip link set \"$IF\" up && (ip -4 addr show \"$IF\" | grep -q 10.70.10.254/ || sudo ip addr add 10.70.10.254/24 dev \"$IF\"); } || { echo 'failed: the machine'\\''s interfaces' > /var/lib/isoloom/ready; exit 1; }\necho 'running: the machine'\\''s interfaces' > /var/lib/isoloom/ready; { IF=$(ip -o link | grep -i \"$(i=0; until v=$(curl -sf -H 'Authorization: Bearer Oracle' http://169.254.169.254/opc/v2/vnics/ | python3 -c 'import json, sys; print(next((str(v.get(\"macAddr\", \"\").lower()) for v in json.load(sys.stdin) if v.get(\"privateIp\") == \"10.70.20.254\"), \"\"))' 2>/dev/null) && [ -n \"$v\" ]; do i=$((i+5)); [ $i -lt 900 ] || break; sleep 5; done; echo \"$v\")\" | awk -F': ' '{print $2}'); sudo ip link set \"$IF\" up && (ip -4 addr show \"$IF\" | grep -q 10.70.20.254/ || sudo ip addr add 10.70.20.254/24 dev \"$IF\"); } || { echo 'failed: the machine'\\''s interfaces' > /var/lib/isoloom/ready; exit 1; }\necho 'running: the machine'\\''s interfaces' > /var/lib/isoloom/ready; { echo 'net.ipv4.ip_forward=1' | sudo tee /etc/sysctl.d/90-isoloom-forwarding.conf >/dev/null && sudo sysctl -q -p /etc/sysctl.d/90-isoloom-forwarding.conf; } || { echo 'failed: the machine'\\''s interfaces' > /var/lib/isoloom/ready; exit 1; }\necho 'running: hosts file' > /var/lib/isoloom/ready; { sh -c 'printf '\\''%s\\n'\\'' '\\''10.70.0.5 fw'\\'' '\\''10.70.10.10 web www.edge.test'\\'' '\\''10.70.20.20 cache'\\'' '\\''10.70.0.10 user'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'; } || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }\necho 'running: provision/fw.sh' > /var/lib/isoloom/ready; { sh -c 'cd /opt/isoloom && sh -c '\\''sh provision/fw.sh'\\'''; } || { echo 'failed: provision/fw.sh' > /var/lib/isoloom/ready; exit 1; }\necho 'running: health check' > /var/lib/isoloom/ready; { sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'; } || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }\nfi\necho ready > /var/lib/isoloom/ready\nrm -f /var/lib/isoloom/part\ncommand -v systemctl >/dev/null && systemctl disable isoloom-setup.service >/dev/null 2>&1\nexit 0\nISOLOOM_SETUP\nmv -f /var/lib/isoloom/setup.sh.new /var/lib/isoloom/setup.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-setup.service <<'ISOLOOM_UNIT'\n[Unit]\nDescription=Isoloom: the machine's set-up\nWants=network-online.target\nAfter=network-online.target cloud-final.service google-startup-scripts.service\n\n[Service]\nType=oneshot\nExecStart=/bin/sh /var/lib/isoloom/setup.sh\nStandardOutput=append:/var/log/isoloom-setup.log\nStandardError=append:/var/log/isoloom-setup.log\nTimeoutStartSec=0\n\n[Install]\nWantedBy=multi-user.target\nISOLOOM_UNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-setup.service >/dev/null 2>&1\nsystemctl start --no-block isoloom-setup.service\nelse\nnohup sh /var/lib/isoloom/setup.sh >> /var/log/isoloom-setup.log 2>&1 &\nfi\n")
  }
}

resource "oci_core_vnic_attachment" "fw_dmz" {
  instance_id  = oci_core_instance.fw.id
  display_name = "${local.name}-fw-dmz"
  create_vnic_details {
    subnet_id              = oci_core_subnet.dmz.id
    private_ip             = "10.70.10.254"
    assign_public_ip       = false
    skip_source_dest_check = true
  }
}

