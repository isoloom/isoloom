  admin_username        = "isoloom"
  network_interface_ids = [azurerm_network_interface.guest_office_vlan20.id]
  custom_data           = base64encode("#!/bin/sh\n# Isoloom: this machine sets itself up. Its progress is in /var/lib/isoloom/ready (isoloom-ready/1), its output in /var/log/isoloom-setup.log. The Isothrum runner delivers the project over SSH.\nmkdir -p /var/lib/isoloom\ncat > /var/lib/isoloom/setup.sh.new <<'ISOLOOM_SETUP'\n#!/bin/sh\numask 022\ncase \"$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\" in ready|failed:*) exit 0 ;; esac\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\npart=$(cat /var/lib/isoloom/part 2>/dev/null || echo 1)\nif [ \"$part\" = 1 ]; then\necho 'running: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; { i=0; until [ -f /var/lib/isoloom/project-delivered ]; do i=$((i+5)); if [ $i -gt 2400 ]; then echo 'the project never came: start the lab through the Isothrum runner (run.json), which delivers it over SSH' >&2; exit 1; fi; sleep 5; done; } || { echo 'failed: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; exit 1; }\necho 'running: hosts file' > /var/lib/isoloom/ready; { sh -c 'printf '\\''%s\\n'\\'' '\\''10.70.99.10 intranet'\\'' '\\''10.70.10.10 staff'\\'' '\\''10.70.20.10 guest'\\'' '\\''10.70.20.50 admin'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'; } || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }\necho 'running: health check' > /var/lib/isoloom/ready; { sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'; } || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }\nfi\necho ready > /var/lib/isoloom/ready\nrm -f /var/lib/isoloom/part\ncommand -v systemctl >/dev/null && systemctl disable isoloom-setup.service >/dev/null 2>&1\nexit 0\nISOLOOM_SETUP\nmv -f /var/lib/isoloom/setup.sh.new /var/lib/isoloom/setup.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-setup.service <<'ISOLOOM_UNIT'\n[Unit]\nDescription=Isoloom: the machine's set-up\nWants=network-online.target\nAfter=network-online.target cloud-final.service google-startup-scripts.service\n\n[Service]\nType=oneshot\nExecStart=/bin/sh /var/lib/isoloom/setup.sh\nStandardOutput=append:/var/log/isoloom-setup.log\nStandardError=append:/var/log/isoloom-setup.log\nTimeoutStartSec=0\n\n[Install]\nWantedBy=multi-user.target\nISOLOOM_UNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-setup.service >/dev/null 2>&1\nsystemctl start --no-block isoloom-setup.service\nelse\nnohup sh /var/lib/isoloom/setup.sh >> /var/log/isoloom-setup.log 2>&1 &\nfi\n")
  admin_ssh_key {
    username   = "isoloom"
    public_key = var.ssh_public_key
  }
  os_disk {
    caching              = "ReadWrite"
    storage_account_type = "StandardSSD_LRS"
    disk_size_gb         = 30
  }
  source_image_reference {
    publisher = "Debian"
    offer     = "debian-12"
    sku       = "12-gen2"
    version   = "latest"
  }
}

# Machine `admin`: what may reach it.
resource "azurerm_network_security_group" "admin" {
  name                = "${local.name}-admin"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  security_rule {
    name                       = "net-office-vlan10"
    priority                   = 100
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "10.70.10.0/24"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "net-office-vlan20"
    priority                   = 110
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "10.70.20.0/24"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "ssh"
    priority                   = 120
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_range     = "22"
    source_address_prefix      = var.allowed_cidr
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "deny-rest-of-vnet"
    priority                   = 4000
    direction                  = "Inbound"
    access                     = "Deny"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "VirtualNetwork"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "outbound"
