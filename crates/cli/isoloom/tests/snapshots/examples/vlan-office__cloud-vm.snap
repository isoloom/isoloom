          },
          "timeout_s": 90
        }
      },
      {
        "id": "admin",
        "from": "from admin",
        "checks": [
          {
            "name": "the admin box reaches the intranet over its trunk",
            "kind": "http",
            "wait_s": 60,
            "derived": false
          },
