  }
  metadata                = { ssh-keys = "admin:${var.ssh_public_key}" }
  metadata_startup_script = "#!/bin/sh\n# Isoloom: this machine sets itself up. Its progress is in /var/lib/isoloom/ready (isoloom-ready/1), its output in /var/log/isoloom-setup.log. The Isothrum runner delivers the project over SSH.\nmkdir -p /var/lib/isoloom\ncat > /var/lib/isoloom/setup.sh.new <<'ISOLOOM_SETUP'\n#!/bin/sh\numask 022\ncase \"$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\" in ready|failed:*) exit 0 ;; esac\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\npart=$(cat /var/lib/isoloom/part 2>/dev/null || echo 1)\nif [ \"$part\" = 1 ]; then\necho 'running: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; { i=0; until [ -f /var/lib/isoloom/project-delivered ]; do i=$((i+5)); if [ $i -gt 2400 ]; then echo 'the project never came: start the lab through the Isothrum runner (run.json), which delivers it over SSH' >&2; exit 1; fi; sleep 5; done; } || { echo 'failed: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; exit 1; }\necho 'running: the machine'\\''s interfaces' > /var/lib/isoloom/ready; { IF=$(ip -o link | grep -i \"${"42:01:0a:46:14:32"}\" | awk -F': ' '{print $2}'); sudo ip link set \"$IF\" up && (ip -4 addr show \"$IF\" | grep -q 10.70.20.50/ || sudo ip addr add 10.70.20.50/24 dev \"$IF\"); } || { echo 'failed: the machine'\\''s interfaces' > /var/lib/isoloom/ready; exit 1; }\necho 'running: hosts file' > /var/lib/isoloom/ready; { sh -c 'printf '\\''%s\\n'\\'' '\\''10.70.99.10 intranet'\\'' '\\''10.70.10.10 staff'\\'' '\\''10.70.20.10 guest'\\'' '\\''10.70.10.50 admin'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'; } || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }\necho 'running: health check' > /var/lib/isoloom/ready; { sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'; } || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }\nfi\necho ready > /var/lib/isoloom/ready\nrm -f /var/lib/isoloom/part\ncommand -v systemctl >/dev/null && systemctl disable isoloom-setup.service >/dev/null 2>&1\nexit 0\nISOLOOM_SETUP\nmv -f /var/lib/isoloom/setup.sh.new /var/lib/isoloom/setup.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-setup.service <<'ISOLOOM_UNIT'\n[Unit]\nDescription=Isoloom: the machine's set-up\nWants=network-online.target\nAfter=network-online.target cloud-final.service google-startup-scripts.service\n\n[Service]\nType=oneshot\nExecStart=/bin/sh /var/lib/isoloom/setup.sh\nStandardOutput=append:/var/log/isoloom-setup.log\nStandardError=append:/var/log/isoloom-setup.log\nTimeoutStartSec=0\n\n[Install]\nWantedBy=multi-user.target\nISOLOOM_UNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-setup.service >/dev/null 2>&1\nsystemctl start --no-block isoloom-setup.service\nelse\nnohup sh /var/lib/isoloom/setup.sh >> /var/log/isoloom-setup.log 2>&1 &\nfi\n"
  labels = {
    isoloom-environment = "vlan-office"
    managed-by          = "isoloom"
    isoloom-instance    = local.name
    isoloom-expires-at  = var.expires_at
  }
  can_ip_forward = true
}

output "machines" {
  value = {
    intranet = google_compute_instance.intranet.network_interface[0].access_config[0].nat_ip
    staff    = google_compute_instance.staff.network_interface[0].access_config[0].nat_ip
    guest    = google_compute_instance.guest.network_interface[0].access_config[0].nat_ip
    admin    = google_compute_instance.admin.network_interface[0].access_config[0].nat_ip
  }
}

output "address_intranet" {
  value = google_compute_instance.intranet.network_interface[0].access_config[0].nat_ip
}

output "address_staff" {
  value = google_compute_instance.staff.network_interface[0].access_config[0].nat_ip
}

output "address_guest" {
  value = google_compute_instance.guest.network_interface[0].access_config[0].nat_ip
}

output "address_admin" {
  value = google_compute_instance.admin.network_interface[0].access_config[0].nat_ip
}

output "ssh_users" {
  value = { intranet = "admin", staff = "admin", guest = "admin", admin = "admin" }
}

output "ip" {
  value = google_compute_instance.staff.network_interface[0].access_config[0].nat_ip
}

output "ready_file" {
  value = "/var/lib/isoloom/ready"
}

# The checks: each runner on the machine it stands for (ssh <user>@<host> '<command>'), or `isoloom test cloud-vm`.
output "checks" {
  value = [
    {
      position = "staff"
      machine  = "staff"
      host     = google_compute_instance.staff.network_interface[0].access_config[0].nat_ip
      user     = "admin"
      command  = "cd /opt/isoloom && sh .isoloom/cloud-vm/checks/staff.sh"
    },
    {
      position = "intranet"
      machine  = "intranet"
      host     = google_compute_instance.intranet.network_interface[0].access_config[0].nat_ip
      user     = "admin"
      command  = "cd /opt/isoloom && sh .isoloom/cloud-vm/checks/intranet.sh"
    },
    {
      position = "guest"
      machine  = "guest"
      host     = google_compute_instance.guest.network_interface[0].access_config[0].nat_ip
      user     = "admin"
      command  = "cd /opt/isoloom && sh .isoloom/cloud-vm/checks/guest.sh"
    },
    {
      position = "admin"
      machine  = "admin"
      host     = google_compute_instance.admin.network_interface[0].access_config[0].nat_ip
      user     = "admin"
      command  = "cd /opt/isoloom && sh .isoloom/cloud-vm/checks/admin.sh"
    }
  ]
}

## .isoloom/cloud-vm/gcp/run.json
{
  "$schema": "https://www.isoloom.com/schema/run-manifest/v0.json",
  "manifest_version": 0,
  "generator": {
    "name": "isoloom",
    "version": "0.11.1"
  },
  "lab": {
    "name": "vlan-office",
    "instance": null,
    "message": null
  },
  "target": "cloud-vm",
  "cloud": "gcp",
  "driver": "terraform",
  "hosts": [
    "linux",
    "macos",
    "windows"
  ],
  "tools": [
    {
      "name": "terraform",
      "probe": [
        "terraform",
        "version"
      ],
      "min_version": "1.11.0"
    },
    {
      "name": "ssh",
      "probe": [
        "ssh",
        "-V"
      ]
    }
  ],
  "identity": {
    "terraform": {
      "module": ".",
      "state": "runner"
    }
  },
  "params": [
    {
      "name": "project",
      "description": "An existing project; or leave empty and give billing_account for a project of its own.",
      "default": "",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "project"
        }
      ]
    },
    {
      "name": "billing_account",
      "description": "With no project: create one for this environment, billed here, deleted with it.",
      "default": "",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "billing_account"
        }
      ]
    },
    {
      "name": "org_id",
      "description": "The module's `org_id`.",
      "default": "",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "org_id"
        }
      ]
    },
    {
      "name": "region",
      "description": "The module's `region`.",
      "default": "europe-west9",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "region"
        }
      ]
    },
    {
      "name": "allowed_cidr",
      "description": "Who may reach the machines (SSH and the published ports), e.g. your IP/32.",
      "required": true,
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "allowed_cidr"
        }
      ]
    },
    {
      "name": "isoloom_sealed",
      "description": "true once the machines are set up: the internet is closed to the `internet: false` networks, at the network.",
      "default": "false",
      "values": [
        "true",
        "false"
      ],
      "set_by": "runner",
      "deliver": [
        {
          "via": "tf_var",
          "var": "isoloom_sealed"
        }
      ]
    },
    {
      "name": "ISOLOOM_DERIVED",
      "description": "0: the checks derived from the spec (reachability, no internet) are skipped.",
      "default": "1",
      "values": [
        "0",
        "1"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_DERIVED",
          "steps": [
            "check-staff",
            "check-intranet",
            "check-guest",
            "check-admin"
          ]
        }
      ]
    }
  ],
  "secrets": [
    {
      "name": "GOOGLE_OAUTH_ACCESS_TOKEN",
      "kind": "connection",
      "required": false,
      "sensitive": true,
      "source": {
        "store": "env",
        "reference": "GOOGLE_OAUTH_ACCESS_TOKEN"
      },
      "deliver": [
        {
          "via": "env",
          "var": "GOOGLE_OAUTH_ACCESS_TOKEN",
          "steps": [
            "init",
            "apply",
            "destroy",
            "seal"
          ]
        }
      ]
    },
    {
      "name": "GOOGLE_CREDENTIALS",
      "kind": "connection",
      "required": false,
      "sensitive": true,
      "source": {
        "store": "env",
        "reference": "GOOGLE_CREDENTIALS"
      },
      "deliver": [
        {
          "via": "env",
          "var": "GOOGLE_CREDENTIALS",
          "steps": [
            "init",
            "apply",
            "destroy",
            "seal"
          ]
        }
      ]
    }
  ],
  "networks": [
    {
      "name": "office-vlan10",
      "cidr": "10.70.10.0/24",
      "internet": false,
      "native": "office-vlan10"
    },
    {
      "name": "office-vlan20",
      "cidr": "10.70.20.0/24",
      "internet": true,
      "native": "office-vlan20"
    },
    {
      "name": "servers",
      "cidr": "10.70.99.0/24",
      "internet": false,
      "native": "servers"
    }
  ],
  "machines": [
    {
      "name": "intranet",
      "role": "target",
      "os": "debian-12",
      "arch": "amd64",
      "addresses": {
        "servers": "10.70.99.10"
      },
      "ports": [
        {
          "name": "web",
          "port": 80,
          "protocol": "tcp",
          "http": true
        }
      ]
    },
    {
      "name": "staff",
      "role": "target",
      "os": "debian-12",
      "arch": "amd64",
      "addresses": {
        "office-vlan10": "10.70.10.10"
      }
    },
    {
      "name": "guest",
      "role": "target",
      "os": "debian-12",
      "arch": "amd64",
      "addresses": {
        "office-vlan20": "10.70.20.10"
      }
    },
    {
      "name": "admin",
      "role": "target",
      "os": "debian-12",
      "arch": "amd64",
      "addresses": {
        "office-vlan10": "10.70.10.50",
        "office-vlan20": "10.70.20.50"
      }
    }
  ],
  "lifecycle": {
    "up": [
      {
        "id": "clear-lock",
        "action": "terraform.clear_lock"
      },
      {
        "id": "init",
        "note": "Preparing Terraform and its providers…",
        "argv": [
          "terraform",
          "init",
          "-input=false",
          "-no-color",
          "-backend-config=path=${run.state_dir}/terraform.tfstate"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 900
      },
      {
        "id": "apply",
        "note": "Creating the lab's machines in the cloud…",
        "argv": [
          "terraform",
          "apply",
          "-auto-approve",
          "-input=false",
          "-no-color"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 3600
      },
      {
        "id": "archive",
        "note": "Archiving the project…",
        "action": "project.archive",
        "with": {
          "root": "../../.."
        }
      },
      {
        "id": "deliver-intranet",
        "note": "Copying the project into intranet…",
        "action": "ssh.run",
        "with": {
          "command": "sudo sh -c 'mkdir -p /opt/isoloom /var/lib/isoloom && tar -xzf - -C /opt/isoloom && touch /var/lib/isoloom/project-delivered'",
          "host": "${outputs.address_intranet}",
          "user": "admin",
          "wait_s": "900"
        },
        "stdin": "${run.state_dir}/project.tgz",
        "timeout_s": 1500
      },
      {
        "id": "deliver-staff",
        "note": "Copying the project into staff…",
        "action": "ssh.run",
        "with": {
          "command": "sudo sh -c 'mkdir -p /opt/isoloom /var/lib/isoloom && tar -xzf - -C /opt/isoloom && touch /var/lib/isoloom/project-delivered'",
          "host": "${outputs.address_staff}",
          "user": "admin",
          "wait_s": "900"
        },
        "stdin": "${run.state_dir}/project.tgz",
        "timeout_s": 1500
      },
      {
        "id": "deliver-guest",
        "note": "Copying the project into guest…",
        "action": "ssh.run",
        "with": {
          "command": "sudo sh -c 'mkdir -p /opt/isoloom /var/lib/isoloom && tar -xzf - -C /opt/isoloom && touch /var/lib/isoloom/project-delivered'",
          "host": "${outputs.address_guest}",
          "user": "admin",
          "wait_s": "900"
        },
        "stdin": "${run.state_dir}/project.tgz",
        "timeout_s": 1500
      },
      {
        "id": "deliver-admin",
        "note": "Copying the project into admin…",
        "action": "ssh.run",
        "with": {
          "command": "sudo sh -c 'mkdir -p /opt/isoloom /var/lib/isoloom && tar -xzf - -C /opt/isoloom && touch /var/lib/isoloom/project-delivered'",
          "host": "${outputs.address_admin}",
          "user": "admin",
          "wait_s": "900"
        },
        "stdin": "${run.state_dir}/project.tgz",
        "timeout_s": 1500
      }
    ],
    "down": [
      {
        "id": "clear-lock",
        "action": "terraform.clear_lock"
      },
      {
        "id": "init",
        "note": "Preparing Terraform and its providers…",
        "argv": [
          "terraform",
          "init",
          "-input=false",
          "-no-color",
          "-backend-config=path=${run.state_dir}/terraform.tfstate"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 900
      },
      {
        "id": "destroy",
        "note": "Removing the lab from the cloud…",
        "argv": [
          "terraform",
          "destroy",
          "-auto-approve",
          "-input=false",
          "-no-color"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 3600
      }
    ],
    "seal": {
      "param": "isoloom_sealed",
      "steps": [
        {
          "id": "seal",
          "note": "Closing the internet to the networks without it…",
          "argv": [
            "terraform",
            "apply",
            "-auto-approve",
            "-input=false",
            "-no-color"
          ],
          "env": {
            "TF_DATA_DIR": "${run.state_dir}/.terraform",
            "TF_INPUT": "0",
            "TF_IN_AUTOMATION": "1",
            "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
          },
          "timeout_s": 3600
        }
      ]
    },
    "status": {
      "id": "state",
      "action": "terraform.read_state"
    }
  },
  "ready": [
    {
      "kind": "step_ok",
      "step": "apply",
      "means": "the machines exist and booted; each sets itself up from its user data once the project is in"
    },
    {
      "kind": "ready_file",
      "host": "${outputs.address_intranet}",
      "user": "admin",
      "path": "${outputs.ready_file}",
      "log": "/var/log/isoloom-setup.log",
      "grammar": "isoloom-ready/1",
      "timeout_s": 2400,
      "unreachable_timeout_s": 600,
      "interval_s": 10
    },
    {
      "kind": "ready_file",
      "host": "${outputs.address_staff}",
      "user": "admin",
      "path": "${outputs.ready_file}",
      "log": "/var/log/isoloom-setup.log",
      "grammar": "isoloom-ready/1",
      "timeout_s": 2400,
      "unreachable_timeout_s": 600,
      "interval_s": 10
    },
    {
      "kind": "ready_file",
      "host": "${outputs.address_guest}",
      "user": "admin",
      "path": "${outputs.ready_file}",
      "log": "/var/log/isoloom-setup.log",
      "grammar": "isoloom-ready/1",
      "timeout_s": 2400,
      "unreachable_timeout_s": 600,
      "interval_s": 10
    },
    {
      "kind": "ready_file",
      "host": "${outputs.address_admin}",
      "user": "admin",
      "path": "${outputs.ready_file}",
      "log": "/var/log/isoloom-setup.log",
      "grammar": "isoloom-ready/1",
      "timeout_s": 2400,
      "unreachable_timeout_s": 600,
      "interval_s": 10
    }
  ],
  "outputs": [
    {
      "name": "ip",
      "description": "Where to stand: the access machine's public address (the first Linux machine's, else the controller's).",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ip"
      }
    },
    {
      "name": "ready_file",
      "description": "Where each Linux machine's set-up says how far it got (isoloom-ready/1).",
      "role": "info",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ready_file"
      }
    },
    {
      "name": "address_intranet",
      "description": "intranet's public address: the runner's SSH and its published ports reach it there.",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "address_intranet"
      }
    },
    {
      "name": "address_staff",
      "description": "staff's public address: the runner's SSH and its published ports reach it there.",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "address_staff"
      }
    },
    {
      "name": "address_guest",
      "description": "guest's public address: the runner's SSH and its published ports reach it there.",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "address_guest"
      }
    },
    {
      "name": "address_admin",
      "description": "admin's public address: the runner's SSH and its published ports reach it there.",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "address_admin"
      }
    }
  ],
  "checks": {
    "protocol": "isoloom-check/1",
    "setup": [],
    "runners": [
      {
        "id": "staff",
        "from": "from staff",
        "checks": [
          {
            "name": "staff reach the intranet",
            "kind": "http",
            "wait_s": 60,
            "derived": false
          },
          {
            "name": "intranet:80 from staff",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "no internet from staff",
            "kind": "http",
            "wait_s": 0,
            "derived": true
          }
        ],
        "step": {
          "id": "check-staff",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} sh .isoloom/cloud-vm/checks/staff.sh",
            "host": "${outputs.address_staff}",
            "user": "admin"
          },
          "timeout_s": 195
        }
      },
      {
        "id": "intranet",
        "from": "from intranet",
        "checks": [
          {
            "name": "no internet from intranet",
            "kind": "http",
            "wait_s": 0,
            "derived": true
          }
        ],
        "step": {
          "id": "check-intranet",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} sh .isoloom/cloud-vm/checks/intranet.sh",
            "host": "${outputs.address_intranet}",
            "user": "admin"
          },
          "timeout_s": 75
        }
      },
      {
        "id": "guest",
        "from": "from guest",
        "checks": [
          {
            "name": "guests don't",
            "kind": "tcp",
            "wait_s": 0,
            "derived": false
          },
          {
            "name": "intranet:80 blocked from guest",
            "kind": "tcp",
            "wait_s": 0,
            "derived": true
          }
        ],
        "step": {
          "id": "check-guest",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} sh .isoloom/cloud-vm/checks/guest.sh",
            "host": "${outputs.address_guest}",
            "user": "admin"
          },
          "timeout_s": 90
        }
      },
      {
        "id": "admin",
        "from": "from admin",
        "checks": [
          {
            "name": "the admin box reaches the intranet over its trunk",
            "kind": "http",
            "wait_s": 60,
            "derived": false
          },
          {
            "name": "intranet:80 from admin",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          }
        ],
        "step": {
          "id": "check-admin",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} sh .isoloom/cloud-vm/checks/admin.sh",
            "host": "${outputs.address_admin}",
            "user": "admin"
          },
          "timeout_s": 180
        }
      }
    ],
    "teardown": []
  },
  "recovery": {
    "retries": 0,
    "apply_retries": 1
  },
  "expiry": {
    "tf_var": "expires_at",
    "unit": "unix_seconds",
    "default_minutes": 240
  }
}

## .isoloom/cloud-vm/oci/main.tf
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  terraform -chdir=.isoloom/cloud-vm/oci init && terraform -chdir=.isoloom/cloud-vm/oci apply \
#           -var compartment_id=<compartment ocid> -var allowed_cidr=<your IP>/32 \
#           -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)"
# Stop:   terraform -chdir=.isoloom/cloud-vm/oci destroy (same variables)
# Auth:   the oci provider reads ~/.oci/config; region defaults, override with -var region=<id>.
# Then:   the machines wait for the project: run the lab through the Isothrum runner (run.json
#         beside this file), which delivers the project over SSH, waits for each set-up and runs the checks.

terraform {
  required_version = ">= 1.6"
  backend "local" {}
  required_providers {
    oci = { source = "oracle/oci", version = "~> 9.8.0" }
  }
}

variable "compartment_id" {
  type        = string
  description = "The compartment the environment goes in"
}

variable "region" {
  type        = string
  default     = "eu-paris-1"
  description = "The OCI region to launch in"
}

variable "config_file_profile" {
  type        = string
  default     = "DEFAULT"
  description = "The profile of the OCI CLI's configuration (~/.oci/config) the provider signs in with"
}

variable "isoloom_sealed" {
  type        = bool
  default     = false
  description = "Close the internet to the machines of every `internet: false` network, at the network: the runner sets it once the machines are set up"
}

variable "allowed_cidr" {
  type        = string
  description = "Who may reach the machines (SSH and the published ports), e.g. your IP/32"
}

variable "ssh_public_key" {
  type        = string
  description = "The key the machines let in: the Isothrum runner's (it delivers the project and runs the checks over SSH)"
}

variable "expires_at" {
  type        = string
  default     = ""
  description = "When the environment should end, in Unix seconds (empty: no end): a tag on every resource, so a reaper finds what to destroy, and the time the machines shut themselves down"
}

provider "oci" {
  region              = var.region
  config_file_profile = var.config_file_profile
}

resource "terraform_data" "id" {
  input = substr(replace(uuid(), "-", ""), 0, 8)
  lifecycle {
    ignore_changes = [input]
  }
}

locals {
  name = "isoloom-vlan-office-${terraform_data.id.output}"
  tags = merge({ isoloom-environment = "vlan-office", managed-by = "isoloom", isoloom-instance = local.name }, var.expires_at == "" ? {} : { isoloom-expires-at = var.expires_at })
}

# The compartment's availability domains; the instances land in the first.
data "oci_identity_availability_domains" "ads" {
  compartment_id = var.compartment_id
}

# Ubuntu 24.04: Oracle Cloud has no Debian image of its own.
data "oci_core_images" "ubuntu_2404" {
  compartment_id           = var.compartment_id
  operating_system         = "Canonical Ubuntu"
  operating_system_version = "24.04"
  shape                    = "VM.Standard.E4.Flex"
  sort_by                  = "TIMECREATED"
  sort_order               = "DESC"
}

# The environment's networks: a VCN holding each one's block, routed to the internet.
resource "oci_core_vcn" "env" {
  compartment_id = var.compartment_id
  freeform_tags  = local.tags
  display_name   = local.name
  cidr_blocks    = ["10.70.10.0/24", "10.70.20.0/24", "10.70.99.0/24"]
}

resource "oci_core_internet_gateway" "env" {
  compartment_id = var.compartment_id
  freeform_tags  = local.tags
  vcn_id         = oci_core_vcn.env.id
  display_name   = local.name
}

resource "oci_core_route_table" "env" {
  compartment_id = var.compartment_id
  freeform_tags  = local.tags
  vcn_id         = oci_core_vcn.env.id
  display_name   = local.name
  route_rules {
    destination       = "0.0.0.0/0"
    network_entity_id = oci_core_internet_gateway.env.id
  }
}

# Network `office-vlan10`: what may reach its machines, and where they may go.
resource "oci_core_security_list" "office_vlan10" {
  compartment_id = var.compartment_id
  freeform_tags  = local.tags
  vcn_id         = oci_core_vcn.env.id
  display_name   = "${local.name}-office-vlan10"
  ingress_security_rules {
    description = "its own network"
    source      = "10.70.10.0/24"
    protocol    = "all"
  }
  ingress_security_rules {
    description = "SSH from allowed_cidr"
    source      = var.allowed_cidr
    protocol    = "6"
    tcp_options {
      min = 22
      max = 22
    }
  }
  ingress_security_rules {
    description = "path MTU discovery"
    source      = "0.0.0.0/0"
    protocol    = "1"
    icmp_options {
      type = 3
      code = 4
    }
  }
  egress_security_rules {
    description = "its own network"
    destination = "10.70.10.0/24"
    protocol    = "all"
  }
  egress_security_rules {
    description = "reach to servers"
    destination = "10.70.99.0/24"
    protocol    = "6"
    tcp_options {
      min = 80
      max = 80
    }
  }
  egress_security_rules {
    description = "reach to servers"
    destination = "10.70.99.0/24"
    protocol    = "17"
    udp_options {
      min = 80
      max = 80
    }
  }
  dynamic "egress_security_rules" {
    for_each = var.isoloom_sealed ? [] : ["0.0.0.0/5", "8.0.0.0/7", "11.0.0.0/8", "12.0.0.0/6", "16.0.0.0/4", "32.0.0.0/3", "64.0.0.0/2", "128.0.0.0/3", "160.0.0.0/5", "168.0.0.0/6", "172.0.0.0/12", "172.32.0.0/11", "172.64.0.0/10", "172.128.0.0/9", "173.0.0.0/8", "174.0.0.0/7", "176.0.0.0/4", "192.0.0.0/9", "192.128.0.0/11", "192.160.0.0/13", "192.169.0.0/16", "192.170.0.0/15", "192.172.0.0/14", "192.176.0.0/12", "192.192.0.0/10", "193.0.0.0/8", "194.0.0.0/7", "196.0.0.0/6", "200.0.0.0/5", "208.0.0.0/4", "224.0.0.0/3"]
    content {
      description = "the internet, until the run is sealed"
      destination = egress_security_rules.value
      protocol    = "all"
    }
  }
  egress_security_rules {
    description = "path MTU discovery"
    destination = "0.0.0.0/0"
    protocol    = "1"
    icmp_options {
      type = 3
      code = 4
    }
  }
}

resource "oci_core_subnet" "office_vlan10" {
  compartment_id    = var.compartment_id
  freeform_tags     = local.tags
  vcn_id            = oci_core_vcn.env.id
  cidr_block        = "10.70.10.0/24"
  display_name      = "${local.name}-office-vlan10"
  route_table_id    = oci_core_route_table.env.id
  security_list_ids = [oci_core_security_list.office_vlan10.id]
}

