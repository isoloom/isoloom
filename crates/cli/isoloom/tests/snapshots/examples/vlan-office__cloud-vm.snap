if [ "${ISOLOOM_DERIVED:-1}" != 0 ]; then
if _retry 30 _http_any 'http://10.70.99.10:80/'; then pass 'intranet:80 from staff'; else fail 'intranet:80 from staff' "nothing answers at http://10.70.99.10:80/"; fi
