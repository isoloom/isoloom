      "module": ".",
      "state": "runner"
    }
  },
  "params": [
    {
      "name": "subscription_id",
      "description": "Default: ARM_SUBSCRIPTION_ID from the environment.",
      "required": true,
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "subscription_id"
        }
      ]
    },
    {
      "name": "region",
      "description": "The module's `region`.",
      "default": "swedencentral",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "region"
        }
      ]
    },
    {
      "name": "size",
      "description": "The module's `size`.",
      "default": "Standard_D2als_v6",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "size"
        }
      ]
    },
    {
      "name": "allowed_cidr",
      "description": "Who may reach the machines (SSH and the published ports), e.g. your IP/32.",
      "required": true,
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "allowed_cidr"
        }
      ]
    },
    {
      "name": "ISOLOOM_DERIVED",
      "description": "0: the checks derived from the spec (reachability, no internet) are skipped.",
      "default": "1",
