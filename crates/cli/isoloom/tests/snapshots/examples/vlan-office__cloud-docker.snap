      },
      "ports": [
        {
          "name": "web",
          "port": 80,
          "protocol": "tcp",
          "http": true
        }
      ]
    },
    {
      "name": "intranet-routes",
      "role": "infra",
      "of": "intranet",
      "addresses": {},
      "native": {
        "service": "intranet-routes"
      }
    },
    {
      "name": "staff",
      "role": "access",
      "arch": "amd64",
      "addresses": {
        "office-vlan10": "10.70.10.10"
      },
      "native": {
        "service": "staff"
      }
    },
    {
      "name": "staff-routes",
      "role": "infra",
      "of": "staff",
      "addresses": {},
      "native": {
        "service": "staff-routes"
      }
    },
    {
      "name": "guest",
      "role": "target",
      "arch": "amd64",
      "addresses": {
        "office-vlan20": "10.70.20.10"
      },
      "native": {
        "service": "guest"
      }
    },
    {
      "name": "guest-routes",
      "role": "infra",
      "of": "guest",
      "addresses": {},
      "native": {
        "service": "guest-routes"
      }
    },
    {
      "name": "admin",
      "role": "target",
      "arch": "amd64",
      "addresses": {
        "office-vlan10": "10.70.10.50",
        "office-vlan20": "10.70.20.50"
      },
      "native": {
        "service": "admin"
      }
    },
    {
      "name": "admin-routes",
      "role": "infra",
      "of": "admin",
      "addresses": {},
      "native": {
        "service": "admin-routes"
      }
    },
    {
      "name": "isoloom-check",
      "role": "check",
      "of": "staff",
      "addresses": {},
      "native": {
        "service": "isoloom-check"
      }
    },
    {
      "name": "isoloom-check-intranet",
      "role": "check",
      "of": "intranet",
      "addresses": {},
      "native": {
        "service": "isoloom-check-intranet"
      }
    },
    {
      "name": "isoloom-check-guest",
      "role": "check",
      "of": "guest",
      "addresses": {},
      "native": {
        "service": "isoloom-check-guest"
      }
    },
    {
      "name": "isoloom-check-admin",
      "role": "check",
      "of": "admin",
      "addresses": {},
      "native": {
        "service": "isoloom-check-admin"
      }
    },
    {
      "name": "isoloom-probe-amd64",
      "role": "infra",
      "addresses": {},
      "native": {
        "service": "isoloom-probe-amd64"
      }
    }
  ],
  "lifecycle": {
    "up": [
      {
        "id": "clear-lock",
        "action": "terraform.clear_lock"
      },
      {
        "id": "init",
        "note": "Preparing Terraform and its providers…",
        "argv": [
          "terraform",
          "init",
          "-input=false",
          "-no-color",
          "-backend-config=path=${run.state_dir}/terraform.tfstate"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 900
      },
      {
        "id": "apply",
        "note": "Creating the Docker host in the cloud…",
        "argv": [
          "terraform",
          "apply",
          "-auto-approve",
          "-input=false",
          "-no-color"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 3600
      },
      {
        "id": "docker",
        "note": "Installing Docker in the VM…",
        "action": "ssh.run",
        "with": {
          "command": "sudo sh -s",
          "host": "${outputs.ip}",
          "user": "isoloom",
          "wait_s": "300"
        },
        "stdin": "setup.sh",
        "timeout_s": 1800
      },
      {
        "id": "archive",
        "note": "Archiving the project…",
        "action": "project.archive",
        "with": {
          "root": "../../.."
        }
      },
      {
        "id": "project",
        "note": "Copying the project into the VM…",
        "action": "ssh.run",
        "with": {
          "command": "sudo rm -rf /opt/isoloom && sudo mkdir -p /opt/isoloom && sudo tar -xzf - -C /opt/isoloom",
          "host": "${outputs.ip}",
          "user": "isoloom"
        },
        "stdin": "${run.state_dir}/project.tgz",
        "timeout_s": 600
      },
      {
        "id": "start",
        "note": "Starting the lab's containers in the VM…",
        "action": "ssh.run",
        "with": {
          "command": "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name vlan-office --file .isoloom/docker/compose.yml up --detach --build --pull missing --wait --wait-timeout 600",
          "host": "${outputs.ip}",
          "user": "isoloom"
        },
        "timeout_s": 1800
      }
    ],
    "down": [
      {
        "id": "clear-lock",
        "action": "terraform.clear_lock"
      },
      {
        "id": "init",
        "note": "Preparing Terraform and its providers…",
        "argv": [
          "terraform",
          "init",
          "-input=false",
          "-no-color",
          "-backend-config=path=${run.state_dir}/terraform.tfstate"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 900
      },
      {
        "id": "destroy",
        "note": "Removing the lab from the cloud…",
        "argv": [
          "terraform",
          "destroy",
          "-auto-approve",
          "-input=false",
          "-no-color"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 3600
      }
    ],
    "status": {
      "id": "state",
      "action": "terraform.read_state"
    }
  },
  "ready": [
    {
      "kind": "step_ok",
      "step": "apply",
      "means": "the Docker host exists and booted"
    },
    {
      "kind": "step_ok",
      "step": "start",
      "means": "every long-running service is healthy (`--wait`: each port's probe, the route keepers, the machines' own healthchecks)"
    }
  ],
  "outputs": [
    {
      "name": "ip",
      "description": "The Docker host's address: SSH reaches it there, and its containers' published ports answer there.",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ip"
      }
    },
    {
      "name": "ssh_user",
      "description": "The user the runner's key lets in on the Docker host.",
      "role": "info",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ssh_user"
      }
    }
  ],
  "checks": {
    "protocol": "isoloom-check/1",
    "setup": [],
    "runners": [
      {
        "id": "isoloom-check",
        "from": "from staff",
        "checks": [
          {
            "name": "staff reach the intranet",
            "kind": "http",
            "wait_s": 60,
            "derived": false
          },
          {
            "name": "intranet:80 from staff",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "no internet from staff",
            "kind": "http",
            "wait_s": 0,
            "derived": true
          }
        ],
        "step": {
          "id": "check-staff",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name vlan-office --file .isoloom/docker/compose.yml --profile check run --rm --no-deps --env ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} isoloom-check",
            "host": "${outputs.ip}",
            "user": "isoloom"
          },
          "timeout_s": 195
        },
        "on_timeout": [
          {
            "id": "rm-check-staff",
            "action": "ssh.run",
            "with": {
              "command": "sudo docker ps -aq --filter label=com.docker.compose.project=vlan-office --filter label=com.docker.compose.service=isoloom-check --filter label=com.docker.compose.oneoff=True | xargs -r sudo docker rm -f",
              "host": "${outputs.ip}",
              "user": "isoloom"
            },
            "timeout_s": 60
          }
        ]
      },
      {
        "id": "isoloom-check-intranet",
        "from": "from intranet",
        "checks": [
          {
            "name": "no internet from intranet",
            "kind": "http",
            "wait_s": 0,
            "derived": true
          }
        ],
        "step": {
          "id": "check-intranet",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name vlan-office --file .isoloom/docker/compose.yml --profile check run --rm --no-deps --env ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} isoloom-check-intranet",
            "host": "${outputs.ip}",
            "user": "isoloom"
          },
          "timeout_s": 75
        },
        "on_timeout": [
          {
            "id": "rm-check-intranet",
            "action": "ssh.run",
            "with": {
              "command": "sudo docker ps -aq --filter label=com.docker.compose.project=vlan-office --filter label=com.docker.compose.service=isoloom-check-intranet --filter label=com.docker.compose.oneoff=True | xargs -r sudo docker rm -f",
              "host": "${outputs.ip}",
              "user": "isoloom"
            },
            "timeout_s": 60
          }
        ]
      },
      {
        "id": "isoloom-check-guest",
        "from": "from guest",
        "checks": [
          {
            "name": "guests don't",
            "kind": "tcp",
            "wait_s": 0,
            "derived": false
          },
          {
            "name": "intranet:80 blocked from guest",
            "kind": "tcp",
            "wait_s": 0,
            "derived": true
          }
        ],
        "step": {
          "id": "check-guest",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name vlan-office --file .isoloom/docker/compose.yml --profile check run --rm --no-deps --env ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} isoloom-check-guest",
            "host": "${outputs.ip}",
            "user": "isoloom"
          },
          "timeout_s": 90
        },
        "on_timeout": [
          {
            "id": "rm-check-guest",
            "action": "ssh.run",
            "with": {
              "command": "sudo docker ps -aq --filter label=com.docker.compose.project=vlan-office --filter label=com.docker.compose.service=isoloom-check-guest --filter label=com.docker.compose.oneoff=True | xargs -r sudo docker rm -f",
              "host": "${outputs.ip}",
              "user": "isoloom"
            },
            "timeout_s": 60
          }
        ]
      },
      {
        "id": "isoloom-check-admin",
        "from": "from admin",
        "checks": [
          {
            "name": "the admin box reaches the intranet over its trunk",
            "kind": "http",
            "wait_s": 60,
            "derived": false
          },
          {
            "name": "intranet:80 from admin",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          }
        ],
        "step": {
          "id": "check-admin",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name vlan-office --file .isoloom/docker/compose.yml --profile check run --rm --no-deps --env ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} isoloom-check-admin",
            "host": "${outputs.ip}",
            "user": "isoloom"
          },
          "timeout_s": 180
        },
        "on_timeout": [
          {
            "id": "rm-check-admin",
            "action": "ssh.run",
            "with": {
              "command": "sudo docker ps -aq --filter label=com.docker.compose.project=vlan-office --filter label=com.docker.compose.service=isoloom-check-admin --filter label=com.docker.compose.oneoff=True | xargs -r sudo docker rm -f",
              "host": "${outputs.ip}",
              "user": "isoloom"
            },
            "timeout_s": 60
          }
        ]
      }
    ],
    "teardown": []
  },
  "recovery": {
    "retries": 0,
    "apply_retries": 1
  },
  "expiry": {
    "tf_var": "expires_at",
    "unit": "unix_seconds",
    "default_minutes": 240
  },
  "guest": {
    "machine": "isoloom-docker-host",
    "host": "${outputs.ip}",
    "status": {
      "id": "ps",
      "action": "ssh.run",
      "with": {
        "command": "if command -v docker >/dev/null; then sudo docker compose --project-name vlan-office ps --all --format json; fi",
        "host": "${outputs.ip}",
        "user": "isoloom"
      },
      "timeout_s": 60
    }
  }
}

## .isoloom/cloud-docker/azure/setup.sh
#!/bin/sh
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# The Docker host's set-up, piped into `sudo sh -s` over SSH by its run manifest.
set -e
cloud-init status --wait >/dev/null 2>&1 || true
command -v docker >/dev/null || if command -v apt-get >/dev/null; then (
  set -e
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -qq
  apt-get install -y -qq ca-certificates curl
  install -m 0755 -d /etc/apt/keyrings
  k=$(mktemp)
  # shellcheck disable=SC1091,SC2154 # /etc/os-release is on the guest, not here.
  _id=$(. /etc/os-release && printf %s "$ID")
  # shellcheck disable=SC1091,SC2154
  _cn=$(. /etc/os-release && printf %s "$VERSION_CODENAME")
  curl -fsSL "https://download.docker.com/linux/$_id/gpg" -o "$k"
  echo "1500c1f56fa9e26b9b8f42452a553675796ade0807cdce11975eb98170b3a570  $k" | sha256sum -c -
  install -m 0644 "$k" /etc/apt/keyrings/docker.asc
  rm -f "$k"
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/$_id $_cn stable" > /etc/apt/sources.list.d/docker.list
  apt-get update -qq
  v=$(apt-cache madison docker-ce | awk '$3 ~ /(^|:)29[.]9[.]0/ { print $3; exit }')
  [ -n "$v" ] || { echo "docker-ce 29.9.0 is not in Docker's apt repository" >&2; exit 1; }
  apt-get install -y -qq --allow-downgrades "docker-ce=$v" "docker-ce-cli=$v" containerd.io docker-buildx-plugin "docker-compose-plugin=5.6.0-*"
)
else
  curl -fsSL https://get.docker.com | VERSION=29.9.0 sh
fi
cat > /etc/systemd/system/isoloom-published.service <<'UNIT'
[Unit]
Description=Isoloom: published ports reach containers of networks without a default route
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'iptables -t nat -C POSTROUTING -m conntrack --ctstate DNAT -o br-+ -j MASQUERADE 2>/dev/null || iptables -t nat -I POSTROUTING -m conntrack --ctstate DNAT -o br-+ -j MASQUERADE'

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now isoloom-published.service

## .isoloom/cloud-docker/digitalocean/main.tf
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  terraform -chdir=.isoloom/cloud-docker/digitalocean init && terraform -chdir=.isoloom/cloud-docker/digitalocean apply \
#           -var allowed_cidr=<your IP>/32 -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)"
# Stop:   terraform -chdir=.isoloom/cloud-docker/digitalocean destroy (same variables)
# Then:   the machines wait for the project: run the lab through the Isothrum runner (run.json
#         beside this file), which delivers the project over SSH, waits for each set-up and runs the checks.

terraform {
  required_version = ">= 1.6"
  backend "local" {}
  required_providers {
    digitalocean = { source = "digitalocean/digitalocean", version = "~> 2.103.0" }
  }
}

variable "region" {
  type    = string
  default = "fra1"
}

variable "size" {
  type    = string
  default = "s-2vcpu-4gb"
}

variable "allowed_cidr" {
  type        = string
  description = "Who may reach the machines (SSH and the published ports), e.g. your IP/32"
}

variable "ssh_public_key" {
  type        = string
  description = "The key the machines let in: the Isothrum runner's (it delivers the project and runs the checks over SSH)"
}

variable "expires_at" {
  type        = string
  default     = ""
  description = "When the environment should end, in Unix seconds (empty: no end): a tag on every resource, so a reaper finds what to destroy, and the time the machines shut themselves down"
}

resource "terraform_data" "id" {
  input = substr(replace(uuid(), "-", ""), 0, 8)
  lifecycle {
    ignore_changes = [input]
  }
}

locals {
  name = "isoloom-vlan-office-${terraform_data.id.output}"
}

resource "digitalocean_vpc" "env" {
  name     = local.name
  region   = var.region
  ip_range = "10.42.1.0/24"
}

resource "digitalocean_ssh_key" "env" {
  name       = local.name
  public_key = var.ssh_public_key
}

resource "digitalocean_droplet" "env" {
  name      = local.name
  region    = var.region
  size      = var.size
  image     = "debian-12-x64"
  vpc_uuid  = digitalocean_vpc.env.id
  ssh_keys  = [digitalocean_ssh_key.env.id]
  user_data = "#!/bin/sh\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\n"
  tags      = concat(["isoloom", "vlan-office", local.name], var.expires_at == "" ? [] : ["isoloom-expires-${var.expires_at}"])
}

resource "digitalocean_firewall" "env" {
  name        = local.name
  droplet_ids = [digitalocean_droplet.env.id]
  inbound_rule {
    protocol         = "tcp"
    port_range       = "22"
    source_addresses = [var.allowed_cidr]
  }
  outbound_rule {
    protocol              = "tcp"
    port_range            = "1-65535"
    destination_addresses = ["0.0.0.0/0", "::/0"]
  }
  outbound_rule {
    protocol              = "udp"
    port_range            = "1-65535"
    destination_addresses = ["0.0.0.0/0", "::/0"]
  }
}

output "ip" {
  value = digitalocean_droplet.env.ipv4_address
}

output "ssh_user" {
  value = "root"
}

## .isoloom/cloud-docker/digitalocean/run.json
{
  "$schema": "https://www.isoloom.com/schema/run-manifest/v0.json",
  "manifest_version": 0,
  "generator": {
    "name": "isoloom",
    "version": "0.11.1"
  },
  "lab": {
    "name": "vlan-office",
    "instance": null,
    "message": null
  },
  "target": "cloud-docker",
  "cloud": "digitalocean",
  "driver": "terraform",
  "hosts": [
    "linux",
    "macos",
    "windows"
  ],
  "tools": [
    {
      "name": "terraform",
      "probe": [
        "terraform",
        "version"
      ],
      "min_version": "1.11.0"
    },
    {
      "name": "ssh",
      "probe": [
        "ssh",
        "-V"
      ]
    }
  ],
  "identity": {
    "terraform": {
      "module": ".",
      "state": "runner"
    }
  },
  "params": [
    {
      "name": "region",
      "description": "The module's `region`.",
      "default": "fra1",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "region"
        }
      ]
    },
    {
      "name": "size",
      "description": "The module's `size`.",
      "default": "s-2vcpu-4gb",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "size"
        }
      ]
    },
    {
      "name": "allowed_cidr",
      "description": "Who may reach the machines (SSH and the published ports), e.g. your IP/32.",
      "required": true,
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "allowed_cidr"
        }
      ]
    },
    {
      "name": "ISOLOOM_DERIVED",
      "description": "0: the checks derived from the spec (reachability, no internet) are skipped.",
      "default": "1",
      "values": [
        "0",
        "1"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_DERIVED",
          "steps": [
            "check-staff",
            "check-intranet",
            "check-guest",
            "check-admin"
          ]
        }
      ]
    }
  ],
  "secrets": [
    {
      "name": "DIGITALOCEAN_TOKEN",
      "kind": "connection",
      "required": true,
      "sensitive": true,
      "source": {
        "store": "env",
        "reference": "DIGITALOCEAN_TOKEN"
      },
      "deliver": [
        {
          "via": "env",
          "var": "DIGITALOCEAN_TOKEN",
          "steps": [
            "init",
            "apply",
            "destroy"
          ]
        }
      ]
    }
  ],
  "networks": [],
  "machines": [
    {
      "name": "isoloom-docker-host",
      "role": "infra",
      "resources": {
        "cpus": 4,
        "memory_mb": 3072
      },
      "addresses": {}
    },
    {
      "name": "isoloom-router",
      "role": "infra",
      "addresses": {
        "office-vlan10": "10.70.10.254",
        "office-vlan20": "10.70.20.254",
        "servers": "10.70.99.254"
      },
      "native": {
        "service": "isoloom-router"
      }
    },
    {
      "name": "isoloom-switch-office",
      "role": "infra",
      "addresses": {},
      "native": {
        "service": "isoloom-switch-office"
      }
    },
    {
      "name": "intranet",
      "role": "target",
      "arch": "amd64",
      "addresses": {
        "servers": "10.70.99.10"
      },
      "native": {
        "service": "intranet"
      },
      "ports": [
        {
          "name": "web",
          "port": 80,
          "protocol": "tcp",
          "http": true
        }
      ]
    },
    {
      "name": "intranet-routes",
      "role": "infra",
      "of": "intranet",
      "addresses": {},
      "native": {
        "service": "intranet-routes"
      }
    },
    {
      "name": "staff",
      "role": "access",
      "arch": "amd64",
      "addresses": {
        "office-vlan10": "10.70.10.10"
      },
      "native": {
        "service": "staff"
      }
    },
    {
      "name": "staff-routes",
      "role": "infra",
      "of": "staff",
      "addresses": {},
      "native": {
        "service": "staff-routes"
      }
    },
    {
      "name": "guest",
      "role": "target",
      "arch": "amd64",
      "addresses": {
        "office-vlan20": "10.70.20.10"
      },
      "native": {
        "service": "guest"
      }
    },
    {
      "name": "guest-routes",
      "role": "infra",
      "of": "guest",
      "addresses": {},
      "native": {
        "service": "guest-routes"
      }
    },
    {
      "name": "admin",
      "role": "target",
      "arch": "amd64",
      "addresses": {
        "office-vlan10": "10.70.10.50",
        "office-vlan20": "10.70.20.50"
      },
      "native": {
        "service": "admin"
      }
    },
    {
      "name": "admin-routes",
      "role": "infra",
      "of": "admin",
      "addresses": {},
      "native": {
        "service": "admin-routes"
      }
    },
    {
      "name": "isoloom-check",
      "role": "check",
      "of": "staff",
      "addresses": {},
      "native": {
        "service": "isoloom-check"
      }
    },
    {
      "name": "isoloom-check-intranet",
      "role": "check",
      "of": "intranet",
      "addresses": {},
      "native": {
        "service": "isoloom-check-intranet"
      }
    },
    {
      "name": "isoloom-check-guest",
      "role": "check",
      "of": "guest",
      "addresses": {},
      "native": {
        "service": "isoloom-check-guest"
      }
    },
    {
      "name": "isoloom-check-admin",
      "role": "check",
      "of": "admin",
      "addresses": {},
      "native": {
        "service": "isoloom-check-admin"
      }
    },
    {
      "name": "isoloom-probe-amd64",
      "role": "infra",
      "addresses": {},
      "native": {
        "service": "isoloom-probe-amd64"
      }
    }
  ],
  "lifecycle": {
    "up": [
      {
        "id": "clear-lock",
        "action": "terraform.clear_lock"
      },
      {
        "id": "init",
        "note": "Preparing Terraform and its providers…",
        "argv": [
          "terraform",
          "init",
          "-input=false",
          "-no-color",
          "-backend-config=path=${run.state_dir}/terraform.tfstate"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 900
      },
      {
        "id": "apply",
        "note": "Creating the Docker host in the cloud…",
        "argv": [
          "terraform",
          "apply",
          "-auto-approve",
          "-input=false",
          "-no-color"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 3600
      },
      {
        "id": "docker",
        "note": "Installing Docker in the VM…",
        "action": "ssh.run",
        "with": {
          "command": "sudo sh -s",
          "host": "${outputs.ip}",
          "user": "root",
          "wait_s": "300"
        },
        "stdin": "setup.sh",
        "timeout_s": 1800
      },
      {
        "id": "archive",
        "note": "Archiving the project…",
        "action": "project.archive",
        "with": {
          "root": "../../.."
        }
      },
      {
        "id": "project",
        "note": "Copying the project into the VM…",
        "action": "ssh.run",
        "with": {
          "command": "sudo rm -rf /opt/isoloom && sudo mkdir -p /opt/isoloom && sudo tar -xzf - -C /opt/isoloom",
          "host": "${outputs.ip}",
          "user": "root"
        },
        "stdin": "${run.state_dir}/project.tgz",
        "timeout_s": 600
      },
      {
        "id": "start",
        "note": "Starting the lab's containers in the VM…",
        "action": "ssh.run",
        "with": {
          "command": "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name vlan-office --file .isoloom/docker/compose.yml up --detach --build --pull missing --wait --wait-timeout 600",
          "host": "${outputs.ip}",
          "user": "root"
        },
        "timeout_s": 1800
      }
    ],
    "down": [
      {
        "id": "clear-lock",
        "action": "terraform.clear_lock"
      },
      {
        "id": "init",
        "note": "Preparing Terraform and its providers…",
        "argv": [
          "terraform",
          "init",
          "-input=false",
          "-no-color",
          "-backend-config=path=${run.state_dir}/terraform.tfstate"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 900
      },
      {
        "id": "destroy",
        "note": "Removing the lab from the cloud…",
        "argv": [
          "terraform",
          "destroy",
          "-auto-approve",
          "-input=false",
          "-no-color"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 3600
      }
    ],
    "status": {
      "id": "state",
      "action": "terraform.read_state"
    }
  },
  "ready": [
    {
      "kind": "step_ok",
      "step": "apply",
      "means": "the Docker host exists and booted"
    },
    {
      "kind": "step_ok",
      "step": "start",
      "means": "every long-running service is healthy (`--wait`: each port's probe, the route keepers, the machines' own healthchecks)"
    }
  ],
  "outputs": [
    {
      "name": "ip",
      "description": "The Docker host's address: SSH reaches it there, and its containers' published ports answer there.",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ip"
      }
    },
    {
      "name": "ssh_user",
      "description": "The user the runner's key lets in on the Docker host.",
      "role": "info",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ssh_user"
      }
    }
  ],
  "checks": {
    "protocol": "isoloom-check/1",
    "setup": [],
    "runners": [
      {
        "id": "isoloom-check",
        "from": "from staff",
        "checks": [
          {
            "name": "staff reach the intranet",
            "kind": "http",
            "wait_s": 60,
            "derived": false
          },
          {
            "name": "intranet:80 from staff",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "no internet from staff",
            "kind": "http",
            "wait_s": 0,
            "derived": true
          }
        ],
        "step": {
          "id": "check-staff",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name vlan-office --file .isoloom/docker/compose.yml --profile check run --rm --no-deps --env ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} isoloom-check",
            "host": "${outputs.ip}",
            "user": "root"
          },
          "timeout_s": 195
        },
        "on_timeout": [
          {
            "id": "rm-check-staff",
            "action": "ssh.run",
            "with": {
              "command": "sudo docker ps -aq --filter label=com.docker.compose.project=vlan-office --filter label=com.docker.compose.service=isoloom-check --filter label=com.docker.compose.oneoff=True | xargs -r sudo docker rm -f",
              "host": "${outputs.ip}",
              "user": "root"
            },
            "timeout_s": 60
          }
        ]
      },
      {
        "id": "isoloom-check-intranet",
        "from": "from intranet",
        "checks": [
          {
            "name": "no internet from intranet",
            "kind": "http",
            "wait_s": 0,
            "derived": true
          }
        ],
        "step": {
          "id": "check-intranet",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name vlan-office --file .isoloom/docker/compose.yml --profile check run --rm --no-deps --env ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} isoloom-check-intranet",
            "host": "${outputs.ip}",
            "user": "root"
          },
          "timeout_s": 75
        },
        "on_timeout": [
          {
            "id": "rm-check-intranet",
            "action": "ssh.run",
            "with": {
              "command": "sudo docker ps -aq --filter label=com.docker.compose.project=vlan-office --filter label=com.docker.compose.service=isoloom-check-intranet --filter label=com.docker.compose.oneoff=True | xargs -r sudo docker rm -f",
              "host": "${outputs.ip}",
              "user": "root"
            },
            "timeout_s": 60
          }
        ]
      },
      {
        "id": "isoloom-check-guest",
        "from": "from guest",
        "checks": [
          {
            "name": "guests don't",
            "kind": "tcp",
            "wait_s": 0,
            "derived": false
          },
          {
            "name": "intranet:80 blocked from guest",
            "kind": "tcp",
            "wait_s": 0,
            "derived": true
          }
        ],
        "step": {
          "id": "check-guest",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name vlan-office --file .isoloom/docker/compose.yml --profile check run --rm --no-deps --env ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} isoloom-check-guest",
            "host": "${outputs.ip}",
            "user": "root"
          },
          "timeout_s": 90
        },
        "on_timeout": [
          {
            "id": "rm-check-guest",
            "action": "ssh.run",
            "with": {
              "command": "sudo docker ps -aq --filter label=com.docker.compose.project=vlan-office --filter label=com.docker.compose.service=isoloom-check-guest --filter label=com.docker.compose.oneoff=True | xargs -r sudo docker rm -f",
              "host": "${outputs.ip}",
              "user": "root"
            },
            "timeout_s": 60
          }
        ]
      },
      {
        "id": "isoloom-check-admin",
        "from": "from admin",
        "checks": [
          {
            "name": "the admin box reaches the intranet over its trunk",
            "kind": "http",
            "wait_s": 60,
            "derived": false
          },
          {
            "name": "intranet:80 from admin",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          }
        ],
        "step": {
          "id": "check-admin",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name vlan-office --file .isoloom/docker/compose.yml --profile check run --rm --no-deps --env ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} isoloom-check-admin",
            "host": "${outputs.ip}",
            "user": "root"
          },
          "timeout_s": 180
        },
        "on_timeout": [
          {
            "id": "rm-check-admin",
            "action": "ssh.run",
            "with": {
              "command": "sudo docker ps -aq --filter label=com.docker.compose.project=vlan-office --filter label=com.docker.compose.service=isoloom-check-admin --filter label=com.docker.compose.oneoff=True | xargs -r sudo docker rm -f",
              "host": "${outputs.ip}",
              "user": "root"
            },
            "timeout_s": 60
          }
        ]
      }
    ],
    "teardown": []
  },
  "recovery": {
    "retries": 0,
    "apply_retries": 1
  },
  "expiry": {
    "tf_var": "expires_at",
    "unit": "unix_seconds",
    "default_minutes": 240
  },
  "guest": {
    "machine": "isoloom-docker-host",
    "host": "${outputs.ip}",
    "status": {
      "id": "ps",
      "action": "ssh.run",
      "with": {
        "command": "if command -v docker >/dev/null; then sudo docker compose --project-name vlan-office ps --all --format json; fi",
        "host": "${outputs.ip}",
        "user": "root"
      },
      "timeout_s": 60
    }
  }
}

## .isoloom/cloud-docker/digitalocean/setup.sh
#!/bin/sh
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# The Docker host's set-up, piped into `sudo sh -s` over SSH by its run manifest.
set -e
cloud-init status --wait >/dev/null 2>&1 || true
command -v docker >/dev/null || if command -v apt-get >/dev/null; then (
  set -e
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -qq
  apt-get install -y -qq ca-certificates curl
  install -m 0755 -d /etc/apt/keyrings
  k=$(mktemp)
  # shellcheck disable=SC1091,SC2154 # /etc/os-release is on the guest, not here.
  _id=$(. /etc/os-release && printf %s "$ID")
  # shellcheck disable=SC1091,SC2154
  _cn=$(. /etc/os-release && printf %s "$VERSION_CODENAME")
  curl -fsSL "https://download.docker.com/linux/$_id/gpg" -o "$k"
  echo "1500c1f56fa9e26b9b8f42452a553675796ade0807cdce11975eb98170b3a570  $k" | sha256sum -c -
  install -m 0644 "$k" /etc/apt/keyrings/docker.asc
  rm -f "$k"
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/$_id $_cn stable" > /etc/apt/sources.list.d/docker.list
  apt-get update -qq
  v=$(apt-cache madison docker-ce | awk '$3 ~ /(^|:)29[.]9[.]0/ { print $3; exit }')
  [ -n "$v" ] || { echo "docker-ce 29.9.0 is not in Docker's apt repository" >&2; exit 1; }
  apt-get install -y -qq --allow-downgrades "docker-ce=$v" "docker-ce-cli=$v" containerd.io docker-buildx-plugin "docker-compose-plugin=5.6.0-*"
)
else
  curl -fsSL https://get.docker.com | VERSION=29.9.0 sh
fi
cat > /etc/systemd/system/isoloom-published.service <<'UNIT'
[Unit]
Description=Isoloom: published ports reach containers of networks without a default route
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'iptables -t nat -C POSTROUTING -m conntrack --ctstate DNAT -o br-+ -j MASQUERADE 2>/dev/null || iptables -t nat -I POSTROUTING -m conntrack --ctstate DNAT -o br-+ -j MASQUERADE'

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now isoloom-published.service

## .isoloom/cloud-docker/gcp/main.tf
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  terraform -chdir=.isoloom/cloud-docker/gcp init && terraform -chdir=.isoloom/cloud-docker/gcp apply \
#           -var allowed_cidr=<your IP>/32 -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)"
# Stop:   terraform -chdir=.isoloom/cloud-docker/gcp destroy (same variables)
# Then:   the machines wait for the project: run the lab through the Isothrum runner (run.json
#         beside this file), which delivers the project over SSH, waits for each set-up and runs the checks.

terraform {
  required_version = ">= 1.6"
  backend "local" {}
  required_providers {
    google = { source = "hashicorp/google", version = "~> 8.5.0" }
  }
}

variable "project" {
  type        = string
  default     = ""
  description = "An existing project; or leave empty and give billing_account for a project of its own"
}

variable "billing_account" {
  type        = string
  default     = ""
  description = "With no project: create one for this environment, billed here, deleted with it"
}

variable "org_id" {
  type    = string
  default = ""
}

variable "region" {
  type    = string
  default = "europe-west9"
}

variable "machine_type" {
  type    = string
  default = "e2-medium"
}

variable "allowed_cidr" {
  type        = string
  description = "Who may reach the machines (SSH and the published ports), e.g. your IP/32"
}

variable "ssh_public_key" {
  type        = string
  description = "The key the machines let in: the Isothrum runner's (it delivers the project and runs the checks over SSH)"
}

variable "expires_at" {
  type        = string
  default     = ""
  description = "When the environment should end, in Unix seconds (empty: no end): a tag on every resource, so a reaper finds what to destroy, and the time the machines shut themselves down"
}

provider "google" {
  region = var.region
}

# A project of its own when none is given: everything goes when the environment is destroyed.
resource "google_project" "env" {
  count               = var.project == "" ? 1 : 0
  name                = "isoloom-vlan-office"
  project_id          = "isoloom-${terraform_data.id.output}"
  billing_account     = var.billing_account
  org_id              = var.org_id == "" ? null : var.org_id
  deletion_policy     = "DELETE"
  auto_create_network = false
}

resource "google_project_service" "compute" {
  count              = var.project == "" ? 1 : 0
  project            = google_project.env[0].project_id
  service            = "compute.googleapis.com"
  disable_on_destroy = false
}

resource "terraform_data" "id" {
  input = substr(replace(uuid(), "-", ""), 0, 8)
  lifecycle {
    ignore_changes = [input]
  }
}

locals {
  name    = "isoloom-vlan-office-${terraform_data.id.output}"
  project = var.project != "" ? var.project : google_project_service.compute[0].project
}

resource "google_compute_network" "env" {
  project                 = local.project
  name                    = local.name
  auto_create_subnetworks = false
}

resource "google_compute_subnetwork" "env" {
  project       = local.project
  name          = local.name
  network       = google_compute_network.env.id
  ip_cidr_range = "10.42.1.0/24"
  region        = var.region
}

resource "google_compute_firewall" "env" {
  project       = local.project
  name          = local.name
  network       = google_compute_network.env.id
  source_ranges = [var.allowed_cidr]
  allow {
    protocol = "tcp"
    ports    = ["22"]
  }
}

resource "google_compute_instance" "env" {
  project      = local.project
  name         = local.name
  machine_type = var.machine_type
  zone         = "${var.region}-a"
  labels = {
    isoloom-environment = "vlan-office"
    managed-by          = "isoloom"
    isoloom-instance    = local.name
    isoloom-expires-at  = var.expires_at
  }
  boot_disk {
    initialize_params {
      image = "debian-cloud/debian-12"
      size  = 30
    }
  }
  network_interface {
    subnetwork = google_compute_subnetwork.env.id
    access_config {}
  }
  metadata = {
    ssh-keys       = "isoloom:${var.ssh_public_key}"
    startup-script = "#!/bin/sh\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\n"
  }
}

output "ip" {
  value = google_compute_instance.env.network_interface[0].access_config[0].nat_ip
}

output "ssh_user" {
  value = "isoloom"
}

## .isoloom/cloud-docker/gcp/run.json
{
  "$schema": "https://www.isoloom.com/schema/run-manifest/v0.json",
  "manifest_version": 0,
  "generator": {
    "name": "isoloom",
    "version": "0.11.1"
  },
  "lab": {
    "name": "vlan-office",
    "instance": null,
    "message": null
  },
  "target": "cloud-docker",
  "cloud": "gcp",
  "driver": "terraform",
  "hosts": [
    "linux",
    "macos",
    "windows"
  ],
  "tools": [
    {
      "name": "terraform",
      "probe": [
        "terraform",
        "version"
      ],
      "min_version": "1.11.0"
    },
    {
      "name": "ssh",
      "probe": [
        "ssh",
        "-V"
      ]
    }
  ],
  "identity": {
    "terraform": {
      "module": ".",
      "state": "runner"
    }
  },
  "params": [
    {
      "name": "project",
      "description": "An existing project; or leave empty and give billing_account for a project of its own.",
      "default": "",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "project"
        }
      ]
    },
    {
      "name": "billing_account",
      "description": "With no project: create one for this environment, billed here, deleted with it.",
      "default": "",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "billing_account"
        }
      ]
    },
    {
      "name": "org_id",
      "description": "The module's `org_id`.",
      "default": "",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "org_id"
        }
      ]
    },
    {
      "name": "region",
      "description": "The module's `region`.",
      "default": "europe-west9",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "region"
        }
      ]
    },
    {
      "name": "machine_type",
      "description": "The module's `machine_type`.",
      "default": "e2-medium",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "machine_type"
        }
      ]
    },
    {
      "name": "allowed_cidr",
      "description": "Who may reach the machines (SSH and the published ports), e.g. your IP/32.",
      "required": true,
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "allowed_cidr"
        }
      ]
    },
    {
      "name": "ISOLOOM_DERIVED",
      "description": "0: the checks derived from the spec (reachability, no internet) are skipped.",
      "default": "1",
      "values": [
        "0",
        "1"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_DERIVED",
          "steps": [
            "check-staff",
            "check-intranet",
            "check-guest",
            "check-admin"
          ]
        }
      ]
    }
  ],
  "secrets": [
    {
      "name": "GOOGLE_OAUTH_ACCESS_TOKEN",
      "kind": "connection",
      "required": false,
      "sensitive": true,
      "source": {
        "store": "env",
        "reference": "GOOGLE_OAUTH_ACCESS_TOKEN"
      },
      "deliver": [
        {
          "via": "env",
          "var": "GOOGLE_OAUTH_ACCESS_TOKEN",
          "steps": [
            "init",
            "apply",
            "destroy"
          ]
        }
      ]
    },
    {
      "name": "GOOGLE_CREDENTIALS",
      "kind": "connection",
      "required": false,
      "sensitive": true,
      "source": {
        "store": "env",
        "reference": "GOOGLE_CREDENTIALS"
      },
      "deliver": [
        {
          "via": "env",
          "var": "GOOGLE_CREDENTIALS",
          "steps": [
            "init",
            "apply",
            "destroy"
          ]
        }
      ]
    }
  ],
  "networks": [],
  "machines": [
    {
      "name": "isoloom-docker-host",
      "role": "infra",
      "resources": {
        "cpus": 4,
        "memory_mb": 3072
      },
      "addresses": {}
    },
    {
      "name": "isoloom-router",
      "role": "infra",
      "addresses": {
        "office-vlan10": "10.70.10.254",
        "office-vlan20": "10.70.20.254",
        "servers": "10.70.99.254"
      },
      "native": {
        "service": "isoloom-router"
      }
    },
    {
      "name": "isoloom-switch-office",
      "role": "infra",
      "addresses": {},
      "native": {
        "service": "isoloom-switch-office"
      }
    },
    {
      "name": "intranet",
      "role": "target",
      "arch": "amd64",
      "addresses": {
        "servers": "10.70.99.10"
      },
      "native": {
        "service": "intranet"
      },
      "ports": [
        {
          "name": "web",
          "port": 80,
          "protocol": "tcp",
          "http": true
        }
      ]
    },
    {
      "name": "intranet-routes",
      "role": "infra",
      "of": "intranet",
      "addresses": {},
      "native": {
        "service": "intranet-routes"
      }
    },
    {
      "name": "staff",
      "role": "access",
      "arch": "amd64",
      "addresses": {
        "office-vlan10": "10.70.10.10"
      },
      "native": {
        "service": "staff"
      }
    },
    {
      "name": "staff-routes",
      "role": "infra",
      "of": "staff",
      "addresses": {},
      "native": {
        "service": "staff-routes"
      }
    },
    {
      "name": "guest",
      "role": "target",
      "arch": "amd64",
      "addresses": {
        "office-vlan20": "10.70.20.10"
      },
      "native": {
        "service": "guest"
      }
    },
    {
      "name": "guest-routes",
      "role": "infra",
      "of": "guest",
      "addresses": {},
      "native": {
        "service": "guest-routes"
      }
    },
    {
      "name": "admin",
      "role": "target",
      "arch": "amd64",
      "addresses": {
        "office-vlan10": "10.70.10.50",
        "office-vlan20": "10.70.20.50"
      },
      "native": {
        "service": "admin"
      }
    },
    {
      "name": "admin-routes",
      "role": "infra",
      "of": "admin",
      "addresses": {},
      "native": {
        "service": "admin-routes"
      }
    },
    {
      "name": "isoloom-check",
      "role": "check",
      "of": "staff",
      "addresses": {},
      "native": {
        "service": "isoloom-check"
      }
    },
    {
      "name": "isoloom-check-intranet",
      "role": "check",
      "of": "intranet",
      "addresses": {},
      "native": {
        "service": "isoloom-check-intranet"
      }
    },
    {
      "name": "isoloom-check-guest",
      "role": "check",
      "of": "guest",
      "addresses": {},
      "native": {
        "service": "isoloom-check-guest"
      }
    },
    {
      "name": "isoloom-check-admin",
      "role": "check",
      "of": "admin",
      "addresses": {},
      "native": {
        "service": "isoloom-check-admin"
      }
    },
    {
      "name": "isoloom-probe-amd64",
      "role": "infra",
      "addresses": {},
      "native": {
        "service": "isoloom-probe-amd64"
      }
    }
  ],
  "lifecycle": {
    "up": [
      {
        "id": "clear-lock",
        "action": "terraform.clear_lock"
      },
      {
        "id": "init",
        "note": "Preparing Terraform and its providers…",
        "argv": [
          "terraform",
          "init",
          "-input=false",
          "-no-color",
          "-backend-config=path=${run.state_dir}/terraform.tfstate"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 900
      },
      {
        "id": "apply",
        "note": "Creating the Docker host in the cloud…",
        "argv": [
          "terraform",
          "apply",
          "-auto-approve",
          "-input=false",
          "-no-color"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 3600
      },
      {
        "id": "docker",
        "note": "Installing Docker in the VM…",
        "action": "ssh.run",
        "with": {
          "command": "sudo sh -s",
          "host": "${outputs.ip}",
          "user": "isoloom",
          "wait_s": "300"
        },
        "stdin": "setup.sh",
        "timeout_s": 1800
      },
      {
        "id": "archive",
        "note": "Archiving the project…",
        "action": "project.archive",
        "with": {
          "root": "../../.."
        }
      },
      {
        "id": "project",
        "note": "Copying the project into the VM…",
        "action": "ssh.run",
        "with": {
          "command": "sudo rm -rf /opt/isoloom && sudo mkdir -p /opt/isoloom && sudo tar -xzf - -C /opt/isoloom",
          "host": "${outputs.ip}",
          "user": "isoloom"
        },
        "stdin": "${run.state_dir}/project.tgz",
        "timeout_s": 600
      },
      {
        "id": "start",
        "note": "Starting the lab's containers in the VM…",
        "action": "ssh.run",
        "with": {
          "command": "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name vlan-office --file .isoloom/docker/compose.yml up --detach --build --pull missing --wait --wait-timeout 600",
          "host": "${outputs.ip}",
          "user": "isoloom"
        },
        "timeout_s": 1800
      }
    ],
    "down": [
      {
        "id": "clear-lock",
        "action": "terraform.clear_lock"
      },
      {
        "id": "init",
        "note": "Preparing Terraform and its providers…",
        "argv": [
          "terraform",
          "init",
          "-input=false",
          "-no-color",
          "-backend-config=path=${run.state_dir}/terraform.tfstate"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 900
      },
      {
        "id": "destroy",
        "note": "Removing the lab from the cloud…",
        "argv": [
          "terraform",
          "destroy",
          "-auto-approve",
          "-input=false",
          "-no-color"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 3600
      }
    ],
    "status": {
      "id": "state",
      "action": "terraform.read_state"
    }
  },
  "ready": [
    {
      "kind": "step_ok",
      "step": "apply",
      "means": "the Docker host exists and booted"
    },
    {
      "kind": "step_ok",
      "step": "start",
      "means": "every long-running service is healthy (`--wait`: each port's probe, the route keepers, the machines' own healthchecks)"
    }
  ],
  "outputs": [
    {
      "name": "ip",
      "description": "The Docker host's address: SSH reaches it there, and its containers' published ports answer there.",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ip"
      }
    },
    {
      "name": "ssh_user",
      "description": "The user the runner's key lets in on the Docker host.",
      "role": "info",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ssh_user"
      }
    }
  ],
  "checks": {
    "protocol": "isoloom-check/1",
    "setup": [],
    "runners": [
      {
        "id": "isoloom-check",
        "from": "from staff",
        "checks": [
          {
            "name": "staff reach the intranet",
            "kind": "http",
            "wait_s": 60,
            "derived": false
          },
          {
            "name": "intranet:80 from staff",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "no internet from staff",
            "kind": "http",
            "wait_s": 0,
            "derived": true
          }
        ],
        "step": {
          "id": "check-staff",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name vlan-office --file .isoloom/docker/compose.yml --profile check run --rm --no-deps --env ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} isoloom-check",
            "host": "${outputs.ip}",
            "user": "isoloom"
          },
          "timeout_s": 195
        },
        "on_timeout": [
          {
            "id": "rm-check-staff",
            "action": "ssh.run",
            "with": {
              "command": "sudo docker ps -aq --filter label=com.docker.compose.project=vlan-office --filter label=com.docker.compose.service=isoloom-check --filter label=com.docker.compose.oneoff=True | xargs -r sudo docker rm -f",
              "host": "${outputs.ip}",
              "user": "isoloom"
            },
            "timeout_s": 60
          }
        ]
      },
      {
        "id": "isoloom-check-intranet",
        "from": "from intranet",
        "checks": [
          {
            "name": "no internet from intranet",
            "kind": "http",
            "wait_s": 0,
            "derived": true
          }
        ],
        "step": {
          "id": "check-intranet",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name vlan-office --file .isoloom/docker/compose.yml --profile check run --rm --no-deps --env ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} isoloom-check-intranet",
            "host": "${outputs.ip}",
            "user": "isoloom"
          },
          "timeout_s": 75
        },
        "on_timeout": [
          {
            "id": "rm-check-intranet",
            "action": "ssh.run",
            "with": {
              "command": "sudo docker ps -aq --filter label=com.docker.compose.project=vlan-office --filter label=com.docker.compose.service=isoloom-check-intranet --filter label=com.docker.compose.oneoff=True | xargs -r sudo docker rm -f",
              "host": "${outputs.ip}",
              "user": "isoloom"
            },
            "timeout_s": 60
          }
        ]
      },
      {
        "id": "isoloom-check-guest",
        "from": "from guest",
        "checks": [
          {
            "name": "guests don't",
            "kind": "tcp",
            "wait_s": 0,
            "derived": false
          },
          {
            "name": "intranet:80 blocked from guest",
            "kind": "tcp",
            "wait_s": 0,
            "derived": true
          }
        ],
        "step": {
          "id": "check-guest",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name vlan-office --file .isoloom/docker/compose.yml --profile check run --rm --no-deps --env ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} isoloom-check-guest",
            "host": "${outputs.ip}",
            "user": "isoloom"
          },
          "timeout_s": 90
        },
        "on_timeout": [
          {
            "id": "rm-check-guest",
            "action": "ssh.run",
            "with": {
              "command": "sudo docker ps -aq --filter label=com.docker.compose.project=vlan-office --filter label=com.docker.compose.service=isoloom-check-guest --filter label=com.docker.compose.oneoff=True | xargs -r sudo docker rm -f",
              "host": "${outputs.ip}",
              "user": "isoloom"
            },
            "timeout_s": 60
          }
        ]
      },
      {
        "id": "isoloom-check-admin",
        "from": "from admin",
        "checks": [
          {
            "name": "the admin box reaches the intranet over its trunk",
            "kind": "http",
            "wait_s": 60,
            "derived": false
          },
          {
            "name": "intranet:80 from admin",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          }
        ],
        "step": {
          "id": "check-admin",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name vlan-office --file .isoloom/docker/compose.yml --profile check run --rm --no-deps --env ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} isoloom-check-admin",
            "host": "${outputs.ip}",
            "user": "isoloom"
          },
          "timeout_s": 180
        },
        "on_timeout": [
          {
            "id": "rm-check-admin",
            "action": "ssh.run",
            "with": {
              "command": "sudo docker ps -aq --filter label=com.docker.compose.project=vlan-office --filter label=com.docker.compose.service=isoloom-check-admin --filter label=com.docker.compose.oneoff=True | xargs -r sudo docker rm -f",
              "host": "${outputs.ip}",
              "user": "isoloom"
            },
            "timeout_s": 60
          }
        ]
      }
    ],
    "teardown": []
  },
  "recovery": {
    "retries": 0,
    "apply_retries": 1
  },
  "expiry": {
    "tf_var": "expires_at",
    "unit": "unix_seconds",
    "default_minutes": 240
  },
  "guest": {
    "machine": "isoloom-docker-host",
    "host": "${outputs.ip}",
    "status": {
      "id": "ps",
      "action": "ssh.run",
      "with": {
        "command": "if command -v docker >/dev/null; then sudo docker compose --project-name vlan-office ps --all --format json; fi",
        "host": "${outputs.ip}",
        "user": "isoloom"
      },
      "timeout_s": 60
    }
  }
}

## .isoloom/cloud-docker/gcp/setup.sh
#!/bin/sh
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# The Docker host's set-up, piped into `sudo sh -s` over SSH by its run manifest.
set -e
cloud-init status --wait >/dev/null 2>&1 || true
command -v docker >/dev/null || if command -v apt-get >/dev/null; then (
  set -e
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -qq
  apt-get install -y -qq ca-certificates curl
  install -m 0755 -d /etc/apt/keyrings
  k=$(mktemp)
  # shellcheck disable=SC1091,SC2154 # /etc/os-release is on the guest, not here.
  _id=$(. /etc/os-release && printf %s "$ID")
  # shellcheck disable=SC1091,SC2154
  _cn=$(. /etc/os-release && printf %s "$VERSION_CODENAME")
  curl -fsSL "https://download.docker.com/linux/$_id/gpg" -o "$k"
  echo "1500c1f56fa9e26b9b8f42452a553675796ade0807cdce11975eb98170b3a570  $k" | sha256sum -c -
  install -m 0644 "$k" /etc/apt/keyrings/docker.asc
  rm -f "$k"
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/$_id $_cn stable" > /etc/apt/sources.list.d/docker.list
  apt-get update -qq
  v=$(apt-cache madison docker-ce | awk '$3 ~ /(^|:)29[.]9[.]0/ { print $3; exit }')
  [ -n "$v" ] || { echo "docker-ce 29.9.0 is not in Docker's apt repository" >&2; exit 1; }
  apt-get install -y -qq --allow-downgrades "docker-ce=$v" "docker-ce-cli=$v" containerd.io docker-buildx-plugin "docker-compose-plugin=5.6.0-*"
)
else
  curl -fsSL https://get.docker.com | VERSION=29.9.0 sh
fi
cat > /etc/systemd/system/isoloom-published.service <<'UNIT'
[Unit]
Description=Isoloom: published ports reach containers of networks without a default route
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'iptables -t nat -C POSTROUTING -m conntrack --ctstate DNAT -o br-+ -j MASQUERADE 2>/dev/null || iptables -t nat -I POSTROUTING -m conntrack --ctstate DNAT -o br-+ -j MASQUERADE'

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now isoloom-published.service

## .isoloom/cloud-docker/linode/main.tf
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  terraform -chdir=.isoloom/cloud-docker/linode init && terraform -chdir=.isoloom/cloud-docker/linode apply \
#           -var allowed_cidr=<your IP>/32 -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)"
# Stop:   terraform -chdir=.isoloom/cloud-docker/linode destroy (same variables)
# Then:   the machines wait for the project: run the lab through the Isothrum runner (run.json
#         beside this file), which delivers the project over SSH, waits for each set-up and runs the checks.

terraform {
  required_version = ">= 1.6"
  backend "local" {}
  required_providers {
    linode = { source = "linode/linode", version = "~> 4.7.0" }
  }
}

variable "region" {
  type    = string
  default = "fr-par"
}

variable "type" {
  type    = string
  default = "g6-standard-2"
}

variable "allowed_cidr" {
  type        = string
  description = "Who may reach the machines (SSH and the published ports), e.g. your IP/32"
}

variable "ssh_public_key" {
  type        = string
  description = "The key the machines let in: the Isothrum runner's (it delivers the project and runs the checks over SSH)"
}

variable "expires_at" {
  type        = string
  default     = ""
  description = "When the environment should end, in Unix seconds (empty: no end): a tag on every resource, so a reaper finds what to destroy, and the time the machines shut themselves down"
}

resource "terraform_data" "id" {
  input = substr(replace(uuid(), "-", ""), 0, 8)
  lifecycle {
    ignore_changes = [input]
  }
}

locals {
  name = "isoloom-vlan-office-${terraform_data.id.output}"
}

resource "linode_instance" "env" {
  label           = local.name
  region          = var.region
  type            = var.type
  image           = "linode/debian12"
  authorized_keys = [trimspace(var.ssh_public_key)]
  metadata {
    user_data = base64encode("#!/bin/sh\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\n")
  }
  tags = concat(["isoloom", "vlan-office", local.name], var.expires_at == "" ? [] : ["isoloom-expires-${var.expires_at}"])
}

resource "linode_firewall" "env" {
  label           = local.name
  inbound_policy  = "DROP"
  outbound_policy = "ACCEPT"
  inbound {
    label    = "ssh-and-published"
    action   = "ACCEPT"
    protocol = "TCP"
    ports    = "22"
    ipv4     = [var.allowed_cidr]
  }
  linodes = [linode_instance.env.id]
}

output "ip" {
  value = one(linode_instance.env.ipv4)
}

output "ssh_user" {
  value = "root"
}

## .isoloom/cloud-docker/linode/run.json
{
  "$schema": "https://www.isoloom.com/schema/run-manifest/v0.json",
  "manifest_version": 0,
  "generator": {
    "name": "isoloom",
    "version": "0.11.1"
  },
  "lab": {
    "name": "vlan-office",
    "instance": null,
    "message": null
  },
  "target": "cloud-docker",
  "cloud": "linode",
  "driver": "terraform",
  "hosts": [
    "linux",
    "macos",
    "windows"
  ],
  "tools": [
    {
      "name": "terraform",
      "probe": [
        "terraform",
        "version"
      ],
      "min_version": "1.11.0"
    },
    {
      "name": "ssh",
      "probe": [
        "ssh",
        "-V"
      ]
    }
  ],
  "identity": {
    "terraform": {
      "module": ".",
      "state": "runner"
    }
  },
  "params": [
    {
      "name": "region",
      "description": "The module's `region`.",
      "default": "fr-par",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "region"
        }
      ]
    },
    {
      "name": "type",
      "description": "The module's `type`.",
      "default": "g6-standard-2",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "type"
        }
      ]
    },
    {
      "name": "allowed_cidr",
      "description": "Who may reach the machines (SSH and the published ports), e.g. your IP/32.",
      "required": true,
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "allowed_cidr"
        }
      ]
    },
    {
      "name": "ISOLOOM_DERIVED",
      "description": "0: the checks derived from the spec (reachability, no internet) are skipped.",
      "default": "1",
      "values": [
        "0",
        "1"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_DERIVED",
          "steps": [
            "check-staff",
            "check-intranet",
            "check-guest",
            "check-admin"
          ]
        }
      ]
    }
  ],
  "secrets": [
    {
      "name": "LINODE_TOKEN",
      "kind": "connection",
      "required": true,
      "sensitive": true,
      "source": {
        "store": "env",
        "reference": "LINODE_TOKEN"
      },
      "deliver": [
        {
          "via": "env",
          "var": "LINODE_TOKEN",
          "steps": [
            "init",
            "apply",
            "destroy"
          ]
        }
      ]
    }
  ],
  "networks": [],
  "machines": [
    {
      "name": "isoloom-docker-host",
      "role": "infra",
      "resources": {
        "cpus": 4,
        "memory_mb": 3072
      },
      "addresses": {}
    },
    {
      "name": "isoloom-router",
      "role": "infra",
      "addresses": {
        "office-vlan10": "10.70.10.254",
        "office-vlan20": "10.70.20.254",
        "servers": "10.70.99.254"
      },
      "native": {
        "service": "isoloom-router"
      }
    },
    {
      "name": "isoloom-switch-office",
      "role": "infra",
