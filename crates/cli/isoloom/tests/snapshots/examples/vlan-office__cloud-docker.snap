      "native": {
        "service": "isoloom-switch-office"
      }
    },
    {
      "name": "intranet",
      "role": "target",
      "arch": "amd64",
      "addresses": {
        "servers": "10.70.99.10"
      },
      "native": {
        "service": "intranet"
      },
      "ports": [
        {
          "name": "web",
          "port": 80,
          "protocol": "tcp",
          "http": true
        }
      ]
    },
    {
      "name": "intranet-routes",
