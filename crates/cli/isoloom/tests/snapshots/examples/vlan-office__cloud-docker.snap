## .isoloom/cloud-docker/aws/main.tf
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  terraform -chdir=.isoloom/cloud-docker/aws init && terraform -chdir=.isoloom/cloud-docker/aws apply \
#           -var allowed_cidr=<your IP>/32 -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)"
# Stop:   terraform -chdir=.isoloom/cloud-docker/aws destroy (same variables)
# Then:   the machines wait for the project: run the lab through the Isothrum runner (run.json
#         beside this file), which delivers the project over SSH, waits for each set-up and runs the checks.

terraform {
  required_version = ">= 1.6"
  backend "local" {}
  required_providers {
    aws = { source = "hashicorp/aws", version = "~> 6.67.0" }
  }
}

variable "region" {
  type    = string
  default = "eu-west-3"
}

variable "instance_type" {
  type    = string
  default = "c7i-flex.large"
}

variable "allowed_cidr" {
  type        = string
  description = "Who may reach the machines (SSH and the published ports), e.g. your IP/32"
}

variable "ssh_public_key" {
  type        = string
  description = "The key the machines let in: the Isothrum runner's (it delivers the project and runs the checks over SSH)"
}

variable "expires_at" {
  type        = string
  default     = ""
  description = "When the environment should end, in Unix seconds (empty: no end): a tag on every resource, so a reaper finds what to destroy, and the time the machines shut themselves down"
}

provider "aws" {
  region = var.region
  default_tags {
    tags = {
      "isoloom:environment" = "vlan-office"
      managed-by            = "isoloom"
      isoloom-expires-at    = var.expires_at
    }
  }
}

resource "terraform_data" "id" {
  input = substr(replace(uuid(), "-", ""), 0, 8)
  lifecycle {
    ignore_changes = [input]
  }
}

locals {
  name = "isoloom-vlan-office-${terraform_data.id.output}"
}

data "aws_availability_zones" "available" {
  state = "available"
}

data "aws_ami" "debian" {
  most_recent = true
  owners      = ["136693071363"]
  filter {
    name   = "name"
    values = ["debian-12-amd64-*"]
  }
}

resource "aws_vpc" "env" {
  cidr_block = "10.42.0.0/16"
  tags       = { Name = local.name }
}

resource "aws_internet_gateway" "env" {
  vpc_id = aws_vpc.env.id
  tags   = { Name = local.name }
}

resource "aws_subnet" "env" {
  vpc_id                  = aws_vpc.env.id
  cidr_block              = "10.42.1.0/24"
  availability_zone       = data.aws_availability_zones.available.names[0]
  map_public_ip_on_launch = true
  tags                    = { Name = local.name }
}

resource "aws_route_table" "env" {
  vpc_id = aws_vpc.env.id
  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.env.id
  }
  tags = { Name = local.name }
}

resource "aws_route_table_association" "env" {
  subnet_id      = aws_subnet.env.id
  route_table_id = aws_route_table.env.id
}

resource "aws_key_pair" "env" {
  key_name   = local.name
  public_key = var.ssh_public_key
}

resource "aws_security_group" "env" {
  name   = local.name
  vpc_id = aws_vpc.env.id
  ingress {
    description = "SSH"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [var.allowed_cidr]
  }
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_instance" "env" {
  ami                                  = data.aws_ami.debian.id
  instance_type                        = var.instance_type
  subnet_id                            = aws_subnet.env.id
  key_name                             = aws_key_pair.env.key_name
  vpc_security_group_ids               = [aws_security_group.env.id]
  instance_initiated_shutdown_behavior = "terminate"
  user_data_base64                     = base64gzip("#!/bin/sh\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\n")
  root_block_device {
    volume_size = 20
    volume_type = "gp3"
    encrypted   = true
  }
  metadata_options {
    http_tokens = "required"
  }
  depends_on = [aws_route_table_association.env]
  tags       = { Name = local.name }
}

output "ip" {
  value = aws_instance.env.public_ip
}

output "ssh_user" {
  value = "admin"
}

## .isoloom/cloud-docker/aws/run.json
{
  "$schema": "https://www.isoloom.com/schema/run-manifest/v0.json",
  "manifest_version": 0,
  "generator": {
    "name": "isoloom",
    "version": "0.11.1"
  },
  "lab": {
    "name": "vlan-office",
    "instance": null,
    "message": null
  },
  "target": "cloud-docker",
  "cloud": "aws",
  "driver": "terraform",
  "hosts": [
    "linux",
    "macos",
    "windows"
  ],
  "tools": [
    {
      "name": "terraform",
      "probe": [
        "terraform",
        "version"
      ],
      "min_version": "1.11.0"
    },
    {
      "name": "ssh",
      "probe": [
        "ssh",
        "-V"
      ]
    }
  ],
  "identity": {
    "terraform": {
      "module": ".",
      "state": "runner"
    }
  },
  "params": [
    {
      "name": "region",
      "description": "The module's `region`.",
      "default": "eu-west-3",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "region"
        }
      ]
    },
    {
      "name": "instance_type",
      "description": "The module's `instance_type`.",
      "default": "c7i-flex.large",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "instance_type"
        }
      ]
    },
    {
      "name": "allowed_cidr",
      "description": "Who may reach the machines (SSH and the published ports), e.g. your IP/32.",
      "required": true,
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "allowed_cidr"
        }
      ]
    },
    {
      "name": "AWS_PROFILE",
      "description": "The AWS CLI profile the provider signs in with (its credentials and settings), when no keys are given.",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "AWS_PROFILE",
          "steps": [
            "init",
            "apply",
            "destroy"
          ]
        }
      ]
    },
    {
      "name": "ISOLOOM_DERIVED",
      "description": "0: the checks derived from the spec (reachability, no internet) are skipped.",
      "default": "1",
      "values": [
        "0",
        "1"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_DERIVED",
          "steps": [
            "check-staff",
            "check-intranet",
            "check-guest",
            "check-admin"
          ]
        }
      ]
    }
  ],
  "secrets": [
    {
      "name": "AWS_ACCESS_KEY_ID",
      "kind": "connection",
      "required": false,
      "sensitive": true,
      "source": {
        "store": "env",
        "reference": "AWS_ACCESS_KEY_ID"
      },
      "deliver": [
        {
          "via": "env",
          "var": "AWS_ACCESS_KEY_ID",
          "steps": [
            "init",
            "apply",
            "destroy"
          ]
        }
      ]
    },
    {
      "name": "AWS_SECRET_ACCESS_KEY",
      "kind": "connection",
      "required": false,
      "sensitive": true,
      "source": {
        "store": "env",
        "reference": "AWS_SECRET_ACCESS_KEY"
      },
      "deliver": [
        {
          "via": "env",
          "var": "AWS_SECRET_ACCESS_KEY",
          "steps": [
            "init",
            "apply",
            "destroy"
          ]
        }
      ]
    },
    {
      "name": "AWS_SESSION_TOKEN",
      "kind": "connection",
      "required": false,
      "sensitive": true,
      "source": {
        "store": "env",
        "reference": "AWS_SESSION_TOKEN"
      },
      "deliver": [
        {
          "via": "env",
          "var": "AWS_SESSION_TOKEN",
          "steps": [
            "init",
            "apply",
            "destroy"
          ]
        }
      ]
    }
  ],
  "networks": [],
  "machines": [
    {
      "name": "isoloom-docker-host",
      "role": "infra",
      "resources": {
        "cpus": 4,
        "memory_mb": 3072
      },
      "addresses": {}
    },
    {
      "name": "isoloom-router",
      "role": "infra",
      "addresses": {
        "office-vlan10": "10.70.10.254",
        "office-vlan20": "10.70.20.254",
        "servers": "10.70.99.254"
      },
      "native": {
        "service": "isoloom-router"
      }
    },
    {
      "name": "isoloom-switch-office",
      "role": "infra",
      "addresses": {},
      "native": {
        "service": "isoloom-switch-office"
      }
    },
    {
      "name": "intranet",
      "role": "target",
      "arch": "amd64",
      "addresses": {
        "servers": "10.70.99.10"
      },
      "native": {
        "service": "intranet"
      },
      "ports": [
        {
          "name": "web",
          "port": 80,
          "protocol": "tcp",
          "http": true
        }
      ]
    },
    {
      "name": "intranet-routes",
      "role": "infra",
      "of": "intranet",
      "addresses": {},
      "native": {
        "service": "intranet-routes"
      }
    },
    {
      "name": "staff",
      "role": "access",
      "arch": "amd64",
      "addresses": {
        "office-vlan10": "10.70.10.10"
      },
      "native": {
        "service": "staff"
      }
    },
    {
      "name": "staff-routes",
      "role": "infra",
      "of": "staff",
      "addresses": {},
      "native": {
        "service": "staff-routes"
      }
    },
    {
      "name": "guest",
      "role": "target",
      "arch": "amd64",
      "addresses": {
        "office-vlan20": "10.70.20.10"
      },
      "native": {
        "service": "guest"
      }
    },
    {
      "name": "guest-routes",
      "role": "infra",
      "of": "guest",
      "addresses": {},
      "native": {
        "service": "guest-routes"
      }
    },
    {
      "name": "admin",
      "role": "target",
      "arch": "amd64",
      "addresses": {
        "office-vlan10": "10.70.10.50",
        "office-vlan20": "10.70.20.50"
      },
      "native": {
        "service": "admin"
      }
    },
    {
      "name": "admin-routes",
      "role": "infra",
      "of": "admin",
      "addresses": {},
      "native": {
        "service": "admin-routes"
      }
    },
    {
      "name": "isoloom-check",
      "role": "check",
      "of": "staff",
      "addresses": {},
      "native": {
        "service": "isoloom-check"
      }
    },
    {
      "name": "isoloom-check-intranet",
      "role": "check",
      "of": "intranet",
      "addresses": {},
      "native": {
        "service": "isoloom-check-intranet"
      }
    },
    {
      "name": "isoloom-check-guest",
      "role": "check",
      "of": "guest",
      "addresses": {},
      "native": {
        "service": "isoloom-check-guest"
      }
    },
    {
      "name": "isoloom-check-admin",
      "role": "check",
      "of": "admin",
      "addresses": {},
      "native": {
        "service": "isoloom-check-admin"
      }
    },
    {
      "name": "isoloom-probe-amd64",
      "role": "infra",
      "addresses": {},
      "native": {
        "service": "isoloom-probe-amd64"
      }
    }
  ],
  "lifecycle": {
    "up": [
      {
        "id": "clear-lock",
        "action": "terraform.clear_lock"
      },
      {
        "id": "init",
        "note": "Preparing Terraform and its providers…",
        "argv": [
          "terraform",
          "init",
          "-input=false",
          "-no-color",
          "-backend-config=path=${run.state_dir}/terraform.tfstate"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 900
      },
      {
        "id": "apply",
        "note": "Creating the Docker host in the cloud…",
        "argv": [
          "terraform",
          "apply",
          "-auto-approve",
          "-input=false",
          "-no-color"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 3600
      },
      {
        "id": "docker",
        "note": "Installing Docker in the VM…",
        "action": "ssh.run",
        "with": {
          "command": "sudo sh -s",
          "host": "${outputs.ip}",
          "user": "admin",
          "wait_s": "300"
        },
        "stdin": "setup.sh",
        "timeout_s": 1800
      },
      {
        "id": "archive",
        "note": "Archiving the project…",
        "action": "project.archive",
        "with": {
          "root": "../../.."
        }
      },
      {
        "id": "project",
        "note": "Copying the project into the VM…",
        "action": "ssh.run",
        "with": {
          "command": "sudo rm -rf /opt/isoloom && sudo mkdir -p /opt/isoloom && sudo tar -xzf - -C /opt/isoloom",
          "host": "${outputs.ip}",
          "user": "admin"
        },
        "stdin": "${run.state_dir}/project.tgz",
        "timeout_s": 600
      },
      {
        "id": "start",
        "note": "Starting the lab's containers in the VM…",
        "action": "ssh.run",
        "with": {
          "command": "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name vlan-office --file .isoloom/docker/compose.yml up --detach --build --pull missing --wait --wait-timeout 600",
          "host": "${outputs.ip}",
          "user": "admin"
        },
        "timeout_s": 1800
      }
    ],
    "down": [
      {
        "id": "clear-lock",
        "action": "terraform.clear_lock"
      },
      {
        "id": "init",
        "note": "Preparing Terraform and its providers…",
        "argv": [
          "terraform",
          "init",
          "-input=false",
          "-no-color",
          "-backend-config=path=${run.state_dir}/terraform.tfstate"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 900
      },
      {
        "id": "destroy",
        "note": "Removing the lab from the cloud…",
        "argv": [
          "terraform",
          "destroy",
          "-auto-approve",
          "-input=false",
          "-no-color"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 3600
      }
    ],
    "status": {
      "id": "state",
      "action": "terraform.read_state"
    }
  },
  "ready": [
    {
      "kind": "step_ok",
      "step": "apply",
      "means": "the Docker host exists and booted"
    },
    {
      "kind": "step_ok",
      "step": "start",
      "means": "every long-running service is healthy (`--wait`: each port's probe, the route keepers, the machines' own healthchecks)"
    }
  ],
  "outputs": [
    {
      "name": "ip",
      "description": "The Docker host's address: SSH reaches it there, and its containers' published ports answer there.",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ip"
      }
    },
    {
      "name": "ssh_user",
      "description": "The user the runner's key lets in on the Docker host.",
      "role": "info",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ssh_user"
      }
    }
  ],
  "checks": {
    "protocol": "isoloom-check/1",
    "setup": [],
    "runners": [
      {
        "id": "isoloom-check",
        "from": "from staff",
        "checks": [
          {
            "name": "staff reach the intranet",
            "kind": "http",
            "wait_s": 60,
            "derived": false
          },
          {
            "name": "intranet:80 from staff",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "no internet from staff",
            "kind": "http",
            "wait_s": 0,
            "derived": true
          }
        ],
        "step": {
          "id": "check-staff",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name vlan-office --file .isoloom/docker/compose.yml --profile check run --rm --no-deps --env ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} isoloom-check",
            "host": "${outputs.ip}",
            "user": "admin"
          },
          "timeout_s": 195
        },
        "on_timeout": [
          {
            "id": "rm-check-staff",
            "action": "ssh.run",
            "with": {
              "command": "sudo docker ps -aq --filter label=com.docker.compose.project=vlan-office --filter label=com.docker.compose.service=isoloom-check --filter label=com.docker.compose.oneoff=True | xargs -r sudo docker rm -f",
              "host": "${outputs.ip}",
              "user": "admin"
            },
            "timeout_s": 60
          }
        ]
      },
      {
        "id": "isoloom-check-intranet",
        "from": "from intranet",
        "checks": [
          {
            "name": "no internet from intranet",
            "kind": "http",
            "wait_s": 0,
            "derived": true
          }
        ],
        "step": {
          "id": "check-intranet",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name vlan-office --file .isoloom/docker/compose.yml --profile check run --rm --no-deps --env ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} isoloom-check-intranet",
            "host": "${outputs.ip}",
            "user": "admin"
          },
          "timeout_s": 75
        },
        "on_timeout": [
          {
            "id": "rm-check-intranet",
            "action": "ssh.run",
            "with": {
              "command": "sudo docker ps -aq --filter label=com.docker.compose.project=vlan-office --filter label=com.docker.compose.service=isoloom-check-intranet --filter label=com.docker.compose.oneoff=True | xargs -r sudo docker rm -f",
              "host": "${outputs.ip}",
              "user": "admin"
            },
            "timeout_s": 60
          }
        ]
      },
      {
        "id": "isoloom-check-guest",
        "from": "from guest",
        "checks": [
          {
            "name": "guests don't",
            "kind": "tcp",
            "wait_s": 0,
            "derived": false
          },
          {
            "name": "intranet:80 blocked from guest",
            "kind": "tcp",
            "wait_s": 0,
            "derived": true
          }
        ],
        "step": {
          "id": "check-guest",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name vlan-office --file .isoloom/docker/compose.yml --profile check run --rm --no-deps --env ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} isoloom-check-guest",
            "host": "${outputs.ip}",
            "user": "admin"
          },
          "timeout_s": 90
        },
        "on_timeout": [
          {
            "id": "rm-check-guest",
            "action": "ssh.run",
            "with": {
              "command": "sudo docker ps -aq --filter label=com.docker.compose.project=vlan-office --filter label=com.docker.compose.service=isoloom-check-guest --filter label=com.docker.compose.oneoff=True | xargs -r sudo docker rm -f",
              "host": "${outputs.ip}",
              "user": "admin"
            },
            "timeout_s": 60
          }
        ]
      },
      {
        "id": "isoloom-check-admin",
        "from": "from admin",
        "checks": [
          {
            "name": "the admin box reaches the intranet over its trunk",
            "kind": "http",
            "wait_s": 60,
            "derived": false
          },
          {
            "name": "intranet:80 from admin",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          }
        ],
        "step": {
          "id": "check-admin",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name vlan-office --file .isoloom/docker/compose.yml --profile check run --rm --no-deps --env ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} isoloom-check-admin",
            "host": "${outputs.ip}",
            "user": "admin"
          },
          "timeout_s": 180
        },
        "on_timeout": [
          {
            "id": "rm-check-admin",
            "action": "ssh.run",
            "with": {
              "command": "sudo docker ps -aq --filter label=com.docker.compose.project=vlan-office --filter label=com.docker.compose.service=isoloom-check-admin --filter label=com.docker.compose.oneoff=True | xargs -r sudo docker rm -f",
              "host": "${outputs.ip}",
              "user": "admin"
            },
            "timeout_s": 60
          }
        ]
      }
    ],
    "teardown": []
  },
  "recovery": {
    "retries": 0,
    "apply_retries": 1
  },
  "expiry": {
    "tf_var": "expires_at",
    "unit": "unix_seconds",
    "default_minutes": 240
  },
  "guest": {
    "machine": "isoloom-docker-host",
    "host": "${outputs.ip}",
    "status": {
      "id": "ps",
      "action": "ssh.run",
      "with": {
        "command": "if command -v docker >/dev/null; then sudo docker compose --project-name vlan-office ps --all --format json; fi",
        "host": "${outputs.ip}",
        "user": "admin"
      },
      "timeout_s": 60
    }
  }
}

## .isoloom/cloud-docker/aws/setup.sh
#!/bin/sh
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# The Docker host's set-up, piped into `sudo sh -s` over SSH by its run manifest.
set -e
cloud-init status --wait >/dev/null 2>&1 || true
command -v docker >/dev/null || if command -v apt-get >/dev/null; then (
  set -e
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -qq
  apt-get install -y -qq ca-certificates curl
  install -m 0755 -d /etc/apt/keyrings
  k=$(mktemp)
  # shellcheck disable=SC1091,SC2154 # /etc/os-release is on the guest, not here.
  _id=$(. /etc/os-release && printf %s "$ID")
  # shellcheck disable=SC1091,SC2154
  _cn=$(. /etc/os-release && printf %s "$VERSION_CODENAME")
  curl -fsSL "https://download.docker.com/linux/$_id/gpg" -o "$k"
  echo "1500c1f56fa9e26b9b8f42452a553675796ade0807cdce11975eb98170b3a570  $k" | sha256sum -c -
  install -m 0644 "$k" /etc/apt/keyrings/docker.asc
  rm -f "$k"
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/$_id $_cn stable" > /etc/apt/sources.list.d/docker.list
  apt-get update -qq
  v=$(apt-cache madison docker-ce | awk '$3 ~ /(^|:)29[.]9[.]0/ { print $3; exit }')
  [ -n "$v" ] || { echo "docker-ce 29.9.0 is not in Docker's apt repository" >&2; exit 1; }
  apt-get install -y -qq --allow-downgrades "docker-ce=$v" "docker-ce-cli=$v" containerd.io docker-buildx-plugin "docker-compose-plugin=5.6.0-*"
)
else
  curl -fsSL https://get.docker.com | VERSION=29.9.0 sh
fi
cat > /etc/systemd/system/isoloom-published.service <<'UNIT'
[Unit]
Description=Isoloom: published ports reach containers of networks without a default route
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'iptables -t nat -C POSTROUTING -m conntrack --ctstate DNAT -o br-+ -j MASQUERADE 2>/dev/null || iptables -t nat -I POSTROUTING -m conntrack --ctstate DNAT -o br-+ -j MASQUERADE'

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now isoloom-published.service

## .isoloom/cloud-docker/azure/main.tf
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  terraform -chdir=.isoloom/cloud-docker/azure init && terraform -chdir=.isoloom/cloud-docker/azure apply \
#           -var allowed_cidr=<your IP>/32 -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)"
# Stop:   terraform -chdir=.isoloom/cloud-docker/azure destroy (same variables)
# Then:   the machines wait for the project: run the lab through the Isothrum runner (run.json
#         beside this file), which delivers the project over SSH, waits for each set-up and runs the checks.

terraform {
  required_version = ">= 1.6"
  backend "local" {}
  required_providers {
    azurerm = { source = "hashicorp/azurerm", version = "~> 5.8.0" }
  }
}

variable "subscription_id" {
  type        = string
  default     = null
  description = "Default: ARM_SUBSCRIPTION_ID from the environment"
}

variable "region" {
  type    = string
  default = "swedencentral"
}

variable "size" {
  type    = string
  default = "Standard_D2als_v6"
}

variable "allowed_cidr" {
  type        = string
  description = "Who may reach the machines (SSH and the published ports), e.g. your IP/32"
}

variable "ssh_public_key" {
  type        = string
  description = "The key the machines let in: the Isothrum runner's (it delivers the project and runs the checks over SSH)"
}

variable "expires_at" {
  type        = string
  default     = ""
  description = "When the environment should end, in Unix seconds (empty: no end): a tag on every resource, so a reaper finds what to destroy, and the time the machines shut themselves down"
}

provider "azurerm" {
  features {}
  subscription_id = var.subscription_id
}

resource "terraform_data" "id" {
  input = substr(replace(uuid(), "-", ""), 0, 8)
  lifecycle {
    ignore_changes = [input]
  }
}

locals {
  name = "isoloom-vlan-office-${terraform_data.id.output}"
  tags = {
    isoloom-environment = "vlan-office"
    managed-by          = "isoloom"
    isoloom-instance    = local.name
    isoloom-expires-at  = var.expires_at
  }
}

resource "azurerm_resource_group" "env" {
  name     = local.name
  location = var.region
  tags     = local.tags
}

resource "azurerm_virtual_network" "env" {
  name                = local.name
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  address_space       = ["10.42.0.0/16"]
}

resource "azurerm_subnet" "env" {
  name                 = local.name
  resource_group_name  = azurerm_resource_group.env.name
  virtual_network_name = azurerm_virtual_network.env.name
  address_prefixes     = ["10.42.1.0/24"]
}

resource "azurerm_public_ip" "env" {
  name                = local.name
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  allocation_method   = "Static"
  sku                 = "Standard"
}

resource "azurerm_network_security_group" "env" {
  name                = local.name
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  security_rule {
    name                       = "ssh-and-published"
    priority                   = 100
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_ranges    = ["22"]
    source_address_prefix      = var.allowed_cidr
    destination_address_prefix = "*"
  }
}

resource "azurerm_network_interface" "env" {
  name                = local.name
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  ip_configuration {
    name                          = "env"
    subnet_id                     = azurerm_subnet.env.id
    private_ip_address_allocation = "Dynamic"
    public_ip_address_id          = azurerm_public_ip.env.id
  }
}

resource "azurerm_network_interface_security_group_association" "env" {
  network_interface_id      = azurerm_network_interface.env.id
  network_security_group_id = azurerm_network_security_group.env.id
}

resource "azurerm_linux_virtual_machine" "env" {
  name                  = local.name
  resource_group_name   = azurerm_resource_group.env.name
  location              = var.region
  size                  = var.size
  custom_data           = base64encode("#!/bin/sh\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\n")
  admin_username        = "isoloom"
  network_interface_ids = [azurerm_network_interface.env.id]
  admin_ssh_key {
    username   = "isoloom"
    public_key = var.ssh_public_key
  }
  os_disk {
    caching              = "ReadWrite"
    storage_account_type = "StandardSSD_LRS"
  }
  source_image_reference {
    publisher = "Debian"
    offer     = "debian-12"
    sku       = "12-gen2"
    version   = "latest"
  }
  tags       = local.tags
  depends_on = [azurerm_network_interface_security_group_association.env]
}

output "ip" {
  value = azurerm_public_ip.env.ip_address
}

output "ssh_user" {
  value = "isoloom"
}

