## .isoloom/kubernetes/chart/files/project/build/check/check.sh
#!/bin/sh
# The portal answers on its port with its page.
set -eu
curl -fsS --max-time 10 http://web:3206/ | grep -q "Supplier portal"
echo "the portal answers"

## .isoloom/kubernetes/chart/files/project/build/database/seed.sh
#!/bin/sh
# Stores the launch token in the database. It arrives as a file, never as an environment
# variable, and goes in as a hex literal, so no character of it can break the statement.
set -eu
token=$(od -An -v -tx1 /run/lab/launch-token | tr -d ' \n')
mysql -h 127.0.0.1 -P 3207 -u root <<SQL
CREATE DATABASE IF NOT EXISTS portal;
CREATE TABLE IF NOT EXISTS portal.launch (token VARBINARY(255) NOT NULL);
INSERT INTO portal.launch VALUES (0x$token);
SQL

## .isoloom/kubernetes/chart/templates/NOTES.txt
Checks: helm test {{ .Release.Name }} -n {{ .Release.Namespace }}

## .isoloom/kubernetes/chart/templates/environment.yaml
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: database
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      isoloom.com/machine: database
  template:
    metadata:
      labels:
        isoloom.com/machine: database
        net.isoloom.com/lab: member
    spec:
      hostname: database
      initContainers:
      - name: isoloom-probe
        image: busybox:1.37.0-musl
        command:
        - /bin/cp
        - /bin/busybox
        - /probe/busybox
        volumeMounts:
        - name: isoloom-probe
          mountPath: /probe
      containers:
      - name: database
        image: '{{ index .Values.images "database" }}'
        imagePullPolicy: IfNotPresent
        ports:
        - containerPort: 3207
        readinessProbe:
          exec:
            command:
            - /.isoloom-probe/busybox
            - sh
            - -c
            - /.isoloom-probe/busybox nc -z -w 2 127.0.0.1 3207
          periodSeconds: 5
          failureThreshold: 60
        env:
        - name: MYSQL_ALLOW_EMPTY_PASSWORD
          value: '1'
        - name: MYSQL_TCP_PORT
          value: '3207'
        - name: API_URL
          valueFrom:
            secretKeyRef:
              name: isoloom-inputs
              key: API_URL
              optional: true
        resources:
          limits:
            cpu: '1'
            memory: 1024Mi
        volumeMounts:
        - name: isoloom-probe
          mountPath: /.isoloom-probe
          readOnly: true
        - name: isoloom-secrets
          mountPath: /run/lab/launch-token
          readOnly: true
          subPath: input-launch-token
      - name: init
        image: '{{ index .Values.images "database" }}'
        imagePullPolicy: IfNotPresent
        command:
        - sh
        - -c
        - until /.isoloom-probe/busybox nc -z -w 2 127.0.0.1 3207; do sleep 2; done && sh /isoloom/scripts/build__database__seed.sh && exec sleep infinity
        env:
        - name: MYSQL_ALLOW_EMPTY_PASSWORD
          value: '1'
        - name: MYSQL_TCP_PORT
          value: '3207'
        - name: API_URL
          valueFrom:
            secretKeyRef:
              name: isoloom-inputs
              key: API_URL
              optional: true
        volumeMounts:
        - name: isoloom-probe
          mountPath: /.isoloom-probe
          readOnly: true
        - name: isoloom-secrets
          mountPath: /run/lab/launch-token
          readOnly: true
          subPath: input-launch-token
        - name: scripts
          mountPath: /isoloom/scripts
      nodeSelector:
        kubernetes.io/arch: amd64
      volumes:
      - name: scripts
        configMap:
          name: isoloom-scripts
          defaultMode: 493
      - name: isoloom-probe
        emptyDir: {}
      - name: isoloom-secrets
        secret:
          secretName: isoloom-secrets
          items:
          - key: input-launch-token
            path: input-launch-token
            mode: 256
---
apiVersion: v1
kind: Service
metadata:
  name: database
spec:
  selector:
    isoloom.com/machine: database
  ports:
  - name: p3207
    port: 3207
    targetPort: 3207
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: web
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      isoloom.com/machine: web
  template:
    metadata:
      labels:
        isoloom.com/machine: web
        net.isoloom.com/lab: member
    spec:
      hostname: web
      initContainers:
      - name: isoloom-probe
        image: busybox:1.37.0-musl
        command:
        - /bin/cp
        - /bin/busybox
        - /probe/busybox
        volumeMounts:
        - name: isoloom-probe
          mountPath: /probe
      - name: wait-database
        image: alpine:3.20
        command:
        - sh
        - -c
        - until nc -z database 3207; do sleep 2; done
      containers:
      - name: web
        image: '{{ index .Values.images "web" }}'
        imagePullPolicy: IfNotPresent
        ports:
        - containerPort: 3206
        readinessProbe:
          exec:
            command:
            - /.isoloom-probe/busybox
            - sh
            - -c
            - /.isoloom-probe/busybox nc -z -w 2 127.0.0.1 3206
          periodSeconds: 5
          failureThreshold: 60
        resources:
          limits:
            cpu: '1'
            memory: 1024Mi
        volumeMounts:
        - name: isoloom-probe
          mountPath: /.isoloom-probe
          readOnly: true
      nodeSelector:
        kubernetes.io/arch: amd64
      volumes:
      - name: isoloom-probe
        emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: web
spec:
  selector:
    isoloom.com/machine: web
  ports:
  - name: p3206
    port: 3206
    targetPort: 3206
---
apiVersion: v1
kind: Service
metadata:
  name: web-published
spec:
  type: LoadBalancer
  selector:
    isoloom.com/machine: web
  ports:
  - name: p3206
    port: 3206
    targetPort: 3206
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: publish-web
spec:
  podSelector:
    matchLabels:
      isoloom.com/machine: web
  ingress:
  - from:
    - ipBlock:
        cidr: 0.0.0.0/0
    ports:
    - port: 3206
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: isoloom-default-deny
spec:
  podSelector: {}
  policyTypes:
  - Ingress
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: net-lab
spec:
  podSelector:
    matchLabels:
      net.isoloom.com/lab: member
  ingress:
  - from:
    - podSelector:
        matchLabels:
          net.isoloom.com/lab: member

## .isoloom/kubernetes/chart/templates/inputs.yaml
