      volumes:
      - name: runner
        configMap:
          name: isoloom-check-runners
          defaultMode: 493
---
apiVersion: batch/v1
kind: Job
metadata:
  name: isoloom-check-web
spec:
  backoffLimit: 0
  template:
    metadata:
      labels:
        net.isoloom.com/lab: member
        isoloom.com/check: isoloom-check-web
    spec:
      restartPolicy: Never
      containers:
      - name: check
        image: curlimages/curl:8.11.1
        command:
        - /bin/sh
        - /isoloom/run/web.sh
        volumeMounts:
        - name: runner
          mountPath: /isoloom/run
      volumes:
      - name: runner
        configMap:
          name: isoloom-check-runners
          defaultMode: 493

