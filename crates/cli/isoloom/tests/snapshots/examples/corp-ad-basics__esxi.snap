## .isoloom/esxi/main.tf
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Needs:  ovftool on this machine, SSH enabled on the ESXi host
# Start:  terraform -chdir=.isoloom/esxi init && terraform -chdir=.isoloom/esxi apply -var esxi_hostname=<host> -var esxi_password=<password> \
#           -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)" -var ssh_private_key_file=~/.ssh/id_ed25519
# Stop:   terraform -chdir=.isoloom/esxi destroy (same variables)

terraform {
  required_version = ">= 1.6"
  backend "local" {}
  required_providers {
    esxi   = { source = "josenk/esxi", version = "~> 1.10.3" }
    tls    = { source = "hashicorp/tls", version = "~> 4.4.1" }
    local  = { source = "hashicorp/local", version = "~> 2.9.1" }
    random = { source = "hashicorp/random", version = "~> 3.9.1" }
  }
}

variable "esxi_hostname" {
  type        = string
  description = "The ESXi host's name or address"
}

variable "esxi_hostport" {
  type        = string
  default     = "22"
  description = "Its SSH port: the provider works over SSH"
}

variable "esxi_hostssl" {
  type    = string
  default = "443"
}

variable "esxi_username" {
  type    = string
  default = "root"
}

variable "esxi_password" {
  type      = string
  sensitive = true
}

variable "disk_store" {
  type        = string
  default     = "datastore1"
  description = "Where the VMs' disks go"
}

variable "uplink_port_group" {
  type        = string
  default     = "VM Network"
  description = "The port group the router reaches the internet through (DHCP)"
}

variable "slot" {
  type        = number
  default     = 1
  description = "1 to 63, unique per environment on this host: it names the vSwitches and the VMs, and makes the MACs"
  validation {
    condition     = var.slot >= 1 && var.slot <= 63
    error_message = "slot is 1 to 63."
  }
}

variable "images" {
  type        = map(string)
  default     = { "ubuntu-24.04" = "https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.ova" }
  description = "An OVA per OS, a path or a URL: Ubuntu's cloud OVAs by default; for another OS, an OVA with cloud-init and open-vm-tools; for Windows, an OVA with VMware Tools and cloudbase-init (its VMware guestinfo service), sysprepped"
  validation {
    condition     = alltrue([for os in ["debian-12", "ubuntu-24.04", "windows-11", "windows-server-2022"] : contains(keys(var.images), os)])
    error_message = "images needs an OVA for each of: debian-12, ubuntu-24.04, windows-11, windows-server-2022."
  }
}

variable "ssh_public_key" {
  type        = string
  description = "Installed for the user `isoloom` on every VM"
}

variable "ssh_private_key_file" {
  type        = string
  description = "The private key of ssh_public_key: Terraform sets the machines up over SSH, through the router"
}

provider "esxi" {
  esxi_hostname = var.esxi_hostname
  esxi_hostport = var.esxi_hostport
  esxi_hostssl  = var.esxi_hostssl
  esxi_username = var.esxi_username
  esxi_password = var.esxi_password
}

# The project's root, and the `isoloom` user on every VM.
locals {
  root = abspath("${path.module}/../..")
  users = [
    {
      name                = "isoloom"
      sudo                = "ALL=(ALL) NOPASSWD:ALL"
      shell               = "/bin/bash"
      ssh_authorized_keys = [var.ssh_public_key]
    }
  ]
}

# The controller's own key: it runs the playbooks over SSH on every machine.
resource "tls_private_key" "controller" {
  algorithm = "ED25519"
}

# The Windows machines' administrator password (user isoloom), for WinRM.
resource "random_password" "windows" {
  length      = 24
  special     = false
  min_upper   = 2
  min_lower   = 2
  min_numeric = 2
}

# Network `dmz`: 10.40.10.0/24, on its own vSwitch with no uplink.
resource "esxi_vswitch" "dmz" {
  name = "iso${var.slot}-dmz"
}

resource "esxi_portgroup" "dmz" {
  name    = "iso${var.slot}-dmz"
  vswitch = esxi_vswitch.dmz.name
  vlan    = 4095
}

# Network `corp`: 10.40.20.0/24, on its own vSwitch with no uplink.
resource "esxi_vswitch" "corp" {
  name = "iso${var.slot}-corp"
}

resource "esxi_portgroup" "corp" {
  name    = "iso${var.slot}-corp"
  vswitch = esxi_vswitch.corp.name
  vlan    = 4095
}

# Network `access`: 10.40.99.0/24, on its own vSwitch with no uplink.
resource "esxi_vswitch" "access" {
  name = "iso${var.slot}-access"
}

resource "esxi_portgroup" "access" {
  name    = "iso${var.slot}-access"
  vswitch = esxi_vswitch.access.name
  vlan    = 4095
}

# The router: forwards between networks with the reach rules, and to the internet. VMware Tools reports its uplink address.
resource "esxi_guest" "isoloom_router" {
  guest_name            = "iso${var.slot}-router"
  notes                 = "isoloom: corp-ad-basics"
  disk_store            = var.disk_store
  ovf_source            = lookup(var.images, "ubuntu-24.04")
  numvcpus              = "1"
  memsize               = "512"
  boot_disk_size        = "10"
  power                 = "on"
  guest_startup_timeout = 600
  network_interfaces {
    virtual_network = var.uplink_port_group
    mac_address     = format("00:50:56:%02x:%02x:%02x", var.slot, 0, 0)
    nic_type        = "vmxnet3"
  }
  network_interfaces {
    virtual_network = esxi_portgroup.dmz.name
    mac_address     = format("00:50:56:%02x:%02x:%02x", var.slot, 0, 1)
    nic_type        = "vmxnet3"
  }
  network_interfaces {
    virtual_network = esxi_portgroup.corp.name
    mac_address     = format("00:50:56:%02x:%02x:%02x", var.slot, 0, 2)
    nic_type        = "vmxnet3"
  }
  network_interfaces {
    virtual_network = esxi_portgroup.access.name
    mac_address     = format("00:50:56:%02x:%02x:%02x", var.slot, 0, 3)
    nic_type        = "vmxnet3"
  }
  guestinfo = {
    metadata = base64encode(yamlencode({
      instance-id    = "iso${var.slot}-router"
      local-hostname = "router"
      network = {
        version = 2
        ethernets = {
          nic0 = { match = { macaddress = format("00:50:56:%02x:%02x:%02x", var.slot, 0, 0) }, dhcp4 = true }
          nic1 = {
            match     = { macaddress = format("00:50:56:%02x:%02x:%02x", var.slot, 0, 1) }
            addresses = ["10.40.10.254/24"]
          }
          nic2 = {
            match     = { macaddress = format("00:50:56:%02x:%02x:%02x", var.slot, 0, 2) }
            addresses = ["10.40.20.254/24"]
          }
          nic3 = {
            match     = { macaddress = format("00:50:56:%02x:%02x:%02x", var.slot, 0, 3) }
            addresses = ["10.40.99.254/24"]
          }
        }
      }
    }))
    "metadata.encoding" = "base64"
    userdata = base64encode(format("#cloud-config\n%s", yamlencode({
      hostname = "isoloom-router"
      users    = local.users
      packages = ["nftables"]
      write_files = [
        {
          path    = "/etc/nftables.conf"
          content = "flush ruleset\ntable inet isoloom {\n  chain forward {\n    type filter hook forward priority 0; policy drop;\n    ct state established,related accept\n    ip saddr 10.40.99.0/24 ip daddr 10.40.10.0/24 accept\n    ip saddr 10.40.10.0/24 ip daddr 10.40.20.0/24 accept\n    ip saddr { 10.40.10.0/24, 10.40.20.0/24, 10.40.99.0/24 } ip daddr != { 10.40.10.0/24, 10.40.20.0/24, 10.40.99.0/24 } accept\n  }\n  chain prerouting {\n    type nat hook prerouting priority -100;\n  }\n  chain postrouting {\n    type nat hook postrouting priority 100;\n    ip saddr { 10.40.10.0/24, 10.40.20.0/24, 10.40.99.0/24 } ip daddr != { 10.40.10.0/24, 10.40.20.0/24, 10.40.99.0/24 } masquerade\n  }\n}\n"
        },
        { path = "/etc/sysctl.d/90-isoloom.conf", content = "net.ipv4.ip_forward=1\n" }
      ]
      runcmd = [
        "sysctl -p /etc/sysctl.d/90-isoloom.conf",
        "systemctl enable --now nftables",
        "nft -f /etc/nftables.conf"
      ]
    })))
    "userdata.encoding" = "base64"
  }
  depends_on = [esxi_portgroup.dmz, esxi_portgroup.corp, esxi_portgroup.access]
}

# Machine `dc01`: set up by cloudbase-init at its first boot.
resource "esxi_guest" "dc01" {
  guest_name     = "iso${var.slot}-dc01"
  notes          = "isoloom: corp-ad-basics"
  disk_store     = var.disk_store
  ovf_source     = lookup(var.images, "windows-server-2022")
  numvcpus       = "2"
  memsize        = "4096"
  boot_disk_size = "60"
  power          = "on"
  guestos        = "windows2019srvnext-64"
  network_interfaces {
    virtual_network = esxi_portgroup.corp.name
    mac_address     = format("00:50:56:%02x:%02x:%02x", var.slot, 2, 0)
    nic_type        = "vmxnet3"
  }
  guestinfo = {
    metadata = base64encode(yamlencode({
      instance-id    = "iso${var.slot}-dc01"
      local-hostname = "dc01"
      network = {
        version = 2
        ethernets = {
          nic0 = {
            match       = { macaddress = format("00:50:56:%02x:%02x:%02x", var.slot, 2, 0) }
            addresses   = ["10.40.20.5/24"]
            gateway4    = "10.40.20.254"
            nameservers = { addresses = ["1.1.1.1"] }
          }
        }
      }
    }))
    "metadata.encoding" = "base64"
    userdata            = base64encode("#ps1_sysnative\n# Isoloom: machine `dc01`, set up by cloudbase-init at its first boot.\n$ErrorActionPreference = 'Stop'\nif (Test-Path 'C:\\ProgramData\\isoloom\\done') { exit 0 }\nNew-Item -ItemType Directory -Force C:\\ProgramData\\isoloom | Out-Null\n# The administrator the controller's playbooks run as, over WinRM.\n$password = ConvertTo-SecureString '${random_password.windows.result}' -AsPlainText -Force\nif (Get-LocalUser -Name isoloom -ErrorAction SilentlyContinue) { Set-LocalUser -Name isoloom -Password $password -PasswordNeverExpires $true } else { New-LocalUser -Name isoloom -Password $password -PasswordNeverExpires | Out-Null }\nif (-not (Get-LocalGroupMember -SID S-1-5-32-544 | Where-Object { $_.Name -like '*\\isoloom' })) { Add-LocalGroupMember -SID S-1-5-32-544 -Member isoloom }\n# Its name takes a restart: cloudbase-init runs this script again after it (exit code 1003).\nif ($env:COMPUTERNAME -ne 'DC01') { Rename-Computer -NewName 'dc01' -Force; exit 1003 }\nNew-NetFirewallRule -DisplayName 'isoloom 53' -Direction Inbound -Protocol TCP -LocalPort 53 -Action Allow | Out-Null\nNew-NetFirewallRule -DisplayName 'isoloom 88' -Direction Inbound -Protocol TCP -LocalPort 88 -Action Allow | Out-Null\nNew-NetFirewallRule -DisplayName 'isoloom 389' -Direction Inbound -Protocol TCP -LocalPort 389 -Action Allow | Out-Null\nNew-NetFirewallRule -DisplayName 'isoloom 445' -Direction Inbound -Protocol TCP -LocalPort 445 -Action Allow | Out-Null\n$max = (Get-PartitionSupportedSize -DriveLetter C).SizeMax; if ((Get-Partition -DriveLetter C).Size -lt $max) { Resize-Partition -DriveLetter C -Size $max }\n$h = \"$env:SystemRoot\\System32\\drivers\\etc\\hosts\"; foreach ($l in @('10.40.20.21 ws-01', '10.40.20.22 ws-02', '10.40.20.10 web01', '10.40.99.10 user')) { if (-not (Select-String -Path $h -SimpleMatch $l -Quiet)) { Add-Content -Path $h -Value $l } }\nroute -p add 10.40.10.0 MASK 255.255.255.0 10.40.20.254; route -p add 10.40.99.0 MASK 255.255.255.0 10.40.20.254\nNew-Item -ItemType Directory -Force C:\\isoloom | Out-Null; Set-Content C:\\isoloom\\ready ready\n# WinRM for the controller, last: a machine that answers is set up.\nNew-ItemProperty -Path HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System -Name LocalAccountTokenFilterPolicy -Value 1 -PropertyType DWord -Force | Out-Null\nGet-NetConnectionProfile | Set-NetConnectionProfile -NetworkCategory Private -ErrorAction SilentlyContinue\nEnable-PSRemoting -Force -SkipNetworkProfileCheck | Out-Null\nSet-Item WSMan:\\localhost\\Service\\Auth\\Basic $true\nSet-Item WSMan:\\localhost\\Service\\AllowUnencrypted $true\nif (-not (Get-NetFirewallRule -DisplayName 'isoloom winrm' -ErrorAction SilentlyContinue)) { New-NetFirewallRule -DisplayName 'isoloom winrm' -Direction Inbound -Protocol TCP -LocalPort 5985 -Action Allow | Out-Null }\nNew-Item -ItemType File -Force 'C:\\ProgramData\\isoloom\\done' | Out-Null\n")
    "userdata.encoding" = "base64"
  }
  depends_on = [esxi_guest.isoloom_router]
}

# Machine `ws-01`: set up by cloudbase-init at its first boot.
resource "esxi_guest" "ws_01" {
  guest_name     = "iso${var.slot}-ws-01"
  notes          = "isoloom: corp-ad-basics"
  disk_store     = var.disk_store
  ovf_source     = lookup(var.images, "windows-11")
  numvcpus       = "2"
  memsize        = "4096"
  boot_disk_size = "60"
  power          = "on"
  guestos        = "windows11-64"
  network_interfaces {
    virtual_network = esxi_portgroup.corp.name
    mac_address     = format("00:50:56:%02x:%02x:%02x", var.slot, 3, 0)
    nic_type        = "vmxnet3"
  }
  guestinfo = {
    metadata = base64encode(yamlencode({
      instance-id    = "iso${var.slot}-ws-01"
      local-hostname = "ws-01"
      network = {
        version = 2
        ethernets = {
          nic0 = {
            match       = { macaddress = format("00:50:56:%02x:%02x:%02x", var.slot, 3, 0) }
            addresses   = ["10.40.20.21/24"]
            gateway4    = "10.40.20.254"
            nameservers = { addresses = ["1.1.1.1"] }
          }
        }
      }
    }))
    "metadata.encoding" = "base64"
    userdata            = base64encode("#ps1_sysnative\n# Isoloom: machine `ws-01`, set up by cloudbase-init at its first boot.\n$ErrorActionPreference = 'Stop'\nif (Test-Path 'C:\\ProgramData\\isoloom\\done') { exit 0 }\nNew-Item -ItemType Directory -Force C:\\ProgramData\\isoloom | Out-Null\n# The administrator the controller's playbooks run as, over WinRM.\n$password = ConvertTo-SecureString '${random_password.windows.result}' -AsPlainText -Force\nif (Get-LocalUser -Name isoloom -ErrorAction SilentlyContinue) { Set-LocalUser -Name isoloom -Password $password -PasswordNeverExpires $true } else { New-LocalUser -Name isoloom -Password $password -PasswordNeverExpires | Out-Null }\nif (-not (Get-LocalGroupMember -SID S-1-5-32-544 | Where-Object { $_.Name -like '*\\isoloom' })) { Add-LocalGroupMember -SID S-1-5-32-544 -Member isoloom }\n# Its name takes a restart: cloudbase-init runs this script again after it (exit code 1003).\nif ($env:COMPUTERNAME -ne 'WS-01') { Rename-Computer -NewName 'ws-01' -Force; exit 1003 }\n$max = (Get-PartitionSupportedSize -DriveLetter C).SizeMax; if ((Get-Partition -DriveLetter C).Size -lt $max) { Resize-Partition -DriveLetter C -Size $max }\n$h = \"$env:SystemRoot\\System32\\drivers\\etc\\hosts\"; foreach ($l in @('10.40.20.5 dc01', '10.40.20.22 ws-02', '10.40.20.10 web01', '10.40.99.10 user')) { if (-not (Select-String -Path $h -SimpleMatch $l -Quiet)) { Add-Content -Path $h -Value $l } }\nroute -p add 10.40.10.0 MASK 255.255.255.0 10.40.20.254; route -p add 10.40.99.0 MASK 255.255.255.0 10.40.20.254\n$t = (Get-Date).AddSeconds(900); foreach ($p in @(53, 88, 389, 445)) { while (-not (Test-NetConnection 'dc01' -Port $p -WarningAction SilentlyContinue).TcpTestSucceeded) { if ((Get-Date) -gt $t) { throw ('dc01 didn''t answer on port ' + $p) }; Start-Sleep 5 } }; 'dc01 answers'\nNew-Item -ItemType Directory -Force C:\\isoloom | Out-Null; Set-Content C:\\isoloom\\ready ready\n# WinRM for the controller, last: a machine that answers is set up.\nNew-ItemProperty -Path HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System -Name LocalAccountTokenFilterPolicy -Value 1 -PropertyType DWord -Force | Out-Null\nGet-NetConnectionProfile | Set-NetConnectionProfile -NetworkCategory Private -ErrorAction SilentlyContinue\nEnable-PSRemoting -Force -SkipNetworkProfileCheck | Out-Null\nSet-Item WSMan:\\localhost\\Service\\Auth\\Basic $true\nSet-Item WSMan:\\localhost\\Service\\AllowUnencrypted $true\nif (-not (Get-NetFirewallRule -DisplayName 'isoloom winrm' -ErrorAction SilentlyContinue)) { New-NetFirewallRule -DisplayName 'isoloom winrm' -Direction Inbound -Protocol TCP -LocalPort 5985 -Action Allow | Out-Null }\nNew-Item -ItemType File -Force 'C:\\ProgramData\\isoloom\\done' | Out-Null\n")
    "userdata.encoding" = "base64"
  }
  depends_on = [esxi_guest.isoloom_router]
}

