# Machine `web01`.
resource "esxi_guest" "web01" {
  guest_name     = "iso${var.slot}-web01"
  notes          = "isoloom: corp-ad-basics"
  disk_store     = var.disk_store
  ovf_source     = lookup(var.images, "debian-12")
  numvcpus       = "1"
  memsize        = "1024"
  boot_disk_size = "20"
  power          = "on"
  network_interfaces {
    virtual_network = esxi_portgroup.dmz.name
    mac_address     = format("00:50:56:%02x:%02x:%02x", var.slot, 5, 0)
    nic_type        = "vmxnet3"
  }
  network_interfaces {
    virtual_network = esxi_portgroup.corp.name
    mac_address     = format("00:50:56:%02x:%02x:%02x", var.slot, 5, 1)
    nic_type        = "vmxnet3"
  }
  guestinfo = {
    metadata = base64encode(yamlencode({
      instance-id    = "iso${var.slot}-web01"
      local-hostname = "web01"
      network = {
        version = 2
        ethernets = {
          nic0 = {
            match       = { macaddress = format("00:50:56:%02x:%02x:%02x", var.slot, 5, 0) }
            addresses   = ["10.40.10.10/24"]
            routes      = [{ to = "0.0.0.0/0", via = "10.40.10.254" }]
            nameservers = { addresses = ["1.1.1.1"] }
          }
          nic1 = {
            match     = { macaddress = format("00:50:56:%02x:%02x:%02x", var.slot, 5, 1) }
            addresses = ["10.40.20.10/24"]
          }
        }
      }
    }))
    "metadata.encoding" = "base64"
    userdata            = base64encode(format("#cloud-config\n%s", yamlencode({ hostname = "web01", users = local.users, packages = [], write_files = [], runcmd = [] })))
    "userdata.encoding" = "base64"
  }
  depends_on = [esxi_guest.isoloom_router]
}

# Its set-up: its steps from the plan, over SSH through the router.
resource "terraform_data" "web01" {
  triggers_replace = [esxi_guest.web01.id]
  connection {
    type                = "ssh"
    host                = "10.40.10.10"
    user                = "isoloom"
    private_key         = file(pathexpand(var.ssh_private_key_file))
    bastion_host        = local.router_address
    bastion_user        = "isoloom"
    bastion_private_key = file(pathexpand(var.ssh_private_key_file))
    timeout             = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-web01.tgz\" --exclude=.git --exclude=.vagrant --exclude=.terraform --exclude=.isoloom-project* -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-web01.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "remote-exec" {
    inline = [
      "set -e",
      "cloud-init status --wait >/dev/null 2>&1 || true",
      "mkdir -p ~/.ssh && echo '${trimspace(tls_private_key.controller.public_key_openssh)}' >> ~/.ssh/authorized_keys",
      "sudo sh -c 'mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz'",
      "sudo sh -c 'for l in '\\''10.40.99.10 user'\\''; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'",
      "sudo sh -c 'ip route replace 10.40.99.0/24 via 10.40.10.254'",
      "sudo sh -c 'pkg() { if command -v apt-get >/dev/null; then apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \"$@\"; elif command -v dnf >/dev/null; then dnf install -y -q \"$@\"; else yum install -y -q \"$@\"; fi; }\ncommand -v ansible-playbook >/dev/null || pkg ansible-core\ncd /opt/isoloom && sh -c '\\''ansible-playbook -c local -i web01, provision/web01.yml'\\'''",
      "sudo sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'"
    ]
  }
}

# The controller: runs the environment's playbooks once every machine is set up.
resource "esxi_guest" "isoloom_controller" {
  guest_name     = "iso${var.slot}-controller"
  notes          = "isoloom: corp-ad-basics"
  disk_store     = var.disk_store
  ovf_source     = lookup(var.images, "ubuntu-24.04")
  numvcpus       = "1"
  memsize        = "512"
  boot_disk_size = "10"
  power          = "on"
  network_interfaces {
    virtual_network = esxi_portgroup.dmz.name
    mac_address     = format("00:50:56:%02x:%02x:%02x", var.slot, 1, 0)
    nic_type        = "vmxnet3"
  }
  network_interfaces {
    virtual_network = esxi_portgroup.corp.name
    mac_address     = format("00:50:56:%02x:%02x:%02x", var.slot, 1, 1)
    nic_type        = "vmxnet3"
  }
  network_interfaces {
    virtual_network = esxi_portgroup.access.name
    mac_address     = format("00:50:56:%02x:%02x:%02x", var.slot, 1, 2)
    nic_type        = "vmxnet3"
  }
  guestinfo = {
    metadata = base64encode(yamlencode({
      instance-id    = "iso${var.slot}-controller"
      local-hostname = "controller"
      network = {
        version = 2
        ethernets = {
          nic0 = {
            match       = { macaddress = format("00:50:56:%02x:%02x:%02x", var.slot, 1, 0) }
            addresses   = ["10.40.10.253/24"]
            routes      = [{ to = "0.0.0.0/0", via = "10.40.10.254" }]
            nameservers = { addresses = ["1.1.1.1"] }
          }
          nic1 = {
            match     = { macaddress = format("00:50:56:%02x:%02x:%02x", var.slot, 1, 1) }
            addresses = ["10.40.20.253/24"]
          }
          nic2 = {
            match     = { macaddress = format("00:50:56:%02x:%02x:%02x", var.slot, 1, 2) }
            addresses = ["10.40.99.253/24"]
          }
        }
      }
    }))
    "metadata.encoding" = "base64"
    userdata = base64encode(format("#cloud-config\n%s", yamlencode({
      hostname    = "isoloom-controller"
      users       = local.users
      packages    = []
      write_files = []
      runcmd      = []
    })))
    "userdata.encoding" = "base64"
  }
  depends_on = [esxi_guest.isoloom_router]
}

resource "terraform_data" "isoloom_controller" {
  triggers_replace = [esxi_guest.isoloom_controller.id]
  connection {
    type                = "ssh"
    host                = "10.40.10.253"
    user                = "isoloom"
    private_key         = file(pathexpand(var.ssh_private_key_file))
    bastion_host        = local.router_address
    bastion_user        = "isoloom"
    bastion_private_key = file(pathexpand(var.ssh_private_key_file))
    timeout             = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-controller.tgz\" --exclude=.git --exclude=.vagrant --exclude=.terraform --exclude=.isoloom-project* -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-controller.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "file" {
    content     = tls_private_key.controller.private_key_openssh
    destination = "/tmp/isoloom-controller-key"
  }
  provisioner "file" {
    content     = "[linux]\nweb01 ansible_host=10.40.10.10 ansible_user=isoloom\n\n[windows]\ndc01 ansible_host=10.40.20.5\nws-01 ansible_host=10.40.20.21\nws-02 ansible_host=10.40.20.22\n\n[linux:vars]\nansible_ssh_private_key_file=/etc/isoloom/id_ed25519\nansible_become=true\n\n[windows:vars]\nansible_user=isoloom\nansible_password=${random_password.windows.result}\nansible_connection=winrm\nansible_port=5985\nansible_winrm_scheme=http\nansible_winrm_transport=basic\nansible_winrm_server_cert_validation=ignore\nansible_winrm_operation_timeout_sec=400\nansible_winrm_read_timeout_sec=500\n\n[domain]\ndc01\nws-01\nws-02\n"
    destination = "/tmp/isoloom-inventory.ini"
  }
  provisioner "remote-exec" {
    inline = [
      "set -e",
      "cloud-init status --wait >/dev/null 2>&1 || true",
      "sudo sh -c 'mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz'",
      "sudo sh -c 'printf '\\''%s\\n'\\'' '\\''10.40.20.5 dc01'\\'' '\\''10.40.20.21 ws-01'\\'' '\\''10.40.20.22 ws-02'\\'' '\\''10.40.10.10 web01'\\'' '\\''10.40.99.10 user'\\'' >> /etc/hosts'",
      "sudo sh -c 'mkdir -p /etc/isoloom && install -m 0600 /tmp/isoloom-controller-key /etc/isoloom/id_ed25519 && install -m 0644 /tmp/isoloom-inventory.ini /etc/isoloom/inventory.ini && rm -f /tmp/isoloom-controller-key /tmp/isoloom-inventory.ini'",
      "sudo sh -c 'DEBIAN_FRONTEND=noninteractive apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq python3-venv curl netcat-openbsd >/dev/null'",
      "sudo sh -c '[ -x /opt/ansible/bin/ansible-playbook ] || { python3 -m venv /opt/ansible && /opt/ansible/bin/pip install -q '\\''ansible-core>=2.15,<2.17'\\'' pywinrm; }'",
      "sudo sh -c 'i=0; until /opt/ansible/bin/ansible -i /etc/isoloom/inventory.ini dc01 -m raw -a '\\''if (-not (Test-Path C:\\isoloom\\ready)) { exit 1 }'\\'' >/dev/null 2>&1; do i=$((i+1)); [ $i -gt 360 ] && { echo '\\''dc01 not ready'\\''; exit 1; }; sleep 10; done'",
      "sudo sh -c 'i=0; until /opt/ansible/bin/ansible -i /etc/isoloom/inventory.ini ws-01 -m raw -a '\\''if (-not (Test-Path C:\\isoloom\\ready)) { exit 1 }'\\'' >/dev/null 2>&1; do i=$((i+1)); [ $i -gt 360 ] && { echo '\\''ws-01 not ready'\\''; exit 1; }; sleep 10; done'",
      "sudo sh -c 'i=0; until /opt/ansible/bin/ansible -i /etc/isoloom/inventory.ini ws-02 -m raw -a '\\''if (-not (Test-Path C:\\isoloom\\ready)) { exit 1 }'\\'' >/dev/null 2>&1; do i=$((i+1)); [ $i -gt 360 ] && { echo '\\''ws-02 not ready'\\''; exit 1; }; sleep 10; done'",
      "sudo sh -c 'set -e\nmkdir -p /tmp/isoloom-facts\nexport PATH=/opt/ansible/bin:$PATH ANSIBLE_HOST_KEY_CHECKING=False ANSIBLE_GATHERING=smart ANSIBLE_FORKS=20 ANSIBLE_PIPELINING=True ANSIBLE_CACHE_PLUGIN=jsonfile ANSIBLE_CACHE_PLUGIN_CONNECTION=/tmp/isoloom-facts ANSIBLE_CACHE_PLUGIN_TIMEOUT=7200\nmkdir -p /tmp/isoloom-retry\nexport ANSIBLE_RETRY_FILES_ENABLED=True ANSIBLE_RETRY_FILES_SAVE_PATH=/tmp/isoloom-retry\n_isoloom_pause=$${ISOLOOM_RETRY_PAUSE:-15}\n_isoloom_attempts=4\n_isoloom_transient='\\''send_input failed|the pipe has been ended|winrmtransporterror|winrmoperationtimeouterror|read timeout|bad http response returned from server|(kerberos|ntlm|credssp).*500|remote end closed connection|connection reset by peer|connection refused|connection aborted|broken pipe|timed out|failed to connect to the host via ssh|shared connection to .* closed'\\''\nretry_download() {\n  _isoloom_n=1\n  until \"$@\"; do\n    [ \"$_isoloom_n\" -lt 5 ] || return 1\n    echo \"isoloom: download failed; trying again in $((_isoloom_n * _isoloom_pause)) s ($((_isoloom_n + 1))/5)\"\n    sleep $((_isoloom_n * _isoloom_pause))\n    _isoloom_n=$((_isoloom_n + 1))\n  done\n}\nplay_hosts() {\n  awk -v transient=\"$_isoloom_transient\" '\\''\n    function commit() {\n      if (pending != \"\") { if (pending_real) real[pending] = 1; else cut[pending] = 1 }\n      pending = \"\"\n    }\n    { gsub(/\\033\\[[0-9;]*m/, \"\") }\n    /^\\.\\.\\.ignoring/ { pending = \"\"; next }\n    { commit() }\n    /^(fatal|failed): \\[/ && !/UNREACHABLE!/ {\n      pending = $0\n      sub(/^(fatal|failed): \\[/, \"\", pending)\n      sub(/\\].*/, \"\", pending)\n      sub(/ -> .*/, \"\", pending)\n      pending_real = (tolower($0) !~ transient)\n      next\n    }\n    /^PLAY RECAP/ { recap = 1; next }\n    recap && / : ok=/ {\n      for (i = 2; i <= NF; i++) {\n        split($i, kv, \"=\")\n        if (kv[1] == \"failed\" && kv[2] > 0) failed[$1] = 1\n        if (kv[1] == \"unreachable\" && kv[2] > 0) unreachable[$1] = 1\n      }\n    }\n    END {\n      commit()\n      for (h in failed) print ((h in real || !(h in cut)) ? \"real \" : \"cut \") h\n      for (h in unreachable) if (!(h in failed)) print \"unreachable \" h\n    }\n  '\\'' \"$1\" | sort\n}\n_isoloom_kind() {\n  echo \"$1\" | awk -v k=\"$2\" '\\''$1 == k { printf \"%s%s\", s, $2; s = \" \" }'\\''\n}\nrun_play() {\n  # The playbook is the last argument; Ansible names its retry file after it.\n  for _isoloom_book; do :; done\n  _isoloom_name=$(basename \"$_isoloom_book\")\n  _isoloom_retry=$${ANSIBLE_RETRY_FILES_SAVE_PATH:-/tmp/isoloom-retry}/$${_isoloom_name%.*}.retry\n  _isoloom_limit=\n  _isoloom_log=$(mktemp)\n  _isoloom_rcf=$(mktemp)\n  _isoloom_n=1\n  rm -f \"$_isoloom_retry\"\n  while :; do\n    { \"$@\" $_isoloom_limit && echo 0 > \"$_isoloom_rcf\" || echo $? > \"$_isoloom_rcf\"; } 2>&1 | tee \"$_isoloom_log\"\n    _isoloom_rc=$(cat \"$_isoloom_rcf\")\n    [ \"$_isoloom_rc\" -ne 0 ] || break\n    _isoloom_hosts=$(play_hosts \"$_isoloom_log\")\n    _isoloom_real=$(_isoloom_kind \"$_isoloom_hosts\" real)\n    _isoloom_gone=$(_isoloom_kind \"$_isoloom_hosts\" unreachable)\n    _isoloom_cut=$(_isoloom_kind \"$_isoloom_hosts\" cut)\n    _isoloom_again=$(echo $_isoloom_gone $_isoloom_cut)\n    if [ -n \"$_isoloom_real\" ]; then\n      echo \"isoloom: $_isoloom_name: a task failed on $_isoloom_real: not retried\"\n      break\n    fi\n    if [ -z \"$_isoloom_again\" ]; then\n      echo \"isoloom: $_isoloom_name failed (exit $_isoloom_rc) with no unreachable host or dropped connection: not retried\"\n      break\n    fi\n    if [ \"$_isoloom_n\" -ge \"$_isoloom_attempts\" ]; then\n      echo \"isoloom: $_isoloom_name: still unreachable after $_isoloom_n runs: $_isoloom_again; giving up\"\n      break\n    fi\n    printf '\\''%s\\n'\\'' $_isoloom_again > \"$_isoloom_retry\"\n    _isoloom_limit=\"--limit @$_isoloom_retry\"\n    _isoloom_n=$((_isoloom_n + 1))\n    if [ -n \"$_isoloom_gone\" ]; then\n      _isoloom_wait=$((4 * _isoloom_pause))\n      echo \"isoloom: $_isoloom_name: unreachable: $_isoloom_again; waiting $_isoloom_wait s, then running it again on them ($_isoloom_n/$_isoloom_attempts)\"\n    else\n      _isoloom_wait=$((2 * _isoloom_pause))\n      echo \"isoloom: $_isoloom_name: the play was cut by a dropped connection on $_isoloom_cut; waiting $_isoloom_wait s, then running it again on them ($_isoloom_n/$_isoloom_attempts)\"\n    fi\n    sleep \"$_isoloom_wait\"\n  done\n  rm -f \"$_isoloom_log\" \"$_isoloom_rcf\"\n  [ \"$_isoloom_rc\" -ne 0 ] || rm -f \"$_isoloom_retry\"\n  return \"$_isoloom_rc\"\n}\ncd /opt/isoloom/provision\n[ ! -f requirements.yml ] || retry_download ansible-galaxy install -r requirements.yml\nrun_play ansible-playbook -i /etc/isoloom/inventory.ini ad-domain.yml\ncd /opt/isoloom/provision\n[ ! -f requirements.yml ] || retry_download ansible-galaxy install -r requirements.yml\nrun_play ansible-playbook -i /etc/isoloom/inventory.ini ad-join.yml\ncd /opt/isoloom/provision\n[ ! -f requirements.yml ] || retry_download ansible-galaxy install -r requirements.yml\nrun_play ansible-playbook -i /etc/isoloom/inventory.ini ws.yml'",
      "sudo sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'"
    ]
  }
  depends_on = [esxi_guest.dc01, esxi_guest.ws_01, esxi_guest.ws_02, terraform_data.web01]
}

locals {
  router_address = esxi_guest.isoloom_router.ip_address
}

output "address" {
  value = local.router_address
}

# The machines, through the router: ssh -J isoloom@<address> isoloom@<machine>.
output "machines" {
  value = { dc01 = "10.40.20.5", ws-01 = "10.40.20.21", ws-02 = "10.40.20.22", web01 = "10.40.10.10" }
}

output "ssh_user" {
  value = "isoloom"
}

# The checks: each runner piped to its machine (ssh -J isoloom@<address> isoloom@<host> sh -s < <script>), or `isoloom test esxi`.
output "checks" {
  value = [
    {
      position = "user"
      machine  = "controller"
      host     = "10.40.10.253"
      user     = "isoloom"
      script   = ".isoloom/esxi/checks/user.sh"
    },
    {
      position = "web01"
      machine  = "web01"
      host     = "10.40.10.10"
      user     = "isoloom"
      script   = ".isoloom/esxi/checks/web01.sh"
    }
  ]
}

# The project's files the machines don't get: version control and the tools' state, and what
# .isoloomignore at the project's root lists (gitignore-style: one pattern per line, `#` comments,
# `!` brings a path back, a trailing `/` matches folders only, a `/` at the start or in the middle
# anchors the pattern at the root; `*`, `?`, `[abc]`, `**`; the last pattern matching a path, or
# a folder it is in, decides). Read as regular expressions, as the Vagrantfiles do.
locals {
  project_ignore_lines = [for l in split("\n", replace(try(file("${local.root}/.isoloomignore"), ""), "\r", "")) : trimspace(l)]
  project_ignore_pats  = [for l in local.project_ignore_lines : { keep = startswith(l, "!"), pat = trimprefix(l, "!") } if l != "" && !startswith(l, "#")]
  project_ignore_globs = [for r in local.project_ignore_pats : merge(r, { glob = trimsuffix(trimsuffix(trimsuffix(r.pat, "/"), "/**"), "/") })]
  project_ignore = [for r in local.project_ignore_globs : {
    keep = r.keep
    re = format(r.glob == r.pat ? "^%s(/|$)" : "^%s/", replace(replace(replace(replace(replace(replace(replace(replace(
      length(split("/", r.glob)) > 1 ? trimprefix(r.glob, "/") : "**/${r.glob}",
    "/[.+^$(){}|\\\\]/", "\\$0"), "[!", "[^"), "**/", "\u0001"), "**", "\u0002"), "*", "[^/]*"), "?", "[^/]"), "\u0001", "(.*/)?"), "\u0002", ".*"))
  } if r.glob != ""]
  # Each file: whether it goes (the last matching pattern decides; none: it goes).
  project_keep    = { for f in fileset(local.root, "**") : f => reverse(concat([true], [for r in local.project_ignore : r.keep if length(regexall(r.re, f)) > 0]))[0] }
  project_paths   = [for f, keep in local.project_keep : f if keep && length(regexall("^\\.isoloom|(^|/)\\.(git|vagrant|terraform)/", f)) == 0]
  project_ignored = [for f, keep in local.project_keep : f if !keep]
}

# What `tar` leaves out of the project's archive: .isoloomignore's files, from the archive's top
# folder, their wildcard characters escaped.
resource "local_file" "isoloom_project" {
  filename = "${path.module}/.isoloom-project-ignored.txt"
  content  = join("", [for f in local.project_ignored : "${replace("${basename(local.root)}/${f}", "/[\\\\*?\\[]/", "\\$0")}\n"])
}

## .isoloom/resolved.json: identical in the `hybrid` snapshot
