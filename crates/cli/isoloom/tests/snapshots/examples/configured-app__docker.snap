## .isoloom/docker/compose.yml
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  docker compose -f .isoloom/docker/compose.yml up -d --wait
# Checks: isothrum check . (or: docker compose -f .isoloom/docker/compose.yml --profile check run --rm isoloom-check, and isoloom-check-<machine>)
# Stop:   docker compose -f .isoloom/docker/compose.yml down -v

name: configured-app
services:
  web:
    build:
      context: ../..
      dockerfile: .isoloom/docker/build/web/Dockerfile
      labels:
        isoloom.managed: 'true'
        isoloom.environment: configured-app
    image: isoloom/configured-app-web
    platform: linux/amd64
    init: true
    hostname: web
    networks:
      lab:
        ipv4_address: 10.66.0.10
    ports:
    - ${ISOLOOM_PUBLISH_ADDRESS:-127.0.0.1}:${ISOLOOM_PUBLISH_FIXED:+8086}:80
    volumes:
    - isoloom-probe-amd64:/.isoloom-probe:ro
    healthcheck:
      test:
      - CMD
      - /.isoloom-probe/busybox
      - sh
      - -c
      - /.isoloom-probe/busybox nc -z -w 2 127.0.0.1 80
      interval: 5s
      timeout: 3s
      retries: 60
      start_period: 10s
    depends_on:
      isoloom-probe-amd64:
        condition: service_completed_successfully
    labels:
      isoloom.port.http: http:80
      isoloom.managed: 'true'
      isoloom.environment: configured-app
    restart: unless-stopped
  api:
    build:
      context: ../..
      dockerfile: .isoloom/docker/build/api/Dockerfile
      labels:
        isoloom.managed: 'true'
        isoloom.environment: configured-app
    image: isoloom/configured-app-api
    platform: linux/amd64
    init: true
    hostname: api
    networks:
      lab:
        ipv4_address: 10.66.0.20
    volumes:
    - isoloom-probe-amd64:/.isoloom-probe:ro
    healthcheck:
      test:
      - CMD
      - /.isoloom-probe/busybox
      - sh
      - -c
      - /.isoloom-probe/busybox nc -z -w 2 127.0.0.1 8080 && /.isoloom-probe/busybox nc -z -w 2 127.0.0.1 8081
      interval: 5s
      timeout: 3s
      retries: 60
      start_period: 10s
    depends_on:
      isoloom-probe-amd64:
        condition: service_completed_successfully
    labels:
      isoloom.port.status: http:8080
      isoloom.port.health: http:8081
      isoloom.managed: 'true'
      isoloom.environment: configured-app
    restart: unless-stopped
  isoloom-check:
    image: curlimages/curl:8.11.1
    profiles:
    - check
    entrypoint:
    - /bin/sh
    - /isoloom/run.sh
    networks:
      lab: null
    volumes:
    - ./checks/networks.sh:/isoloom/run.sh:ro
    - ../..:/isoloom/project:ro
    depends_on:
      web:
        condition: service_healthy
      api:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: configured-app
  isoloom-check-web:
    image: curlimages/curl:8.11.1
    profiles:
    - check
    entrypoint:
    - /bin/sh
    - /isoloom/run.sh
    network_mode: service:web
    volumes:
    - ./checks/web.sh:/isoloom/run.sh:ro
    depends_on:
      web:
        condition: service_healthy
      api:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: configured-app
  isoloom-check-api:
    image: curlimages/curl:8.11.1
    profiles:
    - check
    entrypoint:
    - /bin/sh
    - /isoloom/run.sh
    network_mode: service:api
    volumes:
    - ./checks/api.sh:/isoloom/run.sh:ro
    depends_on:
      web:
        condition: service_healthy
      api:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: configured-app
  isoloom-probe-amd64:
    image: busybox:1.37.0-musl
    platform: linux/amd64
    entrypoint:
    - /bin/cp
    - /bin/busybox
    - /probe/busybox
    network_mode: none
    volumes:
    - isoloom-probe-amd64:/probe
    labels:
      isoloom.managed: 'true'
      isoloom.environment: configured-app
    restart: no
networks:
  lab:
    ipam:
      config:
      - subnet: 10.66.0.0/24
        gateway: 10.66.0.1
    labels:
      isoloom.managed: 'true'
      isoloom.environment: configured-app
volumes:
  isoloom-probe-amd64:
    labels:
      isoloom.managed: 'true'
      isoloom.environment: configured-app

## .isoloom/docker/run.json
{
  "$schema": "https://www.isoloom.com/schema/run-manifest/v0.json",
  "manifest_version": 0,
  "generator": {
    "name": "isoloom",
    "version": "1.0.1"
  },
  "environment": {
    "name": "configured-app",
    "instance": null,
    "message": null
  },
  "target": "docker",
  "driver": "compose",
  "hosts": [
    "linux",
    "macos",
    "windows"
  ],
  "tools": [
    {
      "name": "docker",
      "probe": [
        "docker",
        "info",
        "--format",
        "{{.ServerVersion}}"
      ]
    },
    {
      "name": "docker-compose",
      "probe": [
        "docker",
        "compose",
        "version",
        "--short"
      ],
      "min_version": "2.17.0"
    }
  ],
  "identity": {
    "compose": {
      "project": "${run.name}",
      "files": [
        "compose.yml",
        "${run.state_dir}/ports.yml"
      ],
      "pinned_ports_file": "${run.state_dir}/ports.yml"
    }
  },
  "params": [
    {
      "name": "ISOLOOM_PUBLISH_ADDRESS",
      "description": "The host address published ports listen on.",
      "default": "127.0.0.1",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_PUBLISH_ADDRESS",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "ISOLOOM_PUBLISH_FIXED",
      "description": "Set: each published port takes its `publish:` number instead of an ephemeral one.",
      "values": [
        "1"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_PUBLISH_FIXED",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "ISOLOOM_DERIVED",
      "description": "0: the checks derived from the spec (reachability, no internet) are skipped.",
      "default": "1",
      "values": [
        "0",
        "1"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_DERIVED",
          "steps": [
            "check-networks",
            "check-web",
            "check-api"
          ]
        }
      ]
    }
  ],
  "secrets": [],
  "networks": [
    {
      "name": "lab",
      "cidr": "10.66.0.0/24",
      "internet": true,
      "native": "${run.name}_lab"
    }
  ],
  "machines": [
    {
      "name": "web",
      "role": "target",
      "arch": "amd64",
      "addresses": {
        "lab": "10.66.0.10"
      },
      "native": {
        "service": "web"
      },
      "ports": [
        {
          "name": "http",
          "port": 80,
          "protocol": "tcp",
          "http": true,
          "publish": {
            "mode": "ephemeral",
            "preferred": 8086,
            "address": "${params.ISOLOOM_PUBLISH_ADDRESS}"
          }
        }
      ]
    },
    {
      "name": "api",
      "role": "target",
      "arch": "amd64",
      "addresses": {
        "lab": "10.66.0.20"
      },
      "native": {
        "service": "api"
      },
      "ports": [
        {
          "name": "status",
          "port": 8080,
          "protocol": "tcp",
          "http": true
        },
        {
          "name": "health",
          "port": 8081,
          "protocol": "tcp",
          "http": true
        }
      ]
    },
    {
      "name": "isoloom-check",
      "role": "check",
      "addresses": {},
      "native": {
        "service": "isoloom-check"
      }
    },
    {
      "name": "isoloom-check-web",
      "role": "check",
      "of": "web",
      "addresses": {},
      "native": {
        "service": "isoloom-check-web"
      }
    },
    {
      "name": "isoloom-check-api",
      "role": "check",
      "of": "api",
      "addresses": {},
      "native": {
        "service": "isoloom-check-api"
      }
    },
    {
      "name": "isoloom-probe-amd64",
      "role": "infra",
      "addresses": {},
      "native": {
        "service": "isoloom-probe-amd64"
      }
    }
  ],
  "lifecycle": {
    "up": [
      {
        "id": "pin-ports",
        "note": "Picking the lab's host ports…",
        "action": "compose.pin_ports"
      },
      {
        "id": "ports-free",
        "action": "compose.check_ports_free"
      },
      {
        "id": "stale-networks",
        "action": "compose.remove_stale_networks",
        "failure": "tolerate"
      },
      {
        "id": "up",
        "note": "Starting the lab's containers…",
        "argv": [
          "docker",
          "compose",
          "--project-name",
          "${run.name}",
          "--file",
          "compose.yml",
          "--file",
          "${run.state_dir}/ports.yml",
          "up",
          "--detach",
          "--build",
          "--pull",
          "missing",
          "--wait",
          "--wait-timeout",
          "600"
        ],
        "timeout_s": 1800
      }
    ],
    "down": [
      {
        "id": "down",
        "argv": [
          "docker",
          "compose",
          "--project-name",
          "${run.name}",
          "--file",
          "compose.yml",
          "--file",
          "${run.state_dir}/ports.yml",
          "--profile",
          "check",
          "down",
          "--volumes",
          "--remove-orphans"
        ],
        "timeout_s": 300,
        "when": "always"
      },
      {
        "id": "containers",
        "action": "compose.remove_containers",
        "when": "always",
        "failure": "tolerate"
      },
      {
        "id": "networks",
        "action": "compose.remove_networks",
        "when": "always",
        "failure": "tolerate"
      }
    ],
    "park": {
      "pause": [
        {
          "id": "stop",
          "argv": [
            "docker",
            "compose",
            "--project-name",
            "${run.name}",
            "--file",
            "compose.yml",
            "--file",
            "${run.state_dir}/ports.yml",
            "stop"
          ],
          "timeout_s": 300
        }
      ],
      "shutdown": [
        {
          "id": "stop",
          "argv": [
            "docker",
            "compose",
            "--project-name",
            "${run.name}",
            "--file",
            "compose.yml",
            "--file",
            "${run.state_dir}/ports.yml",
            "stop"
          ],
          "timeout_s": 300
        }
      ]
    },
    "resume": [
      {
        "id": "start",
        "argv": [
          "docker",
          "compose",
          "--project-name",
          "${run.name}",
          "--file",
          "compose.yml",
          "--file",
          "${run.state_dir}/ports.yml",
          "start"
        ],
        "timeout_s": 600
      }
    ],
    "status": {
      "id": "ps",
      "argv": [
        "docker",
        "compose",
        "--project-name",
        "${run.name}",
        "--file",
        "compose.yml",
        "--file",
        "${run.state_dir}/ports.yml",
        "ps",
        "--all",
        "--format",
        "json"
      ],
      "timeout_s": 25
    }
  },
  "ready": [
    {
      "kind": "step_ok",
      "step": "up",
      "means": "every long-running service is healthy (`--wait`: each port's probe, the route keepers, the machines' own healthchecks)"
    }
  ],
  "outputs": [
    {
      "name": "web_http",
      "description": "web's http (port 80).",
      "role": "entry",
      "sensitive": false,
      "format": "http://127.0.0.1:${value}/",
      "from": {
        "kind": "published_port",
        "machine": "web",
        "port": "http"
      }
    }
  ],
  "checks": {
    "protocol": "isoloom-check/1",
    "setup": [],
    "runners": [
      {
        "id": "isoloom-check",
        "from": "from the environment's networks",
        "checks": [
          {
            "name": "checks/web-answers.sh",
            "kind": "script",
            "wait_s": 0,
            "derived": false
          },
          {
            "name": "checks/api-answers.sh",
            "kind": "script",
            "wait_s": 0,
            "derived": false
          }
        ],
        "step": {
          "id": "check-networks",
          "argv": [
            "docker",
            "compose",
            "--project-name",
            "${run.name}",
            "--file",
            "compose.yml",
            "--file",
            "${run.state_dir}/ports.yml",
            "--profile",
            "check",
            "run",
            "--rm",
            "--no-deps",
            "--env",
            "ISOLOOM_DERIVED",
            "isoloom-check"
          ],
          "timeout_s": 90
        },
        "on_timeout": [
          {
            "id": "rm-check-networks",
            "action": "compose.remove_containers",
            "with": {
              "one_off": "true",
              "service": "isoloom-check"
            },
            "failure": "tolerate"
          }
        ]
      },
      {
        "id": "isoloom-check-web",
        "from": "from web",
        "checks": [
          {
            "name": "api:8080 from web",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "api:8081 from web",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          }
        ],
        "step": {
          "id": "check-web",
          "argv": [
            "docker",
            "compose",
            "--project-name",
            "${run.name}",
            "--file",
            "compose.yml",
            "--file",
            "${run.state_dir}/ports.yml",
            "--profile",
            "check",
            "run",
            "--rm",
            "--no-deps",
            "--env",
            "ISOLOOM_DERIVED",
            "isoloom-check-web"
          ],
          "timeout_s": 150
        },
        "on_timeout": [
          {
            "id": "rm-check-web",
            "action": "compose.remove_containers",
            "with": {
              "one_off": "true",
              "service": "isoloom-check-web"
            },
            "failure": "tolerate"
          }
        ]
      },
      {
        "id": "isoloom-check-api",
        "from": "from api",
        "checks": [
          {
            "name": "web:80 from api",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          }
        ],
        "step": {
          "id": "check-api",
          "argv": [
            "docker",
            "compose",
            "--project-name",
            "${run.name}",
            "--file",
            "compose.yml",
            "--file",
            "${run.state_dir}/ports.yml",
            "--profile",
            "check",
            "run",
            "--rm",
            "--no-deps",
            "--env",
            "ISOLOOM_DERIVED",
            "isoloom-check-api"
          ],
          "timeout_s": 105
        },
        "on_timeout": [
          {
            "id": "rm-check-api",
            "action": "compose.remove_containers",
            "with": {
              "one_off": "true",
              "service": "isoloom-check-api"
            },
            "failure": "tolerate"
          }
        ]
      }
    ],
    "teardown": []
  },
  "recovery": {
    "stale_markers": [
      "is already in use by container",
      "network with name",
      "has incorrect label"
    ],
    "steps": [
      {
        "id": "containers",
        "action": "compose.remove_containers",
        "when": "always",
        "failure": "tolerate"
      },
      {
        "id": "networks",
        "action": "compose.remove_networks",
        "when": "always",
        "failure": "tolerate"
      }
    ],
    "retries": 1
  }
}

