  ],
  "clones": {},
  "tools": {},
  "groups": {},
  "router": null,
  "controller": {
    "role": "infra",
    "keep_running": false,
    "addresses": {
      "lab": "10.66.0.253"
    }
  },
  "published": [
    {
      "machine": "web",
      "name": "http",
      "port": 80,
      "protocol": "http",
      "host_port": 8086
    }
  ],
  "targets": {
    "possible": [
