            "name": "checks/web-answers.sh",
            "derived": false,
            "kind": "script",
            "target": "checks/web-answers.sh",
            "expect": "",
            "wait": 0
          },
          {
            "name": "checks/api-answers.sh",
            "derived": false,
            "kind": "script",
            "target": "checks/api-answers.sh",
            "expect": "",
            "wait": 0
          }
        ]
      },
      {
        "position": "web",
        "machine": "web",
        "runner": "isoloom-check-web",
        "checks": [
          {
            "name": "api:8080 from web",
            "derived": true,
            "kind": "http",
            "target": "http://10.66.0.20:8080/",
            "expect": "any",
            "wait": 30
          },
          {
            "name": "api:8081 from web",
            "derived": true,
            "kind": "http",
            "target": "http://10.66.0.20:8081/",
            "expect": "any",
            "wait": 30
          }
        ]
      },
      {
        "position": "api",
        "machine": "api",
        "runner": "isoloom-check-api",
        "checks": [
          {
            "name": "web:80 from api",
            "derived": true,
            "kind": "http",
            "target": "http://10.66.0.10:80/",
            "expect": "any",
            "wait": 30
          }
        ]
      }
    ]
  }
}
