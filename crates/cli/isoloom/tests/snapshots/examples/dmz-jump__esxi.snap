  else
    # shellcheck disable=SC2016 # the inner bash expands $H, $P and $L, for its /dev/tcp
    H=$1 P=$2 L=$3 timeout 6 bash -c 'exec 3<>/dev/tcp/$H/$P || exit 1; [ -z "$L" ] || printf "%s\n" "$L" >&3; cat <&3' >"$f" 2>/dev/null &
  fi
  p=$!
  while :; do
    if grep -qF -- "$4" "$f"; then r=0; break; fi
    if [ $i -ge 5 ] || ! kill -0 $p 2>/dev/null; then break; fi
    sleep 1; i=$((i+1))
  done
  [ $r = 0 ] || ! grep -qF -- "$4" "$f" || r=0
  touch "$f.end"; kill $p 2>/dev/null
  if [ $r = 1 ]; then
    if [ -s "$f" ]; then out="$1:$2 answered \"$(head -c 100 "$f" | tr -d '\000\r' | tr '\n\t' '  ')\", without the expected text"
    elif [ $i -lt 5 ]; then out="$1:$2 refused the connection or closed it without a word"
    else out="nothing read from $1:$2 within 5s"; fi
  fi
  rm -f "$f" "$f.end"; return $r
}
# _exec COMMAND TEXT -> 0 when the command succeeds and its output contains TEXT (if any).
_exec() { out=$(sh -c "$1" 2>&1) && { [ -z "$2" ] || printf '%s\n' "$out" | grep -qF -- "$2"; }; }
# _retry SECONDS COMMAND... -> keeps trying every 2s until it passes or the time is up.
_retry() { _end=$(( $(date +%s) + $1 )); shift; while ! "$@"; do [ "$(date +%s)" -lt "$_end" ] || return 1; sleep 2; done; }

echo '== checks/dmz-reachable.sh'
if _retry 0 sh -c 'cd /opt/isoloom && sh '\''checks/dmz-reachable.sh'\'''; then pass 'checks/dmz-reachable.sh'; else fail 'checks/dmz-reachable.sh' "checks/dmz-reachable.sh exited non-zero"; fi

echo '== checks/internal-not-reachable-from-access.sh'
if _retry 0 sh -c 'cd /opt/isoloom && sh '\''checks/internal-not-reachable-from-access.sh'\'''; then pass 'checks/internal-not-reachable-from-access.sh'; else fail 'checks/internal-not-reachable-from-access.sh' "checks/internal-not-reachable-from-access.sh exited non-zero"; fi

if [ "${ISOLOOM_DERIVED:-1}" != 0 ]; then
if _retry 30 _tcp '10.30.10.10' 80; then pass 'gateway:80 on dmz from user'; else fail 'gateway:80 on dmz from user' "nothing listens at 10.30.10.10:80"; fi
fi

if [ "${ISOLOOM_DERIVED:-1}" != 0 ]; then
if _retry 30 _tcp '10.30.10.10' 22; then pass 'gateway:22 on dmz from user'; else fail 'gateway:22 on dmz from user' "nothing listens at 10.30.10.10:22"; fi
fi

if [ "${ISOLOOM_DERIVED:-1}" != 0 ]; then
if _tcp '10.30.20.20' 8080; then fail 'app:8080 blocked from user' "10.30.20.20:8080 answered; it should be blocked"; else pass 'app:8080 blocked from user'; fi
fi

if [ "${ISOLOOM_DERIVED:-1}" != 0 ]; then
if _tcp '10.30.20.30' 5432; then fail 'db:5432 blocked from user' "10.30.20.30:5432 answered; it should be blocked"; else pass 'db:5432 blocked from user'; fi
fi

echo "isoloom-check: END $passed passed, $failed failed"
[ "$failed" -eq 0 ]

## .isoloom/esxi/main.tf
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Needs:  ovftool on this machine, SSH enabled on the ESXi host
# Auth:   export TF_VAR_esxi_password=<password> (from the environment: never on a command line)
# Start:  terraform -chdir=.isoloom/esxi init && terraform -chdir=.isoloom/esxi apply -var esxi_hostname=<host> \
#           -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)" -var ssh_private_key_file=~/.ssh/id_ed25519
# Stop:   terraform -chdir=.isoloom/esxi destroy (same variables)

terraform {
  required_version = ">= 1.6.0"
  backend "local" {}
  required_providers {
    esxi  = { source = "josenk/esxi", version = "~> 1.10.3" }
    tls   = { source = "hashicorp/tls", version = "~> 4.4.1" }
    local = { source = "hashicorp/local", version = "~> 2.9.1" }
  }
}

variable "esxi_hostname" {
  type        = string
  description = "The ESXi host's name or address"
}

variable "esxi_hostport" {
  type        = string
  default     = "22"
  description = "Its SSH port: the provider works over SSH"
}

variable "esxi_hostssl" {
  type    = string
  default = "443"
}

variable "esxi_username" {
  type    = string
  default = "root"
}

variable "esxi_password" {
  type      = string
  sensitive = true
}

variable "disk_store" {
  type        = string
  default     = "datastore1"
  description = "Where the VMs' disks go"
}

variable "uplink_port_group" {
  type        = string
  default     = "VM Network"
  description = "The port group the router reaches the internet through (DHCP)"
}

variable "slot" {
  type        = number
  default     = 1
  description = "1 to 63, unique per environment on this host: it names the vSwitches and the VMs, and makes the MACs"
  validation {
    condition     = var.slot >= 1 && var.slot <= 63
    error_message = "slot is 1 to 63."
  }
}

variable "images" {
  type = map(string)
  default = {
    "ubuntu-24.04" = "https://cloud-images.ubuntu.com/noble/20260926/noble-server-cloudimg-amd64.ova"
  }
  description = "An OVA per OS, a path or a URL: Ubuntu's cloud OVAs by default; for another OS, an OVA with cloud-init and open-vm-tools"
  validation {
    condition     = alltrue([for os in ["debian-12", "ubuntu-24.04"] : contains(keys(var.images), os)])
    error_message = "images needs an OVA for each of: debian-12, ubuntu-24.04."
  }
}

variable "ssh_public_key" {
  type        = string
  description = "The SSH public key the machines let in: whoever holds its private key signs in, as Terraform does to set them up (`ssh_private_key_file`), and the checks by hand"
}

variable "ssh_private_key_file" {
  type        = string
  description = "The private key of ssh_public_key: Terraform sets the machines up over SSH, through the router"
}

provider "esxi" {
  esxi_hostname = var.esxi_hostname
  esxi_hostport = var.esxi_hostport
  esxi_hostssl  = var.esxi_hostssl
  esxi_username = var.esxi_username
  esxi_password = var.esxi_password
}

# The project's root, and the `isoloom` user on every VM.
locals {
  root = abspath("${path.module}/../..")
  users = [
    {
      name                = "isoloom"
      sudo                = "ALL=(ALL) NOPASSWD:ALL"
      shell               = "/bin/bash"
      ssh_authorized_keys = [var.ssh_public_key]
    }
  ]
}

# Network `dmz`: 10.30.10.0/24, on its own vSwitch with no uplink.
resource "esxi_vswitch" "dmz" {
  name = "iso${var.slot}-dmz"
}

resource "esxi_portgroup" "dmz" {
  name    = "iso${var.slot}-dmz"
  vswitch = esxi_vswitch.dmz.name
  vlan    = 4095
}

# Network `internal`: 10.30.20.0/24, on its own vSwitch with no uplink.
resource "esxi_vswitch" "internal" {
  name = "iso${var.slot}-internal"
}

resource "esxi_portgroup" "internal" {
  name    = "iso${var.slot}-internal"
  vswitch = esxi_vswitch.internal.name
  vlan    = 4095
}

# Network `access`: 10.30.99.0/24, on its own vSwitch with no uplink.
resource "esxi_vswitch" "access" {
  name = "iso${var.slot}-access"
}

resource "esxi_portgroup" "access" {
  name    = "iso${var.slot}-access"
  vswitch = esxi_vswitch.access.name
  vlan    = 4095
}

# The router: forwards between networks with the reach rules, and to the internet. VMware Tools reports its uplink address.
resource "esxi_guest" "isoloom_router" {
  guest_name            = "iso${var.slot}-isoloom-router"
  notes                 = "isoloom: dmz-jump"
  disk_store            = var.disk_store
  ovf_source            = var.images["ubuntu-24.04"]
  numvcpus              = "1"
  memsize               = "512"
  boot_disk_size        = "10"
  power                 = "on"
  guest_startup_timeout = 600
  network_interfaces {
    virtual_network = var.uplink_port_group
    mac_address     = format("00:50:56:%02x:%02x:%02x", var.slot, 0, 0)
    nic_type        = "vmxnet3"
  }
  network_interfaces {
    virtual_network = esxi_portgroup.dmz.name
    mac_address     = format("00:50:56:%02x:%02x:%02x", var.slot, 0, 1)
    nic_type        = "vmxnet3"
  }
  network_interfaces {
    virtual_network = esxi_portgroup.internal.name
    mac_address     = format("00:50:56:%02x:%02x:%02x", var.slot, 0, 2)
    nic_type        = "vmxnet3"
  }
  network_interfaces {
    virtual_network = esxi_portgroup.access.name
    mac_address     = format("00:50:56:%02x:%02x:%02x", var.slot, 0, 3)
    nic_type        = "vmxnet3"
  }
  guestinfo = {
    metadata = base64encode(yamlencode({
      instance-id    = "iso${var.slot}-isoloom-router"
      local-hostname = "isoloom-router"
      network = {
        version = 2
        ethernets = {
          nic0 = { match = { macaddress = format("00:50:56:%02x:%02x:%02x", var.slot, 0, 0) }, dhcp4 = true }
          nic1 = {
            match     = { macaddress = format("00:50:56:%02x:%02x:%02x", var.slot, 0, 1) }
            addresses = ["10.30.10.254/24"]
          }
          nic2 = {
            match     = { macaddress = format("00:50:56:%02x:%02x:%02x", var.slot, 0, 2) }
            addresses = ["10.30.20.254/24"]
          }
          nic3 = {
            match     = { macaddress = format("00:50:56:%02x:%02x:%02x", var.slot, 0, 3) }
            addresses = ["10.30.99.254/24"]
          }
        }
      }
    }))
    "metadata.encoding" = "base64"
    userdata = base64encode(format("#cloud-config\n%s", yamlencode({
      hostname = "isoloom-router"
      users    = local.users
      packages = ["nftables"]
      write_files = [
        {
          path    = "/etc/nftables.conf"
          content = "flush ruleset\ntable inet isoloom {\n  chain forward {\n    type filter hook forward priority 0; policy drop;\n    ct state established,related accept\n    ip saddr 10.30.99.0/24 ip daddr 10.30.10.0/24 accept\n    ip saddr 10.30.10.0/24 ip daddr 10.30.20.0/24 meta l4proto { tcp, udp } th dport { 8080, 5432 } accept\n    ip saddr 10.30.10.0/24 ip daddr 10.30.20.0/24 icmp type echo-request accept\n    ip saddr { 10.30.10.0/24, 10.30.20.0/24, 10.30.99.0/24 } ip daddr != { 10.30.10.0/24, 10.30.20.0/24, 10.30.99.0/24 } accept\n  }\n  chain prerouting {\n    type nat hook prerouting priority -100;\n  }\n  chain postrouting {\n    type nat hook postrouting priority 100;\n    ip saddr { 10.30.10.0/24, 10.30.20.0/24, 10.30.99.0/24 } ip daddr != { 10.30.10.0/24, 10.30.20.0/24, 10.30.99.0/24 } masquerade\n  }\n}\n"
        },
        { path = "/etc/sysctl.d/90-isoloom.conf", content = "net.ipv4.ip_forward=1\n" },
        {
          path    = "/etc/nftables.sealed.nft"
          content = "flush ruleset\ntable inet isoloom {\n  chain forward {\n    type filter hook forward priority 0; policy drop;\n    ct state established,related accept\n    ip saddr 10.30.99.0/24 ip daddr 10.30.10.0/24 accept\n    ip saddr 10.30.10.0/24 ip daddr 10.30.20.0/24 meta l4proto { tcp, udp } th dport { 8080, 5432 } accept\n    ip saddr 10.30.10.0/24 ip daddr 10.30.20.0/24 icmp type echo-request accept\n    ip daddr { 10.30.20.0/24 } drop\n    ip saddr { 10.30.10.0/24, 10.30.99.0/24 } ip daddr != { 10.30.10.0/24, 10.30.99.0/24 } accept\n  }\n  chain prerouting {\n    type nat hook prerouting priority -100;\n  }\n  chain postrouting {\n    type nat hook postrouting priority 100;\n    ip saddr { 10.30.10.0/24, 10.30.99.0/24 } ip daddr != { 10.30.10.0/24, 10.30.99.0/24 } masquerade\n  }\n}\n"
        }
      ]
      runcmd = [
        "sysctl -p /etc/sysctl.d/90-isoloom.conf",
        "systemctl enable --now nftables",
        "nft -f /etc/nftables.conf"
      ]
    })))
    "userdata.encoding" = "base64"
  }
  lifecycle {
    postcondition {
      condition     = self.ip_address != "" && !contains(["10.30.10.254", "10.30.20.254", "10.30.99.254"], self.ip_address)
      error_message = "The router got no address on its uplink port group `${var.uplink_port_group}`: it has no DHCP (VMware Tools then reports a lab address). Give it an uplink with DHCP and internet (`uplink_port_group`; on a nested ESXi, promiscuous mode on)."
    }
  }
  depends_on = [esxi_portgroup.dmz, esxi_portgroup.internal, esxi_portgroup.access]
}

# Machine `gateway`.
resource "esxi_guest" "gateway" {
  guest_name     = "iso${var.slot}-gateway"
  notes          = "isoloom: dmz-jump"
  disk_store     = var.disk_store
  ovf_source     = var.images["debian-12"]
  numvcpus       = "1"
  memsize        = "1024"
  boot_disk_size = "20"
  power          = "on"
  network_interfaces {
    virtual_network = esxi_portgroup.dmz.name
    mac_address     = format("00:50:56:%02x:%02x:%02x", var.slot, 2, 0)
    nic_type        = "vmxnet3"
  }
  network_interfaces {
    virtual_network = esxi_portgroup.internal.name
    mac_address     = format("00:50:56:%02x:%02x:%02x", var.slot, 2, 1)
    nic_type        = "vmxnet3"
  }
  guestinfo = {
    metadata = base64encode(yamlencode({
      instance-id    = "iso${var.slot}-gateway"
      local-hostname = "gateway"
      network = {
        version = 2
        ethernets = {
          nic0 = {
            match       = { macaddress = format("00:50:56:%02x:%02x:%02x", var.slot, 2, 0) }
            addresses   = ["10.30.10.10/24"]
            routes      = [{ to = "0.0.0.0/0", via = "10.30.10.254" }]
            nameservers = { addresses = ["1.1.1.1"] }
          }
          nic1 = {
            match     = { macaddress = format("00:50:56:%02x:%02x:%02x", var.slot, 2, 1) }
            addresses = ["10.30.20.10/24"]
          }
        }
      }
    }))
    "metadata.encoding" = "base64"
    userdata            = base64encode(format("#cloud-config\n%s", yamlencode({ hostname = "gateway", users = local.users })))
    "userdata.encoding" = "base64"
  }
  depends_on = [esxi_guest.isoloom_router]
}

# Its set-up: its steps from the plan, over SSH through the router.
resource "terraform_data" "gateway" {
  triggers_replace = [esxi_guest.gateway.id]
  connection {
    type                = "ssh"
    host                = "10.30.10.10"
    user                = "isoloom"
    private_key         = file(pathexpand(var.ssh_private_key_file))
    bastion_host        = local.router_address
    bastion_user        = "isoloom"
    bastion_private_key = file(pathexpand(var.ssh_private_key_file))
    timeout             = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-gateway.tgz\" --exclude=\"${basename(local.root)}/.isoloom*\" --exclude=\".git\" --exclude=\".terraform\" --exclude=\"*.tfstate\" --exclude=\"*.tfstate.*\" --exclude=\".terraform.tfstate.lock.info\" --exclude=\"crash.log\" --exclude=\"crash.*.log\" --exclude=\".vagrant\" --exclude=\".isoloom-reach\" -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-gateway.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "remote-exec" {
    inline = [
      "set -e",
      "cloud-init status --wait >/dev/null 2>&1 || true",
      "sudo sh -c 'mkdir -p /var/lib/isoloom'",
      "sudo sh -c 'echo '\\''running: set-up'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz' || { sudo sh -c 'echo '\\''failed: set-up'\\'' > /var/lib/isoloom/ready'; exit 1; }",
      "sudo sh -c 'echo '\\''running: hosts file'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'printf '\\''%s\\n'\\'' '\\''10.30.10.10 gateway'\\'' '\\''10.30.20.20 app'\\'' '\\''10.30.20.30 db'\\'' '\\''10.30.99.10 user'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done' || { sudo sh -c 'echo '\\''failed: hosts file'\\'' > /var/lib/isoloom/ready'; exit 1; }",
      "sudo sh -c 'echo '\\''running: routes'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'ip route replace 10.30.99.0/24 via 10.30.10.254' || { sudo sh -c 'echo '\\''failed: routes'\\'' > /var/lib/isoloom/ready'; exit 1; }",
      "sudo sh -c 'echo '\\''running: provision/gateway.yml'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'pkg() { if command -v apt-get >/dev/null; then apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \"$@\"; elif command -v dnf >/dev/null; then dnf install -y -q \"$@\"; else yum install -y -q \"$@\"; fi; }\ncommand -v ansible-playbook >/dev/null || pkg ansible-core\ncd /opt/isoloom && sh -c '\\''ansible-playbook -c local -i gateway, '\\''\\'\\'''\\''provision/gateway.yml'\\''\\'\\'''\\'''\\''' || { sudo sh -c 'echo '\\''failed: provision/gateway.yml'\\'' > /var/lib/isoloom/ready'; exit 1; }",
      "sudo sh -c 'echo '\\''running: health check'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready' || { sudo sh -c 'echo '\\''failed: health check'\\'' > /var/lib/isoloom/ready'; exit 1; }"
    ]
  }
}

# Machine `app`.
resource "esxi_guest" "app" {
  guest_name     = "iso${var.slot}-app"
  notes          = "isoloom: dmz-jump"
  disk_store     = var.disk_store
  ovf_source     = var.images["debian-12"]
  numvcpus       = "1"
  memsize        = "1024"
  boot_disk_size = "20"
  power          = "on"
  network_interfaces {
    virtual_network = esxi_portgroup.internal.name
    mac_address     = format("00:50:56:%02x:%02x:%02x", var.slot, 3, 0)
    nic_type        = "vmxnet3"
  }
  guestinfo = {
    metadata = base64encode(yamlencode({
      instance-id    = "iso${var.slot}-app"
      local-hostname = "app"
      network = {
        version = 2
        ethernets = {
          nic0 = {
            match       = { macaddress = format("00:50:56:%02x:%02x:%02x", var.slot, 3, 0) }
            addresses   = ["10.30.20.20/24"]
            routes      = [{ to = "0.0.0.0/0", via = "10.30.20.254" }]
            nameservers = { addresses = ["1.1.1.1"] }
          }
        }
      }
    }))
    "metadata.encoding" = "base64"
    userdata            = base64encode(format("#cloud-config\n%s", yamlencode({ hostname = "app", users = local.users })))
    "userdata.encoding" = "base64"
  }
  depends_on = [esxi_guest.isoloom_router]
}

# Its set-up: its steps from the plan, over SSH through the router.
resource "terraform_data" "app" {
  triggers_replace = [esxi_guest.app.id]
  connection {
    type                = "ssh"
    host                = "10.30.20.20"
    user                = "isoloom"
    private_key         = file(pathexpand(var.ssh_private_key_file))
    bastion_host        = local.router_address
    bastion_user        = "isoloom"
    bastion_private_key = file(pathexpand(var.ssh_private_key_file))
    timeout             = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-app.tgz\" --exclude=\"${basename(local.root)}/.isoloom*\" --exclude=\".git\" --exclude=\".terraform\" --exclude=\"*.tfstate\" --exclude=\"*.tfstate.*\" --exclude=\".terraform.tfstate.lock.info\" --exclude=\"crash.log\" --exclude=\"crash.*.log\" --exclude=\".vagrant\" --exclude=\".isoloom-reach\" -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-app.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "remote-exec" {
    inline = [
      "set -e",
      "cloud-init status --wait >/dev/null 2>&1 || true",
      "sudo sh -c 'mkdir -p /var/lib/isoloom'",
      "sudo sh -c 'echo '\\''running: set-up'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz' || { sudo sh -c 'echo '\\''failed: set-up'\\'' > /var/lib/isoloom/ready'; exit 1; }",
      "sudo sh -c 'echo '\\''running: hosts file'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'printf '\\''%s\\n'\\'' '\\''10.30.20.10 gateway'\\'' '\\''10.30.20.20 app'\\'' '\\''10.30.20.30 db'\\'' '\\''10.30.99.10 user'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done' || { sudo sh -c 'echo '\\''failed: hosts file'\\'' > /var/lib/isoloom/ready'; exit 1; }",
      "sudo sh -c 'echo '\\''running: routes'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'ip route replace 10.30.10.0/24 via 10.30.20.254\nip route replace 10.30.99.0/24 via 10.30.20.254' || { sudo sh -c 'echo '\\''failed: routes'\\'' > /var/lib/isoloom/ready'; exit 1; }",
      "sudo sh -c 'echo '\\''running: provision/app.yml'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'pkg() { if command -v apt-get >/dev/null; then apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \"$@\"; elif command -v dnf >/dev/null; then dnf install -y -q \"$@\"; else yum install -y -q \"$@\"; fi; }\ncommand -v ansible-playbook >/dev/null || pkg ansible-core\ncd /opt/isoloom && sh -c '\\''ansible-playbook -c local -i app, '\\''\\'\\'''\\''provision/app.yml'\\''\\'\\'''\\'''\\''' || { sudo sh -c 'echo '\\''failed: provision/app.yml'\\'' > /var/lib/isoloom/ready'; exit 1; }",
      "sudo sh -c 'echo '\\''running: closing the internet'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'pkg() { if command -v apt-get >/dev/null; then apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \"$@\"; elif command -v dnf >/dev/null; then dnf install -y -q \"$@\"; else yum install -y -q \"$@\"; fi; }\ncommand -v nft >/dev/null || if command -v apk >/dev/null; then apk add -q --no-cache nftables; else pkg nftables; fi\nprintf '\\''%s\\n'\\'' '\\''table inet isoloom-egress'\\'' '\\''delete table inet isoloom-egress'\\'' '\\''table inet isoloom-egress {'\\'' '\\''  chain output {'\\'' '\\''    type filter hook output priority 0; policy accept;'\\'' '\\''    oifname \"lo\" accept'\\'' '\\''    ip daddr != { 10.30.10.0/24, 10.30.20.0/24, 10.30.99.0/24 } ct state new drop'\\'' '\\''  }'\\'' '\\''}'\\'' > /etc/isoloom-egress.nft\nmkdir -p /etc/isoloom\ncat > /etc/isoloom/egress.sh <<'\\''EGRESS'\\''\n#!/bin/sh\n# No new connection leaves the isoloom networks\nnft -f /etc/isoloom-egress.nft\nexit 0\nEGRESS\nchmod +x /etc/isoloom/egress.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-egress.service <<'\\''UNIT'\\''\n[Unit]\nDescription=No new connection leaves the isoloom networks\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=-/etc/isoloom/egress.sh\n\n[Install]\nWantedBy=multi-user.target\nUNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-egress.service\nsystemctl restart isoloom-egress.service\nelse\nmkdir -p /etc/local.d && ln -sf /etc/isoloom/egress.sh /etc/local.d/isoloom-egress.start\nrc-update add local default >/dev/null 2>&1 || true\n/etc/isoloom/egress.sh || true\nfi' || { sudo sh -c 'echo '\\''failed: closing the internet'\\'' > /var/lib/isoloom/ready'; exit 1; }",
      "sudo sh -c 'echo '\\''running: health check'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready' || { sudo sh -c 'echo '\\''failed: health check'\\'' > /var/lib/isoloom/ready'; exit 1; }"
    ]
  }
}

# Machine `db`.
resource "esxi_guest" "db" {
  guest_name     = "iso${var.slot}-db"
  notes          = "isoloom: dmz-jump"
  disk_store     = var.disk_store
  ovf_source     = var.images["debian-12"]
  numvcpus       = "1"
  memsize        = "1024"
  boot_disk_size = "20"
  power          = "on"
  network_interfaces {
    virtual_network = esxi_portgroup.internal.name
    mac_address     = format("00:50:56:%02x:%02x:%02x", var.slot, 4, 0)
    nic_type        = "vmxnet3"
  }
  guestinfo = {
    metadata = base64encode(yamlencode({
      instance-id    = "iso${var.slot}-db"
      local-hostname = "db"
      network = {
        version = 2
        ethernets = {
          nic0 = {
            match       = { macaddress = format("00:50:56:%02x:%02x:%02x", var.slot, 4, 0) }
            addresses   = ["10.30.20.30/24"]
            routes      = [{ to = "0.0.0.0/0", via = "10.30.20.254" }]
            nameservers = { addresses = ["1.1.1.1"] }
          }
        }
      }
    }))
    "metadata.encoding" = "base64"
    userdata            = base64encode(format("#cloud-config\n%s", yamlencode({ hostname = "db", users = local.users })))
    "userdata.encoding" = "base64"
  }
  depends_on = [esxi_guest.isoloom_router]
}

# Its set-up: its steps from the plan, over SSH through the router.
resource "terraform_data" "db" {
  triggers_replace = [esxi_guest.db.id]
  connection {
    type                = "ssh"
    host                = "10.30.20.30"
    user                = "isoloom"
    private_key         = file(pathexpand(var.ssh_private_key_file))
    bastion_host        = local.router_address
    bastion_user        = "isoloom"
    bastion_private_key = file(pathexpand(var.ssh_private_key_file))
    timeout             = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-db.tgz\" --exclude=\"${basename(local.root)}/.isoloom*\" --exclude=\".git\" --exclude=\".terraform\" --exclude=\"*.tfstate\" --exclude=\"*.tfstate.*\" --exclude=\".terraform.tfstate.lock.info\" --exclude=\"crash.log\" --exclude=\"crash.*.log\" --exclude=\".vagrant\" --exclude=\".isoloom-reach\" -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-db.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "remote-exec" {
    inline = [
      "set -e",
      "cloud-init status --wait >/dev/null 2>&1 || true",
      "sudo sh -c 'mkdir -p /var/lib/isoloom'",
      "sudo sh -c 'echo '\\''running: set-up'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz' || { sudo sh -c 'echo '\\''failed: set-up'\\'' > /var/lib/isoloom/ready'; exit 1; }",
      "sudo sh -c 'echo '\\''running: hosts file'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'printf '\\''%s\\n'\\'' '\\''10.30.20.10 gateway'\\'' '\\''10.30.20.20 app'\\'' '\\''10.30.20.30 db'\\'' '\\''10.30.99.10 user'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done' || { sudo sh -c 'echo '\\''failed: hosts file'\\'' > /var/lib/isoloom/ready'; exit 1; }",
      "sudo sh -c 'echo '\\''running: routes'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'ip route replace 10.30.10.0/24 via 10.30.20.254\nip route replace 10.30.99.0/24 via 10.30.20.254' || { sudo sh -c 'echo '\\''failed: routes'\\'' > /var/lib/isoloom/ready'; exit 1; }",
      "sudo sh -c 'echo '\\''running: provision/db.yml'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'pkg() { if command -v apt-get >/dev/null; then apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \"$@\"; elif command -v dnf >/dev/null; then dnf install -y -q \"$@\"; else yum install -y -q \"$@\"; fi; }\ncommand -v ansible-playbook >/dev/null || pkg ansible-core\ncd /opt/isoloom && sh -c '\\''ansible-playbook -c local -i db, '\\''\\'\\'''\\''provision/db.yml'\\''\\'\\'''\\'''\\''' || { sudo sh -c 'echo '\\''failed: provision/db.yml'\\'' > /var/lib/isoloom/ready'; exit 1; }",
      "sudo sh -c 'echo '\\''running: closing the internet'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'pkg() { if command -v apt-get >/dev/null; then apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \"$@\"; elif command -v dnf >/dev/null; then dnf install -y -q \"$@\"; else yum install -y -q \"$@\"; fi; }\ncommand -v nft >/dev/null || if command -v apk >/dev/null; then apk add -q --no-cache nftables; else pkg nftables; fi\nprintf '\\''%s\\n'\\'' '\\''table inet isoloom-egress'\\'' '\\''delete table inet isoloom-egress'\\'' '\\''table inet isoloom-egress {'\\'' '\\''  chain output {'\\'' '\\''    type filter hook output priority 0; policy accept;'\\'' '\\''    oifname \"lo\" accept'\\'' '\\''    ip daddr != { 10.30.10.0/24, 10.30.20.0/24, 10.30.99.0/24 } ct state new drop'\\'' '\\''  }'\\'' '\\''}'\\'' > /etc/isoloom-egress.nft\nmkdir -p /etc/isoloom\ncat > /etc/isoloom/egress.sh <<'\\''EGRESS'\\''\n#!/bin/sh\n# No new connection leaves the isoloom networks\nnft -f /etc/isoloom-egress.nft\nexit 0\nEGRESS\nchmod +x /etc/isoloom/egress.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-egress.service <<'\\''UNIT'\\''\n[Unit]\nDescription=No new connection leaves the isoloom networks\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=-/etc/isoloom/egress.sh\n\n[Install]\nWantedBy=multi-user.target\nUNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-egress.service\nsystemctl restart isoloom-egress.service\nelse\nmkdir -p /etc/local.d && ln -sf /etc/isoloom/egress.sh /etc/local.d/isoloom-egress.start\nrc-update add local default >/dev/null 2>&1 || true\n/etc/isoloom/egress.sh || true\nfi' || { sudo sh -c 'echo '\\''failed: closing the internet'\\'' > /var/lib/isoloom/ready'; exit 1; }",
      "sudo sh -c 'echo '\\''running: health check'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready' || { sudo sh -c 'echo '\\''failed: health check'\\'' > /var/lib/isoloom/ready'; exit 1; }"
    ]
  }
}

# Machine `user`.
resource "esxi_guest" "user" {
  guest_name     = "iso${var.slot}-user"
  notes          = "isoloom: dmz-jump"
  disk_store     = var.disk_store
  ovf_source     = var.images["debian-12"]
  numvcpus       = "1"
  memsize        = "1024"
  boot_disk_size = "20"
  power          = "on"
  network_interfaces {
    virtual_network = esxi_portgroup.access.name
    mac_address     = format("00:50:56:%02x:%02x:%02x", var.slot, 5, 0)
    nic_type        = "vmxnet3"
  }
  guestinfo = {
    metadata = base64encode(yamlencode({
      instance-id    = "iso${var.slot}-user"
      local-hostname = "user"
      network = {
        version = 2
        ethernets = {
          nic0 = {
            match       = { macaddress = format("00:50:56:%02x:%02x:%02x", var.slot, 5, 0) }
            addresses   = ["10.30.99.10/24"]
            routes      = [{ to = "0.0.0.0/0", via = "10.30.99.254" }]
            nameservers = { addresses = ["1.1.1.1"] }
          }
        }
      }
    }))
    "metadata.encoding" = "base64"
    userdata            = base64encode(format("#cloud-config\n%s", yamlencode({ hostname = "user", users = local.users })))
    "userdata.encoding" = "base64"
  }
  depends_on = [esxi_guest.isoloom_router]
}

# Its set-up: its steps from the plan, over SSH through the router.
resource "terraform_data" "user" {
  triggers_replace = [esxi_guest.user.id]
  connection {
    type                = "ssh"
    host                = "10.30.99.10"
    user                = "isoloom"
    private_key         = file(pathexpand(var.ssh_private_key_file))
    bastion_host        = local.router_address
    bastion_user        = "isoloom"
    bastion_private_key = file(pathexpand(var.ssh_private_key_file))
    timeout             = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-user.tgz\" --exclude=\"${basename(local.root)}/.isoloom*\" --exclude=\".git\" --exclude=\".terraform\" --exclude=\"*.tfstate\" --exclude=\"*.tfstate.*\" --exclude=\".terraform.tfstate.lock.info\" --exclude=\"crash.log\" --exclude=\"crash.*.log\" --exclude=\".vagrant\" --exclude=\".isoloom-reach\" -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-user.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "remote-exec" {
    inline = [
      "set -e",
      "cloud-init status --wait >/dev/null 2>&1 || true",
      "sudo sh -c 'mkdir -p /var/lib/isoloom'",
      "sudo sh -c 'echo '\\''running: set-up'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz' || { sudo sh -c 'echo '\\''failed: set-up'\\'' > /var/lib/isoloom/ready'; exit 1; }",
      "sudo sh -c 'echo '\\''running: hosts file'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'printf '\\''%s\\n'\\'' '\\''10.30.10.10 gateway'\\'' '\\''10.30.20.20 app'\\'' '\\''10.30.20.30 db'\\'' '\\''10.30.99.10 user'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done' || { sudo sh -c 'echo '\\''failed: hosts file'\\'' > /var/lib/isoloom/ready'; exit 1; }",
      "sudo sh -c 'echo '\\''running: routes'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'ip route replace 10.30.10.0/24 via 10.30.99.254\nip route replace 10.30.20.0/24 via 10.30.99.254' || { sudo sh -c 'echo '\\''failed: routes'\\'' > /var/lib/isoloom/ready'; exit 1; }",
      "sudo sh -c 'echo '\\''running: health check'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready' || { sudo sh -c 'echo '\\''failed: health check'\\'' > /var/lib/isoloom/ready'; exit 1; }"
    ]
  }
}

locals {
  router_address = esxi_guest.isoloom_router.ip_address
}

# The router's uplink address: the lab's way in.
output "ip" {
  value = local.router_address
}

# Each Linux machine's set-up progress (`isoloom-ready/1`: `running: <step>`, `failed: <step>`, `ready`).
output "ready_file" {
  value = "/var/lib/isoloom/ready"
}

# The machines, through the router: ssh -J isoloom@<ip> isoloom@<machine>.
output "machines" {
  value = { gateway = "10.30.10.10", app = "10.30.20.20", db = "10.30.20.30", user = "10.30.99.10" }
}

output "ssh_user" {
  value = "isoloom"
}

# The checks: each runner piped to its machine (ssh -J isoloom@<ip> isoloom@<host> sh -s < <script>).
output "checks" {
  value = [
    {
      position = "user"
      machine  = "user"
      host     = "10.30.99.10"
      user     = "isoloom"
      script   = ".isoloom/esxi/checks/user.sh"
    },
    {
      position = "gateway"
      machine  = "gateway"
      host     = "10.30.10.10"
      user     = "isoloom"
      script   = ".isoloom/esxi/checks/gateway.sh"
    },
    {
      position = "app"
      machine  = "app"
      host     = "10.30.20.20"
      user     = "isoloom"
      script   = ".isoloom/esxi/checks/app.sh"
    },
    {
      position = "db"
      machine  = "db"
      host     = "10.30.20.30"
      user     = "isoloom"
      script   = ".isoloom/esxi/checks/db.sh"
    }
  ]
}

# The project's files the machines don't get: what .isoloomignore at the project's root lists
# (gitignore-style: one pattern per line, `#` comments, `!` brings a path back, a trailing `/`
# matches folders only, a `/` at the start or in the middle anchors the pattern at the root; `*`,
# `?`, `[abc]`, `**`; the last pattern matching a path, or a folder it is in, decides), then
# Isoloom's outputs, version control and the tools' state. Read as regular expressions, as the
# Vagrantfiles do.
locals {
  project_ignore_lines = [for l in split("\n", "${replace(try(file("${local.root}/.isoloomignore"), ""), "\r", "")}\n/.isoloom*\n.git/\n.terraform/\n*.tfstate\n*.tfstate.*\n.terraform.tfstate.lock.info\ncrash.log\ncrash.*.log\n.vagrant/\n.isoloom-reach/\n") : trimspace(l)]
  project_ignore_pats  = [for l in local.project_ignore_lines : { keep = startswith(l, "!"), pat = trimprefix(l, "!") } if l != "" && !startswith(l, "#")]
  project_ignore_globs = [for r in local.project_ignore_pats : merge(r, { glob = trimsuffix(trimsuffix(trimsuffix(r.pat, "/"), "/**"), "/") })]
  project_ignore = [for r in local.project_ignore_globs : {
    keep = r.keep
    re = format(r.glob == r.pat ? "^%s(/|$)" : "^%s/", replace(replace(replace(replace(replace(replace(replace(replace(
      length(split("/", r.glob)) > 1 ? trimprefix(r.glob, "/") : "**/${r.glob}",
    "/[.+^$(){}|\\\\]/", "\\$0"), "[!", "[^"), "**/", "\u0001"), "**", "\u0002"), "*", "[^/]*"), "?", "[^/]"), "\u0001", "(.*/)?"), "\u0002", ".*"))
  } if r.glob != ""]
  # Each file: whether it goes (the last matching pattern decides; none: it goes).
  project_keep    = { for f in fileset(local.root, "**") : f => reverse(concat([true], [for r in local.project_ignore : r.keep if length(regexall(r.re, f)) > 0]))[0] }
  project_ignored = [for f, keep in local.project_keep : f if !keep]
}

# What `tar` leaves out of the project's archive: .isoloomignore's files, from the archive's top
# folder, their wildcard characters escaped.
resource "local_file" "isoloom_project" {
  filename = "${path.module}/.isoloom-project-ignored.txt"
  content  = join("", [for f in local.project_ignored : "${replace("${basename(local.root)}/${f}", "/[\\\\*?\\[]/", "\\$0")}\n"])
}

## .isoloom/resolved.json: identical in the `docker` snapshot
