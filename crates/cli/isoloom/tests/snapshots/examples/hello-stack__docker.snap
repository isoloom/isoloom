      "os_version": "12"
    },
    "web": {
      "access": false,
      "supplied": false,
      "shapes": [
        "docker",
        "vm"
      ],
      "role": "target",
      "arch": "amd64",
      "os": "debian-12",
      "windows": false,
      "addresses": {
        "app": "10.60.0.10"
      },
      "docker_addresses": {
        "app": "10.60.0.10"
      },
      "ports": [
        {
          "port": 80,
          "name": null,
          "http": true,
          "publish": 8080
        }
      ],
      "depends_on": [
        "cache"
      ],
      "inputs": [],
      "volumes": {},
      "resources": {
        "cpus": 1,
        "memory_mb": 1024,
        "disk_gb": 20
      },
      "gateway_of": [],
      "routes": [],
      "default_gateway": null,
      "offline": true,
      "os_family": "debian",
      "os_version": "12"
    }
  },
  "start_order": [
    "cache",
    "web"
  ],
  "clones": {},
  "tools": {},
  "groups": {},
  "router": null,
  "controller": {
    "role": "infra",
    "keep_running": false,
    "addresses": {
      "app": "10.60.0.253"
    }
  },
  "published": [
    {
      "machine": "web",
      "port": 80,
      "host_port": 8080
    }
  ],
  "targets": {
    "possible": [
      "docker",
      "hosted",
      "docker-vm",
      "cloud-docker",
      "kubernetes",
      "vagrant",
      "proxmox",
      "esxi",
      "cloud-vm"
    ],
    "generated": [
      "docker",
      "hosted",
      "docker-vm",
      "cloud-docker",
      "kubernetes",
      "vagrant",
      "proxmox",
      "esxi",
      "cloud-vm"
    ],
    "refused": {},
    "not_possible": {
      "hybrid": "only when some machines are containers and others are VMs",
      "external": "needs `external:` on cache, web",
      "cloud-services": "left out by `targets:`"
    },
    "clouds": {
      "cloud-vm": {
        "generated": [
          "aws",
          "azure",
          "gcp",
          "linode",
          "oci"
        ],
        "refused": {
          "digitalocean": "DigitalOcean cloud-vm takes one machine on one network: a droplet joins one VPC, at a private address DigitalOcean picks, so other machines couldn't reach it at its spec address"
        }
      }
    }
  },
  "checks": {
    "default_position": "networks",
    "positions": [
      {
        "position": "networks",
        "machine": null,
        "runner": "isoloom-check",
        "checks": [
          {
            "name": "checks/cache-seeded.sh",
            "derived": false,
            "kind": "script",
            "target": "checks/cache-seeded.sh",
            "expect": "",
            "wait": 0
          },
          {
            "name": "the page greets",
            "derived": false,
            "kind": "http",
            "target": "http://web/",
            "expect": "200",
            "wait": 30
          },
          {
            "name": "the cache answers a PING",
            "derived": false,
            "kind": "tcp",
            "target": "cache:6379",
            "expect": "open",
            "wait": 30
          },
          {
            "name": "the page says hello",
            "derived": false,
            "kind": "http",
            "target": "http://web/",
            "expect": "200",
            "wait": 30
          },
          {
            "name": "the folder's address without its slash redirects",
            "derived": false,
            "kind": "http",
            "target": "http://web/hello",
            "expect": "301",
            "wait": 30
          },
          {
            "name": "the folder's page, past the redirect",
            "derived": false,
            "kind": "http",
            "target": "http://web/hello",
            "expect": "200",
            "wait": 30,
            "follow": true
          },
          {
            "name": "the static page refuses a POST",
            "derived": false,
            "kind": "http",
            "target": "http://web/",
            "expect": "405",
            "wait": 30
          }
        ]
      },
      {
        "position": "cache",
        "machine": "cache",
        "runner": "isoloom-check-cache",
        "checks": [
          {
            "name": "the cache holds the greeting, read inside it",
            "derived": false,
            "kind": "exec",
            "target": "redis-cli get greeting",
            "expect": "hello from isoloom",
            "wait": 0
          },
          {
            "name": "web:80 from cache",
            "derived": true,
            "kind": "http",
            "target": "http://10.60.0.10:80/",
            "expect": "any",
            "wait": 30
          },
          {
            "name": "no internet from cache",
            "derived": true,
            "kind": "http",
            "target": "http://1.1.1.1/",
            "expect": "blocked",
            "wait": 0
          }
        ]
      },
      {
        "position": "web",
        "machine": "web",
        "runner": "isoloom-check-web",
        "checks": [
          {
            "name": "cache:6379 from web",
            "derived": true,
            "kind": "tcp",
            "target": "10.60.0.20:6379",
            "expect": "open",
            "wait": 30
          },
          {
            "name": "no internet from web",
            "derived": true,
            "kind": "http",
            "target": "http://1.1.1.1/",
            "expect": "blocked",
            "wait": 0
          }
        ]
      }
    ]
  },
  "message": "The page answers at http://localhost:8080/ (and at\nhttp://web/ from inside). The cache at 10.60.0.20:6379 holds the\ngreeting seeded at start; nothing here reaches the internet.\n"
}
