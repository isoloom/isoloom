fi

if [ "${ISOLOOM_DERIVED:-1}" != 0 ]; then
c=$(_http 'http://1.1.1.1/'); if [ "$c" = 000 ]; then pass 'no internet from web'; else fail 'no internet from web' "http://1.1.1.1/ answered (HTTP $c); it should be blocked"; fi
fi

echo "isoloom-check: END $passed passed, $failed failed"
[ "$failed" -eq 0 ]

## .isoloom/docker/compose.yml
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  docker compose -f .isoloom/docker/compose.yml up -d --wait
# Checks: isoloom test docker (or: docker compose -f .isoloom/docker/compose.yml --profile check run --rm isoloom-check, and isoloom-check-<machine>)
# Stop:   docker compose -f .isoloom/docker/compose.yml down -v

name: hello-stack
services:
  cache:
    image: redis:7-alpine
    platform: linux/amd64
    hostname: cache
    networks:
      app:
        ipv4_address: 10.60.0.20
    volumes:
    - cache-data:/data
    - isoloom-probe-amd64:/.isoloom-probe:ro
    healthcheck:
      test:
      - CMD
      - /.isoloom-probe/busybox
      - sh
      - -c
      - /.isoloom-probe/busybox nc -z -w 2 127.0.0.1 6379
      interval: 5s
      timeout: 3s
      retries: 60
      start_period: 10s
    depends_on:
      isoloom-probe-amd64:
        condition: service_completed_successfully
    labels:
      isoloom.port.redis: tcp:6379
      isoloom.managed: 'true'
      isoloom.environment: hello-stack
    restart: unless-stopped
  cache-routes:
    image: alpine:3.20
    entrypoint:
    - /bin/sh
    - -c
    - (ip route del default 2>/dev/null || true) && while ip -o -4 addr show | grep -qv ' lo '; do sleep 2; done; exit 1
    network_mode: service:cache
    cap_add:
    - NET_ADMIN
    healthcheck:
      test:
      - CMD-SHELL
      - '! ip route | grep -q ''^default'''
      interval: 2s
      timeout: 2s
      retries: 30
    depends_on:
      cache:
        condition: service_started
    labels:
      isoloom.managed: 'true'
      isoloom.environment: hello-stack
    restart: unless-stopped
  cache-init-1:
    image: redis:7-alpine
    user: root
    entrypoint:
    - /bin/sh
    - /isoloom/init/seed.sh
    network_mode: service:cache
    volumes:
    - ../../build/cache/seed.sh:/isoloom/init/seed.sh:ro
    - cache-data:/data
    depends_on:
      cache:
        condition: service_healthy
      cache-routes:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: hello-stack
    restart: no
  web:
    build:
      context: ../../build/web
      labels:
        isoloom.managed: 'true'
        isoloom.environment: hello-stack
    image: isoloom/hello-stack-web
    platform: linux/amd64
    hostname: web
    networks:
      app:
        ipv4_address: 10.60.0.10
    ports:
    - ${ISOLOOM_PUBLISH_ADDRESS:-127.0.0.1}:${ISOLOOM_PUBLISH_FIXED:+8080}:80
    volumes:
    - isoloom-probe-amd64:/.isoloom-probe:ro
    healthcheck:
      test:
      - CMD
      - /.isoloom-probe/busybox
      - sh
      - -c
      - /.isoloom-probe/busybox nc -z -w 2 127.0.0.1 80
      interval: 5s
      timeout: 3s
      retries: 60
      start_period: 10s
    depends_on:
      isoloom-probe-amd64:
        condition: service_completed_successfully
      cache:
        condition: service_healthy
      cache-init-1:
        condition: service_completed_successfully
      cache-routes:
        condition: service_healthy
    labels:
      isoloom.port.80: http:80
      isoloom.managed: 'true'
      isoloom.environment: hello-stack
    restart: unless-stopped
  web-routes:
    image: alpine:3.20
    entrypoint:
    - /bin/sh
    - -c
    - (ip route del default 2>/dev/null || true) && while ip -o -4 addr show | grep -qv ' lo '; do sleep 2; done; exit 1
    network_mode: service:web
    cap_add:
    - NET_ADMIN
    healthcheck:
      test:
      - CMD-SHELL
      - '! ip route | grep -q ''^default'''
      interval: 2s
      timeout: 2s
      retries: 30
    depends_on:
      web:
        condition: service_started
    labels:
      isoloom.managed: 'true'
      isoloom.environment: hello-stack
    restart: unless-stopped
  isoloom-check:
    image: curlimages/curl:8.11.1
    profiles:
    - check
    user: '0'
    entrypoint:
    - /bin/sh
    - -c
    - ip route del default 2>/dev/null; exec sh /isoloom/run.sh
    networks:
      app: null
    cap_add:
    - NET_ADMIN
    volumes:
    - ./checks/networks.sh:/isoloom/run.sh:ro
    - ../..:/isoloom/project:ro
    depends_on:
      cache:
        condition: service_healthy
      cache-init-1:
        condition: service_completed_successfully
      cache-routes:
        condition: service_healthy
      web:
        condition: service_healthy
      web-routes:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: hello-stack
  isoloom-check-cache:
    image: curlimages/curl:8.11.1
    profiles:
    - check
    entrypoint:
    - /bin/sh
    - /isoloom/run.sh
    network_mode: service:cache
    volumes:
    - ./checks/cache.sh:/isoloom/run.sh:ro
    depends_on:
      cache:
        condition: service_healthy
      cache-init-1:
        condition: service_completed_successfully
      cache-routes:
        condition: service_healthy
      web:
        condition: service_healthy
      web-routes:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: hello-stack
  isoloom-check-web:
    image: curlimages/curl:8.11.1
    profiles:
    - check
    entrypoint:
    - /bin/sh
    - /isoloom/run.sh
    network_mode: service:web
    volumes:
    - ./checks/web.sh:/isoloom/run.sh:ro
    depends_on:
      cache:
        condition: service_healthy
      cache-init-1:
        condition: service_completed_successfully
      cache-routes:
        condition: service_healthy
      web:
        condition: service_healthy
      web-routes:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: hello-stack
  isoloom-probe-amd64:
    image: busybox:1.37.0-musl
    platform: linux/amd64
    entrypoint:
    - /bin/cp
    - /bin/busybox
    - /probe/busybox
    network_mode: none
    volumes:
    - isoloom-probe-amd64:/probe
    labels:
      isoloom.managed: 'true'
      isoloom.environment: hello-stack
    restart: no
networks:
  app:
    ipam:
      config:
      - subnet: 10.60.0.0/24
        gateway: 10.60.0.1
    labels:
      isoloom.managed: 'true'
      isoloom.environment: hello-stack
volumes:
  cache-data:
    labels:
      isoloom.managed: 'true'
      isoloom.environment: hello-stack
  isoloom-probe-amd64:
    labels:
      isoloom.managed: 'true'
      isoloom.environment: hello-stack

## .isoloom/docker/run.json
{
  "$schema": "https://www.isoloom.com/schema/run-manifest/v0.json",
  "manifest_version": 0,
  "generator": {
    "name": "isoloom",
    "version": "0.10.1"
  },
  "lab": {
    "name": "hello-stack",
    "instance": null,
    "message": "The page answers at http://localhost:${published.web.80}/ (and at\nhttp://web/ from inside). The cache at 10.60.0.20:6379 holds the\ngreeting seeded at start; nothing here reaches the internet.\n"
  },
  "target": "docker",
  "driver": "compose",
  "hosts": [
    "linux",
    "macos",
    "windows"
  ],
  "tools": [
    {
      "name": "docker",
      "probe": [
        "docker",
        "info",
        "--format",
        "{{.ServerVersion}}"
      ]
    },
    {
      "name": "docker-compose",
      "probe": [
        "docker",
        "compose",
        "version",
        "--short"
      ],
      "min_version": "2.17.0"
    }
  ],
  "identity": {
    "compose": {
      "project": "${run.name}",
      "files": [
        "compose.yml",
        "${run.state_dir}/ports.yml"
      ],
      "pinned_ports_file": "${run.state_dir}/ports.yml"
    }
  },
  "params": [
    {
      "name": "ISOLOOM_PUBLISH_ADDRESS",
      "description": "The host address published ports listen on.",
      "default": "127.0.0.1",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_PUBLISH_ADDRESS",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "ISOLOOM_PUBLISH_FIXED",
      "description": "Set: each published port takes its `publish:` number instead of an ephemeral one.",
      "values": [
        "1"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_PUBLISH_FIXED",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "ISOLOOM_DERIVED",
      "description": "0: the checks derived from the spec (reachability, no internet) are skipped.",
      "default": "1",
      "values": [
        "0",
        "1"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_DERIVED",
          "steps": [
            "check-networks",
            "check-cache",
            "check-web"
          ]
        }
      ]
    }
  ],
  "secrets": [],
  "networks": [
    {
      "name": "app",
      "cidr": "10.60.0.0/24",
      "internet": false,
      "native": "${run.name}_app"
    }
  ],
  "machines": [
    {
      "name": "cache",
      "role": "target",
      "arch": "amd64",
      "addresses": {
        "app": "10.60.0.20"
      },
      "native": {
        "service": "cache"
      },
      "volumes": [
        {
          "name": "data",
          "path": "/data",
          "native": "${run.name}_cache-data"
        }
      ],
      "ports": [
        {
          "name": "redis",
          "port": 6379,
          "protocol": "tcp",
          "http": false
        }
      ]
    },
    {
      "name": "cache-routes",
      "role": "infra",
      "of": "cache",
      "addresses": {},
      "native": {
        "service": "cache-routes"
      }
    },
    {
      "name": "cache-init-1",
      "role": "job",
      "of": "cache",
      "addresses": {},
      "native": {
        "service": "cache-init-1"
      }
    },
    {
      "name": "web",
      "role": "target",
      "arch": "amd64",
      "addresses": {
        "app": "10.60.0.10"
      },
      "native": {
        "service": "web"
      },
      "ports": [
        {
          "port": 80,
          "protocol": "tcp",
          "http": true,
          "publish": {
            "mode": "ephemeral",
            "preferred": 8080,
            "address": "${params.ISOLOOM_PUBLISH_ADDRESS}"
          }
        }
      ]
    },
    {
      "name": "web-routes",
      "role": "infra",
      "of": "web",
      "addresses": {},
      "native": {
        "service": "web-routes"
      }
    },
    {
      "name": "isoloom-check",
      "role": "check",
      "addresses": {},
      "native": {
        "service": "isoloom-check"
      }
    },
    {
      "name": "isoloom-check-cache",
      "role": "check",
      "of": "cache",
      "addresses": {},
      "native": {
        "service": "isoloom-check-cache"
      }
    },
    {
      "name": "isoloom-check-web",
      "role": "check",
      "of": "web",
      "addresses": {},
      "native": {
        "service": "isoloom-check-web"
      }
    },
    {
      "name": "isoloom-probe-amd64",
      "role": "infra",
      "addresses": {},
      "native": {
        "service": "isoloom-probe-amd64"
      }
    }
  ],
  "lifecycle": {
    "up": [
      {
        "id": "pin-ports",
        "note": "Picking the lab's host ports…",
        "action": "compose.pin_ports"
      },
      {
        "id": "ports-free",
        "action": "compose.check_ports_free"
      },
      {
        "id": "stale-networks",
        "action": "compose.remove_stale_networks",
        "failure": "tolerate"
      },
      {
        "id": "up",
        "note": "Starting the lab's containers…",
        "argv": [
          "docker",
          "compose",
          "--project-name",
          "${run.name}",
          "--file",
          "compose.yml",
          "--file",
          "${run.state_dir}/ports.yml",
          "up",
          "--detach",
          "--build",
          "--pull",
          "missing",
          "--wait",
          "--wait-timeout",
          "600"
        ],
        "timeout_s": 1800
      }
    ],
    "down": [
      {
        "id": "down",
        "argv": [
          "docker",
          "compose",
          "--project-name",
          "${run.name}",
          "--file",
          "compose.yml",
          "--file",
          "${run.state_dir}/ports.yml",
          "--profile",
          "check",
          "down",
          "--volumes",
          "--remove-orphans"
        ],
        "timeout_s": 300,
        "when": "always"
      },
      {
        "id": "containers",
        "action": "compose.remove_containers",
        "when": "always",
        "failure": "tolerate"
      },
      {
        "id": "networks",
        "action": "compose.remove_networks",
        "when": "always",
        "failure": "tolerate"
      }
    ],
    "park": {
      "pause": [
        {
          "id": "stop",
          "argv": [
            "docker",
            "compose",
            "--project-name",
            "${run.name}",
            "--file",
            "compose.yml",
            "--file",
            "${run.state_dir}/ports.yml",
            "stop"
          ],
          "timeout_s": 300
        }
      ],
      "shutdown": [
        {
          "id": "stop",
          "argv": [
            "docker",
            "compose",
            "--project-name",
            "${run.name}",
            "--file",
            "compose.yml",
            "--file",
            "${run.state_dir}/ports.yml",
            "stop"
          ],
          "timeout_s": 300
        }
      ]
    },
    "resume": [
      {
        "id": "start",
        "argv": [
          "docker",
          "compose",
          "--project-name",
          "${run.name}",
          "--file",
          "compose.yml",
          "--file",
          "${run.state_dir}/ports.yml",
          "start"
        ],
        "timeout_s": 600
      }
    ],
    "status": {
      "id": "ps",
      "argv": [
        "docker",
        "compose",
        "--project-name",
        "${run.name}",
        "--file",
        "compose.yml",
        "--file",
        "${run.state_dir}/ports.yml",
        "ps",
        "--all",
        "--format",
        "json"
      ],
      "timeout_s": 25
    }
  },
  "ready": [
    {
      "kind": "step_ok",
      "step": "up",
      "means": "every long-running service is healthy (`--wait`: each port's probe, the route keepers, the machines' own healthchecks)"
    }
  ],
  "outputs": [
    {
      "name": "web_80",
      "description": "web's port 80.",
      "role": "entry",
      "sensitive": false,
      "format": "http://127.0.0.1:${value}/",
      "from": {
        "kind": "published_port",
        "machine": "web",
        "port": 80,
        "protocol": "tcp"
      }
    }
  ],
  "checks": {
    "protocol": "isoloom-check/1",
    "setup": [],
    "runners": [
      {
        "id": "isoloom-check",
        "from": "from the environment's networks",
        "checks": [
          {
            "name": "checks/cache-seeded.sh",
            "kind": "script",
            "wait_s": 0,
            "derived": false
          },
          {
            "name": "the page greets",
            "kind": "http",
            "wait_s": 30,
            "derived": false
          },
          {
            "name": "the cache answers a PING",
            "kind": "tcp",
            "wait_s": 30,
            "derived": false
          },
          {
            "name": "the page says hello",
            "kind": "http",
            "wait_s": 30,
            "derived": false
          },
          {
            "name": "the folder's address without its slash redirects",
            "kind": "http",
            "wait_s": 30,
            "derived": false
          },
          {
            "name": "the folder's page, past the redirect",
            "kind": "http",
            "wait_s": 30,
            "derived": false
          },
          {
            "name": "the static page refuses a POST",
            "kind": "http",
            "wait_s": 30,
            "derived": false
          }
        ],
        "step": {
          "id": "check-networks",
          "argv": [
            "docker",
            "compose",
            "--project-name",
            "${run.name}",
            "--file",
            "compose.yml",
            "--file",
            "${run.state_dir}/ports.yml",
            "--profile",
            "check",
            "run",
            "--rm",
            "--no-deps",
            "--env",
            "ISOLOOM_DERIVED",
            "isoloom-check"
          ],
          "timeout_s": 345
        },
        "on_timeout": [
          {
            "id": "rm-check-networks",
            "action": "compose.remove_containers",
            "with": {
              "one_off": "true",
              "service": "isoloom-check"
            },
            "failure": "tolerate"
          }
        ]
      },
      {
        "id": "isoloom-check-cache",
        "from": "from cache",
        "checks": [
          {
            "name": "web:80 from cache",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "no internet from cache",
            "kind": "http",
            "wait_s": 0,
            "derived": true
          }
        ],
        "step": {
          "id": "check-cache",
          "argv": [
            "docker",
            "compose",
            "--project-name",
            "${run.name}",
            "--file",
            "compose.yml",
            "--file",
            "${run.state_dir}/ports.yml",
            "--profile",
            "check",
            "run",
            "--rm",
            "--no-deps",
            "--env",
            "ISOLOOM_DERIVED",
            "isoloom-check-cache"
          ],
          "timeout_s": 120
        },
        "on_timeout": [
          {
            "id": "rm-check-cache",
            "action": "compose.remove_containers",
            "with": {
              "one_off": "true",
              "service": "isoloom-check-cache"
            },
            "failure": "tolerate"
          }
        ]
      },
      {
        "id": "exec-cache",
        "from": "inside cache",
        "checks": [
          {
            "name": "the cache holds the greeting, read inside it",
            "kind": "exec",
            "wait_s": 0,
            "derived": false
          }
        ],
        "step": {
          "id": "check-exec-cache",
          "argv": [
            "docker",
            "compose",
            "--project-name",
            "${run.name}",
            "--file",
            "compose.yml",
            "--file",
            "${run.state_dir}/ports.yml",
            "exec",
            "-T",
            "cache",
            "sh",
            "-s"
          ],
          "stdin": "checks/exec-cache.sh",
          "timeout_s": 75
        }
      },
      {
        "id": "isoloom-check-web",
        "from": "from web",
        "checks": [
          {
            "name": "cache:6379 from web",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "no internet from web",
            "kind": "http",
            "wait_s": 0,
            "derived": true
          }
        ],
        "step": {
          "id": "check-web",
          "argv": [
            "docker",
            "compose",
            "--project-name",
            "${run.name}",
            "--file",
            "compose.yml",
            "--file",
            "${run.state_dir}/ports.yml",
            "--profile",
            "check",
            "run",
            "--rm",
            "--no-deps",
            "--env",
            "ISOLOOM_DERIVED",
            "isoloom-check-web"
          ],
          "timeout_s": 120
        },
        "on_timeout": [
          {
            "id": "rm-check-web",
            "action": "compose.remove_containers",
            "with": {
              "one_off": "true",
              "service": "isoloom-check-web"
            },
            "failure": "tolerate"
          }
        ]
      }
    ],
    "teardown": []
  },
  "recovery": {
    "stale_markers": [
      "is already in use by container",
      "network with name",
      "has incorrect label"
    ],
    "steps": [
      {
        "id": "containers",
        "action": "compose.remove_containers",
        "when": "always",
        "failure": "tolerate"
      },
      {
        "id": "networks",
        "action": "compose.remove_networks",
        "when": "always",
        "failure": "tolerate"
      }
    ],
    "retries": 1
  }
}

