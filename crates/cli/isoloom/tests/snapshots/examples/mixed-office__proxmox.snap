_retry() { _end=$(( $(date +%s) + $1 )); shift; while ! "$@"; do [ "$(date +%s)" -lt "$_end" ] || return 1; sleep 2; done; }

echo '== checks/both-answer.sh'
if _retry 0 sh -c 'cd /opt/isoloom && sh checks/both-answer.sh'; then pass 'checks/both-answer.sh'; else fail 'checks/both-answer.sh' "checks/both-answer.sh exited non-zero"; fi

echo "isoloom-check: END $passed passed, $failed failed"
[ "$failed" -eq 0 ]

## .isoloom/proxmox/main.tf
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  terraform -chdir=.isoloom/proxmox init && terraform -chdir=.isoloom/proxmox apply -var proxmox_endpoint=https://<server>:8006/ -var proxmox_api_token=<user@realm!name=secret>
# Stop:   terraform -chdir=.isoloom/proxmox destroy (same variables)

terraform {
  required_version = ">= 1.6"
  backend "local" {}
  required_providers {
    proxmox = { source = "bpg/proxmox", version = "~> 0.115.0" }
    tls     = { source = "hashicorp/tls", version = "~> 4.4.1" }
    random  = { source = "hashicorp/random", version = "~> 3.9.1" }
  }
}

variable "proxmox_endpoint" {
  type        = string
  description = "https://<server>:8006/"
}

variable "proxmox_api_token" {
  type        = string
  default     = ""
  sensitive   = true
  description = "user@realm!name=secret; or use proxmox_username and proxmox_password"
}

variable "proxmox_username" {
  type    = string
  default = "root@pam"
}

variable "proxmox_password" {
  type      = string
  default   = ""
  sensitive = true
}

variable "proxmox_insecure" {
  type        = bool
  default     = true
  description = "Accept the server's self-signed certificate"
}

variable "proxmox_ssh_username" {
  type        = string
  default     = "root"
  description = "Uploading cloud-init snippets goes over SSH to the node"
}

variable "proxmox_ssh_private_key_file" {
  type    = string
  default = ""
}

variable "proxmox_ssh_address" {
  type        = string
  default     = ""
  description = "The node's SSH address, when the API reports one this machine can't reach"
}

variable "node" {
  type        = string
  description = "The Proxmox node the VMs go on (`pvesh get /nodes` lists them)"
  validation {
    condition     = var.node != ""
    error_message = "Set `node` to the Proxmox node the lab's VMs go on (`pvesh get /nodes` lists them)."
  }
}

variable "datastore" {
  type        = string
  default     = "local-lvm"
  description = "Where VM disks go"
}

variable "image_datastore" {
  type        = string
  default     = "local"
  description = "A datastore with 'iso' content, for cloud images"
}

variable "snippets_datastore" {
  type        = string
  default     = "local"
  description = "A datastore with 'snippets' content, for cloud-init"
}

variable "uplink_bridge" {
  type        = string
  default     = "vmbr0"
  description = "The bridge the router reaches the internet through"
}

variable "slot" {
  type        = number
  default     = 1
  description = "1 to 99, unique per environment on this server (SDN ids are short)"
}

variable "ssh_public_key" {
  type        = string
  default     = ""
  description = "Installed for the user `isoloom` on every VM"
}

variable "template_windows_server_2019" {
  type        = number
  description = "The VM id of a `windows-server-2019` template: cloudbase-init and the VirtIO drivers installed, UEFI on Q35, its disk on virtio0, sysprepped"
}

provider "proxmox" {
  endpoint  = var.proxmox_endpoint
  api_token = var.proxmox_api_token != "" ? var.proxmox_api_token : null
  username  = var.proxmox_api_token != "" ? null : var.proxmox_username
  password  = var.proxmox_api_token != "" ? null : var.proxmox_password
  insecure  = var.proxmox_insecure
  ssh {
    agent       = false
    username    = var.proxmox_ssh_username
    password    = var.proxmox_ssh_private_key_file != "" ? null : var.proxmox_password
    private_key = var.proxmox_ssh_private_key_file != "" ? file(var.proxmox_ssh_private_key_file) : null
    dynamic "node" {
      for_each = var.proxmox_ssh_address == "" ? [] : [1]
      content {
        name    = var.node
        address = var.proxmox_ssh_address
      }
    }
  }
}

# The project, written to /opt/isoloom in each machine that has steps; the `isoloom` user on every VM.
locals {
  zone          = "iso${var.slot}"
  root          = abspath("${path.module}/../..")
  project_files = [for f in local.project_paths : { path = "/opt/isoloom/${f}", encoding = "b64", content = filebase64("${local.root}/${f}") }]
  users         = var.ssh_public_key == "" ? [] : [{ name = "isoloom", sudo = "ALL=(ALL) NOPASSWD:ALL", shell = "/bin/bash", ssh_authorized_keys = [var.ssh_public_key] }]
}

# The environment's VMs and containers, together in a pool of their own.
resource "proxmox_virtual_environment_pool" "env" {
  pool_id = local.zone
  comment = "Isoloom: mixed-office"
}

# Applies the SDN deletions on destroy, once the zone and its VNets are gone: every SDN object depends on it, so it goes last.
resource "proxmox_sdn_applier" "finalizer" {}

# The environment's networks: an SDN simple zone, a VNet per network.
resource "proxmox_sdn_zone_simple" "env" {
  id         = local.zone
  nodes      = [var.node]
  depends_on = [proxmox_sdn_applier.finalizer]
}

# The Windows machines' administrator password (user isoloom), for WinRM.
resource "random_password" "windows" {
  length      = 24
  special     = false
  min_upper   = 2
  min_lower   = 2
  min_numeric = 2
}

# Network `office`: 192.168.58.0/24
resource "proxmox_sdn_vnet" "office" {
  id   = "i${var.slot}n0"
  zone = proxmox_sdn_zone_simple.env.id
}

# Applies the SDN objects once created, and again whenever one of them is replaced.
resource "proxmox_sdn_applier" "env" {
  lifecycle {
    replace_triggered_by = [proxmox_sdn_zone_simple.env, proxmox_sdn_vnet.office]
  }
  depends_on = [proxmox_sdn_vnet.office]
}

# The `debian-12` cloud image, per environment: a shared file would go with whichever environment is destroyed first.
resource "proxmox_download_file" "debian_12" {
  node_name           = var.node
  datastore_id        = var.image_datastore
  content_type        = "iso"
  url                 = "https://cloud.debian.org/images/cloud/bookworm/20261015-2632/debian-12-genericcloud-amd64-20261015-2632.qcow2"
  file_name           = "iso${var.slot}-debian-12.img"
  overwrite_unmanaged = true
  checksum            = "56c0bd55b6623f2739f377e983d2872e7b208d0cb9c3ba4e93d3f72929026da03637c598b3bd472b29998c31c8a4c17d8e6ae1c556852a8b83a66a09bf5c2b37"
  checksum_algorithm  = "sha512"
}

# Network `office`, for the machines' firewall rules.
resource "proxmox_virtual_environment_firewall_ipset" "office" {
  name    = "iso${var.slot}n0"
  comment = "mixed-office: network office"
  cidr {
    name = "192.168.58.0/24"
  }
}

# The router: forwards between networks with the reach rules, and to the internet.
resource "proxmox_virtual_environment_file" "router" {
  node_name    = var.node
  datastore_id = var.snippets_datastore
  content_type = "snippets"
  source_raw {
    file_name = "iso${var.slot}-router.yaml"
    data = format("#cloud-config\n%s", yamlencode({
      hostname = "isoloom-router"
      users    = local.users
      packages = ["nftables", "qemu-guest-agent"]
      write_files = [
        {
          path    = "/etc/systemd/network/10-wan.network"
          content = join("\n", ["[Match]", "MACAddress=${format("02:15:%02x:00:00:00", var.slot)}", "", "[Network]", "DHCP=yes"])
        },
        {
          path    = "/etc/nftables.conf"
          content = "flush ruleset\ntable inet isoloom {\n  chain forward {\n    type filter hook forward priority 0; policy drop;\n    ct state established,related accept\n    ip daddr 192.168.58.20 tcp dport 80 ct status dnat accept\n    ip saddr { 192.168.58.0/24 } ip daddr != { 192.168.58.0/24 } accept\n  }\n  chain prerouting {\n    type nat hook prerouting priority -100;\n    ip saddr != { 192.168.58.0/24 } tcp dport 8083 dnat ip to 192.168.58.20:80\n  }\n  chain postrouting {\n    type nat hook postrouting priority 100;\n    ip saddr { 192.168.58.0/24 } ip daddr != { 192.168.58.0/24 } masquerade\n  }\n}\n"
        },
        { path = "/etc/sysctl.d/90-isoloom.conf", content = "net.ipv4.ip_forward=1\n" },
        {
          path = "/etc/systemd/network/20-office.network"
          content = join("\n", [
            "[Match]",
            "MACAddress=${format("02:15:%02x:01:%02x:00", var.slot, 0)}",
            "",
            "[Network]",
            "Address=192.168.58.254/24",
            "ConfigureWithoutCarrier=yes"
          ])
        }
      ]
      runcmd = [
        "sysctl -p /etc/sysctl.d/90-isoloom.conf",
        "systemctl enable systemd-networkd",
        "systemctl restart systemd-networkd",
        "systemctl enable --now nftables",
        "nft -f /etc/nftables.conf",
        "systemctl enable --now qemu-guest-agent"
      ]
    }))
  }
}

# The guest agent reports its uplink address (DHCP), for the published ports.
resource "proxmox_virtual_environment_vm" "isoloom_router" {
  name      = "iso${var.slot}-router"
  node_name = var.node
  tags      = ["isoloom", "mixed-office"]
  pool_id   = proxmox_virtual_environment_pool.env.pool_id
  on_boot   = false
  agent {
    enabled = true
    timeout = "8m"
    wait_for_ip {
      ipv4 = true
    }
  }
  stop_on_destroy = true
  lifecycle {
    postcondition {
      condition     = length([for a in flatten(self.ipv4_addresses) : a if a != "127.0.0.1" && !contains(["192.168.58.254"], a)]) > 0
      error_message = "VM `router` got no IPv4 address on its uplink bridge `${var.uplink_bridge}` within 8m: the bridge has no DHCP, or no DNS or internet to install qemu-guest-agent, which reports the address. Give it an uplink bridge with DHCP and internet (`uplink_bridge`)."
    }
  }
  cpu {
    cores = 1
    type  = "host"
  }
  memory {
    dedicated = 512
  }
  disk {
    datastore_id = var.datastore
    file_id      = proxmox_download_file.debian_12.id
    interface    = "virtio0"
    size         = 8
  }
  network_device {
    bridge      = var.uplink_bridge
    mac_address = upper(format("02:15:%02x:00:00:00", var.slot))
  }
  network_device {
    bridge      = proxmox_sdn_vnet.office.id
    mac_address = upper(format("02:15:%02x:01:%02x:00", var.slot, 0))
  }
  initialization {
    datastore_id      = var.datastore
    user_data_file_id = proxmox_virtual_environment_file.router.id
    ip_config {
      ipv4 {
        address = "dhcp"
      }
    }
  }
  operating_system {
    type = "l26"
  }
  serial_device {}
  depends_on = [proxmox_sdn_applier.env]
}

# Machine `files01`: its set-up, run by cloudbase-init.
resource "proxmox_virtual_environment_file" "files01" {
  node_name    = var.node
  datastore_id = var.snippets_datastore
  content_type = "snippets"
  source_raw {
    file_name = "iso${var.slot}-files01.ps1"
    data      = "#ps1_sysnative\n# Isoloom: machine `files01`, set up by cloudbase-init at its first boot.\n$ErrorActionPreference = 'Stop'\nif (Test-Path 'C:\\ProgramData\\isoloom\\done') { exit 0 }\nNew-Item -ItemType Directory -Force C:\\ProgramData\\isoloom | Out-Null\n# The administrator the controller's playbooks run as, over WinRM.\n$password = ConvertTo-SecureString '${random_password.windows.result}' -AsPlainText -Force\nif (Get-LocalUser -Name isoloom -ErrorAction SilentlyContinue) { Set-LocalUser -Name isoloom -Password $password -PasswordNeverExpires $true } else { New-LocalUser -Name isoloom -Password $password -PasswordNeverExpires | Out-Null }\nif (-not (Get-LocalGroupMember -SID S-1-5-32-544 | Where-Object { $_.Name -like '*\\isoloom' })) { Add-LocalGroupMember -SID S-1-5-32-544 -Member isoloom }\n# Its name takes a restart: cloudbase-init runs this script again after it (exit code 1003).\nif ($env:COMPUTERNAME -ne 'FILES01') { Rename-Computer -NewName 'files01' -Force; exit 1003 }\n# The project, at C:\\isoloom.\nfunction Write-IsoloomFile($path, $b64) { $f = Join-Path 'C:\\isoloom' $path; New-Item -ItemType Directory -Force (Split-Path $f) | Out-Null; [IO.File]::WriteAllBytes($f, [Convert]::FromBase64String($b64)) }\n${join("\n", [for f in local.project_paths : "Write-IsoloomFile '${replace(f, "'", "''")}' '${filebase64("${local.root}/${f}")}'"])}\nNew-NetFirewallRule -DisplayName 'isoloom 445' -Direction Inbound -Protocol TCP -LocalPort 445 -Action Allow | Out-Null\n$h = \"$env:SystemRoot\\System32\\drivers\\etc\\hosts\"; foreach ($l in @('192.168.58.10 files01', '192.168.58.20 intranet')) { if (-not (Select-String -Path $h -SimpleMatch $l -Quiet)) { Add-Content -Path $h -Value $l } }\nSet-Location C:\\isoloom; & powershell -NoProfile -ExecutionPolicy Bypass -File 'provision/share.ps1'; if ($LASTEXITCODE) { exit $LASTEXITCODE }\nNew-Item -ItemType Directory -Force C:\\isoloom | Out-Null; Set-Content C:\\isoloom\\ready ready\n# WinRM for the controller, last: a machine that answers is set up.\nNew-ItemProperty -Path HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System -Name LocalAccountTokenFilterPolicy -Value 1 -PropertyType DWord -Force | Out-Null\nGet-NetConnectionProfile | Set-NetConnectionProfile -NetworkCategory Private -ErrorAction SilentlyContinue\nEnable-PSRemoting -Force -SkipNetworkProfileCheck | Out-Null\nSet-Item WSMan:\\localhost\\Service\\Auth\\Basic $true\nSet-Item WSMan:\\localhost\\Service\\AllowUnencrypted $true\nif (-not (Get-NetFirewallRule -DisplayName 'isoloom winrm' -ErrorAction SilentlyContinue)) { New-NetFirewallRule -DisplayName 'isoloom winrm' -Direction Inbound -Protocol TCP -LocalPort 5985 -Action Allow | Out-Null }\nNew-Item -ItemType File -Force 'C:\\ProgramData\\isoloom\\done' | Out-Null\n"
  }
}

resource "proxmox_virtual_environment_vm" "files01" {
  name      = "iso${var.slot}-files01"
  node_name = var.node
  tags      = ["isoloom", "mixed-office"]
  pool_id   = proxmox_virtual_environment_pool.env.pool_id
  on_boot   = false
  bios      = "ovmf"
  machine   = "q35"
  cpu {
    cores = 2
    type  = "host"
  }
  memory {
    dedicated = 3072
  }
  clone {
    vm_id = var.template_windows_server_2019
    full  = true
  }
  efi_disk {
    datastore_id = var.datastore
    type         = "4m"
  }
  tpm_state {
    datastore_id = var.datastore
    version      = "v2.0"
  }
  network_device {
    bridge   = proxmox_sdn_vnet.office.id
    firewall = true
  }
  initialization {
    datastore_id      = var.datastore
    type              = "configdrive2"
    user_data_file_id = proxmox_virtual_environment_file.files01.id
    dns {
      servers = ["1.1.1.1"]
    }
    ip_config {
      ipv4 {
        address = "192.168.58.10/24"
        gateway = "192.168.58.254"
      }
    }
  }
  operating_system {
    type = "win10"
  }
  depends_on = [proxmox_virtual_environment_vm.isoloom_router]
}

# Machine `files01`'s firewall: what reaches it, outside the guest.
resource "proxmox_virtual_environment_firewall_options" "files01" {
  node_name     = var.node
  vm_id         = proxmox_virtual_environment_vm.files01.vm_id
  enabled       = true
  input_policy  = "DROP"
  output_policy = "ACCEPT"
}

resource "proxmox_virtual_environment_firewall_rules" "files01" {
  node_name = var.node
  vm_id     = proxmox_virtual_environment_vm.files01.vm_id
  rule {
    type    = "in"
    action  = "ACCEPT"
    comment = "network office"
    source  = "+${proxmox_virtual_environment_firewall_ipset.office.name}"
  }
}

# Machine `intranet`.
resource "proxmox_virtual_environment_file" "intranet" {
  node_name    = var.node
  datastore_id = var.snippets_datastore
  content_type = "snippets"
  source_raw {
    file_name = "iso${var.slot}-intranet.yaml"
    data = format("#cloud-config\n%s", yamlencode({
      hostname    = "intranet"
      users       = local.users
      packages    = ["nftables", "curl", "netcat-openbsd"]
      write_files = local.project_files
      runcmd = [
        "mkdir -p /var/lib/isoloom",
        "echo 'running: hosts file' > /var/lib/isoloom/ready; sh -c 'printf '\\''%s\\n'\\'' '\\''192.168.58.20 intranet'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done' || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }",
        "echo 'running: provision/intranet.sh' > /var/lib/isoloom/ready; sh -c 'cd /opt/isoloom && sh -c '\\''sh provision/intranet.sh'\\''' || { echo 'failed: provision/intranet.sh' > /var/lib/isoloom/ready; exit 1; }",
        "echo 'running: health check' > /var/lib/isoloom/ready; sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready' || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }"
      ]
    }))
  }
}

resource "proxmox_virtual_environment_vm" "intranet" {
  name      = "iso${var.slot}-intranet"
  node_name = var.node
  tags      = ["isoloom", "mixed-office"]
  pool_id   = proxmox_virtual_environment_pool.env.pool_id
  on_boot   = false
  cpu {
    cores = 1
    type  = "host"
  }
  memory {
    dedicated = 1024
  }
  disk {
    datastore_id = var.datastore
    file_id      = proxmox_download_file.debian_12.id
    interface    = "virtio0"
    size         = 20
  }
  network_device {
    bridge   = proxmox_sdn_vnet.office.id
    firewall = true
  }
  initialization {
    datastore_id      = var.datastore
    user_data_file_id = proxmox_virtual_environment_file.intranet.id
    dns {
      servers = ["1.1.1.1"]
    }
    ip_config {
      ipv4 {
        address = "192.168.58.20/24"
        gateway = "192.168.58.254"
      }
    }
  }
  operating_system {
    type = "l26"
  }
  serial_device {}
  depends_on = [proxmox_virtual_environment_vm.isoloom_router]
}

# Machine `intranet`'s firewall: what reaches it, outside the guest.
resource "proxmox_virtual_environment_firewall_options" "intranet" {
  node_name     = var.node
  vm_id         = proxmox_virtual_environment_vm.intranet.vm_id
  enabled       = true
  input_policy  = "DROP"
  output_policy = "ACCEPT"
}

resource "proxmox_virtual_environment_firewall_rules" "intranet" {
  node_name = var.node
  vm_id     = proxmox_virtual_environment_vm.intranet.vm_id
  rule {
    type    = "in"
    action  = "ACCEPT"
    comment = "network office"
    source  = "+${proxmox_virtual_environment_firewall_ipset.office.name}"
  }
  rule {
    type    = "in"
    action  = "ACCEPT"
    comment = "published"
    proto   = "tcp"
    dport   = "80"
  }
}

locals {
  router_address = try([for a in flatten(proxmox_virtual_environment_vm.isoloom_router.ipv4_addresses) : a if a != "127.0.0.1" && !contains(["192.168.58.254"], a)][0], "")
}

# The router's uplink address: the lab's way in.
output "ip" {
  value = local.router_address
}

# Each Linux machine's set-up progress (`isoloom-ready/1`: `running: <step>`, `failed: <step>`, `ready`).
output "ready_file" {
  value = "/var/lib/isoloom/ready"
}

# Published services, from the router's uplink address.
output "published" {
  value = { "intranet/web" = "${local.router_address}:8083" }
}

# The machines, through the router: ssh -J isoloom@<ip> isoloom@<machine>.
output "machines" {
  value = { files01 = "192.168.58.10", intranet = "192.168.58.20" }
}

output "ssh_user" {
  value = "isoloom"
}

# The checks: each runner piped to its machine (ssh -J isoloom@<ip> isoloom@<host> sh -s < <script>).
output "checks" {
  value = [
    {
      position = "networks"
      machine  = "files01"
      host     = "192.168.58.10"
      user     = "isoloom"
      script   = ".isoloom/proxmox/checks/networks.sh"
    },
    {
      position = "intranet"
      machine  = "intranet"
      host     = "192.168.58.20"
      user     = "isoloom"
      script   = ".isoloom/proxmox/checks/intranet.sh"
    }
  ]
}

# The project's files the machines don't get: version control and the tools' state, and what
# .isoloomignore at the project's root lists (gitignore-style: one pattern per line, `#` comments,
# `!` brings a path back, a trailing `/` matches folders only, a `/` at the start or in the middle
# anchors the pattern at the root; `*`, `?`, `[abc]`, `**`; the last pattern matching a path, or
# a folder it is in, decides). Read as regular expressions, as the Vagrantfiles do.
locals {
  project_ignore_lines = [for l in split("\n", replace(try(file("${local.root}/.isoloomignore"), ""), "\r", "")) : trimspace(l)]
  project_ignore_pats  = [for l in local.project_ignore_lines : { keep = startswith(l, "!"), pat = trimprefix(l, "!") } if l != "" && !startswith(l, "#")]
  project_ignore_globs = [for r in local.project_ignore_pats : merge(r, { glob = trimsuffix(trimsuffix(trimsuffix(r.pat, "/"), "/**"), "/") })]
  project_ignore = [for r in local.project_ignore_globs : {
    keep = r.keep
    re = format(r.glob == r.pat ? "^%s(/|$)" : "^%s/", replace(replace(replace(replace(replace(replace(replace(replace(
      length(split("/", r.glob)) > 1 ? trimprefix(r.glob, "/") : "**/${r.glob}",
    "/[.+^$(){}|\\\\]/", "\\$0"), "[!", "[^"), "**/", "\u0001"), "**", "\u0002"), "*", "[^/]*"), "?", "[^/]"), "\u0001", "(.*/)?"), "\u0002", ".*"))
  } if r.glob != ""]
  # Each file: whether it goes (the last matching pattern decides; none: it goes).
  project_keep  = { for f in fileset(local.root, "**") : f => reverse(concat([true], [for r in local.project_ignore : r.keep if length(regexall(r.re, f)) > 0]))[0] }
  project_paths = [for f, keep in local.project_keep : f if keep && length(regexall("^\\.isoloom|(^|/)\\.(git|vagrant|terraform)/", f)) == 0]
}

## .isoloom/proxmox/run.json
{
  "$schema": "https://www.isoloom.com/schema/run-manifest/v0.json",
  "manifest_version": 0,
  "generator": {
    "name": "isoloom",
    "version": "1.0.1"
  },
  "environment": {
    "name": "mixed-office",
    "instance": null,
    "message": null
  },
  "target": "proxmox",
  "driver": "terraform",
  "hosts": [
    "linux",
    "macos",
    "windows"
  ],
  "tools": [
    {
      "name": "terraform",
      "probe": [
        "terraform",
        "version"
      ],
      "min_version": "1.6.0",
      "container": "hashicorp/terraform:1.9.8@sha256:18f9986038bbaf02cf49db9c09261c778161c51dcc7fb7e355ae8938459428cd",
      "container_hosts": [
        "macos"
      ]
    },
    {
      "name": "ssh",
      "probe": [
        "ssh",
        "-V"
      ]
    }
  ],
  "identity": {
    "terraform": {
      "module": ".",
      "state": "runner"
    }
  },
  "params": [
    {
      "name": "proxmox_endpoint",
      "description": "https://<server>:8006/.",
      "required": true,
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_endpoint"
        }
      ]
    },
    {
      "name": "proxmox_username",
      "description": "The module's `proxmox_username`.",
      "default": "root@pam",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_username"
        }
      ]
    },
    {
      "name": "proxmox_insecure",
      "description": "Accept the server's self-signed certificate.",
      "default": "true",
      "values": [
        "true",
        "false"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_insecure"
        }
      ]
    },
    {
      "name": "proxmox_ssh_username",
      "description": "Uploading cloud-init snippets goes over SSH to the node.",
      "default": "root",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_ssh_username"
        }
      ]
    },
    {
      "name": "proxmox_ssh_address",
      "description": "The node's SSH address, when the API reports one this machine can't reach.",
      "default": "",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_ssh_address"
        }
      ]
    },
    {
      "name": "node",
      "description": "The Proxmox node the VMs go on (`pvesh get /nodes` lists them).",
      "required": true,
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "node"
        }
      ]
    },
    {
      "name": "datastore",
      "description": "Where VM disks go.",
      "default": "local-lvm",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "datastore"
        }
      ]
    },
    {
      "name": "image_datastore",
      "description": "A datastore with 'iso' content, for cloud images.",
      "default": "local",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "image_datastore"
        }
      ]
    },
    {
      "name": "snippets_datastore",
      "description": "A datastore with 'snippets' content, for cloud-init.",
      "default": "local",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "snippets_datastore"
        }
      ]
    },
    {
      "name": "uplink_bridge",
      "description": "The bridge the router reaches the internet through.",
      "default": "vmbr0",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "uplink_bridge"
        }
      ]
    },
    {
      "name": "template_windows_server_2019",
      "description": "The VM id of a `windows-server-2019` template: cloudbase-init and the VirtIO drivers installed, UEFI on Q35, its disk on virtio0, sysprepped.",
      "required": true,
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "template_windows_server_2019"
        }
      ]
    },
    {
      "name": "ISOLOOM_DERIVED",
      "description": "0: the checks derived from the spec (reachability, no internet) are skipped.",
      "default": "1",
      "values": [
        "0",
        "1"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_DERIVED",
          "steps": [
            "check-networks",
            "check-intranet"
          ]
        }
      ]
    }
  ],
  "secrets": [
    {
      "name": "proxmox_api_token",
      "kind": "connection",
      "required": false,
      "sensitive": true,
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_api_token"
        }
      ]
    },
    {
      "name": "proxmox_password",
      "kind": "connection",
      "required": false,
      "sensitive": true,
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_password"
        }
      ]
    }
  ],
  "networks": [
    {
      "name": "office",
      "cidr": "192.168.58.0/24",
      "internet": true,
      "native": "i${run.slot}n0"
    }
  ],
  "machines": [
    {
      "name": "files01",
      "role": "target",
      "os": "windows-server-2019",
      "windows": true,
      "arch": "amd64",
      "addresses": {
        "office": "192.168.58.10"
      },
      "ports": [
        {
          "name": "smb",
          "port": 445,
          "protocol": "tcp",
          "http": false
        }
      ]
    },
    {
      "name": "intranet",
      "role": "target",
      "os": "debian-12",
      "arch": "amd64",
      "addresses": {
        "office": "192.168.58.20"
      },
      "ports": [
        {
          "name": "web",
          "port": 80,
          "protocol": "tcp",
          "http": true,
          "publish": {
            "mode": "fixed",
            "preferred": 8083,
            "address": "${outputs.ip}"
          }
        }
      ]
    },
    {
      "name": "isoloom-router",
      "role": "infra",
      "addresses": {
        "office": "192.168.58.254"
      }
    }
  ],
  "lifecycle": {
    "up": [
      {
        "id": "clear-lock",
        "action": "terraform.clear_lock"
      },
      {
        "id": "init",
        "note": "Preparing Terraform and its providers…",
        "argv": [
          "terraform",
          "init",
          "-input=false",
          "-no-color",
          "-backend-config=path=${run.state_dir}/terraform.tfstate"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_proxmox_ssh_private_key_file": "${run.ssh_key}",
          "TF_VAR_slot": "${run.slot}",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 600
      },
      {
        "id": "apply",
        "note": "Creating the lab's VMs on the server…",
        "argv": [
          "terraform",
          "apply",
          "-auto-approve",
          "-input=false",
          "-no-color"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_proxmox_ssh_private_key_file": "${run.ssh_key}",
          "TF_VAR_slot": "${run.slot}",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 3600
      }
    ],
    "down": [
      {
        "id": "clear-lock",
        "action": "terraform.clear_lock"
      },
      {
        "id": "init",
        "note": "Preparing Terraform and its providers…",
        "argv": [
          "terraform",
          "init",
          "-input=false",
          "-no-color",
          "-backend-config=path=${run.state_dir}/terraform.tfstate"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_proxmox_ssh_private_key_file": "${run.ssh_key}",
          "TF_VAR_slot": "${run.slot}",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 600
      },
      {
        "id": "destroy",
        "note": "Removing the lab from the server…",
        "argv": [
          "terraform",
          "destroy",
          "-auto-approve",
          "-input=false",
          "-no-color",
          "-refresh=false"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_proxmox_ssh_private_key_file": "${run.ssh_key}",
          "TF_VAR_slot": "${run.slot}",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 1800
      }
    ],
    "status": {
      "id": "state",
      "action": "terraform.read_state"
    }
  },
  "ready": [
    {
      "kind": "step_ok",
      "step": "apply",
      "means": "the VMs exist and booted; each sets itself up from its cloud-init"
    },
    {
      "kind": "ready_file",
      "host": "192.168.58.20",
      "user": "isoloom",
      "path": "${outputs.ready_file}",
      "log": "/var/log/cloud-init-output.log",
      "grammar": "isoloom-ready/1",
      "via": "isoloom@${outputs.ip}",
      "timeout_s": 2400,
      "unreachable_timeout_s": 600,
      "interval_s": 10
    }
  ],
  "outputs": [
    {
      "name": "ip",
      "description": "The router's uplink address: the published ports answer there, and SSH reaches the machines through it.",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ip"
      }
    },
    {
      "name": "ssh_user",
      "description": "The user every Linux VM and the router let in with the runner's key.",
      "role": "info",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ssh_user"
      }
    },
    {
      "name": "ready_file",
      "description": "Where each Linux machine's set-up says how far it got (isoloom-ready/1).",
      "role": "info",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ready_file"
      }
    },
    {
      "name": "intranet_web",
      "description": "intranet's web (port 80).",
      "role": "entry",
      "sensitive": false,
      "format": "http://${outputs.ip}:${value}/",
      "from": {
        "kind": "published_port",
        "machine": "intranet",
        "port": "web"
      }
    }
  ],
  "checks": {
    "protocol": "isoloom-check/1",
    "setup": [],
    "runners": [
      {
