## .isoloom/docker/appliances/csr/base.cfg
hostname csr
!
no ip domain lookup
ip domain name lab
!
username admin privilege 15 secret admin
!
interface GigabitEthernet2
 description site-b
 ip address 10.92.2.1 255.255.255.0
 no shutdown
!
interface GigabitEthernet3
 description wan
 ip address 10.92.0.3 255.255.255.248
 no shutdown
!
ip ssh version 2
!
line vty 0 4
 login local
 transport input ssh telnet
!

## .isoloom/docker/appliances/vios/base.cfg
hostname vios
!
no ip domain lookup
ip domain name lab
!
username admin privilege 15 secret admin
!
interface GigabitEthernet0/1
 description site-a
 ip address 10.92.1.1 255.255.255.0
 no shutdown
!
interface GigabitEthernet0/2
 description wan
 ip address 10.92.0.2 255.255.255.248
 no shutdown
!
ip ssh version 2
!
line vty 0 4
 login local
 transport input ssh telnet
!

## .isoloom/docker/checks/host-a.sh
#!/bin/sh
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# The environment's checks, from host-a. `isoloom test` runs it and reads the PASS/FAIL lines.
passed=0; failed=0
pass() { passed=$((passed+1)); echo "isoloom-check: PASS $1"; }
fail() { failed=$((failed+1)); echo "isoloom-check: FAIL $1: $2"; }
# _http URL [follow] -> the status code, 000 when nothing answers (curl, else wget, else bash):
# the first answer's, or with `follow` the last one's after at most 5 redirects (bash: the first).
_http() {
  if command -v curl >/dev/null 2>&1; then
    if [ -n "$2" ]; then set -- "$1" -L --max-redirs 5; else set -- "$1"; fi
    c=$(curl -sk -o /dev/null -m 5 -w '%{http_code}' "$@" 2>/dev/null)
  elif command -v wget >/dev/null 2>&1; then
    # wget follows redirects whatever it's told (busybox's can't be told): -S prints each answer.
    if [ -n "$2" ]; then _n=6; else _n=1; fi
    c=$(wget -q -S -O /dev/null -T 5 --no-check-certificate "$1" 2>&1 | sed -n 's/^ *HTTP\/[0-9.]* \([0-9][0-9][0-9]\).*/\1/p' | head -n $_n | tail -n 1)
  else
    u=${1#*://}; hp=${u%%/*}; p=/${u#*/}; [ "$u" = "$hp" ] && p=/
    h=${hp%%:*}; port=${hp#*:}; [ "$hp" = "$h" ] && port=80
    # shellcheck disable=SC2016 # the inner bash expands $H, $P and $U, for its /dev/tcp
    c=$(H=$h P=$port U=$p timeout 5 bash -c 'exec 3<>/dev/tcp/$H/$P && printf "GET %s HTTP/1.0\r\nHost: %s\r\n\r\n" "$U" "$H" >&3 && read -r l <&3 && echo "$l"' 2>/dev/null | sed -n 's/^HTTP\/[0-9.]* \([0-9][0-9][0-9]\).*/\1/p')
  fi
  echo "${c:-000}"
}
_http_is() { [ "$(_http "$1" "$3")" = "$2" ]; }
# _req STATUS|any TEXT CURL-ARGS... -> 0 when the request gets that status (any answer for `any`)
# and its body contains TEXT (if any); $out says why not. Needs curl.
_req() {
  want=$1; text=$2; shift 2
  command -v curl >/dev/null 2>&1 || { out="curl is needed for this check"; return 1; }
  b=$(mktemp); c=$(curl -sk -m 10 -o "$b" -w '%{http_code}' "$@" 2>/dev/null); c=${c:-000}; r=0
  if [ "$want" = any ]; then [ "$c" != 000 ] || r=1; else [ "$c" = "$want" ] || r=1; fi
  if [ $r = 1 ]; then out="expected HTTP $want, got $c"
  elif [ -n "$text" ] && ! grep -qF -- "$text" "$b"; then r=1; out="HTTP $c, but the response doesn't contain the expected text"
  fi
  rm -f "$b"; return $r
}
_http_any() { [ "$(_http "$1" "$2")" != 000 ]; }
# _tcp HOST PORT -> 0 when it connects (nc, else bash).
_tcp() {
  if command -v nc >/dev/null 2>&1; then nc -z -w 5 "$1" "$2" >/dev/null 2>&1
  else
    # shellcheck disable=SC2016 # the inner bash expands $H and $P, for its /dev/tcp
    H=$1 P=$2 timeout 5 bash -c 'exec 3<>/dev/tcp/$H/$P' >/dev/null 2>&1
  fi
}
# _tcp_read HOST PORT LINE TEXT -> 0 when the bytes read within 5s of connecting (after writing
# LINE and a newline, if any) contain TEXT; $out says why not (nc, else bash). Stdin stays open
# while reading (some nc quit at its end), and nc is stopped after 5s whatever its flavor.
_tcp_read() {
  f=$(mktemp); i=0; r=1
  if command -v nc >/dev/null 2>&1; then
    { [ -z "$3" ] || printf '%s\n' "$3"; j=0; while [ ! -e "$f.end" ] && [ $j -lt 6 ]; do sleep 1; j=$((j+1)); done; } | nc "$1" "$2" >"$f" 2>/dev/null &
  else
    # shellcheck disable=SC2016 # the inner bash expands $H, $P and $L, for its /dev/tcp
    H=$1 P=$2 L=$3 timeout 6 bash -c 'exec 3<>/dev/tcp/$H/$P || exit 1; [ -z "$L" ] || printf "%s\n" "$L" >&3; cat <&3' >"$f" 2>/dev/null &
  fi
  p=$!
  while :; do
    if grep -qF -- "$4" "$f"; then r=0; break; fi
    if [ $i -ge 5 ] || ! kill -0 $p 2>/dev/null; then break; fi
    sleep 1; i=$((i+1))
  done
  [ $r = 0 ] || ! grep -qF -- "$4" "$f" || r=0
  touch "$f.end"; kill $p 2>/dev/null
  if [ $r = 1 ]; then
    if [ -s "$f" ]; then out="$1:$2 answered \"$(head -c 100 "$f" | tr -d '\000\r' | tr '\n\t' '  ')\", without the expected text"
    elif [ $i -lt 5 ]; then out="$1:$2 refused the connection or closed it without a word"
    else out="nothing read from $1:$2 within 5s"; fi
  fi
  rm -f "$f" "$f.end"; return $r
}
# _exec COMMAND TEXT -> 0 when the command succeeds and its output contains TEXT (if any).
_exec() { out=$(sh -c "$1" 2>&1) && { [ -z "$2" ] || printf '%s\n' "$out" | grep -qF -- "$2"; }; }
# _retry SECONDS COMMAND... -> keeps trying every 2s until it passes or the time is up.
_retry() { _end=$(( $(date +%s) + $1 )); shift; while ! "$@"; do [ "$(date +%s)" -lt "$_end" ] || return 1; sleep 2; done; }

if _retry 900 _http_is 'http://host-b/' 200; then pass 'site A reaches site B through both routers'; else fail 'site A reaches site B through both routers' "expected HTTP 200 from http://host-b/, got $(_http 'http://host-b/')"; fi

if [ "${ISOLOOM_DERIVED:-1}" != 0 ]; then
if _tcp '10.92.2.10' 80; then fail 'host-b:80 blocked from host-a' "10.92.2.10:80 answered; it should be blocked"; else pass 'host-b:80 blocked from host-a'; fi
fi

echo "isoloom-check: END $passed passed, $failed failed"
[ "$failed" -eq 0 ]

## .isoloom/docker/compose.yml
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  docker compose -f .isoloom/docker/compose.yml up -d --wait
# Checks: isoloom test docker (or: docker compose -f .isoloom/docker/compose.yml --profile check run --rm isoloom-check, and isoloom-check-<machine>)
# Stop:   docker compose -f .isoloom/docker/compose.yml down -v

name: cisco-qemu
services:
  vios:
    image: vrnetlab/cisco_vios:15.9.3M6
    platform: linux/amd64
    privileged: true
    sysctls:
      net.ipv4.ip_forward: '1'
    entrypoint:
    - /bin/sh
    - -c
    - cat /config/base.cfg /config/own.cfg > /config/startup-config.cfg 2>/dev/null; echo end >> /config/startup-config.cfg; exec uv run /launch.py --username admin --password admin --hostname vios --connection-mode tc --trace
    hostname: vios
    networks:
      isoloom-mgmt:
        ipv4_address: 10.255.255.10
        interface_name: eth0
        priority: 1000
      site-a:
        ipv4_address: 10.92.1.1
        interface_name: eth1
        priority: 999
      wan:
        ipv4_address: 10.92.0.2
        interface_name: eth2
        priority: 998
    cap_add:
    - NET_ADMIN
    extra_hosts:
    - host-b:10.92.2.10
    environment:
      CLAB_INTFS: '2'
      CONNECTION_MODE: tc
      CLAB_MGMT_PASSTHROUGH: 'true'
    volumes:
    - ./appliances/vios/base.cfg:/config/base.cfg:ro
    - ../../configs/vios.cfg:/config/own.cfg:ro
    labels:
      isoloom.managed: 'true'
      isoloom.environment: cisco-qemu
    restart: unless-stopped
  vios-routes:
    image: alpine:3.20
    init: true
    entrypoint:
    - /bin/sh
    - -c
    - ip addr flush dev eth1 && ip addr flush dev eth2 && while ip -o -4 addr show | grep -qv ' lo '; do sleep 2; done; exit 1
    network_mode: service:vios
    cap_add:
    - NET_ADMIN
    healthcheck:
      test:
      - CMD-SHELL
      - '! ip -o -4 addr show | grep -q '' eth[1-9]'''
      interval: 2s
      timeout: 2s
      retries: 30
    depends_on:
      vios:
        condition: service_started
    labels:
      isoloom.managed: 'true'
      isoloom.environment: cisco-qemu
    restart: unless-stopped
  csr:
    image: vrnetlab/cisco_csr1000v:17.03.08
    platform: linux/amd64
    privileged: true
    sysctls:
      net.ipv4.ip_forward: '1'
    entrypoint:
    - /bin/sh
    - -c
    - cat /config/base.cfg /config/own.cfg > /config/startup-config.cfg 2>/dev/null; echo end >> /config/startup-config.cfg; exec uv run /launch.py --username admin --password admin --hostname csr --connection-mode tc --trace
    hostname: csr
    networks:
      isoloom-mgmt:
        ipv4_address: 10.255.255.11
        interface_name: eth0
        priority: 1000
      site-b:
        ipv4_address: 10.92.2.1
        interface_name: eth1
        priority: 999
      wan:
        ipv4_address: 10.92.0.3
        interface_name: eth2
        priority: 998
    cap_add:
    - NET_ADMIN
    extra_hosts:
    - host-a:10.92.1.10
    environment:
      CLAB_INTFS: '2'
      CONNECTION_MODE: tc
    volumes:
    - ./appliances/csr/base.cfg:/config/base.cfg:ro
    - ../../configs/csr.cfg:/config/own.cfg:ro
    labels:
      isoloom.managed: 'true'
      isoloom.environment: cisco-qemu
    restart: unless-stopped
  csr-routes:
    image: alpine:3.20
    init: true
    entrypoint:
    - /bin/sh
    - -c
    - ip addr flush dev eth1 && ip addr flush dev eth2 && while ip -o -4 addr show | grep -qv ' lo '; do sleep 2; done; exit 1
    network_mode: service:csr
    cap_add:
    - NET_ADMIN
    healthcheck:
      test:
      - CMD-SHELL
      - '! ip -o -4 addr show | grep -q '' eth[1-9]'''
      interval: 2s
      timeout: 2s
      retries: 30
    depends_on:
      csr:
        condition: service_started
    labels:
      isoloom.managed: 'true'
      isoloom.environment: cisco-qemu
    restart: unless-stopped
  host-a:
    image: alpine:3.19@sha256:6baf43584bcb78f2e5847d1de515f23499913ac9f12bdf834811a3145eb11ca1
    platform: linux/amd64
    init: true
    entrypoint:
    - sleep
    - infinity
    hostname: host-a
    networks:
      site-a:
        ipv4_address: 10.92.1.10
    extra_hosts:
    - csr:10.92.2.1
    - host-b:10.92.2.10
    labels:
      isoloom.managed: 'true'
      isoloom.environment: cisco-qemu
    restart: unless-stopped
  host-a-routes:
    image: alpine:3.20
    init: true
    entrypoint:
    - /bin/sh
    - -c
    - ip route replace default via 10.92.1.1 && while ip -o -4 addr show | grep -qv ' lo '; do sleep 2; done; exit 1
    network_mode: service:host-a
    cap_add:
    - NET_ADMIN
    healthcheck:
      test:
      - CMD-SHELL
      - ip route | grep -q '^default via 10.92.1.1 '
      interval: 2s
      timeout: 2s
      retries: 30
    depends_on:
      host-a:
        condition: service_started
      vios:
        condition: service_started
    labels:
      isoloom.managed: 'true'
      isoloom.environment: cisco-qemu
    restart: unless-stopped
  host-b:
    image: nginx:1.27-alpine
    platform: linux/amd64
    hostname: host-b
    networks:
      site-b:
        ipv4_address: 10.92.2.10
    extra_hosts:
    - vios:10.92.1.1
    - host-a:10.92.1.10
    volumes:
    - isoloom-probe-amd64:/.isoloom-probe:ro
    healthcheck:
      test:
      - CMD
      - /.isoloom-probe/busybox
      - sh
      - -c
      - /.isoloom-probe/busybox nc -z -w 2 127.0.0.1 80
      interval: 5s
      timeout: 3s
      retries: 60
      start_period: 10s
    depends_on:
      isoloom-probe-amd64:
        condition: service_completed_successfully
    labels:
      isoloom.port.web: http:80
      isoloom.managed: 'true'
      isoloom.environment: cisco-qemu
    restart: unless-stopped
  host-b-routes:
    image: alpine:3.20
    init: true
    entrypoint:
    - /bin/sh
    - -c
    - ip route replace default via 10.92.2.1 && while ip -o -4 addr show | grep -qv ' lo '; do sleep 2; done; exit 1
    network_mode: service:host-b
    cap_add:
    - NET_ADMIN
    healthcheck:
      test:
      - CMD-SHELL
      - ip route | grep -q '^default via 10.92.2.1 '
      interval: 2s
      timeout: 2s
      retries: 30
    depends_on:
      host-b:
        condition: service_started
      csr:
        condition: service_started
    labels:
      isoloom.managed: 'true'
      isoloom.environment: cisco-qemu
    restart: unless-stopped
  isoloom-check-host-a:
    image: curlimages/curl:8.11.1
    profiles:
    - check
    entrypoint:
    - /bin/sh
    - /isoloom/run.sh
    network_mode: service:host-a
    volumes:
    - ./checks/host-a.sh:/isoloom/run.sh:ro
    depends_on:
      vios-routes:
        condition: service_healthy
      csr-routes:
        condition: service_healthy
      host-a-routes:
        condition: service_healthy
      host-b:
        condition: service_healthy
      host-b-routes:
        condition: service_healthy
      host-a:
        condition: service_started
    labels:
      isoloom.managed: 'true'
      isoloom.environment: cisco-qemu
  isoloom-probe-amd64:
    image: busybox:1.37.0-musl
    platform: linux/amd64
    entrypoint:
    - /bin/cp
    - /bin/busybox
    - /probe/busybox
    network_mode: none
    volumes:
    - isoloom-probe-amd64:/probe
    labels:
      isoloom.managed: 'true'
      isoloom.environment: cisco-qemu
    restart: no
networks:
  site-a:
    ipam:
      config:
      - subnet: 10.92.1.0/24
        gateway: 10.92.1.254
    labels:
      isoloom.managed: 'true'
      isoloom.environment: cisco-qemu
  site-b:
    ipam:
      config:
      - subnet: 10.92.2.0/24
        gateway: 10.92.2.254
    labels:
      isoloom.managed: 'true'
      isoloom.environment: cisco-qemu
  wan:
    ipam:
      config:
      - subnet: 10.92.0.0/29
        gateway: 10.92.0.1
    labels:
      isoloom.managed: 'true'
      isoloom.environment: cisco-qemu
  isoloom-mgmt:
    ipam:
      config:
      - subnet: 10.255.255.0/24
    labels:
      isoloom.managed: 'true'
      isoloom.environment: cisco-qemu
volumes:
  isoloom-probe-amd64:
    labels:
      isoloom.managed: 'true'
      isoloom.environment: cisco-qemu

## .isoloom/docker/run.json
{
  "$schema": "https://www.isoloom.com/schema/run-manifest/v0.json",
  "manifest_version": 0,
  "generator": {
    "name": "isoloom",
    "version": "0.10.1"
  },
  "lab": {
    "name": "cisco-qemu",
    "instance": null,
    "message": null
  },
  "target": "docker",
  "driver": "compose",
  "hosts": [
    "linux",
    "macos",
    "windows"
  ],
  "tools": [
    {
      "name": "docker",
      "probe": [
        "docker",
        "info",
        "--format",
        "{{.ServerVersion}}"
      ]
    },
    {
      "name": "docker-compose",
      "probe": [
        "docker",
        "compose",
        "version",
        "--short"
      ],
      "min_version": "2.17.0"
    }
  ],
  "identity": {
    "compose": {
      "project": "${run.name}",
      "files": [
        "compose.yml",
        "${run.state_dir}/ports.yml"
      ],
      "pinned_ports_file": "${run.state_dir}/ports.yml"
    }
  },
  "params": [
    {
      "name": "ISOLOOM_DERIVED",
      "description": "0: the checks derived from the spec (reachability, no internet) are skipped.",
      "default": "1",
      "values": [
        "0",
        "1"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_DERIVED",
          "steps": [
            "check-host-a"
          ]
        }
      ]
    }
  ],
  "secrets": [],
  "networks": [
    {
      "name": "site-a",
      "cidr": "10.92.1.0/24",
      "internet": true,
      "native": "${run.name}_site-a"
    },
    {
      "name": "site-b",
      "cidr": "10.92.2.0/24",
      "internet": true,
      "native": "${run.name}_site-b"
    },
    {
      "name": "wan",
      "cidr": "10.92.0.0/29",
      "internet": false,
      "native": "${run.name}_wan"
    }
  ],
  "machines": [
    {
      "name": "vios",
      "role": "target",
      "arch": "amd64",
      "addresses": {
        "site-a": "10.92.1.1",
        "wan": "10.92.0.2"
      },
      "native": {
        "service": "vios"
      }
    },
    {
      "name": "vios-routes",
      "role": "infra",
      "of": "vios",
      "addresses": {},
      "native": {
        "service": "vios-routes"
      }
    },
    {
      "name": "csr",
      "role": "target",
      "arch": "amd64",
      "addresses": {
        "site-b": "10.92.2.1",
        "wan": "10.92.0.3"
      },
      "native": {
        "service": "csr"
      }
    },
    {
      "name": "csr-routes",
      "role": "infra",
      "of": "csr",
      "addresses": {},
      "native": {
        "service": "csr-routes"
      }
    },
    {
      "name": "host-a",
      "role": "target",
      "arch": "amd64",
      "addresses": {
        "site-a": "10.92.1.10"
      },
      "native": {
        "service": "host-a"
      }
    },
    {
      "name": "host-a-routes",
      "role": "infra",
      "of": "host-a",
      "addresses": {},
      "native": {
        "service": "host-a-routes"
      }
    },
    {
      "name": "host-b",
      "role": "target",
      "arch": "amd64",
      "addresses": {
        "site-b": "10.92.2.10"
      },
      "native": {
        "service": "host-b"
      },
      "ports": [
        {
          "name": "web",
          "port": 80,
          "protocol": "tcp",
          "http": true
        }
      ]
    },
    {
      "name": "host-b-routes",
      "role": "infra",
      "of": "host-b",
      "addresses": {},
      "native": {
        "service": "host-b-routes"
      }
    },
    {
      "name": "isoloom-check-host-a",
      "role": "check",
      "of": "host-a",
      "addresses": {},
      "native": {
        "service": "isoloom-check-host-a"
      }
    },
    {
      "name": "isoloom-probe-amd64",
      "role": "infra",
      "addresses": {},
      "native": {
        "service": "isoloom-probe-amd64"
      }
    }
  ],
  "lifecycle": {
    "up": [
      {
        "id": "pin-ports",
        "note": "Picking the lab's host ports…",
        "action": "compose.pin_ports"
      },
      {
        "id": "ports-free",
        "action": "compose.check_ports_free"
      },
      {
        "id": "stale-networks",
        "action": "compose.remove_stale_networks",
        "failure": "tolerate"
      },
      {
        "id": "up",
        "note": "Starting the lab's containers…",
        "argv": [
          "docker",
          "compose",
          "--project-name",
          "${run.name}",
          "--file",
          "compose.yml",
          "--file",
          "${run.state_dir}/ports.yml",
          "up",
          "--detach",
          "--build",
          "--pull",
          "missing",
          "--wait",
          "--wait-timeout",
          "600"
        ],
        "timeout_s": 1800
      }
    ],
    "down": [
      {
        "id": "down",
        "argv": [
          "docker",
          "compose",
          "--project-name",
          "${run.name}",
          "--file",
          "compose.yml",
          "--file",
          "${run.state_dir}/ports.yml",
          "--profile",
          "check",
          "down",
          "--volumes",
          "--remove-orphans"
        ],
        "timeout_s": 300,
        "when": "always"
      },
      {
        "id": "containers",
        "action": "compose.remove_containers",
        "when": "always",
        "failure": "tolerate"
      },
      {
        "id": "networks",
        "action": "compose.remove_networks",
        "when": "always",
        "failure": "tolerate"
      }
    ],
    "park": {
      "pause": [
        {
          "id": "stop",
          "argv": [
            "docker",
            "compose",
            "--project-name",
            "${run.name}",
            "--file",
            "compose.yml",
            "--file",
            "${run.state_dir}/ports.yml",
            "stop"
          ],
          "timeout_s": 300
        }
      ],
      "shutdown": [
        {
          "id": "stop",
          "argv": [
            "docker",
            "compose",
            "--project-name",
            "${run.name}",
            "--file",
            "compose.yml",
            "--file",
            "${run.state_dir}/ports.yml",
            "stop"
          ],
          "timeout_s": 300
        }
      ]
    },
    "resume": [
      {
        "id": "start",
        "argv": [
          "docker",
          "compose",
          "--project-name",
          "${run.name}",
          "--file",
          "compose.yml",
          "--file",
          "${run.state_dir}/ports.yml",
          "start"
        ],
        "timeout_s": 600
      }
    ],
    "status": {
      "id": "ps",
      "argv": [
        "docker",
        "compose",
        "--project-name",
        "${run.name}",
        "--file",
        "compose.yml",
        "--file",
        "${run.state_dir}/ports.yml",
        "ps",
        "--all",
        "--format",
        "json"
      ],
      "timeout_s": 25
    }
  },
  "ready": [
    {
      "kind": "step_ok",
      "step": "up",
      "means": "every long-running service is healthy (`--wait`: each port's probe, the route keepers, the machines' own healthchecks)"
    }
  ],
  "outputs": [],
  "checks": {
    "protocol": "isoloom-check/1",
    "setup": [],
    "runners": [
      {
        "id": "isoloom-check-host-a",
        "from": "from host-a",
        "checks": [
          {
            "name": "site A reaches site B through both routers",
            "kind": "http",
            "wait_s": 900,
            "derived": false
          },
          {
            "name": "host-b:80 blocked from host-a",
            "kind": "tcp",
            "wait_s": 0,
            "derived": true
          }
        ],
        "step": {
          "id": "check-host-a",
          "argv": [
            "docker",
            "compose",
            "--project-name",
            "${run.name}",
            "--file",
            "compose.yml",
            "--file",
            "${run.state_dir}/ports.yml",
            "--profile",
            "check",
            "run",
            "--rm",
            "--no-deps",
            "--env",
            "ISOLOOM_DERIVED",
            "isoloom-check-host-a"
          ],
          "timeout_s": 990
        },
        "on_timeout": [
          {
            "id": "rm-check-host-a",
            "action": "compose.remove_containers",
            "with": {
              "one_off": "true",
              "service": "isoloom-check-host-a"
            },
            "failure": "tolerate"
          }
        ]
      }
    ],
    "teardown": []
  },
  "recovery": {
    "stale_markers": [
      "is already in use by container",
      "network with name",
      "has incorrect label"
    ],
    "steps": [
      {
        "id": "containers",
        "action": "compose.remove_containers",
        "when": "always",
        "failure": "tolerate"
      },
      {
        "id": "networks",
        "action": "compose.remove_networks",
        "when": "always",
        "failure": "tolerate"
      }
    ],
    "retries": 1
  }
}

