    version   = "latest"
  }
  lifecycle {
    ignore_changes = [custom_data]
  }
}

# The controller (Ansible): every network may reach it, and SSH from allowed_cidr.
resource "azurerm_network_security_group" "isoloom_controller" {
  name                = "${local.name}-isoloom-controller"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  security_rule {
    name                       = "net-lab"
    priority                   = 100
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "10.63.0.0/24"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "ssh"
    priority                   = 110
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_range     = "22"
    source_address_prefix      = var.allowed_cidr
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "deny-rest-of-vnet"
    priority                   = 4000
    direction                  = "Inbound"
    access                     = "Deny"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "VirtualNetwork"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "outbound"
    priority                   = 100
    direction                  = "Outbound"
    access                     = "Allow"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "*"
    destination_address_prefix = "*"
  }
}

resource "azurerm_public_ip" "isoloom_controller" {
  name                = "${local.name}-isoloom-controller"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  allocation_method   = "Static"
  sku                 = "Standard"
}

resource "azurerm_network_interface" "isoloom_controller_lab" {
  name                = "${local.name}-isoloom-controller-lab"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  ip_configuration {
    name                          = "primary"
    subnet_id                     = azurerm_subnet.lab.id
    private_ip_address_allocation = "Static"
    private_ip_address            = "10.63.0.253"
    public_ip_address_id          = azurerm_public_ip.isoloom_controller.id
  }
}

resource "azurerm_network_interface_security_group_association" "isoloom_controller_lab" {
  network_interface_id      = azurerm_network_interface.isoloom_controller_lab.id
  network_security_group_id = azurerm_network_security_group.isoloom_controller.id
}

resource "azurerm_linux_virtual_machine" "isoloom_controller" {
  name                  = "${local.name}-isoloom-controller"
  resource_group_name   = azurerm_resource_group.env.name
  location              = var.region
  tags                  = local.tags
  size                  = "Standard_B2ts_v2"
  admin_username        = "isoloom"
  network_interface_ids = [azurerm_network_interface.isoloom_controller_lab.id]
  custom_data           = base64encode("#!/bin/sh\n# Isoloom: this machine sets itself up. Its progress is in /var/lib/isoloom/ready (isoloom-ready/1), its output in /var/log/isoloom-setup.log. The project comes over SSH from Terraform.\nmkdir -p /var/lib/isoloom\nrm -f /var/lib/isoloom/setup.sh.new\n(umask 077 && cat > /var/lib/isoloom/setup.sh.new) <<'ISOLOOM_SETUP'\n#!/bin/sh\numask 022\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\nstate=$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\npart=$(cat /var/lib/isoloom/part 2>/dev/null || echo 1)\ncase \"$state\" in ready|\"failed: \"*) exit 0 ;; esac\nif [ \"$part\" = 1 ]; then\necho 'running: waiting for the project (Terraform brings it in over SSH)' > /var/lib/isoloom/ready; { i=0; until [ -f /var/lib/isoloom/project-delivered ]; do [ \"$i\" -gt 0 ] || echo 'waiting for the project, which Terraform brings in over SSH during its apply'; i=$((i+5)); if [ \"$i\" -gt 2400 ]; then echo 'the project never came: Terraform brings it in over SSH during its apply (its terraform_data.isoloom_ready_<machine>), with ssh_private_key_file' >&2; exit 1; fi; sleep 5; done; } || { echo 'failed: waiting for the project (Terraform brings it in over SSH)' > /var/lib/isoloom/ready; exit 1; }\necho 'running: the controller'\\''s key' > /var/lib/isoloom/ready; { mkdir -p /etc/isoloom && (umask 077 && echo ${base64encode(tls_private_key.controller.private_key_openssh)} | base64 -d > /etc/isoloom/id_ed25519) && chmod 0600 /etc/isoloom/id_ed25519; } || { echo 'failed: the controller'\\''s key' > /var/lib/isoloom/ready; exit 1; }\necho 'running: the inventory' > /var/lib/isoloom/ready; { mkdir -p /etc/isoloom && (umask 077 && echo ${base64encode("[linux]\nweb ansible_host=10.63.0.10 ansible_user=isoloom\ncache ansible_host=10.63.0.20 ansible_user=isoloom maxmemory='\"64mb\"'\n\n[windows]\n\n[linux:vars]\nansible_ssh_private_key_file=/etc/isoloom/id_ed25519\nansible_become=true\n\n[webservers]\nweb\n\n[caches]\ncache\n\n[pair]\nweb\ncache\n")} | base64 -d > /etc/isoloom/inventory.ini) && chmod 0600 /etc/isoloom/inventory.ini; } || { echo 'failed: the inventory' > /var/lib/isoloom/ready; exit 1; }\necho 'running: hosts file' > /var/lib/isoloom/ready; { sh -c 'printf '\\''%s\\n'\\'' '\\''10.63.0.10 web'\\'' '\\''10.63.0.20 cache'\\'' >> /etc/hosts'; } || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }\necho 'running: packages' > /var/lib/isoloom/ready; { sh -c 'DEBIAN_FRONTEND=noninteractive apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq python3-venv curl netcat-openbsd openssh-client >/dev/null'; } || { echo 'failed: packages' > /var/lib/isoloom/ready; exit 1; }\necho 'running: installing Ansible' > /var/lib/isoloom/ready; { sh -c '[ -x /opt/ansible/bin/ansible-playbook ] || { python3 -m venv /opt/ansible && /opt/ansible/bin/pip install -q '\\''ansible-core>=2.15,<2.17'\\'' pywinrm; }'; } || { echo 'failed: installing Ansible' > /var/lib/isoloom/ready; exit 1; }\necho 'running: waiting for web' > /var/lib/isoloom/ready; { sh -c 'i=0; until s=$(ssh -o StrictHostKeyChecking=no -o ConnectTimeout=5 -i /etc/isoloom/id_ed25519 isoloom@10.63.0.10 head -n 1 /var/lib/isoloom/ready 2>/dev/null) && [ \"$s\" = ready ]; do case \"$s\" in \"failed: \"*) echo \"web: $s\"; exit 1;; esac; i=$((i+1)); [ $i -gt 240 ] && { echo '\\''web not ready'\\''; exit 1; }; sleep 5; done'; } || { echo 'failed: waiting for web' > /var/lib/isoloom/ready; exit 1; }\necho 'running: waiting for cache' > /var/lib/isoloom/ready; { sh -c 'i=0; until s=$(ssh -o StrictHostKeyChecking=no -o ConnectTimeout=5 -i /etc/isoloom/id_ed25519 isoloom@10.63.0.20 head -n 1 /var/lib/isoloom/ready 2>/dev/null) && [ \"$s\" = ready ]; do case \"$s\" in \"failed: \"*) echo \"cache: $s\"; exit 1;; esac; i=$((i+1)); [ $i -gt 240 ] && { echo '\\''cache not ready'\\''; exit 1; }; sleep 5; done'; } || { echo 'failed: waiting for cache' > /var/lib/isoloom/ready; exit 1; }\necho 'running: the playbooks' > /var/lib/isoloom/ready; { sh -c 'set -e\nmkdir -p /tmp/isoloom-facts\nexport PATH=\"/opt/ansible/bin:$PATH\" ANSIBLE_HOST_KEY_CHECKING=False ANSIBLE_GATHERING=smart ANSIBLE_FORKS=20 ANSIBLE_PIPELINING=True ANSIBLE_CACHE_PLUGIN=jsonfile ANSIBLE_CACHE_PLUGIN_CONNECTION=/tmp/isoloom-facts ANSIBLE_CACHE_PLUGIN_TIMEOUT=7200\nmkdir -p /tmp/isoloom-retry\nexport ANSIBLE_RETRY_FILES_ENABLED=True ANSIBLE_RETRY_FILES_SAVE_PATH=/tmp/isoloom-retry\n_isoloom_pause=$${ISOLOOM_RETRY_PAUSE:-15}\n_isoloom_attempts=4\n_isoloom_transient='\\''send_input failed|the pipe has been ended|winrmtransporterror|winrmoperationtimeouterror|read timeout|bad http response returned from server|(kerberos|ntlm|credssp).*500|remote end closed connection|connection reset by peer|connection refused|connection aborted|broken pipe|timed out|failed to connect to the host via ssh|shared connection to .* closed'\\''\nretry_download() {\n  _isoloom_n=1\n  until \"$@\"; do\n    [ \"$_isoloom_n\" -lt 5 ] || return 1\n    echo \"isoloom: download failed; trying again in $((_isoloom_n * _isoloom_pause)) s ($((_isoloom_n + 1))/5)\"\n    sleep $((_isoloom_n * _isoloom_pause))\n    _isoloom_n=$((_isoloom_n + 1))\n  done\n}\nplay_hosts() {\n  awk -v transient=\"$_isoloom_transient\" '\\''\n    function commit() {\n      if (pending != \"\") { if (pending_real) real[pending] = 1; else cut[pending] = 1 }\n      pending = \"\"\n    }\n    { gsub(/\\033\\[[0-9;]*m/, \"\") }\n    /^\\.\\.\\.ignoring/ { pending = \"\"; next }\n    { commit() }\n    /^(fatal|failed): \\[/ && !/UNREACHABLE!/ {\n      pending = $0\n      sub(/^(fatal|failed): \\[/, \"\", pending)\n      sub(/\\].*/, \"\", pending)\n      sub(/ -> .*/, \"\", pending)\n      pending_real = (tolower($0) !~ transient)\n      next\n    }\n    /^PLAY RECAP/ { recap = 1; next }\n    recap && / : ok=/ {\n      for (i = 2; i <= NF; i++) {\n        split($i, kv, \"=\")\n        if (kv[1] == \"failed\" && kv[2] > 0) failed[$1] = 1\n        if (kv[1] == \"unreachable\" && kv[2] > 0) unreachable[$1] = 1\n      }\n    }\n    END {\n      commit()\n      for (h in failed) print ((h in real || !(h in cut)) ? \"real \" : \"cut \") h\n      for (h in unreachable) if (!(h in failed)) print \"unreachable \" h\n    }\n  '\\'' \"$1\" | sort\n}\n_isoloom_kind() {\n  echo \"$1\" | awk -v k=\"$2\" '\\''$1 == k { printf \"%s%s\", s, $2; s = \" \" }'\\''\n}\nrun_play() {\n  # The playbook is the last argument; Ansible names its retry file after it.\n  for _isoloom_book; do :; done\n  _isoloom_name=$(basename \"$_isoloom_book\")\n  _isoloom_retry=$${ANSIBLE_RETRY_FILES_SAVE_PATH:-/tmp/isoloom-retry}/$${_isoloom_name%.*}.retry\n  _isoloom_limit=\n  _isoloom_log=$(mktemp)\n  _isoloom_rcf=$(mktemp)\n  _isoloom_n=1\n  rm -f \"$_isoloom_retry\"\n  while :; do\n    { \"$@\" && echo 0 > \"$_isoloom_rcf\" || echo $? > \"$_isoloom_rcf\"; } 2>&1 | tee \"$_isoloom_log\"\n    _isoloom_rc=$(cat \"$_isoloom_rcf\")\n    [ \"$_isoloom_rc\" -ne 0 ] || break\n    _isoloom_hosts=$(play_hosts \"$_isoloom_log\")\n    _isoloom_real=$(_isoloom_kind \"$_isoloom_hosts\" real)\n    _isoloom_gone=$(_isoloom_kind \"$_isoloom_hosts\" unreachable)\n    _isoloom_cut=$(_isoloom_kind \"$_isoloom_hosts\" cut)\n    _isoloom_again=\"$_isoloom_gone$${_isoloom_gone:+$${_isoloom_cut:+ }}$_isoloom_cut\"\n    if [ -n \"$_isoloom_real\" ]; then\n      echo \"isoloom: $_isoloom_name: a task failed on $_isoloom_real: not retried\"\n      break\n    fi\n    if [ -z \"$_isoloom_again\" ]; then\n      echo \"isoloom: $_isoloom_name failed (exit $_isoloom_rc) with no unreachable host or dropped connection: not retried\"\n      break\n    fi\n    if [ \"$_isoloom_n\" -ge \"$_isoloom_attempts\" ]; then\n      echo \"isoloom: $_isoloom_name: still unreachable after $_isoloom_n runs: $_isoloom_again; giving up\"\n      break\n    fi\n    echo \"$_isoloom_again\" | tr '\\'' '\\'' '\\''\\n'\\'' > \"$_isoloom_retry\"\n    if [ -z \"$_isoloom_limit\" ]; then set -- \"$@\" --limit \"@$_isoloom_retry\"; _isoloom_limit=1; fi\n    _isoloom_n=$((_isoloom_n + 1))\n    if [ -n \"$_isoloom_gone\" ]; then\n      _isoloom_wait=$((4 * _isoloom_pause))\n      echo \"isoloom: $_isoloom_name: unreachable: $_isoloom_again; waiting $_isoloom_wait s, then running it again on them ($_isoloom_n/$_isoloom_attempts)\"\n    else\n      _isoloom_wait=$((2 * _isoloom_pause))\n      echo \"isoloom: $_isoloom_name: the play was cut by a dropped connection on $_isoloom_cut; waiting $_isoloom_wait s, then running it again on them ($_isoloom_n/$_isoloom_attempts)\"\n    fi\n    sleep \"$_isoloom_wait\"\n  done\n  rm -f \"$_isoloom_log\" \"$_isoloom_rcf\"\n  [ \"$_isoloom_rc\" -ne 0 ] || rm -f \"$_isoloom_retry\"\n  return \"$_isoloom_rc\"\n}\ncd '\\''/opt/isoloom/ansible'\\''\nretry_download ansible-galaxy install -r '\\''/opt/isoloom/ansible/requirements.yml'\\''\nrun_play ansible-playbook -i /etc/isoloom/inventory.ini -i '\\''/opt/isoloom/ansible/groups.ini'\\'' -e '\\''{\"greeting\":\"hello from ansible\",\"tools\":[\"curl\",\"jq\"],\"cache_port\":6379}'\\'' '\\''site.yml'\\'''; } || { echo 'failed: the playbooks' > /var/lib/isoloom/ready; exit 1; }\necho 'running: health check' > /var/lib/isoloom/ready; { sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'; } || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }\nfi\necho ready > /var/lib/isoloom/ready\nrm -f /var/lib/isoloom/part\nexit 0\nISOLOOM_SETUP\nmv -f /var/lib/isoloom/setup.sh.new /var/lib/isoloom/setup.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-setup.service <<'ISOLOOM_UNIT'\n[Unit]\nDescription=Isoloom: the machine's set-up\nWants=network-online.target\nAfter=network-online.target cloud-final.service google-startup-scripts.service\n\n[Service]\nType=oneshot\nExecStart=/bin/sh /var/lib/isoloom/setup.sh\nStandardOutput=append:/var/log/isoloom-setup.log\nStandardError=append:/var/log/isoloom-setup.log\nTimeoutStartSec=0\n\n[Install]\nWantedBy=multi-user.target\nISOLOOM_UNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-setup.service >/dev/null 2>&1\nsystemctl start --no-block isoloom-setup.service\nelse\nnohup sh /var/lib/isoloom/setup.sh >> /var/log/isoloom-setup.log 2>&1 &\nfi\n")
  admin_ssh_key {
    username   = "isoloom"
    public_key = var.ssh_public_key
  }
  os_disk {
    caching              = "ReadWrite"
    storage_account_type = "StandardSSD_LRS"
    disk_size_gb         = 30
  }
  source_image_reference {
    publisher = "Debian"
    offer     = "debian-12"
    sku       = "12-gen2"
    version   = "latest"
  }
  lifecycle {
    ignore_changes = [custom_data]
  }
}

resource "terraform_data" "isoloom_ready_web" {
  triggers_replace = [azurerm_linux_virtual_machine.web.id]
  connection {
    type        = "ssh"
    host        = azurerm_public_ip.web.ip_address
    user        = "isoloom"
    private_key = file(pathexpand(var.ssh_private_key_file))
    timeout     = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-ready_web.tgz\" --exclude=\"${basename(local.root)}/.isoloom*\" --exclude=\".git\" --exclude=\".terraform\" --exclude=\"*.tfstate\" --exclude=\"*.tfstate.*\" --exclude=\".terraform.tfstate.lock.info\" --exclude=\"crash.log\" --exclude=\"crash.*.log\" --exclude=\".vagrant\" -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-ready_web.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-outputs-web.tgz\" -C \"${abspath(local.root)}\" .isoloom/cloud-vm/checks"
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-outputs-web.tgz"
    destination = "/tmp/isoloom-outputs.tgz"
  }
  provisioner "remote-exec" {
    inline = [
      "sudo sh -c 'rm -rf /opt/isoloom && mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz && tar -xzf /tmp/isoloom-outputs.tgz -C /opt/isoloom && rm -f /tmp/isoloom-outputs.tgz && mkdir -p /var/lib/isoloom && touch /var/lib/isoloom/project-delivered'"
    ]
  }
  provisioner "remote-exec" {
    inline = [
      "sh -c 't=0\nif command -v cloud-init >/dev/null 2>&1; then sudo cloud-init status --wait >/dev/null 2>&1 || true; fi\nwhile :; do\ns=$(sudo head -n1 /var/lib/isoloom/ready 2>/dev/null)\ncase \"$s\" in\nready) echo \"web: set up\"; exit 0 ;;\n\"failed: \"*) echo \"web: its set-up stopped ($s); the end of /var/log/isoloom-setup.log:\"; sudo tail -n 40 /var/log/isoloom-setup.log 2>/dev/null; exit 1 ;;\nesac\nif [ \"$t\" -ge 2400 ]; then echo \"web: not set up after 2400 s ($${s:-no ready file}); the end of /var/log/isoloom-setup.log:\"; sudo tail -n 40 /var/log/isoloom-setup.log 2>/dev/null; exit 1; fi\nsleep 5; t=$((t + 5))\ndone'"
    ]
  }
}

resource "terraform_data" "isoloom_ready_cache" {
  triggers_replace = [azurerm_linux_virtual_machine.cache.id]
  connection {
    type        = "ssh"
    host        = azurerm_public_ip.cache.ip_address
