## .isoloom/cloud-vm/gcp/main.tf
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  terraform -chdir=.isoloom/cloud-vm/gcp init && terraform -chdir=.isoloom/cloud-vm/gcp apply \
#           -var billing_account=<id> -var allowed_cidr=<your IP>/32 -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)" -var ssh_private_key_file=~/.ssh/id_ed25519
# Stop:   terraform -chdir=.isoloom/cloud-vm/gcp destroy (same variables)

terraform {
  required_version = ">= 1.6.0"
  backend "local" {}
  required_providers {
    google = { source = "hashicorp/google", version = "~> 8.5.0" }
    local  = { source = "hashicorp/local", version = "~> 2.9.1" }
    tls    = { source = "hashicorp/tls", version = "~> 4.4.1" }
  }
}

variable "project" {
  type        = string
  default     = ""
  description = "An existing project; or leave empty and give billing_account for a project of its own"
}

variable "billing_account" {
  type        = string
  default     = ""
  description = "With no project: create one for this environment, billed here, deleted with it"
}

variable "org_id" {
  type    = string
  default = ""
}

variable "region" {
  type    = string
  default = "europe-west9"
}

variable "allowed_cidr" {
  type        = string
  description = "Who may reach the machines (SSH and the published ports), e.g. your IP/32"
}

variable "ssh_public_key" {
  type        = string
  description = "The SSH public key the machines let in: Terraform signs in with its private half (`ssh_private_key_file`) to set them up or wait for their set-up, and so can you, to run the checks"
}

variable "ssh_private_key_file" {
  type        = string
  description = "The private key of ssh_public_key (a path, ~ allowed): Terraform signs in to the machines with it to bring the project in and wait for their set-up"
}

variable "expires_at" {
  type        = string
  default     = ""
  description = "When the environment should end, in Unix seconds (empty: no end): a tag on every resource, so a reaper finds what to destroy, and the time the machines shut themselves down"
}

provider "google" {
  region = var.region
}

# A project of its own when none is given: everything goes when the environment is destroyed.
resource "google_project" "env" {
  count               = var.project == "" ? 1 : 0
  name                = "isoloom-ansible-pair"
  project_id          = "isoloom-${terraform_data.id.output}"
  billing_account     = var.billing_account
  org_id              = var.org_id == "" ? null : var.org_id
  deletion_policy     = "DELETE"
  auto_create_network = false
  labels = {
    isoloom-environment = "ansible-pair"
    managed-by          = "isoloom"
    isoloom-instance    = local.name
    isoloom-expires-at  = var.expires_at
  }
}

resource "google_project_service" "compute" {
  count              = var.project == "" ? 1 : 0
  project            = google_project.env[0].project_id
  service            = "compute.googleapis.com"
  disable_on_destroy = false
}

resource "terraform_data" "id" {
  input = substr(replace(uuid(), "-", ""), 0, 8)
  lifecycle {
    ignore_changes = [input]
  }
}

locals {
  name    = "isoloom-ansible-pair-${terraform_data.id.output}"
  root    = abspath("${path.module}/../../..")
  project = var.project != "" ? var.project : google_project_service.compute[0].project
  zone    = "${var.region}-a"
}

# The environment's networks: a VPC network each, holding a subnetwork with its exact range.
resource "google_compute_network" "lab" {
  project                 = local.project
  name                    = "${local.name}-lab"
  auto_create_subnetworks = false
  mtu                     = 1500
}

resource "google_compute_subnetwork" "lab" {
  project       = local.project
  name          = "${local.name}-lab"
  network       = google_compute_network.lab.id
  ip_cidr_range = "10.63.0.0/24"
  region        = var.region
}

# The controller's own key: it runs the playbooks over SSH on every machine.
resource "tls_private_key" "controller" {
  algorithm = "ED25519"
}

# Machine `web`: what may reach it.
resource "google_compute_firewall" "web_net_lab" {
  project       = local.project
  name          = "${local.name}-web-net-lab"
  network       = google_compute_network.lab.id
  direction     = "INGRESS"
  source_ranges = ["10.63.0.0/24"]
  target_tags   = ["${local.name}-web"]
  allow {
    protocol = "all"
  }
}

resource "google_compute_firewall" "web_ssh" {
  project       = local.project
  name          = "${local.name}-web-ssh"
  network       = google_compute_network.lab.id
  direction     = "INGRESS"
  source_ranges = [var.allowed_cidr]
  target_tags   = ["${local.name}-web"]
  allow {
    protocol = "tcp"
    ports    = ["22"]
  }
}

resource "google_compute_instance" "web" {
  project      = local.project
  name         = "${local.name}-web"
  machine_type = "e2-small"
  zone         = local.zone
  tags         = ["${local.name}-web"]
  boot_disk {
    initialize_params {
      image = "debian-cloud/debian-12"
      labels = {
        isoloom-environment = "ansible-pair"
        managed-by          = "isoloom"
        isoloom-instance    = local.name
        isoloom-expires-at  = var.expires_at
      }
      size = 20
    }
  }
  network_interface {
    subnetwork = google_compute_subnetwork.lab.id
    network_ip = "10.63.0.10"
    access_config {}
  }
  metadata                = { ssh-keys = "admin:${var.ssh_public_key}" }
  metadata_startup_script = "#!/bin/sh\n# Isoloom: this machine sets itself up. Its progress is in /var/lib/isoloom/ready (isoloom-ready/1), its output in /var/log/isoloom-setup.log. The project comes over SSH from Terraform.\nmkdir -p /var/lib/isoloom\nrm -f /var/lib/isoloom/setup.sh.new\n(umask 077 && cat > /var/lib/isoloom/setup.sh.new) <<'ISOLOOM_SETUP'\n#!/bin/sh\numask 022\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\nstate=$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\npart=$(cat /var/lib/isoloom/part 2>/dev/null || echo 1)\ncase \"$state\" in ready|\"failed: \"*) exit 0 ;; esac\nif [ \"$part\" = 1 ]; then\necho 'running: its host name' > /var/lib/isoloom/ready; { hostnamectl set-hostname web 2>/dev/null || hostname web; grep -q ' web$' /etc/hosts || echo '127.0.1.1 web' >> /etc/hosts; [ ! -d /etc/cloud/cloud.cfg.d ] || echo 'preserve_hostname: true' > /etc/cloud/cloud.cfg.d/99-isoloom-hostname.cfg; } || { echo 'failed: its host name' > /var/lib/isoloom/ready; exit 1; }\necho 'running: waiting for the project (Terraform brings it in over SSH)' > /var/lib/isoloom/ready; { i=0; until [ -f /var/lib/isoloom/project-delivered ]; do [ \"$i\" -gt 0 ] || echo 'waiting for the project, which Terraform brings in over SSH during its apply'; i=$((i+5)); if [ \"$i\" -gt 2400 ]; then echo 'the project never came: Terraform brings it in over SSH during its apply (its terraform_data.isoloom_ready_<machine>), with ssh_private_key_file' >&2; exit 1; fi; sleep 5; done; } || { echo 'failed: waiting for the project (Terraform brings it in over SSH)' > /var/lib/isoloom/ready; exit 1; }\necho 'running: the controller'\\''s key' > /var/lib/isoloom/ready; { u='admin'; i=0; until id \"$u\" >/dev/null 2>&1; do i=$((i+2)); [ $i -lt 600 ] || exit 1; sleep 2; done; h=$(getent passwd \"$u\" | cut -d: -f6); install -d -m 700 -o \"$u\" -g \"$(id -gn \"$u\")\" \"$h/.ssh\" && echo '${trimspace(tls_private_key.controller.public_key_openssh)}' >> \"$h/.ssh/authorized_keys\" && chown \"$u\" \"$h/.ssh/authorized_keys\" && chmod 600 \"$h/.ssh/authorized_keys\"; } || { echo 'failed: the controller'\\''s key' > /var/lib/isoloom/ready; exit 1; }\necho 'running: hosts file' > /var/lib/isoloom/ready; { sh -c 'printf '\\''%s\\n'\\'' '\\''10.63.0.10 web'\\'' '\\''10.63.0.20 cache'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'; } || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }\necho 'running: health check' > /var/lib/isoloom/ready; { sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'; } || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }\nfi\necho ready > /var/lib/isoloom/ready\nrm -f /var/lib/isoloom/part\nexit 0\nISOLOOM_SETUP\nmv -f /var/lib/isoloom/setup.sh.new /var/lib/isoloom/setup.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-setup.service <<'ISOLOOM_UNIT'\n[Unit]\nDescription=Isoloom: the machine's set-up\nWants=network-online.target\nAfter=network-online.target cloud-final.service google-startup-scripts.service\n\n[Service]\nType=oneshot\nExecStart=/bin/sh /var/lib/isoloom/setup.sh\nStandardOutput=append:/var/log/isoloom-setup.log\nStandardError=append:/var/log/isoloom-setup.log\nTimeoutStartSec=0\n\n[Install]\nWantedBy=multi-user.target\nISOLOOM_UNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-setup.service >/dev/null 2>&1\nsystemctl start --no-block isoloom-setup.service\nelse\nnohup sh /var/lib/isoloom/setup.sh >> /var/log/isoloom-setup.log 2>&1 &\nfi\n"
  labels = {
    isoloom-environment = "ansible-pair"
    managed-by          = "isoloom"
    isoloom-instance    = local.name
    isoloom-expires-at  = var.expires_at
  }
  lifecycle {
    ignore_changes = [metadata_startup_script]
  }
}

# Machine `cache`: what may reach it.
resource "google_compute_firewall" "cache_net_lab" {
  project       = local.project
  name          = "${local.name}-cache-net-lab"
  network       = google_compute_network.lab.id
  direction     = "INGRESS"
  source_ranges = ["10.63.0.0/24"]
  target_tags   = ["${local.name}-cache"]
  allow {
    protocol = "all"
  }
}

resource "google_compute_firewall" "cache_ssh" {
  project       = local.project
  name          = "${local.name}-cache-ssh"
  network       = google_compute_network.lab.id
  direction     = "INGRESS"
  source_ranges = [var.allowed_cidr]
  target_tags   = ["${local.name}-cache"]
  allow {
    protocol = "tcp"
    ports    = ["22"]
  }
}

resource "google_compute_instance" "cache" {
  project      = local.project
  name         = "${local.name}-cache"
  machine_type = "e2-small"
  zone         = local.zone
  tags         = ["${local.name}-cache"]
  boot_disk {
    initialize_params {
      image = "debian-cloud/debian-12"
      labels = {
        isoloom-environment = "ansible-pair"
