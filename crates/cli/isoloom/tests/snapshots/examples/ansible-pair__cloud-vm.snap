---
source: crates/isoloom/tests/example_snapshots.rs
---
# isoloom targets
✓ cloud-vm
    ✗ digitalocean (DigitalOcean cloud-vm takes one machine on one network: a droplet joins one VPC, at a private address DigitalOcean picks, so other machines couldn't reach it at its spec address)
    ✗ linode (Linode cloud-vm has no Ansible controller yet)
    ✗ oci (Oracle Cloud cloud-vm has no Ansible controller yet)

# isoloom generate --target cloud-vm (exit 0)
✓ .isoloom/cloud-vm/aws/main.tf
✓ .isoloom/cloud-vm/azure/main.tf
✓ .isoloom/cloud-vm/gcp/main.tf
✓ .isoloom/cloud-vm/checks/networks.sh
✓ .isoloom/cloud-vm/checks/web.sh
✓ .isoloom/cloud-vm/checks/cache.sh
✓ .isoloom/resolved.json

## .isoloom/cloud-vm/aws/main.tf
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  terraform -chdir=.isoloom/cloud-vm/aws init && terraform -chdir=.isoloom/cloud-vm/aws apply \
#           -var allowed_cidr=<your IP>/32 -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)" -var ssh_private_key_file=~/.ssh/id_ed25519
# Stop:   terraform -chdir=.isoloom/cloud-vm/aws destroy (same variables)

terraform {
  required_version = ">= 1.6"
  backend "local" {}
  required_providers {
    aws   = { source = "hashicorp/aws", version = "~> 6.67.0" }
    local = { source = "hashicorp/local", version = "~> 2.9.1" }
    tls   = { source = "hashicorp/tls", version = "~> 4.4.1" }
  }
}

variable "region" {
  type    = string
  default = "eu-west-3"
}

variable "allowed_cidr" {
  type        = string
  description = "Who may reach the machines (SSH and the published ports), e.g. your IP/32"
}

variable "ssh_public_key" {
  type = string
}

variable "ssh_private_key_file" {
  type        = string
  description = "The private key of ssh_public_key: Terraform sets the machines up over SSH"
}

variable "auto_stop_minutes" {
  type        = number
  default     = 0
  description = "Shut the machines down after this many minutes (0: never)"
}

variable "expires_at" {
  type        = string
  default     = ""
  description = "When the environment should end, in Unix seconds (empty: no end), as a tag on every resource so a reaper can find what to destroy"
}

provider "aws" {
  region = var.region
  default_tags {
    tags = {
      isoloom-environment = "ansible-pair"
      managed-by          = "isoloom"
      isoloom-instance    = local.name
      isoloom-expires-at  = var.expires_at
    }
  }
}

resource "terraform_data" "id" {
  input = substr(replace(uuid(), "-", ""), 0, 8)
  lifecycle {
    ignore_changes = [input]
  }
}

locals {
  name = "isoloom-ansible-pair-${terraform_data.id.output}"
  root = abspath("${path.module}/../../..")
}

data "aws_availability_zones" "available" {
  state = "available"
}

# The environment's networks: one VPC, a subnet per network with its exact range.
resource "aws_vpc" "env" {
  cidr_block = "10.63.0.0/24"
  tags       = { Name = local.name }
}

resource "aws_internet_gateway" "env" {
  vpc_id = aws_vpc.env.id
}

resource "aws_route_table" "env" {
  vpc_id = aws_vpc.env.id
  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.env.id
  }
}

resource "aws_subnet" "lab" {
  vpc_id            = aws_vpc.env.id
  cidr_block        = "10.63.0.0/24"
  availability_zone = data.aws_availability_zones.available.names[0]
  tags              = { Name = "${local.name}-lab" }
}

resource "aws_route_table_association" "lab" {
  subnet_id      = aws_subnet.lab.id
  route_table_id = aws_route_table.env.id
}

resource "aws_key_pair" "env" {
  key_name   = local.name
  public_key = var.ssh_public_key
}

# The controller's own key: it runs the playbooks over SSH on every machine.
resource "tls_private_key" "controller" {
  algorithm = "ED25519"
}

data "aws_ami" "debian_12" {
  most_recent = true
  owners      = ["136693071363"]
  filter {
    name   = "name"
    values = ["debian-12-amd64-*"]
  }
  filter {
    name   = "architecture"
    values = ["x86_64"]
  }
}

# Machine `web`: what may reach it.
resource "aws_security_group" "web" {
  name   = "${local.name}-web"
  vpc_id = aws_vpc.env.id
  ingress {
    description = "its network (lab)"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["10.63.0.0/24"]
  }
  ingress {
    description = "SSH from allowed_cidr"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [var.allowed_cidr]
  }
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_instance" "web" {
  ami                         = data.aws_ami.debian_12.id
  instance_type               = "t3.micro"
  subnet_id                   = aws_subnet.lab.id
  private_ip                  = "10.63.0.10"
  associate_public_ip_address = true
  key_name                    = aws_key_pair.env.key_name
  vpc_security_group_ids      = [aws_security_group.web.id]
  user_data                   = var.auto_stop_minutes > 0 ? "#!/bin/sh\nshutdown -h +${var.auto_stop_minutes}\n" : null
  root_block_device {
    volume_size = 20
  }
  tags = { Name = "${local.name}-web" }
}

resource "terraform_data" "web" {
  triggers_replace = [aws_instance.web.id]
  connection {
    type        = "ssh"
    host        = aws_instance.web.public_ip
    user        = "admin"
    private_key = file(pathexpand(var.ssh_private_key_file))
    timeout     = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-web.tgz\" --exclude=.git --exclude=.vagrant --exclude=.terraform --exclude=.isoloom-project* -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-web.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "remote-exec" {
    inline = [
      "set -e",
      "cloud-init status --wait >/dev/null 2>&1 || true",
      "mkdir -p ~/.ssh && echo '${trimspace(tls_private_key.controller.public_key_openssh)}' >> ~/.ssh/authorized_keys",
      "sudo sh -c 'mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz'",
      "sudo sh -c 'for l in '\\''10.63.0.20 cache'\\''; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'",
      "sudo sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'"
    ]
  }
}

# Machine `cache`: what may reach it.
resource "aws_security_group" "cache" {
  name   = "${local.name}-cache"
  vpc_id = aws_vpc.env.id
  ingress {
    description = "its network (lab)"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["10.63.0.0/24"]
  }
  ingress {
    description = "SSH from allowed_cidr"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [var.allowed_cidr]
  }
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_instance" "cache" {
  ami                         = data.aws_ami.debian_12.id
  instance_type               = "t3.micro"
  subnet_id                   = aws_subnet.lab.id
  private_ip                  = "10.63.0.20"
  associate_public_ip_address = true
  key_name                    = aws_key_pair.env.key_name
  vpc_security_group_ids      = [aws_security_group.cache.id]
  user_data                   = var.auto_stop_minutes > 0 ? "#!/bin/sh\nshutdown -h +${var.auto_stop_minutes}\n" : null
  root_block_device {
    volume_size = 20
  }
  tags = { Name = "${local.name}-cache" }
}

resource "terraform_data" "cache" {
  triggers_replace = [aws_instance.cache.id]
  connection {
    type        = "ssh"
    host        = aws_instance.cache.public_ip
    user        = "admin"
    private_key = file(pathexpand(var.ssh_private_key_file))
    timeout     = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-cache.tgz\" --exclude=.git --exclude=.vagrant --exclude=.terraform --exclude=.isoloom-project* -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-cache.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "remote-exec" {
    inline = [
      "set -e",
      "cloud-init status --wait >/dev/null 2>&1 || true",
      "mkdir -p ~/.ssh && echo '${trimspace(tls_private_key.controller.public_key_openssh)}' >> ~/.ssh/authorized_keys",
      "sudo sh -c 'mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz'",
      "sudo sh -c 'for l in '\\''10.63.0.10 web'\\''; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'",
      "sudo sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'"
    ]
  }
}

# The controller (Ansible): every network may reach it, and SSH from allowed_cidr.
resource "aws_security_group" "isoloom_controller" {
  name   = "${local.name}-controller"
  vpc_id = aws_vpc.env.id
  ingress {
    description = "lab"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["10.63.0.0/24"]
  }
  ingress {
    description = "SSH from allowed_cidr"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [var.allowed_cidr]
  }
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_network_interface" "isoloom_controller_lab" {
  subnet_id         = aws_subnet.lab.id
  private_ips       = ["10.63.0.253"]
  security_groups   = [aws_security_group.isoloom_controller.id]
  source_dest_check = false
}

resource "aws_instance" "isoloom_controller" {
  ami           = data.aws_ami.debian_12.id
  instance_type = "t3.micro"
  key_name      = aws_key_pair.env.key_name
  user_data     = var.auto_stop_minutes > 0 ? "#!/bin/sh\nshutdown -h +${var.auto_stop_minutes}\n" : null
  primary_network_interface {
    network_interface_id = aws_network_interface.isoloom_controller_lab.id
  }
  tags = { Name = "${local.name}-controller" }
}

resource "aws_eip" "isoloom_controller" {
  network_interface = aws_network_interface.isoloom_controller_lab.id
  depends_on        = [aws_internet_gateway.env]
}

resource "terraform_data" "isoloom_controller" {
  triggers_replace = [aws_instance.isoloom_controller.id]
  connection {
    type        = "ssh"
    host        = aws_eip.isoloom_controller.public_ip
    user        = "admin"
    private_key = file(pathexpand(var.ssh_private_key_file))
    timeout     = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-controller.tgz\" --exclude=.git --exclude=.vagrant --exclude=.terraform --exclude=.isoloom-project* -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-controller.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "file" {
    content     = tls_private_key.controller.private_key_openssh
    destination = "/tmp/isoloom-controller-key"
  }
  provisioner "file" {
    content     = "[linux]\nweb ansible_host=10.63.0.10 ansible_user=admin\ncache ansible_host=10.63.0.20 ansible_user=admin maxmemory='\"64mb\"'\n\n[windows]\n\n[linux:vars]\nansible_ssh_private_key_file=/etc/isoloom/id_ed25519\nansible_become=true\n\n[webservers]\nweb\n\n[caches]\ncache\n\n[pair]\nweb\ncache\n"
    destination = "/tmp/isoloom-inventory.ini"
  }
  provisioner "remote-exec" {
    inline = [
      "set -e",
      "cloud-init status --wait >/dev/null 2>&1 || true",
      "sudo sh -c 'mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz'",
      "sudo sh -c 'printf '\\''%s\\n'\\'' '\\''10.63.0.10 web'\\'' '\\''10.63.0.20 cache'\\'' >> /etc/hosts'",
      "sudo sh -c 'mkdir -p /etc/isoloom && install -m 0600 /tmp/isoloom-controller-key /etc/isoloom/id_ed25519 && install -m 0644 /tmp/isoloom-inventory.ini /etc/isoloom/inventory.ini && rm -f /tmp/isoloom-controller-key /tmp/isoloom-inventory.ini'",
      "sudo sh -c 'DEBIAN_FRONTEND=noninteractive apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq python3-venv curl netcat-openbsd >/dev/null'",
      "sudo sh -c '[ -x /opt/ansible/bin/ansible-playbook ] || { python3 -m venv /opt/ansible && /opt/ansible/bin/pip install -q '\\''ansible-core>=2.15,<2.17'\\'' pywinrm; }'",
      "sudo sh -c 'set -e\nmkdir -p /tmp/isoloom-facts\nexport PATH=/opt/ansible/bin:$PATH ANSIBLE_HOST_KEY_CHECKING=False ANSIBLE_GATHERING=smart ANSIBLE_FORKS=20 ANSIBLE_PIPELINING=True ANSIBLE_CACHE_PLUGIN=jsonfile ANSIBLE_CACHE_PLUGIN_CONNECTION=/tmp/isoloom-facts ANSIBLE_CACHE_PLUGIN_TIMEOUT=7200\nmkdir -p /tmp/isoloom-retry\nexport ANSIBLE_RETRY_FILES_ENABLED=True ANSIBLE_RETRY_FILES_SAVE_PATH=/tmp/isoloom-retry\n_isoloom_pause=$${ISOLOOM_RETRY_PAUSE:-15}\n_isoloom_attempts=4\n_isoloom_transient='\\''send_input failed|the pipe has been ended|winrmtransporterror|winrmoperationtimeouterror|read timeout|bad http response returned from server|(kerberos|ntlm|credssp).*500|remote end closed connection|connection reset by peer|connection refused|connection aborted|broken pipe|timed out|failed to connect to the host via ssh|shared connection to .* closed'\\''\nretry_download() {\n  _isoloom_n=1\n  until \"$@\"; do\n    [ \"$_isoloom_n\" -lt 5 ] || return 1\n    echo \"isoloom: download failed; trying again in $((_isoloom_n * _isoloom_pause)) s ($((_isoloom_n + 1))/5)\"\n    sleep $((_isoloom_n * _isoloom_pause))\n    _isoloom_n=$((_isoloom_n + 1))\n  done\n}\nplay_hosts() {\n  awk -v transient=\"$_isoloom_transient\" '\\''\n    function commit() {\n      if (pending != \"\") { if (pending_real) real[pending] = 1; else cut[pending] = 1 }\n      pending = \"\"\n    }\n    { gsub(/\\033\\[[0-9;]*m/, \"\") }\n    /^\\.\\.\\.ignoring/ { pending = \"\"; next }\n    { commit() }\n    /^(fatal|failed): \\[/ && !/UNREACHABLE!/ {\n      pending = $0\n      sub(/^(fatal|failed): \\[/, \"\", pending)\n      sub(/\\].*/, \"\", pending)\n      sub(/ -> .*/, \"\", pending)\n      pending_real = (tolower($0) !~ transient)\n      next\n    }\n    /^PLAY RECAP/ { recap = 1; next }\n    recap && / : ok=/ {\n      for (i = 2; i <= NF; i++) {\n        split($i, kv, \"=\")\n        if (kv[1] == \"failed\" && kv[2] > 0) failed[$1] = 1\n        if (kv[1] == \"unreachable\" && kv[2] > 0) unreachable[$1] = 1\n      }\n    }\n    END {\n      commit()\n      for (h in failed) print ((h in real || !(h in cut)) ? \"real \" : \"cut \") h\n      for (h in unreachable) if (!(h in failed)) print \"unreachable \" h\n    }\n  '\\'' \"$1\" | sort\n}\n_isoloom_kind() {\n  echo \"$1\" | awk -v k=\"$2\" '\\''$1 == k { printf \"%s%s\", s, $2; s = \" \" }'\\''\n}\nrun_play() {\n  # The playbook is the last argument; Ansible names its retry file after it.\n  for _isoloom_book; do :; done\n  _isoloom_name=$(basename \"$_isoloom_book\")\n  _isoloom_retry=$${ANSIBLE_RETRY_FILES_SAVE_PATH:-/tmp/isoloom-retry}/$${_isoloom_name%.*}.retry\n  _isoloom_limit=\n  _isoloom_log=$(mktemp)\n  _isoloom_rcf=$(mktemp)\n  _isoloom_n=1\n  rm -f \"$_isoloom_retry\"\n  while :; do\n    { \"$@\" $_isoloom_limit && echo 0 > \"$_isoloom_rcf\" || echo $? > \"$_isoloom_rcf\"; } 2>&1 | tee \"$_isoloom_log\"\n    _isoloom_rc=$(cat \"$_isoloom_rcf\")\n    [ \"$_isoloom_rc\" -ne 0 ] || break\n    _isoloom_hosts=$(play_hosts \"$_isoloom_log\")\n    _isoloom_real=$(_isoloom_kind \"$_isoloom_hosts\" real)\n    _isoloom_gone=$(_isoloom_kind \"$_isoloom_hosts\" unreachable)\n    _isoloom_cut=$(_isoloom_kind \"$_isoloom_hosts\" cut)\n    _isoloom_again=$(echo $_isoloom_gone $_isoloom_cut)\n    if [ -n \"$_isoloom_real\" ]; then\n      echo \"isoloom: $_isoloom_name: a task failed on $_isoloom_real: not retried\"\n      break\n    fi\n    if [ -z \"$_isoloom_again\" ]; then\n      echo \"isoloom: $_isoloom_name failed (exit $_isoloom_rc) with no unreachable host or dropped connection: not retried\"\n      break\n    fi\n    if [ \"$_isoloom_n\" -ge \"$_isoloom_attempts\" ]; then\n      echo \"isoloom: $_isoloom_name: still unreachable after $_isoloom_n runs: $_isoloom_again; giving up\"\n      break\n    fi\n    printf '\\''%s\\n'\\'' $_isoloom_again > \"$_isoloom_retry\"\n    _isoloom_limit=\"--limit @$_isoloom_retry\"\n    _isoloom_n=$((_isoloom_n + 1))\n    if [ -n \"$_isoloom_gone\" ]; then\n      _isoloom_wait=$((4 * _isoloom_pause))\n      echo \"isoloom: $_isoloom_name: unreachable: $_isoloom_again; waiting $_isoloom_wait s, then running it again on them ($_isoloom_n/$_isoloom_attempts)\"\n    else\n      _isoloom_wait=$((2 * _isoloom_pause))\n      echo \"isoloom: $_isoloom_name: the play was cut by a dropped connection on $_isoloom_cut; waiting $_isoloom_wait s, then running it again on them ($_isoloom_n/$_isoloom_attempts)\"\n    fi\n    sleep \"$_isoloom_wait\"\n  done\n  rm -f \"$_isoloom_log\" \"$_isoloom_rcf\"\n  [ \"$_isoloom_rc\" -ne 0 ] || rm -f \"$_isoloom_retry\"\n  return \"$_isoloom_rc\"\n}\ncd /opt/isoloom/ansible\nretry_download ansible-galaxy install -r /opt/isoloom/ansible/requirements.yml\nrun_play ansible-playbook -i /etc/isoloom/inventory.ini -i /opt/isoloom/ansible/groups.ini -e '\\''{\"greeting\":\"hello from ansible\",\"tools\":[\"curl\",\"jq\"],\"cache_port\":6379}'\\'' site.yml'",
      "sudo sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'"
    ]
  }
  depends_on = [terraform_data.web, terraform_data.cache]
}

output "machines" {
  value = { web = aws_instance.web.public_ip, cache = aws_instance.cache.public_ip }
}

output "ssh_users" {
  value = { web = "admin", cache = "admin" }
}

output "ip" {
  value = aws_instance.web.public_ip
}

output "ready_file" {
  value = "/var/lib/isoloom/ready"
}

# The checks: each runner on the machine it stands for (ssh <user>@<host> '<command>'), or `isoloom test cloud-vm`.
output "checks" {
  value = [
    {
      position = "networks"
      machine  = "controller"
      host     = aws_eip.isoloom_controller.public_ip
      user     = "admin"
      command  = "cd /opt/isoloom && sh .isoloom/cloud-vm/checks/networks.sh"
    },
    {
      position = "web"
      machine  = "web"
      host     = aws_instance.web.public_ip
      user     = "admin"
      command  = "cd /opt/isoloom && sh .isoloom/cloud-vm/checks/web.sh"
    },
    {
      position = "cache"
      machine  = "cache"
      host     = aws_instance.cache.public_ip
      user     = "admin"
      command  = "cd /opt/isoloom && sh .isoloom/cloud-vm/checks/cache.sh"
    }
  ]
}

# The project's files the machines don't get: version control and the tools' state, and what
# .isoloomignore at the project's root lists (gitignore-style: one pattern per line, `#` comments,
# `!` brings a path back, a trailing `/` matches folders only, a `/` at the start or in the middle
# anchors the pattern at the root; `*`, `?`, `[abc]`, `**`; the last pattern matching a path, or
# a folder it is in, decides). Read as regular expressions, as the Vagrantfiles do.
locals {
  project_ignore_lines = [for l in split("\n", replace(try(file("${local.root}/.isoloomignore"), ""), "\r", "")) : trimspace(l)]
  project_ignore_pats  = [for l in local.project_ignore_lines : { keep = startswith(l, "!"), pat = trimprefix(l, "!") } if l != "" && !startswith(l, "#")]
  project_ignore_globs = [for r in local.project_ignore_pats : merge(r, { glob = trimsuffix(trimsuffix(trimsuffix(r.pat, "/"), "/**"), "/") })]
  project_ignore = [for r in local.project_ignore_globs : {
    keep = r.keep
    re = format(r.glob == r.pat ? "^%s(/|$)" : "^%s/", replace(replace(replace(replace(replace(replace(replace(replace(
      length(split("/", r.glob)) > 1 ? trimprefix(r.glob, "/") : "**/${r.glob}",
    "/[.+^$(){}|\\\\]/", "\\$0"), "[!", "[^"), "**/", "\u0001"), "**", "\u0002"), "*", "[^/]*"), "?", "[^/]"), "\u0001", "(.*/)?"), "\u0002", ".*"))
  } if r.glob != ""]
  # Each file: whether it goes (the last matching pattern decides; none: it goes).
  project_keep    = { for f in fileset(local.root, "**") : f => reverse(concat([true], [for r in local.project_ignore : r.keep if length(regexall(r.re, f)) > 0]))[0] }
  project_paths   = [for f, keep in local.project_keep : f if keep && length(regexall("^\\.isoloom|(^|/)\\.(git|vagrant|terraform)/", f)) == 0]
  project_ignored = [for f, keep in local.project_keep : f if !keep]
}

# What `tar` leaves out of the project's archive: .isoloomignore's files, from the archive's top
# folder, their wildcard characters escaped.
resource "local_file" "isoloom_project" {
  filename = "${path.module}/.isoloom-project-ignored.txt"
  content  = join("", [for f in local.project_ignored : "${replace("${basename(local.root)}/${f}", "/[\\\\*?\\[]/", "\\$0")}\n"])
}

## .isoloom/cloud-vm/azure/main.tf
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  terraform -chdir=.isoloom/cloud-vm/azure init && terraform -chdir=.isoloom/cloud-vm/azure apply \
#           -var allowed_cidr=<your IP>/32 -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)" -var ssh_private_key_file=~/.ssh/id_ed25519
# Stop:   terraform -chdir=.isoloom/cloud-vm/azure destroy (same variables)

terraform {
  required_version = ">= 1.6"
  backend "local" {}
  required_providers {
    azurerm = { source = "hashicorp/azurerm", version = "~> 5.8.0" }
    local   = { source = "hashicorp/local", version = "~> 2.9.1" }
    tls     = { source = "hashicorp/tls", version = "~> 4.4.1" }
  }
}

variable "subscription_id" {
  type        = string
  default     = null
  description = "Default: ARM_SUBSCRIPTION_ID from the environment"
}

variable "region" {
  type    = string
  default = "swedencentral"
}

variable "allowed_cidr" {
  type        = string
  description = "Who may reach the machines (SSH and the published ports), e.g. your IP/32"
}

variable "ssh_public_key" {
  type = string
}

variable "ssh_private_key_file" {
  type        = string
  description = "The private key of ssh_public_key: Terraform sets the machines up over SSH"
}

variable "auto_stop_minutes" {
  type        = number
  default     = 0
  description = "Shut the machines down after this many minutes (0: never)"
}

variable "expires_at" {
  type        = string
  default     = ""
  description = "When the environment should end, in Unix seconds (empty: no end), as a tag on every resource so a reaper can find what to destroy"
}

provider "azurerm" {
  features {}
  subscription_id = var.subscription_id
}

resource "terraform_data" "id" {
  input = substr(replace(uuid(), "-", ""), 0, 8)
  lifecycle {
    ignore_changes = [input]
  }
}

locals {
  name = "isoloom-ansible-pair-${terraform_data.id.output}"
  root = abspath("${path.module}/../../..")
  tags = {
    isoloom-environment = "ansible-pair"
    managed-by          = "isoloom"
    isoloom-instance    = local.name
    isoloom-expires-at  = var.expires_at
  }
}

resource "azurerm_resource_group" "env" {
  name     = local.name
  location = var.region
  tags     = local.tags
}

# The environment's networks: one virtual network, a subnet per network with its exact range.
resource "azurerm_virtual_network" "env" {
  name                = local.name
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  address_space       = ["10.63.0.0/24"]
}

resource "azurerm_subnet" "lab" {
  name                            = "lab"
  resource_group_name             = azurerm_resource_group.env.name
  virtual_network_name            = azurerm_virtual_network.env.name
  address_prefixes                = ["10.63.0.0/24"]
  default_outbound_access_enabled = true
}

# The controller's own key: it runs the playbooks over SSH on every machine.
resource "tls_private_key" "controller" {
  algorithm = "ED25519"
}

# Machine `web`: what may reach it.
resource "azurerm_network_security_group" "web" {
  name                = "${local.name}-web"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  security_rule {
    name                       = "net-lab"
    priority                   = 100
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "10.63.0.0/24"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "ssh"
    priority                   = 110
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_range     = "22"
    source_address_prefix      = var.allowed_cidr
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "outbound"
    priority                   = 100
    direction                  = "Outbound"
    access                     = "Allow"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "*"
    destination_address_prefix = "*"
  }
}

resource "azurerm_public_ip" "web" {
  name                = "${local.name}-web"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  allocation_method   = "Static"
  sku                 = "Standard"
}

resource "azurerm_network_interface" "web_lab" {
  name                = "${local.name}-web-lab"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  ip_configuration {
    name                          = "primary"
    subnet_id                     = azurerm_subnet.lab.id
    private_ip_address_allocation = "Static"
    private_ip_address            = "10.63.0.10"
    public_ip_address_id          = azurerm_public_ip.web.id
  }
}

resource "azurerm_network_interface_security_group_association" "web_lab" {
  network_interface_id      = azurerm_network_interface.web_lab.id
  network_security_group_id = azurerm_network_security_group.web.id
}

resource "azurerm_linux_virtual_machine" "web" {
  name                  = "${local.name}-web"
  resource_group_name   = azurerm_resource_group.env.name
  location              = var.region
  tags                  = local.tags
  size                  = "Standard_B1s"
  admin_username        = "isoloom"
  network_interface_ids = [azurerm_network_interface.web_lab.id]
  custom_data           = var.auto_stop_minutes > 0 ? base64encode("#!/bin/sh\nshutdown -h +${var.auto_stop_minutes}\n") : null
  admin_ssh_key {
    username   = "isoloom"
    public_key = var.ssh_public_key
  }
  os_disk {
    caching              = "ReadWrite"
    storage_account_type = "StandardSSD_LRS"
    disk_size_gb         = 30
  }
  source_image_reference {
    publisher = "Debian"
    offer     = "debian-12"
    sku       = "12-gen2"
    version   = "latest"
  }
}

resource "terraform_data" "web" {
  triggers_replace = [azurerm_linux_virtual_machine.web.id]
  connection {
    type        = "ssh"
    host        = azurerm_public_ip.web.ip_address
    user        = "isoloom"
    private_key = file(pathexpand(var.ssh_private_key_file))
    timeout     = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-web.tgz\" --exclude=.git --exclude=.vagrant --exclude=.terraform --exclude=.isoloom-project* -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-web.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "remote-exec" {
    inline = [
      "set -e",
      "cloud-init status --wait >/dev/null 2>&1 || true",
      "mkdir -p ~/.ssh && echo '${trimspace(tls_private_key.controller.public_key_openssh)}' >> ~/.ssh/authorized_keys",
      "sudo sh -c 'mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz'",
      "sudo sh -c 'for l in '\\''10.63.0.20 cache'\\''; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'",
      "sudo sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'"
    ]
  }
}

# Machine `cache`: what may reach it.
resource "azurerm_network_security_group" "cache" {
  name                = "${local.name}-cache"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  security_rule {
    name                       = "net-lab"
    priority                   = 100
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "10.63.0.0/24"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "ssh"
    priority                   = 110
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_range     = "22"
    source_address_prefix      = var.allowed_cidr
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "outbound"
    priority                   = 100
    direction                  = "Outbound"
    access                     = "Allow"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "*"
    destination_address_prefix = "*"
  }
}

resource "azurerm_public_ip" "cache" {
  name                = "${local.name}-cache"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  allocation_method   = "Static"
  sku                 = "Standard"
}

resource "azurerm_network_interface" "cache_lab" {
  name                = "${local.name}-cache-lab"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  ip_configuration {
    name                          = "primary"
    subnet_id                     = azurerm_subnet.lab.id
    private_ip_address_allocation = "Static"
    private_ip_address            = "10.63.0.20"
    public_ip_address_id          = azurerm_public_ip.cache.id
  }
}

resource "azurerm_network_interface_security_group_association" "cache_lab" {
  network_interface_id      = azurerm_network_interface.cache_lab.id
  network_security_group_id = azurerm_network_security_group.cache.id
}

resource "azurerm_linux_virtual_machine" "cache" {
  name                  = "${local.name}-cache"
  resource_group_name   = azurerm_resource_group.env.name
  location              = var.region
  tags                  = local.tags
  size                  = "Standard_B1s"
  admin_username        = "isoloom"
  network_interface_ids = [azurerm_network_interface.cache_lab.id]
  custom_data           = var.auto_stop_minutes > 0 ? base64encode("#!/bin/sh\nshutdown -h +${var.auto_stop_minutes}\n") : null
  admin_ssh_key {
    username   = "isoloom"
    public_key = var.ssh_public_key
  }
  os_disk {
    caching              = "ReadWrite"
    storage_account_type = "StandardSSD_LRS"
    disk_size_gb         = 30
  }
  source_image_reference {
    publisher = "Debian"
    offer     = "debian-12"
    sku       = "12-gen2"
    version   = "latest"
  }
}

resource "terraform_data" "cache" {
  triggers_replace = [azurerm_linux_virtual_machine.cache.id]
  connection {
    type        = "ssh"
    host        = azurerm_public_ip.cache.ip_address
    user        = "isoloom"
    private_key = file(pathexpand(var.ssh_private_key_file))
    timeout     = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-cache.tgz\" --exclude=.git --exclude=.vagrant --exclude=.terraform --exclude=.isoloom-project* -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-cache.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "remote-exec" {
    inline = [
      "set -e",
      "cloud-init status --wait >/dev/null 2>&1 || true",
      "mkdir -p ~/.ssh && echo '${trimspace(tls_private_key.controller.public_key_openssh)}' >> ~/.ssh/authorized_keys",
      "sudo sh -c 'mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz'",
      "sudo sh -c 'for l in '\\''10.63.0.10 web'\\''; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'",
      "sudo sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'"
    ]
  }
}

# The controller (Ansible): every network may reach it, and SSH from allowed_cidr.
resource "azurerm_network_security_group" "isoloom_controller" {
  name                = "${local.name}-controller"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  security_rule {
    name                       = "net-lab"
    priority                   = 100
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "10.63.0.0/24"
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "ssh"
    priority                   = 110
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_range     = "22"
    source_address_prefix      = var.allowed_cidr
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "outbound"
    priority                   = 100
    direction                  = "Outbound"
    access                     = "Allow"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "*"
    destination_address_prefix = "*"
  }
}

resource "azurerm_public_ip" "isoloom_controller" {
  name                = "${local.name}-controller"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  allocation_method   = "Static"
  sku                 = "Standard"
}

resource "azurerm_network_interface" "isoloom_controller_lab" {
  name                = "${local.name}-controller-lab"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  ip_configuration {
    name                          = "primary"
    subnet_id                     = azurerm_subnet.lab.id
    private_ip_address_allocation = "Static"
    private_ip_address            = "10.63.0.253"
    public_ip_address_id          = azurerm_public_ip.isoloom_controller.id
  }
}

resource "azurerm_network_interface_security_group_association" "isoloom_controller_lab" {
  network_interface_id      = azurerm_network_interface.isoloom_controller_lab.id
  network_security_group_id = azurerm_network_security_group.isoloom_controller.id
}

resource "azurerm_linux_virtual_machine" "isoloom_controller" {
  name                  = "${local.name}-controller"
  resource_group_name   = azurerm_resource_group.env.name
  location              = var.region
  tags                  = local.tags
  size                  = "Standard_B1s"
  admin_username        = "isoloom"
  network_interface_ids = [azurerm_network_interface.isoloom_controller_lab.id]
  custom_data           = var.auto_stop_minutes > 0 ? base64encode("#!/bin/sh\nshutdown -h +${var.auto_stop_minutes}\n") : null
  admin_ssh_key {
    username   = "isoloom"
    public_key = var.ssh_public_key
  }
  os_disk {
    caching              = "ReadWrite"
    storage_account_type = "StandardSSD_LRS"
    disk_size_gb         = 30
  }
  source_image_reference {
    publisher = "Debian"
    offer     = "debian-12"
    sku       = "12-gen2"
    version   = "latest"
  }
}

resource "terraform_data" "isoloom_controller" {
  triggers_replace = [azurerm_linux_virtual_machine.isoloom_controller.id]
  connection {
    type        = "ssh"
    host        = azurerm_public_ip.isoloom_controller.ip_address
    user        = "isoloom"
    private_key = file(pathexpand(var.ssh_private_key_file))
    timeout     = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-controller.tgz\" --exclude=.git --exclude=.vagrant --exclude=.terraform --exclude=.isoloom-project* -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-controller.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "file" {
    content     = tls_private_key.controller.private_key_openssh
    destination = "/tmp/isoloom-controller-key"
  }
  provisioner "file" {
    content     = "[linux]\nweb ansible_host=10.63.0.10 ansible_user=isoloom\ncache ansible_host=10.63.0.20 ansible_user=isoloom maxmemory='\"64mb\"'\n\n[windows]\n\n[linux:vars]\nansible_ssh_private_key_file=/etc/isoloom/id_ed25519\nansible_become=true\n\n[webservers]\nweb\n\n[caches]\ncache\n\n[pair]\nweb\ncache\n"
    destination = "/tmp/isoloom-inventory.ini"
  }
  provisioner "remote-exec" {
    inline = [
      "set -e",
      "cloud-init status --wait >/dev/null 2>&1 || true",
      "sudo sh -c 'mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz'",
      "sudo sh -c 'printf '\\''%s\\n'\\'' '\\''10.63.0.10 web'\\'' '\\''10.63.0.20 cache'\\'' >> /etc/hosts'",
      "sudo sh -c 'mkdir -p /etc/isoloom && install -m 0600 /tmp/isoloom-controller-key /etc/isoloom/id_ed25519 && install -m 0644 /tmp/isoloom-inventory.ini /etc/isoloom/inventory.ini && rm -f /tmp/isoloom-controller-key /tmp/isoloom-inventory.ini'",
      "sudo sh -c 'DEBIAN_FRONTEND=noninteractive apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq python3-venv curl netcat-openbsd >/dev/null'",
      "sudo sh -c '[ -x /opt/ansible/bin/ansible-playbook ] || { python3 -m venv /opt/ansible && /opt/ansible/bin/pip install -q '\\''ansible-core>=2.15,<2.17'\\'' pywinrm; }'",
      "sudo sh -c 'set -e\nmkdir -p /tmp/isoloom-facts\nexport PATH=/opt/ansible/bin:$PATH ANSIBLE_HOST_KEY_CHECKING=False ANSIBLE_GATHERING=smart ANSIBLE_FORKS=20 ANSIBLE_PIPELINING=True ANSIBLE_CACHE_PLUGIN=jsonfile ANSIBLE_CACHE_PLUGIN_CONNECTION=/tmp/isoloom-facts ANSIBLE_CACHE_PLUGIN_TIMEOUT=7200\nmkdir -p /tmp/isoloom-retry\nexport ANSIBLE_RETRY_FILES_ENABLED=True ANSIBLE_RETRY_FILES_SAVE_PATH=/tmp/isoloom-retry\n_isoloom_pause=$${ISOLOOM_RETRY_PAUSE:-15}\n_isoloom_attempts=4\n_isoloom_transient='\\''send_input failed|the pipe has been ended|winrmtransporterror|winrmoperationtimeouterror|read timeout|bad http response returned from server|(kerberos|ntlm|credssp).*500|remote end closed connection|connection reset by peer|connection refused|connection aborted|broken pipe|timed out|failed to connect to the host via ssh|shared connection to .* closed'\\''\nretry_download() {\n  _isoloom_n=1\n  until \"$@\"; do\n    [ \"$_isoloom_n\" -lt 5 ] || return 1\n    echo \"isoloom: download failed; trying again in $((_isoloom_n * _isoloom_pause)) s ($((_isoloom_n + 1))/5)\"\n    sleep $((_isoloom_n * _isoloom_pause))\n    _isoloom_n=$((_isoloom_n + 1))\n  done\n}\nplay_hosts() {\n  awk -v transient=\"$_isoloom_transient\" '\\''\n    function commit() {\n      if (pending != \"\") { if (pending_real) real[pending] = 1; else cut[pending] = 1 }\n      pending = \"\"\n    }\n    { gsub(/\\033\\[[0-9;]*m/, \"\") }\n    /^\\.\\.\\.ignoring/ { pending = \"\"; next }\n    { commit() }\n    /^(fatal|failed): \\[/ && !/UNREACHABLE!/ {\n      pending = $0\n      sub(/^(fatal|failed): \\[/, \"\", pending)\n      sub(/\\].*/, \"\", pending)\n      sub(/ -> .*/, \"\", pending)\n      pending_real = (tolower($0) !~ transient)\n      next\n    }\n    /^PLAY RECAP/ { recap = 1; next }\n    recap && / : ok=/ {\n      for (i = 2; i <= NF; i++) {\n        split($i, kv, \"=\")\n        if (kv[1] == \"failed\" && kv[2] > 0) failed[$1] = 1\n        if (kv[1] == \"unreachable\" && kv[2] > 0) unreachable[$1] = 1\n      }\n    }\n    END {\n      commit()\n      for (h in failed) print ((h in real || !(h in cut)) ? \"real \" : \"cut \") h\n      for (h in unreachable) if (!(h in failed)) print \"unreachable \" h\n    }\n  '\\'' \"$1\" | sort\n}\n_isoloom_kind() {\n  echo \"$1\" | awk -v k=\"$2\" '\\''$1 == k { printf \"%s%s\", s, $2; s = \" \" }'\\''\n}\nrun_play() {\n  # The playbook is the last argument; Ansible names its retry file after it.\n  for _isoloom_book; do :; done\n  _isoloom_name=$(basename \"$_isoloom_book\")\n  _isoloom_retry=$${ANSIBLE_RETRY_FILES_SAVE_PATH:-/tmp/isoloom-retry}/$${_isoloom_name%.*}.retry\n  _isoloom_limit=\n  _isoloom_log=$(mktemp)\n  _isoloom_rcf=$(mktemp)\n  _isoloom_n=1\n  rm -f \"$_isoloom_retry\"\n  while :; do\n    { \"$@\" $_isoloom_limit && echo 0 > \"$_isoloom_rcf\" || echo $? > \"$_isoloom_rcf\"; } 2>&1 | tee \"$_isoloom_log\"\n    _isoloom_rc=$(cat \"$_isoloom_rcf\")\n    [ \"$_isoloom_rc\" -ne 0 ] || break\n    _isoloom_hosts=$(play_hosts \"$_isoloom_log\")\n    _isoloom_real=$(_isoloom_kind \"$_isoloom_hosts\" real)\n    _isoloom_gone=$(_isoloom_kind \"$_isoloom_hosts\" unreachable)\n    _isoloom_cut=$(_isoloom_kind \"$_isoloom_hosts\" cut)\n    _isoloom_again=$(echo $_isoloom_gone $_isoloom_cut)\n    if [ -n \"$_isoloom_real\" ]; then\n      echo \"isoloom: $_isoloom_name: a task failed on $_isoloom_real: not retried\"\n      break\n    fi\n    if [ -z \"$_isoloom_again\" ]; then\n      echo \"isoloom: $_isoloom_name failed (exit $_isoloom_rc) with no unreachable host or dropped connection: not retried\"\n      break\n    fi\n    if [ \"$_isoloom_n\" -ge \"$_isoloom_attempts\" ]; then\n      echo \"isoloom: $_isoloom_name: still unreachable after $_isoloom_n runs: $_isoloom_again; giving up\"\n      break\n    fi\n    printf '\\''%s\\n'\\'' $_isoloom_again > \"$_isoloom_retry\"\n    _isoloom_limit=\"--limit @$_isoloom_retry\"\n    _isoloom_n=$((_isoloom_n + 1))\n    if [ -n \"$_isoloom_gone\" ]; then\n      _isoloom_wait=$((4 * _isoloom_pause))\n      echo \"isoloom: $_isoloom_name: unreachable: $_isoloom_again; waiting $_isoloom_wait s, then running it again on them ($_isoloom_n/$_isoloom_attempts)\"\n    else\n      _isoloom_wait=$((2 * _isoloom_pause))\n      echo \"isoloom: $_isoloom_name: the play was cut by a dropped connection on $_isoloom_cut; waiting $_isoloom_wait s, then running it again on them ($_isoloom_n/$_isoloom_attempts)\"\n    fi\n    sleep \"$_isoloom_wait\"\n  done\n  rm -f \"$_isoloom_log\" \"$_isoloom_rcf\"\n  [ \"$_isoloom_rc\" -ne 0 ] || rm -f \"$_isoloom_retry\"\n  return \"$_isoloom_rc\"\n}\ncd /opt/isoloom/ansible\nretry_download ansible-galaxy install -r /opt/isoloom/ansible/requirements.yml\nrun_play ansible-playbook -i /etc/isoloom/inventory.ini -i /opt/isoloom/ansible/groups.ini -e '\\''{\"greeting\":\"hello from ansible\",\"tools\":[\"curl\",\"jq\"],\"cache_port\":6379}'\\'' site.yml'",
      "sudo sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'"
    ]
  }
  depends_on = [terraform_data.web, terraform_data.cache]
}

output "machines" {
  value = { web = azurerm_public_ip.web.ip_address, cache = azurerm_public_ip.cache.ip_address }
}

output "ssh_users" {
  value = { web = "isoloom", cache = "isoloom" }
}

output "ip" {
  value = azurerm_public_ip.web.ip_address
}

output "ready_file" {
  value = "/var/lib/isoloom/ready"
}

# The checks: each runner on the machine it stands for (ssh <user>@<host> '<command>'), or `isoloom test cloud-vm`.
output "checks" {
  value = [
    {
      position = "networks"
      machine  = "controller"
      host     = azurerm_public_ip.isoloom_controller.ip_address
      user     = "isoloom"
      command  = "cd /opt/isoloom && sh .isoloom/cloud-vm/checks/networks.sh"
    },
    {
      position = "web"
      machine  = "web"
      host     = azurerm_public_ip.web.ip_address
      user     = "isoloom"
      command  = "cd /opt/isoloom && sh .isoloom/cloud-vm/checks/web.sh"
    },
    {
      position = "cache"
      machine  = "cache"
      host     = azurerm_public_ip.cache.ip_address
      user     = "isoloom"
      command  = "cd /opt/isoloom && sh .isoloom/cloud-vm/checks/cache.sh"
    }
  ]
}

# The project's files the machines don't get: version control and the tools' state, and what
# .isoloomignore at the project's root lists (gitignore-style: one pattern per line, `#` comments,
# `!` brings a path back, a trailing `/` matches folders only, a `/` at the start or in the middle
# anchors the pattern at the root; `*`, `?`, `[abc]`, `**`; the last pattern matching a path, or
# a folder it is in, decides). Read as regular expressions, as the Vagrantfiles do.
locals {
  project_ignore_lines = [for l in split("\n", replace(try(file("${local.root}/.isoloomignore"), ""), "\r", "")) : trimspace(l)]
  project_ignore_pats  = [for l in local.project_ignore_lines : { keep = startswith(l, "!"), pat = trimprefix(l, "!") } if l != "" && !startswith(l, "#")]
  project_ignore_globs = [for r in local.project_ignore_pats : merge(r, { glob = trimsuffix(trimsuffix(trimsuffix(r.pat, "/"), "/**"), "/") })]
  project_ignore = [for r in local.project_ignore_globs : {
    keep = r.keep
    re = format(r.glob == r.pat ? "^%s(/|$)" : "^%s/", replace(replace(replace(replace(replace(replace(replace(replace(
      length(split("/", r.glob)) > 1 ? trimprefix(r.glob, "/") : "**/${r.glob}",
    "/[.+^$(){}|\\\\]/", "\\$0"), "[!", "[^"), "**/", "\u0001"), "**", "\u0002"), "*", "[^/]*"), "?", "[^/]"), "\u0001", "(.*/)?"), "\u0002", ".*"))
  } if r.glob != ""]
  # Each file: whether it goes (the last matching pattern decides; none: it goes).
  project_keep    = { for f in fileset(local.root, "**") : f => reverse(concat([true], [for r in local.project_ignore : r.keep if length(regexall(r.re, f)) > 0]))[0] }
  project_paths   = [for f, keep in local.project_keep : f if keep && length(regexall("^\\.isoloom|(^|/)\\.(git|vagrant|terraform)/", f)) == 0]
  project_ignored = [for f, keep in local.project_keep : f if !keep]
}

# What `tar` leaves out of the project's archive: .isoloomignore's files, from the archive's top
# folder, their wildcard characters escaped.
resource "local_file" "isoloom_project" {
  filename = "${path.module}/.isoloom-project-ignored.txt"
  content  = join("", [for f in local.project_ignored : "${replace("${basename(local.root)}/${f}", "/[\\\\*?\\[]/", "\\$0")}\n"])
}

## .isoloom/cloud-vm/checks/cache.sh
#!/bin/sh
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# The environment's checks, from cache. `isoloom test` runs it and reads the PASS/FAIL lines.
passed=0; failed=0
pass() { passed=$((passed+1)); echo "isoloom-check: PASS $1"; }
fail() { failed=$((failed+1)); echo "isoloom-check: FAIL $1: $2"; }
# _http URL [follow] -> the status code, 000 when nothing answers (curl, else wget, else bash):
# the first answer's, or with `follow` the last one's after at most 5 redirects (bash: the first).
_http() {
  if command -v curl >/dev/null 2>&1; then
    if [ -n "$2" ]; then set -- "$1" -L --max-redirs 5; else set -- "$1"; fi
    c=$(curl -sk -o /dev/null -m 5 -w '%{http_code}' "$@" 2>/dev/null)
  elif command -v wget >/dev/null 2>&1; then
    # wget follows redirects whatever it's told (busybox's can't be told): -S prints each answer.
    if [ -n "$2" ]; then _n=6; else _n=1; fi
    c=$(wget -q -S -O /dev/null -T 5 --no-check-certificate "$1" 2>&1 | sed -n 's/^ *HTTP\/[0-9.]* \([0-9][0-9][0-9]\).*/\1/p' | head -n $_n | tail -n 1)
  else
    u=${1#*://}; hp=${u%%/*}; p=/${u#*/}; [ "$u" = "$hp" ] && p=/
    h=${hp%%:*}; port=${hp#*:}; [ "$hp" = "$h" ] && port=80
    c=$(H=$h P=$port U=$p timeout 5 bash -c 'exec 3<>/dev/tcp/$H/$P && printf "GET %s HTTP/1.0\r\nHost: %s\r\n\r\n" "$U" "$H" >&3 && read -r l <&3 && echo "$l"' 2>/dev/null | sed -n 's/^HTTP\/[0-9.]* \([0-9][0-9][0-9]\).*/\1/p')
  fi
  echo "${c:-000}"
}
_http_is() { [ "$(_http "$1" "$3")" = "$2" ]; }
# _req STATUS|any TEXT CURL-ARGS... -> 0 when the request gets that status (any answer for `any`)
# and its body contains TEXT (if any); $out says why not. Needs curl.
_req() {
  want=$1; text=$2; shift 2
  command -v curl >/dev/null 2>&1 || { out="curl is needed for this check"; return 1; }
  b=$(mktemp); c=$(curl -sk -m 10 -o "$b" -w '%{http_code}' "$@" 2>/dev/null); c=${c:-000}; r=0
  if [ "$want" = any ]; then [ "$c" != 000 ] || r=1; else [ "$c" = "$want" ] || r=1; fi
  if [ $r = 1 ]; then out="expected HTTP $want, got $c"
  elif [ -n "$text" ] && ! grep -qF -- "$text" "$b"; then r=1; out="HTTP $c, but the response doesn't contain the expected text"
  fi
  rm -f "$b"; return $r
}
_http_any() { [ "$(_http "$1" "$2")" != 000 ]; }
# _tcp HOST PORT -> 0 when it connects (nc, else bash).
_tcp() {
  if command -v nc >/dev/null 2>&1; then nc -z -w 5 "$1" "$2" >/dev/null 2>&1
  else H=$1 P=$2 timeout 5 bash -c 'exec 3<>/dev/tcp/$H/$P' >/dev/null 2>&1
  fi
}
# _tcp_read HOST PORT LINE TEXT -> 0 when the bytes read within 5s of connecting (after writing
# LINE and a newline, if any) contain TEXT; $out says why not (nc, else bash). Stdin stays open
# while reading (some nc quit at its end), and nc is stopped after 5s whatever its flavor.
_tcp_read() {
  f=$(mktemp); i=0; r=1
  if command -v nc >/dev/null 2>&1; then
    { [ -z "$3" ] || printf '%s\n' "$3"; j=0; while [ ! -e "$f.end" ] && [ $j -lt 6 ]; do sleep 1; j=$((j+1)); done; } | nc "$1" "$2" >"$f" 2>/dev/null &
  else
    H=$1 P=$2 L=$3 timeout 6 bash -c 'exec 3<>/dev/tcp/$H/$P || exit 1; [ -z "$L" ] || printf "%s\n" "$L" >&3; cat <&3' >"$f" 2>/dev/null &
  fi
  p=$!
  while :; do
    if grep -qF -- "$4" "$f"; then r=0; break; fi
    [ $i -lt 5 ] && kill -0 $p 2>/dev/null || break
    sleep 1; i=$((i+1))
  done
  [ $r = 0 ] || ! grep -qF -- "$4" "$f" || r=0
  touch "$f.end"; kill $p 2>/dev/null
  if [ $r = 1 ]; then
    if [ -s "$f" ]; then out="$1:$2 answered \"$(head -c 100 "$f" | tr -d '\000\r' | tr '\n\t' '  ')\", without the expected text"
    elif [ $i -lt 5 ]; then out="$1:$2 refused the connection or closed it without a word"
    else out="nothing read from $1:$2 within 5s"; fi
  fi
  rm -f "$f" "$f.end"; return $r
}
# _exec COMMAND TEXT -> 0 when the command succeeds and its output contains TEXT (if any).
_exec() { out=$(sh -c "$1" 2>&1) && { [ -z "$2" ] || printf '%s\n' "$out" | grep -qF -- "$2"; }; }
# _retry SECONDS COMMAND... -> keeps trying every 2s until it passes or the time is up.
_retry() { _end=$(( $(date +%s) + $1 )); shift; while ! "$@"; do [ "$(date +%s)" -lt "$_end" ] || return 1; sleep 2; done; }

if [ "${ISOLOOM_DERIVED:-1}" != 0 ]; then
if _retry 30 _http_any 'http://10.63.0.10:80/'; then pass 'web:80 from cache'; else fail 'web:80 from cache' "nothing answers at http://10.63.0.10:80/"; fi
fi

echo "isoloom-check: END $passed passed, $failed failed"
[ "$failed" -eq 0 ]

