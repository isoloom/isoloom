c=$(_http 'http://1.1.1.1/'); if [ "$c" = 000 ]; then pass 'no internet from staff'; else fail 'no internet from staff' "http://1.1.1.1/ answered (HTTP $c); it should be blocked"; fi
fi

echo "isoloom-check: END $passed passed, $failed failed"
[ "$failed" -eq 0 ]

## .isoloom/vagrant/run.json
{
  "$schema": "https://www.isoloom.com/schema/run-manifest/v0.json",
  "manifest_version": 0,
  "generator": {
    "name": "isoloom",
    "version": "0.10.1"
  },
  "lab": {
    "name": "vlan-office",
    "instance": null,
    "message": null
  },
  "target": "vagrant",
  "driver": "vagrant",
  "hosts": [
    "linux",
    "macos",
    "windows"
  ],
  "tools": [
    {
      "name": "vagrant",
      "probe": [
        "vagrant",
        "--version"
      ],
      "min_version": "2.4.0"
    },
    {
      "name": "virtualbox",
      "probe": [
        "VBoxManage",
        "--version"
      ],
      "providers": [
        "virtualbox"
      ]
    },
    {
      "name": "vmware",
      "probe": [
        "vmrun",
        "list"
      ],
      "providers": [
        "vmware_desktop"
      ]
    },
    {
      "name": "parallels",
      "probe": [
        "prlctl",
        "--version"
      ],
      "hosts": [
        "macos"
      ],
      "providers": [
        "parallels"
      ]
    },
    {
      "name": "libvirt",
      "probe": [
        "virsh",
        "--version"
      ],
      "hosts": [
        "linux"
      ],
      "providers": [
        "libvirt"
      ]
    },
    {
      "name": "qemu",
      "probe": [
        "qemu-img",
        "--version"
      ],
      "providers": [
        "qemu"
      ]
    }
  ],
  "identity": {
    "vagrant": {
      "providers": [
        {
          "id": "virtualbox",
          "hosts": [
            "linux",
            "macos",
            "windows"
          ],
          "elevation": "none",
          "refusal": null
        },
        {
          "id": "vmware_desktop",
          "hosts": [
            "linux",
            "macos",
            "windows"
          ],
          "plugin": "vagrant-vmware-desktop",
          "elevation": "none",
          "refusal": null
        },
        {
          "id": "hyperv",
          "hosts": [
            "windows"
          ],
          "elevation": "hyperv",
          "refusal": null
        },
        {
          "id": "parallels",
          "hosts": [
            "macos"
          ],
          "plugin": "vagrant-parallels",
          "elevation": "none",
          "refusal": null
        },
        {
          "id": "libvirt",
          "hosts": [
            "linux"
          ],
          "plugin": "vagrant-libvirt",
          "elevation": "none",
          "refusal": null
        },
        {
          "id": "qemu",
          "hosts": [
            "linux",
            "macos"
          ],
          "plugin": "vagrant-qemu",
          "elevation": "none",
          "refusal": "`isoloom-router` is on 3 networks, and QEMU gives a VM one"
        },
        {
          "id": "utm",
          "hosts": [
            "macos"
          ],
          "plugin": "vagrant_utm",
          "elevation": "none",
          "refusal": "`isoloom-router` is on a network, and vagrant_utm gives a VM no private network (it only forwards ports)"
        },
        {
          "id": "vmware_esxi",
          "hosts": [
            "linux",
            "macos",
            "windows"
          ],
          "plugin": "vagrant-vmware-esxi",
          "elevation": "none",
          "remote": true,
          "refusal": null
        }
      ],
      "dotfile": "${run.state_dir}/vagrant"
    }
  },
  "params": [
    {
      "name": "ISOLOOM_HYPERV_SWITCH",
      "description": "The Hyper-V virtual switch each VM's first adapter (Vagrant's connection, and the internet) goes on.",
      "default": "Default Switch",
      "hosts": [
        "windows"
      ],
      "providers": [
        "hyperv"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_HYPERV_SWITCH",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "ISOLOOM_SSH_PROXY_COMMAND",
      "description": "The command Vagrant's SSH to the VMs goes through when this host can't reach them directly (an ESXi host through the runner's relay on macOS).",
      "providers": [
        "vmware_esxi"
      ],
      "set_by": "runner",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_SSH_PROXY_COMMAND",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "ESXI_HOSTNAME",
      "description": "The ESXi host.",
      "required": true,
      "providers": [
        "vmware_esxi"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ESXI_HOSTNAME",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "ESXI_HOSTPORT",
      "description": "Its SSH port.",
      "default": "22",
      "providers": [
        "vmware_esxi"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ESXI_HOSTPORT",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "ESXI_USERNAME",
      "description": "The ESXi user.",
      "default": "root",
      "providers": [
        "vmware_esxi"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ESXI_USERNAME",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "ESXI_DATASTORE",
      "description": "The datastore the VMs' disks go on (default: ESXi's first).",
      "providers": [
        "vmware_esxi"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ESXI_DATASTORE",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "ESXI_VIRTUAL_NETWORK",
      "description": "Port groups, comma-separated: the management network, then one per lab network.",
      "default": "VM Network",
      "providers": [
        "vmware_esxi"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ESXI_VIRTUAL_NETWORK",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "ISOLOOM_DERIVED",
      "description": "0: the checks derived from the spec (reachability, no internet) are skipped.",
      "default": "1",
      "values": [
        "0",
        "1"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_DERIVED",
          "steps": [
            "check-intranet",
            "check-staff",
            "check-guest",
            "check-admin"
          ]
        }
      ]
    }
  ],
  "secrets": [
    {
      "name": "ESXI_PASSWORD",
      "kind": "connection",
      "required": true,
      "sensitive": true,
      "providers": [
        "vmware_esxi"
      ],
      "deliver": [
        {
          "via": "env",
          "var": "ESXI_PASSWORD",
          "steps": [
            "*"
          ]
        }
      ]
    }
  ],
  "networks": [
    {
      "name": "office-vlan10",
      "cidr": "10.70.10.0/24",
      "internet": false,
      "native": "isoloom-vlan-office-office-vlan10"
    },
    {
      "name": "office-vlan20",
      "cidr": "10.70.20.0/24",
      "internet": true,
      "native": "isoloom-vlan-office-office-vlan20"
    },
    {
      "name": "servers",
      "cidr": "10.70.99.0/24",
      "internet": false,
      "native": "isoloom-vlan-office-servers"
    }
  ],
  "machines": [
    {
      "name": "isoloom-router",
      "role": "infra",
      "resources": {
        "cpus": 1,
        "memory_mb": 512
      },
      "addresses": {
        "office-vlan10": "10.70.10.254",
        "office-vlan20": "10.70.20.254",
        "servers": "10.70.99.254"
      },
      "native": {
        "vagrant": "isoloom-router",
        "vm_names": {
          "virtualbox": "vlan-office · router",
          "vmware_desktop": "vlan-office · router",
          "hyperv": "vlan-office-router",
          "parallels": "vlan-office · router",
          "libvirt": "vlan-office_isoloom-router",
          "utm": "vlan-office · router",
          "vmware_esxi": "vlan-office-router"
        }
      }
    },
    {
      "name": "intranet",
      "role": "target",
      "os": "debian-12",
      "arch": "amd64",
      "resources": {
        "cpus": 1,
        "memory_mb": 1024
      },
      "addresses": {
        "servers": "10.70.99.10"
      },
      "native": {
        "vagrant": "intranet",
        "vm_names": {
          "virtualbox": "vlan-office · intranet",
          "vmware_desktop": "vlan-office · intranet",
          "hyperv": "vlan-office-intranet",
          "parallels": "vlan-office · intranet",
          "libvirt": "vlan-office_intranet",
          "utm": "vlan-office · intranet",
          "vmware_esxi": "vlan-office-intranet"
        }
      },
      "ports": [
        {
          "name": "web",
          "port": 80,
          "protocol": "tcp",
          "http": true
        }
      ]
    },
    {
      "name": "staff",
      "role": "access",
      "os": "debian-12",
      "arch": "amd64",
      "resources": {
        "cpus": 1,
        "memory_mb": 1024
      },
      "addresses": {
        "office-vlan10": "10.70.10.10"
      },
      "native": {
        "vagrant": "staff",
        "vm_names": {
          "virtualbox": "vlan-office · staff",
          "vmware_desktop": "vlan-office · staff",
          "hyperv": "vlan-office-staff",
          "parallels": "vlan-office · staff",
          "libvirt": "vlan-office_staff",
          "utm": "vlan-office · staff",
          "vmware_esxi": "vlan-office-staff"
        }
      }
    },
    {
      "name": "guest",
      "role": "target",
      "os": "debian-12",
      "arch": "amd64",
      "resources": {
        "cpus": 1,
        "memory_mb": 1024
      },
      "addresses": {
        "office-vlan20": "10.70.20.10"
      },
      "native": {
        "vagrant": "guest",
        "vm_names": {
          "virtualbox": "vlan-office · guest",
          "vmware_desktop": "vlan-office · guest",
          "hyperv": "vlan-office-guest",
          "parallels": "vlan-office · guest",
          "libvirt": "vlan-office_guest",
          "utm": "vlan-office · guest",
          "vmware_esxi": "vlan-office-guest"
        }
      }
    },
    {
      "name": "admin",
      "role": "target",
      "os": "debian-12",
      "arch": "amd64",
      "resources": {
        "cpus": 1,
        "memory_mb": 1024
      },
      "addresses": {
        "office-vlan10": "10.70.10.50",
        "office-vlan20": "10.70.20.50"
      },
      "native": {
        "vagrant": "admin",
        "vm_names": {
          "virtualbox": "vlan-office · admin",
          "vmware_desktop": "vlan-office · admin",
          "hyperv": "vlan-office-admin",
          "parallels": "vlan-office · admin",
          "libvirt": "vlan-office_admin",
          "utm": "vlan-office · admin",
          "vmware_esxi": "vlan-office-admin"
        }
      }
    }
  ],
  "lifecycle": {
    "up": [
      {
        "id": "reconcile",
        "note": "Clearing the state of a run on another provider, if any…",
        "action": "vagrant.reconcile_provider"
      },
      {
        "id": "discard-saved",
        "action": "vagrant.discard_aborted_saved",
        "failure": "tolerate",
        "providers": [
          "virtualbox"
        ]
      },
      {
        "id": "up",
        "note": "Building the lab's VMs (Windows machines take a while)…",
        "argv": [
          "vagrant",
          "up",
          "--provider",
          "${run.provider}"
        ],
        "timeout_s": 21600
      }
    ],
    "down": [
      {
        "id": "destroy",
        "argv": [
          "vagrant",
          "destroy",
          "--force"
        ],
        "timeout_s": 1800,
        "when": "always"
      },
      {
        "id": "orphans",
        "action": "vagrant.remove_orphans",
        "when": "always",
        "failure": "tolerate",
        "providers": [
          "virtualbox",
          "parallels"
        ]
      },
      {
        "id": "reset",
        "action": "vagrant.reset_state"
      }
    ],
    "park": {
      "pause": [
        {
          "id": "suspend",
          "argv": [
            "vagrant",
            "suspend"
          ],
          "timeout_s": 1800
        }
      ],
      "shutdown": [
        {
          "id": "halt",
          "argv": [
            "vagrant",
            "halt"
          ],
          "timeout_s": 1800
        }
      ]
    },
    "resume": [
      {
        "id": "discard-saved",
        "action": "vagrant.discard_aborted_saved",
        "failure": "tolerate",
        "providers": [
          "virtualbox"
        ]
      },
      {
        "id": "resume",
        "argv": [
          "vagrant",
          "up",
          "--no-provision",
          "--provider",
          "${run.provider}",
          "isoloom-router",
          "intranet",
          "staff",
          "guest",
          "admin"
        ],
        "timeout_s": 3600,
        "failure": "tolerate"
      },
      {
        "id": "discard-cut-off",
        "action": "vagrant.discard_aborted_saved",
        "failure": "tolerate",
        "providers": [
          "virtualbox"
        ]
      },
      {
        "id": "boot",
        "argv": [
          "vagrant",
          "up",
          "--no-provision",
          "--provider",
          "${run.provider}",
          "isoloom-router",
          "intranet",
          "staff",
          "guest",
          "admin"
        ],
        "timeout_s": 3600
      }
    ],
    "provision": {
      "all": [
        {
          "id": "provision",
          "argv": [
            "vagrant",
            "provision",
            "isoloom-router",
            "intranet",
            "staff",
            "guest",
            "admin"
          ],
          "timeout_s": 7200
        }
      ],
      "machine": [
        {
          "id": "provision-machine",
          "argv": [
            "vagrant",
            "provision",
            "${machine}"
          ],
          "timeout_s": 7200
        }
      ]
    },
    "status": {
      "id": "status",
      "argv": [
        "vagrant",
        "status",
        "--machine-readable"
      ],
      "timeout_s": 25,
      "provider_timeout_s": {
        "vmware_esxi": 210
      }
    }
  },
  "ready": [
    {
      "kind": "step_ok",
      "step": "up",
      "means": "every VM booted and ran its provisioners, the controller's playbooks included"
    },
    {
      "kind": "machines_running",
      "machines": [
        "intranet",
        "staff",
        "guest",
        "admin"
      ]
    }
  ],
  "outputs": [],
  "checks": {
    "protocol": "isoloom-check/1",
    "setup": [],
    "runners": [
      {
        "id": "intranet",
        "from": "from intranet",
        "checks": [
          {
            "name": "no internet from intranet",
            "kind": "http",
            "wait_s": 0,
            "derived": true
          }
        ],
        "step": {
          "id": "check-intranet",
          "argv": [
            "vagrant",
            "provision",
            "intranet",
            "--provision-with",
            "checks"
          ],
          "timeout_s": 75
        }
      },
      {
        "id": "staff",
        "from": "from staff",
        "checks": [
          {
            "name": "staff reach the intranet",
            "kind": "http",
            "wait_s": 60,
            "derived": false
          },
          {
            "name": "intranet:80 from staff",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "no internet from staff",
            "kind": "http",
            "wait_s": 0,
            "derived": true
          }
        ],
        "step": {
          "id": "check-staff",
          "argv": [
            "vagrant",
            "provision",
            "staff",
            "--provision-with",
            "checks"
          ],
          "timeout_s": 195
        }
      },
      {
        "id": "guest",
        "from": "from guest",
        "checks": [
          {
            "name": "guests don't",
            "kind": "tcp",
            "wait_s": 0,
            "derived": false
          },
          {
            "name": "intranet:80 blocked from guest",
            "kind": "tcp",
            "wait_s": 0,
            "derived": true
          }
        ],
        "step": {
          "id": "check-guest",
          "argv": [
            "vagrant",
            "provision",
            "guest",
            "--provision-with",
            "checks"
          ],
          "timeout_s": 90
        }
      },
      {
        "id": "admin",
        "from": "from admin",
        "checks": [
          {
            "name": "the admin box reaches the intranet over its trunk",
            "kind": "http",
            "wait_s": 60,
            "derived": false
          },
          {
            "name": "intranet:80 from admin",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          }
        ],
        "step": {
          "id": "check-admin",
          "argv": [
            "vagrant",
            "provision",
            "admin",
            "--provision-with",
            "checks"
          ],
          "timeout_s": 180
        }
      }
    ],
    "teardown": []
  },
  "recovery": {
    "stale_markers": [
      "verr_already_exists",
      "could not rename",
      "is locked",
      "different provider",
      "single provider at a time"
    ],
    "steps": [
      {
        "id": "destroy",
        "note": "Clearing what an earlier run left, then starting again…",
        "argv": [
          "vagrant",
          "destroy",
          "--force"
        ],
        "timeout_s": 180,
        "when": "always",
        "failure": "tolerate"
      },
      {
        "id": "orphans",
        "action": "vagrant.remove_orphans",
        "when": "always",
        "failure": "tolerate",
        "providers": [
          "virtualbox",
          "parallels"
        ]
      },
      {
        "id": "reset",
        "action": "vagrant.reset_state",
        "when": "always"
      }
    ],
    "retries": 1
  }
}
