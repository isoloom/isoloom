---
source: crates/backends/isoloom-compose/tests/snapshots.rs
expression: rendered
---
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  docker compose -f .isoloom/docker/compose.yml up -d --wait
# Checks: isothrum check . (or: docker compose -f .isoloom/docker/compose.yml --profile check run --rm isoloom-check, and isoloom-check-<machine>)
# Stop:   docker compose -f .isoloom/docker/compose.yml down -v

name: build-and-image
services:
  web:
    build:
      context: ../../build/web
      labels:
        isoloom.managed: 'true'
        isoloom.environment: build-and-image
    image: ghcr.io/cyberctf/ad-kerberoasting:1
    platform: linux/amd64
    hostname: web
    networks:
      lan:
        ipv4_address: 10.9.0.10
    volumes:
    - isoloom-probe-amd64:/.isoloom-probe:ro
    healthcheck:
      test:
      - CMD
      - /.isoloom-probe/busybox
      - sh
      - -c
      - /.isoloom-probe/busybox nc -z -w 2 127.0.0.1 8000
      interval: 5s
      timeout: 3s
      retries: 60
      start_period: 10s
    depends_on:
      isoloom-probe-amd64:
        condition: service_completed_successfully
    labels:
      isoloom.port.site: tcp:8000
      isoloom.managed: 'true'
      isoloom.environment: build-and-image
    restart: unless-stopped
  isoloom-probe-amd64:
    image: busybox:1.37.0-musl
    platform: linux/amd64
    entrypoint:
    - /bin/cp
    - /bin/busybox
    - /probe/busybox
    network_mode: none
    volumes:
    - isoloom-probe-amd64:/probe
    labels:
      isoloom.managed: 'true'
      isoloom.environment: build-and-image
    restart: no
networks:
  lan:
    ipam:
      config:
      - subnet: 10.9.0.0/24
        gateway: 10.9.0.1
    labels:
      isoloom.managed: 'true'
      isoloom.environment: build-and-image
volumes:
  isoloom-probe-amd64:
    labels:
      isoloom.managed: 'true'
      isoloom.environment: build-and-image
