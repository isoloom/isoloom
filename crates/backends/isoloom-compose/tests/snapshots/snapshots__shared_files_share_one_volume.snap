expression: "compose(example(\"shared-files\")?)?"
---
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  docker compose -f .isoloom/docker/compose.yml up -d --wait
# Checks: isothrum check . (or: docker compose -f .isoloom/docker/compose.yml --profile check run --rm isoloom-check, and isoloom-check-<machine>)
# Stop:   docker compose -f .isoloom/docker/compose.yml down -v

name: shared-files
services:
  writer:
    image: debian:12@sha256:2c037a04925515fdd6ea85ea14a682d0e79931f5e9f5d07b6dbfc6ba12f9e858
    platform: linux/amd64
    init: true
    entrypoint:
    - sleep
    - infinity
    hostname: writer
    networks:
      app:
        ipv4_address: 10.84.0.10
    volumes:
    - shared:/srv/shared
    - writer-data:/srv/data
    labels:
      isoloom.managed: 'true'
      isoloom.environment: shared-files
    restart: unless-stopped
  writer-init-1:
    image: debian:12@sha256:2c037a04925515fdd6ea85ea14a682d0e79931f5e9f5d07b6dbfc6ba12f9e858
    user: root
    entrypoint:
    - /bin/sh
    - /isoloom/init/write.sh
    network_mode: service:writer
    volumes:
    - ../../steps/write.sh:/isoloom/init/write.sh:ro
    - shared:/srv/shared
    - writer-data:/srv/data
    depends_on:
      writer:
        condition: service_started
    labels:
      isoloom.managed: 'true'
      isoloom.environment: shared-files
    restart: no
  reader:
    image: debian:12@sha256:2c037a04925515fdd6ea85ea14a682d0e79931f5e9f5d07b6dbfc6ba12f9e858
    platform: linux/amd64
    init: true
    entrypoint:
    - sleep
    - infinity
    hostname: reader
    networks:
      app:
        ipv4_address: 10.84.0.11
    volumes:
    - shared:/data/shared
    labels:
      isoloom.managed: 'true'
      isoloom.environment: shared-files
    restart: unless-stopped
  reader-init-1:
    image: debian:12@sha256:2c037a04925515fdd6ea85ea14a682d0e79931f5e9f5d07b6dbfc6ba12f9e858
    user: root
    entrypoint:
    - /bin/sh
    - /isoloom/init/look.sh
    network_mode: service:reader
    volumes:
    - ../../steps/look.sh:/isoloom/init/look.sh:ro
    - shared:/data/shared
    depends_on:
      reader:
        condition: service_started
    labels:
      isoloom.managed: 'true'
      isoloom.environment: shared-files
    restart: no
  isoloom-check-writer:
    image: curlimages/curl:8.11.1
    profiles:
    - check
    entrypoint:
    - /bin/sh
    - /isoloom/run.sh
    network_mode: service:writer
    volumes:
    - ./checks/writer.sh:/isoloom/run.sh:ro
    depends_on:
      writer-init-1:
        condition: service_completed_successfully
      reader-init-1:
        condition: service_completed_successfully
      writer:
        condition: service_started
    labels:
      isoloom.managed: 'true'
      isoloom.environment: shared-files
  isoloom-check-reader:
    image: curlimages/curl:8.11.1
    profiles:
    - check
    entrypoint:
    - /bin/sh
    - /isoloom/run.sh
    network_mode: service:reader
    volumes:
    - ./checks/reader.sh:/isoloom/run.sh:ro
    depends_on:
      writer-init-1:
        condition: service_completed_successfully
      reader-init-1:
        condition: service_completed_successfully
      reader:
        condition: service_started
    labels:
      isoloom.managed: 'true'
      isoloom.environment: shared-files
networks:
  app:
    ipam:
      config:
      - subnet: 10.84.0.0/24
        gateway: 10.84.0.1
    labels:
      isoloom.managed: 'true'
      isoloom.environment: shared-files
volumes:
  shared:
    labels:
      isoloom.managed: 'true'
      isoloom.environment: shared-files
  writer-data:
    labels:
      isoloom.managed: 'true'
      isoloom.environment: shared-files
