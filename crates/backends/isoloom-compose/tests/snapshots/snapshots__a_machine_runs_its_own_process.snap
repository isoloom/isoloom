---
source: crates/backends/isoloom-compose/tests/snapshots.rs
expression: "compose(render(isoloom_spec::parse(&fixture)?)?)?"
---
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  docker compose -f .isoloom/docker/compose.yml up -d --build --wait web api isoloom-probe && docker compose -f .isoloom/docker/compose.yml up --no-deps --exit-code-from isoloom-init-web-1 isoloom-init-web-1
# Checks: the runner (run.json), or by hand: docker compose -f .isoloom/docker/compose.yml --profile check run --rm isoloom-check, and isoloom-check-<machine>
# Stop:   docker compose -f .isoloom/docker/compose.yml down -v

name: own-process
services:
  web:
    image: python:3-alpine
    command:
    - python3
    - -m
    - http.server
    - '8000'
    working_dir: /srv
    hostname: web
    networks:
      lan:
        ipv4_address: 10.9.0.10
    environment:
      DEMO_SECRET: ${DEMO_SECRET:-}
    volumes:
    - isoloom-probe:/.isoloom-probe:ro
    healthcheck:
      test:
      - CMD
      - /.isoloom-probe/busybox
      - sh
      - -c
      - /.isoloom-probe/busybox nc -z -w 2 127.0.0.1 8000 && ( test -s /srv/secret && echo $$DEMO_SECRET )
      interval: 2s
      timeout: 3s
      retries: 30
      start_period: 10s
    depends_on:
      isoloom-probe:
        condition: service_completed_successfully
    labels:
      isoloom.port.site: tcp:8000
      isoloom.managed: 'true'
      isoloom.environment: own-process
    restart: unless-stopped
  isoloom-init-web-1:
    image: python:3-alpine
    user: root
    entrypoint:
    - /bin/sh
    - /isoloom/init/secret.sh
    network_mode: service:web
    environment:
      DEMO_SECRET: ${DEMO_SECRET:-}
    volumes:
    - ../../secret.sh:/isoloom/init/secret.sh:ro
    - ../..:/opt/isoloom:ro
    depends_on:
      web:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: own-process
    restart: no
  api:
    image: python:3-alpine
    command:
    - /bin/sh
    - -c
    - python3 -m http.server 9000
    hostname: api
    networks:
      lan:
        ipv4_address: 10.9.0.11
    volumes:
    - isoloom-probe:/.isoloom-probe:ro
    healthcheck:
      test:
      - CMD
      - /.isoloom-probe/busybox
      - sh
      - -c
      - /.isoloom-probe/busybox nc -z -w 2 127.0.0.1 9000 && ( /.isoloom-probe/busybox wget -q -O /dev/null -T 3 http://127.0.0.1:9000/health )
      interval: 5s
      timeout: 3s
      retries: 60
      start_period: 60s
    depends_on:
      isoloom-probe:
        condition: service_completed_successfully
    labels:
      isoloom.port.api: tcp:9000
      isoloom.managed: 'true'
      isoloom.environment: own-process
    restart: unless-stopped
  isoloom-check-web:
    image: curlimages/curl:8.22.0@sha256:58adaa4e8dca9c988bae2aba4ab3434a0bb2da16bbe3f92dec39ec7785166777
    profiles:
    - check
    entrypoint:
    - /bin/sh
    - /isoloom/run.sh
    network_mode: service:web
    volumes:
    - ./checks/web.sh:/isoloom/run.sh:ro
    depends_on:
      web:
        condition: service_healthy
      isoloom-init-web-1:
        condition: service_completed_successfully
      api:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: own-process
  isoloom-check-api:
    image: curlimages/curl:8.22.0@sha256:58adaa4e8dca9c988bae2aba4ab3434a0bb2da16bbe3f92dec39ec7785166777
    profiles:
    - check
    entrypoint:
    - /bin/sh
    - /isoloom/run.sh
    network_mode: service:api
    volumes:
    - ./checks/api.sh:/isoloom/run.sh:ro
    depends_on:
      web:
        condition: service_healthy
      isoloom-init-web-1:
        condition: service_completed_successfully
      api:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: own-process
  isoloom-probe:
    image: busybox:1.37.0-musl@sha256:f6a95d611e0a8780fabdb2aec43e31275b2720dfefa3e41b16835bfc42454478
    entrypoint:
    - /bin/cp
    - /bin/busybox
    - /probe/busybox
    network_mode: none
    volumes:
    - isoloom-probe:/probe
    labels:
      isoloom.managed: 'true'
      isoloom.environment: own-process
    restart: no
networks:
  lan:
    ipam:
      config:
      - subnet: 10.9.0.0/24
        gateway: 10.9.0.1
    labels:
      isoloom.managed: 'true'
      isoloom.environment: own-process
volumes:
  isoloom-probe:
    labels:
      isoloom.managed: 'true'
      isoloom.environment: own-process
