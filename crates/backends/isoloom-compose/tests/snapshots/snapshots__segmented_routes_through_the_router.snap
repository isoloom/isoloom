---
source: crates/backends/isoloom-compose/tests/snapshots.rs
expression: "compose(example(\"segmented\")?)?"
---
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  docker compose -f .isoloom/docker/compose.yml up -d --wait
# Checks: isothrum check . (or: docker compose -f .isoloom/docker/compose.yml --profile check run --rm isoloom-check, and isoloom-check-<machine>)
# Stop:   docker compose -f .isoloom/docker/compose.yml down -v

name: segmented
services:
  isoloom-router:
    image: alpine:3.20
    sysctls:
      net.ipv4.ip_forward: '1'
    init: true
    entrypoint:
    - /bin/sh
    - -c
    - apk add --no-cache nftables >/dev/null && printf '%s' "$$RULES" | nft -f - && exec sleep infinity
    hostname: isoloom-router
    networks:
      front:
        ipv4_address: 10.61.10.254
      back:
        ipv4_address: 10.61.20.254
      access:
        ipv4_address: 10.61.99.254
    cap_add:
    - NET_ADMIN
    environment:
      RULES: |
        table inet isoloom {
          chain forward {
            type filter hook forward priority 0; policy drop;
            ct state established,related accept
            ip saddr 10.61.99.0/24 ip daddr 10.61.10.0/24 accept
            ip saddr 10.61.10.0/24 ip daddr 10.61.20.0/24 meta l4proto { tcp, udp } th dport { 6379 } accept
            ip saddr 10.61.10.0/24 ip daddr 10.61.20.0/24 icmp type echo-request accept
          }
        }
    healthcheck:
      test:
      - CMD-SHELL
      - nft list table inet isoloom >/dev/null 2>&1
      interval: 3s
      timeout: 3s
      retries: 60
    labels:
      isoloom.managed: 'true'
      isoloom.environment: segmented
    restart: unless-stopped
  cache:
    image: redis:7-alpine
    platform: linux/amd64
    hostname: cache
    networks:
      back:
        ipv4_address: 10.61.20.20
    extra_hosts:
    - web:10.61.10.10
    - user:10.61.99.10
    volumes:
    - cache-data:/data
    - isoloom-probe-amd64:/.isoloom-probe:ro
    healthcheck:
      test:
      - CMD
      - /.isoloom-probe/busybox
      - sh
      - -c
      - /.isoloom-probe/busybox nc -z -w 2 127.0.0.1 6379
      interval: 5s
      timeout: 3s
      retries: 60
      start_period: 10s
    depends_on:
      isoloom-probe-amd64:
        condition: service_completed_successfully
    deploy:
      resources:
        limits:
          cpus: '1'
          memory: 1024M
    labels:
      isoloom.port.redis: tcp:6379
      isoloom.managed: 'true'
      isoloom.environment: segmented
    restart: unless-stopped
  cache-routes:
    image: alpine:3.20
    init: true
    entrypoint:
    - /bin/sh
    - -c
    - ip route replace 10.61.10.0/24 via 10.61.20.254 && ip route replace 10.61.99.0/24 via 10.61.20.254 && (ip route del default 2>/dev/null || true) && while ip -o -4 addr show | grep -qv ' lo '; do sleep 2; done; exit 1
    network_mode: service:cache
    cap_add:
    - NET_ADMIN
    healthcheck:
      test:
      - CMD-SHELL
      - ip route show 10.61.10.0/24 | grep -q via && ! ip route | grep -q '^default'
      interval: 2s
      timeout: 2s
      retries: 30
    depends_on:
      cache:
        condition: service_started
      isoloom-router:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: segmented
    restart: unless-stopped
  web:
    build:
      context: ../../build/web
      labels:
        isoloom.managed: 'true'
        isoloom.environment: segmented
    image: isoloom/segmented-web
    platform: linux/amd64
    hostname: web
    networks:
      front:
        ipv4_address: 10.61.10.10
    extra_hosts:
    - cache:10.61.20.20
    - user:10.61.99.10
    volumes:
    - isoloom-probe-amd64:/.isoloom-probe:ro
    healthcheck:
      test:
      - CMD
      - /.isoloom-probe/busybox
      - sh
      - -c
      - /.isoloom-probe/busybox nc -z -w 2 127.0.0.1 80
      interval: 5s
      timeout: 3s
      retries: 60
      start_period: 10s
    depends_on:
      isoloom-probe-amd64:
        condition: service_completed_successfully
      cache:
        condition: service_healthy
      cache-routes:
        condition: service_healthy
    labels:
      isoloom.port.web: http:80
      isoloom.port.shell: tcp:4444
      isoloom.managed: 'true'
      isoloom.environment: segmented
    restart: unless-stopped
  web-routes:
    image: alpine:3.20
    init: true
    entrypoint:
    - /bin/sh
    - -c
    - ip route replace 10.61.20.0/24 via 10.61.10.254 && ip route replace 10.61.99.0/24 via 10.61.10.254 && while ip -o -4 addr show | grep -qv ' lo '; do sleep 2; done; exit 1
    network_mode: service:web
    cap_add:
    - NET_ADMIN
    healthcheck:
      test:
      - CMD-SHELL
      - ip route show 10.61.20.0/24 | grep -q via
      interval: 2s
      timeout: 2s
      retries: 30
    depends_on:
      web:
        condition: service_started
      isoloom-router:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: segmented
    restart: unless-stopped
  user:
    image: ${ISOLOOM_ACCESS_IMAGE:-debian:12@sha256:2c037a04925515fdd6ea85ea14a682d0e79931f5e9f5d07b6dbfc6ba12f9e858}
    platform: linux/amd64
    profiles:
    - access
    init: true
    entrypoint:
    - sleep
    - infinity
    hostname: user
    networks:
      access:
        ipv4_address: 10.61.99.10
    extra_hosts:
    - cache:10.61.20.20
    - web:10.61.10.10
    labels:
      isoloom.managed: 'true'
      isoloom.environment: segmented
    restart: unless-stopped
  user-routes:
    image: alpine:3.20
    profiles:
    - access
    init: true
    entrypoint:
    - /bin/sh
    - -c
    - ip route replace 10.61.10.0/24 via 10.61.99.254 && ip route replace 10.61.20.0/24 via 10.61.99.254 && while ip -o -4 addr show | grep -qv ' lo '; do sleep 2; done; exit 1
    network_mode: service:user
    cap_add:
    - NET_ADMIN
    healthcheck:
      test:
      - CMD-SHELL
      - ip route show 10.61.10.0/24 | grep -q via
      interval: 2s
      timeout: 2s
      retries: 30
    depends_on:
      user:
        condition: service_started
      isoloom-router:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: segmented
    restart: unless-stopped
  isoloom-check:
    image: curlimages/curl:8.11.1
    profiles:
    - check
    entrypoint:
    - /bin/sh
    - /isoloom/run.sh
    network_mode: service:user
    volumes:
    - ./checks/user.sh:/isoloom/run.sh:ro
    depends_on:
      cache:
        condition: service_healthy
      cache-routes:
        condition: service_healthy
      web:
        condition: service_healthy
      web-routes:
        condition: service_healthy
      user-routes:
        condition: service_healthy
      user:
        condition: service_started
    labels:
      isoloom.managed: 'true'
      isoloom.environment: segmented
  isoloom-check-cache:
    image: curlimages/curl:8.11.1
    profiles:
    - check
    entrypoint:
    - /bin/sh
    - /isoloom/run.sh
    network_mode: service:cache
    volumes:
    - ./checks/cache.sh:/isoloom/run.sh:ro
    depends_on:
      cache:
        condition: service_healthy
      cache-routes:
        condition: service_healthy
      web:
        condition: service_healthy
      web-routes:
        condition: service_healthy
      user-routes:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: segmented
  isoloom-check-web:
    image: curlimages/curl:8.11.1
    profiles:
    - check
    entrypoint:
    - /bin/sh
    - /isoloom/run.sh
    network_mode: service:web
    volumes:
    - ./checks/web.sh:/isoloom/run.sh:ro
    depends_on:
      cache:
        condition: service_healthy
      cache-routes:
        condition: service_healthy
      web:
        condition: service_healthy
      web-routes:
        condition: service_healthy
      user-routes:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: segmented
  isoloom-probe-amd64:
    image: busybox:1.37.0-musl
    platform: linux/amd64
    entrypoint:
    - /bin/cp
    - /bin/busybox
    - /probe/busybox
    network_mode: none
    volumes:
    - isoloom-probe-amd64:/probe
    labels:
      isoloom.managed: 'true'
      isoloom.environment: segmented
    restart: no
networks:
  front:
    ipam:
      config:
      - subnet: 10.61.10.0/24
        gateway: 10.61.10.1
    labels:
      isoloom.managed: 'true'
      isoloom.environment: segmented
  back:
    ipam:
      config:
      - subnet: 10.61.20.0/24
        gateway: 10.61.20.1
    labels:
      isoloom.managed: 'true'
      isoloom.environment: segmented
  access:
    ipam:
      config:
      - subnet: 10.61.99.0/24
        gateway: 10.61.99.1
    labels:
      isoloom.managed: 'true'
      isoloom.environment: segmented
volumes:
  cache-data:
    labels:
      isoloom.managed: 'true'
      isoloom.environment: segmented
  isoloom-probe-amd64:
    labels:
      isoloom.managed: 'true'
      isoloom.environment: segmented
