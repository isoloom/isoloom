# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  docker compose -f .isoloom/docker/compose.yml up -d --wait
# Checks: isoloom test docker (or: docker compose -f .isoloom/docker/compose.yml --profile check run --rm isoloom-check, and isoloom-check-<machine>)
# Stop:   docker compose -f .isoloom/docker/compose.yml down -v

name: tuned-web
services:
  web:
    image: nginx:1.27-alpine
    platform: linux/amd64
    sysctls:
      net.core.somaxconn: '4096'
    ulimits:
      nofile:
        soft: 8192
        hard: 16384
    hostname: web
    networks:
      app:
        ipv4_address: 10.83.0.10
    environment:
      APP_MODE: production
    volumes:
    - web-cache:/var/cache/web
    - isoloom-probe-amd64:/.isoloom-probe:ro
    healthcheck:
      test:
      - CMD
      - /.isoloom-probe/busybox
      - sh
      - -c
      - /.isoloom-probe/busybox nc -z -w 2 127.0.0.1 80
      interval: 5s
      timeout: 3s
      retries: 60
      start_period: 10s
    depends_on:
      isoloom-probe-amd64:
        condition: service_completed_successfully
    labels:
      isoloom.port.web: http:80
      isoloom.managed: 'true'
      isoloom.environment: tuned-web
    restart: unless-stopped
  isoloom-check-web:
    image: curlimages/curl:8.11.1
    profiles:
    - check
    entrypoint:
    - /bin/sh
    - /isoloom/run.sh
    network_mode: service:web
    volumes:
    - ./checks/web.sh:/isoloom/run.sh:ro
    depends_on:
      web:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: tuned-web
  isoloom-probe-amd64:
    image: busybox:1.37.0-musl
    platform: linux/amd64
    entrypoint:
    - /bin/cp
    - /bin/busybox
    - /probe/busybox
    network_mode: none
    volumes:
    - isoloom-probe-amd64:/probe
    labels:
      isoloom.managed: 'true'
      isoloom.environment: tuned-web
    restart: no
networks:
  app:
    ipam:
      config:
      - subnet: 10.83.0.0/24
        gateway: 10.83.0.1
    labels:
      isoloom.managed: 'true'
      isoloom.environment: tuned-web
volumes:
  web-cache:
    labels:
      isoloom.managed: 'true'
      isoloom.environment: tuned-web
  isoloom-probe-amd64:
    labels:
      isoloom.managed: 'true'
      isoloom.environment: tuned-web
