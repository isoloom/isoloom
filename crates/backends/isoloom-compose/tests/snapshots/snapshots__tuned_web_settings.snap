---
source: crates/backends/isoloom-compose/tests/snapshots.rs
expression: compose(render(spec)?)?
---
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  docker compose -f .isoloom/docker/compose.yml up -d --build --wait
# Checks: the runner (run.json), or by hand: docker compose -f .isoloom/docker/compose.yml --profile check run --rm isoloom-check, and isoloom-check-<machine>
# Stop:   docker compose -f .isoloom/docker/compose.yml down -v

name: tuned-web
services:
  web:
    image: nginx:1.27-alpine
    sysctls:
      net.core.somaxconn: '4096'
    ulimits:
      nofile:
        soft: 8192
        hard: 16384
    hostname: web
    networks:
      app:
        ipv4_address: 10.83.0.10
    environment:
      APP_MODE: production
    volumes:
    - web-cache:/var/cache/web
    - isoloom-probe:/.isoloom-probe:ro
    healthcheck:
      test:
      - CMD
      - /.isoloom-probe/busybox
      - sh
      - -c
      - /.isoloom-probe/busybox nc -z -w 2 127.0.0.1 80
      interval: 5s
      timeout: 3s
      retries: 60
      start_period: 10s
    depends_on:
      isoloom-probe:
        condition: service_completed_successfully
    labels:
      isoloom.port.web: http:80
      isoloom.managed: 'true'
      isoloom.environment: tuned-web
    restart: unless-stopped
  isoloom-check-web:
    image: curlimages/curl:8.22.0@sha256:58adaa4e8dca9c988bae2aba4ab3434a0bb2da16bbe3f92dec39ec7785166777
    profiles:
    - check
    entrypoint:
    - /bin/sh
    - /isoloom/run.sh
    network_mode: service:web
    volumes:
    - ./checks/web.sh:/isoloom/run.sh:ro
    depends_on:
      web:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: tuned-web
  isoloom-probe:
    image: busybox:1.37.0-musl@sha256:f6a95d611e0a8780fabdb2aec43e31275b2720dfefa3e41b16835bfc42454478
    entrypoint:
    - /bin/cp
    - /bin/busybox
    - /probe/busybox
    network_mode: none
    volumes:
    - isoloom-probe:/probe
    labels:
      isoloom.managed: 'true'
      isoloom.environment: tuned-web
    restart: no
networks:
  app:
    ipam:
      config:
      - subnet: 10.83.0.0/24
        gateway: 10.83.0.1
    labels:
      isoloom.managed: 'true'
      isoloom.environment: tuned-web
volumes:
  web-cache:
    labels:
      isoloom.managed: 'true'
      isoloom.environment: tuned-web
  isoloom-probe:
    labels:
      isoloom.managed: 'true'
      isoloom.environment: tuned-web
