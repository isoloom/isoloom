# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  docker compose -f .isoloom/docker/compose.yml up -d --build --wait
# Checks: the runner (run.json), or by hand: docker compose -f .isoloom/docker/compose.yml --profile check run --rm isoloom-check, and isoloom-check-<machine>
# Stop:   docker compose -f .isoloom/docker/compose.yml down -v

name: shared-desk
services:
  desk:
    image: debian:12@sha256:2c037a04925515fdd6ea85ea14a682d0e79931f5e9f5d07b6dbfc6ba12f9e858
    platform: linux/amd64
    init: true
    entrypoint:
    - sleep
    - infinity
    hostname: desk
    networks:
      lan:
        ipv4_address: 10.30.0.10
    volumes:
    - type: bind
      source: ${ISOLOOM_HOST_FOLDER_DESK_0:-../../shared}
      target: /srv/shared
      bind:
        create_host_path: true
    - type: bind
      source: ${ISOLOOM_HOST_FOLDER_DESK_1:-~/notes}
      target: /home/notes
      read_only: true
      bind:
        create_host_path: true
    - type: bind
      source: ${ISOLOOM_HOST_FOLDER_DESK_2:-/srv/drop}
      target: /srv/drop
      bind:
        create_host_path: true
    labels:
      isoloom.managed: 'true'
      isoloom.environment: shared-desk
    restart: unless-stopped
networks:
  lan:
    ipam:
      config:
      - subnet: 10.30.0.0/24
        gateway: 10.30.0.1
    labels:
      isoloom.managed: 'true'
      isoloom.environment: shared-desk
