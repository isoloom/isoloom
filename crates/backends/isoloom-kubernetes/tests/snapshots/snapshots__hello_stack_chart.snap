# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# `isoloom chart --version <v>` packages it with that version.
apiVersion: v2
name: hello-stack
description: The hello-stack environment, generated by Isoloom from isoloom.yml
type: application
version: 0.1.0
appVersion: 0.1.0

=== .isoloom/kubernetes/chart/values.yaml
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# images: each machine's image (images built from the project must be pushed where the
# cluster pulls from, and named here). inputs: the launch-time inputs (unset ones are empty).
images:
  cache: redis:7-alpine
  web: isoloom/hello-stack-web

