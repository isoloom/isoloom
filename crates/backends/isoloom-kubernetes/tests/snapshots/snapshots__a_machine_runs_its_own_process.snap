---
source: crates/backends/isoloom-kubernetes/tests/snapshots.rs
expression: "joined(&files, |p| p.ends_with(\"environment.yaml\"))"
---
=== .isoloom/kubernetes/environment.yaml
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  kubectl apply -k .isoloom/kubernetes
#         kubectl -n isoloom-own-process wait --for=condition=Available deployment --all --timeout=600s
# Stop:   kubectl delete namespace isoloom-own-process
# Inputs (optional, unset ones are empty): kubectl -n isoloom-own-process create secret generic isoloom-inputs --from-literal=DEMO_SECRET=…

apiVersion: v1
kind: Namespace
metadata:
  name: isoloom-own-process
  labels:
    app.kubernetes.io/managed-by: isoloom
    pod-security.kubernetes.io/enforce: baseline
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: web
  labels:
    app.kubernetes.io/managed-by: isoloom
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      isoloom.com/machine: web
  template:
    metadata:
      labels:
        isoloom.com/machine: web
        net.isoloom.com/lan: member
    spec:
      hostname: web
      securityContext:
        seccompProfile:
          type: RuntimeDefault
      initContainers:
      - name: isoloom-probe
        image: busybox:1.37.0-musl@sha256:f6a95d611e0a8780fabdb2aec43e31275b2720dfefa3e41b16835bfc42454478
        command:
        - /bin/cp
        - /bin/busybox
        - /probe/busybox
        securityContext:
          runAsUser: 65534
          runAsGroup: 65534
          runAsNonRoot: true
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
        volumeMounts:
        - name: isoloom-probe
          mountPath: /probe
      containers:
      - name: web
        image: python:3-alpine
        imagePullPolicy: IfNotPresent
        args:
        - python3
        - -m
        - http.server
        - '8000'
        workingDir: /srv
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
            add:
            - AUDIT_WRITE
            - CHOWN
            - DAC_OVERRIDE
            - FOWNER
            - FSETID
            - KILL
            - MKNOD
            - NET_BIND_SERVICE
            - SETFCAP
            - SETGID
            - SETPCAP
            - SETUID
            - SYS_CHROOT
        ports:
        - containerPort: 8000
        readinessProbe:
          exec:
            command:
            - /.isoloom-probe/busybox
            - sh
            - -c
            - /.isoloom-probe/busybox nc -z -w 2 127.0.0.1 8000 && ( test -s /srv/secret && echo $DEMO_SECRET )
          initialDelaySeconds: 10
          periodSeconds: 2
          timeoutSeconds: 3
          successThreshold: 1
          failureThreshold: 30
        env:
        - name: DEMO_SECRET
          valueFrom:
            secretKeyRef:
              name: isoloom-inputs
              key: DEMO_SECRET
              optional: true
        resources:
          requests:
            cpu: 100m
            memory: 128Mi
          limits:
            cpu: '1'
            memory: 512Mi
        volumeMounts:
        - name: isoloom-probe
          mountPath: /.isoloom-probe
          readOnly: true
      - name: init
        image: python:3-alpine
        imagePullPolicy: IfNotPresent
        command:
        - sh
        - -c
        - until /.isoloom-probe/busybox nc -z -w 2 127.0.0.1 8000 && ( test -s /srv/secret && echo $DEMO_SECRET ); do sleep 2; done && sh /isoloom/scripts/secret.sh && exec sleep infinity
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
            add:
            - AUDIT_WRITE
            - CHOWN
            - DAC_OVERRIDE
            - FOWNER
            - FSETID
            - KILL
            - MKNOD
            - NET_BIND_SERVICE
            - SETFCAP
            - SETGID
            - SETPCAP
            - SETUID
            - SYS_CHROOT
        env:
        - name: DEMO_SECRET
          valueFrom:
            secretKeyRef:
              name: isoloom-inputs
              key: DEMO_SECRET
              optional: true
        volumeMounts:
        - name: isoloom-probe
          mountPath: /.isoloom-probe
          readOnly: true
        - name: scripts
          mountPath: /isoloom/scripts
      volumes:
      - name: scripts
        configMap:
          name: isoloom-scripts
          defaultMode: 493
      - name: isoloom-probe
        emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: web
  labels:
    app.kubernetes.io/managed-by: isoloom
spec:
  selector:
    isoloom.com/machine: web
  ports:
  - name: p8000
    port: 8000
    targetPort: 8000
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: api
  labels:
    app.kubernetes.io/managed-by: isoloom
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      isoloom.com/machine: api
  template:
    metadata:
      labels:
        isoloom.com/machine: api
        net.isoloom.com/lan: member
    spec:
      hostname: api
      securityContext:
        seccompProfile:
          type: RuntimeDefault
      initContainers:
      - name: isoloom-probe
        image: busybox:1.37.0-musl@sha256:f6a95d611e0a8780fabdb2aec43e31275b2720dfefa3e41b16835bfc42454478
        command:
        - /bin/cp
        - /bin/busybox
        - /probe/busybox
        securityContext:
          runAsUser: 65534
          runAsGroup: 65534
          runAsNonRoot: true
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
        volumeMounts:
        - name: isoloom-probe
          mountPath: /probe
      containers:
      - name: api
        image: python:3-alpine
        imagePullPolicy: IfNotPresent
        args:
        - /bin/sh
        - -c
        - python3 -m http.server 9000
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
            add:
            - AUDIT_WRITE
            - CHOWN
            - DAC_OVERRIDE
            - FOWNER
            - FSETID
            - KILL
            - MKNOD
            - NET_BIND_SERVICE
            - SETFCAP
            - SETGID
            - SETPCAP
            - SETUID
            - SYS_CHROOT
        ports:
        - containerPort: 9000
        startupProbe:
          exec:
            command:
            - /.isoloom-probe/busybox
            - sh
            - -c
            - /.isoloom-probe/busybox nc -z -w 2 127.0.0.1 9000
          periodSeconds: 5
          failureThreshold: 60
        readinessProbe:
          httpGet:
            path: /health
            port: 9000
          initialDelaySeconds: 60
          periodSeconds: 5
          timeoutSeconds: 3
          successThreshold: 1
          failureThreshold: 60
        resources:
          requests:
            cpu: 100m
            memory: 128Mi
          limits:
            cpu: '1'
            memory: 512Mi
        volumeMounts:
        - name: isoloom-probe
          mountPath: /.isoloom-probe
          readOnly: true
      volumes:
      - name: isoloom-probe
        emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: api
  labels:
    app.kubernetes.io/managed-by: isoloom
spec:
  selector:
    isoloom.com/machine: api
  ports:
  - name: p9000
    port: 9000
    targetPort: 9000
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: isoloom-default-deny
  labels:
    app.kubernetes.io/managed-by: isoloom
spec:
  podSelector: {}
  policyTypes:
  - Ingress
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: net-lan
  labels:
    app.kubernetes.io/managed-by: isoloom
spec:
  podSelector:
    matchLabels:
      net.isoloom.com/lan: member
  ingress:
  - from:
    - podSelector:
        matchLabels:
          net.isoloom.com/lan: member

