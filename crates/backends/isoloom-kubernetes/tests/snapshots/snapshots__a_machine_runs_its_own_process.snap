=== .isoloom/kubernetes/environment.yaml
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  kubectl apply -k .isoloom/kubernetes
#         kubectl -n isoloom-own-process wait --for=condition=Available deployment --all --timeout=600s
# Stop:   kubectl delete namespace isoloom-own-process
# Inputs (optional, unset ones are empty): kubectl -n isoloom-own-process create secret generic isoloom-inputs --from-literal=FLAG=…

apiVersion: v1
kind: Namespace
metadata:
  name: isoloom-own-process
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: web
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      isoloom.com/machine: web
  template:
    metadata:
      labels:
        isoloom.com/machine: web
        net.isoloom.com/lan: member
    spec:
      hostname: web
      initContainers:
      - name: isoloom-probe
        image: busybox:1.37.0-musl
        command:
        - /bin/cp
        - /bin/busybox
        - /probe/busybox
        volumeMounts:
        - name: isoloom-probe
          mountPath: /probe
      containers:
      - name: web
        image: python:3-alpine
        imagePullPolicy: IfNotPresent
        args:
        - python3
        - -m
        - http.server
        - '8000'
        workingDir: /srv
        ports:
        - containerPort: 8000
        readinessProbe:
          exec:
            command:
            - /.isoloom-probe/busybox
            - sh
            - -c
            - /.isoloom-probe/busybox nc -z -w 2 127.0.0.1 8000 && ( test -s /srv/flag && echo $FLAG )
          initialDelaySeconds: 10
          periodSeconds: 2
          timeoutSeconds: 3
          successThreshold: 1
          failureThreshold: 30
        env:
        - name: FLAG
          valueFrom:
            secretKeyRef:
              name: isoloom-inputs
              key: FLAG
              optional: true
        volumeMounts:
        - name: isoloom-probe
          mountPath: /.isoloom-probe
          readOnly: true
      - name: init
        image: python:3-alpine
        imagePullPolicy: IfNotPresent
        command:
        - sh
        - -c
        - until /.isoloom-probe/busybox nc -z -w 2 127.0.0.1 8000 && ( test -s /srv/flag && echo $FLAG ); do sleep 2; done && sh /isoloom/scripts/flag.sh && exec sleep infinity
        env:
        - name: FLAG
          valueFrom:
            secretKeyRef:
              name: isoloom-inputs
              key: FLAG
              optional: true
        volumeMounts:
        - name: isoloom-probe
          mountPath: /.isoloom-probe
          readOnly: true
        - name: scripts
          mountPath: /isoloom/scripts
      nodeSelector:
        kubernetes.io/arch: amd64
      volumes:
      - name: scripts
        configMap:
          name: isoloom-scripts
          defaultMode: 493
      - name: isoloom-probe
        emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: web
spec:
  selector:
    isoloom.com/machine: web
  ports:
  - name: p8000
    port: 8000
    targetPort: 8000
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: api
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      isoloom.com/machine: api
  template:
    metadata:
      labels:
        isoloom.com/machine: api
        net.isoloom.com/lan: member
    spec:
      hostname: api
      initContainers:
      - name: isoloom-probe
        image: busybox:1.37.0-musl
        command:
        - /bin/cp
        - /bin/busybox
        - /probe/busybox
        volumeMounts:
        - name: isoloom-probe
          mountPath: /probe
      containers:
      - name: api
        image: python:3-alpine
        imagePullPolicy: IfNotPresent
        args:
        - /bin/sh
        - -c
        - python3 -m http.server 9000
        ports:
        - containerPort: 9000
        startupProbe:
          exec:
            command:
            - /.isoloom-probe/busybox
            - sh
            - -c
            - /.isoloom-probe/busybox nc -z -w 2 127.0.0.1 9000
          periodSeconds: 5
          failureThreshold: 60
        readinessProbe:
          httpGet:
            path: /health
            port: 9000
          initialDelaySeconds: 60
          periodSeconds: 5
          timeoutSeconds: 3
          successThreshold: 1
          failureThreshold: 60
        volumeMounts:
        - name: isoloom-probe
          mountPath: /.isoloom-probe
          readOnly: true
      nodeSelector:
        kubernetes.io/arch: amd64
      volumes:
      - name: isoloom-probe
        emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: api
spec:
  selector:
    isoloom.com/machine: api
  ports:
  - name: p9000
    port: 9000
    targetPort: 9000
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: isoloom-default-deny
spec:
  podSelector: {}
  policyTypes:
  - Ingress
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: net-lan
spec:
  podSelector:
    matchLabels:
      net.isoloom.com/lan: member
  ingress:
  - from:
    - podSelector:
        matchLabels:
          net.isoloom.com/lan: member

