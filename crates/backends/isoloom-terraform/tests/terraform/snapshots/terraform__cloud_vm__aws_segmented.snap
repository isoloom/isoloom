---
source: crates/backends/isoloom-terraform/tests/terraform/cloud_vm.rs
expression: "aws(\"segmented\")?"
---
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  terraform -chdir=.isoloom/cloud-vm/aws init && terraform -chdir=.isoloom/cloud-vm/aws apply \
#           -var allowed_cidr=<your IP>/32 -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)" -var ssh_private_key_file=~/.ssh/id_ed25519
# Stop:   terraform -chdir=.isoloom/cloud-vm/aws destroy (same variables)

terraform {
  required_version = ">= 1.6.0"
  backend "local" {}
  required_providers {
    aws   = { source = "hashicorp/aws", version = "~> 6.67.0" }
    local = { source = "hashicorp/local", version = "~> 2.9.1" }
  }
}

variable "region" {
  type    = string
  default = "eu-west-3"
}

variable "allowed_cidr" {
  type        = string
  description = "Who may reach the machines (SSH and the published ports), e.g. your IP/32"
}

variable "ssh_public_key" {
  type        = string
  description = "The SSH public key the machines let in: Terraform signs in with its private half (`ssh_private_key_file`) to set them up or wait for their set-up, and so can you, to run the checks"
}

variable "ssh_private_key_file" {
  type        = string
  description = "The private key of ssh_public_key (a path, ~ allowed): Terraform signs in to the machines with it to bring the project in and wait for their set-up"
}

variable "expires_at" {
  type        = string
  default     = ""
  description = "When the environment should end, in Unix seconds (empty: no end): a tag on every resource, so a reaper finds what to destroy, and the time the machines shut themselves down"
}

provider "aws" {
  region = var.region
  default_tags {
    tags = {
      isoloom-environment = "segmented"
      managed-by          = "isoloom"
      isoloom-instance    = local.name
      isoloom-expires-at  = var.expires_at
    }
  }
}

resource "terraform_data" "id" {
  input = substr(replace(uuid(), "-", ""), 0, 8)
  lifecycle {
    ignore_changes = [input]
  }
}

locals {
  name = "isoloom-segmented-${terraform_data.id.output}"
  root = abspath("${path.module}/../../..")
}

data "aws_availability_zones" "available" {
  state = "available"
}

# The environment's networks: one VPC, a subnet per network with its exact range.
resource "aws_vpc" "env" {
  cidr_block = "10.61.10.0/24"
  tags       = { Name = local.name }
}

resource "aws_vpc_ipv4_cidr_block_association" "back" {
  vpc_id     = aws_vpc.env.id
  cidr_block = "10.61.20.0/24"
}

resource "aws_vpc_ipv4_cidr_block_association" "access" {
  vpc_id     = aws_vpc.env.id
  cidr_block = "10.61.99.0/24"
}

resource "aws_internet_gateway" "env" {
  vpc_id = aws_vpc.env.id
}

resource "aws_route_table" "env" {
  vpc_id = aws_vpc.env.id
  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.env.id
  }
}

resource "aws_subnet" "front" {
  vpc_id            = aws_vpc.env.id
  cidr_block        = "10.61.10.0/24"
  availability_zone = data.aws_availability_zones.available.names[0]
  tags              = { Name = "${local.name}-front" }
}

resource "aws_route_table_association" "front" {
  subnet_id      = aws_subnet.front.id
  route_table_id = aws_route_table.env.id
}

resource "aws_subnet" "back" {
  vpc_id            = aws_vpc.env.id
  cidr_block        = "10.61.20.0/24"
  availability_zone = data.aws_availability_zones.available.names[0]
  tags              = { Name = "${local.name}-back" }
  depends_on        = [aws_vpc_ipv4_cidr_block_association.back]
}

resource "aws_route_table_association" "back" {
  subnet_id      = aws_subnet.back.id
  route_table_id = aws_route_table.env.id
}

resource "aws_subnet" "access" {
  vpc_id            = aws_vpc.env.id
  cidr_block        = "10.61.99.0/24"
  availability_zone = data.aws_availability_zones.available.names[0]
  tags              = { Name = "${local.name}-access" }
  depends_on        = [aws_vpc_ipv4_cidr_block_association.access]
}

resource "aws_route_table_association" "access" {
  subnet_id      = aws_subnet.access.id
  route_table_id = aws_route_table.env.id
}

# The seal: once every machine is set up, the networks without internet go out to the environment's networks and allowed_cidr alone (replies to SSH and the published ports), at the network.
resource "aws_network_acl" "sealed" {
  vpc_id     = aws_vpc.env.id
  subnet_ids = [aws_subnet.back.id]
  ingress {
    rule_no    = 100
    protocol   = "-1"
    action     = "allow"
    cidr_block = "10.61.10.0/24"
    from_port  = 0
    to_port    = 0
  }
  ingress {
    rule_no    = 110
    protocol   = "-1"
    action     = "allow"
    cidr_block = "10.61.20.0/24"
    from_port  = 0
    to_port    = 0
  }
  ingress {
    rule_no    = 120
    protocol   = "-1"
    action     = "allow"
    cidr_block = "10.61.99.0/24"
    from_port  = 0
    to_port    = 0
  }
  ingress {
    rule_no    = 130
    protocol   = "-1"
    action     = "allow"
    cidr_block = var.allowed_cidr
    from_port  = 0
    to_port    = 0
  }
  egress {
    rule_no    = 100
    protocol   = "-1"
    action     = "allow"
    cidr_block = "10.61.10.0/24"
    from_port  = 0
    to_port    = 0
  }
  egress {
    rule_no    = 110
    protocol   = "-1"
    action     = "allow"
    cidr_block = "10.61.20.0/24"
    from_port  = 0
    to_port    = 0
  }
  egress {
    rule_no    = 120
    protocol   = "-1"
    action     = "allow"
    cidr_block = "10.61.99.0/24"
    from_port  = 0
    to_port    = 0
  }
  egress {
    rule_no    = 130
    protocol   = "-1"
    action     = "allow"
    cidr_block = var.allowed_cidr
    from_port  = 0
    to_port    = 0
  }
  tags = { Name = "${local.name}-sealed" }
  depends_on = [
    terraform_data.isoloom_ready_cache,
    terraform_data.isoloom_ready_web,
    terraform_data.isoloom_ready_user
  ]
}

resource "aws_key_pair" "env" {
  key_name   = local.name
  public_key = var.ssh_public_key
}

data "aws_ami" "debian_12" {
  most_recent = true
  owners      = ["136693071363"]
  filter {
    name   = "name"
    values = ["debian-12-amd64-*"]
  }
  filter {
    name   = "architecture"
    values = ["x86_64"]
  }
}

# Machine `cache`: what may reach it.
resource "aws_security_group" "cache" {
  name   = "${local.name}-cache"
  vpc_id = aws_vpc.env.id
  ingress {
    description = "its network (back)"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["10.61.20.0/24"]
  }
  ingress {
    description = "SSH from allowed_cidr"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [var.allowed_cidr]
  }
  ingress {
    description = "reach from front"
    from_port   = 6379
    to_port     = 6379
    protocol    = "tcp"
    cidr_blocks = ["10.61.10.0/24"]
  }
  ingress {
    description = "reach from front"
    from_port   = 6379
    to_port     = 6379
    protocol    = "udp"
    cidr_blocks = ["10.61.10.0/24"]
  }
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_instance" "cache" {
  instance_initiated_shutdown_behavior = "terminate"
  metadata_options {
    http_tokens = "required"
  }
  ami              = data.aws_ami.debian_12.id
  instance_type    = "t3.micro"
  user_data_base64 = base64gzip("#!/bin/sh\n# Isoloom: this machine sets itself up. Its progress is in /var/lib/isoloom/ready (isoloom-ready/1), its output in /var/log/isoloom-setup.log. The project comes over SSH from Terraform.\nmkdir -p /var/lib/isoloom\nrm -f /var/lib/isoloom/setup.sh.new\n(umask 077 && cat > /var/lib/isoloom/setup.sh.new) <<'ISOLOOM_SETUP'\n#!/bin/sh\numask 022\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\nstate=$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\npart=$(cat /var/lib/isoloom/part 2>/dev/null || echo 1)\ncase \"$state\" in ready|\"failed: \"*) exit 0 ;; esac\nif [ \"$part\" = 1 ]; then\necho 'running: its host name' > /var/lib/isoloom/ready; { hostnamectl set-hostname cache 2>/dev/null || hostname cache; grep -q ' cache$' /etc/hosts || echo '127.0.1.1 cache' >> /etc/hosts; [ ! -d /etc/cloud/cloud.cfg.d ] || echo 'preserve_hostname: true' > /etc/cloud/cloud.cfg.d/99-isoloom-hostname.cfg; } || { echo 'failed: its host name' > /var/lib/isoloom/ready; exit 1; }\necho 'running: waiting for the project (Terraform brings it in over SSH)' > /var/lib/isoloom/ready; { i=0; until [ -f /var/lib/isoloom/project-delivered ]; do [ \"$i\" -gt 0 ] || echo 'waiting for the project, which Terraform brings in over SSH during its apply'; i=$((i+5)); if [ \"$i\" -gt 2400 ]; then echo 'the project never came: Terraform brings it in over SSH during its apply (its terraform_data.isoloom_ready_<machine>), with ssh_private_key_file' >&2; exit 1; fi; sleep 5; done; } || { echo 'failed: waiting for the project (Terraform brings it in over SSH)' > /var/lib/isoloom/ready; exit 1; }\necho 'running: growing the disk' > /var/lib/isoloom/ready; { sh -c 'set -e\npart_grow() {\n  dev=$(readlink -f \"$1\")\n  disk=/dev/$(lsblk -no PKNAME \"$dev\" | head -n1)\n  num=$(cat \"/sys/class/block/$(basename \"$dev\")/partition\")\n  if command -v growpart >/dev/null; then growpart \"$disk\" \"$num\" >/dev/null || true\n  else echo \", +\" | sfdisk --no-reread -N \"$num\" \"$disk\" >/dev/null 2>&1 && partx -u \"$disk\" || true; fi\n}\nfs_grow() { resize2fs \"$1\" >/dev/null 2>&1 || xfs_growfs / >/dev/null 2>&1 || true; }\nsrc=$(findmnt -n -o SOURCE /)\ncase \"$(lsblk -no TYPE \"$src\" | head -n1)\" in\n  lvm)\n    vg=$(lvs --noheadings -o vg_name \"$src\" | tr -d '\\'' '\\'')\n    for pv in $(pvs --noheadings -o pv_name -S vg_name=\"$vg\" | tr -d '\\'' '\\''); do part_grow \"$pv\"; pvresize \"$pv\" >/dev/null; done\n    lvextend -l +100%FREE \"$src\" >/dev/null 2>&1 || true\n    fs_grow \"$src\" ;;\n  part) part_grow \"$src\"; fs_grow \"$src\" ;;\nesac'; } || { echo 'failed: growing the disk' > /var/lib/isoloom/ready; exit 1; }\necho 'running: hosts file' > /var/lib/isoloom/ready; { sh -c 'printf '\\''%s\\n'\\'' '\\''10.61.20.20 cache'\\'' '\\''10.61.10.10 web'\\'' '\\''10.61.99.10 user'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'; } || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }\necho 'running: volume folders' > /var/lib/isoloom/ready; { sh -c 'mkdir -p '\\''/data'\\'''; } || { echo 'failed: volume folders' > /var/lib/isoloom/ready; exit 1; }\necho 'running: provision/cache.sh' > /var/lib/isoloom/ready; { sh -c 'cd /opt/isoloom && sh -c '\\''sh '\\''\\'\\'''\\''provision/cache.sh'\\''\\'\\'''\\'''\\'''; } || { echo 'failed: provision/cache.sh' > /var/lib/isoloom/ready; exit 1; }\necho 'running: closing the internet' > /var/lib/isoloom/ready; { sh -c 'pkg() { if command -v apt-get >/dev/null; then apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \"$@\"; elif command -v dnf >/dev/null; then dnf install -y -q \"$@\"; elif command -v apk >/dev/null; then apk add -q --no-cache \"$@\"; else yum install -y -q \"$@\"; fi; }\ncommand -v nft >/dev/null || pkg nftables\nprintf '\\''%s\\n'\\'' '\\''table inet isoloom-egress'\\'' '\\''delete table inet isoloom-egress'\\'' '\\''table inet isoloom-egress {'\\'' '\\''  chain output {'\\'' '\\''    type filter hook output priority 0; policy accept;'\\'' '\\''    oifname \"lo\" accept'\\'' '\\''    ip daddr != { 10.61.10.0/24, 10.61.20.0/24, 10.61.99.0/24 } ct state new drop'\\'' '\\''  }'\\'' '\\''}'\\'' > /etc/isoloom-egress.nft\nmkdir -p /etc/isoloom\ncat > /etc/isoloom/egress.sh <<'\\''EGRESS'\\''\n#!/bin/sh\n# No new connection leaves the isoloom networks\nnft -f /etc/isoloom-egress.nft\nexit 0\nEGRESS\nchmod +x /etc/isoloom/egress.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-egress.service <<'\\''UNIT'\\''\n[Unit]\nDescription=No new connection leaves the isoloom networks\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=-/etc/isoloom/egress.sh\n\n[Install]\nWantedBy=multi-user.target\nUNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-egress.service\nsystemctl restart isoloom-egress.service\nelse\nmkdir -p /etc/local.d && ln -sf /etc/isoloom/egress.sh /etc/local.d/isoloom-egress.start\nrc-update add local default >/dev/null 2>&1 || true\n/etc/isoloom/egress.sh || true\nfi'; } || { echo 'failed: closing the internet' > /var/lib/isoloom/ready; exit 1; }\necho 'running: health check' > /var/lib/isoloom/ready; { sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'; } || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }\nfi\necho ready > /var/lib/isoloom/ready\nrm -f /var/lib/isoloom/part\nexit 0\nISOLOOM_SETUP\nmv -f /var/lib/isoloom/setup.sh.new /var/lib/isoloom/setup.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-setup.service <<'ISOLOOM_UNIT'\n[Unit]\nDescription=Isoloom: the machine's set-up\nWants=network-online.target\nAfter=network-online.target cloud-final.service google-startup-scripts.service\n\n[Service]\nType=oneshot\nExecStart=/bin/sh /var/lib/isoloom/setup.sh\nStandardOutput=append:/var/log/isoloom-setup.log\nStandardError=append:/var/log/isoloom-setup.log\nTimeoutStartSec=0\n\n[Install]\nWantedBy=multi-user.target\nISOLOOM_UNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-setup.service >/dev/null 2>&1\nsystemctl start --no-block isoloom-setup.service\nelse\nnohup sh /var/lib/isoloom/setup.sh >> /var/log/isoloom-setup.log 2>&1 &\nfi\n")
  lifecycle {
    ignore_changes = [user_data_base64]
  }
  subnet_id                   = aws_subnet.back.id
  private_ip                  = "10.61.20.20"
  associate_public_ip_address = true
  key_name                    = aws_key_pair.env.key_name
  vpc_security_group_ids      = [aws_security_group.cache.id]
  root_block_device {
    volume_size = 10
    volume_type = "gp3"
    encrypted   = true
  }
  tags = { Name = "${local.name}-cache" }
}

# Machine `web`: what may reach it.
resource "aws_security_group" "web" {
  name   = "${local.name}-web"
  vpc_id = aws_vpc.env.id
  ingress {
    description = "its network (front)"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["10.61.10.0/24"]
  }
  ingress {
    description = "SSH from allowed_cidr"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [var.allowed_cidr]
  }
  ingress {
    description = "reach from access"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["10.61.99.0/24"]
  }
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_instance" "web" {
  instance_initiated_shutdown_behavior = "terminate"
  metadata_options {
    http_tokens = "required"
  }
  ami              = data.aws_ami.debian_12.id
  instance_type    = "t3.micro"
  user_data_base64 = base64gzip("#!/bin/sh\n# Isoloom: this machine sets itself up. Its progress is in /var/lib/isoloom/ready (isoloom-ready/1), its output in /var/log/isoloom-setup.log. The project comes over SSH from Terraform.\nmkdir -p /var/lib/isoloom\nrm -f /var/lib/isoloom/setup.sh.new\n(umask 077 && cat > /var/lib/isoloom/setup.sh.new) <<'ISOLOOM_SETUP'\n#!/bin/sh\numask 022\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\nstate=$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\npart=$(cat /var/lib/isoloom/part 2>/dev/null || echo 1)\ncase \"$state\" in ready|\"failed: \"*) exit 0 ;; esac\nif [ \"$part\" = 1 ]; then\necho 'running: its host name' > /var/lib/isoloom/ready; { hostnamectl set-hostname web 2>/dev/null || hostname web; grep -q ' web$' /etc/hosts || echo '127.0.1.1 web' >> /etc/hosts; [ ! -d /etc/cloud/cloud.cfg.d ] || echo 'preserve_hostname: true' > /etc/cloud/cloud.cfg.d/99-isoloom-hostname.cfg; } || { echo 'failed: its host name' > /var/lib/isoloom/ready; exit 1; }\necho 'running: waiting for the project (Terraform brings it in over SSH)' > /var/lib/isoloom/ready; { i=0; until [ -f /var/lib/isoloom/project-delivered ]; do [ \"$i\" -gt 0 ] || echo 'waiting for the project, which Terraform brings in over SSH during its apply'; i=$((i+5)); if [ \"$i\" -gt 2400 ]; then echo 'the project never came: Terraform brings it in over SSH during its apply (its terraform_data.isoloom_ready_<machine>), with ssh_private_key_file' >&2; exit 1; fi; sleep 5; done; } || { echo 'failed: waiting for the project (Terraform brings it in over SSH)' > /var/lib/isoloom/ready; exit 1; }\necho 'running: hosts file' > /var/lib/isoloom/ready; { sh -c 'printf '\\''%s\\n'\\'' '\\''10.61.20.20 cache'\\'' '\\''10.61.10.10 web'\\'' '\\''10.61.99.10 user'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'; } || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }\necho 'running: waiting for cache' > /var/lib/isoloom/ready; { sh -c 'i=0; until (bash -c '\\''</dev/tcp/cache/6379'\\'' 2>/dev/null || nc -z -w 2 cache 6379 2>/dev/null); do i=$((i+2)); if [ $i -ge 900 ]; then echo \"cache didn'\\''t answer within 900s\" >&2; exit 1; fi; sleep 2; done; echo \"cache answers\"'; } || { echo 'failed: waiting for cache' > /var/lib/isoloom/ready; exit 1; }\necho 'running: provision/web.sh' > /var/lib/isoloom/ready; { sh -c 'cd /opt/isoloom && sh -c '\\''sh '\\''\\'\\'''\\''provision/web.sh'\\''\\'\\'''\\'''\\'''; } || { echo 'failed: provision/web.sh' > /var/lib/isoloom/ready; exit 1; }\necho 'running: health check' > /var/lib/isoloom/ready; { sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'; } || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }\nfi\necho ready > /var/lib/isoloom/ready\nrm -f /var/lib/isoloom/part\nexit 0\nISOLOOM_SETUP\nmv -f /var/lib/isoloom/setup.sh.new /var/lib/isoloom/setup.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-setup.service <<'ISOLOOM_UNIT'\n[Unit]\nDescription=Isoloom: the machine's set-up\nWants=network-online.target\nAfter=network-online.target cloud-final.service google-startup-scripts.service\n\n[Service]\nType=oneshot\nExecStart=/bin/sh /var/lib/isoloom/setup.sh\nStandardOutput=append:/var/log/isoloom-setup.log\nStandardError=append:/var/log/isoloom-setup.log\nTimeoutStartSec=0\n\n[Install]\nWantedBy=multi-user.target\nISOLOOM_UNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-setup.service >/dev/null 2>&1\nsystemctl start --no-block isoloom-setup.service\nelse\nnohup sh /var/lib/isoloom/setup.sh >> /var/log/isoloom-setup.log 2>&1 &\nfi\n")
  lifecycle {
    ignore_changes = [user_data_base64]
  }
  subnet_id                   = aws_subnet.front.id
  private_ip                  = "10.61.10.10"
  associate_public_ip_address = true
  key_name                    = aws_key_pair.env.key_name
  vpc_security_group_ids      = [aws_security_group.web.id]
  root_block_device {
    volume_size = 20
    volume_type = "gp3"
    encrypted   = true
  }
  tags = { Name = "${local.name}-web" }
}

# Machine `user`: what may reach it.
resource "aws_security_group" "user" {
  name   = "${local.name}-user"
  vpc_id = aws_vpc.env.id
  ingress {
    description = "its network (access)"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["10.61.99.0/24"]
  }
  ingress {
    description = "SSH from allowed_cidr"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [var.allowed_cidr]
  }
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_instance" "user" {
  instance_initiated_shutdown_behavior = "terminate"
  metadata_options {
    http_tokens = "required"
  }
  ami              = data.aws_ami.debian_12.id
  instance_type    = "t3.micro"
  user_data_base64 = base64gzip("#!/bin/sh\n# Isoloom: this machine sets itself up. Its progress is in /var/lib/isoloom/ready (isoloom-ready/1), its output in /var/log/isoloom-setup.log. The project comes over SSH from Terraform.\nmkdir -p /var/lib/isoloom\nrm -f /var/lib/isoloom/setup.sh.new\n(umask 077 && cat > /var/lib/isoloom/setup.sh.new) <<'ISOLOOM_SETUP'\n#!/bin/sh\numask 022\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\nstate=$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\npart=$(cat /var/lib/isoloom/part 2>/dev/null || echo 1)\ncase \"$state\" in ready|\"failed: \"*) exit 0 ;; esac\nif [ \"$part\" = 1 ]; then\necho 'running: its host name' > /var/lib/isoloom/ready; { hostnamectl set-hostname user 2>/dev/null || hostname user; grep -q ' user$' /etc/hosts || echo '127.0.1.1 user' >> /etc/hosts; [ ! -d /etc/cloud/cloud.cfg.d ] || echo 'preserve_hostname: true' > /etc/cloud/cloud.cfg.d/99-isoloom-hostname.cfg; } || { echo 'failed: its host name' > /var/lib/isoloom/ready; exit 1; }\necho 'running: waiting for the project (Terraform brings it in over SSH)' > /var/lib/isoloom/ready; { i=0; until [ -f /var/lib/isoloom/project-delivered ]; do [ \"$i\" -gt 0 ] || echo 'waiting for the project, which Terraform brings in over SSH during its apply'; i=$((i+5)); if [ \"$i\" -gt 2400 ]; then echo 'the project never came: Terraform brings it in over SSH during its apply (its terraform_data.isoloom_ready_<machine>), with ssh_private_key_file' >&2; exit 1; fi; sleep 5; done; } || { echo 'failed: waiting for the project (Terraform brings it in over SSH)' > /var/lib/isoloom/ready; exit 1; }\necho 'running: hosts file' > /var/lib/isoloom/ready; { sh -c 'printf '\\''%s\\n'\\'' '\\''10.61.20.20 cache'\\'' '\\''10.61.10.10 web'\\'' '\\''10.61.99.10 user'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'; } || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }\necho 'running: health check' > /var/lib/isoloom/ready; { sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'; } || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }\nfi\necho ready > /var/lib/isoloom/ready\nrm -f /var/lib/isoloom/part\nexit 0\nISOLOOM_SETUP\nmv -f /var/lib/isoloom/setup.sh.new /var/lib/isoloom/setup.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-setup.service <<'ISOLOOM_UNIT'\n[Unit]\nDescription=Isoloom: the machine's set-up\nWants=network-online.target\nAfter=network-online.target cloud-final.service google-startup-scripts.service\n\n[Service]\nType=oneshot\nExecStart=/bin/sh /var/lib/isoloom/setup.sh\nStandardOutput=append:/var/log/isoloom-setup.log\nStandardError=append:/var/log/isoloom-setup.log\nTimeoutStartSec=0\n\n[Install]\nWantedBy=multi-user.target\nISOLOOM_UNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-setup.service >/dev/null 2>&1\nsystemctl start --no-block isoloom-setup.service\nelse\nnohup sh /var/lib/isoloom/setup.sh >> /var/log/isoloom-setup.log 2>&1 &\nfi\n")
  lifecycle {
    ignore_changes = [user_data_base64]
  }
  subnet_id                   = aws_subnet.access.id
  private_ip                  = "10.61.99.10"
  associate_public_ip_address = true
  key_name                    = aws_key_pair.env.key_name
  vpc_security_group_ids      = [aws_security_group.user.id]
  root_block_device {
    volume_size = 20
    volume_type = "gp3"
    encrypted   = true
  }
  tags = { Name = "${local.name}-user" }
}

resource "terraform_data" "isoloom_ready_cache" {
  triggers_replace = [aws_instance.cache.id]
  connection {
    type        = "ssh"
    host        = aws_instance.cache.public_ip
    user        = "admin"
    private_key = file(pathexpand(var.ssh_private_key_file))
    timeout     = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-ready_cache.tgz\" --exclude=\"${basename(local.root)}/.isoloom*\" --exclude=\".git\" --exclude=\".terraform\" --exclude=\"*.tfstate\" --exclude=\"*.tfstate.*\" --exclude=\".terraform.tfstate.lock.info\" --exclude=\"crash.log\" --exclude=\"crash.*.log\" --exclude=\".vagrant\" -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-ready_cache.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-outputs-cache.tgz\" -C \"${abspath(local.root)}\" .isoloom/cloud-vm/checks"
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-outputs-cache.tgz"
    destination = "/tmp/isoloom-outputs.tgz"
  }
  provisioner "remote-exec" {
    inline = [
      "sudo sh -c 'rm -rf /opt/isoloom && mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz && tar -xzf /tmp/isoloom-outputs.tgz -C /opt/isoloom && rm -f /tmp/isoloom-outputs.tgz && mkdir -p /var/lib/isoloom && touch /var/lib/isoloom/project-delivered'"
    ]
  }
  provisioner "remote-exec" {
    inline = [
      "sh -c 't=0\nif command -v cloud-init >/dev/null 2>&1; then sudo cloud-init status --wait >/dev/null 2>&1 || true; fi\nwhile :; do\ns=$(sudo head -n1 /var/lib/isoloom/ready 2>/dev/null)\ncase \"$s\" in\nready) echo \"cache: set up\"; exit 0 ;;\n\"failed: \"*) echo \"cache: its set-up stopped ($s); the end of /var/log/isoloom-setup.log:\"; sudo tail -n 40 /var/log/isoloom-setup.log 2>/dev/null; exit 1 ;;\nesac\nif [ \"$t\" -ge 2400 ]; then echo \"cache: not set up after 2400 s ($${s:-no ready file}); the end of /var/log/isoloom-setup.log:\"; sudo tail -n 40 /var/log/isoloom-setup.log 2>/dev/null; exit 1; fi\nsleep 5; t=$((t + 5))\ndone'"
    ]
  }
}

resource "terraform_data" "isoloom_ready_web" {
  triggers_replace = [aws_instance.web.id]
  connection {
    type        = "ssh"
    host        = aws_instance.web.public_ip
    user        = "admin"
    private_key = file(pathexpand(var.ssh_private_key_file))
    timeout     = "10m"
