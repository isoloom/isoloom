---
source: crates/backends/isoloom-terraform/tests/single_network_clouds.rs
expression: "module(Cloud::Oci, \"solo-web\")?"
---
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  terraform -chdir=.isoloom/cloud-vm/oci init && terraform -chdir=.isoloom/cloud-vm/oci apply \
#           -var compartment_id=<compartment ocid> -var allowed_cidr=<your IP>/32 \
#           -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)"
# Stop:   terraform -chdir=.isoloom/cloud-vm/oci destroy (same variables)
# Auth:   the oci provider reads ~/.oci/config; region defaults, override with -var region=<id>.
# Then:   the machines wait for the project: run the lab through the Isothrum runner (run.json
#         beside this file), which delivers the project over SSH, waits for each set-up and runs the checks.

terraform {
  required_version = ">= 1.6"
  backend "local" {}
  required_providers {
    oci = { source = "oracle/oci", version = "~> 9.8.0" }
  }
}

variable "compartment_id" {
  type        = string
  description = "The compartment the environment goes in"
}

variable "region" {
  type        = string
  default     = "eu-paris-1"
  description = "The OCI region to launch in"
}

variable "config_file_profile" {
  type        = string
  default     = "DEFAULT"
  description = "The profile of the OCI CLI's configuration (~/.oci/config) the provider signs in with"
}

variable "allowed_cidr" {
  type        = string
  description = "Who may reach the machines (SSH and the published ports), e.g. your IP/32"
}

variable "ssh_public_key" {
  type        = string
  description = "The key the machines let in: the Isothrum runner's (it delivers the project and runs the checks over SSH)"
}

variable "expires_at" {
  type        = string
  default     = ""
  description = "When the environment should end, in Unix seconds (empty: no end): a tag on every resource, so a reaper finds what to destroy, and the time the machines shut themselves down"
}

provider "oci" {
  region              = var.region
  config_file_profile = var.config_file_profile
}

resource "terraform_data" "id" {
  input = substr(replace(uuid(), "-", ""), 0, 8)
  lifecycle {
    ignore_changes = [input]
  }
}

locals {
  name = "isoloom-solo-web-${terraform_data.id.output}"
  tags = merge({ isoloom-environment = "solo-web", managed-by = "isoloom", isoloom-instance = local.name }, var.expires_at == "" ? {} : { isoloom-expires-at = var.expires_at })
}

# The compartment's availability domains; the instances land in the first.
data "oci_identity_availability_domains" "ads" {
  compartment_id = var.compartment_id
}

# Ubuntu 24.04: Oracle Cloud has no Debian image of its own.
data "oci_core_images" "ubuntu_2404" {
  compartment_id           = var.compartment_id
  operating_system         = "Canonical Ubuntu"
  operating_system_version = "24.04"
  shape                    = "VM.Standard.E4.Flex"
  sort_by                  = "TIMECREATED"
  sort_order               = "DESC"
}

# The environment's networks: a VCN holding each one's block, routed to the internet.
resource "oci_core_vcn" "env" {
  compartment_id = var.compartment_id
  freeform_tags  = local.tags
  display_name   = local.name
  cidr_block     = "10.80.0.0/24"
}

resource "oci_core_internet_gateway" "env" {
  compartment_id = var.compartment_id
  freeform_tags  = local.tags
  vcn_id         = oci_core_vcn.env.id
  display_name   = local.name
}

resource "oci_core_route_table" "env" {
  compartment_id = var.compartment_id
  freeform_tags  = local.tags
  vcn_id         = oci_core_vcn.env.id
  display_name   = local.name
  route_rules {
    destination       = "0.0.0.0/0"
    network_entity_id = oci_core_internet_gateway.env.id
  }
}

# Network `app`: what may reach its machines, and where they may go.
resource "oci_core_security_list" "app" {
  compartment_id = var.compartment_id
  freeform_tags  = local.tags
  vcn_id         = oci_core_vcn.env.id
  display_name   = "${local.name}-app"
  ingress_security_rules {
    description = "its own network"
    source      = "10.80.0.0/24"
    protocol    = "all"
  }
  ingress_security_rules {
    description = "SSH from allowed_cidr"
    source      = var.allowed_cidr
    protocol    = "6"
    tcp_options {
      min = 22
      max = 22
    }
  }
  ingress_security_rules {
    description = "path MTU discovery"
    source      = "0.0.0.0/0"
    protocol    = "1"
    icmp_options {
      type = 3
      code = 4
    }
  }
  egress_security_rules {
    description = "its own network"
    destination = "10.80.0.0/24"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "0.0.0.0/5"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "8.0.0.0/7"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "11.0.0.0/8"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "12.0.0.0/6"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "16.0.0.0/4"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "32.0.0.0/3"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "64.0.0.0/2"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "128.0.0.0/3"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "160.0.0.0/5"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "168.0.0.0/6"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "172.0.0.0/12"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "172.32.0.0/11"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "172.64.0.0/10"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "172.128.0.0/9"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "173.0.0.0/8"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "174.0.0.0/7"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "176.0.0.0/4"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "192.0.0.0/9"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "192.128.0.0/11"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "192.160.0.0/13"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "192.169.0.0/16"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "192.170.0.0/15"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "192.172.0.0/14"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "192.176.0.0/12"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "192.192.0.0/10"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "193.0.0.0/8"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "194.0.0.0/7"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "196.0.0.0/6"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "200.0.0.0/5"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "208.0.0.0/4"
    protocol    = "all"
  }
  egress_security_rules {
    description = "the internet"
    destination = "224.0.0.0/3"
    protocol    = "all"
  }
  egress_security_rules {
    description = "path MTU discovery"
    destination = "0.0.0.0/0"
    protocol    = "1"
    icmp_options {
      type = 3
      code = 4
    }
  }
}

resource "oci_core_subnet" "app" {
  compartment_id    = var.compartment_id
  freeform_tags     = local.tags
  vcn_id            = oci_core_vcn.env.id
  cidr_block        = "10.80.0.0/24"
  display_name      = "${local.name}-app"
  route_table_id    = oci_core_route_table.env.id
  security_list_ids = [oci_core_security_list.app.id]
}

# The ports `web` publishes, from allowed_cidr: on its VNIC only.
resource "oci_core_network_security_group" "web" {
  compartment_id = var.compartment_id
  freeform_tags  = local.tags
  vcn_id         = oci_core_vcn.env.id
  display_name   = "${local.name}-web"
}

resource "oci_core_network_security_group_security_rule" "web_tcp_8080" {
  network_security_group_id = oci_core_network_security_group.web.id
  description               = "published"
  direction                 = "INGRESS"
  protocol                  = "6"
  source                    = var.allowed_cidr
  source_type               = "CIDR_BLOCK"
  tcp_options {
    destination_port_range {
      min = 8080
      max = 8080
    }
  }
}

# Machine `web`, at its fixed address 10.80.0.10.
resource "oci_core_instance" "web" {
  compartment_id      = var.compartment_id
  freeform_tags       = local.tags
  availability_domain = data.oci_identity_availability_domains.ads.availability_domains[0].name
  display_name        = "${local.name}-web"
  shape               = "VM.Standard.E4.Flex"
  shape_config {
    ocpus         = 1
    memory_in_gbs = 1
  }
  source_details {
    source_type             = "image"
    source_id               = data.oci_core_images.ubuntu_2404.images[0].id
    boot_volume_size_in_gbs = 50
  }
  create_vnic_details {
    subnet_id              = oci_core_subnet.app.id
    private_ip             = "10.80.0.10"
    assign_public_ip       = true
    hostname_label         = "web"
    skip_source_dest_check = false
    nsg_ids                = [oci_core_network_security_group.web.id]
  }
  metadata = {
    ssh_authorized_keys = var.ssh_public_key
    user_data           = base64encode("#!/bin/sh\n# Isoloom: this machine sets itself up. Its progress is in /var/lib/isoloom/ready (isoloom-ready/1), its output in /var/log/isoloom-setup.log. The Isothrum runner delivers the project over SSH.\nmkdir -p /var/lib/isoloom\ncat > /var/lib/isoloom/setup.sh.new <<'ISOLOOM_SETUP'\n#!/bin/sh\numask 022\ncase \"$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\" in ready|failed:*) exit 0 ;; esac\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\npart=$(cat /var/lib/isoloom/part 2>/dev/null || echo 1)\nif [ \"$part\" = 1 ]; then\necho 'running: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; { i=0; until [ -f /var/lib/isoloom/project-delivered ]; do i=$((i+5)); if [ $i -gt 2400 ]; then echo 'the project never came: start the lab through the Isothrum runner (run.json), which delivers it over SSH' >&2; exit 1; fi; sleep 5; done; } || { echo 'failed: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; exit 1; }\necho 'running: provision/web.sh' > /var/lib/isoloom/ready; { sh -c 'cd /opt/isoloom && sh -c '\\''sh provision/web.sh'\\'''; } || { echo 'failed: provision/web.sh' > /var/lib/isoloom/ready; exit 1; }\necho 'running: published ports' > /var/lib/isoloom/ready; { command -v nft >/dev/null || (sudo apt-get update -qq && sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq nftables); } || { echo 'failed: published ports' > /var/lib/isoloom/ready; exit 1; }\necho 'running: published ports' > /var/lib/isoloom/ready; { sudo nft add table ip isoloom-publish && sudo nft 'add chain ip isoloom-publish prerouting { type nat hook prerouting priority -100; }' && sudo nft add rule ip isoloom-publish prerouting tcp dport 8080 redirect to :80; } || { echo 'failed: published ports' > /var/lib/isoloom/ready; exit 1; }\necho 'running: health check' > /var/lib/isoloom/ready; { sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'; } || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }\nfi\necho ready > /var/lib/isoloom/ready\nrm -f /var/lib/isoloom/part\ncommand -v systemctl >/dev/null && systemctl disable isoloom-setup.service >/dev/null 2>&1\nexit 0\nISOLOOM_SETUP\nmv -f /var/lib/isoloom/setup.sh.new /var/lib/isoloom/setup.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-setup.service <<'ISOLOOM_UNIT'\n[Unit]\nDescription=Isoloom: the machine's set-up\nWants=network-online.target\nAfter=network-online.target cloud-final.service google-startup-scripts.service\n\n[Service]\nType=oneshot\nExecStart=/bin/sh /var/lib/isoloom/setup.sh\nStandardOutput=append:/var/log/isoloom-setup.log\nStandardError=append:/var/log/isoloom-setup.log\nTimeoutStartSec=0\n\n[Install]\nWantedBy=multi-user.target\nISOLOOM_UNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-setup.service >/dev/null 2>&1\nsystemctl start --no-block isoloom-setup.service\nelse\nnohup sh /var/lib/isoloom/setup.sh >> /var/log/isoloom-setup.log 2>&1 &\nfi\n")
  }
}

output "machines" {
  value = { web = oci_core_instance.web.public_ip }
}

output "address_web" {
  value = oci_core_instance.web.public_ip
}

output "ssh_users" {
  value = { web = "ubuntu" }
}

output "ip" {
  value = oci_core_instance.web.public_ip
}

output "ready_file" {
  value = "/var/lib/isoloom/ready"
}

output "published" {
  value = { "web/web" = "${oci_core_instance.web.public_ip}:8080" }
}
