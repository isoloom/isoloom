==> .isoloom/cloud-services/up.sh
#!/bin/sh
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Creates the services (`isoloom run cloud-services`).
# The services of `cloud-bucket`: the Terraform module `terraform`, in the user's aws account.
set -eu
cd "$(dirname "$0")"
here="$(pwd)"
export TF_DATA_DIR="$here/.terraform"
[ ! -f "$here/isoloom-instance" ] || export TF_VAR_isoloom_instance="$(cat "$here/isoloom-instance")"
src='../../terraform'
module="$here/module"
echo $$ > "$here/deploying"
trap 'rm -f "$here/deploying"' EXIT
mkdir -p "$module"
find "$module" -type f \( -name '*.tf' -o -name '*.tf.json' -o -name '*.tfvars' -o -name '*.tfvars.json' \) -exec rm -f {} +
tar -C "$src" -cf - --exclude=.terraform --exclude='*.tfstate' --exclude='*.tfstate.*' . | tar -C "$module" -xf -
terraform -chdir="$module" init -input=false >&2
set -- -var-file="$here/terraform.tfvars.json"
[ ! -f "$here/inputs.tfvars.json" ] || set -- "$@" -var-file="$here/inputs.tfvars.json"
terraform -chdir="$module" apply -auto-approve -input=false -state="$here/terraform.tfstate" "$@"
==> .isoloom/cloud-services/down.sh
#!/bin/sh
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Destroys them (`isoloom down cloud-services`): what they cost stops here.
# The services of `cloud-bucket`: the Terraform module `terraform`, in the user's aws account.
set -eu
cd "$(dirname "$0")"
here="$(pwd)"
export TF_DATA_DIR="$here/.terraform"
[ ! -f "$here/isoloom-instance" ] || export TF_VAR_isoloom_instance="$(cat "$here/isoloom-instance")"
src='../../terraform'
module="$here/module"
if [ ! -d "$module" ]; then
  mkdir -p "$module"
  find "$module" -type f \( -name '*.tf' -o -name '*.tf.json' -o -name '*.tfvars' -o -name '*.tfvars.json' \) -exec rm -f {} +
  tar -C "$src" -cf - --exclude=.terraform --exclude='*.tfstate' --exclude='*.tfstate.*' . | tar -C "$module" -xf -
fi
terraform -chdir="$module" init -input=false >&2
set -- -var-file="$here/terraform.tfvars.json"
[ ! -f "$here/inputs.tfvars.json" ] || set -- "$@" -var-file="$here/inputs.tfvars.json"
terraform -chdir="$module" destroy -auto-approve -input=false -state="$here/terraform.tfstate" "$@"
==> .isoloom/cloud-services/outputs.sh
#!/bin/sh
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Prints the module's outputs as JSON (what `isoloom test` and the message read).
# The services of `cloud-bucket`: the Terraform module `terraform`, in the user's aws account.
set -eu
cd "$(dirname "$0")"
here="$(pwd)"
export TF_DATA_DIR="$here/.terraform"
[ ! -f "$here/isoloom-instance" ] || export TF_VAR_isoloom_instance="$(cat "$here/isoloom-instance")"
src='../../terraform'
module="$here/module"
[ -d "$module" ] || module="$src"
terraform -chdir="$module" output -json -state="$here/terraform.tfstate"
