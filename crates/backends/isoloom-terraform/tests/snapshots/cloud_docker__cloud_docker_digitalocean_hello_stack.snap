---
source: crates/backends/isoloom-terraform/tests/cloud_docker.rs
expression: "cloud(\"digitalocean\")?"
---
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Auth:   export DIGITALOCEAN_TOKEN=<token>
# Start:  terraform -chdir=.isoloom/cloud-docker/digitalocean init && terraform -chdir=.isoloom/cloud-docker/digitalocean apply \
#           -var allowed_cidr=<your IP>/32 -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)"
# Stop:   terraform -chdir=.isoloom/cloud-docker/digitalocean destroy (same variables)
# Then:   the machines wait for the project: run the lab through the runner (run.json) beside this file,
#         which delivers the project over SSH, waits for each set-up and runs the checks.

terraform {
  required_version = ">= 1.6"
  backend "local" {}
  required_providers {
    digitalocean = { source = "digitalocean/digitalocean", version = "~> 2.103.0" }
  }
}

variable "region" {
  type    = string
  default = "fra1"
}

variable "size" {
  type    = string
  default = "s-2vcpu-4gb"
}

variable "allowed_cidr" {
  type        = string
  description = "Who may reach the machines (SSH and the published ports), e.g. your IP/32"
}

variable "ssh_public_key" {
  type        = string
  description = "The SSH public key the machines let in: whoever holds its private key signs in, as the runner (run.json) does to deliver the project and run the checks"
}

variable "expires_at" {
  type        = string
  default     = ""
  description = "When the environment should end, in Unix seconds (empty: no end): a tag on every resource, so a reaper finds what to destroy, and the time the machines shut themselves down"
}

provider "digitalocean" {}

resource "terraform_data" "id" {
  input = substr(replace(uuid(), "-", ""), 0, 8)
  lifecycle {
    ignore_changes = [input]
  }
}

locals {
  name = "isoloom-hello-stack-${terraform_data.id.output}"
}

resource "digitalocean_vpc" "env" {
  name     = local.name
  region   = var.region
  ip_range = "10.42.1.0/24"
}

resource "digitalocean_ssh_key" "env" {
  name       = local.name
  public_key = var.ssh_public_key
}

resource "digitalocean_droplet" "env" {
  name      = local.name
  region    = var.region
  size      = var.size
  image     = "debian-12-x64"
  vpc_uuid  = digitalocean_vpc.env.id
  ssh_keys  = [digitalocean_ssh_key.env.id]
  user_data = "#!/bin/sh\nmkdir -p /var/lib/isoloom\necho ${var.expires_at} > /var/lib/isoloom/expires-at\nmkdir -p /etc/isoloom\ncat > /etc/isoloom/expiry.sh <<'EXPIRY'\n#!/bin/sh\n# The run's end: the machine shuts itself down\ne=$(cat /var/lib/isoloom/expires-at 2>/dev/null); if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\nexit 0\nEXPIRY\nchmod +x /etc/isoloom/expiry.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-expiry.service <<'UNIT'\n[Unit]\nDescription=The run's end: the machine shuts itself down\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=-/etc/isoloom/expiry.sh\n\n[Install]\nWantedBy=multi-user.target\nUNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-expiry.service\nsystemctl restart isoloom-expiry.service\nelse\nmkdir -p /etc/local.d && ln -sf /etc/isoloom/expiry.sh /etc/local.d/isoloom-expiry.start\nrc-update add local default >/dev/null 2>&1 || true\n/etc/isoloom/expiry.sh || true\nfi\n"
  tags      = concat(["isoloom", "hello-stack", local.name], var.expires_at == "" ? [] : ["isoloom-expires-${var.expires_at}"])
  lifecycle {
    ignore_changes = [user_data]
  }
}

resource "digitalocean_firewall" "env" {
  name        = local.name
  droplet_ids = [digitalocean_droplet.env.id]
  inbound_rule {
    protocol         = "tcp"
    port_range       = "22"
    source_addresses = [var.allowed_cidr]
  }
  inbound_rule {
    protocol         = "tcp"
    port_range       = "8080"
    source_addresses = [var.allowed_cidr]
  }
  outbound_rule {
    protocol              = "tcp"
    port_range            = "1-65535"
    destination_addresses = ["0.0.0.0/0", "::/0"]
  }
  outbound_rule {
    protocol              = "udp"
    port_range            = "1-65535"
    destination_addresses = ["0.0.0.0/0", "::/0"]
  }
  outbound_rule {
    protocol              = "icmp"
    destination_addresses = ["0.0.0.0/0", "::/0"]
  }
}

output "ip" {
  value = digitalocean_droplet.env.ipv4_address
}

output "ssh_user" {
  value = "root"
}
