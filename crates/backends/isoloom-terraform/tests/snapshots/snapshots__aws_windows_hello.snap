---
source: crates/backends/isoloom-terraform/tests/snapshots.rs
expression: "aws(\"windows-hello\")?"
---
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  terraform -chdir=.isoloom/cloud-vm/aws init && terraform -chdir=.isoloom/cloud-vm/aws apply \
#           -var allowed_cidr=<your IP>/32 -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)"
# Stop:   terraform -chdir=.isoloom/cloud-vm/aws destroy (same variables)
# Then:   the machines wait for the project: run the lab through the Isothrum runner (run.json
#         beside this file), which delivers the project over SSH, waits for each set-up and runs the checks.

terraform {
  required_version = ">= 1.6"
  backend "local" {}
  required_providers {
    aws    = { source = "hashicorp/aws", version = "~> 6.67.0" }
    tls    = { source = "hashicorp/tls", version = "~> 4.4.1" }
    random = { source = "hashicorp/random", version = "~> 3.9.1" }
    time   = { source = "hashicorp/time", version = "~> 0.14.2" }
    local  = { source = "hashicorp/local", version = "~> 2.9.1" }
  }
}

variable "region" {
  type    = string
  default = "eu-west-3"
}

variable "allowed_cidr" {
  type        = string
  description = "Who may reach the machines (SSH and the published ports), e.g. your IP/32"
}

variable "ssh_public_key" {
  type        = string
  description = "The key the machines let in: the Isothrum runner's (it delivers the project and runs the checks over SSH)"
}

variable "expires_at" {
  type        = string
  default     = ""
  description = "When the environment should end, in Unix seconds (empty: no end): a tag on every resource, so a reaper finds what to destroy, and the time the machines shut themselves down"
}

provider "aws" {
  region = var.region
  default_tags {
    tags = {
      isoloom-environment = "windows-hello"
      managed-by          = "isoloom"
      isoloom-instance    = local.name
      isoloom-expires-at  = var.expires_at
    }
  }
}

resource "terraform_data" "id" {
  input = substr(replace(uuid(), "-", ""), 0, 8)
  lifecycle {
    ignore_changes = [input]
  }
}

locals {
  name = "isoloom-windows-hello-${terraform_data.id.output}"
  root = abspath("${path.module}/../../..")
}

data "aws_availability_zones" "available" {
  state = "available"
}

# The environment's networks: one VPC, a subnet per network with its exact range.
resource "aws_vpc" "env" {
  cidr_block = "192.168.57.0/24"
  tags       = { Name = local.name }
}

resource "aws_internet_gateway" "env" {
  vpc_id = aws_vpc.env.id
}

resource "aws_route_table" "env" {
  vpc_id = aws_vpc.env.id
  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.env.id
  }
}

resource "aws_subnet" "lab" {
  vpc_id            = aws_vpc.env.id
  cidr_block        = "192.168.57.0/24"
  availability_zone = data.aws_availability_zones.available.names[0]
  tags              = { Name = "${local.name}-lab" }
}

resource "aws_route_table_association" "lab" {
  subnet_id      = aws_subnet.lab.id
  route_table_id = aws_route_table.env.id
}

resource "aws_key_pair" "env" {
  key_name   = local.name
  public_key = var.ssh_public_key
}

# The Windows machines' administrator password (user isoloom), for WinRM.
resource "random_password" "windows" {
  length      = 24
  special     = false
  min_upper   = 2
  min_lower   = 2
  min_numeric = 2
}

# The controller's own key: it runs the playbooks over SSH on every machine.
resource "tls_private_key" "controller" {
  algorithm = "ED25519"
}

data "aws_ami" "debian_12" {
  most_recent = true
  owners      = ["136693071363"]
  filter {
    name   = "name"
    values = ["debian-12-amd64-*"]
  }
  filter {
    name   = "architecture"
    values = ["x86_64"]
  }
}

data "aws_ami" "windows_server_2019" {
  most_recent = true
  owners      = ["801119661308"]
  filter {
    name   = "name"
    values = ["Windows_Server-2019-English-Full-Base-*"]
  }
  filter {
    name   = "architecture"
    values = ["x86_64"]
  }
}

# Machine `web01` (Windows): what may reach it.
resource "aws_security_group" "web01" {
  name   = "${local.name}-web01"
  vpc_id = aws_vpc.env.id
  ingress {
    description = "its network (lab)"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["192.168.57.0/24"]
  }
  ingress {
    description = "WinRM from allowed_cidr (its set-up)"
    from_port   = 5985
    to_port     = 5985
    protocol    = "tcp"
    cidr_blocks = [var.allowed_cidr]
  }
  ingress {
    description = "published"
    from_port   = 8082
    to_port     = 8082
    protocol    = "tcp"
    cidr_blocks = [var.allowed_cidr]
  }
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

# No key pair: AWS refuses ED25519 keys on Windows, and WinRM uses the generated password.
resource "aws_instance" "web01" {
  ami                         = data.aws_ami.windows_server_2019.id
  instance_type               = "c7i-flex.large"
  subnet_id                   = aws_subnet.lab.id
  private_ip                  = "192.168.57.10"
  associate_public_ip_address = true
  vpc_security_group_ids      = [aws_security_group.web01.id]
  user_data                   = "<powershell>\n$p = ConvertTo-SecureString '${random_password.windows.result}' -AsPlainText -Force\nNew-LocalUser -Name isoloom -Password $p -PasswordNeverExpires -AccountNeverExpires | Out-Null\nAdd-LocalGroupMember -Group Administrators -Member isoloom\nEnable-PSRemoting -Force -SkipNetworkProfileCheck | Out-Null\nSet-Item WSMan:\\localhost\\Service\\AllowUnencrypted $true\nSet-Item WSMan:\\localhost\\Service\\Auth\\Basic $true\nNew-NetFirewallRule -DisplayName 'isoloom WinRM' -Direction Inbound -Protocol TCP -LocalPort 5985 -Action Allow | Out-Null\n${var.expires_at != "" ? "Register-ScheduledTask -TaskName isoloom-expiry -Action (New-ScheduledTaskAction -Execute shutdown.exe -Argument '/s /t 0') -Trigger (New-ScheduledTaskTrigger -Once -At ([DateTimeOffset]::FromUnixTimeSeconds(${var.expires_at}).LocalDateTime)) -User SYSTEM -RunLevel Highest -Force | Out-Null" : ""}\n</powershell>\n"
  root_block_device {
    volume_size = 50
  }
  tags = { Name = "${local.name}-web01" }
}

resource "terraform_data" "web01_name" {
  triggers_replace = [aws_instance.web01.id]
  connection {
    type     = "winrm"
    host     = aws_instance.web01.public_ip
    user     = "isoloom"
    password = random_password.windows.result
    https    = false
    timeout  = "30m"
  }
  provisioner "remote-exec" {
    inline = [
      "powershell -NoProfile -Command \"if ($env:COMPUTERNAME -ne 'WEB01') { Rename-Computer -NewName 'web01' -Force; shutdown /r /t 10 }\""
    ]
  }
}

resource "time_sleep" "web01_restart" {
  create_duration = "90s"
  depends_on      = [terraform_data.web01_name]
}

resource "terraform_data" "web01" {
  triggers_replace = [aws_instance.web01.id]
  connection {
    type     = "winrm"
    host     = aws_instance.web01.public_ip
    user     = "isoloom"
    password = random_password.windows.result
    https    = false
    timeout  = "30m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-web01.tgz\" --exclude=.git --exclude=.vagrant --exclude=.terraform --exclude=.isoloom-project* -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-web01.tgz"
    destination = "C:/Windows/Temp/isoloom-project.tgz"
  }
  provisioner "file" {
    content     = "$ErrorActionPreference = 'Stop'\nif ($env:COMPUTERNAME -ne 'WEB01') { throw \"still named $env:COMPUTERNAME: the rename hasn't taken effect\" }\nnetsh interface portproxy add v4tov4 listenport=8082 listenaddress=0.0.0.0 connectport=80 connectaddress=127.0.0.1 | Out-Null\nNew-NetFirewallRule -DisplayName 'isoloom 80' -Direction Inbound -Protocol TCP -LocalPort 80 -Action Allow | Out-Null\nNew-NetFirewallRule -DisplayName 'isoloom 8082' -Direction Inbound -Protocol TCP -LocalPort 8082 -Action Allow | Out-Null\n$archive = 'C:\\Windows\\Temp\\isoloom-project.tgz'; $dest = 'C:\\isoloom'; $strip = 1\n# The project into a Windows machine: unpacks the tar.gz $archive into $dest (replacing an older\n# copy), leaving out the archive's first $strip folders. Plain .NET (GZipStream), so it runs on\n# every Windows Isoloom supports: PowerShell 2.0 and later, and no tar.exe before Windows Server\n# 2019. Symbolic links are left out (counted).\n& {\n  $ErrorActionPreference = 'Stop'\n  $sep = [IO.Path]::DirectorySeparatorChar\n  $new = \"$dest.new\"\n  if (Test-Path $new) { Remove-Item $new -Recurse -Force }\n  [void][IO.Directory]::CreateDirectory($new)\n  $file = New-Object IO.FileStream($archive, [IO.FileMode]::Open, [IO.FileAccess]::Read)\n  $in = New-Object IO.Compression.GZipStream($file, [IO.Compression.CompressionMode]::Decompress)\n  $utf8 = New-Object Text.UTF8Encoding($false)\n  $header = New-Object byte[] 512\n  $chunk = New-Object byte[] 65536\n  function Fill([byte[]]$b, [int]$n) {\n    $got = 0\n    while ($got -lt $n) {\n      $r = $in.Read($b, $got, $n - $got)\n      if ($r -le 0) { throw \"$archive ends early\" }\n      $got += $r\n    }\n  }\n  function Field([int]$at, [int]$len) {\n    $end = [Array]::IndexOf($header, [byte]0, $at, $len)\n    if ($end -lt 0) { $end = $at + $len }\n    $utf8.GetString($header, $at, $end - $at)\n  }\n  # Copies $size bytes to $out (or skips them, with no $out), then the padding after them.\n  function Body([long]$size, $out) {\n    $left = $size\n    while ($left -gt 0) {\n      $n = [int][Math]::Min([long]$chunk.Length, $left)\n      Fill $chunk $n\n      if ($out) { $out.Write($chunk, 0, $n) }\n      $left -= $n\n    }\n    $pad = [int]((512 - $size % 512) % 512)\n    if ($pad) { Fill $chunk $pad }\n  }\n  $pax = @{}\n  $links = 0\n  $files = 0\n  while ($true) {\n    Fill $header 512\n    if ($header[148] -eq 0) { break } # the end: zero blocks have no checksum\n    $type = [char]$header[156]\n    $sizeText = (Field 124 12).Trim()\n    $size = [long]0\n    if ($sizeText) { $size = [Convert]::ToInt64($sizeText, 8) }\n    if ($pax['size']) { $size = [long]$pax['size'] }\n    if ($type -eq 'x') {\n      # pax records (\"<length> key=value\\n\"): a long path, a large size, for the next entry.\n      $ms = New-Object IO.MemoryStream\n      Body $size $ms\n      $b = $ms.ToArray()\n      $i = 0\n      while ($i -lt $b.Length) {\n        $sp = [Array]::IndexOf($b, [byte]32, $i)\n        $len = [int]$utf8.GetString($b, $i, $sp - $i)\n        $eq = [Array]::IndexOf($b, [byte]61, $sp)\n        $pax[$utf8.GetString($b, $sp + 1, $eq - $sp - 1)] = $utf8.GetString($b, $eq + 1, $i + $len - $eq - 2)\n        $i += $len\n      }\n      continue\n    }\n    if ($type -eq 'L' -or $type -eq 'K') {\n      # GNU tar's long name (or link target) for the next entry.\n      $ms = New-Object IO.MemoryStream\n      Body $size $ms\n      if ($type -eq 'L') { $pax['path'] = $utf8.GetString($ms.ToArray()).TrimEnd([char]0) }\n      continue\n    }\n    $name = Field 0 100\n    $prefix = Field 345 155\n    if ($prefix) { $name = \"$prefix/$name\" }\n    if ($pax['path']) { $name = $pax['path'] }\n    $pax = @{}\n    $parts = @($name.Split('/') | Where-Object { $_ -ne '' -and $_ -ne '.' })\n    if ($parts.Count -le $strip) { Body $size $null; continue }\n    $path = Join-Path $new ([string]::Join([string]$sep, [string[]]($parts[$strip..($parts.Count - 1)])))\n    if ($type -eq '5' -or $type -eq '0' -or $type -eq [char]0) {\n      # A name Windows can't take (`:`, `*`, too long...) is left out, with a warning.\n      $out = $null\n      try {\n        if ($type -eq '5') {\n          [void][IO.Directory]::CreateDirectory($path)\n        } else {\n          [void][IO.Directory]::CreateDirectory([IO.Path]::GetDirectoryName($path))\n          $out = [IO.File]::Create($path)\n        }\n      } catch {\n        Write-Warning \"Not copied: $name ($($_.Exception.Message))\"\n        Body $size $null\n        continue\n      }\n      if ($out) {\n        try { Body $size $out } finally { $out.Close() }\n        $files++\n      } else {\n        Body $size $null\n      }\n    } else {\n      if ($type -eq '2') { $links++ }\n      Body $size $null\n    }\n  }\n  $in.Close()\n  if (Test-Path $dest) { Remove-Item $dest -Recurse -Force }\n  Move-Item $new $dest\n  Remove-Item $archive -Force\n  $note = ''\n  if ($links) { $note = \" ($links symbolic links left out)\" }\n  \"$files files in $dest$note\"\n}\nSet-Location C:\\isoloom; & powershell -NoProfile -ExecutionPolicy Bypass -File 'provision/iis.ps1'; if ($LASTEXITCODE) { exit $LASTEXITCODE }\nNew-Item -ItemType Directory -Force C:\\isoloom | Out-Null; Set-Content C:\\isoloom\\ready ready\n"
    destination = "C:/ProgramData/isoloom/setup.ps1"
  }
  provisioner "remote-exec" {
    inline = ["powershell -NoProfile -ExecutionPolicy Bypass -File C:/ProgramData/isoloom/setup.ps1"]
  }
  depends_on = [time_sleep.web01_restart]
}

# The controller (Ansible): every network may reach it, and SSH from allowed_cidr.
resource "aws_security_group" "isoloom_controller" {
  name   = "${local.name}-controller"
  vpc_id = aws_vpc.env.id
  ingress {
    description = "lab"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["192.168.57.0/24"]
  }
  ingress {
    description = "SSH from allowed_cidr"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [var.allowed_cidr]
  }
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_network_interface" "isoloom_controller_lab" {
  subnet_id         = aws_subnet.lab.id
  private_ips       = ["192.168.57.253"]
  security_groups   = [aws_security_group.isoloom_controller.id]
  source_dest_check = false
}

resource "aws_instance" "isoloom_controller" {
  ami              = data.aws_ami.debian_12.id
  instance_type    = "t3.micro"
  key_name         = aws_key_pair.env.key_name
  user_data_base64 = base64gzip("#!/bin/sh\n# Isoloom: this machine sets itself up. Its progress is in /var/lib/isoloom/ready (isoloom-ready/1), its output in /var/log/isoloom-setup.log. The Isothrum runner delivers the project over SSH.\nmkdir -p /var/lib/isoloom\ncat > /var/lib/isoloom/setup.sh.new <<'ISOLOOM_SETUP'\n#!/bin/sh\numask 022\ncase \"$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\" in ready|failed:*) exit 0 ;; esac\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\npart=$(cat /var/lib/isoloom/part 2>/dev/null || echo 1)\nif [ \"$part\" = 1 ]; then\necho 'running: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; { i=0; until [ -f /var/lib/isoloom/project-delivered ]; do i=$((i+5)); if [ $i -gt 2400 ]; then echo 'the project never came: start the lab through the Isothrum runner (run.json), which delivers it over SSH' >&2; exit 1; fi; sleep 5; done; } || { echo 'failed: waiting for the project (the runner delivers it over SSH)' > /var/lib/isoloom/ready; exit 1; }\necho 'running: the controller'\\''s key' > /var/lib/isoloom/ready; { mkdir -p /etc/isoloom && (umask 077 && echo ${base64encode(tls_private_key.controller.private_key_openssh)} | base64 -d > /etc/isoloom/id_ed25519) && chmod 0600 /etc/isoloom/id_ed25519; } || { echo 'failed: the controller'\\''s key' > /var/lib/isoloom/ready; exit 1; }\necho 'running: the inventory' > /var/lib/isoloom/ready; { mkdir -p /etc/isoloom && (umask 077 && echo ${base64encode("[linux]\n\n[windows]\nweb01 ansible_host=192.168.57.10\n\n[linux:vars]\nansible_ssh_private_key_file=/etc/isoloom/id_ed25519\nansible_become=true\n\n[windows:vars]\nansible_user=isoloom\nansible_password=${random_password.windows.result}\nansible_connection=winrm\nansible_port=5985\nansible_winrm_scheme=http\nansible_winrm_transport=basic\nansible_winrm_server_cert_validation=ignore\nansible_winrm_operation_timeout_sec=400\nansible_winrm_read_timeout_sec=500\n")} | base64 -d > /etc/isoloom/inventory.ini) && chmod 0644 /etc/isoloom/inventory.ini; } || { echo 'failed: the inventory' > /var/lib/isoloom/ready; exit 1; }\necho 'running: hosts file' > /var/lib/isoloom/ready; { sh -c 'printf '\\''%s\\n'\\'' '\\''192.168.57.10 web01'\\'' >> /etc/hosts'; } || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }\necho 'running: packages' > /var/lib/isoloom/ready; { sh -c 'DEBIAN_FRONTEND=noninteractive apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq python3-venv curl netcat-openbsd openssh-client >/dev/null'; } || { echo 'failed: packages' > /var/lib/isoloom/ready; exit 1; }\necho 'running: installing Ansible' > /var/lib/isoloom/ready; { sh -c '[ -x /opt/ansible/bin/ansible-playbook ] || { python3 -m venv /opt/ansible && /opt/ansible/bin/pip install -q '\\''ansible-core>=2.15,<2.17'\\'' pywinrm; }'; } || { echo 'failed: installing Ansible' > /var/lib/isoloom/ready; exit 1; }\necho 'running: waiting for the Windows machines' > /var/lib/isoloom/ready; { sh -c 'i=0; until /opt/ansible/bin/ansible -i /etc/isoloom/inventory.ini web01 -m raw -a '\\''if (-not (Test-Path C:\\isoloom\\ready)) { exit 1 }'\\'' >/dev/null 2>&1; do i=$((i+1)); [ $i -gt 360 ] && { echo '\\''web01 not ready'\\''; exit 1; }; sleep 10; done'; } || { echo 'failed: waiting for the Windows machines' > /var/lib/isoloom/ready; exit 1; }\necho 'running: the playbooks' > /var/lib/isoloom/ready; { sh -c 'set -e\nmkdir -p /tmp/isoloom-facts\nexport PATH=\"/opt/ansible/bin:$PATH\" ANSIBLE_HOST_KEY_CHECKING=False ANSIBLE_GATHERING=smart ANSIBLE_FORKS=20 ANSIBLE_PIPELINING=True ANSIBLE_CACHE_PLUGIN=jsonfile ANSIBLE_CACHE_PLUGIN_CONNECTION=/tmp/isoloom-facts ANSIBLE_CACHE_PLUGIN_TIMEOUT=7200\nmkdir -p /tmp/isoloom-retry\nexport ANSIBLE_RETRY_FILES_ENABLED=True ANSIBLE_RETRY_FILES_SAVE_PATH=/tmp/isoloom-retry\n_isoloom_pause=$${ISOLOOM_RETRY_PAUSE:-15}\n_isoloom_attempts=4\n_isoloom_transient='\\''send_input failed|the pipe has been ended|winrmtransporterror|winrmoperationtimeouterror|read timeout|bad http response returned from server|(kerberos|ntlm|credssp).*500|remote end closed connection|connection reset by peer|connection refused|connection aborted|broken pipe|timed out|failed to connect to the host via ssh|shared connection to .* closed'\\''\nretry_download() {\n  _isoloom_n=1\n  until \"$@\"; do\n    [ \"$_isoloom_n\" -lt 5 ] || return 1\n    echo \"isoloom: download failed; trying again in $((_isoloom_n * _isoloom_pause)) s ($((_isoloom_n + 1))/5)\"\n    sleep $((_isoloom_n * _isoloom_pause))\n    _isoloom_n=$((_isoloom_n + 1))\n  done\n}\nplay_hosts() {\n  awk -v transient=\"$_isoloom_transient\" '\\''\n    function commit() {\n      if (pending != \"\") { if (pending_real) real[pending] = 1; else cut[pending] = 1 }\n      pending = \"\"\n    }\n    { gsub(/\\033\\[[0-9;]*m/, \"\") }\n    /^\\.\\.\\.ignoring/ { pending = \"\"; next }\n    { commit() }\n    /^(fatal|failed): \\[/ && !/UNREACHABLE!/ {\n      pending = $0\n      sub(/^(fatal|failed): \\[/, \"\", pending)\n      sub(/\\].*/, \"\", pending)\n      sub(/ -> .*/, \"\", pending)\n      pending_real = (tolower($0) !~ transient)\n      next\n    }\n    /^PLAY RECAP/ { recap = 1; next }\n    recap && / : ok=/ {\n      for (i = 2; i <= NF; i++) {\n        split($i, kv, \"=\")\n        if (kv[1] == \"failed\" && kv[2] > 0) failed[$1] = 1\n        if (kv[1] == \"unreachable\" && kv[2] > 0) unreachable[$1] = 1\n      }\n    }\n    END {\n      commit()\n      for (h in failed) print ((h in real || !(h in cut)) ? \"real \" : \"cut \") h\n      for (h in unreachable) if (!(h in failed)) print \"unreachable \" h\n    }\n  '\\'' \"$1\" | sort\n}\n_isoloom_kind() {\n  echo \"$1\" | awk -v k=\"$2\" '\\''$1 == k { printf \"%s%s\", s, $2; s = \" \" }'\\''\n}\nrun_play() {\n  # The playbook is the last argument; Ansible names its retry file after it.\n  for _isoloom_book; do :; done\n  _isoloom_name=$(basename \"$_isoloom_book\")\n  _isoloom_retry=$${ANSIBLE_RETRY_FILES_SAVE_PATH:-/tmp/isoloom-retry}/$${_isoloom_name%.*}.retry\n  _isoloom_limit=\n  _isoloom_log=$(mktemp)\n  _isoloom_rcf=$(mktemp)\n  _isoloom_n=1\n  rm -f \"$_isoloom_retry\"\n  while :; do\n    { \"$@\" && echo 0 > \"$_isoloom_rcf\" || echo $? > \"$_isoloom_rcf\"; } 2>&1 | tee \"$_isoloom_log\"\n    _isoloom_rc=$(cat \"$_isoloom_rcf\")\n    [ \"$_isoloom_rc\" -ne 0 ] || break\n    _isoloom_hosts=$(play_hosts \"$_isoloom_log\")\n    _isoloom_real=$(_isoloom_kind \"$_isoloom_hosts\" real)\n    _isoloom_gone=$(_isoloom_kind \"$_isoloom_hosts\" unreachable)\n    _isoloom_cut=$(_isoloom_kind \"$_isoloom_hosts\" cut)\n    _isoloom_again=\"$_isoloom_gone$${_isoloom_gone:+$${_isoloom_cut:+ }}$_isoloom_cut\"\n    if [ -n \"$_isoloom_real\" ]; then\n      echo \"isoloom: $_isoloom_name: a task failed on $_isoloom_real: not retried\"\n      break\n    fi\n    if [ -z \"$_isoloom_again\" ]; then\n      echo \"isoloom: $_isoloom_name failed (exit $_isoloom_rc) with no unreachable host or dropped connection: not retried\"\n      break\n    fi\n    if [ \"$_isoloom_n\" -ge \"$_isoloom_attempts\" ]; then\n      echo \"isoloom: $_isoloom_name: still unreachable after $_isoloom_n runs: $_isoloom_again; giving up\"\n      break\n    fi\n    echo \"$_isoloom_again\" | tr '\\'' '\\'' '\\''\\n'\\'' > \"$_isoloom_retry\"\n    if [ -z \"$_isoloom_limit\" ]; then set -- \"$@\" --limit \"@$_isoloom_retry\"; _isoloom_limit=1; fi\n    _isoloom_n=$((_isoloom_n + 1))\n    if [ -n \"$_isoloom_gone\" ]; then\n      _isoloom_wait=$((4 * _isoloom_pause))\n      echo \"isoloom: $_isoloom_name: unreachable: $_isoloom_again; waiting $_isoloom_wait s, then running it again on them ($_isoloom_n/$_isoloom_attempts)\"\n    else\n      _isoloom_wait=$((2 * _isoloom_pause))\n      echo \"isoloom: $_isoloom_name: the play was cut by a dropped connection on $_isoloom_cut; waiting $_isoloom_wait s, then running it again on them ($_isoloom_n/$_isoloom_attempts)\"\n    fi\n    sleep \"$_isoloom_wait\"\n  done\n  rm -f \"$_isoloom_log\" \"$_isoloom_rcf\"\n  [ \"$_isoloom_rc\" -ne 0 ] || rm -f \"$_isoloom_retry\"\n  return \"$_isoloom_rc\"\n}'; } || { echo 'failed: the playbooks' > /var/lib/isoloom/ready; exit 1; }\necho 'running: health check' > /var/lib/isoloom/ready; { sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'; } || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }\nfi\necho ready > /var/lib/isoloom/ready\nrm -f /var/lib/isoloom/part\ncommand -v systemctl >/dev/null && systemctl disable isoloom-setup.service >/dev/null 2>&1\nexit 0\nISOLOOM_SETUP\nmv -f /var/lib/isoloom/setup.sh.new /var/lib/isoloom/setup.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-setup.service <<'ISOLOOM_UNIT'\n[Unit]\nDescription=Isoloom: the machine's set-up\nWants=network-online.target\nAfter=network-online.target cloud-final.service google-startup-scripts.service\n\n[Service]\nType=oneshot\nExecStart=/bin/sh /var/lib/isoloom/setup.sh\nStandardOutput=append:/var/log/isoloom-setup.log\nStandardError=append:/var/log/isoloom-setup.log\nTimeoutStartSec=0\n\n[Install]\nWantedBy=multi-user.target\nISOLOOM_UNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-setup.service >/dev/null 2>&1\nsystemctl start --no-block isoloom-setup.service\nelse\nnohup sh /var/lib/isoloom/setup.sh >> /var/log/isoloom-setup.log 2>&1 &\nfi\n")
  primary_network_interface {
    network_interface_id = aws_network_interface.isoloom_controller_lab.id
  }
  tags = { Name = "${local.name}-controller" }
}

resource "aws_eip" "isoloom_controller" {
  network_interface = aws_network_interface.isoloom_controller_lab.id
  depends_on        = [aws_internet_gateway.env]
}

output "machines" {
  value = { web01 = aws_instance.web01.public_ip }
}

output "address_web01" {
  value = aws_instance.web01.public_ip
}

output "address_isoloom_controller" {
  value = aws_eip.isoloom_controller.public_ip
}

output "ssh_users" {
  value = { web01 = "isoloom" }
}

output "ip" {
  value = aws_eip.isoloom_controller.public_ip
}

output "ready_file" {
  value = "/var/lib/isoloom/ready"
}

# The checks: each runner on the machine it stands for (ssh <user>@<host> '<command>'), or `isoloom test cloud-vm`.
output "checks" {
  value = [
    {
      position = "networks"
      machine  = "controller"
      host     = aws_eip.isoloom_controller.public_ip
      user     = "admin"
      command  = "cd /opt/isoloom && sh .isoloom/cloud-vm/checks/networks.sh"
    }
  ]
}

output "published" {
  value = { "web01/web" = "${aws_instance.web01.public_ip}:8082" }
}

# The project's files the machines don't get: version control and the tools' state, and what
# .isoloomignore at the project's root lists (gitignore-style: one pattern per line, `#` comments,
# `!` brings a path back, a trailing `/` matches folders only, a `/` at the start or in the middle
# anchors the pattern at the root; `*`, `?`, `[abc]`, `**`; the last pattern matching a path, or
# a folder it is in, decides). Read as regular expressions, as the Vagrantfiles do.
locals {
  project_ignore_lines = [for l in split("\n", replace(try(file("${local.root}/.isoloomignore"), ""), "\r", "")) : trimspace(l)]
  project_ignore_pats  = [for l in local.project_ignore_lines : { keep = startswith(l, "!"), pat = trimprefix(l, "!") } if l != "" && !startswith(l, "#")]
  project_ignore_globs = [for r in local.project_ignore_pats : merge(r, { glob = trimsuffix(trimsuffix(trimsuffix(r.pat, "/"), "/**"), "/") })]
  project_ignore = [for r in local.project_ignore_globs : {
    keep = r.keep
    re = format(r.glob == r.pat ? "^%s(/|$)" : "^%s/", replace(replace(replace(replace(replace(replace(replace(replace(
      length(split("/", r.glob)) > 1 ? trimprefix(r.glob, "/") : "**/${r.glob}",
    "/[.+^$(){}|\\\\]/", "\\$0"), "[!", "[^"), "**/", "\u0001"), "**", "\u0002"), "*", "[^/]*"), "?", "[^/]"), "\u0001", "(.*/)?"), "\u0002", ".*"))
  } if r.glob != ""]
  # Each file: whether it goes (the last matching pattern decides; none: it goes).
  project_keep    = { for f in fileset(local.root, "**") : f => reverse(concat([true], [for r in local.project_ignore : r.keep if length(regexall(r.re, f)) > 0]))[0] }
  project_ignored = [for f, keep in local.project_keep : f if !keep]
}

# What `tar` leaves out of the project's archive: .isoloomignore's files, from the archive's top
# folder, their wildcard characters escaped.
resource "local_file" "isoloom_project" {
  filename = "${path.module}/.isoloom-project-ignored.txt"
  content  = join("", [for f in local.project_ignored : "${replace("${basename(local.root)}/${f}", "/[\\\\*?\\[]/", "\\$0")}\n"])
}
