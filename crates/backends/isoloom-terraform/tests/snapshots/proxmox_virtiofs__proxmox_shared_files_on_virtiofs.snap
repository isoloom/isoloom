---
source: crates/backends/isoloom-terraform/tests/proxmox_virtiofs.rs
assertion_line: 45
expression: render(&shared_files()?)?
---
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  terraform -chdir=.isoloom/proxmox init && terraform -chdir=.isoloom/proxmox apply -var proxmox_endpoint=https://<server>:8006/ -var proxmox_api_token=<user@realm!name=secret>
# Stop:   terraform -chdir=.isoloom/proxmox destroy (same variables)

terraform {
  required_version = ">= 1.6"
  backend "local" {}
  required_providers {
    proxmox = { source = "bpg/proxmox", version = "~> 0.115.0" }
    tls     = { source = "hashicorp/tls", version = "~> 4.4.1" }
  }
}

variable "proxmox_endpoint" {
  type        = string
  description = "https://<server>:8006/"
}

variable "proxmox_api_token" {
  type        = string
  default     = ""
  sensitive   = true
  description = "user@realm!name=secret; or use proxmox_username and proxmox_password"
}

variable "proxmox_username" {
  type    = string
  default = "root@pam"
}

variable "proxmox_password" {
  type      = string
  default   = ""
  sensitive = true
}

variable "proxmox_insecure" {
  type        = bool
  default     = true
  description = "Accept the server's self-signed certificate"
}

variable "proxmox_ssh_username" {
  type        = string
  default     = "root"
  description = "Uploading cloud-init snippets goes over SSH to the node"
}

variable "proxmox_ssh_private_key_file" {
  type    = string
  default = ""
}

variable "proxmox_ssh_address" {
  type        = string
  default     = ""
  description = "The node's SSH address, when the API reports one this machine can't reach"
}

variable "node" {
  type        = string
  description = "The Proxmox node the VMs go on (`pvesh get /nodes` lists them)"
  validation {
    condition     = var.node != ""
    error_message = "Set `node` to the Proxmox node the lab's VMs go on (`pvesh get /nodes` lists them)."
  }
}

variable "datastore" {
  type        = string
  default     = "local-lvm"
  description = "Where VM disks go"
}

variable "image_datastore" {
  type        = string
  default     = "local"
  description = "A datastore with 'iso' content, for cloud images"
}

variable "snippets_datastore" {
  type        = string
  default     = "local"
  description = "A datastore with 'snippets' content, for cloud-init"
}

variable "uplink_bridge" {
  type        = string
  default     = "vmbr0"
  description = "The bridge the router reaches the internet through"
}

variable "slot" {
  type        = number
  default     = 1
  description = "1 to 99, unique per environment on this server (SDN ids are short)"
}

variable "ssh_public_key" {
  type        = string
  default     = ""
  description = "Installed for the user `isoloom` on every VM"
}

variable "virtiofs_root" {
  type        = string
  default     = "/srv/isoloom"
  description = "On the node, the folder holding each virtiofs volume's own: <root>/<environment>/<volume>, made before apply"
}

provider "proxmox" {
  endpoint  = var.proxmox_endpoint
  api_token = var.proxmox_api_token != "" ? var.proxmox_api_token : null
  username  = var.proxmox_api_token != "" ? null : var.proxmox_username
  password  = var.proxmox_api_token != "" ? null : var.proxmox_password
  insecure  = var.proxmox_insecure
  ssh {
    agent       = false
    username    = var.proxmox_ssh_username
    password    = var.proxmox_ssh_private_key_file != "" ? null : var.proxmox_password
    private_key = var.proxmox_ssh_private_key_file != "" ? file(var.proxmox_ssh_private_key_file) : null
    dynamic "node" {
      for_each = var.proxmox_ssh_address == "" ? [] : [1]
      content {
        name    = var.node
        address = var.proxmox_ssh_address
      }
    }
  }
}

# The project, written to /opt/isoloom in each machine that has steps; the `isoloom` user on every VM.
locals {
  zone          = "iso${var.slot}"
  root          = abspath("${path.module}/../..")
  project_files = [for f in local.project_paths : { path = "/opt/isoloom/${f}", encoding = "b64", content = filebase64("${local.root}/${f}") }]
  users         = var.ssh_public_key == "" ? [] : [{ name = "isoloom", sudo = "ALL=(ALL) NOPASSWD:ALL", shell = "/bin/bash", ssh_authorized_keys = [var.ssh_public_key] }]
}

# The environment's VMs and containers, together in a pool of their own.
resource "proxmox_virtual_environment_pool" "env" {
  pool_id = local.zone
  comment = "Isoloom: shared-files"
}

# Applies the SDN deletions on destroy, once the zone and its VNets are gone: every SDN object depends on it, so it goes last.
resource "proxmox_sdn_applier" "finalizer" {}

# The environment's networks: an SDN simple zone, a VNet per network.
resource "proxmox_sdn_zone_simple" "env" {
  id         = local.zone
  nodes      = [var.node]
  depends_on = [proxmox_sdn_applier.finalizer]
}

# Network `app`: 10.84.0.0/24
resource "proxmox_sdn_vnet" "app" {
  id   = "i${var.slot}n0"
  zone = proxmox_sdn_zone_simple.env.id
}

# Applies the SDN objects once created, and again whenever one of them is replaced.
resource "proxmox_sdn_applier" "env" {
  lifecycle {
    replace_triggered_by = [proxmox_sdn_zone_simple.env, proxmox_sdn_vnet.app]
  }
  depends_on = [proxmox_sdn_vnet.app]
}

# The `debian-12` cloud image, per environment: a shared file would go with whichever environment is destroyed first.
resource "proxmox_download_file" "debian_12" {
  node_name           = var.node
  datastore_id        = var.image_datastore
  content_type        = "iso"
  url                 = "https://cloud.debian.org/images/cloud/bookworm/latest/debian-12-genericcloud-amd64.qcow2"
  file_name           = "iso${var.slot}-debian-12.img"
  overwrite_unmanaged = true
}

# Network `app`, for the machines' firewall rules.
resource "proxmox_virtual_environment_firewall_ipset" "app" {
  name    = "iso${var.slot}n0"
  comment = "shared-files: network app"
  cidr {
    name = "10.84.0.0/24"
  }
}

# Volume `shared`: a folder of the server, shared into each VM that mounts it (virtiofs). Make the folder on the node first.
resource "proxmox_hardware_mapping_dir" "shared" {
  name    = "iso${var.slot}-shared"
  comment = "Isoloom: shared-files, volume shared"
  map     = [{ node = var.node, path = "${var.virtiofs_root}/shared-files/shared" }]
}

# The router: forwards between networks with the reach rules, and to the internet.
resource "proxmox_virtual_environment_file" "router" {
  node_name    = var.node
  datastore_id = var.snippets_datastore
  content_type = "snippets"
  source_raw {
    file_name = "iso${var.slot}-router.yaml"
    data = format("#cloud-config\n%s", yamlencode({
      hostname = "isoloom-router"
      users    = local.users
      packages = ["nftables", "qemu-guest-agent"]
      write_files = [
        {
          path    = "/etc/systemd/network/10-wan.network"
          content = join("\n", ["[Match]", "MACAddress=${format("02:15:%02x:00:00:00", var.slot)}", "", "[Network]", "DHCP=yes"])
        },
        {
          path    = "/etc/nftables.conf"
          content = "flush ruleset\ntable inet isoloom {\n  chain forward {\n    type filter hook forward priority 0; policy drop;\n    ct state established,related accept\n    ip saddr { 10.84.0.0/24 } ip daddr != { 10.84.0.0/24 } accept\n  }\n  chain prerouting {\n    type nat hook prerouting priority -100;\n  }\n  chain postrouting {\n    type nat hook postrouting priority 100;\n    ip saddr { 10.84.0.0/24 } ip daddr != { 10.84.0.0/24 } masquerade\n  }\n}\n"
        },
        { path = "/etc/sysctl.d/90-isoloom.conf", content = "net.ipv4.ip_forward=1\n" },
        {
          path = "/etc/systemd/network/20-app.network"
          content = join("\n", [
            "[Match]",
            "MACAddress=${format("02:15:%02x:01:%02x:00", var.slot, 0)}",
            "",
            "[Network]",
            "Address=10.84.0.254/24",
            "ConfigureWithoutCarrier=yes"
          ])
        }
      ]
      runcmd = [
        "sysctl -p /etc/sysctl.d/90-isoloom.conf",
        "systemctl enable systemd-networkd",
        "systemctl restart systemd-networkd",
        "systemctl enable --now nftables",
        "nft -f /etc/nftables.conf",
        "systemctl enable --now qemu-guest-agent"
      ]
    }))
  }
}

# The guest agent reports its uplink address (DHCP), for the published ports.
resource "proxmox_virtual_environment_vm" "isoloom_router" {
  name      = "iso${var.slot}-router"
  node_name = var.node
  tags      = ["isoloom", "shared-files"]
  pool_id   = proxmox_virtual_environment_pool.env.pool_id
  on_boot   = false
  agent {
    enabled = true
    timeout = "8m"
    wait_for_ip {
      ipv4 = true
    }
  }
  stop_on_destroy = true
  lifecycle {
    postcondition {
      condition     = length([for a in flatten(self.ipv4_addresses) : a if a != "127.0.0.1" && !contains(["10.84.0.254"], a)]) > 0
      error_message = "VM `router` got no IPv4 address on its uplink bridge `${var.uplink_bridge}` within 8m: the bridge has no DHCP, or no DNS or internet to install qemu-guest-agent, which reports the address. Give it an uplink bridge with DHCP and internet (`uplink_bridge`)."
    }
  }
  cpu {
    cores = 1
    type  = "host"
  }
  memory {
    dedicated = 512
  }
  disk {
    datastore_id = var.datastore
    file_id      = proxmox_download_file.debian_12.id
    interface    = "virtio0"
    size         = 8
  }
  network_device {
    bridge      = var.uplink_bridge
    mac_address = upper(format("02:15:%02x:00:00:00", var.slot))
  }
  network_device {
    bridge      = proxmox_sdn_vnet.app.id
    mac_address = upper(format("02:15:%02x:01:%02x:00", var.slot, 0))
  }
  initialization {
    datastore_id      = var.datastore
    user_data_file_id = proxmox_virtual_environment_file.router.id
    ip_config {
      ipv4 {
        address = "dhcp"
      }
    }
  }
  operating_system {
    type = "l26"
  }
  serial_device {}
  depends_on = [proxmox_sdn_applier.env]
}

# Machine `writer`.
resource "proxmox_virtual_environment_file" "writer" {
  node_name    = var.node
  datastore_id = var.snippets_datastore
  content_type = "snippets"
  source_raw {
    file_name = "iso${var.slot}-writer.yaml"
    data = format("#cloud-config\n%s", yamlencode({
      hostname       = "writer"
      users          = local.users
      packages       = ["nftables", "curl", "netcat-openbsd"]
      device_aliases = { data = "/dev/disk/by-id/virtio-data" }
      disk_setup     = { data = { table_type = "gpt", layout = true, overwrite = false } }
      fs_setup       = [{ label = "data", filesystem = "ext4", device = "data.1" }]
      mounts         = [["LABEL=data", "/srv/data", "ext4", "defaults,nofail", "0", "2"]]
      write_files = concat(local.project_files, [
        {
          path        = "/etc/isoloom/virtiofs/shared"
          permissions = "0644"
          content     = proxmox_hardware_mapping_dir.shared.name
        }
      ])
      runcmd = [
        "mkdir -p /var/lib/isoloom",
        "echo 'running: hosts file' > /var/lib/isoloom/ready && sh -c 'for l in '\\''10.84.0.11 reader'\\''; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done' || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }",
        "echo 'running: shared volume shared' > /var/lib/isoloom/ready && sh -c 'mkdir -p '\\''/srv/shared'\\''\ntag=$(cat '\\''/etc/isoloom/virtiofs/shared'\\'')\ngrep -qF '\\'' /srv/shared virtiofs '\\'' /etc/fstab || printf '\\''%s %s virtiofs defaults,nofail 0 0\\n'\\'' \"$tag\" '\\''/srv/shared'\\'' >> /etc/fstab\nmountpoint -q '\\''/srv/shared'\\'' || mount '\\''/srv/shared'\\'' || { echo '\\''volume shared: the server'\\''\\'\\'''\\''s folder isn'\\''\\'\\'''\\''t shared into this VM (virtiofs): does the mapping'\\''\\'\\'''\\''s folder exist on the node?'\\'' >&2; exit 1; }' || { echo 'failed: shared volume shared' > /var/lib/isoloom/ready; exit 1; }",
        "echo 'running: setup scripts' > /var/lib/isoloom/ready && sh -c '[ -f /var/lib/isoloom/setup.done ] || (\nset -e\nmkdir -p '\\''/opt/isoloom'\\'' && cd '\\''/opt/isoloom'\\''\nsh '\\''/opt/isoloom/steps/write.sh'\\''\nmkdir -p /var/lib/isoloom && touch /var/lib/isoloom/setup.done\n)' || { echo 'failed: setup scripts' > /var/lib/isoloom/ready; exit 1; }",
        "echo 'running: health check' > /var/lib/isoloom/ready && sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready' || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }"
      ]
    }))
  }
}

resource "proxmox_virtual_environment_vm" "writer" {
  name      = "iso${var.slot}-writer"
  node_name = var.node
  tags      = ["isoloom", "shared-files"]
  pool_id   = proxmox_virtual_environment_pool.env.pool_id
  on_boot   = false
  cpu {
    cores = 1
    type  = "host"
  }
  memory {
    dedicated = 1024
  }
  disk {
    datastore_id = var.datastore
    file_id      = proxmox_download_file.debian_12.id
    interface    = "virtio0"
    size         = 20
  }
  disk {
    datastore_id = var.datastore
    interface    = "virtio1"
    size         = 50
    serial       = "data"
    file_format  = "raw"
  }
  network_device {
    bridge   = proxmox_sdn_vnet.app.id
    firewall = true
  }
  virtiofs {
    mapping      = proxmox_hardware_mapping_dir.shared.name
    cache        = "auto"
    direct_io    = false
    expose_xattr = false
    expose_acl   = false
  }
  initialization {
    datastore_id      = var.datastore
    user_data_file_id = proxmox_virtual_environment_file.writer.id
    dns {
      servers = ["1.1.1.1"]
    }
    ip_config {
      ipv4 {
        address = "10.84.0.10/24"
        gateway = "10.84.0.254"
      }
    }
  }
  operating_system {
    type = "l26"
  }
  serial_device {}
  depends_on = [proxmox_virtual_environment_vm.isoloom_router]
}

# Machine `writer`'s firewall: what reaches it, outside the guest.
resource "proxmox_virtual_environment_firewall_options" "writer" {
  node_name     = var.node
  vm_id         = proxmox_virtual_environment_vm.writer.vm_id
  enabled       = true
  input_policy  = "DROP"
  output_policy = "ACCEPT"
}

resource "proxmox_virtual_environment_firewall_rules" "writer" {
  node_name = var.node
  vm_id     = proxmox_virtual_environment_vm.writer.vm_id
  rule {
    type    = "in"
    action  = "ACCEPT"
    comment = "network app"
    source  = "+${proxmox_virtual_environment_firewall_ipset.app.name}"
  }
}

# Machine `reader`.
resource "proxmox_virtual_environment_file" "reader" {
  node_name    = var.node
  datastore_id = var.snippets_datastore
  content_type = "snippets"
  source_raw {
    file_name = "iso${var.slot}-reader.yaml"
    data = format("#cloud-config\n%s", yamlencode({
      hostname = "reader"
      users    = local.users
      packages = ["nftables", "curl", "netcat-openbsd"]
      write_files = concat(local.project_files, [
        {
          path        = "/etc/isoloom/virtiofs/shared"
          permissions = "0644"
          content     = proxmox_hardware_mapping_dir.shared.name
        }
      ])
      runcmd = [
        "mkdir -p /var/lib/isoloom",
        "echo 'running: hosts file' > /var/lib/isoloom/ready && sh -c 'for l in '\\''10.84.0.10 writer'\\''; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done' || { echo 'failed: hosts file' > /var/lib/isoloom/ready; exit 1; }",
        "echo 'running: shared volume shared' > /var/lib/isoloom/ready && sh -c 'mkdir -p '\\''/data/shared'\\''\ntag=$(cat '\\''/etc/isoloom/virtiofs/shared'\\'')\ngrep -qF '\\'' /data/shared virtiofs '\\'' /etc/fstab || printf '\\''%s %s virtiofs defaults,nofail 0 0\\n'\\'' \"$tag\" '\\''/data/shared'\\'' >> /etc/fstab\nmountpoint -q '\\''/data/shared'\\'' || mount '\\''/data/shared'\\'' || { echo '\\''volume shared: the server'\\''\\'\\'''\\''s folder isn'\\''\\'\\'''\\''t shared into this VM (virtiofs): does the mapping'\\''\\'\\'''\\''s folder exist on the node?'\\'' >&2; exit 1; }' || { echo 'failed: shared volume shared' > /var/lib/isoloom/ready; exit 1; }",
        "echo 'running: setup scripts' > /var/lib/isoloom/ready && sh -c '[ -f /var/lib/isoloom/setup.done ] || (\nset -e\nmkdir -p '\\''/opt/isoloom'\\'' && cd '\\''/opt/isoloom'\\''\nsh '\\''/opt/isoloom/steps/look.sh'\\''\nmkdir -p /var/lib/isoloom && touch /var/lib/isoloom/setup.done\n)' || { echo 'failed: setup scripts' > /var/lib/isoloom/ready; exit 1; }",
        "echo 'running: health check' > /var/lib/isoloom/ready && sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready' || { echo 'failed: health check' > /var/lib/isoloom/ready; exit 1; }"
      ]
    }))
  }
}

resource "proxmox_virtual_environment_vm" "reader" {
  name      = "iso${var.slot}-reader"
  node_name = var.node
  tags      = ["isoloom", "shared-files"]
  pool_id   = proxmox_virtual_environment_pool.env.pool_id
  on_boot   = false
  cpu {
    cores = 1
    type  = "host"
  }
  memory {
    dedicated = 1024
  }
  disk {
    datastore_id = var.datastore
    file_id      = proxmox_download_file.debian_12.id
    interface    = "virtio0"
    size         = 20
  }
  network_device {
    bridge   = proxmox_sdn_vnet.app.id
    firewall = true
  }
  virtiofs {
    mapping      = proxmox_hardware_mapping_dir.shared.name
    cache        = "auto"
    direct_io    = false
    expose_xattr = false
    expose_acl   = false
  }
  initialization {
    datastore_id      = var.datastore
    user_data_file_id = proxmox_virtual_environment_file.reader.id
    dns {
      servers = ["1.1.1.1"]
    }
    ip_config {
      ipv4 {
        address = "10.84.0.11/24"
        gateway = "10.84.0.254"
      }
    }
  }
  operating_system {
    type = "l26"
  }
  serial_device {}
  depends_on = [proxmox_virtual_environment_vm.isoloom_router]
}

# Machine `reader`'s firewall: what reaches it, outside the guest.
resource "proxmox_virtual_environment_firewall_options" "reader" {
  node_name     = var.node
  vm_id         = proxmox_virtual_environment_vm.reader.vm_id
  enabled       = true
  input_policy  = "DROP"
  output_policy = "ACCEPT"
}

resource "proxmox_virtual_environment_firewall_rules" "reader" {
  node_name = var.node
  vm_id     = proxmox_virtual_environment_vm.reader.vm_id
  rule {
    type    = "in"
    action  = "ACCEPT"
    comment = "network app"
    source  = "+${proxmox_virtual_environment_firewall_ipset.app.name}"
  }
}

locals {
  router_address = try([for a in flatten(proxmox_virtual_environment_vm.isoloom_router.ipv4_addresses) : a if a != "127.0.0.1" && !contains(["10.84.0.254"], a)][0], "")
}

# The router's uplink address: the lab's way in.
output "ip" {
  value = local.router_address
}

# Each Linux machine's set-up progress (`isoloom-ready/1`: `running: <step>`, `failed: <step>`, `ready`).
output "ready_file" {
  value = "/var/lib/isoloom/ready"
}

# The machines, through the router: ssh -J isoloom@<ip> isoloom@<machine>.
output "machines" {
  value = { writer = "10.84.0.10", reader = "10.84.0.11" }
}

output "ssh_user" {
  value = "isoloom"
}

# The checks: each runner piped to its machine (ssh -J isoloom@<ip> isoloom@<host> sh -s < <script>).
output "checks" {
  value = [
    {
      position = "writer"
      machine  = "writer"
      host     = "10.84.0.10"
      user     = "isoloom"
      script   = ".isoloom/proxmox/checks/writer.sh"
    },
    {
      position = "reader"
      machine  = "reader"
      host     = "10.84.0.11"
      user     = "isoloom"
      script   = ".isoloom/proxmox/checks/reader.sh"
    }
  ]
}

# The project's files the machines don't get: version control and the tools' state, and what
# .isoloomignore at the project's root lists (gitignore-style: one pattern per line, `#` comments,
# `!` brings a path back, a trailing `/` matches folders only, a `/` at the start or in the middle
# anchors the pattern at the root; `*`, `?`, `[abc]`, `**`; the last pattern matching a path, or
# a folder it is in, decides). Read as regular expressions, as the Vagrantfiles do.
locals {
  project_ignore_lines = [for l in split("\n", replace(try(file("${local.root}/.isoloomignore"), ""), "\r", "")) : trimspace(l)]
  project_ignore_pats  = [for l in local.project_ignore_lines : { keep = startswith(l, "!"), pat = trimprefix(l, "!") } if l != "" && !startswith(l, "#")]
  project_ignore_globs = [for r in local.project_ignore_pats : merge(r, { glob = trimsuffix(trimsuffix(trimsuffix(r.pat, "/"), "/**"), "/") })]
  project_ignore = [for r in local.project_ignore_globs : {
    keep = r.keep
    re = format(r.glob == r.pat ? "^%s(/|$)" : "^%s/", replace(replace(replace(replace(replace(replace(replace(replace(
      length(split("/", r.glob)) > 1 ? trimprefix(r.glob, "/") : "**/${r.glob}",
    "/[.+^$(){}|\\\\]/", "\\$0"), "[!", "[^"), "**/", "\u0001"), "**", "\u0002"), "*", "[^/]*"), "?", "[^/]"), "\u0001", "(.*/)?"), "\u0002", ".*"))
  } if r.glob != ""]
  # Each file: whether it goes (the last matching pattern decides; none: it goes).
  project_keep    = { for f in fileset(local.root, "**") : f => reverse(concat([true], [for r in local.project_ignore : r.keep if length(regexall(r.re, f)) > 0]))[0] }
  project_paths   = [for f, keep in local.project_keep : f if keep && length(regexall("^\\.isoloom|(^|/)\\.(git|vagrant|terraform)/", f)) == 0]
  project_ignored = [for f, keep in local.project_keep : f if !keep]
}
