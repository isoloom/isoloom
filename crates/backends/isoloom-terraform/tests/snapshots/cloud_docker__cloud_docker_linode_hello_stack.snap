---
source: crates/backends/isoloom-terraform/tests/cloud_docker.rs
expression: "cloud(\"linode\")?"
---
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Auth:   export LINODE_TOKEN=<token> (the provider reads it).
# Start:  terraform -chdir=.isoloom/cloud-docker/linode init && terraform -chdir=.isoloom/cloud-docker/linode apply \
#           -var allowed_cidr=<your IP>/32 -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)" -var ssh_private_key_file=~/.ssh/id_ed25519
# Stop:   terraform -chdir=.isoloom/cloud-docker/linode destroy (same variables)

terraform {
  required_version = ">= 1.6.0"
  backend "local" {}
  required_providers {
    linode = { source = "linode/linode", version = "~> 4.7.0" }
    local  = { source = "hashicorp/local", version = "~> 2.9.1" }
  }
}

variable "region" {
  type    = string
  default = "fr-par"
}

variable "type" {
  type    = string
  default = "g6-standard-2"
}

variable "allowed_cidr" {
  type        = string
  description = "Who may reach the machines (SSH and the published ports), e.g. your IP/32"
}

variable "ssh_public_key" {
  type        = string
  description = "The SSH public key the machines let in: Terraform signs in with its private half (`ssh_private_key_file`) to set them up or wait for their set-up, and so can you, to run the checks"
}

variable "ssh_private_key_file" {
  type        = string
  description = "The private key of ssh_public_key (a path, ~ allowed): Terraform signs in to the machines with it to bring the project in and wait for their set-up"
}

variable "expires_at" {
  type        = string
  default     = ""
  description = "When the environment should end, in Unix seconds (empty: no end): a tag on every resource, so a reaper finds what to destroy, and the time the machines shut themselves down"
}

provider "linode" {}

resource "terraform_data" "id" {
  input = substr(replace(uuid(), "-", ""), 0, 8)
  lifecycle {
    ignore_changes = [input]
  }
}

locals {
  name = "isoloom-hello-stack-${terraform_data.id.output}"
  root = abspath("${path.module}/../../..")
}

resource "linode_instance" "env" {
  label           = local.name
  region          = var.region
  type            = var.type
  image           = "linode/debian12"
  authorized_keys = [trimspace(var.ssh_public_key)]
  metadata {
    user_data = base64encode("#!/bin/sh\n# Isoloom: this machine sets itself up. Its progress is in /var/lib/isoloom/ready (isoloom-ready/1), its output in /var/log/isoloom-setup.log. The project comes over SSH from Terraform.\nmkdir -p /var/lib/isoloom\nrm -f /var/lib/isoloom/setup.sh.new\n(umask 077 && cat > /var/lib/isoloom/setup.sh.new) <<'ISOLOOM_SETUP'\n#!/bin/sh\numask 022\ne=${var.expires_at}; if [ -n \"$e\" ]; then m=$(( (e - $(date +%s)) / 60 )); [ \"$m\" -ge 1 ] || m=1; shutdown -h \"+$m\" >/dev/null 2>&1 || true; fi\nstate=$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\npart=$(cat /var/lib/isoloom/part 2>/dev/null || echo 1)\ncase \"$state\" in ready|\"failed: \"*) exit 0 ;; esac\nif [ \"$part\" = 1 ]; then\necho 'running: waiting for the project (Terraform brings it in over SSH)' > /var/lib/isoloom/ready; { i=0; until [ -f /var/lib/isoloom/project-delivered ]; do [ \"$i\" -gt 0 ] || echo 'waiting for the project, which Terraform brings in over SSH during its apply'; i=$((i+5)); if [ \"$i\" -gt 2400 ]; then echo 'the project never came: Terraform brings it in over SSH during its apply (its terraform_data.isoloom_ready_<machine>), with ssh_private_key_file' >&2; exit 1; fi; sleep 5; done; } || { echo 'failed: waiting for the project (Terraform brings it in over SSH)' > /var/lib/isoloom/ready; exit 1; }\necho 'running: Docker' > /var/lib/isoloom/ready; { sh -c 'set -e\ncloud-init status --wait >/dev/null 2>&1 || true\ncommand -v docker >/dev/null || if command -v apt-get >/dev/null; then (\n  set -e\n  export DEBIAN_FRONTEND=noninteractive\n  apt-get update -qq\n  apt-get install -y -qq ca-certificates curl\n  install -m 0755 -d /etc/apt/keyrings\n  k=$(mktemp)\n  # shellcheck disable=SC1091,SC2154 # /etc/os-release is on the guest, not here.\n  _id=$(. /etc/os-release && printf %s \"$ID\")\n  # shellcheck disable=SC1091,SC2154\n  _cn=$(. /etc/os-release && printf %s \"$VERSION_CODENAME\")\n  curl -fsSL \"https://download.docker.com/linux/$_id/gpg\" -o \"$k\"\n  echo \"1500c1f56fa9e26b9b8f42452a553675796ade0807cdce11975eb98170b3a570  $k\" | sha256sum -c -\n  install -m 0644 \"$k\" /etc/apt/keyrings/docker.asc\n  rm -f \"$k\"\n  echo \"deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/$_id $_cn stable\" > /etc/apt/sources.list.d/docker.list\n  apt-get update -qq\n  v=$(apt-cache madison docker-ce | awk '\\''$3 ~ /(^|:)29[.]9[.]0/ { print $3; exit }'\\'')\n  [ -n \"$v\" ] || { echo \"docker-ce 29.9.0 is not in Docker'\\''s apt repository\" >&2; exit 1; }\n  apt-get install -y -qq --allow-downgrades \"docker-ce=$v\" \"docker-ce-cli=$v\" containerd.io docker-buildx-plugin \"docker-compose-plugin=5.6.0-*\"\n  # A container pinned to x86 (its spec'\\''s hardware.arch, or an image published for x86 only): on\n  # another CPU (an Apple Silicon Mac'\\''s VM, an Arm cloud VM) the engine runs it through QEMU'\\''s\n  # user-mode emulation, which Debian registers with binfmt for every container (Docker Desktop\n  # does the same on its own).\n  [ \"$(dpkg --print-architecture)\" = amd64 ] || apt-get install -y -qq qemu-user-static binfmt-support\n)\nelse\n  curl -fsSL https://get.docker.com | VERSION=29.9.0 sh\nfi\ncat > /etc/systemd/system/isoloom-published.service <<'\\''UNIT'\\''\n[Unit]\nDescription=Isoloom: published ports reach containers of networks without a default route\nAfter=docker.service\nWants=docker.service\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=/bin/sh -c '\\''iptables -t nat -C POSTROUTING -m conntrack --ctstate DNAT -o br-+ -j MASQUERADE 2>/dev/null || iptables -t nat -I POSTROUTING -m conntrack --ctstate DNAT -o br-+ -j MASQUERADE'\\''\n\n[Install]\nWantedBy=multi-user.target\nUNIT\nsystemctl daemon-reload\nsystemctl enable --now isoloom-published.service\n'; } || { echo 'failed: Docker' > /var/lib/isoloom/ready; exit 1; }\necho 'running: the containers (1)' > /var/lib/isoloom/ready; { sh -c 'cd /opt/isoloom && docker compose --project-name env --file .isoloom/docker/compose.yml up -d --build --wait'; } || { echo 'failed: the containers (1)' > /var/lib/isoloom/ready; exit 1; }\nfi\necho ready > /var/lib/isoloom/ready\nrm -f /var/lib/isoloom/part\nexit 0\nISOLOOM_SETUP\nmv -f /var/lib/isoloom/setup.sh.new /var/lib/isoloom/setup.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-setup.service <<'ISOLOOM_UNIT'\n[Unit]\nDescription=Isoloom: the machine's set-up\nWants=network-online.target\nAfter=network-online.target cloud-final.service google-startup-scripts.service\n\n[Service]\nType=oneshot\nExecStart=/bin/sh /var/lib/isoloom/setup.sh\nStandardOutput=append:/var/log/isoloom-setup.log\nStandardError=append:/var/log/isoloom-setup.log\nTimeoutStartSec=0\n\n[Install]\nWantedBy=multi-user.target\nISOLOOM_UNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-setup.service >/dev/null 2>&1\nsystemctl start --no-block isoloom-setup.service\nelse\nnohup sh /var/lib/isoloom/setup.sh >> /var/log/isoloom-setup.log 2>&1 &\nfi\n")
  }
  tags = concat(["isoloom", "hello-stack", local.name], var.expires_at == "" ? [] : ["isoloom-expires-${var.expires_at}"])
  lifecycle {
    ignore_changes = [metadata[0].user_data]
  }
}

resource "linode_firewall" "env" {
  label           = local.name
  tags            = concat(["isoloom", "hello-stack", local.name], var.expires_at == "" ? [] : ["isoloom-expires-${var.expires_at}"])
  inbound_policy  = "DROP"
  outbound_policy = "ACCEPT"
  inbound {
    label    = "ssh-and-published"
    action   = "ACCEPT"
    protocol = "TCP"
    ports    = "22,8080"
    ipv4     = [var.allowed_cidr]
  }
  linodes = [linode_instance.env.id]
}

resource "terraform_data" "isoloom_ready_docker_host" {
  triggers_replace = [linode_instance.env.id]
  connection {
    type        = "ssh"
    host        = one(linode_instance.env.ipv4)
    user        = "root"
    private_key = file(pathexpand(var.ssh_private_key_file))
    timeout     = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-ready_docker_host.tgz\" --exclude=\"${basename(local.root)}/.isoloom*\" --exclude=\".git\" --exclude=\".terraform\" --exclude=\"*.tfstate\" --exclude=\"*.tfstate.*\" --exclude=\".terraform.tfstate.lock.info\" --exclude=\"crash.log\" --exclude=\"crash.*.log\" --exclude=\".vagrant\" -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-ready_docker_host.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-outputs-docker_host.tgz\" -C \"${abspath(local.root)}\" .isoloom/docker"
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-outputs-docker_host.tgz"
    destination = "/tmp/isoloom-outputs.tgz"
  }
  provisioner "remote-exec" {
    inline = [
      "sh -c 'rm -rf /opt/isoloom && mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz && tar -xzf /tmp/isoloom-outputs.tgz -C /opt/isoloom && rm -f /tmp/isoloom-outputs.tgz && mkdir -p /var/lib/isoloom && touch /var/lib/isoloom/project-delivered'"
    ]
  }
  provisioner "remote-exec" {
    inline = [
      "sh -c 't=0\nif command -v cloud-init >/dev/null 2>&1; then cloud-init status --wait >/dev/null 2>&1 || true; fi\nwhile :; do\ns=$(head -n1 /var/lib/isoloom/ready 2>/dev/null)\ncase \"$s\" in\nready) echo \"docker-host: set up\"; exit 0 ;;\n\"failed: \"*) echo \"docker-host: its set-up stopped ($s); the end of /var/log/isoloom-setup.log:\"; tail -n 40 /var/log/isoloom-setup.log 2>/dev/null; exit 1 ;;\nesac\nif [ \"$t\" -ge 2400 ]; then echo \"docker-host: not set up after 2400 s ($${s:-no ready file}); the end of /var/log/isoloom-setup.log:\"; tail -n 40 /var/log/isoloom-setup.log 2>/dev/null; exit 1; fi\nsleep 5; t=$((t + 5))\ndone'"
    ]
  }
}

output "ip" {
  value = one(linode_instance.env.ipv4)
}

output "ssh_user" {
  value = "root"
}

# The project's files the machines don't get: what .isoloomignore at the project's root lists
# (gitignore-style: one pattern per line, `#` comments, `!` brings a path back, a trailing `/`
# matches folders only, a `/` at the start or in the middle anchors the pattern at the root; `*`,
# `?`, `[abc]`, `**`; the last pattern matching a path, or a folder it is in, decides), then
# Isoloom's outputs, version control and the tools' state. Read as regular expressions, as the
# Vagrantfiles do.
locals {
  project_ignore_lines = [for l in split("\n", "${replace(try(file("${local.root}/.isoloomignore"), ""), "\r", "")}\n/.isoloom*\n.git/\n.terraform/\n*.tfstate\n*.tfstate.*\n.terraform.tfstate.lock.info\ncrash.log\ncrash.*.log\n.vagrant/\n") : trimspace(l)]
  project_ignore_pats  = [for l in local.project_ignore_lines : { keep = startswith(l, "!"), pat = trimprefix(l, "!") } if l != "" && !startswith(l, "#")]
  project_ignore_globs = [for r in local.project_ignore_pats : merge(r, { glob = trimsuffix(trimsuffix(trimsuffix(r.pat, "/"), "/**"), "/") })]
  project_ignore = [for r in local.project_ignore_globs : {
    keep = r.keep
    re = format(r.glob == r.pat ? "^%s(/|$)" : "^%s/", replace(replace(replace(replace(replace(replace(replace(replace(
      length(split("/", r.glob)) > 1 ? trimprefix(r.glob, "/") : "**/${r.glob}",
    "/[.+^$(){}|\\\\]/", "\\$0"), "[!", "[^"), "**/", "\u0001"), "**", "\u0002"), "*", "[^/]*"), "?", "[^/]"), "\u0001", "(.*/)?"), "\u0002", ".*"))
  } if r.glob != ""]
  # Each file: whether it goes (the last matching pattern decides; none: it goes).
  project_keep    = { for f in fileset(local.root, "**") : f => reverse(concat([true], [for r in local.project_ignore : r.keep if length(regexall(r.re, f)) > 0]))[0] }
  project_ignored = [for f, keep in local.project_keep : f if !keep]
}

# What `tar` leaves out of the project's archive: .isoloomignore's files, from the archive's top
# folder, their wildcard characters escaped.
resource "local_file" "isoloom_project" {
  filename = "${path.module}/.isoloom-project-ignored.txt"
  content  = join("", [for f in local.project_ignored : "${replace("${basename(local.root)}/${f}", "/[\\\\*?\\[]/", "\\$0")}\n"])
}
