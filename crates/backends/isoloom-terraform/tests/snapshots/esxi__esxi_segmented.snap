---
source: crates/backends/isoloom-terraform/tests/esxi.rs
expression: "esxi(\"segmented\")?"
---
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Needs:  ovftool on this machine, SSH enabled on the ESXi host
# Start:  terraform -chdir=.isoloom/esxi init && terraform -chdir=.isoloom/esxi apply -var esxi_hostname=<host> -var esxi_password=<password> \
#           -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)" -var ssh_private_key_file=~/.ssh/id_ed25519
# Stop:   terraform -chdir=.isoloom/esxi destroy (same variables)

terraform {
  required_version = ">= 1.6"
  backend "local" {}
  required_providers {
    esxi  = { source = "josenk/esxi", version = "~> 1.10.3" }
    tls   = { source = "hashicorp/tls", version = "~> 4.4.1" }
    local = { source = "hashicorp/local", version = "~> 2.9.1" }
  }
}

variable "esxi_hostname" {
  type        = string
  description = "The ESXi host's name or address"
}

variable "esxi_hostport" {
  type        = string
  default     = "22"
  description = "Its SSH port: the provider works over SSH"
}

variable "esxi_hostssl" {
  type    = string
  default = "443"
}

variable "esxi_username" {
  type    = string
  default = "root"
}

variable "esxi_password" {
  type      = string
  sensitive = true
}

variable "disk_store" {
  type        = string
  default     = "datastore1"
  description = "Where the VMs' disks go"
}

variable "uplink_port_group" {
  type        = string
  default     = "VM Network"
  description = "The port group the router reaches the internet through (DHCP)"
}

variable "slot" {
  type        = number
  default     = 1
  description = "1 to 63, unique per environment on this host: it names the vSwitches and the VMs, and makes the MACs"
  validation {
    condition     = var.slot >= 1 && var.slot <= 63
    error_message = "slot is 1 to 63."
  }
}

variable "images" {
  type = map(string)
  default = {
    "ubuntu-24.04" = "https://cloud-images.ubuntu.com/noble/20260926/noble-server-cloudimg-amd64.ova"
  }
  description = "An OVA per OS, a path or a URL: Ubuntu's cloud OVAs by default; for another OS, an OVA with cloud-init and open-vm-tools"
  validation {
    condition     = alltrue([for os in ["debian-12", "ubuntu-24.04"] : contains(keys(var.images), os)])
    error_message = "images needs an OVA for each of: debian-12, ubuntu-24.04."
  }
}

variable "ssh_public_key" {
  type        = string
  description = "Installed for the user `isoloom` on every VM"
}

variable "ssh_private_key_file" {
  type        = string
  description = "The private key of ssh_public_key: Terraform sets the machines up over SSH, through the router"
}

provider "esxi" {
  esxi_hostname = var.esxi_hostname
  esxi_hostport = var.esxi_hostport
  esxi_hostssl  = var.esxi_hostssl
  esxi_username = var.esxi_username
  esxi_password = var.esxi_password
}

# The project's root, and the `isoloom` user on every VM.
locals {
  root = abspath("${path.module}/../..")
  users = [
    {
      name                = "isoloom"
      sudo                = "ALL=(ALL) NOPASSWD:ALL"
      shell               = "/bin/bash"
      ssh_authorized_keys = [var.ssh_public_key]
    }
  ]
}

# Network `front`: 10.61.10.0/24, on its own vSwitch with no uplink.
resource "esxi_vswitch" "front" {
  name = "iso${var.slot}-front"
}

resource "esxi_portgroup" "front" {
  name    = "iso${var.slot}-front"
  vswitch = esxi_vswitch.front.name
  vlan    = 4095
}

# Network `back`: 10.61.20.0/24, on its own vSwitch with no uplink.
resource "esxi_vswitch" "back" {
  name = "iso${var.slot}-back"
}

resource "esxi_portgroup" "back" {
  name    = "iso${var.slot}-back"
  vswitch = esxi_vswitch.back.name
  vlan    = 4095
}

# Network `access`: 10.61.99.0/24, on its own vSwitch with no uplink.
resource "esxi_vswitch" "access" {
  name = "iso${var.slot}-access"
}

resource "esxi_portgroup" "access" {
  name    = "iso${var.slot}-access"
  vswitch = esxi_vswitch.access.name
  vlan    = 4095
}

# The router: forwards between networks with the reach rules, and to the internet. VMware Tools reports its uplink address.
resource "esxi_guest" "isoloom_router" {
  guest_name            = "iso${var.slot}-router"
  notes                 = "isoloom: segmented"
  disk_store            = var.disk_store
  ovf_source            = var.images["ubuntu-24.04"]
  numvcpus              = "1"
  memsize               = "512"
  boot_disk_size        = "10"
  power                 = "on"
  guest_startup_timeout = 600
  network_interfaces {
    virtual_network = var.uplink_port_group
    mac_address     = format("00:50:56:%02x:%02x:%02x", var.slot, 0, 0)
    nic_type        = "vmxnet3"
  }
  network_interfaces {
    virtual_network = esxi_portgroup.front.name
    mac_address     = format("00:50:56:%02x:%02x:%02x", var.slot, 0, 1)
    nic_type        = "vmxnet3"
  }
  network_interfaces {
    virtual_network = esxi_portgroup.back.name
    mac_address     = format("00:50:56:%02x:%02x:%02x", var.slot, 0, 2)
    nic_type        = "vmxnet3"
  }
  network_interfaces {
    virtual_network = esxi_portgroup.access.name
    mac_address     = format("00:50:56:%02x:%02x:%02x", var.slot, 0, 3)
    nic_type        = "vmxnet3"
  }
  guestinfo = {
    metadata = base64encode(yamlencode({
      instance-id    = "iso${var.slot}-router"
      local-hostname = "router"
      network = {
        version = 2
        ethernets = {
          nic0 = { match = { macaddress = format("00:50:56:%02x:%02x:%02x", var.slot, 0, 0) }, dhcp4 = true }
          nic1 = {
            match     = { macaddress = format("00:50:56:%02x:%02x:%02x", var.slot, 0, 1) }
            addresses = ["10.61.10.254/24"]
          }
          nic2 = {
            match     = { macaddress = format("00:50:56:%02x:%02x:%02x", var.slot, 0, 2) }
            addresses = ["10.61.20.254/24"]
          }
          nic3 = {
            match     = { macaddress = format("00:50:56:%02x:%02x:%02x", var.slot, 0, 3) }
            addresses = ["10.61.99.254/24"]
          }
        }
      }
    }))
    "metadata.encoding" = "base64"
    userdata = base64encode(format("#cloud-config\n%s", yamlencode({
      hostname = "isoloom-router"
      users    = local.users
      packages = ["nftables"]
      write_files = [
        {
          path    = "/etc/nftables.conf"
          content = "flush ruleset\ntable inet isoloom {\n  chain forward {\n    type filter hook forward priority 0; policy drop;\n    ct state established,related accept\n    ip saddr 10.61.99.0/24 ip daddr 10.61.10.0/24 accept\n    ip saddr 10.61.10.0/24 ip daddr 10.61.20.0/24 meta l4proto { tcp, udp } th dport { 6379 } accept\n    ip saddr 10.61.10.0/24 ip daddr 10.61.20.0/24 icmp type echo-request accept\n    ip saddr { 10.61.10.0/24, 10.61.20.0/24, 10.61.99.0/24 } ip daddr != { 10.61.10.0/24, 10.61.20.0/24, 10.61.99.0/24 } accept\n  }\n  chain prerouting {\n    type nat hook prerouting priority -100;\n  }\n  chain postrouting {\n    type nat hook postrouting priority 100;\n    ip saddr { 10.61.10.0/24, 10.61.20.0/24, 10.61.99.0/24 } ip daddr != { 10.61.10.0/24, 10.61.20.0/24, 10.61.99.0/24 } masquerade\n  }\n}\n"
        },
        { path = "/etc/sysctl.d/90-isoloom.conf", content = "net.ipv4.ip_forward=1\n" },
        {
          path    = "/etc/nftables.sealed.nft"
          content = "flush ruleset\ntable inet isoloom {\n  chain forward {\n    type filter hook forward priority 0; policy drop;\n    ct state established,related accept\n    ip saddr 10.61.99.0/24 ip daddr 10.61.10.0/24 accept\n    ip saddr 10.61.10.0/24 ip daddr 10.61.20.0/24 meta l4proto { tcp, udp } th dport { 6379 } accept\n    ip saddr 10.61.10.0/24 ip daddr 10.61.20.0/24 icmp type echo-request accept\n    ip daddr { 10.61.20.0/24 } drop\n    ip saddr { 10.61.10.0/24, 10.61.99.0/24 } ip daddr != { 10.61.10.0/24, 10.61.99.0/24 } accept\n  }\n  chain prerouting {\n    type nat hook prerouting priority -100;\n  }\n  chain postrouting {\n    type nat hook postrouting priority 100;\n    ip saddr { 10.61.10.0/24, 10.61.99.0/24 } ip daddr != { 10.61.10.0/24, 10.61.99.0/24 } masquerade\n  }\n}\n"
        }
      ]
      runcmd = [
        "sysctl -p /etc/sysctl.d/90-isoloom.conf",
        "systemctl enable --now nftables",
        "nft -f /etc/nftables.conf"
      ]
    })))
    "userdata.encoding" = "base64"
  }
  lifecycle {
    postcondition {
      condition     = self.ip_address != "" && !contains(["10.61.10.254", "10.61.20.254", "10.61.99.254"], self.ip_address)
      error_message = "The router got no address on its uplink port group `${var.uplink_port_group}`: it has no DHCP (VMware Tools then reports a lab address). Give it an uplink with DHCP and internet (`uplink_port_group`; on a nested ESXi, promiscuous mode on)."
    }
  }
  depends_on = [esxi_portgroup.front, esxi_portgroup.back, esxi_portgroup.access]
}

# Machine `cache`.
resource "esxi_guest" "cache" {
  guest_name     = "iso${var.slot}-cache"
  notes          = "isoloom: segmented"
  disk_store     = var.disk_store
  ovf_source     = var.images["debian-12"]
  numvcpus       = "1"
  memsize        = "1024"
  boot_disk_size = "10"
  power          = "on"
  network_interfaces {
    virtual_network = esxi_portgroup.back.name
    mac_address     = format("00:50:56:%02x:%02x:%02x", var.slot, 2, 0)
    nic_type        = "vmxnet3"
  }
  guestinfo = {
    metadata = base64encode(yamlencode({
      instance-id    = "iso${var.slot}-cache"
      local-hostname = "cache"
      network = {
        version = 2
        ethernets = {
          nic0 = {
            match       = { macaddress = format("00:50:56:%02x:%02x:%02x", var.slot, 2, 0) }
            addresses   = ["10.61.20.20/24"]
            routes      = [{ to = "0.0.0.0/0", via = "10.61.20.254" }]
            nameservers = { addresses = ["1.1.1.1"] }
          }
        }
      }
    }))
    "metadata.encoding" = "base64"
    userdata            = base64encode(format("#cloud-config\n%s", yamlencode({ hostname = "cache", users = local.users })))
    "userdata.encoding" = "base64"
  }
  depends_on = [esxi_guest.isoloom_router]
}

# Its set-up: its steps from the plan, over SSH through the router.
resource "terraform_data" "cache" {
  triggers_replace = [esxi_guest.cache.id]
  connection {
    type                = "ssh"
    host                = "10.61.20.20"
    user                = "isoloom"
    private_key         = file(pathexpand(var.ssh_private_key_file))
    bastion_host        = local.router_address
    bastion_user        = "isoloom"
    bastion_private_key = file(pathexpand(var.ssh_private_key_file))
    timeout             = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-cache.tgz\" --exclude=.git --exclude=.vagrant --exclude=.terraform --exclude=.isoloom-project* -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-cache.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "remote-exec" {
    inline = [
      "set -e",
      "cloud-init status --wait >/dev/null 2>&1 || true",
      "sudo sh -c 'mkdir -p /var/lib/isoloom'",
      "sudo sh -c 'echo '\\''running: growing the disk'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'set -e\npart_grow() {\n  dev=$(readlink -f \"$1\")\n  disk=/dev/$(lsblk -no PKNAME \"$dev\" | head -n1)\n  num=$(cat \"/sys/class/block/$(basename \"$dev\")/partition\")\n  if command -v growpart >/dev/null; then growpart \"$disk\" \"$num\" >/dev/null || true\n  else echo \", +\" | sfdisk --no-reread -N \"$num\" \"$disk\" >/dev/null 2>&1 && partx -u \"$disk\" || true; fi\n}\nfs_grow() { resize2fs \"$1\" >/dev/null 2>&1 || xfs_growfs / >/dev/null 2>&1 || true; }\nsrc=$(findmnt -n -o SOURCE /)\ncase \"$(lsblk -no TYPE \"$src\" | head -n1)\" in\n  lvm)\n    vg=$(lvs --noheadings -o vg_name \"$src\" | tr -d '\\'' '\\'')\n    for pv in $(pvs --noheadings -o pv_name -S vg_name=\"$vg\" | tr -d '\\'' '\\''); do part_grow \"$pv\"; pvresize \"$pv\" >/dev/null; done\n    lvextend -l +100%FREE \"$src\" >/dev/null 2>&1 || true\n    fs_grow \"$src\" ;;\n  part) part_grow \"$src\"; fs_grow \"$src\" ;;\nesac' || { sudo sh -c 'echo '\\''failed: growing the disk'\\'' > /var/lib/isoloom/ready'; exit 1; }",
      "sudo sh -c 'echo '\\''running: set-up'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz' || { sudo sh -c 'echo '\\''failed: set-up'\\'' > /var/lib/isoloom/ready'; exit 1; }",
      "sudo sh -c 'echo '\\''running: hosts file'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'printf '\\''%s\\n'\\'' '\\''10.61.20.20 cache'\\'' '\\''10.61.10.10 web'\\'' '\\''10.61.99.10 user'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done' || { sudo sh -c 'echo '\\''failed: hosts file'\\'' > /var/lib/isoloom/ready'; exit 1; }",
      "sudo sh -c 'echo '\\''running: routes'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'ip route replace 10.61.10.0/24 via 10.61.20.254\nip route replace 10.61.99.0/24 via 10.61.20.254' || { sudo sh -c 'echo '\\''failed: routes'\\'' > /var/lib/isoloom/ready'; exit 1; }",
      "sudo sh -c 'echo '\\''running: volume folders'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'mkdir -p '\\''/data'\\''' || { sudo sh -c 'echo '\\''failed: volume folders'\\'' > /var/lib/isoloom/ready'; exit 1; }",
      "sudo sh -c 'echo '\\''running: provision/cache.sh'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'cd /opt/isoloom && sh -c '\\''sh provision/cache.sh'\\''' || { sudo sh -c 'echo '\\''failed: provision/cache.sh'\\'' > /var/lib/isoloom/ready'; exit 1; }",
      "sudo sh -c 'echo '\\''running: closing the internet'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'pkg() { if command -v apt-get >/dev/null; then apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \"$@\"; elif command -v dnf >/dev/null; then dnf install -y -q \"$@\"; else yum install -y -q \"$@\"; fi; }\ncommand -v nft >/dev/null || if command -v apk >/dev/null; then apk add -q --no-cache nftables; else pkg nftables; fi\nprintf '\\''%s\\n'\\'' '\\''table inet isoloom-egress'\\'' '\\''delete table inet isoloom-egress'\\'' '\\''table inet isoloom-egress {'\\'' '\\''  chain output {'\\'' '\\''    type filter hook output priority 0; policy accept;'\\'' '\\''    oifname \"lo\" accept'\\'' '\\''    ip daddr != { 10.61.10.0/24, 10.61.20.0/24, 10.61.99.0/24 } ct state new drop'\\'' '\\''  }'\\'' '\\''}'\\'' > /etc/isoloom-egress.nft\nmkdir -p /etc/isoloom\ncat > /etc/isoloom/egress.sh <<'\\''EGRESS'\\''\n#!/bin/sh\n# No new connection leaves the isoloom networks\nnft -f /etc/isoloom-egress.nft\nexit 0\nEGRESS\nchmod +x /etc/isoloom/egress.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-egress.service <<'\\''UNIT'\\''\n[Unit]\nDescription=No new connection leaves the isoloom networks\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=-/etc/isoloom/egress.sh\n\n[Install]\nWantedBy=multi-user.target\nUNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-egress.service\nsystemctl restart isoloom-egress.service\nelse\nmkdir -p /etc/local.d && ln -sf /etc/isoloom/egress.sh /etc/local.d/isoloom-egress.start\nrc-update add local default >/dev/null 2>&1 || true\n/etc/isoloom/egress.sh || true\nfi' || { sudo sh -c 'echo '\\''failed: closing the internet'\\'' > /var/lib/isoloom/ready'; exit 1; }",
      "sudo sh -c 'echo '\\''running: health check'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready' || { sudo sh -c 'echo '\\''failed: health check'\\'' > /var/lib/isoloom/ready'; exit 1; }"
    ]
  }
}

# Machine `web`.
resource "esxi_guest" "web" {
  guest_name     = "iso${var.slot}-web"
  notes          = "isoloom: segmented"
  disk_store     = var.disk_store
  ovf_source     = var.images["debian-12"]
  numvcpus       = "1"
  memsize        = "1024"
  boot_disk_size = "20"
  power          = "on"
  network_interfaces {
    virtual_network = esxi_portgroup.front.name
    mac_address     = format("00:50:56:%02x:%02x:%02x", var.slot, 3, 0)
    nic_type        = "vmxnet3"
  }
  guestinfo = {
    metadata = base64encode(yamlencode({
      instance-id    = "iso${var.slot}-web"
      local-hostname = "web"
      network = {
        version = 2
        ethernets = {
          nic0 = {
            match       = { macaddress = format("00:50:56:%02x:%02x:%02x", var.slot, 3, 0) }
            addresses   = ["10.61.10.10/24"]
            routes      = [{ to = "0.0.0.0/0", via = "10.61.10.254" }]
            nameservers = { addresses = ["1.1.1.1"] }
          }
        }
      }
    }))
    "metadata.encoding" = "base64"
    userdata            = base64encode(format("#cloud-config\n%s", yamlencode({ hostname = "web", users = local.users })))
    "userdata.encoding" = "base64"
  }
  depends_on = [esxi_guest.isoloom_router]
}

# Its set-up: its steps from the plan, over SSH through the router.
resource "terraform_data" "web" {
  triggers_replace = [esxi_guest.web.id]
  connection {
    type                = "ssh"
    host                = "10.61.10.10"
    user                = "isoloom"
    private_key         = file(pathexpand(var.ssh_private_key_file))
    bastion_host        = local.router_address
    bastion_user        = "isoloom"
    bastion_private_key = file(pathexpand(var.ssh_private_key_file))
    timeout             = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-web.tgz\" --exclude=.git --exclude=.vagrant --exclude=.terraform --exclude=.isoloom-project* -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-web.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "remote-exec" {
    inline = [
      "set -e",
      "cloud-init status --wait >/dev/null 2>&1 || true",
      "sudo sh -c 'mkdir -p /var/lib/isoloom'",
      "sudo sh -c 'echo '\\''running: set-up'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz' || { sudo sh -c 'echo '\\''failed: set-up'\\'' > /var/lib/isoloom/ready'; exit 1; }",
      "sudo sh -c 'echo '\\''running: hosts file'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'printf '\\''%s\\n'\\'' '\\''10.61.20.20 cache'\\'' '\\''10.61.10.10 web'\\'' '\\''10.61.99.10 user'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done' || { sudo sh -c 'echo '\\''failed: hosts file'\\'' > /var/lib/isoloom/ready'; exit 1; }",
      "sudo sh -c 'echo '\\''running: routes'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'ip route replace 10.61.20.0/24 via 10.61.10.254\nip route replace 10.61.99.0/24 via 10.61.10.254' || { sudo sh -c 'echo '\\''failed: routes'\\'' > /var/lib/isoloom/ready'; exit 1; }",
      "sudo sh -c 'echo '\\''running: waiting for cache'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'i=0; until (bash -c '\\''</dev/tcp/cache/6379'\\'' 2>/dev/null || nc -z -w 2 cache 6379 2>/dev/null); do i=$((i+2)); if [ $i -ge 900 ]; then echo \"cache didn'\\''t answer within 900s\" >&2; exit 1; fi; sleep 2; done; echo \"cache answers\"' || { sudo sh -c 'echo '\\''failed: waiting for cache'\\'' > /var/lib/isoloom/ready'; exit 1; }",
      "sudo sh -c 'echo '\\''running: provision/web.sh'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'cd /opt/isoloom && sh -c '\\''sh provision/web.sh'\\''' || { sudo sh -c 'echo '\\''failed: provision/web.sh'\\'' > /var/lib/isoloom/ready'; exit 1; }",
      "sudo sh -c 'echo '\\''running: health check'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready' || { sudo sh -c 'echo '\\''failed: health check'\\'' > /var/lib/isoloom/ready'; exit 1; }"
    ]
  }
  depends_on = [terraform_data.cache]
}

# Machine `user`.
resource "esxi_guest" "user" {
  guest_name     = "iso${var.slot}-user"
  notes          = "isoloom: segmented"
  disk_store     = var.disk_store
  ovf_source     = var.images["debian-12"]
  numvcpus       = "1"
  memsize        = "1024"
  boot_disk_size = "20"
  power          = "on"
  network_interfaces {
    virtual_network = esxi_portgroup.access.name
    mac_address     = format("00:50:56:%02x:%02x:%02x", var.slot, 4, 0)
    nic_type        = "vmxnet3"
  }
  guestinfo = {
    metadata = base64encode(yamlencode({
      instance-id    = "iso${var.slot}-user"
      local-hostname = "user"
      network = {
        version = 2
        ethernets = {
          nic0 = {
            match       = { macaddress = format("00:50:56:%02x:%02x:%02x", var.slot, 4, 0) }
            addresses   = ["10.61.99.10/24"]
            routes      = [{ to = "0.0.0.0/0", via = "10.61.99.254" }]
            nameservers = { addresses = ["1.1.1.1"] }
          }
        }
      }
    }))
    "metadata.encoding" = "base64"
    userdata            = base64encode(format("#cloud-config\n%s", yamlencode({ hostname = "user", users = local.users })))
    "userdata.encoding" = "base64"
  }
  depends_on = [esxi_guest.isoloom_router]
}

# Its set-up: its steps from the plan, over SSH through the router.
resource "terraform_data" "user" {
  triggers_replace = [esxi_guest.user.id]
  connection {
    type                = "ssh"
    host                = "10.61.99.10"
    user                = "isoloom"
    private_key         = file(pathexpand(var.ssh_private_key_file))
    bastion_host        = local.router_address
    bastion_user        = "isoloom"
    bastion_private_key = file(pathexpand(var.ssh_private_key_file))
    timeout             = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-user.tgz\" --exclude=.git --exclude=.vagrant --exclude=.terraform --exclude=.isoloom-project* -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-user.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "remote-exec" {
    inline = [
      "set -e",
      "cloud-init status --wait >/dev/null 2>&1 || true",
      "sudo sh -c 'mkdir -p /var/lib/isoloom'",
      "sudo sh -c 'echo '\\''running: set-up'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz' || { sudo sh -c 'echo '\\''failed: set-up'\\'' > /var/lib/isoloom/ready'; exit 1; }",
      "sudo sh -c 'echo '\\''running: hosts file'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'printf '\\''%s\\n'\\'' '\\''10.61.20.20 cache'\\'' '\\''10.61.10.10 web'\\'' '\\''10.61.99.10 user'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done' || { sudo sh -c 'echo '\\''failed: hosts file'\\'' > /var/lib/isoloom/ready'; exit 1; }",
      "sudo sh -c 'echo '\\''running: routes'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'ip route replace 10.61.10.0/24 via 10.61.99.254\nip route replace 10.61.20.0/24 via 10.61.99.254' || { sudo sh -c 'echo '\\''failed: routes'\\'' > /var/lib/isoloom/ready'; exit 1; }",
      "sudo sh -c 'echo '\\''running: health check'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready' || { sudo sh -c 'echo '\\''failed: health check'\\'' > /var/lib/isoloom/ready'; exit 1; }"
    ]
  }
}

locals {
  router_address = esxi_guest.isoloom_router.ip_address
}

# The router's uplink address: the lab's way in.
output "ip" {
  value = local.router_address
}

# Each Linux machine's set-up progress (`isoloom-ready/1`: `running: <step>`, `failed: <step>`, `ready`).
output "ready_file" {
  value = "/var/lib/isoloom/ready"
}

# The machines, through the router: ssh -J isoloom@<ip> isoloom@<machine>.
output "machines" {
  value = { cache = "10.61.20.20", web = "10.61.10.10", user = "10.61.99.10" }
}

output "ssh_user" {
  value = "isoloom"
}

# The checks: each runner piped to its machine (ssh -J isoloom@<ip> isoloom@<host> sh -s < <script>).
output "checks" {
  value = [
    {
      position = "user"
      machine  = "user"
      host     = "10.61.99.10"
      user     = "isoloom"
      script   = ".isoloom/esxi/checks/user.sh"
    },
    {
      position = "cache"
      machine  = "cache"
      host     = "10.61.20.20"
      user     = "isoloom"
      script   = ".isoloom/esxi/checks/cache.sh"
    },
    {
      position = "web"
      machine  = "web"
      host     = "10.61.10.10"
      user     = "isoloom"
      script   = ".isoloom/esxi/checks/web.sh"
    }
  ]
}

# The project's files the machines don't get: version control and the tools' state, and what
# .isoloomignore at the project's root lists (gitignore-style: one pattern per line, `#` comments,
# `!` brings a path back, a trailing `/` matches folders only, a `/` at the start or in the middle
# anchors the pattern at the root; `*`, `?`, `[abc]`, `**`; the last pattern matching a path, or
# a folder it is in, decides). Read as regular expressions, as the Vagrantfiles do.
locals {
  project_ignore_lines = [for l in split("\n", replace(try(file("${local.root}/.isoloomignore"), ""), "\r", "")) : trimspace(l)]
  project_ignore_pats  = [for l in local.project_ignore_lines : { keep = startswith(l, "!"), pat = trimprefix(l, "!") } if l != "" && !startswith(l, "#")]
  project_ignore_globs = [for r in local.project_ignore_pats : merge(r, { glob = trimsuffix(trimsuffix(trimsuffix(r.pat, "/"), "/**"), "/") })]
  project_ignore = [for r in local.project_ignore_globs : {
    keep = r.keep
    re = format(r.glob == r.pat ? "^%s(/|$)" : "^%s/", replace(replace(replace(replace(replace(replace(replace(replace(
      length(split("/", r.glob)) > 1 ? trimprefix(r.glob, "/") : "**/${r.glob}",
    "/[.+^$(){}|\\\\]/", "\\$0"), "[!", "[^"), "**/", "\u0001"), "**", "\u0002"), "*", "[^/]*"), "?", "[^/]"), "\u0001", "(.*/)?"), "\u0002", ".*"))
  } if r.glob != ""]
  # Each file: whether it goes (the last matching pattern decides; none: it goes).
  project_keep    = { for f in fileset(local.root, "**") : f => reverse(concat([true], [for r in local.project_ignore : r.keep if length(regexall(r.re, f)) > 0]))[0] }
  project_ignored = [for f, keep in local.project_keep : f if !keep]
}

# What `tar` leaves out of the project's archive: .isoloomignore's files, from the archive's top
# folder, their wildcard characters escaped.
resource "local_file" "isoloom_project" {
  filename = "${path.module}/.isoloom-project-ignored.txt"
  content  = join("", [for f in local.project_ignored : "${replace("${basename(local.root)}/${f}", "/[\\\\*?\\[]/", "\\$0")}\n"])
}
