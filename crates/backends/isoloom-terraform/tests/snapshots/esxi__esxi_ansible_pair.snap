---
source: crates/backends/isoloom-terraform/tests/esxi.rs
expression: "esxi(\"ansible-pair\")?"
---
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Needs:  ovftool on this machine, SSH enabled on the ESXi host
# Start:  terraform -chdir=.isoloom/esxi init && terraform -chdir=.isoloom/esxi apply -var esxi_hostname=<host> -var esxi_password=<password> \
#           -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)" -var ssh_private_key_file=~/.ssh/id_ed25519
# Stop:   terraform -chdir=.isoloom/esxi destroy (same variables)

terraform {
  required_version = ">= 1.6"
  backend "local" {}
  required_providers {
    esxi  = { source = "josenk/esxi", version = "~> 1.10.3" }
    tls   = { source = "hashicorp/tls", version = "~> 4.4.1" }
    local = { source = "hashicorp/local", version = "~> 2.9.1" }
  }
}

variable "esxi_hostname" {
  type        = string
  description = "The ESXi host's name or address"
}

variable "esxi_hostport" {
  type        = string
  default     = "22"
  description = "Its SSH port: the provider works over SSH"
}

variable "esxi_hostssl" {
  type    = string
  default = "443"
}

variable "esxi_username" {
  type    = string
  default = "root"
}

variable "esxi_password" {
  type      = string
  sensitive = true
}

variable "disk_store" {
  type        = string
  default     = "datastore1"
  description = "Where the VMs' disks go"
}

variable "uplink_port_group" {
  type        = string
  default     = "VM Network"
  description = "The port group the router reaches the internet through (DHCP)"
}

variable "slot" {
  type        = number
  default     = 1
  description = "1 to 63, unique per environment on this host: it names the vSwitches and the VMs, and makes the MACs"
  validation {
    condition     = var.slot >= 1 && var.slot <= 63
    error_message = "slot is 1 to 63."
  }
}

variable "images" {
  type        = map(string)
  default     = { "ubuntu-24.04" = "https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.ova" }
  description = "An OVA per OS, a path or a URL: Ubuntu's cloud OVAs by default; for another OS, an OVA with cloud-init and open-vm-tools"
  validation {
    condition     = alltrue([for os in ["debian-12", "ubuntu-24.04"] : contains(keys(var.images), os)])
    error_message = "images needs an OVA for each of: debian-12, ubuntu-24.04."
  }
}

variable "ssh_public_key" {
  type        = string
  description = "Installed for the user `isoloom` on every VM"
}

variable "ssh_private_key_file" {
  type        = string
  description = "The private key of ssh_public_key: Terraform sets the machines up over SSH, through the router"
}

provider "esxi" {
  esxi_hostname = var.esxi_hostname
  esxi_hostport = var.esxi_hostport
  esxi_hostssl  = var.esxi_hostssl
  esxi_username = var.esxi_username
  esxi_password = var.esxi_password
}

# The project's root, and the `isoloom` user on every VM.
locals {
  root = abspath("${path.module}/../..")
  users = [
    {
      name                = "isoloom"
      sudo                = "ALL=(ALL) NOPASSWD:ALL"
      shell               = "/bin/bash"
      ssh_authorized_keys = [var.ssh_public_key]
    }
  ]
}

# The controller's own key: it runs the playbooks over SSH on every machine.
resource "tls_private_key" "controller" {
  algorithm = "ED25519"
}

# Network `lab`: 10.63.0.0/24, on its own vSwitch with no uplink.
resource "esxi_vswitch" "lab" {
  name = "iso${var.slot}-lab"
}

resource "esxi_portgroup" "lab" {
  name    = "iso${var.slot}-lab"
  vswitch = esxi_vswitch.lab.name
  vlan    = 4095
}

# The router: forwards between networks with the reach rules, and to the internet. VMware Tools reports its uplink address.
resource "esxi_guest" "isoloom_router" {
  guest_name            = "iso${var.slot}-router"
  notes                 = "isoloom: ansible-pair"
  disk_store            = var.disk_store
  ovf_source            = var.images["ubuntu-24.04"]
  numvcpus              = "1"
  memsize               = "512"
  boot_disk_size        = "10"
  power                 = "on"
  guest_startup_timeout = 600
  network_interfaces {
    virtual_network = var.uplink_port_group
    mac_address     = format("00:50:56:%02x:%02x:%02x", var.slot, 0, 0)
    nic_type        = "vmxnet3"
  }
  network_interfaces {
    virtual_network = esxi_portgroup.lab.name
    mac_address     = format("00:50:56:%02x:%02x:%02x", var.slot, 0, 1)
    nic_type        = "vmxnet3"
  }
  guestinfo = {
    metadata = base64encode(yamlencode({
      instance-id    = "iso${var.slot}-router"
      local-hostname = "router"
      network = {
        version = 2
        ethernets = {
          nic0 = { match = { macaddress = format("00:50:56:%02x:%02x:%02x", var.slot, 0, 0) }, dhcp4 = true }
          nic1 = {
            match     = { macaddress = format("00:50:56:%02x:%02x:%02x", var.slot, 0, 1) }
            addresses = ["10.63.0.254/24"]
          }
        }
      }
    }))
    "metadata.encoding" = "base64"
    userdata = base64encode(format("#cloud-config\n%s", yamlencode({
      hostname = "isoloom-router"
      users    = local.users
      packages = ["nftables"]
      write_files = [
        {
          path    = "/etc/nftables.conf"
          content = "flush ruleset\ntable inet isoloom {\n  chain forward {\n    type filter hook forward priority 0; policy drop;\n    ct state established,related accept\n    ip saddr { 10.63.0.0/24 } ip daddr != { 10.63.0.0/24 } accept\n  }\n  chain prerouting {\n    type nat hook prerouting priority -100;\n  }\n  chain postrouting {\n    type nat hook postrouting priority 100;\n    ip saddr { 10.63.0.0/24 } ip daddr != { 10.63.0.0/24 } masquerade\n  }\n}\n"
        },
        { path = "/etc/sysctl.d/90-isoloom.conf", content = "net.ipv4.ip_forward=1\n" }
      ]
      runcmd = [
        "sysctl -p /etc/sysctl.d/90-isoloom.conf",
        "systemctl enable --now nftables",
        "nft -f /etc/nftables.conf"
      ]
    })))
    "userdata.encoding" = "base64"
  }
  lifecycle {
    postcondition {
      condition     = self.ip_address != "" && !contains(["10.63.0.254"], self.ip_address)
      error_message = "The router got no address on its uplink port group `${var.uplink_port_group}`: it has no DHCP (VMware Tools then reports a lab address). Give it an uplink with DHCP and internet (`uplink_port_group`; on a nested ESXi, promiscuous mode on)."
    }
  }
  depends_on = [esxi_portgroup.lab]
}

# Machine `web`.
resource "esxi_guest" "web" {
  guest_name     = "iso${var.slot}-web"
  notes          = "isoloom: ansible-pair"
  disk_store     = var.disk_store
  ovf_source     = var.images["debian-12"]
  numvcpus       = "1"
  memsize        = "1024"
  boot_disk_size = "20"
  power          = "on"
  network_interfaces {
    virtual_network = esxi_portgroup.lab.name
    mac_address     = format("00:50:56:%02x:%02x:%02x", var.slot, 2, 0)
    nic_type        = "vmxnet3"
  }
  guestinfo = {
    metadata = base64encode(yamlencode({
      instance-id    = "iso${var.slot}-web"
      local-hostname = "web"
      network = {
        version = 2
        ethernets = {
          nic0 = {
            match       = { macaddress = format("00:50:56:%02x:%02x:%02x", var.slot, 2, 0) }
            addresses   = ["10.63.0.10/24"]
            routes      = [{ to = "0.0.0.0/0", via = "10.63.0.254" }]
            nameservers = { addresses = ["1.1.1.1"] }
          }
        }
      }
    }))
    "metadata.encoding" = "base64"
    userdata            = base64encode(format("#cloud-config\n%s", yamlencode({ hostname = "web", users = local.users })))
    "userdata.encoding" = "base64"
  }
  depends_on = [esxi_guest.isoloom_router]
}

# Its set-up: its steps from the plan, over SSH through the router.
resource "terraform_data" "web" {
  triggers_replace = [esxi_guest.web.id]
  connection {
    type                = "ssh"
    host                = "10.63.0.10"
    user                = "isoloom"
    private_key         = file(pathexpand(var.ssh_private_key_file))
    bastion_host        = local.router_address
    bastion_user        = "isoloom"
    bastion_private_key = file(pathexpand(var.ssh_private_key_file))
    timeout             = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-web.tgz\" --exclude=.git --exclude=.vagrant --exclude=.terraform --exclude=.isoloom-project* -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-web.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "remote-exec" {
    inline = [
      "set -e",
      "cloud-init status --wait >/dev/null 2>&1 || true",
      "sudo sh -c 'mkdir -p /var/lib/isoloom'",
      "mkdir -p ~/.ssh && echo '${trimspace(tls_private_key.controller.public_key_openssh)}' >> ~/.ssh/authorized_keys",
      "sudo sh -c 'echo '\\''running: set-up'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz' || { sudo sh -c 'echo '\\''failed: set-up'\\'' > /var/lib/isoloom/ready'; exit 1; }",
      "sudo sh -c 'echo '\\''running: hosts file'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'printf '\\''%s\\n'\\'' '\\''10.63.0.10 web'\\'' '\\''10.63.0.20 cache'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done' || { sudo sh -c 'echo '\\''failed: hosts file'\\'' > /var/lib/isoloom/ready'; exit 1; }",
      "sudo sh -c 'echo '\\''running: health check'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready' || { sudo sh -c 'echo '\\''failed: health check'\\'' > /var/lib/isoloom/ready'; exit 1; }"
    ]
  }
}

# Machine `cache`.
resource "esxi_guest" "cache" {
  guest_name     = "iso${var.slot}-cache"
  notes          = "isoloom: ansible-pair"
  disk_store     = var.disk_store
  ovf_source     = var.images["debian-12"]
  numvcpus       = "1"
  memsize        = "1024"
  boot_disk_size = "20"
  power          = "on"
  network_interfaces {
    virtual_network = esxi_portgroup.lab.name
    mac_address     = format("00:50:56:%02x:%02x:%02x", var.slot, 3, 0)
    nic_type        = "vmxnet3"
  }
  guestinfo = {
    metadata = base64encode(yamlencode({
      instance-id    = "iso${var.slot}-cache"
      local-hostname = "cache"
      network = {
        version = 2
        ethernets = {
          nic0 = {
            match       = { macaddress = format("00:50:56:%02x:%02x:%02x", var.slot, 3, 0) }
            addresses   = ["10.63.0.20/24"]
            routes      = [{ to = "0.0.0.0/0", via = "10.63.0.254" }]
            nameservers = { addresses = ["1.1.1.1"] }
          }
        }
      }
    }))
    "metadata.encoding" = "base64"
    userdata            = base64encode(format("#cloud-config\n%s", yamlencode({ hostname = "cache", users = local.users })))
    "userdata.encoding" = "base64"
  }
  depends_on = [esxi_guest.isoloom_router]
}

# Its set-up: its steps from the plan, over SSH through the router.
resource "terraform_data" "cache" {
  triggers_replace = [esxi_guest.cache.id]
  connection {
    type                = "ssh"
    host                = "10.63.0.20"
    user                = "isoloom"
    private_key         = file(pathexpand(var.ssh_private_key_file))
    bastion_host        = local.router_address
    bastion_user        = "isoloom"
    bastion_private_key = file(pathexpand(var.ssh_private_key_file))
    timeout             = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-cache.tgz\" --exclude=.git --exclude=.vagrant --exclude=.terraform --exclude=.isoloom-project* -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-cache.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "remote-exec" {
    inline = [
      "set -e",
      "cloud-init status --wait >/dev/null 2>&1 || true",
      "sudo sh -c 'mkdir -p /var/lib/isoloom'",
      "mkdir -p ~/.ssh && echo '${trimspace(tls_private_key.controller.public_key_openssh)}' >> ~/.ssh/authorized_keys",
      "sudo sh -c 'echo '\\''running: set-up'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz' || { sudo sh -c 'echo '\\''failed: set-up'\\'' > /var/lib/isoloom/ready'; exit 1; }",
      "sudo sh -c 'echo '\\''running: hosts file'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'printf '\\''%s\\n'\\'' '\\''10.63.0.10 web'\\'' '\\''10.63.0.20 cache'\\'' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done' || { sudo sh -c 'echo '\\''failed: hosts file'\\'' > /var/lib/isoloom/ready'; exit 1; }",
      "sudo sh -c 'echo '\\''running: health check'\\'' > /var/lib/isoloom/ready'; sudo sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready' || { sudo sh -c 'echo '\\''failed: health check'\\'' > /var/lib/isoloom/ready'; exit 1; }"
    ]
  }
}

# The controller: runs the environment's playbooks once every machine is set up.
resource "esxi_guest" "isoloom_controller" {
  guest_name     = "iso${var.slot}-controller"
  notes          = "isoloom: ansible-pair"
  disk_store     = var.disk_store
  ovf_source     = var.images["ubuntu-24.04"]
  numvcpus       = "1"
  memsize        = "768"
  boot_disk_size = "10"
  power          = "on"
  network_interfaces {
    virtual_network = esxi_portgroup.lab.name
    mac_address     = format("00:50:56:%02x:%02x:%02x", var.slot, 1, 0)
    nic_type        = "vmxnet3"
  }
  guestinfo = {
    metadata = base64encode(yamlencode({
      instance-id    = "iso${var.slot}-controller"
      local-hostname = "controller"
      network = {
        version = 2
        ethernets = {
          nic0 = {
            match       = { macaddress = format("00:50:56:%02x:%02x:%02x", var.slot, 1, 0) }
            addresses   = ["10.63.0.253/24"]
            routes      = [{ to = "0.0.0.0/0", via = "10.63.0.254" }]
            nameservers = { addresses = ["1.1.1.1"] }
          }
        }
      }
    }))
    "metadata.encoding" = "base64"
    userdata            = base64encode(format("#cloud-config\n%s", yamlencode({ hostname = "isoloom-controller", users = local.users })))
    "userdata.encoding" = "base64"
  }
  depends_on = [esxi_guest.isoloom_router]
}

resource "terraform_data" "isoloom_controller" {
  triggers_replace = [esxi_guest.isoloom_controller.id]
  connection {
    type                = "ssh"
    host                = "10.63.0.253"
    user                = "isoloom"
    private_key         = file(pathexpand(var.ssh_private_key_file))
    bastion_host        = local.router_address
    bastion_user        = "isoloom"
    bastion_private_key = file(pathexpand(var.ssh_private_key_file))
    timeout             = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-controller.tgz\" --exclude=.git --exclude=.vagrant --exclude=.terraform --exclude=.isoloom-project* -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-controller.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "file" {
    content     = tls_private_key.controller.private_key_openssh
    destination = "/tmp/isoloom-controller-key"
  }
  provisioner "file" {
    content     = "[linux]\nweb ansible_host=10.63.0.10 ansible_user=isoloom\ncache ansible_host=10.63.0.20 ansible_user=isoloom maxmemory='\"64mb\"'\n\n[windows]\n\n[linux:vars]\nansible_ssh_private_key_file=/etc/isoloom/id_ed25519\nansible_become=true\n\n[webservers]\nweb\n\n[caches]\ncache\n\n[pair]\nweb\ncache\n"
    destination = "/tmp/isoloom-inventory.ini"
  }
  provisioner "remote-exec" {
    inline = [
      "set -e",
      "cloud-init status --wait >/dev/null 2>&1 || true",
      "sudo sh -c 'mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz'",
      "sudo sh -c 'printf '\\''%s\\n'\\'' '\\''10.63.0.10 web'\\'' '\\''10.63.0.20 cache'\\'' >> /etc/hosts'",
      "sudo sh -c 'mkdir -p /etc/isoloom && install -m 0600 /tmp/isoloom-controller-key /etc/isoloom/id_ed25519 && install -m 0644 /tmp/isoloom-inventory.ini /etc/isoloom/inventory.ini && rm -f /tmp/isoloom-controller-key /tmp/isoloom-inventory.ini'",
      "sudo sh -c 'DEBIAN_FRONTEND=noninteractive apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq python3-venv curl netcat-openbsd >/dev/null'",
      "sudo sh -c '[ -x /opt/ansible/bin/ansible-playbook ] || { python3 -m venv /opt/ansible && /opt/ansible/bin/pip install -q '\\''ansible-core>=2.15,<2.17'\\'' pywinrm; }'",
      "sudo sh -c 'set -e\nmkdir -p /tmp/isoloom-facts\nexport PATH=\"/opt/ansible/bin:$PATH\" ANSIBLE_HOST_KEY_CHECKING=False ANSIBLE_GATHERING=smart ANSIBLE_FORKS=20 ANSIBLE_PIPELINING=True ANSIBLE_CACHE_PLUGIN=jsonfile ANSIBLE_CACHE_PLUGIN_CONNECTION=/tmp/isoloom-facts ANSIBLE_CACHE_PLUGIN_TIMEOUT=7200\nmkdir -p /tmp/isoloom-retry\nexport ANSIBLE_RETRY_FILES_ENABLED=True ANSIBLE_RETRY_FILES_SAVE_PATH=/tmp/isoloom-retry\n_isoloom_pause=$${ISOLOOM_RETRY_PAUSE:-15}\n_isoloom_attempts=4\n_isoloom_transient='\\''send_input failed|the pipe has been ended|winrmtransporterror|winrmoperationtimeouterror|read timeout|bad http response returned from server|(kerberos|ntlm|credssp).*500|remote end closed connection|connection reset by peer|connection refused|connection aborted|broken pipe|timed out|failed to connect to the host via ssh|shared connection to .* closed'\\''\nretry_download() {\n  _isoloom_n=1\n  until \"$@\"; do\n    [ \"$_isoloom_n\" -lt 5 ] || return 1\n    echo \"isoloom: download failed; trying again in $((_isoloom_n * _isoloom_pause)) s ($((_isoloom_n + 1))/5)\"\n    sleep $((_isoloom_n * _isoloom_pause))\n    _isoloom_n=$((_isoloom_n + 1))\n  done\n}\nplay_hosts() {\n  awk -v transient=\"$_isoloom_transient\" '\\''\n    function commit() {\n      if (pending != \"\") { if (pending_real) real[pending] = 1; else cut[pending] = 1 }\n      pending = \"\"\n    }\n    { gsub(/\\033\\[[0-9;]*m/, \"\") }\n    /^\\.\\.\\.ignoring/ { pending = \"\"; next }\n    { commit() }\n    /^(fatal|failed): \\[/ && !/UNREACHABLE!/ {\n      pending = $0\n      sub(/^(fatal|failed): \\[/, \"\", pending)\n      sub(/\\].*/, \"\", pending)\n      sub(/ -> .*/, \"\", pending)\n      pending_real = (tolower($0) !~ transient)\n      next\n    }\n    /^PLAY RECAP/ { recap = 1; next }\n    recap && / : ok=/ {\n      for (i = 2; i <= NF; i++) {\n        split($i, kv, \"=\")\n        if (kv[1] == \"failed\" && kv[2] > 0) failed[$1] = 1\n        if (kv[1] == \"unreachable\" && kv[2] > 0) unreachable[$1] = 1\n      }\n    }\n    END {\n      commit()\n      for (h in failed) print ((h in real || !(h in cut)) ? \"real \" : \"cut \") h\n      for (h in unreachable) if (!(h in failed)) print \"unreachable \" h\n    }\n  '\\'' \"$1\" | sort\n}\n_isoloom_kind() {\n  echo \"$1\" | awk -v k=\"$2\" '\\''$1 == k { printf \"%s%s\", s, $2; s = \" \" }'\\''\n}\nrun_play() {\n  # The playbook is the last argument; Ansible names its retry file after it.\n  for _isoloom_book; do :; done\n  _isoloom_name=$(basename \"$_isoloom_book\")\n  _isoloom_retry=$${ANSIBLE_RETRY_FILES_SAVE_PATH:-/tmp/isoloom-retry}/$${_isoloom_name%.*}.retry\n  _isoloom_limit=\n  _isoloom_log=$(mktemp)\n  _isoloom_rcf=$(mktemp)\n  _isoloom_n=1\n  rm -f \"$_isoloom_retry\"\n  while :; do\n    { \"$@\" && echo 0 > \"$_isoloom_rcf\" || echo $? > \"$_isoloom_rcf\"; } 2>&1 | tee \"$_isoloom_log\"\n    _isoloom_rc=$(cat \"$_isoloom_rcf\")\n    [ \"$_isoloom_rc\" -ne 0 ] || break\n    _isoloom_hosts=$(play_hosts \"$_isoloom_log\")\n    _isoloom_real=$(_isoloom_kind \"$_isoloom_hosts\" real)\n    _isoloom_gone=$(_isoloom_kind \"$_isoloom_hosts\" unreachable)\n    _isoloom_cut=$(_isoloom_kind \"$_isoloom_hosts\" cut)\n    _isoloom_again=\"$_isoloom_gone$${_isoloom_gone:+$${_isoloom_cut:+ }}$_isoloom_cut\"\n    if [ -n \"$_isoloom_real\" ]; then\n      echo \"isoloom: $_isoloom_name: a task failed on $_isoloom_real: not retried\"\n      break\n    fi\n    if [ -z \"$_isoloom_again\" ]; then\n      echo \"isoloom: $_isoloom_name failed (exit $_isoloom_rc) with no unreachable host or dropped connection: not retried\"\n      break\n    fi\n    if [ \"$_isoloom_n\" -ge \"$_isoloom_attempts\" ]; then\n      echo \"isoloom: $_isoloom_name: still unreachable after $_isoloom_n runs: $_isoloom_again; giving up\"\n      break\n    fi\n    echo \"$_isoloom_again\" | tr '\\'' '\\'' '\\''\\n'\\'' > \"$_isoloom_retry\"\n    if [ -z \"$_isoloom_limit\" ]; then set -- \"$@\" --limit \"@$_isoloom_retry\"; _isoloom_limit=1; fi\n    _isoloom_n=$((_isoloom_n + 1))\n    if [ -n \"$_isoloom_gone\" ]; then\n      _isoloom_wait=$((4 * _isoloom_pause))\n      echo \"isoloom: $_isoloom_name: unreachable: $_isoloom_again; waiting $_isoloom_wait s, then running it again on them ($_isoloom_n/$_isoloom_attempts)\"\n    else\n      _isoloom_wait=$((2 * _isoloom_pause))\n      echo \"isoloom: $_isoloom_name: the play was cut by a dropped connection on $_isoloom_cut; waiting $_isoloom_wait s, then running it again on them ($_isoloom_n/$_isoloom_attempts)\"\n    fi\n    sleep \"$_isoloom_wait\"\n  done\n  rm -f \"$_isoloom_log\" \"$_isoloom_rcf\"\n  [ \"$_isoloom_rc\" -ne 0 ] || rm -f \"$_isoloom_retry\"\n  return \"$_isoloom_rc\"\n}\ncd /opt/isoloom/ansible\nretry_download ansible-galaxy install -r /opt/isoloom/ansible/requirements.yml\nrun_play ansible-playbook -i /etc/isoloom/inventory.ini -i /opt/isoloom/ansible/groups.ini -e '\\''{\"greeting\":\"hello from ansible\",\"tools\":[\"curl\",\"jq\"],\"cache_port\":6379}'\\'' site.yml'",
      "sudo sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'"
    ]
  }
  depends_on = [terraform_data.web, terraform_data.cache]
}

locals {
  router_address = esxi_guest.isoloom_router.ip_address
}

# The router's uplink address: the lab's way in.
output "ip" {
  value = local.router_address
}

# Each Linux machine's set-up progress (`isoloom-ready/1`: `running: <step>`, `failed: <step>`, `ready`).
output "ready_file" {
  value = "/var/lib/isoloom/ready"
}

# The machines, through the router: ssh -J isoloom@<ip> isoloom@<machine>.
output "machines" {
  value = { web = "10.63.0.10", cache = "10.63.0.20" }
}

output "ssh_user" {
  value = "isoloom"
}

# The checks: each runner piped to its machine (ssh -J isoloom@<ip> isoloom@<host> sh -s < <script>).
output "checks" {
  value = [
    {
      position = "networks"
      machine  = "controller"
      host     = "10.63.0.253"
      user     = "isoloom"
      script   = ".isoloom/esxi/checks/networks.sh"
    },
    {
      position = "web"
      machine  = "web"
      host     = "10.63.0.10"
      user     = "isoloom"
      script   = ".isoloom/esxi/checks/web.sh"
    },
    {
      position = "cache"
      machine  = "cache"
      host     = "10.63.0.20"
      user     = "isoloom"
      script   = ".isoloom/esxi/checks/cache.sh"
    }
  ]
}

# The project's files the machines don't get: version control and the tools' state, and what
# .isoloomignore at the project's root lists (gitignore-style: one pattern per line, `#` comments,
# `!` brings a path back, a trailing `/` matches folders only, a `/` at the start or in the middle
# anchors the pattern at the root; `*`, `?`, `[abc]`, `**`; the last pattern matching a path, or
# a folder it is in, decides). Read as regular expressions, as the Vagrantfiles do.
locals {
  project_ignore_lines = [for l in split("\n", replace(try(file("${local.root}/.isoloomignore"), ""), "\r", "")) : trimspace(l)]
  project_ignore_pats  = [for l in local.project_ignore_lines : { keep = startswith(l, "!"), pat = trimprefix(l, "!") } if l != "" && !startswith(l, "#")]
  project_ignore_globs = [for r in local.project_ignore_pats : merge(r, { glob = trimsuffix(trimsuffix(trimsuffix(r.pat, "/"), "/**"), "/") })]
  project_ignore = [for r in local.project_ignore_globs : {
    keep = r.keep
    re = format(r.glob == r.pat ? "^%s(/|$)" : "^%s/", replace(replace(replace(replace(replace(replace(replace(replace(
      length(split("/", r.glob)) > 1 ? trimprefix(r.glob, "/") : "**/${r.glob}",
    "/[.+^$(){}|\\\\]/", "\\$0"), "[!", "[^"), "**/", "\u0001"), "**", "\u0002"), "*", "[^/]*"), "?", "[^/]"), "\u0001", "(.*/)?"), "\u0002", ".*"))
  } if r.glob != ""]
  # Each file: whether it goes (the last matching pattern decides; none: it goes).
  project_keep    = { for f in fileset(local.root, "**") : f => reverse(concat([true], [for r in local.project_ignore : r.keep if length(regexall(r.re, f)) > 0]))[0] }
  project_ignored = [for f, keep in local.project_keep : f if !keep]
}

# What `tar` leaves out of the project's archive: .isoloomignore's files, from the archive's top
# folder, their wildcard characters escaped.
resource "local_file" "isoloom_project" {
  filename = "${path.module}/.isoloom-project-ignored.txt"
  content  = join("", [for f in local.project_ignored : "${replace("${basename(local.root)}/${f}", "/[\\\\*?\\[]/", "\\$0")}\n"])
}
