---
source: crates/backends/isoloom-terraform/src/paas/tests.rs
expression: "file(SPEC, Cloud::Azure, \"services.tf\")"
---
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# The environment's services (`services:`), beside main.tf, whose network, zone and names they use.
# `dns.private` is on: a spec with services turns it on, as each service is reached by its name
# in the zone (shop.internal). That zone is billed: an Azure private DNS zone, about $0.50 a month.

# Service `db`: PostgreSQL 16 on a flexible server, reached as db.shop.internal.
resource "azurerm_postgresql_flexible_server" "db" {
  name                          = "${local.name}-db"
  resource_group_name           = azurerm_resource_group.env.name
  location                      = var.region
  tags                          = local.tags
  version                       = "16"
  administrator_login           = "shop"
  administrator_password        = var.ISOLOOM_SECRET_DB_PASSWORD
  sku_name                      = "B_Standard_B1ms"
  storage_mb                    = 32768
  public_network_access_enabled = false
  lifecycle {
    ignore_changes = [zone]
  }
}

resource "azurerm_postgresql_flexible_server_database" "db" {
  name      = "shop"
  server_id = azurerm_postgresql_flexible_server.db.id
  charset   = "UTF8"
  collation = "en_US.utf8"
}

resource "azurerm_private_endpoint" "isoloom_service_db" {
  name                = "${local.name}-service-db"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  subnet_id           = azurerm_subnet.lab.id
  private_service_connection {
    name                           = "${local.name}-service-db"
    private_connection_resource_id = azurerm_postgresql_flexible_server.db.id
    subresource_names              = ["postgresqlServer"]
    is_manual_connection           = false
  }
}

resource "azurerm_private_dns_a_record" "db_shop_internal" {
  name                = "db"
  private_dns_zone_id = azurerm_private_dns_zone.private.id
  ttl                 = 60
  records             = [azurerm_private_endpoint.isoloom_service_db.private_service_connection[0].private_ip_address]
  tags                = local.tags
}

# Service `files`: the container `uploads` in a storage account (its clients speak Blob Storage's API).
resource "azurerm_storage_account" "files" {
  name                            = "isoloom${terraform_data.id.output}files"
  resource_group_name             = azurerm_resource_group.env.name
  location                        = var.region
  tags                            = local.tags
  account_tier                    = "Standard"
  account_replication_type        = "LRS"
  min_tls_version                 = "TLS1_2"
  allow_nested_items_to_be_public = false
  blob_properties {
    versioning_enabled = true
  }
}

resource "azurerm_storage_container" "files" {
  name                  = "uploads"
  storage_account_id    = azurerm_storage_account.files.id
  container_access_type = "private"
}

output "files_bucket" {
  value = azurerm_storage_container.files.name
}

output "files_endpoint" {
  value = azurerm_storage_account.files.primary_blob_endpoint
}

# Service `bus`: Kafka on Event Hubs (its Kafka endpoint, port 9093), a hub per topic.
resource "azurerm_eventhub_namespace" "bus" {
  name                = "${local.name}-bus"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
  sku                 = "Standard"
  capacity            = 1
}

resource "azurerm_eventhub" "bus_orders" {
  name              = "orders"
  namespace_id      = azurerm_eventhub_namespace.bus.id
  partition_count   = 3
  message_retention = 1
}

resource "azurerm_eventhub_namespace_authorization_rule" "isoloom_service_bus" {
  name                = "isoloom-clients"
  namespace_name      = azurerm_eventhub_namespace.bus.name
  resource_group_name = azurerm_resource_group.env.name
  listen              = true
  send                = true
  manage              = false
}

# Machine `worker`'s identity (`access: identity`): the services it uses, no key.
resource "azurerm_user_assigned_identity" "isoloom_client_worker" {
  name                = "${local.name}-client-worker"
  resource_group_name = azurerm_resource_group.env.name
  location            = var.region
  tags                = local.tags
}

resource "azurerm_role_assignment" "isoloom_client_worker_files" {
  scope                = azurerm_storage_account.files.id
  role_definition_name = "Storage Blob Data Contributor"
  principal_id         = azurerm_user_assigned_identity.isoloom_client_worker.principal_id
}

resource "azurerm_role_assignment" "isoloom_client_worker_bus" {
  scope                = azurerm_eventhub_namespace.bus.id
  role_definition_name = "Azure Event Hubs Data Owner"
  principal_id         = azurerm_user_assigned_identity.isoloom_client_worker.principal_id
}

resource "terraform_data" "isoloom_service_files_to_web" {
  triggers_replace = [
    azurerm_linux_virtual_machine.web.id,
    sha256(jsonencode([
      azurerm_storage_account.files.primary_blob_endpoint,
      azurerm_storage_container.files.name,
      var.region,
      "azure-blob",
      azurerm_storage_account.files.name,
      azurerm_storage_account.files.primary_access_key
    ]))
  ]
  connection {
    type        = "ssh"
    host        = azurerm_public_ip.web.ip_address
    user        = "isoloom"
    private_key = file(pathexpand(var.ssh_private_key_file))
    timeout     = "10m"
  }
  provisioner "file" {
    content     = azurerm_storage_account.files.primary_blob_endpoint
    destination = "/tmp/isoloom-service-files-endpoint"
  }
  provisioner "file" {
    content     = azurerm_storage_container.files.name
    destination = "/tmp/isoloom-service-files-bucket"
  }
  provisioner "file" {
    content     = var.region
    destination = "/tmp/isoloom-service-files-region"
  }
  provisioner "file" {
    content     = "azure-blob"
    destination = "/tmp/isoloom-service-files-api"
  }
  provisioner "file" {
    content     = azurerm_storage_account.files.name
    destination = "/tmp/isoloom-service-files-access-key"
  }
  provisioner "file" {
    content     = azurerm_storage_account.files.primary_access_key
    destination = "/tmp/isoloom-service-files-secret-key"
  }
  provisioner "remote-exec" {
    inline = [
      "sudo sh -c 'install -d -m 0755 '\\''/etc/isoloom/services/files'\\'' && install -m 0444 '\\''/tmp/isoloom-service-files-endpoint'\\'' '\\''/etc/isoloom/services/files/endpoint'\\'' && rm -f '\\''/tmp/isoloom-service-files-endpoint'\\'' && install -m 0444 '\\''/tmp/isoloom-service-files-bucket'\\'' '\\''/etc/isoloom/services/files/bucket'\\'' && rm -f '\\''/tmp/isoloom-service-files-bucket'\\'' && install -m 0444 '\\''/tmp/isoloom-service-files-region'\\'' '\\''/etc/isoloom/services/files/region'\\'' && rm -f '\\''/tmp/isoloom-service-files-region'\\'' && install -m 0444 '\\''/tmp/isoloom-service-files-api'\\'' '\\''/etc/isoloom/services/files/api'\\'' && rm -f '\\''/tmp/isoloom-service-files-api'\\'' && install -m 0400 '\\''/tmp/isoloom-service-files-access-key'\\'' '\\''/etc/isoloom/services/files/access-key'\\'' && rm -f '\\''/tmp/isoloom-service-files-access-key'\\'' && install -m 0400 '\\''/tmp/isoloom-service-files-secret-key'\\'' '\\''/etc/isoloom/services/files/secret-key'\\'' && rm -f '\\''/tmp/isoloom-service-files-secret-key'\\'''"
    ]
  }
  depends_on = [terraform_data.isoloom_ready_web]
}

resource "terraform_data" "isoloom_service_files_to_worker" {
  triggers_replace = [
    azurerm_linux_virtual_machine.worker.id,
    sha256(jsonencode([
      azurerm_storage_account.files.primary_blob_endpoint,
      azurerm_storage_container.files.name,
      var.region,
      "azure-blob",
      azurerm_user_assigned_identity.isoloom_client_worker.client_id
    ]))
  ]
  connection {
    type        = "ssh"
    host        = azurerm_public_ip.worker.ip_address
    user        = "isoloom"
    private_key = file(pathexpand(var.ssh_private_key_file))
    timeout     = "10m"
  }
  provisioner "file" {
    content     = azurerm_storage_account.files.primary_blob_endpoint
    destination = "/tmp/isoloom-service-files-endpoint"
  }
  provisioner "file" {
    content     = azurerm_storage_container.files.name
    destination = "/tmp/isoloom-service-files-bucket"
  }
  provisioner "file" {
    content     = var.region
    destination = "/tmp/isoloom-service-files-region"
  }
  provisioner "file" {
    content     = "azure-blob"
    destination = "/tmp/isoloom-service-files-api"
  }
  provisioner "file" {
    content     = azurerm_user_assigned_identity.isoloom_client_worker.client_id
    destination = "/tmp/isoloom-service-files-identity"
  }
  provisioner "remote-exec" {
    inline = [
      "sudo sh -c 'install -d -m 0755 '\\''/etc/isoloom/services/files'\\'' && install -m 0444 '\\''/tmp/isoloom-service-files-endpoint'\\'' '\\''/etc/isoloom/services/files/endpoint'\\'' && rm -f '\\''/tmp/isoloom-service-files-endpoint'\\'' && install -m 0444 '\\''/tmp/isoloom-service-files-bucket'\\'' '\\''/etc/isoloom/services/files/bucket'\\'' && rm -f '\\''/tmp/isoloom-service-files-bucket'\\'' && install -m 0444 '\\''/tmp/isoloom-service-files-region'\\'' '\\''/etc/isoloom/services/files/region'\\'' && rm -f '\\''/tmp/isoloom-service-files-region'\\'' && install -m 0444 '\\''/tmp/isoloom-service-files-api'\\'' '\\''/etc/isoloom/services/files/api'\\'' && rm -f '\\''/tmp/isoloom-service-files-api'\\'' && install -m 0444 '\\''/tmp/isoloom-service-files-identity'\\'' '\\''/etc/isoloom/services/files/identity'\\'' && rm -f '\\''/tmp/isoloom-service-files-identity'\\'''"
    ]
  }
  depends_on = [terraform_data.isoloom_ready_worker]
}

resource "terraform_data" "isoloom_service_bus_to_web" {
  triggers_replace = [
    azurerm_linux_virtual_machine.web.id,
    sha256(jsonencode([
      "${azurerm_eventhub_namespace.bus.name}.servicebus.windows.net:9093",
      "SASL_SSL",
      "PLAIN",
      "$ConnectionString",
      azurerm_eventhub_namespace_authorization_rule.isoloom_service_bus.primary_connection_string
    ]))
  ]
  connection {
    type        = "ssh"
    host        = azurerm_public_ip.web.ip_address
    user        = "isoloom"
    private_key = file(pathexpand(var.ssh_private_key_file))
    timeout     = "10m"
  }
  provisioner "file" {
    content     = "${azurerm_eventhub_namespace.bus.name}.servicebus.windows.net:9093"
    destination = "/tmp/isoloom-service-bus-bootstrap"
  }
  provisioner "file" {
    content     = "SASL_SSL"
    destination = "/tmp/isoloom-service-bus-security-protocol"
  }
  provisioner "file" {
    content     = "PLAIN"
    destination = "/tmp/isoloom-service-bus-sasl-mechanism"
  }
  provisioner "file" {
    content     = "$ConnectionString"
    destination = "/tmp/isoloom-service-bus-user"
  }
  provisioner "file" {
    content     = azurerm_eventhub_namespace_authorization_rule.isoloom_service_bus.primary_connection_string
    destination = "/tmp/isoloom-service-bus-password"
  }
  provisioner "remote-exec" {
    inline = [
      "sudo sh -c 'install -d -m 0755 '\\''/etc/isoloom/services/bus'\\'' && install -m 0444 '\\''/tmp/isoloom-service-bus-bootstrap'\\'' '\\''/etc/isoloom/services/bus/bootstrap'\\'' && rm -f '\\''/tmp/isoloom-service-bus-bootstrap'\\'' && install -m 0444 '\\''/tmp/isoloom-service-bus-security-protocol'\\'' '\\''/etc/isoloom/services/bus/security-protocol'\\'' && rm -f '\\''/tmp/isoloom-service-bus-security-protocol'\\'' && install -m 0444 '\\''/tmp/isoloom-service-bus-sasl-mechanism'\\'' '\\''/etc/isoloom/services/bus/sasl-mechanism'\\'' && rm -f '\\''/tmp/isoloom-service-bus-sasl-mechanism'\\'' && install -m 0400 '\\''/tmp/isoloom-service-bus-user'\\'' '\\''/etc/isoloom/services/bus/user'\\'' && rm -f '\\''/tmp/isoloom-service-bus-user'\\'' && install -m 0400 '\\''/tmp/isoloom-service-bus-password'\\'' '\\''/etc/isoloom/services/bus/password'\\'' && rm -f '\\''/tmp/isoloom-service-bus-password'\\'''"
    ]
  }
  depends_on = [terraform_data.isoloom_ready_web]
}

resource "terraform_data" "isoloom_service_bus_to_worker" {
  triggers_replace = [
    azurerm_linux_virtual_machine.worker.id,
    sha256(jsonencode([
      "${azurerm_eventhub_namespace.bus.name}.servicebus.windows.net:9093",
      "SASL_SSL",
      "OAUTHBEARER",
      azurerm_user_assigned_identity.isoloom_client_worker.client_id
    ]))
  ]
  connection {
    type        = "ssh"
    host        = azurerm_public_ip.worker.ip_address
    user        = "isoloom"
    private_key = file(pathexpand(var.ssh_private_key_file))
    timeout     = "10m"
  }
  provisioner "file" {
    content     = "${azurerm_eventhub_namespace.bus.name}.servicebus.windows.net:9093"
    destination = "/tmp/isoloom-service-bus-bootstrap"
  }
  provisioner "file" {
    content     = "SASL_SSL"
    destination = "/tmp/isoloom-service-bus-security-protocol"
  }
  provisioner "file" {
    content     = "OAUTHBEARER"
    destination = "/tmp/isoloom-service-bus-sasl-mechanism"
  }
  provisioner "file" {
    content     = azurerm_user_assigned_identity.isoloom_client_worker.client_id
    destination = "/tmp/isoloom-service-bus-identity"
  }
  provisioner "remote-exec" {
    inline = [
      "sudo sh -c 'install -d -m 0755 '\\''/etc/isoloom/services/bus'\\'' && install -m 0444 '\\''/tmp/isoloom-service-bus-bootstrap'\\'' '\\''/etc/isoloom/services/bus/bootstrap'\\'' && rm -f '\\''/tmp/isoloom-service-bus-bootstrap'\\'' && install -m 0444 '\\''/tmp/isoloom-service-bus-security-protocol'\\'' '\\''/etc/isoloom/services/bus/security-protocol'\\'' && rm -f '\\''/tmp/isoloom-service-bus-security-protocol'\\'' && install -m 0444 '\\''/tmp/isoloom-service-bus-sasl-mechanism'\\'' '\\''/etc/isoloom/services/bus/sasl-mechanism'\\'' && rm -f '\\''/tmp/isoloom-service-bus-sasl-mechanism'\\'' && install -m 0444 '\\''/tmp/isoloom-service-bus-identity'\\'' '\\''/etc/isoloom/services/bus/identity'\\'' && rm -f '\\''/tmp/isoloom-service-bus-identity'\\'''"
    ]
  }
  depends_on = [terraform_data.isoloom_ready_worker]
}
