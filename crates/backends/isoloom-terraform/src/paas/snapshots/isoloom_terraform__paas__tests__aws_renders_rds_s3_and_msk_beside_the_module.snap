---
source: crates/backends/isoloom-terraform/src/paas/tests.rs
expression: "file(SPEC, Cloud::Aws, \"services.tf\")"
---
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# The environment's services (`services:`), beside main.tf, whose network, zone and names they use.
# `dns.private` is on: a spec with services turns it on, as each service is reached by its name
# in the zone (shop.internal). That zone is billed: a Route 53 private hosted zone, about $0.50 a month.

variable "ISOLOOM_SECRET_BUS_USER" {
  type        = string
  sensitive   = true
  description = "The secret `bus-user` (the spec's `secrets`), which a service takes"
}

variable "ISOLOOM_SECRET_BUS_PASSWORD" {
  type        = string
  sensitive   = true
  description = "The secret `bus-password` (the spec's `secrets`), which a service takes"
}

# The services' own block in the VPC: RDS and MSK take subnets in two availability zones.
resource "aws_vpc_ipv4_cidr_block_association" "isoloom_services" {
  vpc_id     = aws_vpc.env.id
  cidr_block = "100.64.0.0/26"
}

resource "aws_subnet" "isoloom_services_a" {
  vpc_id            = aws_vpc_ipv4_cidr_block_association.isoloom_services.vpc_id
  cidr_block        = "100.64.0.0/27"
  availability_zone = data.aws_availability_zones.available.names[0]
}

resource "aws_subnet" "isoloom_services_b" {
  vpc_id            = aws_vpc_ipv4_cidr_block_association.isoloom_services.vpc_id
  cidr_block        = "100.64.0.32/27"
  availability_zone = data.aws_availability_zones.available.names[1]
}

# Service `db`: PostgreSQL 16 on RDS, reached as db.shop.internal.
resource "aws_db_subnet_group" "db" {
  name       = "${local.name}-db"
  subnet_ids = [aws_subnet.isoloom_services_a.id, aws_subnet.isoloom_services_b.id]
}

resource "aws_security_group" "isoloom_service_db" {
  name   = "${local.name}-service-db"
  vpc_id = aws_vpc.env.id
  ingress {
    description = "from the networks of its clients"
    from_port   = 5432
    to_port     = 5432
    protocol    = "tcp"
    cidr_blocks = ["10.30.0.0/24"]
  }
}

resource "aws_db_instance" "db" {
  identifier             = "${local.name}-db"
  engine                 = "postgres"
  engine_version         = "16"
  instance_class         = "db.t4g.micro"
  allocated_storage      = 20
  db_name                = "shop"
  username               = "shop"
  password               = var.ISOLOOM_SECRET_DB_PASSWORD
  db_subnet_group_name   = aws_db_subnet_group.db.name
  vpc_security_group_ids = [aws_security_group.isoloom_service_db.id]
  publicly_accessible    = false
  skip_final_snapshot    = true
  deletion_protection    = false
  apply_immediately      = true
}

resource "aws_route53_record" "db_shop_internal" {
  zone_id = aws_route53_zone.private.zone_id
  name    = "db.shop.internal"
  type    = "CNAME"
  ttl     = 60
  records = [aws_db_instance.db.address]
}

# Service `files`: the bucket `uploads` on S3.
resource "aws_s3_bucket" "files" {
  bucket        = "isoloom-${terraform_data.id.output}-uploads"
  force_destroy = true
}

resource "aws_s3_bucket_public_access_block" "files" {
  bucket                  = aws_s3_bucket.files.id
  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "aws_s3_bucket_versioning" "files" {
  bucket = aws_s3_bucket.files.id
  versioning_configuration {
    status = "Enabled"
  }
}

resource "aws_iam_user" "isoloom_service_files" {
  name          = "${local.name}-service-files"
  force_destroy = true
}

resource "aws_iam_user_policy" "isoloom_service_files" {
  user = aws_iam_user.isoloom_service_files.name
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect   = "Allow"
        Action   = ["s3:ListBucket", "s3:GetObject", "s3:PutObject", "s3:DeleteObject"]
        Resource = [aws_s3_bucket.files.arn, "${aws_s3_bucket.files.arn}/*"]
      }
    ]
  })
}

resource "aws_iam_access_key" "isoloom_service_files" {
  user = aws_iam_user.isoloom_service_files.name
}

output "files_bucket" {
  value = aws_s3_bucket.files.bucket
}

output "files_endpoint" {
  value = "https://s3.${var.region}.amazonaws.com"
}

resource "aws_security_group" "isoloom_service_bus" {
  name   = "${local.name}-service-bus"
  vpc_id = aws_vpc.env.id
  ingress {
    description = "from the networks of its clients"
    from_port   = 9096
    to_port     = 9096
    protocol    = "tcp"
    cidr_blocks = ["10.30.0.0/24"]
  }
  ingress {
    description = "from the networks of its clients"
    from_port   = 9098
    to_port     = 9098
    protocol    = "tcp"
    cidr_blocks = ["10.30.0.0/24"]
  }
}

# Service `bus`: Kafka on MSK. Its topics are made at their first use, with 3 partitions (MSK has no topic resource).
resource "aws_msk_configuration" "bus" {
  name              = "${local.name}-bus"
  kafka_versions    = ["3.8.x"]
  server_properties = "auto.create.topics.enable=true\nnum.partitions=3\n"
}

resource "aws_msk_cluster" "bus" {
  cluster_name           = "${local.name}-bus"
  kafka_version          = "3.8.x"
  number_of_broker_nodes = 2
  broker_node_group_info {
    instance_type   = "kafka.t3.small"
    client_subnets  = [aws_subnet.isoloom_services_a.id, aws_subnet.isoloom_services_b.id]
    security_groups = [aws_security_group.isoloom_service_bus.id]
    storage_info {
      ebs_storage_info {
        volume_size = 10
      }
    }
  }
  client_authentication {
    sasl {
      scram = true
      iam   = true
    }
  }
  configuration_info {
    arn      = aws_msk_configuration.bus.arn
    revision = aws_msk_configuration.bus.latest_revision
  }
}

resource "aws_kms_key" "isoloom_service_bus" {
  description             = "${local.name}-bus"
  deletion_window_in_days = 7
}

resource "aws_secretsmanager_secret" "isoloom_service_bus" {
  name                    = "AmazonMSK_${local.name}-bus"
  kms_key_id              = aws_kms_key.isoloom_service_bus.key_id
  recovery_window_in_days = 0
}

resource "aws_secretsmanager_secret_version" "isoloom_service_bus" {
  secret_id     = aws_secretsmanager_secret.isoloom_service_bus.id
  secret_string = jsonencode({ username = var.ISOLOOM_SECRET_BUS_USER, password = var.ISOLOOM_SECRET_BUS_PASSWORD })
}

resource "aws_msk_scram_secret_association" "isoloom_service_bus" {
  cluster_arn     = aws_msk_cluster.bus.arn
  secret_arn_list = [aws_secretsmanager_secret.isoloom_service_bus.arn]
  depends_on      = [aws_secretsmanager_secret_version.isoloom_service_bus]
}

# Machine `worker`'s identity (`access: identity`): the services it uses, no key.
resource "aws_iam_role" "isoloom_client_worker" {
  name = "${local.name}-client-worker"
  assume_role_policy = jsonencode({
    Version   = "2012-10-17"
    Statement = [{ Effect = "Allow", Action = "sts:AssumeRole", Principal = { Service = "ec2.amazonaws.com" } }]
  })
}

resource "aws_iam_role_policy" "isoloom_client_worker_files" {
  role = aws_iam_role.isoloom_client_worker.id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect   = "Allow"
        Action   = ["s3:ListBucket", "s3:GetObject", "s3:PutObject", "s3:DeleteObject"]
        Resource = [aws_s3_bucket.files.arn, "${aws_s3_bucket.files.arn}/*"]
      }
    ]
  })
}

resource "aws_iam_role_policy" "isoloom_client_worker_bus" {
  role = aws_iam_role.isoloom_client_worker.id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect = "Allow"
        Action = ["kafka-cluster:*"]
        Resource = [
          aws_msk_cluster.bus.arn,
          "${replace(aws_msk_cluster.bus.arn, ":cluster/", ":topic/")}/*",
          "${replace(aws_msk_cluster.bus.arn, ":cluster/", ":group/")}/*"
        ]
      }
    ]
  })
}

resource "aws_iam_instance_profile" "isoloom_client_worker" {
  name = "${local.name}-client-worker"
  role = aws_iam_role.isoloom_client_worker.name
}

resource "terraform_data" "isoloom_service_files_to_web" {
  triggers_replace = [
    aws_instance.web.id,
    sha256(jsonencode([
      "https://s3.${var.region}.amazonaws.com",
      aws_s3_bucket.files.bucket,
      var.region,
      "s3",
      aws_iam_access_key.isoloom_service_files.id,
      aws_iam_access_key.isoloom_service_files.secret
    ]))
  ]
  connection {
    type        = "ssh"
    host        = aws_instance.web.public_ip
    user        = "admin"
    private_key = file(pathexpand(var.ssh_private_key_file))
    timeout     = "10m"
  }
  provisioner "file" {
    content     = "https://s3.${var.region}.amazonaws.com"
    destination = "/tmp/isoloom-service-files-endpoint"
  }
  provisioner "file" {
    content     = aws_s3_bucket.files.bucket
    destination = "/tmp/isoloom-service-files-bucket"
  }
  provisioner "file" {
    content     = var.region
    destination = "/tmp/isoloom-service-files-region"
  }
  provisioner "file" {
    content     = "s3"
    destination = "/tmp/isoloom-service-files-api"
  }
  provisioner "file" {
    content     = aws_iam_access_key.isoloom_service_files.id
    destination = "/tmp/isoloom-service-files-access-key"
  }
  provisioner "file" {
    content     = aws_iam_access_key.isoloom_service_files.secret
    destination = "/tmp/isoloom-service-files-secret-key"
  }
  provisioner "remote-exec" {
    inline = [
      "sudo sh -c 'install -d -m 0755 '\\''/etc/isoloom/services/files'\\'' && install -m 0444 '\\''/tmp/isoloom-service-files-endpoint'\\'' '\\''/etc/isoloom/services/files/endpoint'\\'' && rm -f '\\''/tmp/isoloom-service-files-endpoint'\\'' && install -m 0444 '\\''/tmp/isoloom-service-files-bucket'\\'' '\\''/etc/isoloom/services/files/bucket'\\'' && rm -f '\\''/tmp/isoloom-service-files-bucket'\\'' && install -m 0444 '\\''/tmp/isoloom-service-files-region'\\'' '\\''/etc/isoloom/services/files/region'\\'' && rm -f '\\''/tmp/isoloom-service-files-region'\\'' && install -m 0444 '\\''/tmp/isoloom-service-files-api'\\'' '\\''/etc/isoloom/services/files/api'\\'' && rm -f '\\''/tmp/isoloom-service-files-api'\\'' && install -m 0400 '\\''/tmp/isoloom-service-files-access-key'\\'' '\\''/etc/isoloom/services/files/access-key'\\'' && rm -f '\\''/tmp/isoloom-service-files-access-key'\\'' && install -m 0400 '\\''/tmp/isoloom-service-files-secret-key'\\'' '\\''/etc/isoloom/services/files/secret-key'\\'' && rm -f '\\''/tmp/isoloom-service-files-secret-key'\\'''"
    ]
  }
  depends_on = [terraform_data.isoloom_ready_web]
}

resource "terraform_data" "isoloom_service_files_to_worker" {
  triggers_replace = [
    aws_instance.worker.id,
    sha256(jsonencode([
      "https://s3.${var.region}.amazonaws.com",
      aws_s3_bucket.files.bucket,
      var.region,
      "s3",
      aws_iam_role.isoloom_client_worker.arn
    ]))
  ]
  connection {
    type        = "ssh"
    host        = aws_instance.worker.public_ip
    user        = "admin"
    private_key = file(pathexpand(var.ssh_private_key_file))
    timeout     = "10m"
  }
  provisioner "file" {
    content     = "https://s3.${var.region}.amazonaws.com"
    destination = "/tmp/isoloom-service-files-endpoint"
  }
  provisioner "file" {
    content     = aws_s3_bucket.files.bucket
    destination = "/tmp/isoloom-service-files-bucket"
  }
  provisioner "file" {
    content     = var.region
    destination = "/tmp/isoloom-service-files-region"
  }
  provisioner "file" {
    content     = "s3"
    destination = "/tmp/isoloom-service-files-api"
  }
  provisioner "file" {
    content     = aws_iam_role.isoloom_client_worker.arn
    destination = "/tmp/isoloom-service-files-identity"
  }
  provisioner "remote-exec" {
    inline = [
      "sudo sh -c 'install -d -m 0755 '\\''/etc/isoloom/services/files'\\'' && install -m 0444 '\\''/tmp/isoloom-service-files-endpoint'\\'' '\\''/etc/isoloom/services/files/endpoint'\\'' && rm -f '\\''/tmp/isoloom-service-files-endpoint'\\'' && install -m 0444 '\\''/tmp/isoloom-service-files-bucket'\\'' '\\''/etc/isoloom/services/files/bucket'\\'' && rm -f '\\''/tmp/isoloom-service-files-bucket'\\'' && install -m 0444 '\\''/tmp/isoloom-service-files-region'\\'' '\\''/etc/isoloom/services/files/region'\\'' && rm -f '\\''/tmp/isoloom-service-files-region'\\'' && install -m 0444 '\\''/tmp/isoloom-service-files-api'\\'' '\\''/etc/isoloom/services/files/api'\\'' && rm -f '\\''/tmp/isoloom-service-files-api'\\'' && install -m 0444 '\\''/tmp/isoloom-service-files-identity'\\'' '\\''/etc/isoloom/services/files/identity'\\'' && rm -f '\\''/tmp/isoloom-service-files-identity'\\'''"
    ]
  }
  depends_on = [terraform_data.isoloom_ready_worker]
}

resource "terraform_data" "isoloom_service_bus_to_web" {
  triggers_replace = [
    aws_instance.web.id,
    sha256(jsonencode([
      aws_msk_cluster.bus.bootstrap_brokers_sasl_scram,
      "SASL_SSL",
      "SCRAM-SHA-512",
      var.ISOLOOM_SECRET_BUS_USER,
      var.ISOLOOM_SECRET_BUS_PASSWORD
    ]))
  ]
  connection {
    type        = "ssh"
    host        = aws_instance.web.public_ip
    user        = "admin"
    private_key = file(pathexpand(var.ssh_private_key_file))
    timeout     = "10m"
  }
  provisioner "file" {
    content     = aws_msk_cluster.bus.bootstrap_brokers_sasl_scram
    destination = "/tmp/isoloom-service-bus-bootstrap"
  }
  provisioner "file" {
    content     = "SASL_SSL"
    destination = "/tmp/isoloom-service-bus-security-protocol"
  }
  provisioner "file" {
    content     = "SCRAM-SHA-512"
    destination = "/tmp/isoloom-service-bus-sasl-mechanism"
  }
  provisioner "file" {
    content     = var.ISOLOOM_SECRET_BUS_USER
    destination = "/tmp/isoloom-service-bus-user"
  }
  provisioner "file" {
    content     = var.ISOLOOM_SECRET_BUS_PASSWORD
    destination = "/tmp/isoloom-service-bus-password"
  }
  provisioner "remote-exec" {
    inline = [
      "sudo sh -c 'install -d -m 0755 '\\''/etc/isoloom/services/bus'\\'' && install -m 0444 '\\''/tmp/isoloom-service-bus-bootstrap'\\'' '\\''/etc/isoloom/services/bus/bootstrap'\\'' && rm -f '\\''/tmp/isoloom-service-bus-bootstrap'\\'' && install -m 0444 '\\''/tmp/isoloom-service-bus-security-protocol'\\'' '\\''/etc/isoloom/services/bus/security-protocol'\\'' && rm -f '\\''/tmp/isoloom-service-bus-security-protocol'\\'' && install -m 0444 '\\''/tmp/isoloom-service-bus-sasl-mechanism'\\'' '\\''/etc/isoloom/services/bus/sasl-mechanism'\\'' && rm -f '\\''/tmp/isoloom-service-bus-sasl-mechanism'\\'' && install -m 0400 '\\''/tmp/isoloom-service-bus-user'\\'' '\\''/etc/isoloom/services/bus/user'\\'' && rm -f '\\''/tmp/isoloom-service-bus-user'\\'' && install -m 0400 '\\''/tmp/isoloom-service-bus-password'\\'' '\\''/etc/isoloom/services/bus/password'\\'' && rm -f '\\''/tmp/isoloom-service-bus-password'\\'''"
    ]
  }
  depends_on = [terraform_data.isoloom_ready_web]
}

resource "terraform_data" "isoloom_service_bus_to_worker" {
  triggers_replace = [
    aws_instance.worker.id,
    sha256(jsonencode([
      aws_msk_cluster.bus.bootstrap_brokers_sasl_iam,
      "SASL_SSL",
      "AWS_MSK_IAM",
      aws_iam_role.isoloom_client_worker.arn
    ]))
  ]
  connection {
    type        = "ssh"
    host        = aws_instance.worker.public_ip
    user        = "admin"
    private_key = file(pathexpand(var.ssh_private_key_file))
    timeout     = "10m"
  }
  provisioner "file" {
    content     = aws_msk_cluster.bus.bootstrap_brokers_sasl_iam
    destination = "/tmp/isoloom-service-bus-bootstrap"
  }
  provisioner "file" {
    content     = "SASL_SSL"
    destination = "/tmp/isoloom-service-bus-security-protocol"
  }
  provisioner "file" {
    content     = "AWS_MSK_IAM"
    destination = "/tmp/isoloom-service-bus-sasl-mechanism"
  }
  provisioner "file" {
    content     = aws_iam_role.isoloom_client_worker.arn
    destination = "/tmp/isoloom-service-bus-identity"
  }
  provisioner "remote-exec" {
    inline = [
      "sudo sh -c 'install -d -m 0755 '\\''/etc/isoloom/services/bus'\\'' && install -m 0444 '\\''/tmp/isoloom-service-bus-bootstrap'\\'' '\\''/etc/isoloom/services/bus/bootstrap'\\'' && rm -f '\\''/tmp/isoloom-service-bus-bootstrap'\\'' && install -m 0444 '\\''/tmp/isoloom-service-bus-security-protocol'\\'' '\\''/etc/isoloom/services/bus/security-protocol'\\'' && rm -f '\\''/tmp/isoloom-service-bus-security-protocol'\\'' && install -m 0444 '\\''/tmp/isoloom-service-bus-sasl-mechanism'\\'' '\\''/etc/isoloom/services/bus/sasl-mechanism'\\'' && rm -f '\\''/tmp/isoloom-service-bus-sasl-mechanism'\\'' && install -m 0444 '\\''/tmp/isoloom-service-bus-identity'\\'' '\\''/etc/isoloom/services/bus/identity'\\'' && rm -f '\\''/tmp/isoloom-service-bus-identity'\\'''"
    ]
  }
  depends_on = [terraform_data.isoloom_ready_worker]
}
