    m.trigger.before :"VagrantPlugins::HyperV::Action::StartInstance", type: :action do |t|
      t.ruby { |_, machine| IsoloomHyperV.attach(machine, [["isoloom-ansible-pair-lab", "0215605C41D5"]]) }
    end
    m.trigger.after :"VagrantPlugins::HyperV::Action::WaitForIPAddress", type: :action do |t|
      t.ruby do |_, machine|
        IsoloomHyperV.address(machine, <<~'SH')
          set -e
          mkdir -p /etc/isoloom
          cat > /etc/isoloom/env-net.sh <<'NET'
          #!/bin/sh
          # This machine's addresses on the environment's networks (Hyper-V sets none), by adapter MAC.
          set_address() {
            for d in /sys/class/net/*; do
              [ "$(cat "$d/address" 2>/dev/null)" = "$1" ] || continue
              IF=${d##*/}
              if command -v nmcli >/dev/null; then nmcli device set "$IF" managed no 2>/dev/null || true; fi
              ip link set "$IF" up
              ip -4 addr show dev "$IF" | grep -q " $2 " || ip addr add "$2" dev "$IF"
              return 0
            done
            echo "isoloom: no network adapter with MAC $1" >&2
            return 1
          }
          rc=0
          set_address 02:15:60:5c:41:d5 10.63.0.20/24 || rc=1
          exit $rc
          NET
          chmod +x /etc/isoloom/env-net.sh
          # NetworkManager would try DHCP there.
          if [ -d /etc/NetworkManager/conf.d ]; then
            printf '[keyfile]\nunmanaged-devices=mac:02:15:60:5c:41:d5\n' > /etc/NetworkManager/conf.d/90-isoloom-env-net.conf
          fi
          if [ -d /run/systemd/system ]; then
            cat > /etc/systemd/system/isoloom-env-net.service <<'UNIT'
          [Unit]
          Description=Isoloom: addresses on the environment networks
          After=network-pre.target NetworkManager.service systemd-networkd.service
          Before=network-online.target isoloom-routes.service

          [Service]
          Type=oneshot
          RemainAfterExit=yes
          ExecStart=/etc/isoloom/env-net.sh

          [Install]
          WantedBy=multi-user.target
          UNIT
            systemctl daemon-reload
            systemctl enable -q isoloom-env-net.service
          elif command -v rc-update >/dev/null; then
            printf '#!/bin/sh\nexec /etc/isoloom/env-net.sh\n' > /etc/local.d/isoloom-env-net.start
            chmod +x /etc/local.d/isoloom-env-net.start
            rc-update add local default >/dev/null
          fi
          /etc/isoloom/env-net.sh
        SH
      end
    end
    m.trigger.after :"VagrantPlugins::HyperV::Action::DeleteVM", type: :action do |t|
      t.ruby { |_, _| IsoloomHyperV.prune(["isoloom-ansible-pair-lab"]) }
    end
    m.vm.provision "addresses", type: "shell", run: "always", inline: "set -eu
command -v nmcli >/dev/null 2>&1 && nmcli -t general status >/dev/null 2>&1 || exit 0
cards=\"\"
for address in \"$@\"; do
  ip=${address%/*}
  card=$(ip -o -4 addr show | awk -v ip=\"$ip\" '{ split($4, a, \"/\"); if (a[1] == ip) { print $2; exit } }')
  if [ -z \"$card\" ]; then
    # Dropped already: the card NetworkManager is configuring that has no IPv4 address.
    for c in $(nmcli -t -f DEVICE,STATE device | awk -F: '$2 ~ /^connecting/ { print $1 }'); do
      [ -n \"$(ip -o -4 addr show dev \"$c\")\" ] || { card=$c; break; }
    done
  fi
  [ -n \"$card\" ] || { echo \"addresses: no card for $address\" >&2; exit 1; }
  nmcli device set \"$card\" managed no
  ip -o -4 addr show dev \"$card\" | grep -q \" $ip/\" || ip addr add \"$address\" dev \"$card\"
  ip link set \"$card\" up
  case \";$cards;\" in *\";interface-name:$card;\"*) ;; *) cards=\"$cards${cards:+;}interface-name:$card\" ;; esac
done
mkdir -p /etc/NetworkManager/conf.d
printf '[keyfile]\\nunmanaged-devices=%s\\n' \"$cards\" >/etc/NetworkManager/conf.d/90-isoloom-addresses.conf
", args: ["10.63.0.20/24"]
    m.vm.provision "isoloom_project", name: "project"
    m.vm.provision "shell", name: "hosts", inline: "printf '%s\\n' '10.63.0.10 web' '10.63.0.20 cache' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '%s\\n' \"$l\" >> /etc/hosts; done"
    m.vm.provision "shell", name: "ready", inline: "mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready"
    m.vm.provision "shell", name: "checks", run: "never", path: "checks/cache.sh", env: { "ISOLOOM_DERIVED" => ENV.fetch("ISOLOOM_DERIVED", "1") }
  end

  config.vm.define "isoloom-controller" do |m|
    m.vm.box = RbConfig::CONFIG["host_cpu"] =~ /arm|aarch64/ ? "bento/debian-12" : "generic/alpine319"
    m.vm.hostname = "isoloom-controller"
    m.vm.network "private_network", ip: "10.63.0.253", netmask: "255.255.255.0", virtualbox__intnet: "isoloom-ansible-pair-lab", libvirt__network_name: "isoloom-ansible-pair-lab", libvirt__dhcp_enabled: false
    m.vm.provider "virtualbox" do |v|
      v.name = "ansible-pair - isoloom-controller"
      v.linked_clone = true
      v.cpus = 1
      v.memory = 768
    end
    m.vm.provider "vmware_desktop" do |v|
      v.vmx["displayName"] = "ansible-pair - isoloom-controller"
      v.vmx["numvcpus"] = "1"
      v.vmx["memsize"] = "768"
    end
    m.vm.provider "parallels" do |v|
      v.name = "ansible-pair - isoloom-controller"
      v.linked_clone = true
      v.cpus = 1
      v.memory = 768
    end
    m.vm.provider "qemu" do |v, o|
      o.vm.box = "cloud-image/debian-12"
      o.vm.box_version = ">= 0"
      v.smp = "cpus=1"
      v.memory = "768M"
      v.ssh_auto_correct = true
      # Its port of network `lab`'s hub (see IsoloomQemu).
      v.advanced_network = true
      v.net_mode = :socket
      v.socket_opts = "connect=127.0.0.1:#{QEMU_HUBS["lab"]["isoloom-controller"]}"
    end
    m.trigger.before :"VagrantPlugins::QEMU::Action::StartInstance", type: :action do |t|
      t.ruby { |_, _| IsoloomQemu.hub("lab", QEMU_HUBS["lab"]) }
    end
    m.trigger.after :"VagrantPlugins::QEMU::Action::Destroy", type: :action do |t|
      t.ruby { |env, machine| IsoloomQemu.release("lab", QEMU_HUBS["lab"].keys, env, machine.name) }
    end
    m.vm.provider "vmware_esxi" do |v, o|
      o.vm.box = "bento/debian-12"
      v.esxi_hostname = ENV.fetch("ESXI_HOSTNAME", "")
      v.esxi_hostport = ENV.fetch("ESXI_HOSTPORT", "22").to_i
      v.esxi_username = ENV.fetch("ESXI_USERNAME", "root")
      v.esxi_password = "env:ESXI_PASSWORD"
      v.esxi_disk_store = ENV["ESXI_DATASTORE"] if ENV["ESXI_DATASTORE"]
      v.esxi_virtual_network = esxi_networks([1])
      v.guest_name = "ansible-pair-isoloom-controller"
      v.guest_numvcpus = 1
      v.guest_memsize = 768
    end
    m.vm.provider "libvirt" do |v, o|
      o.vm.box = "generic/alpine319"
      o.vm.box_version = ">= 0"
      o.vm.box_architecture = :auto
      v.cpus = 1
      v.memory = 768
    end
    m.vm.provider "hyperv" do |v, o|
      v.vmname = "ansible-pair-isoloom-controller"
      v.cpus = 1
      v.memory = 768
      v.linked_clone = true
      # Alpine sets a hostname by restarting every interface: SSH to it drops on Hyper-V.
      o.vm.hostname = nil
      o.vm.network "private_network", bridge: HYPERV_SWITCH
    end
    m.trigger.before :"VagrantPlugins::HyperV::Action::Configure", type: :action do |t|
      t.ruby { |_, _| IsoloomHyperV.switches(["isoloom-ansible-pair-lab"]) }
    end
    m.trigger.before :"VagrantPlugins::HyperV::Action::StartInstance", type: :action do |t|
      t.ruby { |_, machine| IsoloomHyperV.attach(machine, [["isoloom-ansible-pair-lab", "0215B7AAD166"]]) }
    end
    m.trigger.after :"VagrantPlugins::HyperV::Action::WaitForIPAddress", type: :action do |t|
      t.ruby do |_, machine|
        IsoloomHyperV.address(machine, <<~'SH')
          set -e
          mkdir -p /etc/isoloom
          cat > /etc/isoloom/env-net.sh <<'NET'
          #!/bin/sh
          # This machine's addresses on the environment's networks (Hyper-V sets none), by adapter MAC.
          set_address() {
            for d in /sys/class/net/*; do
              [ "$(cat "$d/address" 2>/dev/null)" = "$1" ] || continue
              IF=${d##*/}
              if command -v nmcli >/dev/null; then nmcli device set "$IF" managed no 2>/dev/null || true; fi
              ip link set "$IF" up
              ip -4 addr show dev "$IF" | grep -q " $2 " || ip addr add "$2" dev "$IF"
              return 0
            done
            echo "isoloom: no network adapter with MAC $1" >&2
            return 1
          }
          rc=0
          set_address 02:15:b7:aa:d1:66 10.63.0.253/24 || rc=1
          exit $rc
          NET
          chmod +x /etc/isoloom/env-net.sh
          # NetworkManager would try DHCP there.
          if [ -d /etc/NetworkManager/conf.d ]; then
            printf '[keyfile]\nunmanaged-devices=mac:02:15:b7:aa:d1:66\n' > /etc/NetworkManager/conf.d/90-isoloom-env-net.conf
          fi
          if [ -d /run/systemd/system ]; then
            cat > /etc/systemd/system/isoloom-env-net.service <<'UNIT'
          [Unit]
          Description=Isoloom: addresses on the environment networks
          After=network-pre.target NetworkManager.service systemd-networkd.service
          Before=network-online.target isoloom-routes.service

          [Service]
          Type=oneshot
          RemainAfterExit=yes
          ExecStart=/etc/isoloom/env-net.sh

          [Install]
          WantedBy=multi-user.target
          UNIT
            systemctl daemon-reload
            systemctl enable -q isoloom-env-net.service
          elif command -v rc-update >/dev/null; then
            printf '#!/bin/sh\nexec /etc/isoloom/env-net.sh\n' > /etc/local.d/isoloom-env-net.start
            chmod +x /etc/local.d/isoloom-env-net.start
            rc-update add local default >/dev/null
          fi
          /etc/isoloom/env-net.sh
        SH
      end
    end
    m.trigger.after :"VagrantPlugins::HyperV::Action::DeleteVM", type: :action do |t|
      t.ruby { |_, _| IsoloomHyperV.prune(["isoloom-ansible-pair-lab"]) }
    end
    m.vm.provision "shell", name: "hosts", inline: "printf '%s\\n' '10.63.0.10 web' '10.63.0.20 cache' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '%s\\n' \"$l\" >> /etc/hosts; done"
    m.vm.provision "isoloom_project", name: "project"
    m.vm.provision "shell", name: "controller", inline: <<~'SH'
      set -e
      if command -v apk >/dev/null; then
        apk add -q --no-cache python3 sshpass curl netcat-openbsd
      else
        export DEBIAN_FRONTEND=noninteractive
        apt-get update -qq
        apt-get install -y -qq python3-venv sshpass curl netcat-openbsd >/dev/null
      fi
      [ -x /opt/ansible/bin/ansible-playbook ] || { python3 -m venv /opt/ansible && /opt/ansible/bin/pip install -q 'ansible-core>=2.15,<2.17' pywinrm; }
      mkdir -p /etc/isoloom
      cat > /etc/isoloom/inventory.ini <<'INV'
      [linux]
      web ansible_host=10.63.0.10
      cache ansible_host=10.63.0.20 maxmemory='"64mb"'

      [windows]

      [linux:vars]
      ansible_user=vagrant
      ansible_password=vagrant
      ansible_become=true

      [webservers]
      web

      [caches]
      cache

      [pair]
      web
      cache
      INV
    SH
    m.vm.provision "shell", name: "ansible", inline: <<~'SH'
      set -e
      mkdir -p /tmp/isoloom-facts
      export PATH="/opt/ansible/bin:$PATH" ANSIBLE_HOST_KEY_CHECKING=False ANSIBLE_GATHERING=smart ANSIBLE_FORKS=20 ANSIBLE_PIPELINING=True ANSIBLE_CACHE_PLUGIN=jsonfile ANSIBLE_CACHE_PLUGIN_CONNECTION=/tmp/isoloom-facts ANSIBLE_CACHE_PLUGIN_TIMEOUT=7200
      mkdir -p /tmp/isoloom-retry
      export ANSIBLE_RETRY_FILES_ENABLED=True ANSIBLE_RETRY_FILES_SAVE_PATH=/tmp/isoloom-retry
      _isoloom_pause=${ISOLOOM_RETRY_PAUSE:-15}
      _isoloom_attempts=4
      _isoloom_transient='send_input failed|the pipe has been ended|winrmtransporterror|winrmoperationtimeouterror|read timeout|bad http response returned from server|(kerberos|ntlm|credssp).*500|remote end closed connection|connection reset by peer|connection refused|connection aborted|broken pipe|timed out|failed to connect to the host via ssh|shared connection to .* closed'
      retry_download() {
        _isoloom_n=1
        until "$@"; do
          [ "$_isoloom_n" -lt 5 ] || return 1
          echo "isoloom: download failed; trying again in $((_isoloom_n * _isoloom_pause)) s ($((_isoloom_n + 1))/5)"
          sleep $((_isoloom_n * _isoloom_pause))
          _isoloom_n=$((_isoloom_n + 1))
        done
      }
      play_hosts() {
        awk -v transient="$_isoloom_transient" '
          function commit() {
            if (pending != "") { if (pending_real) real[pending] = 1; else cut[pending] = 1 }
            pending = ""
          }
          { gsub(/\033\[[0-9;]*m/, "") }
          /^\.\.\.ignoring/ { pending = ""; next }
          { commit() }
          /^(fatal|failed): \[/ && !/UNREACHABLE!/ {
            pending = $0
            sub(/^(fatal|failed): \[/, "", pending)
            sub(/\].*/, "", pending)
            sub(/ -> .*/, "", pending)
            pending_real = (tolower($0) !~ transient)
            next
          }
          /^PLAY RECAP/ { recap = 1; next }
          recap && / : ok=/ {
            for (i = 2; i <= NF; i++) {
              split($i, kv, "=")
              if (kv[1] == "failed" && kv[2] > 0) failed[$1] = 1
              if (kv[1] == "unreachable" && kv[2] > 0) unreachable[$1] = 1
            }
          }
          END {
            commit()
            for (h in failed) print ((h in real || !(h in cut)) ? "real " : "cut ") h
            for (h in unreachable) if (!(h in failed)) print "unreachable " h
          }
        ' "$1" | sort
      }
      _isoloom_kind() {
        echo "$1" | awk -v k="$2" '$1 == k { printf "%s%s", s, $2; s = " " }'
      }
      run_play() {
        # The playbook is the last argument; Ansible names its retry file after it.
        for _isoloom_book; do :; done
        _isoloom_name=$(basename "$_isoloom_book")
        _isoloom_retry=${ANSIBLE_RETRY_FILES_SAVE_PATH:-/tmp/isoloom-retry}/${_isoloom_name%.*}.retry
        _isoloom_limit=
        _isoloom_log=$(mktemp)
        _isoloom_rcf=$(mktemp)
        _isoloom_n=1
        rm -f "$_isoloom_retry"
        while :; do
          { "$@" && echo 0 > "$_isoloom_rcf" || echo $? > "$_isoloom_rcf"; } 2>&1 | tee "$_isoloom_log"
          _isoloom_rc=$(cat "$_isoloom_rcf")
          [ "$_isoloom_rc" -ne 0 ] || break
          _isoloom_hosts=$(play_hosts "$_isoloom_log")
          _isoloom_real=$(_isoloom_kind "$_isoloom_hosts" real)
          _isoloom_gone=$(_isoloom_kind "$_isoloom_hosts" unreachable)
          _isoloom_cut=$(_isoloom_kind "$_isoloom_hosts" cut)
          _isoloom_again="$_isoloom_gone${_isoloom_gone:+${_isoloom_cut:+ }}$_isoloom_cut"
          if [ -n "$_isoloom_real" ]; then
            echo "isoloom: $_isoloom_name: a task failed on $_isoloom_real: not retried"
            break
          fi
          if [ -z "$_isoloom_again" ]; then
            echo "isoloom: $_isoloom_name failed (exit $_isoloom_rc) with no unreachable host or dropped connection: not retried"
            break
          fi
          if [ "$_isoloom_n" -ge "$_isoloom_attempts" ]; then
            echo "isoloom: $_isoloom_name: still unreachable after $_isoloom_n runs: $_isoloom_again; giving up"
            break
          fi
          echo "$_isoloom_again" | tr ' ' '\n' > "$_isoloom_retry"
          if [ -z "$_isoloom_limit" ]; then set -- "$@" --limit "@$_isoloom_retry"; _isoloom_limit=1; fi
          _isoloom_n=$((_isoloom_n + 1))
          if [ -n "$_isoloom_gone" ]; then
            _isoloom_wait=$((4 * _isoloom_pause))
            echo "isoloom: $_isoloom_name: unreachable: $_isoloom_again; waiting $_isoloom_wait s, then running it again on them ($_isoloom_n/$_isoloom_attempts)"
          else
            _isoloom_wait=$((2 * _isoloom_pause))
            echo "isoloom: $_isoloom_name: the play was cut by a dropped connection on $_isoloom_cut; waiting $_isoloom_wait s, then running it again on them ($_isoloom_n/$_isoloom_attempts)"
          fi
          sleep "$_isoloom_wait"
        done
        rm -f "$_isoloom_log" "$_isoloom_rcf"
        [ "$_isoloom_rc" -ne 0 ] || rm -f "$_isoloom_retry"
        return "$_isoloom_rc"
      }
      cd '/opt/isoloom/ansible'
      retry_download ansible-galaxy install -r '/opt/isoloom/ansible/requirements.yml'
      run_play ansible-playbook -i /etc/isoloom/inventory.ini -i '/opt/isoloom/ansible/groups.ini' -e '{"greeting":"hello from ansible","tools":["curl","jq"],"cache_port":6379}' 'site.yml'
    SH
    m.vm.provision "shell", name: "halt", inline: "touch /run/isoloom-halting; (sleep 5; poweroff) >/dev/null 2>&1 &"
    m.vm.provision "shell", name: "checks", run: "never", inline: [["checks/web-answers.sh", "'/opt/isoloom/checks'", "'/opt/isoloom/checks/web-answers.sh'"]].map { |p, folder, file| "mkdir -p #{folder} && cat > #{file} <<'ISOLOOM_EOF'\n#{File.read(File.join(ROOT, p))}\nISOLOOM_EOF\n" }.join + File.read(File.join(__dir__, "checks/isoloom-controller.sh")), env: { "ISOLOOM_DERIVED" => ENV.fetch("ISOLOOM_DERIVED", "1") }
  end
end
