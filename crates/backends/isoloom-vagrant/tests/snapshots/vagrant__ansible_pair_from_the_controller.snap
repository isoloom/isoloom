# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  cd .isoloom/vagrant && vagrant up
# Stop:   cd .isoloom/vagrant && vagrant destroy -f

# One machine at a time, in order (QEMU and libvirt would boot them all at once).
ENV["VAGRANT_NO_PARALLEL"] = "1"
ROOT = File.expand_path("../..", __dir__)
# This host's CPU as QEMU names it: a machine built for another one runs emulated there.
HOST_ARCH = RbConfig::CONFIG["host_cpu"] =~ /arm|aarch64/ ? "aarch64" : "x86_64"
# The project goes into a VM through Isoloom's own `project` step (the `isoloom_project`
# provisioner below): a tar.gz of the project as it is when the step runs, not when this file
# loads, so files added or removed since still count. Symbolic links go in as links, never
# followed (a link loop can't break the copy). Plain Ruby (Vagrant's own): no tool on the host.
require "zlib"
require "tempfile"

module IsoloomProject
  # Writes the archive of `root` to `io`, gzipped, leaving out what `.isoloomignore` lists, then
  # what `rules` (lines of its syntax, read after the file's) list: Isoloom's outputs but those
  # the machine reads, version control and the tools' state (`COPY_RULES`, the generator's).
  def self.write(root, io, rules: COPY_RULES)
    gz = Zlib::GzipWriter.new(io)
    rules = ignore_rules(root, rules)
    walk(root, nil, rules) { |rel, st| entry(gz, root, rel, st) }
    gz.write("\0" * 1024)
    gz.finish
  end

  # `.isoloomignore` at the project's root, gitignore-style: one pattern per line, `#` comments,
  # `!` brings a path back, a trailing `/` matches folders only, a `/` at the start or in the
  # middle anchors the pattern at the root (otherwise it matches at any depth), `*`, `?`,
  # `[abc]` and `**`. A pattern matching a folder matches everything in it, and the last pattern
  # matching a path (or a folder it is in) decides. As [regexp, keep] pairs, `copy` read after
  # the file; the Terraform outputs translate the patterns the same way, so every target leaves
  # out the same files.
  def self.ignore_rules(root, copy)
    text = begin
      File.binread(File.join(root, ".isoloomignore")).force_encoding("UTF-8")
    rescue Errno::ENOENT
      ""
    end
    "#{text}\n#{copy}".split("\n").filter_map do |line|
      line = line.strip
      next if line.empty? || line.start_with?("#")
      keep = line.start_with?("!")
      pat = keep ? line[1..] : line
      glob = pat.delete_suffix("/").delete_suffix("/**").delete_suffix("/")
      next if glob.empty?
      anchored = glob.include?("/") ? glob.delete_prefix("/") : "**/#{glob}"
      re = anchored.gsub(/[.+^$(){}|\\]/) { "\\#{$&}" }.gsub("[!", "[^")
                   .gsub("**/", "\u0001").gsub("**", "\u0002").gsub("*", "[^/]*").gsub("?", "[^/]")
                   .gsub("\u0001", "(.*/)?").gsub("\u0002", ".*")
      [Regexp.new(glob == pat ? "^#{re}(/|$)" : "^#{re}/"), keep]
    end
  end

  # Whether the rules leave a path out (a folder's path ends with `/`).
  def self.ignored?(rules, path)
    rules.reduce(false) { |out, (re, keep)| re.match?(path) ? !keep : out }
  end

  # Every entry under `dir` (relative to `root`), parents first, in name order.
  def self.walk(root, dir, rules, &block)
    names = begin
      Dir.children(dir ? File.join(root, dir) : root).sort
    rescue Errno::ENOENT, Errno::ENOTDIR
      return # removed while the archive was being written
    end
    names.each do |name|
      rel = dir ? "#{dir}/#{name}" : name
      st = begin
        File.lstat(File.join(root, rel))
      rescue Errno::ENOENT
        next
      end
      folder = st.directory?
      out = ignored?(rules, folder ? "#{rel}/" : rel)
      yield rel, st unless out
      # An ignored folder is skipped, unless a `!` pattern may bring back something in it.
      walk(root, rel, rules, &block) if folder && (!out || rules.any? { |_, keep| keep })
    end
  end

  def self.entry(out, root, rel, st)
    path = File.join(root, rel)
    if st.symlink?
      header(out, rel, "2", 0o777, 0, st.mtime, File.readlink(path))
    elsif st.directory?
      header(out, "#{rel}/", "5", st.mode & 0o7777, 0, st.mtime)
    elsif st.file?
      File.open(path, "rb") do |f|
        mode = st.mode & 0o7777
        # Windows has no executable bit: a script (#!) is made executable.
        mode |= 0o111 if Gem.win_platform? && f.read(2) == "#!"
        f.rewind
        header(out, rel, "0", mode, st.size, st.mtime)
        copied = IO.copy_stream(f, out, st.size)
        out.write("\0" * (st.size - copied)) if copied < st.size # shrank while being read
        out.write("\0" * ((512 - st.size % 512) % 512))
      end
    end
  rescue Errno::ENOENT
    nil # removed while the archive was being written
  end

  # A ustar header; a pax one before it for what ustar can't hold (long names, large sizes).
  def self.header(out, name, type, mode, size, mtime, link = "")
    name = name.b
    link = link.b
    pax = {}
    pax["path"] = name if name.bytesize > 100
    pax["linkpath"] = link if link.bytesize > 100
    pax["size"] = size.to_s if size >= 8**11
    unless pax.empty?
      body = pax.map { |k, v| record(k, v) }.join
      header(out, "PaxHeader/#{name.byteslice(0, 80)}", "x", 0o644, body.bytesize, mtime)
      out.write(body)
      out.write("\0" * ((512 - body.bytesize % 512) % 512))
    end
    h = [
      name.byteslice(0, 100), format("%07o", mode), format("%07o", 0), format("%07o", 0),
      format("%011o", size >= 8**11 ? 0 : size), format("%011o", [mtime.to_i, 0].max), " " * 8, type,
      link.byteslice(0, 100), "ustar", "00", "", "", "", "", "", "",
    ].pack("a100a8a8a8a12a12a8a1a100a6a2a32a32a8a8a155a12")
    h[148, 8] = format("%06o\0 ", h.sum(0))
    out.write(h)
  end

  # One pax record: "<length> key=value\n", the length counting itself.
  def self.record(key, value)
    rest = " #{key}=".b + value + "\n"
    len = rest.bytesize + 1
    len += 1 while (len.to_s.bytesize + rest.bytesize) > len
    len.to_s.b + rest
  end
end

if defined?(Vagrant) && Vagrant.respond_to?(:plugin)
  module IsoloomProject
    class Config < Vagrant.plugin("2", :config)
      attr_accessor :name, :rules

      def initialize
        super
        @name = UNSET_VALUE
        @rules = UNSET_VALUE
      end

      def finalize!
        @name = nil if @name == UNSET_VALUE
        @rules = COPY_RULES if @rules == UNSET_VALUE
      end
    end

    # Builds the archive, uploads it to LINUX_ARCHIVE (WINDOWS_ARCHIVE on Windows, over WinRM or
    # OpenSSH) and unpacks it as root with LINUX_UNPACK (WINDOWS_UNPACK), replacing an older copy.
    # The archives' paths and the unpacking are the generator's, set after this file.
    class Provisioner < Vagrant.plugin("2", :provisioner)
      def provision
        windows = %w[winrm winssh].include?(@machine.config.vm.communicator.to_s)
        Tempfile.create(["isoloom-project", ".tgz"]) do |f|
          f.binmode
          IsoloomProject.write(ROOT, f, rules: config.rules)
          f.close
          @machine.ui.info("The project, #{(File.size(f.path) / 1024.0).ceil} KB compressed, into the VM")
          comm = @machine.communicate
          if windows
            comm.upload(f.path, WINDOWS_ARCHIVE)
            comm.execute(WINDOWS_UNPACK, elevated: true) do |type, data|
              @machine.ui.info(data.chomp) if type == :stdout && !data.strip.empty?
            end
          else
            comm.upload(f.path, LINUX_ARCHIVE)
            comm.sudo(LINUX_UNPACK)
          end
        end
      end
    end

    class Plugin < Vagrant.plugin("2")
      name "isoloom project"
      config(:isoloom_project, :provisioner) { Config }
      provisioner(:isoloom_project) { Provisioner }
    end
  end
end

# What a copy of the project leaves out beyond .isoloomignore.
IsoloomProject::COPY_RULES = "/.isoloom*
.git/
.terraform/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
crash.log
crash.*.log
.vagrant/
"
# Where the project's archive is uploaded, and how it is unpacked, as root (on Windows,
# with no tar.exe before Windows Server 2019).
IsoloomProject::LINUX_ARCHIVE = "/tmp/isoloom-project.tgz"
IsoloomProject::LINUX_UNPACK = "rm -rf /opt/isoloom && mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom && rm -f /tmp/isoloom-project.tgz"
IsoloomProject::WINDOWS_ARCHIVE = "C:\\Windows\\Temp\\isoloom-project.tgz"
IsoloomProject::WINDOWS_UNPACK = <<'PS1'
$archive = 'C:\Windows\Temp\isoloom-project.tgz'; $dest = 'C:\isoloom'; $strip = 0
# The project into a Windows machine: unpacks the tar.gz $archive into $dest (replacing an older
# copy), leaving out the archive's first $strip folders. Plain .NET (GZipStream), so it runs on
# every Windows Isoloom supports: PowerShell 2.0 and later, and no tar.exe before Windows Server
# 2019. Symbolic links are left out (counted).
& {
  $ErrorActionPreference = 'Stop'
  $sep = [IO.Path]::DirectorySeparatorChar
  $new = "$dest.new"
  if (Test-Path $new) { Remove-Item $new -Recurse -Force }
  [void][IO.Directory]::CreateDirectory($new)
  $file = New-Object IO.FileStream($archive, [IO.FileMode]::Open, [IO.FileAccess]::Read)
  $in = New-Object IO.Compression.GZipStream($file, [IO.Compression.CompressionMode]::Decompress)
  $utf8 = New-Object Text.UTF8Encoding($false)
  $header = New-Object byte[] 512
  $chunk = New-Object byte[] 65536
  function Fill([byte[]]$b, [int]$n) {
    $got = 0
    while ($got -lt $n) {
      $r = $in.Read($b, $got, $n - $got)
      if ($r -le 0) { throw "$archive ends early" }
      $got += $r
    }
  }
  function Field([int]$at, [int]$len) {
    $end = [Array]::IndexOf($header, [byte]0, $at, $len)
    if ($end -lt 0) { $end = $at + $len }
    $utf8.GetString($header, $at, $end - $at)
  }
  # Copies $size bytes to $out (or skips them, with no $out), then the padding after them.
  function Body([long]$size, $out) {
    $left = $size
    while ($left -gt 0) {
      $n = [int][Math]::Min([long]$chunk.Length, $left)
      Fill $chunk $n
      if ($out) { $out.Write($chunk, 0, $n) }
      $left -= $n
    }
    $pad = [int]((512 - $size % 512) % 512)
    if ($pad) { Fill $chunk $pad }
  }
  $pax = @{}
  $links = 0
  $files = 0
  while ($true) {
    Fill $header 512
    if ($header[148] -eq 0) { break } # the end: zero blocks have no checksum
    $type = [char]$header[156]
    $sizeText = (Field 124 12).Trim()
    $size = [long]0
    if ($sizeText) { $size = [Convert]::ToInt64($sizeText, 8) }
    if ($pax['size']) { $size = [long]$pax['size'] }
    if ($type -eq 'x') {
      # pax records ("<length> key=value\n"): a long path, a large size, for the next entry.
      $ms = New-Object IO.MemoryStream
      Body $size $ms
      $b = $ms.ToArray()
      $i = 0
      while ($i -lt $b.Length) {
        $sp = [Array]::IndexOf($b, [byte]32, $i)
        $len = [int]$utf8.GetString($b, $i, $sp - $i)
        $eq = [Array]::IndexOf($b, [byte]61, $sp)
        $pax[$utf8.GetString($b, $sp + 1, $eq - $sp - 1)] = $utf8.GetString($b, $eq + 1, $i + $len - $eq - 2)
        $i += $len
      }
      continue
    }
    if ($type -eq 'L' -or $type -eq 'K') {
      # GNU tar's long name (or link target) for the next entry.
      $ms = New-Object IO.MemoryStream
      Body $size $ms
      if ($type -eq 'L') { $pax['path'] = $utf8.GetString($ms.ToArray()).TrimEnd([char]0) }
      continue
    }
    $name = Field 0 100
    $prefix = Field 345 155
    if ($prefix) { $name = "$prefix/$name" }
    if ($pax['path']) { $name = $pax['path'] }
    $pax = @{}
    $parts = @($name.Split('/') | Where-Object { $_ -ne '' -and $_ -ne '.' })
    if ($parts.Count -le $strip) { Body $size $null; continue }
    $path = Join-Path $new ([string]::Join([string]$sep, [string[]]($parts[$strip..($parts.Count - 1)])))
    if ($type -eq '5' -or $type -eq '0' -or $type -eq [char]0) {
      # A name Windows can't take (`:`, `*`, too long...) is left out, with a warning.
      $out = $null
      try {
        if ($type -eq '5') {
          [void][IO.Directory]::CreateDirectory($path)
        } else {
          [void][IO.Directory]::CreateDirectory([IO.Path]::GetDirectoryName($path))
          $out = [IO.File]::Create($path)
        }
      } catch {
        Write-Warning "Not copied: $name ($($_.Exception.Message))"
        Body $size $null
        continue
      }
      if ($out) {
        try { Body $size $out } finally { $out.Close() }
        $files++
      } else {
        Body $size $null
      }
    } else {
      if ($type -eq '2') { $links++ }
      Body $size $null
    }
  }
  $in.Close()
  if (Test-Path $dest) { Remove-Item $dest -Recurse -Force }
  Move-Item $new $dest
  Remove-Item $archive -Force
  $note = ''
  if ($links) { $note = " ($links symbolic links left out)" }
  "$files files in $dest$note"
}
PS1
# Hyper-V (`vagrant up --provider hyperv`, from an elevated shell: an administrator, or a member
# of Hyper-V Administrators). Vagrant connects every adapter of a VM to one virtual switch and
# sets no address in the guest, so Isoloom does the rest:
# - the first adapter (Vagrant's own connection, and the internet) is on ISOLOOM_HYPERV_SWITCH,
#   else the Default Switch (Windows 10 and 11; on Windows Server, name an external or NAT one);
# - each network is a private switch named after it (between the VMs only, like a VirtualBox
#   internal network), created when missing and removed with the environment's last VM;
# - each VM has an adapter there with a fixed MAC, attached before every start (Vagrant has
#   just connected them all to the first switch), and its address set in the guest once it
#   answers (a boot-time unit on Linux, a static address on Windows);
# - published ports aren't forwarded to the host (Hyper-V can't): Windows' port proxy relays each
#   one (TCP) from 127.0.0.1 to the VM's address, set at every start (the address may change)
#   and removed with the VM.
HYPERV_SWITCH = ENV.fetch("ISOLOOM_HYPERV_SWITCH", "Default Switch")
module IsoloomHyperV
  def self.fail!(message)
    raise Class.new(Vagrant::Errors::VagrantError) { define_method(:error_message) { "Hyper-V: #{message}" } }
  end

  # Runs PowerShell on this host: its output, or the error it stopped on.
  def self.ps(script)
    require "vagrant/util/powershell"
    r = Vagrant::Util::PowerShell.execute_inline("$ErrorActionPreference = 'Stop'; #{script}")
    fail!(r.stderr.strip.empty? ? r.stdout.strip : r.stderr.strip) if r.exit_code != 0
    r.stdout
  end

  # A PowerShell string.
  def self.q(s)
    "'#{s.to_s.gsub("'", "''")}'"
  end

  # Before Vagrant picks the first adapter's switch: that switch exists (Vagrant would otherwise
  # ask which one, or take another), and so do the networks' private switches.
  def self.switches(names)
    ps((["if (-not (Hyper-V\\Get-VMSwitch -Name #{q(HYPERV_SWITCH)} -ErrorAction SilentlyContinue)) { throw ('no virtual switch named ' + #{q(HYPERV_SWITCH)} + ': set ISOLOOM_HYPERV_SWITCH to one of Get-VMSwitch') }"] +
        names.map { |n| "if (-not (Hyper-V\\Get-VMSwitch -Name #{q(n)} -ErrorAction SilentlyContinue)) { Hyper-V\\New-VMSwitch -Name #{q(n)} -SwitchType Private | Out-Null }" }).join("; "))
  end

  # Before the VM starts: its adapter on each network's switch, found by its MAC (added the
  # first time), connected there.
  def self.attach(machine, nics)
    return if nics.empty?
    ps((["$vm = Hyper-V\\Get-VM -Id #{q(machine.id)}"] + nics.map { |sw, mac|
      "$a = @(Hyper-V\\Get-VMNetworkAdapter -VM $vm | Where-Object { $_.MacAddress -eq #{q(mac)} }); " \
      "if ($a.Count -eq 0) { Hyper-V\\Add-VMNetworkAdapter -VM $vm -Name #{q(sw)} -SwitchName #{q(sw)} -StaticMacAddress #{q(mac)} } " \
      "else { Hyper-V\\Connect-VMNetworkAdapter -VMNetworkAdapter $a[0] -SwitchName #{q(sw)} }"
    }).join("; "))
  end

  # Before the VM starts: a virtual TPM 2.0, with a key protector of this host's own (Hyper-V
  # enables none without one). A generation 1 VM has no TPM to give: an error when the spec
  # requires one, else it starts without (Windows 11's boxes install without one).
  def self.tpm(machine, required)
    ps("$vm = Hyper-V\\Get-VM -Id #{q(machine.id)}; " \
       "if ($vm.Generation -lt 2) { if (#{required ? '$true' : '$false'}) { throw ($vm.Name + ' is a generation 1 VM: it has no virtual TPM') } } " \
       "elseif (-not (Hyper-V\\Get-VMSecurity -VM $vm).TpmEnabled) { Hyper-V\\Set-VMKeyProtector -VM $vm -NewLocalKeyProtector; Hyper-V\\Enable-VMTPM -VM $vm }")
  end

  # Once the VM has an address (a Hyper-V step, so this runs on Hyper-V only), when the guest
  # answers, before its provisioning: its addresses on the networks.
  def self.address(machine, script)
    fail!("#{machine.name} didn't answer within #{machine.config.vm.boot_timeout} s") unless machine.communicate.wait_for_ready(machine.config.vm.boot_timeout)
    machine.communicate.sudo(script)
  end

  # Hyper-V forwards no ports: each published one (guest => host) relayed from this host's
  # 127.0.0.1 to the VM's address by Windows' port proxy (TCP; the IP Helper service), set again
  # at every start since the address may change. `host` is the number the port's forward takes
  # (the runner's choice in ISOLOOM_HOSTPORTS, else the published one).
  def self.ports(machine, ports)
    ip = (machine.ssh_info || {})[:host]
    fail!("#{machine.name} has no address to relay its ports to") unless ip
    ps(ports.map { |guest, host|
      "netsh interface portproxy delete v4tov4 listenaddress=127.0.0.1 listenport=#{host} | Out-Null; " \
      "netsh interface portproxy add v4tov4 listenaddress=127.0.0.1 listenport=#{host} connectaddress=#{ip} connectport=#{guest} | Out-Null; " \
      "if ($LASTEXITCODE -ne 0) { throw 'netsh interface portproxy add failed for 127.0.0.1:#{host}' }"
    }.join("; "))
    machine.ui.info("Hyper-V: " + ports.map { |guest, host| "127.0.0.1:#{host} relayed to #{ip}:#{guest}" }.join("; "))
  end

  # After a VM is deleted: its ports' relays.
  def self.unports(ports)
    ps(ports.map { |_, host| "netsh interface portproxy delete v4tov4 listenaddress=127.0.0.1 listenport=#{host} | Out-Null" }.join("; ") + "; $global:LASTEXITCODE = 0")
  end

  # After a VM is deleted: the networks' switches no VM uses any more.
  def self.prune(names)
    ps(names.map { |n| "if ((Hyper-V\\Get-VMSwitch -Name #{q(n)} -ErrorAction SilentlyContinue) -and -not (Hyper-V\\Get-VMNetworkAdapter -All | Where-Object { $_.SwitchName -eq #{q(n)} })) { Hyper-V\\Remove-VMSwitch -Name #{q(n)} -Force }" }.join("; "))
  end
end
# Vagrant's own check of a host port before forwarding it (`Vagrant::Util::IsPortOpen`) asks
# `Socket.tcp` with a timeout, and on macOS 27 that hands back a socket for a refused connection
# (Ruby bug #22223: the retried `connect_nonblock` answers EISCONN while the socket's SO_ERROR
# still holds ECONNREFUSED). Every host port then reads as in use, and a VM's fixed forwarded
# port fails as a collision before the VM boots (the SSH one Vagrant moves, to a port that read
# as free by luck). On a Mac the check reads the socket's error itself, as Vagrant's should.
if RUBY_PLATFORM.include?("darwin") && defined?(Vagrant)
  require "vagrant/util/is_port_open"

  module Vagrant::Util::IsPortOpen
    def is_port_open?(host, port)
      addr = Addrinfo.tcp(host, port)
      sock = Socket.new(addr.afamily, addr.socktype, addr.protocol)
      begin
        if sock.connect_nonblock(addr, exception: false) == :wait_writable
          return false unless sock.wait_writable(0.1)
        end
        sock.getsockopt(Socket::SOL_SOCKET, Socket::SO_ERROR).int.zero?
      rescue SystemCallError
        false
      ensure
        sock.close
      end
    end
  end
end
# The VMs' graphical consoles, on this computer's loopback only.
# - VMware: the port and password the runner chose for a machine, from ISOLOOM_CONSOLES
#   ({"<machine>": {"port": <n>, "password": "<8 characters>"}}); no console when it chose none.
# - QEMU: a display, a USB tablet, and VNC at the first free display from 5900.
# - VirtualBox: its remote display only with the Oracle extension pack, which brings the server.
module IsoloomConsole
  # The console the runner chose for `machine`, or nil.
  def self.of(machine)
    text = ENV["ISOLOOM_CONSOLES"].to_s
    return nil if text.empty?
    require "json"
    console = JSON.parse(text)[machine]
    console.is_a?(Hash) && console["port"].is_a?(Integer) && console["password"].is_a?(String) ? console : nil
  rescue JSON::ParserError
    nil
  end

  # QEMU's arguments for a VM of CPU `arch`: an Arm VM has no display unless given one.
  def self.qemu(arch)
    usb = ["-device", "qemu-xhci,id=isoloom-usb", "-device", "usb-tablet,bus=isoloom-usb.0"]
    display = arch == "aarch64" ? ["-device", "virtio-gpu-pci", "-device", "usb-kbd,bus=isoloom-usb.0"] : []
    ["-vnc", "127.0.0.1:0,to=99"] + usb.first(2) + display + usb.last(2)
  end

  # Whether VirtualBox has a remote display server: an installed, usable extension pack that
  # brings one. Asked once per Vagrant command, and only of a VirtualBox VM's block.
  def self.virtualbox_vrde?
    return @vrde unless @vrde.nil?
    require "open3"
    dir = ENV["VBOX_MSI_INSTALL_PATH"] || ENV["VBOX_INSTALL_PATH"]
    tool = dir && File.exist?(File.join(dir, "VBoxManage.exe")) ? File.join(dir, "VBoxManage.exe") : "VBoxManage"
    out, status = Open3.capture2e(tool, "list", "extpacks")
    packs = out.split(/^Pack no\.\s*\d+:/).drop(1)
    @vrde = status.success? && packs.any? { |p| p =~ /^Usable:\s+true/ && p =~ /^VRDE Module:\s+\S/ }
  rescue SystemCallError
    @vrde = false
  end
end

# ESXi (vagrant-vmware-esxi): ESXI_VIRTUAL_NETWORK lists port groups, comma-separated: the
# management network first, then one per network, in order (lab); a missing one reuses the last.
ESXI_NETWORKS = ENV.fetch("ESXI_VIRTUAL_NETWORK", "VM Network").split(",").map(&:strip)
def esxi_networks(indexes)
  [ESXI_NETWORKS[0]] + indexes.map { |i| ESXI_NETWORKS[i] || ESXI_NETWORKS[-1] }
end

# QEMU (vagrant-qemu): what the provider block can't say on its own.
# - Every network gets a hub: one QEMU process with no machine, a port per VM on one emulated
#   hub, each VM connecting to its own (no root; multicast doesn't send on a Mac). The ports are
#   picked when Vagrant reads this file (`ports`), for this copy of the project: free on this
#   host, and the ones a running hub of this copy listens on while it runs. A hub starts before a
#   VM on its network does, unless one runs, with `SPARE` ports more for VMs that join the network
#   while it runs; it is never restarted under the VMs connected to it, and stops once the
#   network's last VM is destroyed: destroying one VM leaves it to the others.
# - A VM's disk is an overlay of its box's, and a size below the box's disk would cut its file
#   system off: `disk_resize` is set only when the machine's size is above the box's (every
#   installed version of it, read with qemu-img). Until the box is downloaded the size is unknown
#   and nothing is set; Vagrant reads this file again once it has the box, before it makes the
#   disk.
module IsoloomQemu
  # Beside Vagrant's own state for this Vagrantfile.
  def self.hubs_dir
    File.join(__dir__, ".vagrant", "isoloom-qemu-hubs")
  end

  def self.fail!(message)
    raise Class.new(Vagrant::Errors::VagrantError) { define_method(:error_message) { "QEMU: #{message}" } }
  end

  def self.pid_file(net)
    File.join(hubs_dir, "#{net}.pid")
  end

  # The hub's record: the ports it listens on, by VM, and its spare ones (`record`).
  def self.ports_file(net)
    File.join(hubs_dir, "#{net}.ports.json")
  end

  # The hub's process id, while it runs: a process whose command names the hub's pid file, so
  # an id the system has given another process since is never taken for (or stopped as) a hub.
  def self.running(net)
    pid = Integer(File.read(pid_file(net)).strip)
    command = IO.popen(["ps", "-ww", "-o", "command=", "-p", pid.to_s], err: File::NULL, &:read)
    pid if command.include?(pid_file(net))
  rescue ArgumentError, SystemCallError
    nil
  end

  # The hub ports: 20000-39999.
  FIRST_PORT = 20_000
  PORTS = 20_000
  # The ports a hub listens on beyond its VMs', for VMs that join its network while it runs (an
  # attack box added to a running environment): QEMU's socket netdev doesn't reconnect, so a hub
  # restarted for one more port would leave the VMs connected to it off the network for good.
  SPARE = 4

  # Each network's hub ports, by VM (`vms`: each network's VMs, in the order they start), as
  # QEMU_HUBS holds them. A network whose hub runs keeps the ports it listens on, a VM that joins
  # it taking a spare one (`kept`). Every other VM gets a port free on this host, looked for from a
  # point of this folder's, not of the environment's name: two copies of one environment start far
  # apart, and a port something else holds is passed over. One folder starts from the same point,
  # so a copy gets the same ports from one run to the next while they stay free.
  def self.ports(vms)
    hubs = vms.map { |net, names| [net, kept(net, names)] }.to_h
    taken = hubs.values.compact.flat_map(&:values)
    at = start
    hubs.each_key do |net|
      next if hubs[net]
      hubs[net] = vms[net].map do |vm|
        at = free_from(at, taken)
        taken << at
        [vm, at]
      end.to_h
    end
    hubs
  end

  # The network's running hub's ports for its VMs `names`: each VM's own, and a spare one, in
  # order, for a VM that joins the network while the hub runs. None when no hub runs, or when its
  # spare ports don't go round the VMs that join.
  def self.kept(net, names)
    rec = record(net)
    return nil unless rec
    spare = rec[:spare].dup
    ports = {}
    names.each do |vm|
      port = rec[:vms][vm] || spare.shift
      return nil unless port
      ports[vm] = port
    end
    ports
  end

  # The running hub's record: its ports by VM (`vms`) and those no VM has taken yet (`spare`).
  # None while no hub runs, or for a record Isoloom doesn't read; one an earlier Isoloom wrote
  # (the ports by VM alone) has no spare port.
  def self.record(net)
    return nil unless running(net)
    require "json"
    rec = JSON.parse(File.read(ports_file(net)))
    return nil unless rec.is_a?(Hash)
    vms, spare = rec["vms"].is_a?(Hash) ? [rec["vms"], rec["spare"]] : [rec, []]
    return nil unless vms.values.all?(Integer) && spare.is_a?(Array) && spare.all?(Integer)
    { vms: vms, spare: spare }
  rescue SystemCallError, JSON::ParserError
    nil
  end

  def self.write_record(net, vms, spare)
    require "json"
    File.write(ports_file(net), JSON.generate("vms" => vms, "spare" => spare))
  end

  # This folder's first port to look from: FNV-1a of its path, in the range.
  def self.start
    hash = File.expand_path(__dir__).bytes.reduce(0x811c9dc5) { |h, b| ((h ^ b) * 0x01000193) & 0xffffffff }
    FIRST_PORT + hash % PORTS
  end

  # The first port from `at` on, wrapping in the range, that is free here and not in `taken`.
  def self.free_from(at, taken)
    PORTS.times do |i|
      port = FIRST_PORT + (at - FIRST_PORT + i) % PORTS
      return port if !taken.include?(port) && free?(port)
    end
    fail!("no port of #{FIRST_PORT}-#{FIRST_PORT + PORTS - 1} is free for a network's hub")
  end

  # Whether a hub could listen on 127.0.0.1:`port` here.
  def self.free?(port)
    require "socket"
    TCPServer.new("127.0.0.1", port).close
    true
  rescue SystemCallError
    false
  end

  # Starts the network's hub on `ports` (by VM), with `SPARE` ports more, unless one runs: QEMU
  # returns once its ports listen. A running hub is kept: a VM that joins its network takes one of
  # its spare ports (`kept`), recorded here. One with no spare port left for it is refused rather
  # than restarted under the VMs connected to it. A hub without a record Isoloom reads (an older
  # Isoloom started it) is replaced: the VM about to start connects to its new port.
  def self.hub(net, ports)
    rec = record(net)
    if rec
      joined = ports.reject { |vm, port| rec[:vms][vm] == port }
      unless joined.values.all? { |port| rec[:spare].include?(port) }
        fail!("the hub of network `#{net}` runs for #{rec[:vms].keys.join(', ')}, with no spare port left " \
              "for #{joined.keys.join(', ')}: started again it would leave them off the network. " \
              "Destroy the environment, then bring it up again")
      end
      write_record(net, rec[:vms].merge(joined), rec[:spare] - joined.values) unless joined.empty?
      return
    end
    stop(net)
    require "fileutils"
    FileUtils.mkdir_p(hubs_dir)
    taken = ports.values.dup
    at = taken.max || start
    spare = Array.new(SPARE) do
      at = free_from(at, taken)
      taken << at
      at
    end
    args = ["qemu-system-#{HOST_ARCH}", "-machine", "none", "-display", "none", "-nodefaults",
            "-daemonize", "-pidfile", pid_file(net)]
    (ports.values + spare).each_with_index do |port, i|
      args += ["-netdev", "socket,id=s#{i},listen=127.0.0.1:#{port}", "-netdev", "hubport,id=h#{i},hubid=0,netdev=s#{i}"]
    end
    log = File.join(hubs_dir, "#{net}.log")
    ok = system(*args, out: log, err: log)
    fail!("the hub of network `#{net}` didn't start (#{args.first}): see #{log}") unless ok
    write_record(net, ports, spare)
  end

  # Stops the network's hub once none of its VMs (`vms`, by define name, and those its record
  # holds) is left besides the one just destroyed. A VM is left while Vagrant keeps its id: a
  # halted one still holds its port, and the hub starts again for it anyway if stopped.
  def self.release(net, vms, env, gone)
    rec = record(net)
    left = (vms + (rec ? rec[:vms].keys : [])).uniq.reject { |vm| vm == gone.to_s }
    return if left.any? { |vm| env.local_data_path.join("machines", vm, "qemu", "id").file? }
    stop(net)
  end

  # Stops the network's hub, if it runs.
  def self.stop(net)
    pid = running(net)
    Process.kill("TERM", pid) if pid
    [pid_file(net), ports_file(net)].each { |f| File.delete(f) if File.exist?(f) }
  end

  # `disk_resize` for a VM of `box` sized `gb` GB: the size when it is above the box's disk,
  # else nothing (the box's disk is kept, never cut).
  def self.disk(box, gb)
    require "json"
    dir = File.join(Vagrant.user_data_path.to_s, "boxes", box.gsub("/", "-VAGRANTSLASH-"))
    images = Dir.glob(File.join(dir, "**", "libvirt", "**", "*.{img,qcow2}"))
    return nil if images.empty?
    sizes = images.map do |img|
      out = IO.popen(["qemu-img", "info", "--output=json", img], err: File::NULL, &:read)
      JSON.parse(out)["virtual-size"]
    rescue StandardError
      nil
    end
    # A box whose size can't be read keeps its own disk: a guess could cut it.
    return nil if sizes.include?(nil)
    gb * 1024**3 > sizes.max ? "#{gb}G" : nil
  end
end
# QEMU: each network's VMs, in the order they start, and their ports on its hub: picked for this
# copy of the project when Vagrant reads this file (see IsoloomQemu.ports).
QEMU_HUBS = IsoloomQemu.ports({ "lab" => ["web", "cache", "isoloom-controller"] })

Vagrant.configure("2") do |config|
  config.vm.synced_folder ".", "/vagrant", disabled: true
  config.vm.boot_timeout = 900
  config.ssh.proxy_command = ENV["ISOLOOM_SSH_PROXY_COMMAND"] if ENV["ISOLOOM_SSH_PROXY_COMMAND"]
  config.vm.provider "libvirt" do |v|
    v.default_prefix = "ansible-pair_"
  end

  config.vm.define "web" do |m|
    m.vm.box = "bento/debian-12"
    m.vm.hostname = "web"
    m.vm.network "private_network", ip: "10.63.0.10", netmask: "255.255.255.0", virtualbox__intnet: "isoloom-ansible-pair-lab", libvirt__network_name: "isoloom-ansible-pair-lab", libvirt__dhcp_enabled: false
    m.vm.provider "virtualbox" do |v|
      v.name = "ansible-pair - web"
      v.linked_clone = true
      v.cpus = 1
      v.memory = 1024
      v.customize ["modifyvm", :id, "--vrde", IsoloomConsole.virtualbox_vrde? ? "on" : "off", "--vrdeaddress", "127.0.0.1", "--vrdeport", "3390-3489"]
    end
    m.vm.provider "vmware_desktop" do |v|
      v.vmx["displayName"] = "ansible-pair - web"
      v.vmx["numvcpus"] = "1"
      v.vmx["memsize"] = "1024"
      if (console = IsoloomConsole.of("web"))
        v.vmx["RemoteDisplay.vnc.enabled"] = "TRUE"
        v.vmx["RemoteDisplay.vnc.ip"] = "127.0.0.1"
        v.vmx["RemoteDisplay.vnc.port"] = console.fetch("port").to_s
        v.vmx["RemoteDisplay.vnc.password"] = console.fetch("password")
      end
    end
    m.vm.provider "parallels" do |v|
      v.name = "ansible-pair - web"
      v.linked_clone = true
      v.cpus = 1
      v.memory = 1024
    end
    m.vm.provider "qemu" do |v, o|
      o.vm.box = "cloud-image/debian-12"
      o.vm.box_version = ">= 0"
      o.vm.box_architecture = "amd64"
      v.arch = "x86_64"
      v.smp = "cpus=1"
      v.memory = "1024M"
      v.ssh_auto_correct = true
      # Its port of network `lab`'s hub (see IsoloomQemu).
      v.advanced_network = true
      v.net_mode = :socket
      v.socket_opts = "connect=127.0.0.1:#{QEMU_HUBS["lab"]["web"]}"
      if "x86_64" != HOST_ARCH
        v.smp = "cpus=1"
        o.vm.boot_timeout = 3600
      end
      v.other_default = %w[-parallel none -monitor none -display none]
      v.extra_qemu_args = IsoloomConsole.qemu("x86_64")
    end
    m.trigger.before :"VagrantPlugins::QEMU::Action::StartInstance", type: :action do |t|
      t.ruby { |_, _| IsoloomQemu.hub("lab", QEMU_HUBS["lab"]) }
    end
    m.trigger.after :"VagrantPlugins::QEMU::Action::Destroy", type: :action do |t|
      t.ruby { |env, machine| IsoloomQemu.release("lab", QEMU_HUBS["lab"].keys, env, machine.name) }
    end
    m.vm.provider "vmware_esxi" do |v|
      v.esxi_hostname = ENV.fetch("ESXI_HOSTNAME", "")
      v.esxi_hostport = ENV.fetch("ESXI_HOSTPORT", "22").to_i
      v.esxi_username = ENV.fetch("ESXI_USERNAME", "root")
      v.esxi_password = "env:ESXI_PASSWORD"
      v.esxi_disk_store = ENV["ESXI_DATASTORE"] if ENV["ESXI_DATASTORE"]
      v.esxi_virtual_network = esxi_networks([1])
      v.guest_name = "ansible-pair-web"
      v.guest_numvcpus = 1
      v.guest_memsize = 1024
    end
    m.vm.provider "libvirt" do |v, o|
      o.vm.box = "generic/debian12"
      o.vm.box_version = ">= 0"
      o.vm.box_architecture = "amd64"
      v.cpus = 1
      v.memory = 1024
      v.machine_arch = "x86_64"
      v.graphics_type = "vnc"
      v.graphics_ip = "127.0.0.1"
      v.graphics_autoport = "yes"
    end
    m.vm.provider "hyperv" do |v, o|
      o.vm.box = "generic/debian12"
      o.vm.box_version = "4.3.12"
      v.vmname = "ansible-pair-web"
      v.cpus = 1
      v.memory = 1024
      v.linked_clone = true
      o.vm.network "private_network", bridge: HYPERV_SWITCH
    end
    m.trigger.before :"VagrantPlugins::HyperV::Action::Configure", type: :action do |t|
      t.ruby { |_, _| IsoloomHyperV.switches(["isoloom-ansible-pair-lab"]) }
    end
    m.trigger.before :"VagrantPlugins::HyperV::Action::StartInstance", type: :action do |t|
      t.ruby { |_, machine| IsoloomHyperV.attach(machine, [["isoloom-ansible-pair-lab", "0215CFE4F0A1"]]) }
    end
    m.trigger.after :"VagrantPlugins::HyperV::Action::WaitForIPAddress", type: :action do |t|
      t.ruby do |_, machine|
        IsoloomHyperV.address(machine, <<~'SH')
          set -e
          mkdir -p /etc/isoloom
          cat > /etc/isoloom/env-net.sh <<'NET'
          #!/bin/sh
          # This machine's addresses on the environment's networks (Hyper-V sets none), by adapter MAC.
          set_address() {
            for d in /sys/class/net/*; do
              [ "$(cat "$d/address" 2>/dev/null)" = "$1" ] || continue
              IF=${d##*/}
              if command -v nmcli >/dev/null; then nmcli device set "$IF" managed no 2>/dev/null || true; fi
              ip link set "$IF" up
              ip -4 addr show dev "$IF" | grep -q " $2 " || ip addr add "$2" dev "$IF"
              return 0
            done
            echo "isoloom: no network adapter with MAC $1" >&2
            return 1
          }
          rc=0
          set_address 02:15:cf:e4:f0:a1 10.63.0.10/24 || rc=1
          exit $rc
          NET
          chmod +x /etc/isoloom/env-net.sh
          # NetworkManager would try DHCP there.
          if [ -d /etc/NetworkManager/conf.d ]; then
            printf '[keyfile]\nunmanaged-devices=mac:02:15:cf:e4:f0:a1\n' > /etc/NetworkManager/conf.d/90-isoloom-env-net.conf
          fi
          if [ -d /run/systemd/system ]; then
            cat > /etc/systemd/system/isoloom-env-net.service <<'UNIT'
          [Unit]
          Description=Isoloom: addresses on the environment networks
          After=network-pre.target NetworkManager.service systemd-networkd.service
          Before=network-online.target isoloom-routes.service

          [Service]
          Type=oneshot
          RemainAfterExit=yes
          ExecStart=/etc/isoloom/env-net.sh

          [Install]
          WantedBy=multi-user.target
          UNIT
            systemctl daemon-reload
            systemctl enable -q isoloom-env-net.service
          elif command -v rc-update >/dev/null; then
            printf '#!/bin/sh\nexec /etc/isoloom/env-net.sh\n' > /etc/local.d/isoloom-env-net.start
            chmod +x /etc/local.d/isoloom-env-net.start
            rc-update add local default >/dev/null
          fi
          /etc/isoloom/env-net.sh
        SH
      end
    end
    m.trigger.after :"VagrantPlugins::HyperV::Action::DeleteVM", type: :action do |t|
      t.ruby { |_, _| IsoloomHyperV.prune(["isoloom-ansible-pair-lab"]) }
    end
    m.vm.provision "addresses", type: "shell", run: "always", inline: "set -eu
command -v nmcli >/dev/null 2>&1 && nmcli -t general status >/dev/null 2>&1 || exit 0
cards=\"\"
for address in \"$@\"; do
  ip=${address%/*}
  card=$(ip -o -4 addr show | awk -v ip=\"$ip\" '{ split($4, a, \"/\"); if (a[1] == ip) { print $2; exit } }')
  if [ -z \"$card\" ]; then
    # Dropped already: the card NetworkManager is configuring that has no IPv4 address.
    for c in $(nmcli -t -f DEVICE,STATE device | awk -F: '$2 ~ /^connecting/ { print $1 }'); do
      [ -n \"$(ip -o -4 addr show dev \"$c\")\" ] || { card=$c; break; }
    done
  fi
  [ -n \"$card\" ] || { echo \"addresses: no card for $address\" >&2; exit 1; }
  nmcli device set \"$card\" managed no
  ip -o -4 addr show dev \"$card\" | grep -q \" $ip/\" || ip addr add \"$address\" dev \"$card\"
  ip link set \"$card\" up
  case \";$cards;\" in *\";interface-name:$card;\"*) ;; *) cards=\"$cards${cards:+;}interface-name:$card\" ;; esac
done
mkdir -p /etc/NetworkManager/conf.d
printf '[keyfile]\\nunmanaged-devices=%s\\n' \"$cards\" >/etc/NetworkManager/conf.d/90-isoloom-addresses.conf
", args: ["10.63.0.10/24"]
    m.vm.provision "isoloom_project", name: "project"
    m.vm.provision "shell", name: "hosts", inline: "printf '%s\\n' '10.63.0.10 web' '10.63.0.20 cache' | while IFS= read -r l; do grep -qxF \"$l\" /etc/hosts || printf '%s\\n' \"$l\" >> /etc/hosts; done"
    m.vm.provision "shell", name: "ready", inline: "mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready"
    m.vm.provision "shell", name: "checks", run: "never", path: "checks/web.sh", env: { "ISOLOOM_DERIVED" => ENV.fetch("ISOLOOM_DERIVED", "1") }
  end

  config.vm.define "cache" do |m|
    m.vm.box = "bento/debian-12"
    m.vm.hostname = "cache"
    m.vm.network "private_network", ip: "10.63.0.20", netmask: "255.255.255.0", virtualbox__intnet: "isoloom-ansible-pair-lab", libvirt__network_name: "isoloom-ansible-pair-lab", libvirt__dhcp_enabled: false
    m.vm.provider "virtualbox" do |v|
