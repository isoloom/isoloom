---
source: crates/isoloom-compose/tests/snapshots.rs
expression: compose
---
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  docker compose -f .isoloom/docker/compose.yml up -d --wait
# Checks: isoloom test docker (or: docker compose -f .isoloom/docker/compose.yml --profile check run --rm isoloom-check, and isoloom-check-<machine>)
# Stop:   docker compose -f .isoloom/docker/compose.yml down -v

name: own-process
services:
  web:
    image: python:3-alpine
    platform: linux/amd64
    entrypoint:
    - /bin/sh
    - -c
    - set -e; sh /isoloom/before/1-flag.sh; exec "$$@"
    - isoloom-before
    command:
    - python3
    - -m
    - http.server
    - '8000'
    working_dir: /srv
    hostname: web
    networks:
      lan:
        ipv4_address: 10.9.0.10
    environment:
      FLAG: ${FLAG:-}
    volumes:
    - ../../flag.sh:/isoloom/before/1-flag.sh:ro
    - isoloom-probe-amd64:/.isoloom-probe:ro
    healthcheck:
      test:
      - CMD
      - /.isoloom-probe/busybox
      - sh
      - -c
      - /.isoloom-probe/busybox nc -z -w 2 127.0.0.1 8000 && ( test -s /srv/flag && echo $$FLAG )
      interval: 2s
      timeout: 3s
      retries: 30
      start_period: 10s
    depends_on:
      isoloom-probe-amd64:
        condition: service_completed_successfully
    labels:
      isoloom.port.8000: tcp:8000
      isoloom.managed: 'true'
      isoloom.environment: own-process
    restart: unless-stopped
  api:
    image: python:3-alpine
    platform: linux/amd64
    command:
    - /bin/sh
    - -c
    - python3 -m http.server 9000
    hostname: api
    networks:
      lan:
        ipv4_address: 10.9.0.11
    volumes:
    - isoloom-probe-amd64:/.isoloom-probe:ro
    healthcheck:
      test:
      - CMD
      - /.isoloom-probe/busybox
      - sh
      - -c
      - /.isoloom-probe/busybox nc -z -w 2 127.0.0.1 9000 && ( /.isoloom-probe/busybox wget -q -O /dev/null -T 3 http://127.0.0.1:9000/health )
      interval: 5s
      timeout: 3s
      retries: 60
      start_period: 60s
    depends_on:
      isoloom-probe-amd64:
        condition: service_completed_successfully
    labels:
      isoloom.port.9000: tcp:9000
      isoloom.managed: 'true'
      isoloom.environment: own-process
    restart: unless-stopped
  isoloom-check-web:
    image: curlimages/curl:8.11.1
    profiles:
    - check
    entrypoint:
    - /bin/sh
    - /isoloom/run.sh
    network_mode: service:web
    volumes:
    - ./checks/web.sh:/isoloom/run.sh:ro
    depends_on:
      web:
        condition: service_healthy
      api:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: own-process
  isoloom-check-api:
    image: curlimages/curl:8.11.1
    profiles:
    - check
    entrypoint:
    - /bin/sh
    - /isoloom/run.sh
    network_mode: service:api
    volumes:
    - ./checks/api.sh:/isoloom/run.sh:ro
    depends_on:
      web:
        condition: service_healthy
      api:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: own-process
  isoloom-probe-amd64:
    image: busybox:1.37.0-musl
    platform: linux/amd64
    entrypoint:
    - /bin/cp
    - /bin/busybox
    - /probe/busybox
    network_mode: none
    volumes:
    - isoloom-probe-amd64:/probe
    labels:
      isoloom.managed: 'true'
      isoloom.environment: own-process
    restart: no
networks:
  lan:
    ipam:
      config:
      - subnet: 10.9.0.0/24
        gateway: 10.9.0.1
    labels:
      isoloom.managed: 'true'
      isoloom.environment: own-process
volumes:
  isoloom-probe-amd64:
    labels:
      isoloom.managed: 'true'
      isoloom.environment: own-process
