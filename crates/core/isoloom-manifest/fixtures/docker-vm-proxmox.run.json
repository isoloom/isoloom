{
  "$schema": "https://raw.githubusercontent.com/isoloom/isoloom/main/schemas/run-manifest-v1.schema.json",
  "manifest_version": 1,
  "generator": {
    "name": "isoloom",
    "version": "2.0.0"
  },
  "environment": {
    "name": "web-portal",
    "instance": null,
    "message": "The portal answers at http://localhost:${published.web.portal}/.\n"
  },
  "target": "docker-vm",
  "driver": "terraform",
  "hosts": [
    "linux",
    "macos",
    "windows"
  ],
  "tools": [
    {
      "name": "terraform",
      "probe": [
        "terraform",
        "version"
      ],
      "min_version": "1.6.0",
      "container": "hashicorp/terraform:1.16.7@sha256:c9c77f5b9820832cbc7b88d16df406ac6e75fee5a9077e5437db0c54e5ff33e3",
      "container_hosts": [
        "macos"
      ]
    },
    {
      "name": "ssh",
      "probe": [
        "ssh",
        "-V"
      ]
    }
  ],
  "identity": {
    "terraform": {
      "module": ".",
      "state": "runner",
      "gone": [
        {
          "resource": "proxmox_virtual_environment_firewall_ipset",
          "error": "no such IPSet '{id}'"
        },
        {
          "resource": "proxmox_virtual_environment_vm",
          "error": "Configuration file 'nodes/{node_name}/qemu-server/{id}.conf' does not exist"
        },
        {
          "resource": "proxmox_virtual_environment_container",
          "error": "Configuration file 'nodes/{node_name}/lxc/{id}.conf' does not exist"
        }
      ]
    }
  },
  "params": [
    {
      "name": "proxmox_endpoint",
      "description": "https://<server>:8006/.",
      "required": true,
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_endpoint"
        }
      ]
    },
    {
      "name": "proxmox_username",
      "description": "The module's `proxmox_username`.",
      "default": "root@pam",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_username"
        }
      ]
    },
    {
      "name": "proxmox_insecure",
      "description": "Accept the server's self-signed certificate (TLS isn't verified).",
      "default": "false",
      "values": [
        "true",
        "false"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_insecure"
        }
      ]
    },
    {
      "name": "proxmox_ssh_username",
      "description": "Uploading cloud-init snippets goes over SSH to the node.",
      "default": "root",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_ssh_username"
        }
      ]
    },
    {
      "name": "proxmox_ssh_address",
      "description": "The node's SSH address, when the API reports one this machine can't reach.",
      "default": "",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_ssh_address"
        }
      ]
    },
    {
      "name": "node",
      "description": "The Proxmox node the VMs go on (`pvesh get /nodes` lists them).",
      "required": true,
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "node"
        }
      ]
    },
    {
      "name": "datastore",
      "description": "Where VM disks go.",
      "default": "local-lvm",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "datastore"
        }
      ]
    },
    {
      "name": "image_datastore",
      "description": "A datastore with 'iso' content, for cloud images.",
      "default": "local",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "image_datastore"
        }
      ]
    },
    {
      "name": "snippets_datastore",
      "description": "A datastore with 'snippets' content, for cloud-init.",
      "default": "local",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "snippets_datastore"
        }
      ]
    },
    {
      "name": "uplink_bridge",
      "description": "The bridge the VM gets its address (DHCP) and the internet from.",
      "default": "vmbr0",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "uplink_bridge"
        }
      ]
    },
    {
      "name": "ISOLOOM_DERIVED",
      "description": "0: the checks derived from the spec (reachability, no internet) are skipped.",
      "default": "1",
      "values": [
        "0",
        "1"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_DERIVED",
          "steps": [
            "check-isoloom-networks",
            "check-db",
            "check-web"
          ]
        }
      ]
    }
  ],
  "secrets": [
    {
      "name": "proxmox_api_token",
      "kind": "connection",
      "required": false,
      "sensitive": true,
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_api_token"
        }
      ]
    },
    {
      "name": "proxmox_password",
      "kind": "connection",
      "required": false,
      "sensitive": true,
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_password"
        }
      ]
    },
    {
      "name": "DEMO_SECRET",
      "kind": "input",
      "required": false,
      "sensitive": true,
      "machines": [
        "web",
        "isoloom-init-web-1"
      ],
      "default": "",
      "deliver": [
        {
          "via": "env",
          "var": "DEMO_SECRET",
          "steps": [
            "start",
            "job-isoloom-init-web-1"
          ]
        }
      ]
    }
  ],
  "networks": [
    {
      "name": "lab",
      "cidr": "10.30.0.0/24",
      "internet": false,
      "native": "web-portal_lab"
    }
  ],
  "machines": [
    {
      "name": "isoloom-docker-host",
      "role": "infra",
      "resources": {
        "cpus": 2,
        "memory_mb": 2048
      },
      "addresses": {}
    },
    {
      "name": "db",
      "role": "member",
      "resources": {
        "cpus": 1,
        "memory_mb": 512
      },
      "addresses": {
        "lab": "10.30.0.20"
      },
      "native": {
        "service": "db"
      },
      "ports": [
        {
          "name": "mysql",
          "port": 3306,
          "protocol": "tcp",
          "http": false
        }
      ]
    },
    {
      "name": "isoloom-routes-db",
      "role": "infra",
      "of": "db",
      "addresses": {},
      "native": {
        "service": "isoloom-routes-db"
      }
    },
    {
      "name": "web",
      "role": "member",
      "resources": {
        "cpus": 1,
        "memory_mb": 512
      },
      "addresses": {
        "lab": "10.30.0.10"
      },
      "native": {
        "service": "web"
      },
      "volumes": [
        {
          "name": "data",
          "path": "/srv/data",
          "native": "web-portal_web-data"
        }
      ],
      "ports": [
        {
          "name": "portal",
          "port": 80,
          "protocol": "tcp",
          "http": true,
          "publish": {
            "mode": "fixed",
            "preferred": 8080,
            "address": "${outputs.ip}"
          }
        }
      ]
    },
    {
      "name": "isoloom-routes-web",
      "role": "infra",
      "of": "web",
      "addresses": {},
      "native": {
        "service": "isoloom-routes-web"
      }
    },
    {
      "name": "isoloom-init-web-1",
      "role": "job",
      "of": "web",
      "addresses": {},
      "native": {
        "service": "isoloom-init-web-1"
      }
    },
    {
      "name": "isoloom-check",
      "role": "check",
      "addresses": {},
      "native": {
        "service": "isoloom-check"
      }
    },
    {
      "name": "isoloom-check-db",
      "role": "check",
      "of": "db",
      "addresses": {},
      "native": {
        "service": "isoloom-check-db"
      }
    },
    {
      "name": "isoloom-check-web",
      "role": "check",
      "of": "web",
      "addresses": {},
      "native": {
        "service": "isoloom-check-web"
      }
    },
    {
      "name": "isoloom-probe",
      "role": "infra",
      "addresses": {},
      "native": {
        "service": "isoloom-probe"
      }
    }
  ],
  "lifecycle": {
    "up": [
      {
        "id": "clear-lock",
        "action": "terraform.clear_lock"
      },
      {
        "id": "init",
        "note": "Preparing Terraform and its providers…",
        "argv": [
          "terraform",
          "init",
          "-input=false",
          "-no-color",
          "-backend-config=path=${run.state_dir}/terraform.tfstate"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_proxmox_ssh_private_key_file": "${run.ssh_key}",
          "TF_VAR_slot": "${run.slot}",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 900
      },
      {
        "id": "apply",
        "note": "Creating the environment's VMs on the server…",
        "argv": [
          "terraform",
          "apply",
          "-auto-approve",
          "-input=false",
          "-no-color"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_proxmox_ssh_private_key_file": "${run.ssh_key}",
          "TF_VAR_slot": "${run.slot}",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 3600
      },
      {
        "id": "archive",
        "note": "Archiving the project…",
        "action": "project.archive",
        "with": {
          "outputs": ".isoloom/docker .isoloom/configure",
          "root": "../../.."
        }
      },
      {
        "id": "project",
        "note": "Copying the project into the VM…",
        "action": "ssh.run",
        "with": {
          "command": "sudo sh -c 'rm -rf /opt/isoloom && mkdir -p /opt/isoloom && tar -xzf - -C /opt/isoloom'",
          "host": "${outputs.ip}",
          "user": "isoloom"
        },
        "stdin": "${run.state_dir}/project.tgz",
        "timeout_s": 600
      },
      {
        "id": "docker",
        "note": "Installing Docker in the VM…",
        "action": "ssh.run",
        "with": {
          "command": "sudo sh -s",
          "host": "${outputs.ip}",
          "user": "isoloom"
        },
        "stdin": "setup.sh",
        "timeout_s": 1800
      },
      {
        "id": "pull-start",
        "note": "Pulling the environment's images in the VM…",
        "action": "ssh.run",
        "with": {
          "command": "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name web-portal --file .isoloom/docker/compose.yml pull --policy missing --ignore-buildable --include-deps db isoloom-routes-db web isoloom-routes-web isoloom-probe",
          "host": "${outputs.ip}",
          "user": "isoloom"
        },
        "timeout_s": 900,
        "download": true
      },
      {
        "id": "start",
        "note": "Starting the environment's containers in the VM…",
        "action": "ssh.run",
        "with": {
          "command": "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name web-portal --file .isoloom/docker/compose.yml up --detach --build --pull missing --remove-orphans --wait --wait-timeout 600 db isoloom-routes-db web isoloom-routes-web isoloom-probe",
          "host": "${outputs.ip}",
          "user": "isoloom"
        },
        "timeout_s": 1800
      },
      {
        "id": "pull-job-isoloom-init-web-1",
        "note": "Pulling the environment's images in the VM…",
        "action": "ssh.run",
        "with": {
          "command": "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name web-portal --file .isoloom/docker/compose.yml pull --policy missing --ignore-buildable isoloom-init-web-1",
          "host": "${outputs.ip}",
          "user": "isoloom"
        },
        "timeout_s": 900,
        "download": true
      },
      {
        "id": "job-isoloom-init-web-1",
        "note": "Running web's set-up script…",
        "action": "ssh.run",
        "with": {
          "command": "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name web-portal --file .isoloom/docker/compose.yml up --no-deps --exit-code-from isoloom-init-web-1 isoloom-init-web-1",
          "host": "${outputs.ip}",
          "user": "isoloom"
        },
        "timeout_s": 600
      }
    ],
    "down": [
      {
        "id": "clear-lock",
        "action": "terraform.clear_lock"
      },
      {
        "id": "init",
        "note": "Preparing Terraform and its providers…",
        "argv": [
          "terraform",
          "init",
          "-input=false",
          "-no-color",
          "-backend-config=path=${run.state_dir}/terraform.tfstate"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_proxmox_ssh_private_key_file": "${run.ssh_key}",
          "TF_VAR_slot": "${run.slot}",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 900
      },
      {
        "id": "destroy",
        "note": "Removing the environment from the server…",
        "argv": [
          "terraform",
          "destroy",
          "-auto-approve",
          "-input=false",
          "-no-color",
          "-refresh=false"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_proxmox_ssh_private_key_file": "${run.ssh_key}",
          "TF_VAR_slot": "${run.slot}",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 1800
      }
    ],
    "status": {
      "id": "state",
      "action": "terraform.read_state"
    }
  },
  "ready": [
    {
      "kind": "step_ok",
      "step": "apply",
      "means": "the Docker host VM exists and booted"
    },
    {
      "kind": "step_ok",
      "step": "start",
      "means": "every long-running service is healthy (`--wait`: each port's probe, the route keepers, the machines' own healthchecks)"
    },
    {
      "kind": "step_ok",
      "step": "job-isoloom-init-web-1",
      "means": "web's set-up script (isoloom-init-web-1) exited 0"
    }
  ],
  "outputs": [
    {
      "name": "ip",
      "description": "The Docker host's address: SSH reaches it there, and its containers' published ports answer there.",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ip"
      }
    },
    {
      "name": "ssh_user",
      "description": "The user the runner's key lets in on the Docker host.",
      "role": "info",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ssh_user"
      }
    },
    {
      "name": "web__portal",
      "description": "web's portal (port 80).",
      "role": "entry",
      "sensitive": false,
      "format": "http://${host.web}:${value}/",
      "from": {
        "kind": "published_port",
        "machine": "web",
        "port": "portal"
      }
    }
  ],
  "checks": {
    "protocol": "isoloom-check/1",
    "setup": [],
    "runners": [
      {
        "id": "isoloom-check",
        "from": "from the environment's networks",
        "checks": [
          {
            "name": "http://web/",
            "kind": "http",
            "wait_s": 60,
            "derived": false
          },
          {
            "name": "db:3306",
            "kind": "tcp",
            "wait_s": 120,
            "derived": false
          },
          {
            "name": "build/check/check.sh",
            "kind": "script",
            "wait_s": 180,
            "derived": false
          }
        ],
        "step": {
          "id": "check-isoloom-networks",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name web-portal --file .isoloom/docker/compose.yml --profile check run --rm --no-deps --env ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} isoloom-check",
            "host": "${outputs.ip}",
            "user": "isoloom"
          },
          "timeout_s": 465
        },
        "on_timeout": [
          {
            "id": "rm-check-isoloom-networks",
            "action": "ssh.run",
            "with": {
              "command": "sudo docker ps -aq --filter label=com.docker.compose.project=web-portal --filter label=com.docker.compose.service=isoloom-check --filter label=com.docker.compose.oneoff=True | xargs -r sudo docker rm -f",
              "host": "${outputs.ip}",
              "user": "isoloom"
            },
            "timeout_s": 60
          }
        ]
      },
      {
        "id": "isoloom-check-db",
        "from": "from db",
        "checks": [
          {
            "name": "web:80 from db",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "no internet from db",
            "kind": "http",
            "wait_s": 0,
            "derived": true
          }
        ],
        "step": {
          "id": "check-db",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name web-portal --file .isoloom/docker/compose.yml --profile check run --rm --no-deps --env ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} isoloom-check-db",
            "host": "${outputs.ip}",
            "user": "isoloom"
          },
          "timeout_s": 120
        },
        "on_timeout": [
          {
            "id": "rm-check-db",
            "action": "ssh.run",
            "with": {
              "command": "sudo docker ps -aq --filter label=com.docker.compose.project=web-portal --filter label=com.docker.compose.service=isoloom-check-db --filter label=com.docker.compose.oneoff=True | xargs -r sudo docker rm -f",
              "host": "${outputs.ip}",
              "user": "isoloom"
            },
            "timeout_s": 60
          }
        ]
      },
      {
        "id": "isoloom-check-web",
        "from": "from web",
        "checks": [
          {
            "name": "db:3306 from web",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "no internet from web",
            "kind": "http",
            "wait_s": 0,
            "derived": true
          }
        ],
        "step": {
          "id": "check-web",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name web-portal --file .isoloom/docker/compose.yml --profile check run --rm --no-deps --env ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} isoloom-check-web",
            "host": "${outputs.ip}",
            "user": "isoloom"
          },
          "timeout_s": 120
        },
        "on_timeout": [
          {
            "id": "rm-check-web",
            "action": "ssh.run",
            "with": {
              "command": "sudo docker ps -aq --filter label=com.docker.compose.project=web-portal --filter label=com.docker.compose.service=isoloom-check-web --filter label=com.docker.compose.oneoff=True | xargs -r sudo docker rm -f",
              "host": "${outputs.ip}",
              "user": "isoloom"
            },
            "timeout_s": 60
          }
        ]
      }
    ],
    "teardown": []
  },
  "guest": {
    "machine": "isoloom-docker-host",
    "host": "${outputs.ip}",
    "status": {
      "id": "ps",
      "action": "ssh.run",
      "with": {
        "command": "if command -v docker >/dev/null; then sudo docker compose --project-name web-portal ps --all --format json; fi",
        "host": "${outputs.ip}",
        "user": "isoloom"
      },
      "timeout_s": 60
    }
  }
}
