{
  "manifest_version": 0,
  "generator": {
    "name": "isoloom",
    "version": "0.10.1"
  },
  "lab": {
    "name": "minimal",
    "instance": null
  },
  "target": "docker",
  "driver": "compose",
  "hosts": [
    "linux",
    "macos",
    "windows"
  ],
  "tools": [
    {
      "name": "docker",
      "probe": [
        "docker",
        "info",
        "--format",
        "{{.ServerVersion}}"
      ]
    }
  ],
  "identity": {
    "compose": {
      "project": "${run.name}",
      "files": [
        "compose.yml"
      ]
    }
  },
  "params": [],
  "secrets": [],
  "networks": [
    {
      "name": "lab",
      "cidr": "10.40.0.0/24",
      "internet": true,
      "native": "${run.name}_lab"
    }
  ],
  "machines": [
    {
      "name": "web",
      "role": "target",
      "addresses": {
        "lab": "10.40.0.10"
      },
      "native": {
        "service": "web"
      },
      "ports": [
        {
          "name": "site",
          "port": 80,
          "protocol": "tcp",
          "http": true,
          "publish": {
            "mode": "ephemeral",
            "preferred": 8080
          }
        }
      ]
    }
  ],
  "lifecycle": {
    "up": [],
    "down": [
      {
        "id": "down",
        "argv": [
          "docker",
          "compose",
          "--project-name",
          "${run.name}",
          "--file",
          "compose.yml",
          "down",
          "--volumes"
        ],
        "timeout_s": 300,
        "when": "always"
      }
    ],
    "status": {
      "id": "ps",
      "argv": [
        "docker",
        "compose",
        "--project-name",
        "${run.name}",
        "--file",
        "compose.yml",
        "ps",
        "--all",
        "--format",
        "json"
      ],
      "timeout_s": 25
    }
  },
  "ready": [
    {
      "kind": "step_ok",
      "step": "up"
    }
  ],
  "outputs": [
    {
      "name": "web_site",
      "role": "entry",
      "sensitive": false,
      "format": "http://127.0.0.1:${value}/",
      "from": {
        "kind": "published_port",
        "machine": "web",
        "port": 80,
        "protocol": "tcp"
      }
    }
  ],
  "checks": {
    "protocol": "isoloom-check/1",
    "setup": [],
    "runners": [],
    "teardown": []
  }
}
