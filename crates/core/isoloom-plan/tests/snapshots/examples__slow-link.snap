---
version: 1
name: slow-link
networks:
  branch:
    cidr: 10.75.1.0/24
    internet: true
    gateway: ~
    docker: ~
  far:
    cidr: 10.75.2.0/24
    internet: true
    gateway: ~
    docker: ~
    tc:
      delay: 80ms
      jitter: 10ms
      loss: 1
      rate: 10mbit
reach:
  - from: branch
    to: far
    ports:
      - 80
inputs: []
machines:
  web:
    networks:
      far: 10
    os: debian@12
    arch: amd64
    privileged: false
    read_only: false
    tmpfs: []
    shm_size: ~
    dns: ~
    ports:
      - port: 80
        name: web
        http: true
        publish: ~
    inputs: []
    resources: ~
    depends_on: []
    volumes: {}
    access: false
    docker:
      image: ~
      build: build/web
      dockerfile: build/web.Dockerfile
      args:
        NGINX_TAG: 1.27-alpine
      init: []
      idle: false
    vm:
      os: debian-12
      provision:
        - provision/web.sh
      image: ~
  user:
    networks:
      branch: 10
    os: debian@12
    arch: amd64
    privileged: false
    read_only: false
    tmpfs: []
    shm_size: ~
    dns: ~
    ports: []
    inputs: []
    resources: ~
    depends_on: []
    volumes: {}
    access: true
    docker:
      image: "debian:12@sha256:2c037a04925515fdd6ea85ea14a682d0e79931f5e9f5d07b6dbfc6ba12f9e858"
      build: ~
      init: []
      idle: true
    vm:
      os: debian-12
      provision: []
      image: ~
common: ~
groups: {}
provision: []
checks:
  - name: "the far site answers, slowly"
    from: user
    http: ~
    tcp: ~
    exec: ~
    script: checks/slow-but-there.sh
    expect: ~
    wait: ~
targets: ~
tools:
  shell: {}
