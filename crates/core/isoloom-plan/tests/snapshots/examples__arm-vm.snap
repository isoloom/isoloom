version: 1
name: arm-vm
networks:
  lab:
    cidr: 10.70.0.0/24
    internet: true
    gateway: ~
    docker: ~
reach: []
inputs: []
machines:
  box:
    networks:
      lab: 10
    os: ubuntu@24.04
    arch: arm64
    privileged: false
    read_only: false
    tmpfs: []
    shm_size: ~
    dns: ~
    ports:
      - port: 22
        name: ssh
        http: false
        publish: ~
    inputs: []
    resources: ~
    depends_on: []
    volumes: {}
    access: false
    docker:
      image: ~
      build: ~
      init: []
      idle: true
    vm:
      os: ubuntu-24.04
      provision:
        - provision/setup.sh
      image: ~
common: ~
groups: {}
provision: []
checks:
  - name: the box runs natively on arm64
    from: box
    http: ~
    tcp: ~
    exec: uname -m
    script: ~
    expect: aarch64
    wait: ~
targets: ~
