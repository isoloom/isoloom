---
source: crates/core/isoloom-plan/tests/examples.rs
assertion_line: 44
expression: example(&name).spec()
---
version: 1
name: udp-dns
networks:
  servers:
    cidr: 10.66.10.0/24
    internet: false
    gateway: ~
    docker: ~
  users:
    cidr: 10.66.20.0/24
    internet: false
    gateway: ~
    docker: ~
reach:
  - from: users
    to: servers
    ports:
      - 53
inputs: []
machines:
  dns:
    networks:
      servers: 53
    os: debian@12
    arch: amd64
    privileged: false
    read_only: false
    tmpfs: []
    shm_size: ~
    dns: ~
    ports:
      - port: 53
        name: dns-udp
        http: false
        publish: 10053
        protocol: udp
      - port: 53
        name: dns
        http: false
        publish: ~
    inputs: []
    resources: ~
    depends_on: []
    volumes: {}
    access: false
    docker:
      image: ~
      build: build/dns
      init: []
      idle: false
    vm:
      os: debian-12
      provision:
        - provision/dns.sh
      image: ~
  client:
    networks:
      users: 10
    os: debian@12
    arch: amd64
    privileged: false
    read_only: false
    tmpfs: []
    shm_size: ~
    dns: ~
    ports: []
    inputs: []
    resources: ~
    depends_on:
      - dns
    volumes: {}
    access: true
    docker:
      image: ~
      build: ~
      init: []
      idle: true
    vm:
      os: debian-12
      provision:
        - provision/client.sh
      image: ~
common: ~
groups: {}
provision: []
checks:
  - checks/resolve.sh
targets: ~
message: "The DNS server answers at {{ machines.dns.addresses.servers }}:53 (UDP and TCP), and on\n127.0.0.1:{{ machines.dns.ports.dns-udp.published }}/udp from this machine:\ndig @127.0.0.1 -p {{ machines.dns.ports.dns-udp.published }} www.lab.test\n"
