---
version: 1
name: segmented
networks:
  front:
    cidr: 10.61.10.0/24
    internet: true
    gateway: ~
    docker: ~
  back:
    cidr: 10.61.20.0/24
    internet: false
    gateway: ~
    docker: ~
  access:
    cidr: 10.61.99.0/24
    internet: true
    gateway: ~
    docker: ~
reach:
  - from: access
    to: front
    ports: []
  - from: front
    to: back
    ports:
      - 6379
inputs: []
machines:
  cache:
    networks:
      back: 20
    os: debian@12
    arch: amd64
    privileged: false
    read_only: false
    tmpfs: []
    shm_size: ~
    dns: ~
    ports:
      - port: 6379
        name: redis
        http: false
        publish: ~
    inputs: []
    resources:
      cpus: 1
      memory_mb: 1024
      disk_gb: 10
    depends_on: []
    volumes:
      data: /data
    access: false
    docker:
      image: "redis:7-alpine"
      build: ~
      init: []
      idle: false
    vm:
      os: debian-12
      provision:
        - provision/cache.sh
      image: ~
  web:
    networks:
      front: 10
    os: debian@12
    arch: amd64
    privileged: false
    read_only: false
    tmpfs: []
    shm_size: ~
    dns: ~
    ports:
      - port: 80
        name: web
        http: true
        publish: ~
      - port: 4444
        name: shell
        http: false
        publish: ~
        dormant: true
    inputs: []
    resources: ~
    depends_on:
      - cache
    volumes: {}
    access: false
    docker:
      image: ~
      build: build/web
      init: []
      idle: false
    vm:
      os: debian-12
      provision:
        - provision/web.sh
      image: ~
  user:
    networks:
      access: 10
    os: debian@12
    arch: amd64
    privileged: false
    read_only: false
    tmpfs: []
    shm_size: ~
    dns: ~
    ports: []
    inputs: []
    resources: ~
    depends_on: []
    volumes: {}
    access: true
    docker:
      image: "debian:12@sha256:2c037a04925515fdd6ea85ea14a682d0e79931f5e9f5d07b6dbfc6ba12f9e858"
      build: ~
      init: []
      idle: true
    vm:
      os: debian-12
      provision: []
      image: ~
common: ~
groups: {}
provision: []
checks:
  - name: the web page answers through the router
    from: user
    http: "http://web/"
    tcp: ~
    exec: ~
    script: ~
    expect: 200
    wait: 60
  - name: the cache is sealed off from the user
    from: user
    http: ~
    tcp: "cache:6379"
    exec: ~
    script: ~
    expect: blocked
    wait: ~
targets: ~
