---
source: crates/core/isoloom-plan/tests/examples.rs
expression: example(&name).unwrap().spec()
---
version: 1
name: corp-ad-basics
networks:
  dmz:
    cidr: 10.40.10.0/24
    internet: true
    gateway: ~
    docker: ~
  corp:
    cidr: 10.40.20.0/24
    internet: true
    gateway: ~
    docker: ~
  access:
    cidr: 10.40.99.0/24
    internet: true
    gateway: ~
    docker: ~
reach:
  - from: access
    to: dmz
    ports: []
  - from: dmz
    to: corp
    ports: []
inputs: []
machines:
  dc01:
    networks:
      corp: 5
    os: windows-server@2022
    arch: amd64
    privileged: false
    read_only: false
    tmpfs: []
    shm_size: ~
    dns: ~
    ports:
      - port: 53
        name: dns
        http: false
        publish: ~
      - port: 88
        name: kerberos
        http: false
        publish: ~
      - port: 389
        name: ldap
        http: false
        publish: ~
      - port: 445
        name: smb
        http: false
        publish: ~
    inputs: []
    resources:
      cpus: 2
      memory_mb: 4096
      disk_gb: 60
    depends_on: []
    volumes: {}
    access: false
    docker: ~
    vm:
      os: windows-server-2022
      provision: []
      image: ~
  ws-01:
    networks:
      corp: 21
    os: windows@11
    arch: amd64
    privileged: false
    read_only: false
    tmpfs: []
    shm_size: ~
    dns: ~
    ports: []
    inputs: []
    resources:
      cpus: 2
      memory_mb: 4096
      disk_gb: 60
    depends_on:
      - dc01
    volumes: {}
    access: false
    docker: ~
    vm:
      os: windows-11
      provision: []
      image: ~
  ws-02:
    networks:
      corp: 22
    os: windows@11
    arch: amd64
    privileged: false
    read_only: false
    tmpfs: []
    shm_size: ~
    dns: ~
    ports: []
    inputs: []
    resources:
      cpus: 2
      memory_mb: 4096
      disk_gb: 60
    depends_on:
      - dc01
    volumes: {}
    access: false
    docker: ~
    vm:
      os: windows-11
      provision: []
      image: ~
  web01:
    networks:
      dmz: 10
      corp: 10
    os: debian@12
    arch: amd64
    privileged: false
    read_only: false
    tmpfs: []
    shm_size: ~
    dns: ~
    ports:
      - port: 80
        name: web
        http: false
        publish: ~
    inputs: []
    resources: ~
    depends_on: []
    volumes: {}
    access: false
    docker:
      image: ~
      build: build/web01
      init: []
      idle: false
    vm:
      os: debian-12
      provision:
        - provision/web01.yml
      image: ~
  user:
    networks:
      access: 10
    os: debian@12
    arch: amd64
    privileged: false
    read_only: false
    tmpfs: []
    shm_size: ~
    dns: ~
    ports: []
    inputs: []
    resources: ~
    depends_on: []
    volumes: {}
    access: true
    docker:
      image: "debian:12@sha256:2c037a04925515fdd6ea85ea14a682d0e79931f5e9f5d07b6dbfc6ba12f9e858"
      build: ~
      init: []
      idle: true
    vm:
      os: debian-12
      provision: []
      image: ~
common: ~
groups:
  domain:
    members:
      - dc01
      - ws-01
      - ws-02
provision:
  - ansible: provision/ad-domain.yml
    inventory: []
    groups: {}
    vars: {}
    host_vars: {}
    requirements: ~
  - ansible: provision/ad-join.yml
    inventory: []
    groups: {}
    vars: {}
    host_vars: {}
    requirements: ~
  - ansible: provision/ws.yml
    inventory: []
    groups: {}
    vars: {}
    host_vars: {}
    requirements: ~
checks:
  - checks/domain-up.sh
  - name: web01 reaches the directory on dc01
    from: web01
    http: ~
    tcp: ~
    exec: ~
    script: checks/web01-reaches-dc01.sh
    expect: ~
    wait: ~
targets: ~
