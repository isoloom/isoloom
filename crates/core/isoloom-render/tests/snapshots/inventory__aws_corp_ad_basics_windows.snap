---
source: crates/isoloom-render/tests/inventory.rs
expression: "inventory::render(&env(\"corp-ad-basics\", Target::CloudVm), &aws())"
---
[linux]
web01 ansible_host=10.40.10.10 ansible_user=admin

[windows]
dc01 ansible_host=10.40.20.5
ws-01 ansible_host=10.40.20.21
ws-02 ansible_host=10.40.20.22

[linux:vars]
ansible_ssh_private_key_file=/etc/isoloom/id_ed25519
ansible_become=true

[windows:vars]
ansible_user=isoloom
ansible_password=${random_password.windows.result}
ansible_connection=winrm
ansible_port=5985
ansible_winrm_scheme=http
ansible_winrm_transport=basic
ansible_winrm_server_cert_validation=ignore
ansible_winrm_operation_timeout_sec=400
ansible_winrm_read_timeout_sec=500

[domain]
dc01
ws-01
ws-02
