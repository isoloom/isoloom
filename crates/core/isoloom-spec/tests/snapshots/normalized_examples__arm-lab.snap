---
source: crates/isoloom-spec/tests/normalized_examples.rs
expression: spec
---
version: 1
name: arm-lab
networks:
  lab:
    cidr: 10.60.0.0/24
    internet: true
    gateway: ~
    docker: ~
reach: []
inputs: []
machines:
  web:
    networks:
      lab: 10
    arch: arm64
    privileged: true
    read_only: true
    tmpfs:
      - /run
      - /var/cache/nginx
    shm_size: 128m
    dns:
      servers:
        - 10.60.0.2
      search:
        - arm.lab
      domain: arm.lab
    ports:
      - port: 80
        name: ~
        http: true
        publish: 8085
    inputs: []
    resources: ~
    depends_on: []
    volumes: {}
    access: false
    docker:
      image: "nginx:1.27"
      build: ~
      init: []
      idle: false
    vm: ~
common: ~
groups: {}
provision: []
checks:
  - checks/web-answers.sh
targets: ~
