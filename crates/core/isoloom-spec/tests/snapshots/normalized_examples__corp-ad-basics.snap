        publish: ~
      - port: 88
        name: ~
        http: false
        publish: ~
      - port: 389
        name: ~
        http: false
        publish: ~
      - port: 445
        name: ~
        http: false
        publish: ~
    inputs: []
    resources:
      cpus: 2
      memory_mb: 4096
      disk_gb: 60
    depends_on: []
    volumes: {}
    access: false
    docker: ~
    vm:
      os: windows-server-2022
      provision:
        - provision/ad-domain.yml
      image: ~
  ws-01:
    networks:
      corp: 21
    arch: amd64
    privileged: false
    read_only: false
    tmpfs: []
    shm_size: ~
    dns: ~
    ports: []
    inputs: []
    resources:
