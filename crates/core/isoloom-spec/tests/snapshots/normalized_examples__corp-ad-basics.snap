    volumes: {}
    access: false
    docker: ~
    vm:
      os: windows-11
      provision:
        - provision/ad-join.yml
        - provision/ws.yml
      image: ~
  ws-02:
    networks:
      corp: 22
    arch: amd64
    privileged: false
    read_only: false
    tmpfs: []
    shm_size: ~
    dns: ~
    ports: []
    inputs: []
    resources:
      cpus: 2
      memory_mb: 4096
      disk_gb: 60
    depends_on:
      - dc01
    volumes: {}
    access: false
    docker: ~
    vm:
      os: windows-11
      provision:
        - provision/ad-join.yml
        - provision/ws.yml
      image: ~
  web01:
    networks:
      dmz: 10
      corp: 10
    arch: amd64
    privileged: false
    read_only: false
    tmpfs: []
    shm_size: ~
    dns: ~
