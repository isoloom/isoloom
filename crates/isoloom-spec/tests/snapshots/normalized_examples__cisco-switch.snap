---
source: crates/isoloom-spec/tests/normalized_examples.rs
expression: spec
---
version: 1
name: cisco-switch
networks:
  office-vlan10:
    cidr: 10.92.10.0/24
    internet: false
    gateway: ~
    docker: ~
    switch: sw1
  office-vlan20:
    cidr: 10.92.20.0/24
    internet: false
    gateway: ~
    docker: ~
    switch: sw1
reach: []
inputs: []
machines:
  sw1:
    networks: {}
    arch: amd64
    privileged: false
    read_only: false
    tmpfs: []
    shm_size: ~
    dns: ~
    services: []
    inputs: []
    resources: ~
    depends_on: []
    volumes: {}
    access: false
    docker:
      image: "vrnetlab/cisco_iol:L2-17.12.01"
      build: ~
      init: []
      idle: false
      appliance: cisco-iol-l2
      config: configs/sw1.cfg
    vm: ~
  files:
    networks:
      office-vlan10: 10
      office-vlan20: 10
    arch: amd64
    privileged: false
    read_only: false
    tmpfs: []
    shm_size: ~
    dns: ~
    services:
      - port: 80
        name: ~
        http: true
        publish: ~
    inputs: []
    resources: ~
    depends_on: []
    volumes: {}
    access: false
    docker:
      image: "nginx:1.27-alpine"
      build: ~
      init: []
      idle: false
    vm: ~
  staff:
    networks:
      office-vlan10: 20
    arch: amd64
    privileged: false
    read_only: false
    tmpfs: []
    shm_size: ~
    dns: ~
    services: []
    inputs: []
    resources: ~
    depends_on: []
    volumes: {}
    access: false
    docker:
      image: "alpine:3.20"
      build: ~
      init: []
      idle: true
    vm: ~
  guest:
    networks:
      office-vlan20: 20
    arch: amd64
    privileged: false
    read_only: false
    tmpfs: []
    shm_size: ~
    dns: ~
    services: []
    inputs: []
    resources: ~
    depends_on: []
    volumes: {}
    access: false
    docker:
      image: "alpine:3.20"
      build: ~
      init: []
      idle: true
    vm: ~
common: ~
groups: {}
provision: []
checks:
  - name: "staff reach the file server through the switch (VLAN 10, tagged on its trunk)"
    from: staff
    http: "http://10.92.10.10/"
    tcp: ~
    exec: ~
    script: ~
    expect: 200
    wait: 180
  - name: "guests too, on VLAN 20"
    from: guest
    http: "http://10.92.20.10/"
    tcp: ~
    exec: ~
    script: ~
    expect: 200
    wait: 180
targets: ~
