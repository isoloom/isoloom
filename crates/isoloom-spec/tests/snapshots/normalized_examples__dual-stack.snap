---
source: crates/isoloom-spec/tests/normalized_examples.rs
expression: spec
---
version: 1
name: dual-stack
networks:
  front:
    cidr: 10.67.10.0/24
    internet: true
    gateway: ~
    docker: ~
    ipv6:
      cidr: "fd00:67:10::/64"
  back:
    cidr: 10.67.20.0/24
    internet: false
    gateway: ~
    docker: ~
    ipv6:
      cidr: "fd00:67:20::/64"
reach:
  - from: front
    to: back
    ports:
      - 80
inputs: []
machines:
  web:
    networks:
      back: 10
    arch: amd64
    privileged: false
    read_only: false
    tmpfs: []
    shm_size: ~
    dns: ~
    ports:
      - port: 80
        name: ~
        http: true
        publish: ~
    inputs: []
    resources: ~
    depends_on: []
    volumes: {}
    access: false
    docker:
      image: "nginx:1.27-alpine"
      build: ~
      init: []
      idle: false
    vm:
      os: debian-12
      provision:
        - provision/web.sh
      image: ~
  user:
    networks:
      front: 10
    arch: amd64
    privileged: false
    read_only: false
    tmpfs: []
    shm_size: ~
    dns: ~
    ports: []
    inputs: []
    resources: ~
    depends_on: []
    volumes: {}
    access: true
    docker: ~
    vm:
      os: debian-12
      provision: []
      image: ~
common: ~
groups: {}
provision: []
checks:
  - name: the web page answers over IPv6 through the router
    from: user
    http: "http://[fd00:67:20::10]/"
    tcp: ~
    exec: ~
    script: ~
    expect: 200
    wait: 60
targets: ~
