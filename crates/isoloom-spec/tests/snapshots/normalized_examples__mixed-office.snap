---
source: crates/isoloom-spec/tests/normalized_examples.rs
expression: spec
---
version: 1
name: mixed-office
networks:
  office:
    cidr: 192.168.58.0/24
    internet: true
    gateway: ~
    docker: ~
reach: []
inputs: []
machines:
  files01:
    networks:
      office: 10
    arch: amd64
    privileged: false
    read_only: false
    tmpfs: []
    shm_size: ~
    dns: ~
    ports:
      - port: 445
        name: ~
        http: false
        publish: ~
    inputs: []
    resources:
      cpus: 2
      memory_mb: 3072
      disk_gb: ~
    depends_on: []
    volumes: {}
    access: false
    docker: ~
    vm:
      os: windows-server-2019
      provision:
        - provision/share.ps1
      image: ~
      tpm: true
  intranet:
    networks:
      office: 20
    arch: amd64
    privileged: false
    read_only: false
    tmpfs: []
    shm_size: ~
    dns: ~
    ports:
      - port: 80
        name: ~
        http: true
        publish: 8083
    inputs: []
    resources: ~
    depends_on: []
    volumes: {}
    access: false
    docker:
      image: "nginx:1.27"
      build: ~
      init: []
      idle: false
    vm:
      os: debian-12
      provision:
        - provision/intranet.sh
      image: ~
common: ~
groups: {}
provision: []
checks:
  - checks/both-answer.sh
targets: ~
