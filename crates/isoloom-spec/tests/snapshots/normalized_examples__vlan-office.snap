---
source: crates/isoloom-spec/tests/normalized_examples.rs
expression: spec
---
version: 1
name: vlan-office
networks:
  office-vlan10:
    cidr: 10.70.10.0/24
    internet: false
    gateway: ~
    docker: ~
  office-vlan20:
    cidr: 10.70.20.0/24
    internet: true
    gateway: ~
    docker: ~
  servers:
    cidr: 10.70.99.0/24
    internet: false
    gateway: ~
    docker: ~
reach:
  - from: office-vlan10
    to: servers
    ports:
      - 80
inputs: []
machines:
  intranet:
    networks:
      servers: 10
    arch: amd64
    privileged: false
    read_only: false
    tmpfs: []
    shm_size: ~
    dns: ~
    services:
      - port: 80
        name: ~
        http: true
        publish: ~
    inputs: []
    resources: ~
    depends_on: []
    volumes: {}
    access: false
    docker:
      image: "nginx:1.27-alpine"
      build: ~
      init: []
      idle: false
    vm:
      os: debian-12
      provision:
        - provision/intranet.sh
      image: ~
  staff:
    networks:
      office-vlan10: 10
    arch: amd64
    privileged: false
    read_only: false
    tmpfs: []
    shm_size: ~
    dns: ~
    services: []
    inputs: []
    resources: ~
    depends_on: []
    volumes: {}
    access: true
    docker: ~
    vm:
      os: debian-12
      provision: []
      image: ~
  guest:
    networks:
      office-vlan20: 10
    arch: amd64
    privileged: false
    read_only: false
    tmpfs: []
    shm_size: ~
    dns: ~
    services: []
    inputs: []
    resources: ~
    depends_on: []
    volumes: {}
    access: false
    docker:
      image: "alpine:3.20"
      build: ~
      init: []
      idle: true
    vm:
      os: debian-12
      provision:
        - provision/guest.sh
      image: ~
  admin:
    networks:
      office-vlan10: 50
      office-vlan20: 50
    arch: amd64
    privileged: false
    read_only: false
    tmpfs: []
    shm_size: ~
    dns: ~
    services: []
    inputs: []
    resources: ~
    depends_on: []
    volumes: {}
    access: false
    docker:
      image: "alpine:3.20"
      build: ~
      init: []
      idle: true
    vm:
      os: debian-12
      provision:
        - provision/guest.sh
      image: ~
common: ~
groups: {}
provision: []
checks:
  - name: staff reach the intranet
    from: staff
    http: "http://intranet/"
    tcp: ~
    exec: ~
    script: ~
    expect: 200
    wait: 60
  - name: "guests don't"
    from: guest
    http: ~
    tcp: "intranet:80"
    exec: ~
    script: ~
    expect: blocked
    wait: ~
  - name: the admin box reaches the intranet over its trunk
    from: admin
    http: "http://intranet/"
    tcp: ~
    exec: ~
    script: ~
    expect: 200
    wait: 60
targets: ~
