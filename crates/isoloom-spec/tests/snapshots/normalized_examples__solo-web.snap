---
source: crates/isoloom-spec/tests/normalized_examples.rs
expression: spec
---
version: 1
name: solo-web
networks:
  app:
    cidr: 10.80.0.0/24
    internet: true
    gateway: ~
    docker: ~
reach: []
inputs: []
machines:
  web:
    networks:
      app: 10
    arch: amd64
    privileged: false
    read_only: false
    tmpfs: []
    shm_size: ~
    dns: ~
    ports:
      - port: 80
        name: ~
        http: true
        publish: 8080
    inputs: []
    resources: ~
    depends_on: []
    volumes: {}
    access: false
    docker:
      image: ~
      build: build/web
      init: []
      idle: false
    vm:
      os: debian-12
      provision:
        - provision/web.sh
      image: ~
common: ~
groups: {}
provision: []
checks:
  - checks/web-answers.sh
targets: ~
