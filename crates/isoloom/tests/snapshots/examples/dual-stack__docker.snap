## .isoloom/docker/compose.yml
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  docker compose -f .isoloom/docker/compose.yml up -d --wait
# Checks: isoloom test docker (or: docker compose -f .isoloom/docker/compose.yml --profile check run --rm isoloom-check, and isoloom-check-<machine>)
# Stop:   docker compose -f .isoloom/docker/compose.yml down -v

name: dual-stack
services:
  isoloom-router:
    image: alpine:3.20
    sysctls:
      net.ipv4.ip_forward: '1'
      net.ipv6.conf.all.forwarding: '1'
    entrypoint:
    - /bin/sh
    - -c
    - apk add --no-cache nftables >/dev/null && printf '%s' "$$RULES" | nft -f - && exec sleep infinity
    hostname: isoloom-router
    networks:
      front:
        ipv4_address: 10.67.10.254
        ipv6_address: fd00:67:10::254
      back:
        ipv4_address: 10.67.20.254
        ipv6_address: fd00:67:20::254
    cap_add:
    - NET_ADMIN
    environment:
      RULES: |
        table inet isoloom {
          chain forward {
            type filter hook forward priority 0; policy drop;
            ct state established,related accept
            ip saddr 10.67.10.0/24 ip daddr 10.67.20.0/24 meta l4proto { tcp, udp } th dport { 80 } accept
            ip saddr 10.67.10.0/24 ip daddr 10.67.20.0/24 icmp type echo-request accept
            ip6 saddr fd00:67:10::/64 ip6 daddr fd00:67:20::/64 meta l4proto { tcp, udp } th dport { 80 } accept
            ip6 saddr fd00:67:10::/64 ip6 daddr fd00:67:20::/64 icmpv6 type echo-request accept
          }
        }
    healthcheck:
      test:
      - CMD-SHELL
      - nft list table inet isoloom >/dev/null 2>&1
      interval: 3s
      timeout: 3s
      retries: 60
    labels:
      isoloom.managed: 'true'
      isoloom.environment: dual-stack
    restart: unless-stopped
  web:
    image: nginx:1.27-alpine
    platform: linux/amd64
    hostname: web
    networks:
      back:
        ipv4_address: 10.67.20.10
        ipv6_address: fd00:67:20::10
    extra_hosts:
    - user:10.67.10.10
    volumes:
    - isoloom-probe-amd64:/.isoloom-probe:ro
    healthcheck:
      test:
      - CMD
      - /.isoloom-probe/busybox
      - sh
      - -c
      - /.isoloom-probe/busybox nc -z -w 2 127.0.0.1 80
      interval: 5s
      timeout: 3s
      retries: 60
      start_period: 10s
    depends_on:
      isoloom-probe-amd64:
        condition: service_completed_successfully
    labels:
      isoloom.port.80: http:80
      isoloom.managed: 'true'
      isoloom.environment: dual-stack
    restart: unless-stopped
  web-routes:
    image: alpine:3.20
    entrypoint:
    - /bin/sh
    - -c
    - ip route replace 10.67.10.0/24 via 10.67.20.254 && ip -6 route replace fd00:67:10::/64 via fd00:67:20::254 && (ip route del default 2>/dev/null || true) && (ip -6 route del default 2>/dev/null || true) && while ip -o -4 addr show | grep -qv ' lo '; do sleep 2; done; exit 1
    network_mode: service:web
    cap_add:
    - NET_ADMIN
    healthcheck:
      test:
      - CMD-SHELL
      - ip route show 10.67.10.0/24 | grep -q via && ip -6 route show fd00:67:10::/64 | grep -q via && ! ip route | grep -q '^default' && ! ip -6 route | grep -q '^default'
      interval: 2s
      timeout: 2s
      retries: 30
    depends_on:
      web:
        condition: service_started
      isoloom-router:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: dual-stack
    restart: unless-stopped
  isoloom-access:
    image: alpine:3.20
    profiles:
    - check
    entrypoint:
    - sleep
    - infinity
    hostname: user
    networks:
      front:
        ipv4_address: 10.67.10.10
        ipv6_address: fd00:67:10::10
    extra_hosts:
    - web:10.67.20.10
    labels:
      isoloom.managed: 'true'
      isoloom.environment: dual-stack
  isoloom-access-routes:
    image: alpine:3.20
    profiles:
    - check
    entrypoint:
    - /bin/sh
    - -c
    - ip route replace 10.67.20.0/24 via 10.67.10.254 && ip -6 route replace fd00:67:20::/64 via fd00:67:10::254 && while ip -o -4 addr show | grep -qv ' lo '; do sleep 2; done; exit 1
    network_mode: service:isoloom-access
    cap_add:
    - NET_ADMIN
    healthcheck:
      test:
      - CMD-SHELL
      - ip route show 10.67.20.0/24 | grep -q via && ip -6 route show fd00:67:20::/64 | grep -q via
      interval: 2s
      timeout: 2s
      retries: 30
    depends_on:
      isoloom-access:
        condition: service_started
      isoloom-router:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: dual-stack
    restart: unless-stopped
  isoloom-check:
    image: curlimages/curl:8.11.1
    profiles:
    - check
    entrypoint:
    - /bin/sh
    - /isoloom/run.sh
    network_mode: service:isoloom-access
    volumes:
    - ./checks/user.sh:/isoloom/run.sh:ro
    depends_on:
      web:
        condition: service_healthy
      web-routes:
        condition: service_healthy
      isoloom-access:
        condition: service_started
      isoloom-access-routes:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: dual-stack
  isoloom-check-web:
    image: curlimages/curl:8.11.1
    profiles:
    - check
    entrypoint:
    - /bin/sh
    - /isoloom/run.sh
    network_mode: service:web
    volumes:
    - ./checks/web.sh:/isoloom/run.sh:ro
    depends_on:
      web:
        condition: service_healthy
      web-routes:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: dual-stack
  isoloom-probe-amd64:
    image: busybox:1.37.0-musl
    platform: linux/amd64
    entrypoint:
    - /bin/cp
    - /bin/busybox
    - /probe/busybox
    network_mode: none
    volumes:
    - isoloom-probe-amd64:/probe
    labels:
      isoloom.managed: 'true'
      isoloom.environment: dual-stack
    restart: no
networks:
  front:
    enable_ipv6: true
    ipam:
      config:
      - subnet: 10.67.10.0/24
        gateway: 10.67.10.1
      - subnet: fd00:67:10::/64
        gateway: fd00:67:10::1
        ip_range: fd00:67:10::1:0/112
    labels:
      isoloom.managed: 'true'
      isoloom.environment: dual-stack
  back:
    enable_ipv6: true
    ipam:
      config:
      - subnet: 10.67.20.0/24
        gateway: 10.67.20.1
      - subnet: fd00:67:20::/64
        gateway: fd00:67:20::1
        ip_range: fd00:67:20::1:0/112
    labels:
      isoloom.managed: 'true'
      isoloom.environment: dual-stack
volumes:
  isoloom-probe-amd64:
    labels:
      isoloom.managed: 'true'
      isoloom.environment: dual-stack

