## .isoloom/kubernetes/checks/job.yaml
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# The environment's checks, one Job per position. Run after the environment (or `isoloom test kubernetes`):
#   kubectl -n isoloom-workbench delete job isoloom-check-bench --ignore-not-found
#   kubectl kustomize --load-restrictor LoadRestrictionsNone .isoloom/kubernetes/checks | kubectl apply -f -
#   kubectl -n isoloom-workbench wait --for=condition=complete job --all --timeout=300s; kubectl -n isoloom-workbench logs -l isoloom.com/check
apiVersion: batch/v1
kind: Job
metadata:
  name: isoloom-check-bench
spec:
  backoffLimit: 0
  template:
    metadata:
      labels:
        net.isoloom.com/lan: member
        isoloom.com/check: isoloom-check-bench
    spec:
      restartPolicy: Never
      containers:
      - name: check
        image: curlimages/curl:8.11.1
        command:
        - /bin/sh
        - /isoloom/run/bench.sh
        volumeMounts:
        - name: runner
          mountPath: /isoloom/run
      volumes:
      - name: runner
        configMap:
          name: isoloom-check-runners
          defaultMode: 493

## .isoloom/kubernetes/checks/kustomization.yaml
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
namespace: isoloom-workbench
resources:
- job.yaml
generatorOptions:
  disableNameSuffixHash: true
configMapGenerator:
- name: isoloom-check-runners
  files:
  - bench.sh

## .isoloom/kubernetes/environment.yaml
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  kubectl kustomize --load-restrictor LoadRestrictionsNone .isoloom/kubernetes | kubectl apply -f -
