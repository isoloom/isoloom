        ],
        "refused": {
          "digitalocean": "DigitalOcean cloud-vm takes one machine on one network: a droplet joins one VPC, at a private address DigitalOcean picks, so other machines couldn't reach it at its spec address"
        }
      }
    }
  },
  "checks": {
    "default_position": "networks",
    "positions": [
      {
        "position": "web",
        "machine": "web",
        "runner": "isoloom-check-web",
        "checks": [
          {
            "name": "the client's name resolves in the private zone",
            "derived": false,
            "kind": "exec",
            "target": "getent hosts client.corp.internal",
            "expect": "",
            "wait": 0
          }
        ]
      },
      {
        "position": "client",
        "machine": "client",
        "runner": "isoloom-check-client",
        "checks": [
          {
            "name": "the web server answers at its alias in the private zone",
            "derived": false,
            "kind": "http",
            "target": "http://www.corp.internal/",
            "expect": "200",
            "wait": 30
          },
          {
            "name": "web:80 from client",
            "derived": true,
            "kind": "http",
            "target": "http://10.84.0.10:80/",
            "expect": "any",
            "wait": 30
          }
        ]
      }
    ]
  }
}
