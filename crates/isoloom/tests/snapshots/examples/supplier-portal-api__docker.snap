      "access": false,
      "supplied": false,
      "shapes": [
        "docker",
        "vm"
      ],
      "role": "target",
      "arch": "amd64",
      "os": "debian-12",
      "windows": false,
      "addresses": {
        "lab": "10.20.0.32"
      },
      "docker_addresses": {
        "lab": "10.20.0.32"
      },
      "ports": [
        {
          "port": 3207,
          "name": "mysql",
          "http": false,
          "publish": null
        }
      ],
      "depends_on": [],
      "inputs": [
        "API_URL",
        "LAUNCH_TOKEN"
