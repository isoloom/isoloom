  "targets": {
    "possible": [
      "docker",
      "hosted",
      "docker-vm",
      "cloud-docker",
      "kubernetes",
      "vagrant",
      "proxmox",
      "esxi",
      "cloud-vm"
    ],
    "generated": [
      "docker",
      "hosted",
      "docker-vm",
      "cloud-docker",
      "kubernetes",
      "vagrant",
      "proxmox",
      "esxi",
      "cloud-vm"
    ],
    "refused": {},
    "not_possible": {
      "hybrid": "only when some machines are containers and others are VMs",
      "external": "needs `external:` on intranet, guest, admin",
      "cloud-services": "left out by `targets:`"
    },
    "clouds": {
      "cloud-vm": {
        "generated": [
          "aws",
          "azure",
          "gcp",
          "oci"
        ],
        "refused": {
          "digitalocean": "DigitalOcean cloud-vm takes one machine on one network: a droplet joins one VPC, at a private address DigitalOcean picks, so other machines couldn't reach it at its spec address",
          "linode": "machine `admin` is on several networks: a Linode instance has one VPC interface"
        }
      }
    }
  },
  "checks": {
    "default_position": "staff",
    "positions": [
      {
        "position": "staff",
        "machine": "staff",
        "runner": "isoloom-check",
        "checks": [
          {
            "name": "staff reach the intranet",
            "derived": false,
            "kind": "http",
            "target": "http://intranet/",
            "expect": "200",
            "wait": 60
          },
          {
            "name": "intranet:80 from staff",
            "derived": true,
            "kind": "http",
            "target": "http://10.70.99.10:80/",
            "expect": "any",
            "wait": 30
          },
          {
            "name": "no internet from staff",
            "derived": true,
            "kind": "http",
            "target": "http://1.1.1.1/",
            "expect": "blocked",
            "wait": 0
          }
        ]
      },
      {
        "position": "intranet",
        "machine": "intranet",
        "runner": "isoloom-check-intranet",
        "checks": [
          {
            "name": "no internet from intranet",
            "derived": true,
            "kind": "http",
            "target": "http://1.1.1.1/",
            "expect": "blocked",
            "wait": 0
          }
        ]
      },
      {
        "position": "guest",
        "machine": "guest",
        "runner": "isoloom-check-guest",
        "checks": [
          {
            "name": "guests don't",
            "derived": false,
            "kind": "tcp",
            "target": "intranet:80",
            "expect": "blocked",
            "wait": 0
          },
          {
            "name": "intranet:80 blocked from guest",
            "derived": true,
            "kind": "tcp",
            "target": "10.70.99.10:80",
            "expect": "blocked",
            "wait": 0
          }
        ]
      },
      {
        "position": "admin",
        "machine": "admin",
        "runner": "isoloom-check-admin",
        "checks": [
          {
            "name": "the admin box reaches the intranet over its trunk",
            "derived": false,
            "kind": "http",
            "target": "http://intranet/",
            "expect": "200",
            "wait": 60
          },
          {
            "name": "intranet:80 from admin",
            "derived": true,
            "kind": "http",
            "target": "http://10.70.99.10:80/",
            "expect": "any",
            "wait": 30
          }
        ]
      }
    ]
  }
}
