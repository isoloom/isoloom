## .isoloom/docker/compose.yml
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  docker compose -f .isoloom/docker/compose.yml up -d --wait
# Checks: isoloom test docker (or: docker compose -f .isoloom/docker/compose.yml --profile check run --rm isoloom-check, and isoloom-check-<machine>)
# Stop:   docker compose -f .isoloom/docker/compose.yml down -v
# On Docker, network `lab` uses 10.62.0.0/24 instead of 192.168.62.0/24 (same last octets).

name: air-gapped
services:
  store:
    image: redis:7-alpine
    platform: linux/amd64
    hostname: store
    networks:
      lab:
        ipv4_address: 10.62.0.20
    volumes:
    - isoloom-probe-amd64:/.isoloom-probe:ro
    healthcheck:
      test:
      - CMD
      - /.isoloom-probe/busybox
      - sh
      - -c
      - /.isoloom-probe/busybox nc -z -w 2 127.0.0.1 6379
      interval: 5s
      timeout: 3s
      retries: 60
      start_period: 10s
    depends_on:
      isoloom-probe-amd64:
        condition: service_completed_successfully
    labels:
      isoloom.port.redis: tcp:6379
      isoloom.managed: 'true'
      isoloom.environment: air-gapped
    restart: unless-stopped
  app:
    image: nginx:1.27-alpine
    platform: linux/amd64
    hostname: app
    networks:
      lab:
        ipv4_address: 10.62.0.10
    volumes:
    - isoloom-probe-amd64:/.isoloom-probe:ro
    healthcheck:
      test:
      - CMD
      - /.isoloom-probe/busybox
      - sh
      - -c
      - /.isoloom-probe/busybox nc -z -w 2 127.0.0.1 80
      interval: 5s
      timeout: 3s
      retries: 60
      start_period: 10s
    depends_on:
      isoloom-probe-amd64:
        condition: service_completed_successfully
      store:
        condition: service_healthy
    labels:
      isoloom.port.80: http:80
      isoloom.managed: 'true'
      isoloom.environment: air-gapped
    restart: unless-stopped
  isoloom-check-store:
    image: curlimages/curl:8.11.1
    profiles:
    - check
    entrypoint:
    - /bin/sh
    - /isoloom/run.sh
    network_mode: service:store
    volumes:
    - ./checks/store.sh:/isoloom/run.sh:ro
    depends_on:
      store:
        condition: service_healthy
      app:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: air-gapped
  isoloom-check-app:
    image: curlimages/curl:8.11.1
    profiles:
    - check
    entrypoint:
    - /bin/sh
    - /isoloom/run.sh
    network_mode: service:app
    volumes:
    - ./checks/app.sh:/isoloom/run.sh:ro
    depends_on:
      store:
        condition: service_healthy
      app:
        condition: service_healthy
    labels:
      isoloom.managed: 'true'
      isoloom.environment: air-gapped
  isoloom-probe-amd64:
    image: busybox:1.37.0-musl
    platform: linux/amd64
    entrypoint:
    - /bin/cp
    - /bin/busybox
    - /probe/busybox
    network_mode: none
    volumes:
    - isoloom-probe-amd64:/probe
    labels:
      isoloom.managed: 'true'
      isoloom.environment: air-gapped
    restart: no
networks:
  lab:
    ipam:
      config:
      - subnet: 10.62.0.0/24
        gateway: 10.62.0.1
    internal: true
    labels:
      isoloom.managed: 'true'
      isoloom.environment: air-gapped
volumes:
  isoloom-probe-amd64:
    labels:
      isoloom.managed: 'true'
      isoloom.environment: air-gapped

