            "derived": true,
            "kind": "http",
            "target": "http://1.1.1.1/",
            "expect": "blocked",
            "wait": 0
          }
        ]
      },
      {
        "position": "app",
        "machine": "app",
        "runner": "isoloom-check-app",
        "checks": [
