            "name": "store:6379 from app",
            "derived": true,
            "kind": "tcp",
            "target": "192.168.62.20:6379",
            "expect": "open",
            "wait": 30
          },
          {
            "name": "no internet from app",
            "derived": true,
            "kind": "http",
            "target": "http://1.1.1.1/",
            "expect": "blocked",
            "wait": 0
          }
        ]
      }
    ]
  }
}
