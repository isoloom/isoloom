c=$(_http 'http://1.1.1.1/'); if [ "$c" = 000 ]; then pass 'no internet from staff'; else fail 'no internet from staff' "http://1.1.1.1/ answered (HTTP $c); it should be blocked"; fi
fi

echo "isoloom-check: END $passed passed, $failed failed"
[ "$failed" -eq 0 ]

## .isoloom/cloud-vm/gcp/main.tf
# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  terraform -chdir=.isoloom/cloud-vm/gcp init && terraform -chdir=.isoloom/cloud-vm/gcp apply \
#           -var billing_account=<id> -var allowed_cidr=<your IP>/32 -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)" -var ssh_private_key_file=~/.ssh/id_ed25519
# Stop:   terraform -chdir=.isoloom/cloud-vm/gcp destroy (same variables)

terraform {
  required_version = ">= 1.6"
  backend "local" {}
  required_providers {
    google = { source = "hashicorp/google", version = "~> 8.5.0" }
    local  = { source = "hashicorp/local", version = "~> 2.9.1" }
  }
}

variable "project" {
  type        = string
  default     = ""
  description = "An existing project; or leave empty and give billing_account for a project of its own"
}

variable "billing_account" {
  type        = string
  default     = ""
  description = "With no project: create one for this environment, billed here, deleted with it"
}

variable "org_id" {
  type    = string
  default = ""
}

variable "region" {
  type    = string
  default = "europe-west9"
}

variable "allowed_cidr" {
  type        = string
  description = "Who may reach the machines (SSH and the published ports), e.g. your IP/32"
}

variable "ssh_public_key" {
  type = string
}

variable "ssh_private_key_file" {
  type        = string
  description = "The private key of ssh_public_key: Terraform sets the machines up over SSH"
}

variable "auto_stop_minutes" {
  type        = number
  default     = 0
  description = "Shut the machines down after this many minutes (0: never)"
}

variable "expires_at" {
  type        = string
  default     = ""
  description = "When the environment should end, in Unix seconds (empty: no end), as a tag on every resource so a reaper can find what to destroy"
}

provider "google" {
  region = var.region
}

# A project of its own when none is given: everything goes when the environment is destroyed.
resource "google_project" "env" {
  count               = var.project == "" ? 1 : 0
  name                = "isoloom-vlan-office"
  project_id          = "isoloom-${terraform_data.id.output}"
  billing_account     = var.billing_account
  org_id              = var.org_id == "" ? null : var.org_id
  deletion_policy     = "DELETE"
  auto_create_network = false
}

resource "google_project_service" "compute" {
  count              = var.project == "" ? 1 : 0
  project            = google_project.env[0].project_id
  service            = "compute.googleapis.com"
  disable_on_destroy = false
}

resource "terraform_data" "id" {
  input = substr(replace(uuid(), "-", ""), 0, 8)
  lifecycle {
    ignore_changes = [input]
  }
}

locals {
  name    = "isoloom-vlan-office-${terraform_data.id.output}"
  root    = abspath("${path.module}/../../..")
  project = var.project != "" ? var.project : google_project_service.compute[0].project
  zone    = "${var.region}-a"
}

# The environment's networks: a VPC network each, holding a subnetwork with its exact range.
resource "google_compute_network" "office_vlan10" {
  project                 = local.project
  name                    = "${local.name}-office-vlan10"
  auto_create_subnetworks = false
  mtu                     = 1500
}

resource "google_compute_subnetwork" "office_vlan10" {
  project       = local.project
  name          = "${local.name}-office-vlan10"
  network       = google_compute_network.office_vlan10.id
  ip_cidr_range = "10.70.10.0/24"
  region        = var.region
}

resource "google_compute_network" "office_vlan20" {
  project                 = local.project
  name                    = "${local.name}-office-vlan20"
  auto_create_subnetworks = false
  mtu                     = 1500
}

resource "google_compute_subnetwork" "office_vlan20" {
  project       = local.project
  name          = "${local.name}-office-vlan20"
  network       = google_compute_network.office_vlan20.id
  ip_cidr_range = "10.70.20.0/24"
  region        = var.region
}

resource "google_compute_network" "servers" {
  project                 = local.project
  name                    = "${local.name}-servers"
  auto_create_subnetworks = false
  mtu                     = 1500
}

resource "google_compute_subnetwork" "servers" {
  project       = local.project
  name          = "${local.name}-servers"
  network       = google_compute_network.servers.id
  ip_cidr_range = "10.70.99.0/24"
  region        = var.region
}

resource "google_compute_network_peering" "office_vlan10_office_vlan20" {
  name                 = "${local.name}-office-vlan10-office-vlan20"
  network              = google_compute_network.office_vlan10.self_link
  peer_network         = google_compute_network.office_vlan20.self_link
  export_custom_routes = true
  import_custom_routes = true
}

resource "google_compute_network_peering" "office_vlan20_office_vlan10" {
  name                 = "${local.name}-office-vlan20-office-vlan10"
  network              = google_compute_network.office_vlan20.self_link
  peer_network         = google_compute_network.office_vlan10.self_link
  export_custom_routes = true
  import_custom_routes = true
  depends_on           = [google_compute_network_peering.office_vlan10_office_vlan20]
}

resource "google_compute_network_peering" "office_vlan10_servers" {
  name                 = "${local.name}-office-vlan10-servers"
  network              = google_compute_network.office_vlan10.self_link
  peer_network         = google_compute_network.servers.self_link
  export_custom_routes = true
  import_custom_routes = true
  depends_on           = [google_compute_network_peering.office_vlan20_office_vlan10]
}

resource "google_compute_network_peering" "servers_office_vlan10" {
  name                 = "${local.name}-servers-office-vlan10"
  network              = google_compute_network.servers.self_link
  peer_network         = google_compute_network.office_vlan10.self_link
  export_custom_routes = true
  import_custom_routes = true
  depends_on           = [google_compute_network_peering.office_vlan10_servers]
}

resource "google_compute_network_peering" "office_vlan20_servers" {
  name                 = "${local.name}-office-vlan20-servers"
  network              = google_compute_network.office_vlan20.self_link
  peer_network         = google_compute_network.servers.self_link
  export_custom_routes = true
  import_custom_routes = true
  depends_on           = [google_compute_network_peering.servers_office_vlan10]
}

resource "google_compute_network_peering" "servers_office_vlan20" {
  name                 = "${local.name}-servers-office-vlan20"
  network              = google_compute_network.servers.self_link
  peer_network         = google_compute_network.office_vlan20.self_link
  export_custom_routes = true
  import_custom_routes = true
  depends_on           = [google_compute_network_peering.office_vlan20_servers]
}

# Machine `intranet`: what may reach it.
resource "google_compute_firewall" "intranet_net_servers" {
  project       = local.project
  name          = "${local.name}-intranet-net-servers"
  network       = google_compute_network.servers.id
  direction     = "INGRESS"
  source_ranges = ["10.70.99.0/24"]
  target_tags   = ["${local.name}-intranet"]
  allow {
    protocol = "all"
  }
}

resource "google_compute_firewall" "intranet_ssh" {
  project       = local.project
  name          = "${local.name}-intranet-ssh"
  network       = google_compute_network.servers.id
  direction     = "INGRESS"
  source_ranges = [var.allowed_cidr]
  target_tags   = ["${local.name}-intranet"]
  allow {
    protocol = "tcp"
    ports    = ["22"]
  }
}

resource "google_compute_firewall" "intranet_reach_office_vlan10" {
  project       = local.project
  name          = "${local.name}-intranet-reach-office-vlan10"
  network       = google_compute_network.servers.id
  direction     = "INGRESS"
  source_ranges = ["10.70.10.0/24"]
  target_tags   = ["${local.name}-intranet"]
  allow {
    protocol = "tcp"
    ports    = ["80"]
  }
  allow {
    protocol = "udp"
    ports    = ["80"]
  }
}

resource "google_compute_instance" "intranet" {
  project      = local.project
  name         = "${local.name}-intranet"
  machine_type = "e2-small"
  zone         = local.zone
  tags         = ["${local.name}-intranet"]
  boot_disk {
    initialize_params {
      image = "debian-cloud/debian-12"
      size  = 20
    }
  }
  network_interface {
    subnetwork = google_compute_subnetwork.servers.id
    network_ip = "10.70.99.10"
    access_config {}
  }
  metadata                = { ssh-keys = "admin:${var.ssh_public_key}" }
  metadata_startup_script = var.auto_stop_minutes > 0 ? "#!/bin/sh\nshutdown -h +${var.auto_stop_minutes}\n" : null
  labels = {
    isoloom-environment = "vlan-office"
    managed-by          = "isoloom"
    isoloom-instance    = local.name
    isoloom-expires-at  = var.expires_at
  }
}

resource "terraform_data" "intranet" {
  triggers_replace = [google_compute_instance.intranet.id]
  connection {
    type        = "ssh"
    host        = google_compute_instance.intranet.network_interface[0].access_config[0].nat_ip
    user        = "admin"
    private_key = file(pathexpand(var.ssh_private_key_file))
    timeout     = "10m"
  }
  provisioner "local-exec" {
    command = "tar -czf \"${path.module}/.isoloom-project-intranet.tgz\" --exclude=.git --exclude=.vagrant --exclude=.terraform --exclude=.isoloom-project* -X \"${abspath(local_file.isoloom_project.filename)}\" -C \"${dirname(local.root)}\" \"${basename(local.root)}\""
  }
  provisioner "file" {
    source      = "${path.module}/.isoloom-project-intranet.tgz"
    destination = "/tmp/isoloom-project.tgz"
  }
  provisioner "remote-exec" {
    inline = [
      "set -e",
      "cloud-init status --wait >/dev/null 2>&1 || true",
      "sudo sh -c 'mkdir -p /opt/isoloom && tar -xzf /tmp/isoloom-project.tgz -C /opt/isoloom --strip-components=1 && rm -f /tmp/isoloom-project.tgz'",
      "sudo sh -c 'for l in '\\''10.70.10.10 staff'\\'' '\\''10.70.20.10 guest'\\'' '\\''10.70.10.50 admin'\\''; do grep -qxF \"$l\" /etc/hosts || printf '\\''%s\\n'\\'' \"$l\" >> /etc/hosts; done'",
      "sudo sh -c 'cd /opt/isoloom && sh -c '\\''sh provision/intranet.sh'\\'''",
      "sudo sh -c 'pkg() { if command -v apt-get >/dev/null; then apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \"$@\"; elif command -v dnf >/dev/null; then dnf install -y -q \"$@\"; else yum install -y -q \"$@\"; fi; }\ncommand -v nft >/dev/null || if command -v apk >/dev/null; then apk add -q --no-cache nftables; else pkg nftables; fi\nprintf '\\''%s\\n'\\'' '\\''table inet isoloom-egress'\\'' '\\''delete table inet isoloom-egress'\\'' '\\''table inet isoloom-egress {'\\'' '\\''  chain output {'\\'' '\\''    type filter hook output priority 0; policy accept;'\\'' '\\''    oifname \"lo\" accept'\\'' '\\''    ip daddr != { 10.70.10.0/24, 10.70.20.0/24, 10.70.99.0/24 } ct state new drop'\\'' '\\''  }'\\'' '\\''}'\\'' > /etc/isoloom-egress.nft\nmkdir -p /etc/isoloom\ncat > /etc/isoloom/egress.sh <<'\\''EGRESS'\\''\n#!/bin/sh\n# No new connection leaves the isoloom networks\nnft -f /etc/isoloom-egress.nft\nexit 0\nEGRESS\nchmod +x /etc/isoloom/egress.sh\nif command -v systemctl >/dev/null; then\ncat > /etc/systemd/system/isoloom-egress.service <<'\\''UNIT'\\''\n[Unit]\nDescription=No new connection leaves the isoloom networks\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=-/etc/isoloom/egress.sh\n\n[Install]\nWantedBy=multi-user.target\nUNIT\nsystemctl daemon-reload\nsystemctl enable isoloom-egress.service\nsystemctl restart isoloom-egress.service\nelse\nmkdir -p /etc/local.d && ln -sf /etc/isoloom/egress.sh /etc/local.d/isoloom-egress.start\nrc-update add local default >/dev/null 2>&1 || true\n/etc/isoloom/egress.sh || true\nfi'",
      "sudo sh -c 'mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready'"
    ]
  }
}

# Machine `staff`: what may reach it.
