      v.esxi_hostname = ENV.fetch("ESXI_HOSTNAME", "")
      v.esxi_hostport = ENV.fetch("ESXI_HOSTPORT", "22").to_i
      v.esxi_username = ENV.fetch("ESXI_USERNAME", "root")
      v.esxi_password = "env:ESXI_PASSWORD"
      v.esxi_disk_store = ENV["ESXI_DATASTORE"] if ENV["ESXI_DATASTORE"]
      v.esxi_virtual_network = esxi_networks(["app"])
      v.guest_name = "hello-stack-cache"
      v.guest_numvcpus = 1
      v.guest_memsize = 1024
    end
    m.vm.provider "libvirt" do |v, o|
      o.vm.box = "generic/debian12"
      v.cpus = 1
      v.memory = 1024
      v.machine_arch = "x86_64"
    end
    m.vm.provider "hyperv" do |v, o|
      o.vm.box = "generic/debian12"
      o.vm.box_version = "4.3.12"
      v.vmname = "hello-stack-cache"
      v.cpus = 1
      v.memory = 1024
      v.linked_clone = true
      o.vm.network "private_network", bridge: HYPERV_SWITCH
    end
    m.trigger.before :"VagrantPlugins::HyperV::Action::Configure", type: :action do |t|
      t.ruby { |_, _| IsoloomHyperV.switches(["isoloom-hello-stack-app"]) }
    end
    m.trigger.before :"VagrantPlugins::HyperV::Action::StartInstance", type: :action do |t|
      t.ruby { |_, machine| IsoloomHyperV.attach(machine, [["isoloom-hello-stack-app", "0215691A601D"]]) }
    end
    m.trigger.after :"VagrantPlugins::HyperV::Action::WaitForIPAddress", type: :action do |t|
      t.ruby do |_, machine|
        IsoloomHyperV.address(machine, <<~'SH')
          set -e
          mkdir -p /etc/isoloom
          cat > /etc/isoloom/lab-net.sh <<'NET'
          #!/bin/sh
          # This machine's addresses on the isoloom networks (Hyper-V sets none), by adapter MAC.
          lab() {
            for d in /sys/class/net/*; do
              [ "$(cat "$d/address" 2>/dev/null)" = "$1" ] || continue
              IF=${d##*/}
              if command -v nmcli >/dev/null; then nmcli device set "$IF" managed no 2>/dev/null || true; fi
              ip link set "$IF" up
              ip -4 addr show dev "$IF" | grep -q " $2 " || ip addr add "$2" dev "$IF"
              return 0
            done
            echo "isoloom: no network adapter with MAC $1" >&2
            return 1
          }
          rc=0
          lab 02:15:69:1a:60:1d 10.60.0.20/24 || rc=1
          exit $rc
          NET
          chmod +x /etc/isoloom/lab-net.sh
          # NetworkManager would try DHCP there.
          if [ -d /etc/NetworkManager/conf.d ]; then
            printf '[keyfile]\nunmanaged-devices=mac:02:15:69:1a:60:1d\n' > /etc/NetworkManager/conf.d/90-isoloom-lab.conf
          fi
          if [ -d /run/systemd/system ]; then
            cat > /etc/systemd/system/isoloom-lab-net.service <<'UNIT'
          [Unit]
          Description=Addresses on the isoloom networks
          After=network-pre.target NetworkManager.service systemd-networkd.service
          Before=network-online.target isoloom-routes.service

          [Service]
          Type=oneshot
          RemainAfterExit=yes
          ExecStart=/etc/isoloom/lab-net.sh

          [Install]
          WantedBy=multi-user.target
          UNIT
            systemctl daemon-reload
            systemctl enable -q isoloom-lab-net.service
          elif command -v rc-update >/dev/null; then
            printf '#!/bin/sh\nexec /etc/isoloom/lab-net.sh\n' > /etc/local.d/isoloom-lab-net.start
            chmod +x /etc/local.d/isoloom-lab-net.start
            rc-update add local default >/dev/null
          fi
          /etc/isoloom/lab-net.sh
        SH
      end
    end
    m.trigger.after :"VagrantPlugins::HyperV::Action::DeleteVM", type: :action do |t|
      t.ruby { |_, _| IsoloomHyperV.prune(["isoloom-hello-stack-app"]) }
    end
    m.vm.provision "isoloom_project", name: "project"
    m.vm.provision "shell", name: "hosts", inline: "for l in '10.60.0.10 web'; do grep -qxF \"$l\" /etc/hosts || printf '%s\\n' \"$l\" >> /etc/hosts; done"
    m.vm.provision "shell", name: "volumes", inline: "mkdir -p '/data'"
    m.vm.provision "shell", name: "provision/cache.sh", inline: "cd /opt/isoloom && sh -c 'sh provision/cache.sh'"
    m.vm.provision "shell", name: "no internet", inline: <<~'SH'
      pkg() { if command -v apt-get >/dev/null; then apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "$@"; elif command -v dnf >/dev/null; then dnf install -y -q "$@"; else yum install -y -q "$@"; fi; }
      command -v nft >/dev/null || if command -v apk >/dev/null; then apk add -q --no-cache nftables; else pkg nftables; fi
      printf '%s\n' 'table inet isoloom-egress' 'delete table inet isoloom-egress' 'table inet isoloom-egress {' '  chain output {' '    type filter hook output priority 0; policy accept;' '    oifname "lo" accept' '    ip daddr != { 10.60.0.0/24 } ct state new drop' '  }' '}' > /etc/isoloom-egress.nft
      mkdir -p /etc/isoloom
      cat > /etc/isoloom/egress.sh <<'EGRESS'
      #!/bin/sh
      # No new connection leaves the isoloom networks
      nft -f /etc/isoloom-egress.nft
      exit 0
      EGRESS
      chmod +x /etc/isoloom/egress.sh
      if command -v systemctl >/dev/null; then
      cat > /etc/systemd/system/isoloom-egress.service <<'UNIT'
      [Unit]
      Description=No new connection leaves the isoloom networks
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      ExecStart=-/etc/isoloom/egress.sh

      [Install]
      WantedBy=multi-user.target
      UNIT
      systemctl daemon-reload
      systemctl enable isoloom-egress.service
      systemctl restart isoloom-egress.service
      else
      mkdir -p /etc/local.d && ln -sf /etc/isoloom/egress.sh /etc/local.d/isoloom-egress.start
      rc-update add local default >/dev/null 2>&1 || true
      /etc/isoloom/egress.sh || true
      fi
    SH
    m.vm.provision "shell", name: "ready", inline: "mkdir -p /var/lib/isoloom && echo ready > /var/lib/isoloom/ready"
    m.vm.provision "shell", name: "checks", run: "never", path: "checks/cache.sh", env: { "ISOLOOM_DERIVED" => ENV.fetch("ISOLOOM_DERIVED", "1") }
  end

