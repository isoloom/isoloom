# Generated by isoloom from isoloom.yml. Don't edit: change isoloom.yml and run
# `isoloom generate`. `isoloom check` fails when this file is out of date.
# Start:  cd .isoloom/vagrant && vagrant up
# Stop:   cd .isoloom/vagrant && vagrant destroy -f

# One machine at a time, in order (QEMU and libvirt would boot them all at once).
ENV["VAGRANT_NO_PARALLEL"] = "1"
ROOT = File.expand_path("../..", __dir__)
# This host's CPU as QEMU names it: a machine built for another one runs emulated there.
HOST_ARCH = RbConfig::CONFIG["host_cpu"] =~ /arm|aarch64/ ? "aarch64" : "x86_64"
# The project goes into a VM through Isoloom's own `project` step (the `isoloom_project`
# provisioner below): a tar.gz of the project as it is when the step runs, not when this file
# loads, so files added or removed since still count. Symbolic links go in as links, never
# followed (a link loop can't break the copy). Plain Ruby (Vagrant's own): no tool on the host.
require "zlib"
require "tempfile"

module IsoloomProject
  # Never copied, at any depth: version control and the tools' own state.
  SKIP = [".git", ".vagrant", ".terraform"].freeze

  # Writes the archive of `root` to `io`, gzipped. `generated`: whether Isoloom's outputs (the
  # top-level `.isoloom*` folders) go in; `extra`: files in them that go in anyway (paths from
  # `root`, with `/`). What `.isoloomignore` lists stays out.
  def self.write(root, io, generated: false, extra: [])
    gz = Zlib::GzipWriter.new(io)
    rules = ignore_rules(root)
    walk(root, nil, generated, extra, rules) { |rel, st| entry(gz, root, rel, st) }
    gz.write("\0" * 1024)
    gz.finish
  end

  # `.isoloomignore` at the project's root, gitignore-style: one pattern per line, `#` comments,
  # `!` brings a path back, a trailing `/` matches folders only, a `/` at the start or in the
  # middle anchors the pattern at the root (otherwise it matches at any depth), `*`, `?`,
  # `[abc]` and `**`. A pattern matching a folder matches everything in it, and the last pattern
  # matching a path (or a folder it is in) decides. As [regexp, keep] pairs; the Terraform
  # outputs translate the patterns the same way, so every target leaves out the same files.
  def self.ignore_rules(root)
    text = File.binread(File.join(root, ".isoloomignore")).force_encoding("UTF-8")
    text.split("\n").filter_map do |line|
      line = line.strip
      next if line.empty? || line.start_with?("#")
      keep = line.start_with?("!")
      pat = keep ? line[1..] : line
      glob = pat.delete_suffix("/").delete_suffix("/**").delete_suffix("/")
      next if glob.empty?
      anchored = glob.include?("/") ? glob.delete_prefix("/") : "**/#{glob}"
      re = anchored.gsub(/[.+^$(){}|\\]/) { "\\#{$&}" }.gsub("[!", "[^")
                   .gsub("**/", "\u0001").gsub("**", "\u0002").gsub("*", "[^/]*").gsub("?", "[^/]")
                   .gsub("\u0001", "(.*/)?").gsub("\u0002", ".*")
      [Regexp.new(glob == pat ? "^#{re}(/|$)" : "^#{re}/"), keep]
    end
  rescue Errno::ENOENT
    []
  end

  # Whether the rules leave a path out (a folder's path ends with `/`).
  def self.ignored?(rules, path)
    rules.reduce(false) { |out, (re, keep)| re.match?(path) ? !keep : out }
  end

  # Every entry under `dir` (relative to `root`), parents first, in name order.
  def self.walk(root, dir, generated, extra, rules, &block)
    names = begin
      Dir.children(dir ? File.join(root, dir) : root).sort
    rescue Errno::ENOENT, Errno::ENOTDIR
      return # removed while the archive was being written
    end
    names.each do |name|
      next if SKIP.include?(name)
      rel = dir ? "#{dir}/#{name}" : name
      if !generated && rel.start_with?(".isoloom")
        next unless extra.any? { |e| e == rel || e.start_with?("#{rel}/") }
      end
      st = begin
        File.lstat(File.join(root, rel))
      rescue Errno::ENOENT
        next
      end
      folder = st.directory?
      out = ignored?(rules, folder ? "#{rel}/" : rel)
      yield rel, st unless out
      # An ignored folder is skipped, unless a `!` pattern may bring back something in it.
      walk(root, rel, generated, extra, rules, &block) if folder && (!out || rules.any? { |_, keep| keep })
    end
  end

  def self.entry(out, root, rel, st)
    path = File.join(root, rel)
    if st.symlink?
      header(out, rel, "2", 0o777, 0, st.mtime, File.readlink(path))
    elsif st.directory?
      header(out, "#{rel}/", "5", st.mode & 0o7777, 0, st.mtime)
    elsif st.file?
      File.open(path, "rb") do |f|
        mode = st.mode & 0o7777
        # Windows has no executable bit: a script (#!) is made executable.
        mode |= 0o111 if Gem.win_platform? && f.read(2) == "#!"
        f.rewind
        header(out, rel, "0", mode, st.size, st.mtime)
        copied = IO.copy_stream(f, out, st.size)
        out.write("\0" * (st.size - copied)) if copied < st.size # shrank while being read
        out.write("\0" * ((512 - st.size % 512) % 512))
      end
    end
  rescue Errno::ENOENT
    nil # removed while the archive was being written
  end

  # A ustar header; a pax one before it for what ustar can't hold (long names, large sizes).
  def self.header(out, name, type, mode, size, mtime, link = "")
    name = name.b
    link = link.b
    pax = {}
    pax["path"] = name if name.bytesize > 100
    pax["linkpath"] = link if link.bytesize > 100
    pax["size"] = size.to_s if size >= 8**11
    unless pax.empty?
      body = pax.map { |k, v| record(k, v) }.join
      header(out, "PaxHeader/#{name.byteslice(0, 80)}", "x", 0o644, body.bytesize, mtime)
      out.write(body)
      out.write("\0" * ((512 - body.bytesize % 512) % 512))
    end
    h = [
      name.byteslice(0, 100), format("%07o", mode), format("%07o", 0), format("%07o", 0),
      format("%011o", size >= 8**11 ? 0 : size), format("%011o", [mtime.to_i, 0].max), " " * 8, type,
      link.byteslice(0, 100), "ustar", "00", "", "", "", "", "", "",
    ].pack("a100a8a8a8a12a12a8a1a100a6a2a32a32a8a8a155a12")
    h[148, 8] = format("%06o\0 ", h.sum(0))
    out.write(h)
  end

  # One pax record: "<length> key=value\n", the length counting itself.
  def self.record(key, value)
    rest = " #{key}=".b + value + "\n"
    len = rest.bytesize + 1
    len += 1 while (len.to_s.bytesize + rest.bytesize) > len
    len.to_s.b + rest
  end
end

if defined?(Vagrant) && Vagrant.respond_to?(:plugin)
  module IsoloomProject
    class Config < Vagrant.plugin("2", :config)
      attr_accessor :name, :generated, :extra

      def initialize
        super
        @name = UNSET_VALUE
        @generated = UNSET_VALUE
        @extra = UNSET_VALUE
      end

      def finalize!
        @name = nil if @name == UNSET_VALUE
        @generated = false if @generated == UNSET_VALUE
        @extra = [] if @extra == UNSET_VALUE
      end
    end

    # Builds the archive, uploads it, unpacks it in /opt/isoloom (C:\isoloom on Windows, over
    # WinRM, with UNTAR_PS1), replacing an older copy.
    class Provisioner < Vagrant.plugin("2", :provisioner)
      def provision
        windows = @machine.config.vm.communicator.to_s == "winrm"
        Tempfile.create(["isoloom-project", ".tgz"]) do |f|
          f.binmode
          IsoloomProject.write(ROOT, f, generated: config.generated, extra: config.extra)
          f.close
          dest = windows ? "C:\\isoloom" : "/opt/isoloom"
          @machine.ui.info("The project, #{(File.size(f.path) / 1024.0).ceil} KB compressed, to #{dest}")
          comm = @machine.communicate
          if windows
            archive = "C:\\Windows\\Temp\\isoloom-project.tgz"
            comm.upload(f.path, archive)
            script = "$archive = '#{archive}'; $dest = '#{dest}'; $strip = 0\n#{UNTAR_PS1}"
            comm.execute(script, elevated: true) do |type, data|
              @machine.ui.info(data.chomp) if type == :stdout && !data.strip.empty?
            end
          else
            comm.upload(f.path, "/tmp/isoloom-project.tgz")
            comm.execute("rm -rf /tmp/isoloom-project && mkdir /tmp/isoloom-project && tar -xzf /tmp/isoloom-project.tgz -C /tmp/isoloom-project && rm -f /tmp/isoloom-project.tgz")
            comm.sudo("rm -rf /opt/isoloom && mv /tmp/isoloom-project /opt/isoloom")
          end
        end
      end
    end

    class Plugin < Vagrant.plugin("2")
      name "isoloom project"
      config(:isoloom_project, :provisioner) { Config }
      provisioner(:isoloom_project) { Provisioner }
    end
  end
end

# Unpacks the project on Windows (no tar.exe before Windows Server 2019).
IsoloomProject::UNTAR_PS1 = <<'PS1'
# The project into a Windows machine: unpacks the tar.gz $archive into $dest (replacing an older
# copy), leaving out the archive's first $strip folders. Plain .NET (GZipStream), so it runs on
# every Windows Isoloom supports: PowerShell 2.0 and later, and no tar.exe before Windows Server
# 2019. Symbolic links are left out (counted).
& {
  $ErrorActionPreference = 'Stop'
  $sep = [IO.Path]::DirectorySeparatorChar
  $new = "$dest.new"
  if (Test-Path $new) { Remove-Item $new -Recurse -Force }
  [void][IO.Directory]::CreateDirectory($new)
  $file = New-Object IO.FileStream($archive, [IO.FileMode]::Open, [IO.FileAccess]::Read)
  $in = New-Object IO.Compression.GZipStream($file, [IO.Compression.CompressionMode]::Decompress)
  $utf8 = New-Object Text.UTF8Encoding($false)
  $header = New-Object byte[] 512
  $chunk = New-Object byte[] 65536
  function Fill([byte[]]$b, [int]$n) {
    $got = 0
    while ($got -lt $n) {
      $r = $in.Read($b, $got, $n - $got)
      if ($r -le 0) { throw "$archive ends early" }
      $got += $r
    }
  }
  function Field([int]$at, [int]$len) {
    $end = [Array]::IndexOf($header, [byte]0, $at, $len)
    if ($end -lt 0) { $end = $at + $len }
    $utf8.GetString($header, $at, $end - $at)
  }
  # Copies $size bytes to $out (or skips them, with no $out), then the padding after them.
  function Body([long]$size, $out) {
    $left = $size
    while ($left -gt 0) {
      $n = [int][Math]::Min([long]$chunk.Length, $left)
      Fill $chunk $n
      if ($out) { $out.Write($chunk, 0, $n) }
      $left -= $n
    }
    $pad = [int]((512 - $size % 512) % 512)
    if ($pad) { Fill $chunk $pad }
  }
  $pax = @{}
  $links = 0
  $files = 0
  while ($true) {
    Fill $header 512
    if ($header[148] -eq 0) { break } # the end: zero blocks have no checksum
    $type = [char]$header[156]
    $sizeText = (Field 124 12).Trim()
    $size = [long]0
    if ($sizeText) { $size = [Convert]::ToInt64($sizeText, 8) }
    if ($pax['size']) { $size = [long]$pax['size'] }
    if ($type -eq 'x') {
      # pax records ("<length> key=value\n"): a long path, a large size, for the next entry.
      $ms = New-Object IO.MemoryStream
      Body $size $ms
      $b = $ms.ToArray()
      $i = 0
      while ($i -lt $b.Length) {
        $sp = [Array]::IndexOf($b, [byte]32, $i)
        $len = [int]$utf8.GetString($b, $i, $sp - $i)
        $eq = [Array]::IndexOf($b, [byte]61, $sp)
        $pax[$utf8.GetString($b, $sp + 1, $eq - $sp - 1)] = $utf8.GetString($b, $eq + 1, $i + $len - $eq - 2)
        $i += $len
      }
      continue
    }
    if ($type -eq 'L' -or $type -eq 'K') {
      # GNU tar's long name (or link target) for the next entry.
      $ms = New-Object IO.MemoryStream
      Body $size $ms
      if ($type -eq 'L') { $pax['path'] = $utf8.GetString($ms.ToArray()).TrimEnd([char]0) }
      continue
    }
    $name = Field 0 100
    $prefix = Field 345 155
    if ($prefix) { $name = "$prefix/$name" }
    if ($pax['path']) { $name = $pax['path'] }
    $pax = @{}
    $parts = @($name.Split('/') | Where-Object { $_ -ne '' -and $_ -ne '.' })
    if ($parts.Count -le $strip) { Body $size $null; continue }
    $path = Join-Path $new ([string]::Join([string]$sep, [string[]]($parts[$strip..($parts.Count - 1)])))
    if ($type -eq '5' -or $type -eq '0' -or $type -eq [char]0) {
      # A name Windows can't take (`:`, `*`, too long...) is left out, with a warning.
      $out = $null
      try {
        if ($type -eq '5') {
          [void][IO.Directory]::CreateDirectory($path)
        } else {
          [void][IO.Directory]::CreateDirectory([IO.Path]::GetDirectoryName($path))
          $out = [IO.File]::Create($path)
        }
      } catch {
        Write-Warning "Not copied: $name ($($_.Exception.Message))"
        Body $size $null
        continue
      }
      if ($out) {
        try { Body $size $out } finally { $out.Close() }
        $files++
      } else {
        Body $size $null
      }
    } else {
      if ($type -eq '2') { $links++ }
      Body $size $null
    }
  }
  $in.Close()
  if (Test-Path $dest) { Remove-Item $dest -Recurse -Force }
  Move-Item $new $dest
  Remove-Item $archive -Force
  $note = ''
  if ($links) { $note = " ($links symbolic links left out)" }
  "$files files in $dest$note"
}
PS1
# Hyper-V (`vagrant up --provider hyperv`, from an elevated shell: an administrator, or a member
# of Hyper-V Administrators). Vagrant connects every adapter of a VM to one virtual switch and
# sets no address in the guest, so Isoloom does the rest:
# - the first adapter (Vagrant's own connection, and the internet) is on ISOLOOM_HYPERV_SWITCH,
#   else the Default Switch (Windows 10 and 11; on Windows Server, name an external or NAT one);
# - each network is a private switch named after it (between the VMs only, like a VirtualBox
#   internal network), created when missing and removed with the environment's last VM;
# - each VM has an adapter there with a fixed MAC, attached before every start (Vagrant has
#   just connected them all to the first switch), and its address set in the guest once it
#   answers (a boot-time unit on Linux, a static address on Windows);
# - published ports aren't forwarded to the host (Hyper-V can't): a warning says where they are.
HYPERV_SWITCH = ENV.fetch("ISOLOOM_HYPERV_SWITCH", "Default Switch")
module IsoloomHyperV
  def self.fail!(message)
    raise Class.new(Vagrant::Errors::VagrantError) { define_method(:error_message) { "Hyper-V: #{message}" } }
  end

  # Runs PowerShell on this host: its output, or the error it stopped on.
  def self.ps(script)
    require "vagrant/util/powershell"
    r = Vagrant::Util::PowerShell.execute_inline("$ErrorActionPreference = 'Stop'; #{script}")
    fail!(r.stderr.strip.empty? ? r.stdout.strip : r.stderr.strip) if r.exit_code != 0
    r.stdout
  end

  # A PowerShell string.
  def self.q(s)
    "'#{s.to_s.gsub("'", "''")}'"
  end

  # Before Vagrant picks the first adapter's switch: that switch exists (Vagrant would otherwise
  # ask which one, or take another), and so do the networks' private switches.
  def self.switches(names)
    ps((["if (-not (Hyper-V\\Get-VMSwitch -Name #{q(HYPERV_SWITCH)} -ErrorAction SilentlyContinue)) { throw ('no virtual switch named ' + #{q(HYPERV_SWITCH)} + ': set ISOLOOM_HYPERV_SWITCH to one of Get-VMSwitch') }"] +
        names.map { |n| "if (-not (Hyper-V\\Get-VMSwitch -Name #{q(n)} -ErrorAction SilentlyContinue)) { Hyper-V\\New-VMSwitch -Name #{q(n)} -SwitchType Private | Out-Null }" }).join("; "))
  end

  # Before the VM starts: its adapter on each network's switch, found by its MAC (added the
  # first time), connected there.
  def self.attach(machine, nics)
    return if nics.empty?
    ps((["$vm = Hyper-V\\Get-VM -Id #{q(machine.id)}"] + nics.map { |sw, mac|
      "$a = @(Hyper-V\\Get-VMNetworkAdapter -VM $vm | Where-Object { $_.MacAddress -eq #{q(mac)} }); " \
      "if ($a.Count -eq 0) { Hyper-V\\Add-VMNetworkAdapter -VM $vm -Name #{q(sw)} -SwitchName #{q(sw)} -StaticMacAddress #{q(mac)} } " \
      "else { Hyper-V\\Connect-VMNetworkAdapter -VMNetworkAdapter $a[0] -SwitchName #{q(sw)} }"
    }).join("; "))
  end

  # Once the VM has an address (a Hyper-V step, so this runs on Hyper-V only), when the guest
  # answers, before its provisioning: its addresses on the networks.
  def self.address(machine, script)
    fail!("#{machine.name} didn't answer within #{machine.config.vm.boot_timeout} s") unless machine.communicate.wait_for_ready(machine.config.vm.boot_timeout)
    machine.communicate.sudo(script)
  end

  # Hyper-V forwards no ports: where the published ones (guest => host) are instead.
  def self.ports(machine, ports)
    ip = (machine.ssh_info || {})[:host] || "the VM's address"
    machine.ui.warn("Hyper-V forwards no ports to this host: " + ports.map { |guest, host| "127.0.0.1:#{host} isn't there, use #{ip}:#{guest}" }.join("; "))
  end

  # After a VM is deleted: the networks' switches no VM uses any more.
  def self.prune(names)
    ps(names.map { |n| "if ((Hyper-V\\Get-VMSwitch -Name #{q(n)} -ErrorAction SilentlyContinue) -and -not (Hyper-V\\Get-VMNetworkAdapter -All | Where-Object { $_.SwitchName -eq #{q(n)} })) { Hyper-V\\Remove-VMSwitch -Name #{q(n)} -Force }" }.join("; "))
  end
end

# ESXi (vagrant-vmware-esxi): ESXI_VIRTUAL_NETWORK lists port groups, comma-separated: the
# management network first, then one per network, in order (app); a missing one reuses the last.
ESXI_NETWORKS = ENV.fetch("ESXI_VIRTUAL_NETWORK", "VM Network").split(",").map(&:strip)
LAB_NETWORKS = ["app"]
def esxi_networks(nets)
  [ESXI_NETWORKS[0]] + nets.map { |n| ESXI_NETWORKS[1 + LAB_NETWORKS.index(n)] || ESXI_NETWORKS[-1] }
end

# QEMU (vagrant-qemu): what the provider block can't say on its own.
# - A network of other than two VMs gets a hub: one QEMU process with no machine, a port per VM
#   on one emulated hub, each VM connecting to its own (no root; multicast doesn't send on a
#   Mac). It starts before a VM on that network does, and stops with the network's first VM,
#   which `vagrant destroy` destroys last.
# - A VM's disk is an overlay of its box's, and a size below the box's disk would cut its file
#   system off: `disk_resize` is set only when the machine's size is above the box's (every
#   installed version of it, read with qemu-img). Until the box is downloaded the size is unknown
#   and nothing is set; Vagrant reads this file again once it has the box, before it makes the
#   disk.
module IsoloomQemu
  # Beside Vagrant's own state for this Vagrantfile.
  def self.hubs_dir
    File.join(__dir__, ".vagrant", "isoloom-qemu-hubs")
  end

  def self.fail!(message)
    raise Class.new(Vagrant::Errors::VagrantError) { define_method(:error_message) { "QEMU: #{message}" } }
  end

  def self.pid_file(net)
    File.join(hubs_dir, "#{net}.pid")
  end

  # The hub's process id, while it runs.
  def self.running(net)
    pid = Integer(File.read(pid_file(net)).strip)
    Process.kill(0, pid)
    pid
  rescue ArgumentError, SystemCallError
    nil
  end

  # Starts the network's hub unless it runs: QEMU returns once its ports listen.
  def self.hub(net, ports)
    return if running(net)
    require "fileutils"
    FileUtils.mkdir_p(hubs_dir)
    args = ["qemu-system-#{HOST_ARCH}", "-machine", "none", "-display", "none", "-nodefaults",
            "-daemonize", "-pidfile", pid_file(net)]
    ports.each_with_index do |port, i|
      args += ["-netdev", "socket,id=s#{i},listen=127.0.0.1:#{port}", "-netdev", "hubport,id=h#{i},hubid=0,netdev=s#{i}"]
    end
    log = File.join(hubs_dir, "#{net}.log")
    ok = system(*args, out: log, err: log)
    fail!("the hub of network `#{net}` didn't start (#{args.first}): see #{log}") unless ok
  end

  # Stops the network's hub, if it runs.
  def self.stop(net)
    pid = running(net)
    Process.kill("TERM", pid) if pid
    File.delete(pid_file(net)) if File.exist?(pid_file(net))
  end

  # `disk_resize` for a VM of `box` sized `gb` GB: the size when it is above the box's disk,
  # else nothing (the box's disk is kept, never cut).
  def self.disk(box, gb)
    require "json"
    dir = File.join(Vagrant.user_data_path.to_s, "boxes", box.gsub("/", "-VAGRANTSLASH-"))
    images = Dir.glob(File.join(dir, "**", "libvirt", "**", "*.{img,qcow2}"))
    return nil if images.empty?
    sizes = images.map do |img|
      out = IO.popen(["qemu-img", "info", "--output=json", img], err: File::NULL, &:read)
      JSON.parse(out)["virtual-size"]
    rescue StandardError
      nil
    end
    # A box whose size can't be read keeps its own disk: a guess could cut it.
    return nil if sizes.include?(nil)
    gb * 1024**3 > sizes.max ? "#{gb}G" : nil
  end
end
# QEMU: each network's hub ports, one a VM, in the order they start.
QEMU_HUBS = {
  "app" => [38162, 38163, 38164],
}

Vagrant.configure("2") do |config|
  config.vm.synced_folder ".", "/vagrant", disabled: true
  config.vm.boot_timeout = 900
  config.ssh.proxy_command = ENV["ISOLOOM_SSH_PROXY_COMMAND"] if ENV["ISOLOOM_SSH_PROXY_COMMAND"]
  config.vm.provider "libvirt" do |v|
    v.default_prefix = "hello-stack_"
  end

  config.vm.define "cache" do |m|
    m.vm.box = "bento/debian-12"
    m.vm.hostname = "cache"
    m.vm.network "private_network", ip: "10.60.0.20", netmask: "255.255.255.0", virtualbox__intnet: "isoloom-hello-stack-app", libvirt__network_name: "isoloom-hello-stack-app", libvirt__dhcp_enabled: false
    m.vm.provider "virtualbox" do |v|
      v.name = "hello-stack · cache"
      v.linked_clone = true
      v.cpus = 1
      v.memory = 1024
    end
    m.vm.provider "vmware_desktop" do |v|
      v.vmx["displayName"] = "hello-stack · cache"
      v.vmx["numvcpus"] = "1"
      v.vmx["memsize"] = "1024"
    end
    m.vm.provider "parallels" do |v|
      v.name = "hello-stack · cache"
      v.linked_clone = true
      v.cpus = 1
      v.memory = 1024
    end
    m.vm.provider "utm" do |v|
      v.name = "hello-stack · cache"
      v.cpus = 1
      v.memory = 1024
    end
    m.vm.provider "qemu" do |v, o|
      o.vm.box = "cloud-image/debian-12"
      o.vm.box_version = ">= 0"
      o.vm.box_architecture = "amd64"
      v.arch = "x86_64"
      v.smp = "cpus=1"
      v.memory = "1024M"
      v.ssh_auto_correct = true
      # Port 38162 of network `app`'s hub (see IsoloomQemu).
      v.advanced_network = true
      v.net_mode = :socket
      v.socket_opts = "connect=127.0.0.1:38162"
      if "x86_64" != HOST_ARCH
        v.smp = "cpus=1"
        o.vm.boot_timeout = 3600
      end
    end
    m.trigger.before :"VagrantPlugins::QEMU::Action::StartInstance", type: :action do |t|
      t.ruby { |_, _| IsoloomQemu.hub("app", QEMU_HUBS["app"]) }
