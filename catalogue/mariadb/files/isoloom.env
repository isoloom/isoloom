# Written by Isoloom from the catalogue's mariadb entry: what the official image reads from its
# environment, for the entrypoint's first start. The passwords stay in their value files.
MARIADB_ROOT_PASSWORD_FILE={{ with.password.path }}
MARIADB_DATABASE={{ with.database }}
MARIADB_USER={{ with.user }}
MARIADB_PASSWORD_FILE={{ with.user_password.path }}
