# Written by Isoloom from the catalogue's mysql entry: what the official image reads from its
# environment, for the entrypoint's first start. The passwords stay in their value files.
MYSQL_ROOT_PASSWORD_FILE={{ with.password.path }}
MYSQL_DATABASE={{ with.database }}
MYSQL_USER={{ with.user }}
MYSQL_PASSWORD_FILE={{ with.user_password.path }}
