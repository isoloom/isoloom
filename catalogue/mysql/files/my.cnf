# SPDX-License-Identifier: Apache-2.0
# Written by Isoloom from the catalogue's mysql entry, for Oracle's generic build under
# /usr/local/mysql: the official image's settings (every address, no host cache, its data folder).
[mysqld]
basedir = /usr/local/mysql
datadir = /var/lib/mysql
socket = /run/mysqld/mysqld.sock
pid-file = /run/mysqld/mysqld.pid
bind-address = 0.0.0.0
port = 3306
skip-name-resolve
secure-file-priv = /var/lib/mysql-files
user = mysql

[client]
socket = /run/mysqld/mysqld.sock

!includedir /etc/mysql/conf.d/
